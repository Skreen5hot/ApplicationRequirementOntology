             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19245 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Schedule maintenance work" .


###  http://example.org/apqc#PCF_19247
ex:PCF_19247 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Gathering resources needed to complete all maintenance work. Verify that all resources have the proper training and skills to perform the work." ;
             ex:designatesProcessType ex:P19247 ;
