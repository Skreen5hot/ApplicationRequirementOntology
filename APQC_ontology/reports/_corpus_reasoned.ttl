                                       owl:onProperty obo:BFO_0000054 ;
                                       owl:someValuesFrom ex:P10165
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000054 ;
                                       owl:someValuesFrom ex:P10166
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000054 ;
                                       owl:someValuesFrom ex:P11495
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000054 ;
                                       owl:someValuesFrom ex:P11496
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000054 ;
                                       owl:someValuesFrom ex:P11497
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000054 ;
                                       owl:someValuesFrom ex:P17684
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000054 ;
                                       owl:someValuesFrom ex:P18948
                                     ] ,
                                     [ rdf:type owl:Restriction ;
