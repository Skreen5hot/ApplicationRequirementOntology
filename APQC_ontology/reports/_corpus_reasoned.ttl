ex:PCF_19229 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Arranging a timetable for which to perform construction work. Schedule resources to contract assets for new or replacement assets. Reschedule or redesign assets if needed. " ;
             ex:designatesProcessType ex:P19229 ;
             ex:hierarchyID "10.2.3" ;
             ex:pcfID "19229" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21575 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Schedule and perform construction work" .


###  http://example.org/apqc#PCF_19230
ex:PCF_19230 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining a timetable for which to execute the construction of the asset." ;
             ex:designatesProcessType ex:P19230 ;
             ex:hierarchyID "10.2.3.1" ;
             ex:pcfID "19230" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19229 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Schedule construction work" .


