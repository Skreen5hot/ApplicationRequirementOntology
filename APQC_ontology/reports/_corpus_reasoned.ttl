                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000869
cco:ont00000869 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000199 ;
