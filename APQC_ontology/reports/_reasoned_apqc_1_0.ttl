                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Camera&oldid=1063931551"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


