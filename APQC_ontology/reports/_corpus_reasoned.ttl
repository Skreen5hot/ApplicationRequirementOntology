###  https://www.commoncoreontologies.org/ont00001263
cco:ont00001263 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000588 ;
                rdfs:label "Act of Issuing Mass Media Documentary"@en ;
                skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation information that provides a factual record or report."@en ;
                cco:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001265
cco:ont00001265 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001036 ;
                rdfs:label "Public Address System"@en ;
                skos:altLabel "PA System"@en ;
                skos:definition "A Communication System that is designed to allow a Person to speak to a large audience."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Public_address_system&oldid=1059177344"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001266
cco:ont00001266 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001075 ;
                rdfs:label "Act of Vocational Training Instruction"@en ;
                skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider by imparting skills required for a specific occupation in industry, agriculture or trade to an Agent either directly or indirectly through some communication medium."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=vocational%20training" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001267
cco:ont00001267 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000971 ;
                rdfs:label "Act of Propaganda"@en ;
                skos:definition "An Act of Deceptive Communication Propaganda intended to influence the attitude of a mass audience toward some cause or position by presenting facts selectively (thus possibly lying by omission) or by using loaded messages to produce an emotional rather than rational response to the information presented."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propaganda&oldid=1062472484"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001269
cco:ont00001269 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000133 ;
                rdfs:label "Act of Warning"@en ;
                skos:definition "An Act of Directive Communication performed by indicating a possible or impending danger, problem, or other unpleasant situation."@en ;
                cco:ont00001754 "http://www.merriam-webster.com/dictionary/warning" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001270
cco:ont00001270 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000268 ;
                rdfs:label "Howitzer"@en ;
                skos:definition "A Cannon that is designed to have a relatively short barrel and to use relatively small propellant charges to propel projectiles in relatively high trajectories with a steep angle of descent."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Howitzer&oldid=1059576383"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001271
cco:ont00001271 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001169 ;
                rdfs:label "Wired Communication Relay Artifact Function"@en ;
                skos:definition "A Communication Relay Artifact Function that is realized during events in which a Material Artifact is used to first receive and then transmit information by means of wires from one Material Artifact to another for the purpose of communiction."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001272
cco:ont00001272 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000191 ;
                rdfs:label "Act of Murder"@en ;
                skos:definition "An Act of Homicide with malice aforethought."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001274
cco:ont00001274 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000008 ;
                rdfs:label "Infrasonic Frequency"@en ;
                skos:definition "A Sound Frequency that is below 20 Hz."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001275
cco:ont00001275 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001353 ;
                rdfs:label "Nominal Speed Artifact Function"@en ;
                skos:definition "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains a speed that does not exceed some specified tolerance of that Material Artifact."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001276
cco:ont00001276 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000426 ;
                rdfs:label "Carrier Air Wing"@en ;
                skos:definition "A Military Force that is trained and equipped to conduct air operations while embarked on an aircraft carrier."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001277
cco:ont00001277 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000378 ;
                rdfs:label "Red"@en ;
                skos:definition "A Color that is above Orange with a wavelength in the visible spectrum typically between 635 to 700 nanometers."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001278
cco:ont00001278 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000537 ;
                rdfs:label "Stock"@en ;
                skos:definition "A Financial Instrument that entitles holders to an ownership interest (equity) in the specified Incorporated Organization."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Stock&oldid=1064040249"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001279
cco:ont00001279 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001133 ;
                rdfs:label "Vibration Motion"@en ;
                skos:altLabel "Mechanical Oscillation"@en ,
                              "Oscillation Motion"@en ,
                              "Vibration"@en ;
                skos:definition "A Motion wherein some participant repetitively deviates from a central location to two surrounding locations."@en ;
                cco:ont00001754 "https://physicsabout.com/motion/"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001280
cco:ont00001280 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001059 ;
                rdfs:label "Flat"@en ;
                skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a horizontal border without a significant deviation."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001281
cco:ont00001281 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000791 ;
                rdfs:label "Emulsifier Artifact Function"@en ;
                skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which two or more liquids that are normally immiscible are mixed."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Emulsion&oldid=1056901580"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001282
cco:ont00001282 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000598 ;
                rdfs:label "Hydraulic Valve"@en ;
                skos:definition "A Valve that is designed to regulate, direct, or control the flow of a liquid by opening, closing, or partially obstructing various passageways."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_transfer_unit&oldid=1002682083"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001283
cco:ont00001283 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000782 ;
                rdfs:label "Refinery"@en ;
                skos:definition "A Factory that is designed for refining raw materials into products of value."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refinery&oldid=1027092124"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001284
cco:ont00001284 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000914 ;
                rdfs:label "Crew"@en ;
                skos:definition "A Group of Persons that bear Roles realized by the operation of the specified Vehicle."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001285
cco:ont00001285 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000368 ;
                rdfs:label "Revolving Motion"@en ;
                skos:definition "A Rotational Motion of an Object around an Axis of Rotation that is located externally to the Site occupied by the Object."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001286
cco:ont00001286 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000752 ;
                rdfs:label "Waveform"@en ;
                skos:definition "A Wave Process Profile that is the shape of the Wave Cycles of the Wave Process when depicted in a visual graph."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001287
cco:ont00001287 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Maintenance Facility"@en ;
                skos:definition "A Facility that is designed to be used to perform actions to maintain or improve the state of some property or equipment."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/maintain" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001288
cco:ont00001288 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001150 ;
                rdfs:label "Round Shot"@en ;
                skos:definition "A Portion of Ammunition that is designed to be a solid projectile without explosive charge and to be fired from a cannon."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Round_shot&oldid=1062790260"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001289
cco:ont00001289 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000135 ;
                rdfs:label "Damaged Stasis"@en ;
                skos:altLabel "Compromised"@en ,
                              "Damaged"@en ,
                              "Injured"@en ;
                skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to a previous action or event such that the Independent Continuant is now of lesser value, usefulness, or functionality."@en ;
                skos:scopeNote "This class can be used to instantiate instances that might otherwise be treated by defined classes such as Damaged Vehicle or Wounded Person. The Independent Continuant and Quality or Realizable Entity are participants of the stasis which can in turn be related to the temporal interval via the occupies temporal region property. "@en ;
                cco:ont00001754 "http://www.thefreedictionary.com/damaged" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001290
cco:ont00001290 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Length"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of one-dimensional regions or Geospatial Regions."@en ;
                skos:example "foot, meter, kilometer, mile" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001291
cco:ont00001291 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000628 ;
                rdfs:label "Radiation Absorptivity"@en ;
                skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of the capacity of that bearer to absorb electromagnetic radiation of a given frequency."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001292
cco:ont00001292 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000053 ;
                rdfs:label "Bus"@en ;
                skos:definition "A Ground Motor Vehicle that is designed to transport a large number of people and to travel on six or more tired wheels."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bus&oldid=1055341487"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001293
cco:ont00001293 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001367 ;
                rdfs:label "Perimeter"@en ;
                skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the extent of a boundary which encloses the bearer."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001294
cco:ont00001294 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001202 ;
                rdfs:label "Three Dimensional Extent"@en ;
                skos:altLabel "Volume"@en ;
                skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in three dimensions."@en ;
                cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001295
cco:ont00001295 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Financial Facility"@en ;
                skos:definition "A Facility that is designed to support the management of money."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001296
cco:ont00001296 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000119 ;
                rdfs:label "Pitch Orientation"@en ;
                skos:altLabel "Pitch"@en ;
                skos:definition "A Spatial Orientation of an Object relative to its Pitch Axis."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001297
cco:ont00001297 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001052 ;
                rdfs:label "Military Headquarters Facility"@en ;
                skos:definition "A Military Facility that is designed for military administration and coordination."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Headquarters&oldid=1046429636"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001298
cco:ont00001298 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000798 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000101 ;
                                  owl:someValuesFrom cco:ont00002039
                                ] ;
                rdfs:label "Material Copy of a Document"@en ;
                skos:altLabel "Document"@en ;
                skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity in a series of paragraphs of text or diagrams in the form of physical pieces of paper or an electronic word processor file."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Document&oldid=1057829688"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001299
cco:ont00001299 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000344 ;
                rdfs:label "Wetting Agent Artifact Function"@en ;
                skos:definition "A Surfactant Artifact Function that is realized in a process that reduces the water repellent tendency of a substance thereby allowing it to become wet."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wetting&oldid=1062806793"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001300
cco:ont00001300 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001192 ;
                rdfs:label "Patch Antenna"@en ;
                skos:altLabel "Microstrip Patch Antenna"@en ,
                              "Rectangular Microstrip Antenna"@en ;
                skos:definition "A Radio Antenna that consists of a flat rectangular sheet (or patch) of metal mounted over a larger sheet of metal called a ground plane which is typically contained inside a plastic radome for protection and is small enough that it can be mounted on a flat surface."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Patch_antenna&oldid=1016658507"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001301
cco:ont00001301 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Service Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in a process of providing intangible goods to consumers."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Goods_and_services&oldid=1063137197"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001302
cco:ont00001302 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00001180
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000196 ;
                                                             owl:someValuesFrom cco:ont00000173
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00001180 ;
                rdfs:label "Civil Organization"@en ;
                skos:definition "An Organization that is not commercial or military and is the bearer of a Civilian Role."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001303
cco:ont00001303 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001306 ;
                rdfs:label "Position Observation Artifact Function"@en ;
                skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the position of a specified object or class of objects."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001304
cco:ont00001304 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000575 ;
                rdfs:label "Dimension Specification"@en ;
                skos:definition "An Quality Specification that prescribes some Size Quality."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001305
cco:ont00001305 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001066 ;
                rdfs:label "Loss of Function"@en ;
                skos:definition "A Loss of Disposition in which some Independent Continuant ceases to be the bearer of some Function."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001306
cco:ont00001306 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Observation Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to collect information about a specified object or class of objects."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001307
cco:ont00001307 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000061 ;
                rdfs:label "Measurement Unit of Mass Flow Rate"@en ;
                skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which the Mass of a substance passes per unit time."@en ;
                skos:example "kilogram per second, slug per second, pound per second" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001308
cco:ont00001308 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001315 ;
                rdfs:label "Sewage Treatment Facility"@en ;
                skos:definition "A Waste Management Facility that is designed for removing contaminants from wastewater, especially sewage."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sewage_treatment&oldid=1062966352"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001309
cco:ont00001309 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000077 ;
                rdfs:label "Lot Number"@en ;
                skos:definition "A Code Identifier that designates a particular quantity or lot of material from a single manufacturer."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lot_number&oldid=1061846325"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001310
cco:ont00001310 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Covering Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in a process in which an entity is covered."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/covering" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001311
cco:ont00001311 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000782 ;
                rdfs:label "Aircraft Manufacturing Facility"@en ;
                skos:definition "A Factory that is designed to manufacture Aircraft."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aerospace_manufacturer&oldid=1059223410"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001312
cco:ont00001312 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000274 ;
                rdfs:label "Paramilitary Force"@en ;
                skos:definition "An Armed Force whose organizational structure, training, subculture, and (often) function are similar to those of a professional Military, and which is not included as part of a Government's formal Armed Forces."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Paramilitary&oldid=1063281359"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001313
cco:ont00001313 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Article of Clothing"@en ;
                skos:definition "A Material Artifact that is designed to cover some portion of a body."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Clothing&oldid=1063505718"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001314
cco:ont00001314 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Legal System Act"@en ;
                skos:definition "A Planned Act performed by an Agent that realizes their role within the context of a legal system of some jurisdiction."@en ;
                cco:ont00001754 "http://www.id.uscourts.gov/glossary.htm" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001315
cco:ont00001315 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Waste Management Facility"@en ;
                skos:definition "A Facility that is designed for managing waste for some portion of the waste's existence."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Waste_management&oldid=1062844209"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001316
cco:ont00001316 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001042 ;
                rdfs:label "Gimbal"@en ;
                skos:definition "An Equipment Mount that consists of a pivoted support that allows a Material Artifact to Rotate about one or more Axes."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gimbal&oldid=1053306885"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001317
cco:ont00001317 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Volume"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of sites or three-dimensional spatial regions."@en ;
                skos:example "cubic feet, cubic meter, quart, liter" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001318
cco:ont00001318 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000119 ;
                rdfs:label "Yaw Orientation"@en ;
                skos:altLabel "Yaw"@en ;
                skos:definition "A Spatial Orientation of an Object relative to its Yaw Axis."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001319
cco:ont00001319 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000427 ;
                rdfs:label "Tank"@en ;
                skos:definition "An Armored Fighting Vehicle that is designed to carry heavy firepower, have a powerful Engine, and travel on one or more continuous tracks such that it is suitable for front-line combat and can provide operational maneuverability as well as tactical offensive and defensive capabilities."@en ;
                skos:scopeNote "Tank firepower is normally provided by a large-caliber main gun mounted in a rotating turret, which is supported by secondary machine guns. A tank's heavy armour and all-terrain mobility provide protection for both the tank and its crew, allowing it to perform all primary tasks of the armoured troops on the battlefield."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tank&oldid=1060527612"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001320
cco:ont00001320 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000903 ;
                rdfs:label "Radio Transceiver"@en ;
                skos:definition "A Radio Communication Instrument that is an electronic device composed of both a Radio Transmitter and a Radio Receiver that share common circuitry or a single housing."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transceiver&oldid=1058453736"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001321
cco:ont00001321 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001105 ;
                rdfs:label "Lead Acid Electric Battery"@en ;
                skos:definition "A Secondary Cell Electric Battery that has a lead anode and lead oxide cathode."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lead%E2%80%93acid_battery&oldid=1061641405"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001322
cco:ont00001322 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000726 ;
                rdfs:label "Decrease of Generically Dependent Continuant"@en ;
                skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in the level of a Generically Dependent Continuant that it bears."@en ;
                skos:scopeNote "For the most part Generically Dependent Continuants do not inhere in their bearers over some continuous scale. The primary exception is religion and this class allows annotation of those cases where an Agent is described as becoming less religious. Other cases would include the decrease of an organization's bearing of some objective."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001323
cco:ont00001323 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Bearing Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in processes in which the Material Artifact constrains relative motion to only the desired motion, and reduces friction between moving parts."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001324
cco:ont00001324 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:label "Process Regulation"@en ;
                skos:definition "A Prescriptive Information Content Entity that prescribes an Process as required, prohibited, or permitted, and is the output of an Process which realizes some Authority Role."@en ;
                skos:scopeNote "Although regulations often regulate processes which involve agents--as the regulating or regulated participant--it is unclear how causally active an agents need to be in those regulated processes. For example, it is not clear how causally active a human agent is in the process of a traffic light regulating the motion of a self-driving vehicle."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001325
cco:ont00001325 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001334 ;
                rdfs:label "Act of Renting"@en ;
                skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Renter) as a payment to acquire temporary possession or use of a good or property that is owned or controlled by another Agent (the Seller)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001326
cco:ont00001326 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000254 ;
                rdfs:label "Land Transportation Artifact"@en ;
                skos:definition "A Transportation Artifact that facilitates the movement of Agents and Vehicles via land"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001327
cco:ont00001327 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Social Act"@en ;
                skos:definition "A Planned Act having an objective that affects, is performed by, or is performed on behalf of, a community or group of Persons."@en ;
                cco:ont00001754 "http://en.wiktionary.org/wiki/commually" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001328
cco:ont00001328 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000398 ;
                rdfs:label "Temporal Reference System"@en ;
                skos:altLabel "Temporal Reference Frame"@en ,
                              "Time Scale"@en ;
                skos:definition "A Reference System that describes a set of standards for measuring time as well as understanding the context of and organizing temporal data."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001329
cco:ont00001329 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001301 ;
                rdfs:label "Education Artifact Function"@en ;
                skos:definition "A Service Artifact Function that is realized in processes of transmiting accumulated knowledge skills and values from one generation to another."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001330
cco:ont00001330 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000110 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001777 ;
                                  owl:someValuesFrom cco:ont00000345
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001777 ;
                                  owl:someValuesFrom cco:ont00000517
                                ] ;
                rdfs:label "Telemetry Process"@en ;
                skos:definition "A Mechanical Process that is highly automated and in which measurements are made or other data is collected and transmitted to receiving equipment to facilitate the monitoring of environmental conditions or equipment parameters at a remote or inaccessible location."@en ;
                skos:example "using a GPS tag to track a shark's migratory pattern" ,
                             "using a portable cardiac monitor to remotely collect data on a patient's heart activity (biotelemetry)" ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telemetry&oldid=1061697851"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001331
cco:ont00001331 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001014 ;
                rdfs:label "Legal Name"@en ;
                skos:definition "A Proper Name that is an official name for the designated entity as determined by a Government or court of law."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001332
cco:ont00001332 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000610 ;
                rdfs:label "Extreme Ultraviolet Light Frequency"@en ;
                skos:definition "An Ultraviolet Light Frequency that is between 3 and 30 petahertz."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001333
cco:ont00001333 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000378 ;
                rdfs:label "Rosy"@en ;
                skos:definition "A Color consisting of red hue and yellow hue and high brightness."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001334
cco:ont00001334 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000836 ;
                rdfs:label "Act of Purchasing"@en ;
                skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is used by an Agent (the Purchaser) to acquire a good or service from another Agent (the Provider)."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Purchasing&oldid=1050163120"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001335
cco:ont00001335 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001180 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001859 ;
                                  owl:someValuesFrom cco:ont00001203
                                ] ;
                dct:creator "https://cubrc.org"^^xsd:anyURI ;
                rdfs:label "Government"@en ;
                skos:definition "An Organization that is the highest legitimate authority delimited by some Delimiting Domain and that exercises executive, legislative, or judicial authority in that Domain."@en ;
                skos:editorialNote "Highest legitimate authority should not be confused with highest legitimate authority of a particular kind. For example, while the judicial branch of the United States government has the highest judicial authority in a Delimiting Domain, it is not the highest legitimate authority delimited by that domain. The combination of executive, judicial, and legislative branches is higher because it wields more legitimate authority than any branch on its own."@en ,
                                   "Importantly, the definition states \"highest legitimate authority delimited by some Delimiting Domain\" and not \"highest legitimate authority in some Delimiting Domain.\" The government of Wales is the highest legitimate authority delimited by some Delimiting Domain but it is not the highest legitimate authority in that domain, which would be the government of the United Kingdom."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Government&oldid=1063736308"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001336
cco:ont00001336 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001232 ;
                rdfs:label "Act of Ownership"@en ;
                skos:definition "An Act of Possession that includes an agent having certain rights and duties over the property owned."@en ;
                skos:scopeNote "The relation between the owner and property may be private, collective, or common and the property may be objects, land, real estate, or intellectual property."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ownership&oldid=1058224617"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001337
cco:ont00001337 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000754 ;
                rdfs:label "Infrared Light Frequency"@en ;
                skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 gigahertz and 430 tetrahertz."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared&oldid=1064111319"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001338
cco:ont00001338 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000862 ;
                rdfs:label "Timbre"@en ;
                skos:definition "A Sound Process Profile that is characterized by the variation, spectrum, or envelope of translated sound waves, typically on a continuum from dull or dark to bright."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001339
cco:ont00001339 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000890 ;
                rdfs:label "Act of Walking"@en ;
                skos:definition "An Act of Travel that proceeds by foot."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001340
cco:ont00001340 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000529 ;
                rdfs:label "Calendar Date Identifier"@en ;
                skos:definition "A Date Identifier that designates some Day by using a combination of Day, Week, Month, or Year Identifiers formatted according to an implementation of a Calendar System."@en ;
                skos:example "January 1, 2018; 1 January 2018; 01/01/18; 01Jan18" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001341
cco:ont00001341 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000024 ;
                rdfs:label "Portion of Geosphere"@en ;
                skos:definition "A fiat object part that is composed of one or more portions of the atmosphere, cryosphere, hydrosphere, or lithosphere"@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Geosphere&oldid=1137306949"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001342
cco:ont00001342 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000427 ;
                rdfs:label "Infantry Fighting Vehicle"@en ;
                skos:definition "An Armored Fighting Vehicle that is designed to carry infantry into battle and to provide fire support for them."@en ;
                skos:scopeNote "Infantry Fighting Vehicles (IFVs) are differentiated from Armored Personnel Carriers (APCs) because they are designed to give direct fire support to the dismounted infantry and so usually have significantly enhanced armament. IFVs also often have improved armour and firing ports (allowing the infantry to fire personal weapons while mounted)."@en ;
                cco:ont00001753 "IFV" ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infantry_fighting_vehicle&oldid=1062470745"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001343
cco:ont00001343 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Circuit Breaker"@en ;
                skos:definition "A Material Artifact that is designed to protect an electrical circuit from damage caused by excess current from an overload or short circuit."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Circuit_breaker&oldid=1060854893"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001344
cco:ont00001344 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000881 ;
                rdfs:label "Biological Depot"@en ;
                skos:definition "A Storage Facility that is designed to store biological agents."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001345
cco:ont00001345 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Impulse"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of the integral of a Force applied to a portion of matter over a temporal interval."@en ;
                skos:example "N s, dyne second" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001346
cco:ont00001346 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Legal Instrument"@en ;
                skos:definition "A Material Artifact that is designed as a formally executed written document that can be formally attributed to its author, records and formally expresses a legally enforceable act, process, or contractual duty, obligation, or right, and therefore evidences that act, process, or agreement."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Legal_instrument&oldid=1054387344"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001347
cco:ont00001347 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000005 ;
                rdfs:label "Behavior"@en ;
                skos:definition "An Act in which an Independent Continuant participates as an Agent in response to external or internal stimuli and following some pattern which is dependent upon some combination of that Independent Continuant's internal state and external conditions."@en ;
                cco:ont00001754 "http://purl.obolibrary.org/obo/GO_0007610" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001348
cco:ont00001348 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000028 ;
                rdfs:label "Three-Dimensional Position"@en ;
                skos:definition "A Three-Dimensional Spatial Region that encompasses the (minimal) spatial region in which some object is located at a particular time."@en ;
                skos:scopeNote "For an object in motion, its Three-Dimensional Position is part of its Three-Dimensional Path."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001349
cco:ont00001349 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000378 ;
                rdfs:label "Grey"@en ;
                skos:definition "A Color between white and black colors."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001350
cco:ont00001350 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Thermal Control Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized by a Material Artifact increasing, decreasing, or maintaining the temperature of itself, a part of itself, or another object."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001351
cco:ont00001351 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000275 ;
                rdfs:label "Cartesian Coordinate System"@en ;
                skos:altLabel "Rectangular Coordinate System"@en ;
                skos:definition "A Spatial Reference System that identifies each point in a spatial region of n-dimensions using an ordered n-tuple of numerical coordinates that are the signed (i.e. positive or negative) distances measured in the same unit of length from the zero point where the fixed perpendicular Coordinate System Axes meet."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cartesian_coordinate_system&oldid=1058613323"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001352
cco:ont00001352 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000829 ;
                rdfs:label "Greenwich Mean Time Zone Identifier"@en ;
                skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Greenwich Mean Time."@en ;
                skos:scopeNote "Greenwich Mean Time (GMT) is the mean solar time at the Royal Observatory in Greenwich, London and has been superseded by Coordinated Universal Time (UTC)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001353
cco:ont00001353 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000448 ;
                rdfs:label "Speed Artifact Function"@en ;
                skos:definition "A Motion Artifact Function that is realized in some process in which its bearer has some speed."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001354
cco:ont00001354 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000378 ;
                rdfs:label "Vermilion"@en ;
                skos:definition "A Color consisting of red and orange hue with a slight amount of gray."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001355
cco:ont00001355 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000928 ;
                rdfs:label "Freight Train Car"@en ;
                skos:altLabel "Freight Car"@en ;
                skos:definition "A Train Car that is designed to transport cargo."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Goods_wagon&oldid=1062686785"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001356
cco:ont00001356 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000611 ;
                rdfs:label "Increase of Disposition"@en ;
                skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Disposition that it bears."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001357
cco:ont00001357 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Time"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of temporal regions."@en ;
                skos:example "second, minute, hour, day" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001358
cco:ont00001358 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000270 ;
                rdfs:label "School"@en ;
                skos:definition "An Education Facility that is designed to provide learning space and environments for teaching of students under the direction of teachers."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=School&oldid=1063515394"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001359
cco:ont00001359 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000908 ;
                rdfs:label "Act of Manufacturing"@en ;
                skos:definition "An Act of Material Artifact Processing wherein Material Artifacts are mass produced in a Facility for the purpose of being sold or distributed to consumers."@en ;
                skos:scopeNote "An Act of Manufacturing typically involves the mass production of goods."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001360
cco:ont00001360 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001059 ;
                rdfs:label "Three Dimensional Shape"@en ;
                skos:definition "A Shape Quality that inheres only in a three dimensional entity."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001361
cco:ont00001361 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Healing Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in a process in which health is restored to an unbalanced, diseased, or damaged organism."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Healing&oldid=1053920678"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001362
cco:ont00001362 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001283 ;
                rdfs:label "Gas Processing Facility"@en ;
                skos:definition "A Refinery that is designed for refining natural gas into products of value."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Natural-gas_processing&oldid=1056700541"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001363
cco:ont00001363 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001033 ;
                rdfs:label "Male Sex"@en ;
                skos:definition "A Biological Sex inhering in an individual whose sex organs contain only male gametes."@en ;
                cco:ont00001754 "http://purl.org/obo/owl/PATO#PATO_0000384" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001364
cco:ont00001364 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00001163
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001877 ;
                                                             owl:someValuesFrom obo:BFO_0000001
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00001163 ;
                rdfs:label "Interval Measurement Information Content Entity"@en ;
                skos:definition "A Measurement Information Content Entity that places a Quality of an Entity onto some interval scale having no true zero value."@en ;
                skos:example "The sentence \"The temperature reached -27 degrees Fahrenheit on January 20, 1985 in Chicago, IL.\" is the carrier of an interval measurement as 0 degrees on the Fahrenheit scale does not describe absolute zero."@en ;
                skos:scopeNote "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001365
cco:ont00001365 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001353 ;
                rdfs:label "Maximum Speed Artifact Function"@en ;
                skos:definition "A Speed Artifact Function that is realized in some process in which the Material Artifact bearing the Artifact Function attains the highest speed at which that Material Artifact is designed to operate."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001366
cco:ont00001366 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Powering Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to supply power to some Material Artifact."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001367
cco:ont00001367 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001202 ;
                rdfs:label "One Dimensional Extent"@en ;
                skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in one dimension."@en ;
                skos:scopeNote "Subclasses of one dimensional extent are included for usability. It is doubtful any of them can be objectively distinguished (on the side of the bearing entity) without some reference to external properties such as orientation and perspective."@en ;
                cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001368
cco:ont00001368 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001306 ;
                rdfs:label "Motion Observation Artifact Function"@en ;
                skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the Motion of a specified object or class of objects."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001369
cco:ont00001369 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001059 ;
                rdfs:label "Rectangular"@en ;
                skos:definition "A Shape Quality inhering in a bearer in virtue of having four sides and four 90 degree angles."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001370
cco:ont00001370 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Machine Bearing"@en ;
                skos:definition "A Material Artifact that is designed to constrain relative motion to only desired motion and reduces friction between moving parts."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001371
cco:ont00001371 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Electromagnetic Induction Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized by processes in which some Material Artifact that is used to produce electromotive force across an electrical conductor due to its dynamic interaction with a magnetic field."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_induction&oldid=1061836930"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001372
cco:ont00001372 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000437 ;
                rdfs:label "Fertilizer Artifact Function"@en ;
                skos:definition "An Enhancing Artifact Function that is realized in processes of supplying soilds or plant tissues with one or more plant nutrients essential to growth."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fertilizer&oldid=1062923261"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001373
cco:ont00001373 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001051 ;
                rdfs:label "Bow"@en ;
                skos:definition "A Projectile Launcher that is designed to launch Arrows."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bow_and_arrow&oldid=1062193194"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001374
cco:ont00001374 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000402 ;
                rdfs:label "Act of Declarative Communication"@en ;
                skos:definition "An Act of Communication that changes the reality in accord with the proposition of the declaration."@en ;
                skos:scopeNote "Examples: Baptism, Sentencing a person to imprisonment, Pronouncing a couple husband and wife, Declaring war"@en ;
                cco:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001375
cco:ont00001375 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Washing Facility"@en ;
                skos:definition "A Facility that is designed to wash personnel or equipment."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Washing&oldid=1035998791"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001376
cco:ont00001376 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000570 ;
                rdfs:label "Torque"@en ;
                skos:altLabel "Moment of Force"@en ;
                skos:definition "A Force that is applied to an object in a direction that would tend to cause the object to rotate around an Axis of Rotation and is the rate of change of an object's Angular Momentum."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torque&oldid=1063339484"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001377
cco:ont00001377 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000378 ;
                rdfs:label "Gold Color"@en ;
                skos:definition "A Color that resembles a yellow-orange Hue with the added feature of having a metallic shine."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001378
cco:ont00001378 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001301 ;
                rdfs:label "Hospitality Artifact Function"@en ;
                skos:definition "A Service Artifact Function that is realized in processes of accommodation food and beverage meeting and events gaming entertainment and recreation tourism services and visitor information."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hospitality&oldid=1049599161"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001379
cco:ont00001379 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                rdfs:label "Agent Capability"@en ;
                skos:definition "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."@en ;
                cco:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001380
cco:ont00001380 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000339 ;
                rdfs:label "Farm"@en ;
                skos:definition "An Agricultural Facility that is designed to produce food and other crops."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Farm&oldid=1058311769"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001381
cco:ont00001381 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Medical Artifact"@en ;
                skos:definition "A Material Artifact that is designed for diagnosing, treating, or preventing disease, disability, or death."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001382
cco:ont00001382 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000475 ;
                rdfs:label "Electronic Cash"@en ;
                skos:definition "A Portion of Cash that consists of Bytes."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001383
cco:ont00001383 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000479 ;
                rdfs:label "Fire Station"@en ;
                skos:altLabel "Fire Hall"@en ,
                              "Fire House"@en ;
                skos:definition "A Public Safety Facility that is designed for the storage of firefighting apparatus."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fire_station&oldid=1060666629"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001384
cco:ont00001384 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000628 ;
                rdfs:label "Opacity"@en ;
                skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of that bearer's capacity to transmit electromagnetic radiation of a given frequency through the bearer instead of reflecting, scattering, or absorbing electromangentic radiation of that frequency."@en ;
                skos:scopeNote "Note that it is important to specify the frequency of electromagnetic radiation when representing a bearer's Opacity since a bearer may be Opaque with respect to electromagnetic radiation of one frequency, but be transparent with respect to electromagnetic radiation of another frequency. Unless otherwise stated, statements about a bearer's Opacity are assumed to be about electromagnetic radiation with a frequency in the visible spectrum."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Opacity_(optics)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001999
cco:ont00001999 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Filter Function"@en ;
                skos:definition "An Artifact Function that is realized in a process where entities of a specific type or which have specified properties enter it or pass through it."@en ;
                skos:scopeNote """Although its basic function remains the same, a Filter can be used in 2 different ways:
(1) to allow only the desired entities to pass through (e.g. removing dirt from engine oil); or
(2) to allow everything except the desired entities to pass through (e.g. panning for gold)."""@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002000
cco:ont00002000 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000147 ;
                rdfs:label "Center of Mass"@en ;
                skos:definition "A Fiat Point that is where the weighted position vectors of the distributed Mass of a Material Entity relative to this point sum to zero."@en ;
                cco:ont00001754 "Asimov, Isaac. Understanding Physics. New York: Barnes and Noble, 1993. 76-79. Available at: https://archive.org/details/understandingphy00isaa/page/n91/mode/2up"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002001
cco:ont00002001 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000958 ;
                rdfs:label "Media Content Entity" ;
                skos:definition "An information content entity presented in a canonical media format."@en ;
                skos:scopeNote "By 'canonical', it is intended that the media format is of a commonly recognized format, such as mass media formats such as books, magazines, and journals, as well as digital media forms (e.g. ebooks), to include, too, file types, such as those recognized by the Internet Assigned Numbers Authority (IANA)'s Media Types standard [RFC2046]." ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002002
cco:ont00002002 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Certificate"@en ;
                skos:definition "A Media Content Entity that attests to certain demonstrated characteristics of an Object, Person, or Organization."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/degree" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002003
cco:ont00002003 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002002 ;
                rdfs:label "Academic Degree"@en ;
                skos:definition "A Certificate issued by an Educational Organization to a Person to indicate that the Person has satisfactorily completed a course of study, or as an honorary recognition of the Person's achievement."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/degree" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002004
cco:ont00002004 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Image"@en ;
                skos:definition "A Media Content Entity represents some entity owing to a visual isomorphism between the carrying artifact and the entity."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Image&oldid=1062709732"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002005
cco:ont00002005 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002004 ;
                rdfs:label "Chart"@en ;
                skos:definition "An Image that is prescribed by some canonical visual format."@en ;
                cco:ont00001754 "Adapted from “Chart.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/chart. Accessed 4 Aug. 2024." ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002006
cco:ont00002006 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Database"@en ;
                skos:definition "A Media Content Entity that is designed to be rapidly searchable and retrievable."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Database&oldid=1057024641"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002007
cco:ont00002007 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "List"@en ;
                skos:definition "A Media Content Entity whose parts are the subject of some Sequence Position Ordinality."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=List_(abstract_data_type)&oldid=1041588680"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002008
cco:ont00002008 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002007 ;
                rdfs:label "Code List"@en ;
                skos:definition "A List whose parts are Code Identifiers."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002009
cco:ont00002009 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Video"@en ;
                skos:definition "A Media Content Entity that contains a sequence of representations that are presented sufficiently rapidly to create the appearance of motion and continuity."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Video&oldid=1049376249"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002010
cco:ont00002010 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Message"@en ;
                skos:definition "A Media Content Entity that is relatively brief and designed to be transmitted from a sender to a recipient."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Message&oldid=1060098631"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002011
cco:ont00002011 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002010 ;
                rdfs:label "Warning Message"@en ;
                skos:definition "A Message that describes a possible or impending threat."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002012
cco:ont00002012 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002010 ;
                rdfs:label "Email Message"@en ;
                skos:definition "A Message that is transmitted to the recipient's Email Box."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email&oldid=1063646749"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002013
cco:ont00002013 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002010 ;
                rdfs:label "Notification Message"@en ;
                skos:definition "A Message that describes a scenario that has been determined to merit attention by the recipient."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002014
cco:ont00002014 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Barcode"@en ;
                skos:definition "A Media Content Entity that represents one or more geometric shapes that have, as part, some Prescriptive Information Content Entity."@en ;
                skos:scopeNote "For information on types of barcodes, see: https://www.scandit.com/types-barcodes-choosing-right-barcode/"@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Barcode&oldid=1059844765"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002037
cco:ont00002037 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Information Line"@en ;
                skos:definition "A Media Content entity consisting of a single line or row in some Document Content entity of which it is a part."@en ;
                skos:example "a line in a computer file that bears a portion of code for some computer program" ,
                             "a line of data in a database" ,
                             "a line of text in a book" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002038
cco:ont00002038 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:someValuesFrom cco:ont00002039
                                ] ;
                rdfs:label "Document Field Content"@en ;
                skos:altLabel "Document Field"@en ;
                skos:definition "A Media Content Entity that is a part of some document content entity, and which  prescribes the eliciation of information to be written or selected within the document content entity."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002039
cco:ont00002039 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002001 ;
                rdfs:label "Document Content Entity"@en ;
                skos:altLabel "Document"@en ;
                skos:definition "A Media Content Entity that consists of a series of paragraphs of text or diagrams that are intended to be carried by physical pieces of paper or an electronic word processor file."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Document&oldid=1057829688"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002040
cco:ont00002040 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002039 ;
                rdfs:label "Book"@en ;
                skos:definition "A Document Content Entity that canonically appears as ink on paper or parchment, or other materials fastened together to hinge at one side."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Book&oldid=1063132471"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002041
cco:ont00002041 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002039 ;
                rdfs:label "Transcript"@en ;
                skos:definition "A Document Content Entity that was originally recorded in a different medium."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transcript&oldid=1038510063"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002042
cco:ont00002042 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002039 ;
                rdfs:label "Spreadsheet"@en ;
                skos:definition "A Document Content Entity that canonically appears as a interactive, tabular form."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spreadsheet&oldid=1064060503"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002043
cco:ont00002043 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002039 ;
                rdfs:label "Report"@en ;
                skos:definition "A Document Content entity that conveys an account of some event, situation, or the result of some observation or inquiry."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Report&oldid=1063765657"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002044
cco:ont00002044 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002039 ;
                rdfs:label "Form Document"@en ;
                skos:definition "A Document Content Entity that has Document Field Contents as parts."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Form_(document)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002045
cco:ont00002045 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002039 ;
                rdfs:label "Journal Article"@en ;
                skos:definition "A Document Content Entity that is part of a Journal Issue."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Academic_journal&oldid=1059723283"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002066
cco:ont00002066 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000552 ;
                rdfs:label "Explosive Mine"@en ;
                skos:altLabel "Mine"@en ,
                              "Mine Weapon"@en ;
                skos:definition "An Explosive Weapon that is designed to be concealed and to detonate as its target passes near it."@en ;
                skos:scopeNote "Being (relatively) stationary is a common but not necessary feature of explosive mines."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Explosive_mine&oldid=1116284461"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002067
cco:ont00002067 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00002066 ;
                rdfs:label "Explosive Naval Mine"@en ;
                skos:altLabel "Naval Mine"@en ,
                              "Sea Mine"@en ;
                skos:definition "An Explosive Mine that is designed to be concealed on or under water."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Naval_mine&oldid=1299942380"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002068
cco:ont00002068 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000995
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000196 ;
                                                             owl:someValuesFrom cco:ont00002069
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Display Instrument"@en ;
                skos:definition "A Material Artifact that is designed to bear an Image Display Artifact Function."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002069
cco:ont00002069 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Image Display Artifact Function"@en ;
                skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to display an Image."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002070
cco:ont00002070 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000003 ;
                rdfs:altLabel "Email Box Identifier"@en ;
                rdfs:label "Email Address"@en ;
                skos:definition "A Designative Name created in order to identify some Email Box as the destination of an email message for the purpose of Email Messaging."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002071
cco:ont00002071 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000433 ;
                rdfs:label "Act of Employment"@en ;
                skos:definition "An Act of Association wherein an Agent assigns a set of activities to some Person to be performed in exchange for financial compensation."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002073
cco:ont00002073 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "Sensor Role"@en ;
                skos:definition "A Role that inheres in an entity in virtue of it being used in a process wherein an attribute of its bearer acts as a proxy for some aspect of its sensing environment."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002074
cco:ont00002074 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "Sensor Platform Role"@en ;
                skos:definition "A Role that inheres in an entity in virtue of it being used to support or convey a Sensor during its deployment and functioning."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00002075
cco:ont00002075 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000015
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000055 ;
                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                  owl:unionOf ( cco:ont00001241
                                                                                                cco:ont00002073
                                                                                              )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf obo:BFO_0000015 ;
                rdfs:label "Sensing Process"@en ;
                skos:definition "A Process that realizes a Sensor Function or Sensor Role."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


#################################################################
#    Individuals
#################################################################

###  http://example.org/apqc#PCF_10002
ex:PCF_10002 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing a direction and vision for an organization. This involves defining the business concept and long-term vision, as well as developing the business strategy and managing strategic initiatives. Processes in this category focus on creating a vision, a mission, and strategic objectives, and culminate in creating measures to ensure that the organization is moving in the desired direction." ;
             ex:hierarchyID "1.0" ;
             ex:pcfID "10002" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop Vision and Strategy" .


###  http://example.org/apqc#PCF_10003
ex:PCF_10003 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Detailing practices and procedures related to the concept of developing and managing products and services. These are reflected in the process groups Govern and manage product/service development program [19696], Generate and define new product/service ideas [19698], and Develop products and services [10062]." ;
             ex:hierarchyID "2.0" ;
             ex:pcfID "10003" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and Manage Products and Services" .


###  http://example.org/apqc#PCF_10004
ex:PCF_10004 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining process groups related to understanding markets, customers, and capabilities; developing marketing strategies; executing marketing plans; developing sales strategies; developing and managing marketing plans; and managing sales partners and alliances." ;
             ex:hierarchyID "3.0" ;
             ex:pcfID "10004" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Market and Sell Products and Services" .


###  http://example.org/apqc#PCF_10007
ex:PCF_10007 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Delivering processes traditionally defined as \"human resources\". Process groups include those related to developing and maintaining workforce strategy, recruiting employees, developing and counseling employees, managing employee relations, rewarding and retaining employees, redeploying and retiring employees, managing employee information, and managing employee communications." ;
             ex:hierarchyID "7.0" ;
             ex:pcfID "10007" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and Manage Human Capital" .


###  http://example.org/apqc#PCF_10012
ex:PCF_10012 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Fostering external relationships with stakeholders of the entity, including investors, government and industry, the board of directors, and the general public. This is not related to customer management." ;
             ex:hierarchyID "12.0" ;
             ex:pcfID "10012" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage External Relationships" .


###  http://example.org/apqc#PCF_10013
ex:PCF_10013 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Performing activities by an organization that are fundamental to the successful operation of the organization, even across functions in a business. Capabilities defined in the PCF include business process management; portfolio, program, and project management; quality management; change management; benchmarking; environmental health and safety management; and knowledge management." ;
             ex:hierarchyID "13.0" ;
             ex:pcfID "10013" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and Manage Business Capabilities" .


###  http://example.org/apqc#PCF_10015
ex:PCF_10015 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing an organization's mission statement, strategy, and business design. Create a concise statement that clearly articulates the mission of the organization, outlining practicable targets to Establish a strategic vision [10020]. Delineate strategic options by matching these alternatives with the organization's internal capabilities. Create an organizational design, and identify goals by developing strategies at the functional and process levels." ;
             ex:designatesProcessType ex:P10015 ;
             ex:hierarchyID "1.2" ;
             ex:pcfID "10015" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10002 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop business strategy" .


###  http://example.org/apqc#PCF_10016
ex:PCF_10016 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing strategic initiatives, from development through selection, execution, and evaluation. Conduct and oversee strategic projects supporting long-term objectives. Administer programs of strategic significance by developing such initiatives, select the most appropriate projects, and formulate measures to assess their impact." ;
             ex:designatesProcessType ex:P10016 ;
             ex:hierarchyID "1.3" ;
             ex:pcfID "10016" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10002 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and measure strategic initiatives" .


###  http://example.org/apqc#PCF_10017
ex:PCF_10017 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing all forces, entities, and systems that are external to an organization but can affect its operation. Analyze far-reaching currents in the macroeconomic situation, assess the competition, evaluate technological changes, and identify societal as well as ecological issues of concern. Create a big-picture understanding of externalities, with sufficient depth across individual aspects." ;
             ex:designatesProcessType ex:P10017 ;
             ex:hierarchyID "1.1.1" ;
             ex:pcfID "10017" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17040 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess the external environment" .


###  http://example.org/apqc#PCF_10018
ex:PCF_10018 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the market to identify customer required solutions. Assess the relevant market(s) to determine the products/services that are needed or wanted by customers. Carry out quantitative and qualitative analyses to capture and investigate products/services. Employ creative techniques that allow for a closer appreciation of the customer, and design relevant solutions." ;
             ex:designatesProcessType ex:P10018 ;
             ex:hierarchyID "1.1.2" ;
             ex:pcfID "10018" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17040 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Survey market and determine customer needs and wants" .


###  http://example.org/apqc#PCF_10019
ex:PCF_10019 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Undertaking a review of the organization's in-house skills and resources in order to create a big-picture understanding of internal capacities. Assess the organization's capabilities in order to advance the advantageous and weed out the detrimental aspects. Identify synergic associations within the backdrop of the forces and players active in the market, and take into account all externalities." ;
             ex:designatesProcessType ex:P10019 ;
             ex:hierarchyID "1.1.3" ;
             ex:pcfID "10019" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17040 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess the internal environment" .


###  http://example.org/apqc#PCF_10020
ex:PCF_10020 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing the organization's long-term vision as a strategic positioning and engagement of stakeholders. Institute the vision by creating strategic orientations of all stakeholders. Understand the strategy development frameworks in this context." ;
             ex:designatesProcessType ex:P10020 ;
             ex:hierarchyID "1.1.4" ;
             ex:pcfID "10020" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17040 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish strategic vision" .


###  http://example.org/apqc#PCF_10021
ex:PCF_10021 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the competitive forces in the marketplace that could potentially affect the organization. Analyze various aspects of business competition including competing firms. Aggregate competitive intelligence, create benchmarks to juxtapose processes and performance metrics, and inject crucial information about the competition into management models to synthesize insights." ;
             ex:designatesProcessType ex:P10021 ;
             ex:hierarchyID "1.1.1.2" ;
             ex:pcfID "10021" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10017 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze and evaluate competition" .


###  http://example.org/apqc#PCF_10022
ex:PCF_10022 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining large-scale macroeconomic shifts and trends, with medium to long-term relevance for the organization. Vet the immediate and the larger economic ecosystem to identify broad-based movements that affect the organization. In the immediate vicinity, for example, examine the stock price of key vendors/suppliers in the organizational value-chain. In the larger economic ecosystem, analyze according to geographical distribution where factors such as interest rates, taxation structures, oil prices, and unemployment rates are explored." ;
             ex:designatesProcessType ex:P10022 ;
             ex:hierarchyID "1.1.1.4" ;
             ex:pcfID "10022" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10017 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify economic trends" .


###  http://example.org/apqc#PCF_10023
ex:PCF_10023 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying areas of concern pertaining to public policy and regulation, established by sovereign or multinational authorities. Examine various regions and geopolitical formations to identify those political and regulatory issues-present or developing-that can potentially affect the organization. Plan for an iterative process, partitioned across regional and geopolitical entities that have a direct bearing on the organization's activities. Assess changes in environmental compliance, product standards, trade barriers, etc." ;
             ex:designatesProcessType ex:P10023 ;
             ex:hierarchyID "1.1.1.5" ;
             ex:pcfID "10023" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10017 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify political and regulatory factors" .


###  http://example.org/apqc#PCF_10024
ex:PCF_10024 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing developments in technologies presently being used by the business, new technologies that have a potential for the business, and any disruptive innovations. Conduct a survey of advancement in technologies that are already deployed with inputs from the personnel closely working with them, tracking utility and feasibility for deployment. Arrange for mid- to senior-level management personnel who explore contingent uses to assess new and disruptive technologies. Follow up with desk research, involving physical scoping and viability assessment." ;
             ex:designatesProcessType ex:P10024 ;
             ex:hierarchyID "1.1.1.8" ;
             ex:pcfID "10024" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10017 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess new technologies" .


###  http://example.org/apqc#PCF_10025
ex:PCF_10025 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing statistical data relating to the size, distribution, and composition of relevant populations, as well as their characteristics. Perform quantitative analysis over raw data-sets gathered from well-founded sources such as government census or large, private databases. Consider employing primary research in collecting required statistics. Use comprehensive studies (reports, briefs, and articles) to assist with the analysis, in place of raw data." ;
             ex:designatesProcessType ex:P10025 ;
             ex:hierarchyID "1.1.1.9" ;
             ex:pcfID "10025" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10017 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze demographics" .


###  http://example.org/apqc#PCF_10026
ex:PCF_10026 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Distinguishing changes in societal makeup, as well as the cultural composite. Isolate shifts in the societal composition and distribution, as well as the value systems and attributes that bind the organization together. Analyze well-regarded publications--and gather the perspective of public intellectuals and opinion leaders--on relevant issues." ;
             ex:designatesProcessType ex:P10026 ;
             ex:hierarchyID "1.1.1.7" ;
             ex:pcfID "10026" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10017 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify social and cultural changes" .


###  http://example.org/apqc#PCF_10027
ex:PCF_10027 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying changes in ecological ecosystems that can be directly or indirectly detrimental to the organization. Analyze ecological factors within the immediate ecosystem for near to middle-term impact. Analyze the ecology, at large, to get a sense of long-term shifts and concerns. Gather analyses from research publications. Speak to subject matter experts. Engage with advocacy groups, lawyers, journalists, and the active populations." ;
             ex:designatesProcessType ex:P10027 ;
             ex:hierarchyID "1.1.1.6" ;
             ex:pcfID "10027" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10017 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify environmental factors" .


###  http://example.org/apqc#PCF_10028
ex:PCF_10028 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Investigating key market features and customer characteristics, using qualitative and quantitative measures to capture relevant aspects. Distill key ingredients that allow the organization to Capture customer needs and wants [19946], and Assess customer needs and wants [19947]. Conduct standardized appraisals by defining selection parameters and setting quotas." ;
             ex:designatesProcessType ex:P10028 ;
             ex:hierarchyID "1.1.2.1" ;
             ex:pcfID "10028" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10018 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct qualitative/quantitative research and assessments" .


###  http://example.org/apqc#PCF_10030
ex:PCF_10030 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and examining key attributes that differentiate the organization in the market and those that underscore the core of its operations. Consider how the organization functions. Reflect over tangible and intangible aspects in order to spot critical correlations and the interplay between these attributes. Have senior executives conduct the analysis, with input from management and operational personnel." ;
             ex:designatesProcessType ex:P10030 ;
             ex:hierarchyID "1.1.3.1" ;
             ex:pcfID "10030" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10019 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze organizational characteristics" .


###  http://example.org/apqc#PCF_10031
ex:PCF_10031 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing baselines that provide standards for assessing performance levels and allow for a relational benchmarking of current processes. Undertake a survey of archival performance records, conducted in conjunction by the management and the operations personnel. Take into account the organization's internal objectives, particularly for process improvement and enhancement. Understand industry best practices." ;
             ex:designatesProcessType ex:P10031 ;
             ex:hierarchyID "1.1.3.3" ;
             ex:pcfID "10031" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10019 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create baselines for current processes" .


###  http://example.org/apqc#PCF_10032
ex:PCF_10032 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing the capabilities of technology and process automation systems deployed within the organization in order to direct future associated processes. Conduct a broad-based survey to examine various aspects associated with such systems and technologies, with the objective of identifying key facets that are of interest. Investigate the intended purpose, purpose served, utility, longevity, remaining service-life, repair or service requirements, etc." ;
             ex:designatesProcessType ex:P10032 ;
             ex:hierarchyID "1.1.3.4" ;
             ex:pcfID "10032" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10019 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze systems and technology" .


###  http://example.org/apqc#PCF_10033
ex:PCF_10033 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Appraising the financial state of the organization so that management can create resource allocation strategies. Scrutinize the organization's financials--including balance sheets, statements of income, cash-flows, equity holdings, and liquidity--with the objective of understanding the organization's financial health and capacities. (This analysis directly feeds into Conduct organizational restructuring opportunities [16792] and Define a business concept and long-term vision [17040].)" ;
             ex:designatesProcessType ex:P10033 ;
             ex:hierarchyID "1.1.3.5" ;
             ex:pcfID "10033" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10019 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze financial health" .


###  http://example.org/apqc#PCF_10034
ex:PCF_10034 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining a strategically significant aggregate of competence and capacities that differentiates the organization in the market. Identify distinguishing attributes including unique skills and resources and its brand and services in the marketplace. Have senior executives and management personnel assess competencies in order to further develop these capabilities into distinct commercial value propositions." ;
             ex:designatesProcessType ex:P10034 ;
             ex:hierarchyID "1.1.3.6" ;
             ex:pcfID "10034" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10019 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify core competencies" .


###  http://example.org/apqc#PCF_10035
ex:PCF_10035 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Orienting those entities, associated with the organization that have a direct bearing on its operations and output, in a way that advances its strategic vision. Map all stakeholders in strategic configurations, within the architectural layout of the marketplace, and position the organization relative to them. (This exercise is undertaken by senior strategy personnel, drawing upon the process Define a business concept and long-term vision [17040].)" ;
             ex:designatesProcessType ex:P10035 ;
             ex:hierarchyID "1.1.4.2" ;
             ex:pcfID "10035" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10020 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Align stakeholders around strategic vision" .


###  http://example.org/apqc#PCF_10036
ex:PCF_10036 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and executing communication strategies to convey an alignment plan of all organizational stakeholders, which helps the organization realize its vision. Create custom communication strategies and delivery channels with the objective of orienting stakeholders according to the configuration maps created in the process Align stakeholders around a strategic vision [10035]. Have senior strategy personnel closely collaborate with the communications/marketing team." ;
             ex:designatesProcessType ex:P10036 ;
             ex:hierarchyID "1.1.4.3" ;
             ex:pcfID "10036" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10020 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate strategic vision to stakeholders" .


###  http://example.org/apqc#PCF_10037
ex:PCF_10037 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing an overarching, compact statement that concisely underscores the mission of the organization. Define and communicate a clear and succinct mission statement, which encapsulates how the organization aims to proceed in order to Establish a strategic vision [10020]. Solicit critical inputs from senior management and strategy executives, and collaborate with marketing or personnel from allied functions." ;
             ex:designatesProcessType ex:P10037 ;
             ex:hierarchyID "1.2.1" ;
             ex:pcfID "10037" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop overall mission statement" .


###  http://example.org/apqc#PCF_10038
ex:PCF_10038 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing sets of strategic decisions designed to drive the organization's long-term objectives. Identify various strategies concerning core functional areas. Appraise strategic options in light of auxiliary decision frameworks that ensure smooth functioning, the advancement of functional efficiencies, and vitality. Involve senior management executives, especially strategy and/or business unit personnel, with need-based consultative assistance from professional services providers." ;
             ex:designatesProcessType ex:P10038 ;
             ex:hierarchyID "1.2.2" ;
             ex:pcfID "10038" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define and evaluate strategic options to achieve the mission" .


###  http://example.org/apqc#PCF_10039
ex:PCF_10039 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a strategy for the achievement of business goals over the distant future. Adopt one of the strategic options for realizing its mission over the long term. Enlist senior management executives, comprising strategy and/or business unit personnel." ;
             ex:designatesProcessType ex:P10039 ;
             ex:hierarchyID "1.2.3" ;
             ex:pcfID "10039" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Set/Develop long-term enterprise strategy" .


###  http://example.org/apqc#PCF_10040
ex:PCF_10040 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Aligning the approach and method of individual units, departments, systems, and operations within the organization, in accordance with the larger strategic course adopted. Employ the organization's strategic path to guide the functions, divisions, and operations. Calibrate the plan and method of each functional area, as well as the processes therein, to Select the long-term business strategy [10039]." ;
             ex:designatesProcessType ex:P10040 ;
             ex:hierarchyID "1.2.4" ;
             ex:pcfID "10040" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Coordinate and align cross-functional and process strategies" .


###  http://example.org/apqc#PCF_10041
ex:PCF_10041 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Formulating a design for the organization's resources that allow it to meet its objectives. Develop a new framework for molding the organization's various processes into a coherent and seamless whole." ;
             ex:designatesProcessType ex:P10041 ;
             ex:hierarchyID "1.2.5" ;
             ex:pcfID "10041" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create organizational design" .


###  http://example.org/apqc#PCF_10042
ex:PCF_10042 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing overall goals for the organization that help in accomplishing its mission. Formulate organization-wide targets in the near to middle term, which will accumulate and propel the organization to realize its long-term objectives, as outlined in Develop an overall mission statement [10037]. Enlist business unit heads or equivalent personnel, in close collaboration with senior management executives." ;
             ex:designatesProcessType ex:P10042 ;
             ex:hierarchyID "1.2.6" ;
             ex:pcfID "10042" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and set organizational objectives" .


###  http://example.org/apqc#PCF_10043
ex:PCF_10043 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Charting a strategic course for business units in order to leverage opportunities, sidestep hurdles, and create synergies among each other. Create strategic road maps for the organization's units--in light of their individual resources and requirements, as well as their relationships with other business units--to achieve organizational goals." ;
             ex:designatesProcessType ex:P10043 ;
             ex:hierarchyID "1.2.7" ;
             ex:pcfID "10043" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Formulate business unit strategies" .


###  http://example.org/apqc#PCF_10044
ex:PCF_10044 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the status quo relating to the de facto core of what the business is. Reflect over the fundamental essence of what the business accomplishes and the manner in which it operates. Look beyond the obvious solution capabilities to delineate capacities that form the basis of the business engine. Involve senior executives and management personnel and possibly professional services providers." ;
             ex:designatesProcessType ex:P10044 ;
             ex:hierarchyID "1.2.1.1" ;
             ex:pcfID "10044" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10037 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define current business" .


###  http://example.org/apqc#PCF_10045
ex:PCF_10045 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining actionable objectives that effectively set a course to fulfill the organization's vision. In this fundamental activity, articulate certain goals or targets in broad but practicable terms to reach long-term objectives." ;
             ex:designatesProcessType ex:P10045 ;
             ex:hierarchyID "1.2.1.2" ;
             ex:pcfID "10045" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10037 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Formulate mission" .


###  http://example.org/apqc#PCF_10046
ex:PCF_10046 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and executing a communication strategy to convey the mission statement. Create a universal communication strategy and appropriate delivery channels, with the objective of leveraging the latter to execute the former. Convey the inherent message of the mission to all stakeholders, including employees, customers, and the public. Ensure collaboration between senior strategy personnel and the communications/marketing team." ;
             ex:designatesProcessType ex:P10046 ;
             ex:hierarchyID "1.2.1.3" ;
             ex:pcfID "10046" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10037 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate mission" .


###  http://example.org/apqc#PCF_10047
ex:PCF_10047 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the various options available to achieve the goals highlighted in the mission statement. Delineate (in accordance with a predefined criteria) the various permutations of strategic decisions that would help the organization achieve the objectives outlined in Develop overall mission statement [10037]. Involve senior management and key strategy personnel, with timely help from professional services providers." ;
             ex:designatesProcessType ex:P10047 ;
             ex:hierarchyID "1.2.2.1" ;
             ex:pcfID "10047" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10038 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define strategic options" .


###  http://example.org/apqc#PCF_10048
ex:PCF_10048 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Scoping and probing to study the impact of strategic options for fulfilling the organization's objectives. Estimate a measure of the impact effectuated by each set of strategic decisions, which comprise Define strategic options [10047]. Closely examine the consequences of each option." ;
             ex:designatesProcessType ex:P10048 ;
             ex:hierarchyID "1.2.2.2" ;
             ex:pcfID "10048" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10038 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess and analyze impact of each option" .


###  http://example.org/apqc#PCF_10049
ex:PCF_10049 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the structural makeup of the organization, including pertinent features of and associated synergies among constituent elements. Examine the organization's architectural framework, paying close attention to the individual elements, the relations among them, and the conjoint and co-acting forces therein. Analyze functions and processes, as well as work-related positions. Scrutinize various relevant characteristics associated with each of them, depending upon the scale, scope, and type of organization." ;
             ex:designatesProcessType ex:P10049 ;
             ex:hierarchyID "1.2.5.1" ;
             ex:pcfID "10049" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate breadth and depth of organizational structure" .


###  http://example.org/apqc#PCF_10050
ex:PCF_10050 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Appraising job-specific roles within the organizational chart and their hierarchical architecture. Analyze a map of work-related roles within the organizational structure. Examine the value added by the positions associated with jobs to be performed and how they stack up within the organization's operations." ;
             ex:designatesProcessType ex:P10050 ;
             ex:hierarchyID "1.2.5.2" ;
             ex:pcfID "10050" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform job-specific roles mapping and value-added analyses" .


###  http://example.org/apqc#PCF_10051
ex:PCF_10051 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the constituent exercises and undertakings within a work-related position for the purpose of effective delegation. Deconstruct job-specific roles into activities and visualize the relations among them, with the objective of assigning responsibilities to the appropriate personnel." ;
             ex:designatesProcessType ex:P10051 ;
             ex:hierarchyID "1.2.5.3" ;
             ex:pcfID "10051" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop role activity diagrams to assess hand-off activity" .


###  http://example.org/apqc#PCF_10052
ex:PCF_10052 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Organizing workshop sessions to adopt organizational redesign. Communicate the organizational structure and mapping of responsibilities against job roles in order to facilitate an effective understanding among personnel. Use a collaborative process that may include participative workshop sessions." ;
             ex:designatesProcessType ex:P10052 ;
             ex:hierarchyID "1.2.5.4" ;
             ex:pcfID "10052" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform organization redesign workshops" .


###  http://example.org/apqc#PCF_10053
ex:PCF_10053 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Fleshing out the connections and dependencies among the various units of the organization. Delineate the relationship among business units or process frameworks within the organization, in terms of activities, synergies, and shared resources and responsibilities. Formalize relationships among business units so that any mutual coherence is clearly understood and can be attended to." ;
             ex:designatesProcessType ex:P10053 ;
             ex:hierarchyID "1.2.5.5" ;
             ex:pcfID "10053" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design the relationships between organizational units" .


###  http://example.org/apqc#PCF_10054
ex:PCF_10054 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating an understanding of the fit between job roles and organizational processes in order to properly place personnel. Deconstruct key processes into constituent activities, and examine job-related roles. Take cues from Develop role activity diagrams to assess hand-off activity [10051]. Map appropriate positions against these important processes, which in turn expedite the deployment of staff members." ;
             ex:designatesProcessType ex:P10054 ;
             ex:hierarchyID "1.2.5.6" ;
             ex:pcfID "10054" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop role analysis and activity diagrams for key processes" .


###  http://example.org/apqc#PCF_10055
ex:PCF_10055 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Probing the repercussions of all practicable organizational design options. Analyze the significance and impact of workable organizational structure options. Closely examine the long-term impact of these frameworks over the functioning of the organization." ;
             ex:designatesProcessType ex:P10055 ;
             ex:hierarchyID "1.2.5.7" ;
             ex:pcfID "10055" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess organizational implication of feasible alternatives" .


###  http://example.org/apqc#PCF_10056
ex:PCF_10056 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Embracing and ratifying a new organizational structure. (Assume the new framework to be the best fit through Assess the organizational implications of feasible alternatives [10055].)" ;
             ex:designatesProcessType ex:P10056 ;
             ex:hierarchyID "1.2.5.8" ;
             ex:pcfID "10056" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10041 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Migrate to new organization" .


###  http://example.org/apqc#PCF_10057
ex:PCF_10057 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing strategic projects that help fulfill long-term goals. Develop time-bound projects that are discretionary in nature and lie beyond the scope of the organization's routine operations." ;
             ex:designatesProcessType ex:P10057 ;
             ex:hierarchyID "1.3.1" ;
             ex:pcfID "10057" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10016 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop strategic initiatives" .


###  http://example.org/apqc#PCF_10058
ex:PCF_10058 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining projects of strategic significance that lie outside the purview of the organization's routine operations. Closely analyze strategic initiatives for their applicability and feasibility, given the organization's vision." ;
             ex:designatesProcessType ex:P10058 ;
             ex:hierarchyID "1.3.2" ;
             ex:pcfID "10058" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10016 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate strategic initiatives" .


###  http://example.org/apqc#PCF_10059
ex:PCF_10059 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Selecting relevant projects of strategic significance that create opportunities for the organization to realize its long-term objectives, on the basis of their suitability to the organization's constraints and reality. Select from the process Evaluate strategic initiatives [10058], based on their applicability and feasibility for the organization. Enlist senior management, especially strategy personnel." ;
             ex:designatesProcessType ex:P10059 ;
             ex:hierarchyID "1.3.3" ;
             ex:pcfID "10059" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10016 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select strategic initiatives" .


###  http://example.org/apqc#PCF_10060
ex:PCF_10060 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Devising measures to examine strategic projects. Formulate evaluation criteria to assess the strategic initiatives for the level of impact." ;
             ex:designatesProcessType ex:P10060 ;
             ex:hierarchyID "1.3.4" ;
             ex:pcfID "10060" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10016 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish high-level measures" .


###  http://example.org/apqc#PCF_10061
ex:PCF_10061 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing a portfolio of product/service offerings to take advantage of shifts in the market expectations, all the while coordinating with the overall business strategy. Revisit the product/service portfolio in light of market opportunities, and overhaul it to capture value created by these opportunities. Identify gaps between current offerings and the market expectations to direct the organization's R&D activity. Create new solutions, and revise or retire existing ones so that the revamped portfolio aligns with Develop a business strategy [10015]." ;
             ex:designatesProcessType ex:ProductServicePortfolioManagementCapability ;
             ex:hierarchyID "2.1.1" ;
             ex:pcfID "10061" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_19696 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage product and service portfolio" .


###  http://example.org/apqc#PCF_10062
ex:PCF_10062 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing new products/services from scratch, including all activities associated with the design, prototyping, evaluation, and market testing of these planned offerings." ;
             ex:designatesProcessType ex:P10062 ;
             ex:hierarchyID "2.3" ;
             ex:pcfID "10062" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10003 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop products and services" .


###  http://example.org/apqc#PCF_10063
ex:PCF_10063 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the capabilities and performance of existing products/services, in light of market opportunities. Examine performance of the existing line of products/services, including measures of profitability, penetration, and value delivered. Identify gaps between existing solutions' portfolio or their performance levels, on the one hand, and the current market demand, available technologies, and/or customer expectations, on the other. Consider opportunities in the present market environment and any relation with the performance. Consider input from professional services providers." ;
             ex:designatesProcessType ex:P10063 ;
             ex:hierarchyID "2.1.1.1" ;
             ex:pcfID "10063" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10061 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate performance of existing products/services against market opportunities" .


###  http://example.org/apqc#PCF_10065
ex:PCF_10065 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Coordinating R&D activity to identify new technologies to integrate into the revamped portfolio of products/services. Conduct early-stage R&D activity to close gaps between existing solution offerings and changing market expectations. Triangulate appropriate technologies that can support the development of a revised product/service portfolio." ;
             ex:designatesProcessType ex:P10065 ;
             ex:hierarchyID "2.2.1" ;
             ex:pcfID "10065" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_19698 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform discovery research" .


###  http://example.org/apqc#PCF_10066
ex:PCF_10066 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Checking the alignment of product/service portfolio, and its individual offerings, with the organization's overall strategy and planning for the development of new or revised solutions. Conduct reality checks on new product/service concepts prior to committing significant investment to ensure that the revamped solutions' portfolio is in line with the overall business strategy, aligns organizational processes for their development, and creates a plan for assimilating these changes in the organization's offerings. Enlist senior management executives." ;
             ex:designatesProcessType ex:P10066 ;
             ex:hierarchyID "2.1.1.2" ;
             ex:pcfID "10066" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10061 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Confirm alignment of product/service concepts with business strategy" .


###  http://example.org/apqc#PCF_10067
ex:PCF_10067 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Manage the introduction and withdrawal of products/services. Administer associated changes, namely measuring the performance of new solution offerings and the revision of master files in the archives." ;
             ex:designatesProcessType ex:ProductServiceLifecycleManagementCapability ;
             ex:hierarchyID "2.1.2" ;
             ex:pcfID "10067" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_19696 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage product and service life cycle" .


###  http://example.org/apqc#PCF_10068
ex:PCF_10068 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining potential enhancements to current products/services in order to take advantage of a shift in market expectations. Identify how the existing line of products/services may be revised--through enhancements to individual solutions or across-the-board renovations--in order to capitalize on present opportunities in the market." ;
             ex:designatesProcessType ex:P10068 ;
             ex:hierarchyID "2.2.2.5" ;
             ex:pcfID "10068" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19669 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify potential improvements to existing products and services" .


###  http://example.org/apqc#PCF_10070
ex:PCF_10070 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining new technologies to revise the portfolio of solution offerings. Identify recently developed technological advances that can be leveraged in the development or advancement of the organization's product/service portfolio. Enlist senior management in conjunction with personnel responsible for the design, processing, and delivery of products/services. Have the organization's research division(s) carry out the process." ;
             ex:designatesProcessType ex:P10070 ;
             ex:hierarchyID "2.2.1.1" ;
             ex:pcfID "10070" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10065 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify new technologies" .


###  http://example.org/apqc#PCF_10071
ex:PCF_10071 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing new technologies from scratch to integrate into a revised portfolio of solutions. Develop new technological processes, models, and/or implements in-house, with the objective of improving existing solutions or creating new ones. Consider market realities, as well as the portfolio of products/services. Assess the results in conjunction with senior executives and personnel responsible for the design, processing, and delivery of these solutions. Engage the R&D function, and consider external sources such as offshore providers, specialized research agencies, and crowdsourcing communities." ;
             ex:designatesProcessType ex:P10071 ;
             ex:hierarchyID "2.2.1.2" ;
             ex:pcfID "10071" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10065 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop new technologies" .


###  http://example.org/apqc#PCF_10072
ex:PCF_10072 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Appraising the feasibility of integrating new technologies, whether developed as a custom solution or adopted from an external source, into revised portfolio of solution offerings. Examine recently developed technological advances for suitability to incorporate them into the concept of revised and/or new solution offerings. Enlist senior management, in consultation with in-house personnel responsible for the design, processing, and delivery of these solutions, as well as key supply-chain stakeholders." ;
             ex:designatesProcessType ex:P10072 ;
             ex:hierarchyID "2.2.1.3" ;
             ex:pcfID "10072" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10065 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess feasibility of integrating new leading technologies into product/service concepts" .


###  http://example.org/apqc#PCF_10073
ex:PCF_10073 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Setting prerequisites for the cost of development and quality standards for the new solutions' portfolio and/or its individual offerings. Set targets for the budget and quality standards for the revamped portfolio of solution offerings. Prepare a plan for the outlay required for revising and adding new product/services. Identify intended levels of quality for these, bearing in mind the existing standards of solutions offered by the organization and its competitors. Enlist senior management executives, particularly those responsible for finance and budgeting, product/service design, manufacturing/processing, delivery, and quality control." ;
             ex:designatesProcessType ex:P10073 ;
             ex:hierarchyID "2.1.1.4" ;
             ex:pcfID "10073" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10061 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan and develop cost and quality targets" .


###  http://example.org/apqc#PCF_10074
ex:PCF_10074 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Selecting from among the potential new/revised solutions and capitalizing on market opportunities so that they meet the cost and quality prerequisites. Create an index of product/service concepts, and arrange them in order of preference. Base prioritization on adherence to Plan and develop cost and quality targets [10073], and choose options that would comprise the revised solution portfolio." ;
             ex:designatesProcessType ex:P10074 ;
             ex:hierarchyID "2.1.1.3" ;
             ex:pcfID "10074" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10061 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prioritize and select new product/service concepts" .


###  http://example.org/apqc#PCF_10075
ex:PCF_10075 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the individual and collective timeframe for realizing new/revised solutions. Create a schedule that clearly demarcates the timeframes designated for the development of every new solution and/or revising each of the existing ones. Create a timetable by setting deadlines for each step in overhauling the product/service portfolio." ;
             ex:designatesProcessType ex:P10075 ;
             ex:hierarchyID "2.1.1.5" ;
             ex:pcfID "10075" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10061 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Specify development timing targets" .


###  http://example.org/apqc#PCF_10076
ex:PCF_10076 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a programmatic procedure for changing products/services while paying heed to all stakeholders involved and the prerequisites identified. Create a plan for changing the existing portfolio of solution offerings. Develop a systematic program for the design, processing, and delivery of the new product/service concepts. Construct project-flow diagrams. Identify the stakeholders involved and personnel responsible for each stage, as well as the necessary decisions. Earmark the budgetary outlay, and conduct any strategic planning required." ;
             ex:designatesProcessType ex:P10076 ;
             ex:hierarchyID "2.1.1.6" ;
             ex:pcfID "10076" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10061 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan for product/service offering modifications" .


###  http://example.org/apqc#PCF_10077
ex:PCF_10077 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Launching revamped product/service portfolio in to the market. Introduction in to the marketplace is done by deploying effective channels for marketing, sales, delivery, and after-sales servicing. Introduce new/revised solution offerings in a concerted effort. Coordinate a cross-functional effort." ;
             ex:designatesProcessType ex:P10077 ;
             ex:hierarchyID "2.1.2.2" ;
             ex:pcfID "10077" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10067 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Introduce new products/services" .


###  http://example.org/apqc#PCF_10078
ex:PCF_10078 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Removing nonconforming products and services. Withdraw those products/services that do not conform to market realities and are not positioned to take advantage of prevailing opportunities. Coordinate with processing/delivery teams within the organization and key stakeholders in the supply chain. Create mechanisms for continued after-sales servicing, as well as deploy effective public relations efforts in order to preserve the image and goodwill of the organization through the process." ;
             ex:designatesProcessType ex:P10078 ;
             ex:hierarchyID "2.1.2.3" ;
             ex:pcfID "10078" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10067 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Retire outdated products/services" .


###  http://example.org/apqc#PCF_10079
ex:PCF_10079 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Attuning the performance measures of products/services to better reflect the revamped portfolio of solution offerings. Revise the parameters used to measure performance, apropos the organization's product/service offerings. (Modify these standards in consideration of the changes made to the portfolio by Introduce new products/services [10077] and Retire outdated products/services [10078].)" ;
             ex:designatesProcessType ex:P10079 ;
             ex:hierarchyID "2.1.2.4" ;
             ex:pcfID "10079" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10067 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify and refine performance indicators" .


###  http://example.org/apqc#PCF_10083
ex:PCF_10083 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Allocating resources to the design, development, and evaluation of product/service concepts. Allocate funds, personnel, and time for developing the new and/or revised products/services. Begin to design the potential new product/service concepts that have been prioritized and selected for further development." ;
             ex:designatesProcessType ex:P10083 ;
             ex:hierarchyID "2.3.1.1" ;
             ex:pcfID "10083" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assign resources to product/service project" .


###  http://example.org/apqc#PCF_10084
ex:PCF_10084 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Preparing a business-level business case and a technical feasibility assessment in order to move the product/service projects forward. Weigh the costs and benefits of designing, developing, and evaluating the shortlisted product/service concepts. Prepare a business case to justify the product/service projects. Conduct a technical appraisal to ensure that the organization has the technical know-how and resources to further develop these concepts." ;
             ex:designatesProcessType ex:P10084 ;
             ex:hierarchyID "2.3.1.2" ;
             ex:pcfID "10084" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prepare high-level business case and technical assessment" .


###  http://example.org/apqc#PCF_10085
ex:PCF_10085 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating design specifications. Create specifications for the design of new or revised product/service concepts as a measure to meet during development. Have the senior functional-level solutioning or design staff create a framework of compliance standards for these products/services." ;
             ex:designatesProcessType ex:P10085 ;
             ex:hierarchyID "2.3.1.3" ;
             ex:pcfID "10085" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop product/service design specifications" .


###  http://example.org/apqc#PCF_10086
ex:PCF_10086 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Documenting requirements to meet in the design of new or revised products/services. Specify technical, quality, and costing requirements, as well as ergonomic, safety, and servicing requirements for such products/services. Ensure the information presented can be understood by the personnel executing the design and includes examples, anecdotal references, and illustrations." ;
             ex:designatesProcessType ex:P10086 ;
             ex:hierarchyID "2.3.1.6" ;
             ex:pcfID "10086" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Document design specifications" .


###  http://example.org/apqc#PCF_10087
ex:PCF_10087 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conducting any mandatory and elective appraisals of the product/service design specifications in order to ensure compliance with external standards. Carry out external reviews of specifications created for the development of new product/service designs. Conduct mandatory appraisals such as legal and regulatory, as well as any optional assessments that, for instance, pitch the specifications against industrial benchmarks." ;
             ex:designatesProcessType ex:P10087 ;
             ex:hierarchyID "2.3.1.7" ;
             ex:pcfID "10087" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct mandatory and elective external reviews" .


###  http://example.org/apqc#PCF_10088
ex:PCF_10088 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Building prototypes for shortlisted product/service concepts. Develop prototypes for those product/service concepts that have been identified for further development. Provide proof-of-concepts, and test any processes involved. Build prototypes in line with the design specifications already outlined. Enlist the solutioning and/or design staff." ;
             ex:designatesProcessType ex:P10088 ;
             ex:hierarchyID "2.3.1.9" ;
             ex:pcfID "10088" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Build prototypes/proof of concepts" .


###  http://example.org/apqc#PCF_10089
ex:PCF_10089 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Eliminating any problems relating to utility of the product/service over the course of its expected lifetime. Tweak the prototype in order to comply with the required quality and reliability standards. Further refine the prototype, so it may be subjected to testing." ;
             ex:designatesProcessType ex:P10089 ;
             ex:hierarchyID "2.3.1.11" ;
             ex:pcfID "10089" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Eliminate quality and reliability problems" .


###  http://example.org/apqc#PCF_10090
ex:PCF_10090 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Carrying out an in-house appraisal of the prototypes in order to validate design and feasibility. Test the product/service prototypes to confirm their compliance with design and usability standards. Corroborate the viability of the design, and validate the feasibility of their production. Identify any areas for improvement." ;
             ex:designatesProcessType ex:P10090 ;
             ex:hierarchyID "2.3.1.12" ;
             ex:pcfID "10090" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct in-house product/service testing and evaluate feasibility" .


###  http://example.org/apqc#PCF_10091
ex:PCF_10091 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying performance parameters. Determine the parameters to measure performance of the design and development of the product/service concepts into prototypes. " ;
             ex:designatesProcessType ex:P10091 ;
             ex:hierarchyID "2.3.1.13" ;
             ex:pcfID "10091" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify design/development performance indicators" .


###  http://example.org/apqc#PCF_10092
ex:PCF_10092 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Interacting with suppliers and manufactures to determine design decisions. Collaborate with vendors, suppliers, contractors, and subcontractors to verify feasibility of co-producing the prototype's design. Ensure that efforts can be coordinated with other stakeholders in the organization's supply chain ecosystem at the time of manufacturing, producing, or packaging the finished product/service." ;
             ex:designatesProcessType ex:P10092 ;
             ex:hierarchyID "2.3.1.14" ;
             ex:pcfID "10092" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Collaborate on design with suppliers and external partners" .


###  http://example.org/apqc#PCF_10093
ex:PCF_10093 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Composing a detailed study of the market ecosystem in light of new products/services. Conduct a detailed analysis of the targeted market(s) in order to Introduce new products/services [10077]. Examine the competition, market size and growth rate, market trends, customer segments and their characteristics, market influencers, distribution channels, and profitability. Enlist in-house marketing and/or solutioning teams, or outsource to specialized professional services agencies." ;
             ex:designatesProcessType ex:P10093 ;
             ex:hierarchyID "2.3.2.1" ;
             ex:pcfID "10093" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19996 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prepare detailed market study" .


###  http://example.org/apqc#PCF_10094
ex:PCF_10094 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conducting both qualitative and quantitative studies to determine the fit between the newly developed products/services and the customers. Conduct external tests of the new product/service, and then refine them to maximize the customer uptake. Gather feedback from prospective customers and targeted populations by conducting surveys, focus groups, interviews, and detailed studies. Enlist professional services such as public relations or market research organizations." ;
             ex:designatesProcessType ex:P10094 ;
             ex:hierarchyID "2.3.2.2" ;
             ex:pcfID "10094" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19996 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct customer tests and interviews" .


###  http://example.org/apqc#PCF_10095
ex:PCF_10095 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Finalizing the characteristics of new products/services by appropriately weighing feedback from prospective customers against a cost-benefit analysis in order to produce a profitable business proposition. Refine the attributes of the newly developed products/services, in light of the feedback and insights collected during Conduct customer tests and interviews [10094]. Revisit the high-level business case to justify the resources assigned to the product/service project against the anticipated benefits." ;
             ex:designatesProcessType ex:P10095 ;
             ex:hierarchyID "2.3.2.3" ;
             ex:pcfID "10095" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19996 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Finalize product/service characteristics and business cases" .


###  http://example.org/apqc#PCF_10096
ex:PCF_10096 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reassessing the technical requirements in light of the final product/service attributes. Revisit the technical assessment to revalidate the organization's capacity for progressing with new product/service projects, in light of the revised product/service characteristics." ;
             ex:designatesProcessType ex:P10096 ;
             ex:hierarchyID "2.3.2.4" ;
             ex:pcfID "10096" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19996 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Finalize technical requirements" .


###  http://example.org/apqc#PCF_10097
ex:PCF_10097 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying any changes that need to be effectuated in the organization's internal processes for manufacturing, and delivering the newly developed products/services. Determine if any changes need to be made to the production and distribution processes, in light of the new products/services. Begin production process planning. Prepare for factory layout planning. Generate shop-floor instructions and changes to the supply chain." ;
             ex:designatesProcessType ex:P10097 ;
             ex:hierarchyID "2.3.3.2" ;
             ex:pcfID "10097" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19997 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify requirements for changes to manufacturing/delivery processes" .


###  http://example.org/apqc#PCF_10098
ex:PCF_10098 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating the new manufacturing/delivery processes for the new products/services, and testing them to ensure proper functioning. Create the production/delivery process for the prototypes that have been built for the new products/services. Conduct trial-runs to test these processes and their integration with the organization's other processes." ;
             ex:designatesProcessType ex:P10098 ;
             ex:hierarchyID "2.3.1.10" ;
             ex:pcfID "10098" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19993 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and test prototype production and/or service delivery process" .


###  http://example.org/apqc#PCF_10099
ex:PCF_10099 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and/or sourcing the essential machinery needed for creating purpose-built processes, as well as the raw materials, to produce the new products/services. Either design the equipment and materials needed internally, or source from external vendors. Obtain the feedstock or raw materials needed to prepare the finished products, as well as the machinery - hardware and software - needed to arrange production lines, factory operations, assemblies, and manufacturing processes. Revisit the technologies that underpin the new or revised products/services in order to source the right equipment and materials." ;
             ex:designatesProcessType ex:P10099 ;
             ex:hierarchyID "2.3.3.1" ;
             ex:pcfID "10099" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19997 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design and obtain necessary capabilities/materials and equipment" .


###  http://example.org/apqc#PCF_10100
ex:PCF_10100 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Finalizing production process or methodology. Install and initiate the production process to manufacture the new products, using the equipment and machinery already assembled. In the case of new services, implement delivery processes and methodologies. Validate processes for the accuracy of their operation and proper functioning." ;
             ex:designatesProcessType ex:P10100 ;
             ex:hierarchyID "2.3.3.4" ;
             ex:pcfID "10100" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19997 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Install and validate production/service delivery process" .


###  http://example.org/apqc#PCF_10101
ex:PCF_10101 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Making sense of the market and customers to identify the right opportunities to be capitalized, given the organization's competencies. Discern trends and shift in the market and customers. Identify the right market opportunities that fit closely with the organization's capabilities and strategy by gathering intelligence on various attributes of different market/customer segments." ;
             ex:designatesProcessType ex:P10101 ;
             ex:hierarchyID "3.1" ;
             ex:pcfID "10101" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10004 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Understand markets, customers, and capabilities" .


###  http://example.org/apqc#PCF_10102
ex:PCF_10102 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Charting a strategic course for marketing products/services. This will include defining the value proposition, creating a mechanism for pricing, and determining the right mix of marketing channels. Create a specific positioning and branding for the organization's offerings. Enlist marketing head to lead, with inputs from the business development and sales functions." ;
             ex:designatesProcessType ex:P10102 ;
             ex:hierarchyID "3.2" ;
             ex:pcfID "10102" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10004 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop marketing strategy" .


###  http://example.org/apqc#PCF_10103
ex:PCF_10103 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing concrete plans for guiding and providing support to the sales function. Chart a road map for the sales function, including an analysis of historical sales data to create forecasts for anticipated sales, forming sales targets, forging partnerships with other economic agents to boost sales, devising a budget for this function, and determining metrics to measure customer management activities as well as progress in achieving sales targets." ;
             ex:designatesProcessType ex:P10103 ;
             ex:hierarchyID "3.4" ;
             ex:pcfID "10103" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10004 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop sales strategy" .


###  http://example.org/apqc#PCF_10105
ex:PCF_10105 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Selling products/services. Set appropriate customer expectations. Work with customers using the same schedule that product/service development, production, and customer service functions follow. Manage sales personnel and sales partnerships/alliances." ;
             ex:designatesProcessType ex:P10105 ;
             ex:hierarchyID "3.5" ;
             ex:pcfID "10105" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10004 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and manage sales plans" .


###  http://example.org/apqc#PCF_10106
ex:PCF_10106 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Gathering intelligence on the market and customers. Closely examine the inherent attributes and collective behavior of the various market and customer segments. Track trends in the market. Determine what drives the customers to make purchasing decisions in order to identify opportunities in the market." ;
             ex:designatesProcessType ex:P10106 ;
             ex:hierarchyID "3.1.1" ;
             ex:pcfID "10106" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10101 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform customer and market intelligence analysis" .


###  http://example.org/apqc#PCF_10107
ex:PCF_10107 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Appraising market opportunities by quantifying and subjecting them to prioritization, as well as validation tests. Closely examine the market opportunities that have been identified by Perform customer and market intelligence analysis [10106]. Triangulate those opportunities to capitalize by finding a fit between identified opportunities and the composite of organizational capabilities and business strategy." ;
             ex:designatesProcessType ex:P10107 ;
             ex:hierarchyID "3.1.2" ;
             ex:pcfID "10107" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10101 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate and prioritize market opportunities" .


###  http://example.org/apqc#PCF_10108
ex:PCF_10108 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Carrying out research studies to understand the behavior of customers and the realities of the market. Undertake research to understand the market conditions as well as the characteristics, drives, and desires of prospective customers. Gather highly contextualized intelligence through primary and secondary research methods, with the objective of gaining insights over how to best seize a market opportunity. Consider assistance from professional research services." ;
             ex:designatesProcessType ex:P10108 ;
             ex:hierarchyID "3.1.1.1" ;
             ex:pcfID "10108" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10106 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct customer and market research" .


###  http://example.org/apqc#PCF_10109
ex:PCF_10109 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying a section of the customer population to target for marketing products/services. Create segments within the customer population for targeted marketing campaigns, which increase the efficacy of marketing outlay. Determine the right customer segments, craft effective marketing messages, and efficiently communicate them. Determine the optimal pricing mix. Consider assistance from professional services for market segmentation studies, with coordination and oversight from the marketing/sales functions." ;
             ex:designatesProcessType ex:P10109 ;
             ex:hierarchyID "3.1.1.2" ;
             ex:pcfID "10109" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10106 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify market segments" .


###  http://example.org/apqc#PCF_10110
ex:PCF_10110 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining large-scale shifts and trends, with relevance to the organization's products/services. Vet the industrial and larger market landscape to identify broad-based movements that could have a direct or tangential impact on the uptake of the organization's products/services. Examine, among other things, the market capitalization of similar products, the profitability of organizations offering competing products/services, the stock price of key vendors/suppliers in the organizational value-chain, the rate and scale of innovation activity in the organization's product/service category, the price and availability of raw materials, and the shelf-life of similar products/services. Conduct primary and secondary research, and consider enlisting professional services." ;
             ex:designatesProcessType ex:P10110 ;
             ex:hierarchyID "3.1.1.3" ;
             ex:pcfID "10110" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10106 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze market and industry trends" .


###  http://example.org/apqc#PCF_10111
ex:PCF_10111 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the strengths and weaknesses of competing organizations. Assess competing organizations for offerings, product strategy, marketing and delivery channels, etc. Analyze the usability experience, durability, USP, and other key attributes of competing and substitute products. Gather competitive intelligence, and consider enlisting professional services." ;
             ex:designatesProcessType ex:P10111 ;
             ex:hierarchyID "3.1.1.4" ;
             ex:pcfID "10111" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10106 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze competing organizations, competitive/substitute products/services" .


###  http://example.org/apqc#PCF_10112
ex:PCF_10112 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the brands owned and products offered in the market. Determine the relative position of the existing products/brands in the marketplace." ;
             ex:designatesProcessType ex:P10112 ;
             ex:hierarchyID "3.1.1.5" ;
             ex:pcfID "10112" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10106 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate existing products/services" .


###  http://example.org/apqc#PCF_10113
ex:PCF_10113 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Understanding the culture and environment in which you're operating. Analyze how internal decision-making, thought processes, financial circumstances, and more affect the ability to bring new products to market. Survey or analyze the market into which the products would be introduced." ;
             ex:designatesProcessType ex:P10113 ;
             ex:hierarchyID "3.1.1.6" ;
             ex:pcfID "10113" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10106 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess internal and external business environment" .


###  http://example.org/apqc#PCF_10114
ex:PCF_10114 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying the factors that drive the targeted market segment. Model customer purchasing patterns, and forecast their future purchasing behavior. " ;
             ex:designatesProcessType ex:P10114 ;
             ex:hierarchyID "3.1.1.1.1" ;
             ex:pcfID "10114" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10108 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Understand consumer needs and historical behaviors" .


###  http://example.org/apqc#PCF_10115
ex:PCF_10115 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the increase or decrease of the company's sales volume in the targeted markets. Conduct an analysis to determine the factors and underlying causes that affect the changes in the demand for products or services offered. Consider changes in offerings or in the business strategy to regain or increase the market share." ;
             ex:designatesProcessType ex:P10115 ;
             ex:hierarchyID "3.1.1.2.1" ;
             ex:pcfID "10115" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10109 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine market share gain/loss" .


###  http://example.org/apqc#PCF_10116
ex:PCF_10116 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Attaching quantifiable indicators to opportunities that have been identified in the market. Compute estimated figures of the approximate value that can be captured with the provision of existing products/services (i.e., the extent of financial benefits that can be reaped in the market)." ;
             ex:designatesProcessType ex:P10116 ;
             ex:hierarchyID "3.1.2.1" ;
             ex:pcfID "10116" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10107 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Quantify market opportunities" .


###  http://example.org/apqc#PCF_10117
ex:PCF_10117 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying the targeted segment of customers. Deduce those particular customer segments that are to be targeted from among the market segments. " ;
             ex:designatesProcessType ex:P10117 ;
             ex:hierarchyID "3.1.2.2" ;
             ex:pcfID "10117" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10107 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine target segments" .


###  http://example.org/apqc#PCF_10118
ex:PCF_10118 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating an index of market opportunities, and arrange them in order of preference. Prioritize based on the opportunities' adherence to the overall business strategy. Correlate with the competencies and capacities that the organization, as a whole, processes." ;
             ex:designatesProcessType ex:P10118 ;
             ex:hierarchyID "3.1.2.3" ;
             ex:pcfID "10118" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10107 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prioritize opportunities consistent with capabilities and overall business strategy" .


###  http://example.org/apqc#PCF_10119
ex:PCF_10119 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Confirming the practicability and reasonableness of the market opportunities that have been identified. Give substance to the real-time feasibility of the market opportunities." ;
             ex:designatesProcessType ex:P10119 ;
             ex:hierarchyID "3.1.2.4" ;
             ex:pcfID "10119" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10107 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Validate opportunities" .


###  http://example.org/apqc#PCF_10120
ex:PCF_10120 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Validating identified market opportunities by testing company's offerings on limited-size samples of the consumer population that are hypothesized to be representative of the target market at large and to have similar purchasing behavior. The feedback gained through consumer testing can be used to modify or reject product offerings before their full scale launch, saving the company valuable resources, should the initial offering not be successful." ;
             ex:designatesProcessType ex:P10120 ;
             ex:hierarchyID "3.1.2.4.1" ;
             ex:pcfID "10120" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10119 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Test with customers/consumers" .


###  http://example.org/apqc#PCF_10121
ex:PCF_10121 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Verifying that the company has sufficient infrastructure and resources to deliver their offerings in a timely and cost-effective manner, and that it is able to scale up from the small-scale market samples, used for consumer testing, to the entire identified market segment." ;
             ex:designatesProcessType ex:P10121 ;
             ex:hierarchyID "3.1.2.4.2" ;
             ex:pcfID "10121" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10119 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Confirm internal capabilities" .


###  http://example.org/apqc#PCF_10123
ex:PCF_10123 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a pricing strategy and mechanism that aligns with the benefits of the products/services, as perceived by customers. Chart a strategic course and a methodology that can guide the pricing of products/services. Draw heavily from the customer value proposition, and balance the expectations of different divisions inside the organization, while delivering the maximum ROI." ;
             ex:designatesProcessType ex:P10123 ;
             ex:hierarchyID "3.2.2" ;
             ex:pcfID "10123" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10102 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define pricing strategy" .


###  http://example.org/apqc#PCF_10124
ex:PCF_10124 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a framework that allows for a uniform methodology while determining the price of individual offerings. Devise a blueprint for establishing the pricing of specific products/services. Create guidelines that factor in the cost of production/servicing, price sensitivity, product lifecycle, and the price of competing/substitute products." ;
             ex:designatesProcessType ex:P10124 ;
             ex:hierarchyID "3.2.2.2" ;
             ex:pcfID "10124" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10123 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish guidelines for applying pricing and discounting of products/services" .


###  http://example.org/apqc#PCF_10125
ex:PCF_10125 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Confirming the strategy and specifications developed for pricing the organization's products/services. Approve pricing guidelines by vetting the soundness of the methodology and the guidelines' alignment with the value proposition." ;
             ex:designatesProcessType ex:P10125 ;
             ex:hierarchyID "3.2.2.4" ;
             ex:pcfID "10125" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10123 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Approve pricing strategies/policies and targets" .


###  http://example.org/apqc#PCF_10126
ex:PCF_10126 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the attributes of all marketing channels, and evaluating the key partners in those channels. Closely examine the various characteristics of all available marketing channels such as the cost of using them, durability of impact, applicability to the organization's products/services, turn-around time, involvement of middlemen, and conversion rate. Analyze key partners in the marketing channels including those who have been associated with the organization; evaluate their capabilities, the scale and scope of their operations, quality of support provided, etc." ;
             ex:designatesProcessType ex:P10126 ;
             ex:hierarchyID "3.2.3.6" ;
             ex:pcfID "10126" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20000 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate channel attributes and potential partners" .


###  http://example.org/apqc#PCF_10127
ex:PCF_10127 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyze the various channels for their relevance to the targeted segments. Identify the channel that can effectively market to the targeted customers in regard to the drives, desires, and characteristics of these populations, their uptake, extent of engagement, frequency of use, and effectiveness in communicating." ;
             ex:designatesProcessType ex:P10127 ;
             ex:hierarchyID "3.2.3.3" ;
             ex:pcfID "10127" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20000 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine channel role and fit with target segments" .


###  http://example.org/apqc#PCF_10128
ex:PCF_10128 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Choose the most pertinent marketing channel for the targeted segments (based on Determine channel fit with target segments [10127])." ;
             ex:designatesProcessType ex:P10128 ;
             ex:hierarchyID "3.2.3.4" ;
             ex:pcfID "10128" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20000 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select channels for target segments" .


###  http://example.org/apqc#PCF_10129
ex:PCF_10129 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a sales forecast for the organization's portfolio of offerings, bearing in mind the effect of promotional events, and fine-tuning these in the context of the new forecast. Estimate the future demand for the organization's products/services by analyzing historical information and any promotional activity." ;
             ex:designatesProcessType ex:P10129 ;
             ex:hierarchyID "3.4.1" ;
             ex:pcfID "10129" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10103 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop sales forecast" .


###  http://example.org/apqc#PCF_10130
ex:PCF_10130 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Cultivating an alliance of partners by identifying, analyzing, negotiating, and managing partnerships with other economic agents." ;
             ex:designatesProcessType ex:P10130 ;
             ex:hierarchyID "3.4.2" ;
             ex:pcfID "10130" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10103 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop sales partner/alliance relationships" .


###  http://example.org/apqc#PCF_10131
ex:PCF_10131 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Setting up a financial plan for the sales function. Calculate the estimated sales revenue and costs, which helps in calculating the overall net profit. Create a sound plan for resource outlay by comparing the forecast with historical data." ;
             ex:designatesProcessType ex:P10131 ;
             ex:hierarchyID "3.4.3" ;
             ex:pcfID "10131" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10103 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish overall sales budgets" .


###  http://example.org/apqc#PCF_10132
ex:PCF_10132 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing specific quantitative and qualitative measures of realizing sales targets. Create sales targets by analyzing historical sales data and comparing the forecasts to results, in light of customer and market intelligence. Examine the performance of sales personnel in light of market opportunities. Based on this review, establish sales targets along with metrics to quantify these goals, corresponding with the overall business strategy." ;
             ex:designatesProcessType ex:P10132 ;
             ex:hierarchyID "3.4.4" ;
             ex:pcfID "10132" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10103 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish sales goals and measures" .


###  http://example.org/apqc#PCF_10133
ex:PCF_10133 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying the appropriate measures that can represent key attributes of the customer management function. Select measures to track customer activity, feedback, satisfaction, organizational responsiveness to customer needs, and general data on how the organization is managing customer accounts, leads, and contacts. Build on customer and market intelligence to identify metrics gauging aspects related to customer management. Select measures based on the nature of the business, the type and size of customer base, strategic goals, and the model used to structure sales and customer relationships." ;
             ex:designatesProcessType ex:P10133 ;
             ex:hierarchyID "3.4.5" ;
             ex:pcfID "10133" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10103 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish customer management measures" .


###  http://example.org/apqc#PCF_10134
ex:PCF_10134 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Gathering all information about sales orders into an index. Create a directory of all sales orders, whether open or those which have been fulfilled. Track what product/service was ordered, the quantity ordered, who ordered it, the delivery date, the shipping method, the unit price and line total, payment terms, and any discount applied." ;
             ex:designatesProcessType ex:P10134 ;
             ex:hierarchyID "3.4.1.1" ;
             ex:pcfID "10134" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10129 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Gather current and historic order information" .


###  http://example.org/apqc#PCF_10135
ex:PCF_10135 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing sales order data to identify patterns in order to capitalize on emerging trends in the industry or the economy. Closely examine the directory of sales orders. Discern any patterns from this index, which is representative of the demand for the organization's offerings. Identify trends among the various segments of the organization's customer base to create forecasts. Glean patterns from this analysis, including the triangulation of segments that are showing the most growth in demand or those that represent the highest decline revenue, industry-wide trends such as decline/boost in overall demand, and any unusual trends that lie outside of the organization's expectations." ;
             ex:designatesProcessType ex:P10135 ;
             ex:hierarchyID "3.4.1.2" ;
             ex:pcfID "10135" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10129 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze sales trends and patterns" .


###  http://example.org/apqc#PCF_10136
ex:PCF_10136 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating the future demand for the organization's products/services. Use the trends and patterns identified in the sales data to estimate future demand. Use forecast to prepare for future customer demand and to recalibrate the strategic course of functions and business units." ;
             ex:designatesProcessType ex:P10136 ;
             ex:hierarchyID "3.4.1.3" ;
             ex:pcfID "10136" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10129 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Generate sales forecast" .


###  http://example.org/apqc#PCF_10137
ex:PCF_10137 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reviewing promotional activities' effect on the sales orders. Analyze all promotional events and campaigns that the organization has already employed or is planning to deploy. " ;
             ex:designatesProcessType ex:P10137 ;
             ex:hierarchyID "3.4.1.4" ;
             ex:pcfID "10137" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10129 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze historical and planned promotions and events" .


###  http://example.org/apqc#PCF_10138
ex:PCF_10138 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying collaboration opportunities for selling, marketing, and distributing the organization's products/services. Determine any scope for partnering with other economic agents, with synergies for the marketing, sales, and/or distribution of the organization's products/services. Identify alliance opportunities that target customer segments who would be interested." ;
             ex:designatesProcessType ex:P10138 ;
             ex:hierarchyID "3.4.2.1" ;
             ex:pcfID "10138" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10130 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify alliance opportunities" .


###  http://example.org/apqc#PCF_10139
ex:PCF_10139 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating the frameworks needed to select alliance partners, and maintaining relationships with them. Create a framework for structured programs that can receive and support multiple alliances. Clearly outline the responsibilities and benefits of the alliance partners. Create frameworks for selecting the right alliance partners, and maintain a relationship with them. Create or repurpose teams of relationship managers and outline a methodology for selecting alliance partners." ;
             ex:designatesProcessType ex:P10139 ;
             ex:hierarchyID "3.4.2.2" ;
             ex:pcfID "10139" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10130 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design alliance programs and methods for selecting and managing relationships" .


###  http://example.org/apqc#PCF_10140
ex:PCF_10140 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Choosing alliance partners using the selected programs and methodology. Select the most feasible and profitable alliance partners, based on Design alliance programs and methods for selecting and managing relationships [10139] and through a careful scrutiny of the potential alliance." ;
             ex:designatesProcessType ex:P10140 ;
             ex:hierarchyID "3.4.2.3" ;
             ex:pcfID "10140" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10130 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select alliances" .


###  http://example.org/apqc#PCF_10141
ex:PCF_10141 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing strategies for effectively managing, identifying, and countering any possible issues from the alliance partnerships formed. Create a strategic road map for managing the partnerships forged through Design alliance programs and methods for selecting and managing relationships [10139]. Determine where the alliance partnerships are headed, possible problems or pushback from the partners, how these issues might be countered, how these alliance partnerships would evolve in the future, any other business cases where these partnerships might be deployed, etc." ;
             ex:designatesProcessType ex:P10141 ;
             ex:hierarchyID "3.4.2.7" ;
             ex:pcfID "10141" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10130 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop partner and alliance management strategies" .


###  http://example.org/apqc#PCF_10142
ex:PCF_10142 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Setting targets for organizational achievement. This includes what the organization aims to achieve from and how it wishes to manage both the individual partners and the alliance as a whole. Set immediate through long-term goals including revenue targets, market penetration, footfall numbers, and geographical coverage." ;
             ex:designatesProcessType ex:P10142 ;
             ex:hierarchyID "3.4.2.8" ;
             ex:pcfID "10142" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10130 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish partner and alliance management goals" .


###  http://example.org/apqc#PCF_10143
ex:PCF_10143 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Estimating revenue from the sale of products/services. Approximate the anticipated sale of products/services and multiply it by the selling price of the respective offering. (This represents the total amount of money that the organization receives from the sale of its portfolio of offerings.)" ;
             ex:designatesProcessType ex:P10143 ;
             ex:hierarchyID "3.4.3.2" ;
             ex:pcfID "10143" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10131 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate product revenue" .


###  http://example.org/apqc#PCF_10144
ex:PCF_10144 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating the variable costs of production. Approximate those costs that depend on the volume of products/services produced by the organization." ;
             ex:designatesProcessType ex:P10144 ;
             ex:hierarchyID "3.4.3.3" ;
             ex:pcfID "10144" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10131 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine variable costs" .


###  http://example.org/apqc#PCF_10145
ex:PCF_10145 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating the overhead costs associated with selling the organization's products/services. Determine fixed costs that are not directly related to the volume of products/services processed or the sale of these offerings (e.g., expense over machinery and equipment)." ;
             ex:designatesProcessType ex:P10145 ;
             ex:hierarchyID "3.4.3.4" ;
             ex:pcfID "10145" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10131 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine overhead and fixed costs" .


###  http://example.org/apqc#PCF_10146
ex:PCF_10146 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating the net income. Calculate the organization's profitability by accounting for Determine overhead and fixed costs [10145] and Determine variable costs [10144]." ;
             ex:designatesProcessType ex:P10146 ;
             ex:hierarchyID "3.4.3.5" ;
             ex:pcfID "10146" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10131 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate net profit" .


###  http://example.org/apqc#PCF_10147
ex:PCF_10147 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan in measurable terms for the financial outlay that best captures resource allocation for the sales forecast. Consider the outlay of capital, HR, raw materials, and provisions needed to reach sales targets." ;
             ex:designatesProcessType ex:P10147 ;
             ex:hierarchyID "3.4.3.6" ;
             ex:pcfID "10147" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10131 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create budget" .


###  http://example.org/apqc#PCF_10148
ex:PCF_10148 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining what to achieve by marketing. Create qualitative and quantitative targets. Establish metrics to track performance (for individual Market segments [10109] and Channels for target segments [10129]). Enlist the head of marketing to determine marketing priorities and the related measures. (The decision in establishing these goals, objectives, and metrics is founded in Develop marketing strategy [10102] and takes cues from current priorities and organizational strategy.)" ;
             ex:designatesProcessType ex:P10148 ;
             ex:hierarchyID "3.3.1" ;
             ex:pcfID "10148" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20008 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish goals, objectives, and measures for products/services by channel/segment" .


###  http://example.org/apqc#PCF_10149
ex:PCF_10149 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a budget for the organization's marketing efforts, in line with the business-wide strategic outlook. Create a plan to distribute resources for achieving the marketing strategy in light of the overall business strategy. Make cost assumptions; calculate the estimated total revenue from the marketing activities against the costs/expenses of these activities. Forecast the return on investment. Attribute costs to the appropriate marketing activities such as promotional campaigns, advertising, marketing communications, PR campaigns, personnel, and office space. Enlist the financial and marketing functions." ;
             ex:designatesProcessType ex:P10149 ;
             ex:hierarchyID "3.3.2" ;
             ex:pcfID "10149" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20008 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish marketing budgets" .


###  http://example.org/apqc#PCF_10153
ex:PCF_10153 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Collating all customer-centered metrics. The objective is to create a big-picture view of the customers' mindset and their behavior pertaining to the organization's offerings." ;
             ex:designatesProcessType ex:P10153 ;
             ex:hierarchyID "3.3.5" ;
             ex:pcfID "10153" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20008 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track customer management measures" .


###  http://example.org/apqc#PCF_10154
ex:PCF_10154 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating, executing, and administering a strategic road map for packaging products/services. Determine how to package products/services into finished offerings that can be directly marketed to prospective customers. Consider physicality, perishability, and shelf-life. Develop a strategy for packaging products/services. Test alternatives. Collect feedback. Refine the option chosen for execution. Have marketing, product development, and supply chain functions work together to develop sound packaging." ;
             ex:designatesProcessType ex:MarketingManagementCapability ;
             ex:hierarchyID "3.3.7" ;
             ex:pcfID "10154" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20008 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and manage packaging strategy" .


###  http://example.org/apqc#PCF_10155
ex:PCF_10155 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ensuring corroboration of the marketing strategy and the organizational strategy. Ensure the organization's marketing strategy/plan aligns with the overall business strategy. Fine-tune the marketing plan according to the organizational strategy." ;
             ex:designatesProcessType ex:P10155 ;
             ex:hierarchyID "3.3.2.1" ;
             ex:pcfID "10155" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10149 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Confirm marketing alignment to business strategy" .


###  http://example.org/apqc#PCF_10156
ex:PCF_10156 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating the total cost of marketing the organization's portfolio of products/services. Calculate the total outlay needed for promoting, selling, and delivering the organization's products/services to customers. Account for all costs to acquire customers and sustain a relationship with them. Include the expenses needed for promotional actives, warehousing, transactional costs, and distribution of the organization's offering." ;
             ex:designatesProcessType ex:P10156 ;
             ex:hierarchyID "3.3.2.2" ;
             ex:pcfID "10156" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10149 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine costs of marketing" .


###  http://example.org/apqc#PCF_10157
ex:PCF_10157 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Estimating the outlay required for promoting, selling, and distributing the products/services of the organization. Add up the expenses of all activities necessitated in marketing, such as promotional campaigns, advertising, marketing communications, PR campaigns, employing skilled personnel, and office space." ;
             ex:designatesProcessType ex:P10157 ;
             ex:hierarchyID "3.3.2.3" ;
             ex:pcfID "10157" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10149 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create marketing budget" .


###  http://example.org/apqc#PCF_10159
ex:PCF_10159 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing the central messages for a segment of its customers. Craft concise statements that position the value proposition of individual products/services around the pressing concerns in the market, thereby showing how the organization's offerings are the right fit for the customers." ;
             ex:designatesProcessType ex:P10159 ;
             ex:hierarchyID "3.3.4.2" ;
             ex:pcfID "10159" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop marketing messages" .


###  http://example.org/apqc#PCF_10160
ex:PCF_10160 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the appropriate audience to direct marketing efforts at. Identify the particular group of customers to target. Discover the appropriate customer groups at a micro-level. Use techniques such as segmentation analysis, whereby the entire population is sliced according to certain demographic or behavioral attributes." ;
             ex:designatesProcessType ex:P10160 ;
             ex:hierarchyID "3.3.4.3" ;
             ex:pcfID "10160" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define target audience" .


###  http://example.org/apqc#PCF_10163
ex:PCF_10163 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing a dynamic pricing mechanism for the organization's offerings that is supported by the number of units in production. Outline a system for determining the optimum price point for each product/service. Based this model on an estimation of the volume of anticipated sales for each offering and variable costs." ;
             ex:designatesProcessType ex:P10163 ;
             ex:hierarchyID "3.3.3.3" ;
             ex:pcfID "10163" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20593 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine pricing based on volume/unit forecast" .


###  http://example.org/apqc#PCF_10164
ex:PCF_10164 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing the pricing mechanism to determine prices for all individual offerings in the organizational portfolio. Calculate the prices of all offerings based on the established methodology and/or formulaic structure." ;
             ex:designatesProcessType ex:P10164 ;
             ex:hierarchyID "3.3.3.4" ;
             ex:pcfID "10164" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20593 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute pricing plan" .


###  http://example.org/apqc#PCF_10165
ex:PCF_10165 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the efficiency of pricing with the objective of identifying any divergence from the equilibrium prices and avoiding any deadweight loss. Gauge the performance of the pricing plan by tracking growth in the revenue and/or customer uptake, secured as a result of new prices. Measure the performance of pricing by periodically checking the profits generated from the sale of each of the organization's offerings against the backdrop of any events that may have influenced the uptake of a certain good/service by the customer base." ;
             ex:designatesProcessType ex:P10165 ;
             ex:hierarchyID "3.3.3.5" ;
             ex:pcfID "10165" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20593 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate pricing performance" .


###  http://example.org/apqc#PCF_10166
ex:PCF_10166 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Refining the pricing mechanism to create equitable prices for all products/services with the objective of maximizing the profits and/or customer uptake of these offerings. Reconcile the pricing mechanism in order to achieve equilibrium pricing. Adjust the prices for all of the organization's offerings, using the insights gleaned from examining how much profit or customer uptake is generated by the present pricing strategy." ;
             ex:designatesProcessType ex:P10166 ;
             ex:hierarchyID "3.3.3.6" ;
             ex:pcfID "10166" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20593 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Refine pricing as needed" .


###  http://example.org/apqc#PCF_10167
ex:PCF_10167 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining a conceptual framework for all promotional activity in order to create an overarching aspiration and ensure consistency. Create a plan for running promotional programs and designing the associated activities in order to increase visibility or sales. Determine how the organization quantifies what it wishes to achieve from these activities, what sort of messages the organization comfortable publicizing, what channels the organization wishes to employ, etc." ;
             ex:designatesProcessType ex:P10167 ;
             ex:hierarchyID "3.3.4.1" ;
             ex:pcfID "10167" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define promotional concepts and objectives" .


###  http://example.org/apqc#PCF_10168
ex:PCF_10168 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a scheme for executing the promotional programs and campaigns, and testing these on sample audiences. Create a program plan, and carry out trials for promotional activities. Develop a scheme for how, when, where, and by whom the promotional schemes and campaigns will be deployed. Design incentives that convince or tempt the consumer to take up the organization's offerings. Conduct focus groups and pilot programs that reach out to a smaller number of people from among the target audiences to validate effectiveness." ;
             ex:designatesProcessType ex:P10168 ;
             ex:hierarchyID "3.3.4.4" ;
             ex:pcfID "10168" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan and test promotional activities" .


###  http://example.org/apqc#PCF_10169
ex:PCF_10169 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Executing promotional programs in the market for reaching out to the desired customer segments. Implement the promotional schemes and campaigns. Create collaterals for the dissemination of information about the product, product line, brand, or company to the target audiences in an effective manner. Leverage relationships with distributors, vendors, and retailers. Consider enlisting professional services such as design, PR, and advertising firms." ;
             ex:designatesProcessType ex:P10169 ;
             ex:hierarchyID "3.3.4.5" ;
             ex:pcfID "10169" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute promotional activities" .


###  http://example.org/apqc#PCF_10170
ex:PCF_10170 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the success of promotional programs through metrics that track the impact of these activities. Examine the performance of promotional activities. Measure the success of these programs through metrics representative of customer uptake, market penetration, sustenance of impact created, revenue growth through offerings marketed, etc. Measure through primary data collection. Analyze through various statistical techniques to generate insights." ;
             ex:designatesProcessType ex:P10170 ;
             ex:hierarchyID "3.3.4.6" ;
             ex:pcfID "10170" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate promotional performance metrics" .


###  http://example.org/apqc#PCF_10171
ex:PCF_10171 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Fine-tuning promotional activities by employing the insights gleaned from the quantitative, as well as any qualitative, performance evaluations. Change certain attributes of the schemes, campaigns, and programs deployed in order to increase the impact generated, in terms of measures already agreed upon such as customer uptake, market penetration, sustenance of impact created, and revenue growth through offerings marketed." ;
             ex:designatesProcessType ex:P10171 ;
             ex:hierarchyID "3.3.4.7" ;
             ex:pcfID "10171" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Refine promotional performance metrics" .


###  http://example.org/apqc#PCF_10172
ex:PCF_10172 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Incorporating the understanding developed by studying promotional activities as well as refining them. Include the best practices and value-enhancing attributes identified in Refine promotional activities [10171] into similarly planned schemes, programs, and campaigns. Adjust promotional activities to further increase the effectiveness of the overall promotional efforts." ;
             ex:designatesProcessType ex:P10172 ;
             ex:hierarchyID "3.3.4.8" ;
             ex:pcfID "10172" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Incorporate learning into future/planned consumer promotions" .


###  http://example.org/apqc#PCF_10173
ex:PCF_10173 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Estimating customer loyalty and the average contribution made by them to revenues, over their lifespan. Use metrics to quantify the commitment of customers to the offerings of the organization, such as measures of tendency to switch brands/providers, number/proportion of return customers, and the number of customers using multiple substitutable offerings." ;
             ex:designatesProcessType ex:P10173 ;
             ex:hierarchyID "3.3.5.1" ;
             ex:pcfID "10173" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10153 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine customer lifetime value" .


###  http://example.org/apqc#PCF_10174
ex:PCF_10174 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing the revenue stream generated by the sale of the organization's products/services in order to identify trends therein. Examine data relating to the inflow of revenue from individual/groups of customers in order to identify patterns in the generation and sustenance of receivables. Conduct statistical analysis over the stream of revenue collected and the point of origin associated with each unit of sale through metrics such as the accounting rate of return, the GAAP revenue over a given period, and customer lifetime revenue." ;
             ex:designatesProcessType ex:P10174 ;
             ex:hierarchyID "3.3.5.2" ;
             ex:pcfID "10174" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10153 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze customer revenue trend" .


###  http://example.org/apqc#PCF_10175
ex:PCF_10175 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating measures that capture the proportion of customers the organization is able to retain to those it is losing. Compute metrics such as the tendency to switch brands/providers and the proportion of return customers to comprehend the trends within the customer attrition and retention rates." ;
             ex:designatesProcessType ex:P10175 ;
             ex:hierarchyID "3.3.5.3" ;
             ex:pcfID "10175" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10153 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze customer attrition and retention rates" .


###  http://example.org/apqc#PCF_10176
ex:PCF_10176 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Studying all measures of the customer's behavior and conduct toward the organization's offerings in order to glean insight and identify patterns into their decision making. Closely examine all categories of data sets over a customer base. Analyze data points related to customer loyalty, retention, value, conversion, level of satisfaction, attrition, etc. Flesh out measures for an all-encompassing analysis that provides a macro-level picture of the customer's behavior and mindset related to the organization's products/services." ;
             ex:designatesProcessType ex:P10176 ;
             ex:hierarchyID "3.3.5.4" ;
             ex:pcfID "10176" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10153 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze customer metrics" .


###  http://example.org/apqc#PCF_10177
ex:PCF_10177 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reviewing and reappraising the strategies, objectives, and plans for all customer-centered processes. Revisit all customer-focused processes and activities--which relate to their acquisition, conversion, and retention--with the objective of revising them in light of customer analysis. Revise accordingly." ;
             ex:designatesProcessType ex:P10177 ;
             ex:hierarchyID "3.3.5.5" ;
             ex:pcfID "10177" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10153 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Revise customer strategies, objectives, and plans based on metrics" .


###  http://example.org/apqc#PCF_10178
ex:PCF_10178 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a strategic road map for how to package products/services into desirable solutions while increasing profitability. Create a scheme for how the organization will bundle and wrap its products/services into a presentable and sellable offering. Consider what aspects or components of an offering the organization can extract the maximum revenue from, and reduce the less profitable constituents while maintaining a high perceptible value for the customers. Balance maximizing profit with benefits to the customer." ;
             ex:designatesProcessType ex:P10178 ;
             ex:hierarchyID "3.3.7.1" ;
             ex:pcfID "10178" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10154 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan packaging strategy" .


###  http://example.org/apqc#PCF_10179
ex:PCF_10179 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Piloting the packaged products/services in the market with a test audience. Create trial runs using techniques such as focus groups of the final product, wrapped and bundled." ;
             ex:designatesProcessType ex:P10179 ;
             ex:hierarchyID "3.3.7.2" ;
             ex:pcfID "10179" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10154 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Test packaging options" .


###  http://example.org/apqc#PCF_10180
ex:PCF_10180 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing the final packaging. Put into action the packaging strategy in light of the insights accumulated from testing various options." ;
             ex:designatesProcessType ex:P10180 ;
             ex:hierarchyID "3.3.7.3" ;
             ex:pcfID "10180" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10154 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute packaging strategy" .


###  http://example.org/apqc#PCF_10181
ex:PCF_10181 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Fine-tuning the packaging that has been developed and tested using insights gleaned from feedback. " ;
             ex:designatesProcessType ex:P10181 ;
             ex:hierarchyID "3.3.7.4" ;
             ex:pcfID "10181" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10154 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Refine packaging" .


###  http://example.org/apqc#PCF_10182
ex:PCF_10182 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Generating leads of prospective customers to grow the organization's business. Identify viable customers based on customer and market research. Discover leads through IT applications, cold calling, reference/network development, or other sales and business development techniques. Employ a scoring model qualify the prospective customers into leads, and prioritize them." ;
             ex:designatesProcessType ex:P10182 ;
             ex:hierarchyID "3.5.1" ;
             ex:pcfID "10182" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10105 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage leads/opportunities" .


###  http://example.org/apqc#PCF_10183
ex:PCF_10183 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the customer's expectations, with the intent of responsibly increasing the sale of the organization's products/services. Create a systematic method for governing sales, using sales forecasts and customer management measures. Develop a blueprint to manage relationships with customers and the data it holds on them, as well as the sale of its products/services to these customers. Devise a recipe for handling the organization's key customers in order to manage their expectations with tact and responsibility while maximizing revenue." ;
             ex:designatesProcessType ex:P10183 ;
             ex:hierarchyID "3.5.2" ;
             ex:pcfID "10183" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10105 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage customers and accounts" .


###  http://example.org/apqc#PCF_10184
ex:PCF_10184 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the entire sales process, from using leads to open sales to closing sales and creating records. Govern all sales activities. Make sales calls based on leads and preparatory work (drafting terms of the sale, creating proposals, suggesting prices, etc.). Close the sale, along with any administrative activities related to data entry and the processing of the sale." ;
             ex:designatesProcessType ex:P10184 ;
             ex:hierarchyID "3.5.1.8" ;
             ex:pcfID "10184" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10182 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage customer sales calls" .


###  http://example.org/apqc#PCF_10185
ex:PCF_10185 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Taking, receiving, processing, and acknowledging new customer orders or amendments to outstanding customer orders. Monitoring status from order receipt to customer delivery/customer invoicing." ;
             ex:designatesProcessType ex:P10185 ;
             ex:hierarchyID "3.5.4" ;
             ex:pcfID "10185" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10105 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage sales orders" .


###  http://example.org/apqc#PCF_10187
ex:PCF_10187 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the organization's partners and alliances, with the objective of maximizing revenue. Train partners regarding the organization's portfolio of products/services. Craft sales forecasts. Examine their performance. Manage all data held by the organization on these partners." ;
             ex:designatesProcessType ex:P10187 ;
             ex:hierarchyID "3.5.5" ;
             ex:pcfID "10187" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10105 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage sales partners and alliances" .


###  http://example.org/apqc#PCF_10188
ex:PCF_10188 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying people who can be converted into customers. Leverage personal and professional networks, business research over databases and directories, and secondary research." ;
             ex:designatesProcessType ex:P10188 ;
             ex:hierarchyID "3.5.1.1" ;
             ex:pcfID "10188" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10182 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify potential customers" .


###  http://example.org/apqc#PCF_10189
ex:PCF_10189 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Qualifying the prospective customers into credible leads by gauging their behavior against the organization's offering. Triangulate leads to increase the efficiency of sales and marketing efforts. Build a detailed profile of the prospects. Determine what products/services they already use, if they have decision-making authority, their views on the products/services they already use, how prone they are to switch, if the organization's solution better in some attributes than those prospects currently use, etc." ;
             ex:designatesProcessType ex:P10189 ;
             ex:hierarchyID "3.5.1.2" ;
             ex:pcfID "10189" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10182 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify/receive leads/opportunities" .


###  http://example.org/apqc#PCF_10190
ex:PCF_10190 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Communicating with customers and prospects with the intent of creating sales opportunities. Reach out to existing and prospective customers through alternate media and networking channels, apart from cold calling/emailing." ;
             ex:designatesProcessType ex:P10190 ;
             ex:hierarchyID "3.5.1.8.1" ;
             ex:pcfID "10190" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10184 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform sales calls" .


###  http://example.org/apqc#PCF_10191
ex:PCF_10191 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Capitalizing on sales calls by pitching on bids and closing deals. Outline the nature and scope of the work, draft agreement terms, prepare proposals and agreements, and propose timelines and prices." ;
             ex:designatesProcessType ex:P10191 ;
             ex:hierarchyID "3.5.1.8.2" ;
             ex:pcfID "10191" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10184 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform pre-sales activities" .


###  http://example.org/apqc#PCF_10192
ex:PCF_10192 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Formalizing a sale by reaching an agreement on terms of the deal. Negotiate on the price, and reach a consensus on the terms and conditions." ;
             ex:designatesProcessType ex:P10192 ;
             ex:hierarchyID "3.5.1.8.4" ;
             ex:pcfID "10192" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10184 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Close the sale" .


###  http://example.org/apqc#PCF_10193
ex:PCF_10193 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Completing all the paper-work associated with the sale of its products/services. Exchange any pertinent legal/financial information required for completing the sale, signing of a contract/work-order, and issuing copies of bills/invoices." ;
             ex:designatesProcessType ex:P10193 ;
             ex:hierarchyID "3.5.1.8.5" ;
             ex:pcfID "10193" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10184 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Record outcome of sales process" .


###  http://example.org/apqc#PCF_10194
ex:PCF_10194 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Receiving and confirming orders from customers. Verify that no extra expenses have to be disbursed on part of the organization for labor or inventory when processing the order. " ;
             ex:designatesProcessType ex:P10194 ;
             ex:hierarchyID "3.5.4.1" ;
             ex:pcfID "10194" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Accept and validate sales orders" .


###  http://example.org/apqc#PCF_10195
ex:PCF_10195 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Collecting and maintaining all account information. Collect information about the purchase, servicing, return, and/or commitment of any products/services on part of the organization to its customers. Bring together information from various organizational divisions, and update periodically." ;
             ex:designatesProcessType ex:P10195 ;
             ex:hierarchyID "3.5.4.2" ;
             ex:pcfID "10195" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Collect and maintain account information" .


###  http://example.org/apqc#PCF_10196
ex:PCF_10196 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ascertaining the volume or scale of products/services to provide to customers to fulfill sales orders. Check the finished products stored in warehouses, the production capacity, and (in the case of services) the processing speed, as well as work force availability." ;
             ex:designatesProcessType ex:P10196 ;
             ex:hierarchyID "3.5.4.3" ;
             ex:pcfID "10196" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine availability" .


###  http://example.org/apqc#PCF_10197
ex:PCF_10197 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Devising a blueprint for order fulfillment. Create a schematic flow encompassing all activities to deliver orders to the customers. Outline a procedure for satisfying these orders by answering questions about what needs to happen in sequence to realize an order." ;
             ex:designatesProcessType ex:P10197 ;
             ex:hierarchyID "3.5.4.4" ;
             ex:pcfID "10197" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine fulfillment process" .


###  http://example.org/apqc#PCF_10199
ex:PCF_10199 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Processing any unfulfilled orders, and updating the status of any orders that have been accepted and are being attended to. Deliver on any purchase orders that remain unserviced due to temporary unavailability of the product/service. Manage any updates to the sales orders. Revise their status in the order system." ;
             ex:designatesProcessType ex:P10199 ;
             ex:hierarchyID "3.5.4.5" ;
             ex:pcfID "10199" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process back orders and updates" .


###  http://example.org/apqc#PCF_10200
ex:PCF_10200 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Attending to any queries received from the customers, even after a sales order has been serviced. Deploy ad hoc personnel for managing these enquiries." ;
             ex:designatesProcessType ex:P10200 ;
             ex:hierarchyID "3.5.4.6" ;
             ex:pcfID "10200" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Handle sales order inquiries including post-order fulfillment transactions" .


###  http://example.org/apqc#PCF_10201
ex:PCF_10201 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing essential information of customer accounts." ;
             ex:designatesProcessType ex:P10201 ;
             ex:hierarchyID "3.5.4.2.1" ;
             ex:pcfID "10201" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Administer key account details" .


###  http://example.org/apqc#PCF_10202
ex:PCF_10202 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Obtaining detailed information about customers." ;
             ex:designatesProcessType ex:P10202 ;
             ex:hierarchyID "3.5.4.2.2" ;
             ex:pcfID "10202" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Retrieve full customer details" .


###  http://example.org/apqc#PCF_10203
ex:PCF_10203 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Altering information about involved parties." ;
             ex:designatesProcessType ex:P10203 ;
             ex:hierarchyID "3.5.4.2.3" ;
             ex:pcfID "10203" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Modify involved party details" .


###  http://example.org/apqc#PCF_10204
ex:PCF_10204 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Documenting address information." ;
             ex:designatesProcessType ex:P10204 ;
             ex:hierarchyID "3.5.4.2.4" ;
             ex:pcfID "10204" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Record address details" .


###  http://example.org/apqc#PCF_10205
ex:PCF_10205 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Documenting contact information." ;
             ex:designatesProcessType ex:P10205 ;
             ex:hierarchyID "3.5.4.2.5" ;
             ex:pcfID "10205" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Record contact details" .


###  http://example.org/apqc#PCF_10206
ex:PCF_10206 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing information about important business rules regarding communicating with customers." ;
             ex:designatesProcessType ex:P10206 ;
             ex:hierarchyID "3.5.4.2.6" ;
             ex:pcfID "10206" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Record key customer communication profile details" .


###  http://example.org/apqc#PCF_10207
ex:PCF_10207 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Revising information about involved parties." ;
             ex:designatesProcessType ex:P10207 ;
             ex:hierarchyID "3.5.4.2.7" ;
             ex:pcfID "10207" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review involved party information" .


###  http://example.org/apqc#PCF_10208
ex:PCF_10208 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Dismissing information about involved parties." ;
             ex:designatesProcessType ex:P10208 ;
             ex:hierarchyID "3.5.4.2.8" ;
             ex:pcfID "10208" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10195 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Terminate involved party information" .


###  http://example.org/apqc#PCF_10209
ex:PCF_10209 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Planning the distribution of personnel across various sales functions. Match the capabilities of individual employees with the skill sets needed for specific roles. Seek assistance from HR." ;
             ex:designatesProcessType ex:P10209 ;
             ex:hierarchyID "3.5.1.7" ;
             ex:pcfID "10209" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10182 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine sales resource allocation" .


###  http://example.org/apqc#PCF_10210
ex:PCF_10210 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a scheme of awards and recognition for sales employees to promote a results-based culture. Create specific incentives to reach desired outcomes, such as landing key clients, growing the customer base, providing exceptional servicing, and increasing profit margins." ;
             ex:designatesProcessType ex:P10210 ;
             ex:hierarchyID "7.1.2.3.1" ;
             ex:pcfID "10210" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10425 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish incentive strategy" .


###  http://example.org/apqc#PCF_10211
ex:PCF_10211 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Imparting guidance and instruction to sales partners/alliances concerning products/services. Distribute literature about the organization's products/services. Conduct workshops. Disseminate useful media content to engage and enlighten partners. Create communities through group engagements." ;
             ex:designatesProcessType ex:P10211 ;
             ex:hierarchyID "3.5.5.1" ;
             ex:pcfID "10211" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10187 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide sales and product/service training to sales partners/alliances" .


###  http://example.org/apqc#PCF_10214
ex:PCF_10214 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the performance of its partners/alliances in selling its products/services. Use metrics such as growth in revenue generated, conversion rate, and total outreach to customers for assessing the performance results." ;
             ex:designatesProcessType ex:P10214 ;
             ex:hierarchyID "3.5.5.3" ;
             ex:pcfID "10214" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10187 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate partner/alliance results" .


###  http://example.org/apqc#PCF_10215
ex:PCF_10215 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating strategies for production and materials. Handle the demand for the products of the organization. Develop plans for handling materials. Develop and administer the schedule for master production. Plan for distribution requirements and its constraints by reviewing and assessing distribution policies and performance and by establishing quality standards and procedures. " ;
             ex:designatesProcessType ex:P10215 ;
             ex:hierarchyID "4.1" ;
             ex:pcfID "10215" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_20022 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan for and align supply chain resources" .


###  http://example.org/apqc#PCF_10216
ex:PCF_10216 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan for procuring materials and services. Develop strategies for sourcing materials and services. Choose the most appropriate suppliers, and develop contracts with them. Order the materials and services as per the requirements. Manage relationships with suppliers." ;
             ex:designatesProcessType ex:P10216 ;
             ex:hierarchyID "4.2" ;
             ex:pcfID "10216" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_20022 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Procure materials and services" .


###  http://example.org/apqc#PCF_10217
ex:PCF_10217 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Processing and delivering the finished goods manufactured by the organization. Schedule the production of products. Execute the product production activities. Perform tests to oversee and ensure quality of production. Maintain records of the production process. Track lots." ;
             ex:designatesProcessType ex:P10217 ;
             ex:hierarchyID "4.3" ;
             ex:pcfID "10217" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_20022 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Produce/Assemble/Test product" .


###  http://example.org/apqc#PCF_10218
ex:PCF_10218 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Validating specific service requirements for individual customers. Determine and schedule resource to fulfill these requirements. Provide service to specific individual customers. Ensure the quality of service delivery." ;
             ex:designatesProcessType ex:P10218 ;
             ex:hierarchyID "6.3.4" ;
             ex:pcfID "10218" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_12658 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Service products" .


###  http://example.org/apqc#PCF_10219
ex:PCF_10219 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering and overseeing all activities related to logistics and warehousing. Outline and establish a strategy for the logistics function. Plan and administer the flow of inbound materials. Administer the operational activities of warehousing and outbound transportation. Manage reverse logistics including returns and exchanges." ;
             ex:designatesProcessType ex:LogisticsManagementCapability ;
             ex:hierarchyID "4.4" ;
             ex:pcfID "10219" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_20022 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage logistics and warehousing" .


###  http://example.org/apqc#PCF_10221
ex:PCF_10221 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating strategies for production processes, as well as the process of managing materials. Define production and supply constraints. Design a blueprint of the workplace. Establish rules and regulations regarding the employees, outsourcing of services, and the expenditure to be incurred on the manufacturing capital." ;
             ex:designatesProcessType ex:P10221 ;
             ex:hierarchyID "4.1.1" ;
             ex:pcfID "10221" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop production and materials strategies" .


###  http://example.org/apqc#PCF_10222
ex:PCF_10222 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Forecasting demand for products using secondary research and customer feedback. Refine these forecasts. Inspect the approach used in creating forecasts, and determine its accuracy." ;
             ex:designatesProcessType ex:P10222 ;
             ex:hierarchyID "4.1.2" ;
             ex:pcfID "10222" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage demand for products" .


###  http://example.org/apqc#PCF_10223
ex:PCF_10223 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a scheme that allows for advance planning for the availability of raw materials and spares. Start with an unconstrained plan, and refine based on supply chain realities by identifying critical materials required for production, checking material specifications, and collaborating with all vendors over the supply." ;
             ex:designatesProcessType ex:P10223 ;
             ex:hierarchyID "4.1.3" ;
             ex:pcfID "10223" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create materials plan" .


###  http://example.org/apqc#PCF_10224
ex:PCF_10224 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Taking care of the master production plan. The master production includes creation and implementation of the site-level production plan, as well as management of the inventory that is currently in the production process." ;
             ex:designatesProcessType ex:P10224 ;
             ex:hierarchyID "4.1.4" ;
             ex:pcfID "10224" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create and manage master production schedule" .


###  http://example.org/apqc#PCF_10226
ex:PCF_10226 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Instituting the constraints for planning of distribution process. Create a plan that specifies every element in the distribution process from the blueprint of the distribution centers to how and when the inventory would reach the distribution centers." ;
             ex:designatesProcessType ex:P10226 ;
             ex:hierarchyID "4.1.6" ;
             ex:pcfID "10226" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish distribution planning constraints" .


###  http://example.org/apqc#PCF_10227
ex:PCF_10227 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Revisiting and refurbishing the policies for planning the distribution process. Asses the distribution strategies, including how the products are to be made available and sent to different distributors. Set guidelines regarding relationships between the sources and the distribution centers." ;
             ex:designatesProcessType ex:P10227 ;
             ex:hierarchyID "4.1.7" ;
             ex:pcfID "10227" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review distribution planning policies" .


###  http://example.org/apqc#PCF_10229
ex:PCF_10229 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating quantifiable strategic objectives for each manufacturing segment in conjunction with sales projections." ;
             ex:designatesProcessType ex:P10229 ;
             ex:hierarchyID "4.1.1.1" ;
             ex:pcfID "10229" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define manufacturing goals" .


###  http://example.org/apqc#PCF_10230
ex:PCF_10230 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Setting up internal rules and regulations regarding the employees and the materials." ;
             ex:designatesProcessType ex:P10230 ;
             ex:hierarchyID "4.1.1.2" ;
             ex:pcfID "10230" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define labor and materials policies" .


###  http://example.org/apqc#PCF_10231
ex:PCF_10231 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating rules and regulations regarding contracting out of a business process to another party in order to reduce costs." ;
             ex:designatesProcessType ex:P10231 ;
             ex:hierarchyID "4.1.1.3" ;
             ex:pcfID "10231" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define outsourcing policies" .


###  http://example.org/apqc#PCF_10232
ex:PCF_10232 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing rules and regulations pertaining to the expenditure incurred in acquiring or upgrading the existing stock of manufacturing capital. " ;
             ex:designatesProcessType ex:P10232 ;
             ex:hierarchyID "4.1.1.4" ;
             ex:pcfID "10232" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define capital expense policies" .


###  http://example.org/apqc#PCF_10233
ex:PCF_10233 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the manufacturing and processing capacities of the organization. Delineate the capabilities required for optimizing output with available resources. Analyze capabilities possessed by the organization concerning the raw materials required and the process necessitated for producing finished products. " ;
             ex:designatesProcessType ex:P10233 ;
             ex:hierarchyID "4.1.1.5" ;
             ex:pcfID "10233" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define capacities" .


###  http://example.org/apqc#PCF_10234
ex:PCF_10234 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining limitations in the ability of the organization's supply chain to deliver a new stock, and creating a network of production stakeholders. Frame and manage relationships within the flow of manufacturing and processing operations. Identify probable supply issues." ;
             ex:designatesProcessType ex:P10234 ;
             ex:hierarchyID "4.1.1.6" ;
             ex:pcfID "10234" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define production network and supply constraints" .


###  http://example.org/apqc#PCF_10235
ex:PCF_10235 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identify the bedrock levels of market demand anticipated for the organization's products/services. Estimate future demand for product and services using historical data, analysis of the market environment and any externalities, etc. to create ex ante approximations." ;
             ex:designatesProcessType ex:P10235 ;
             ex:hierarchyID "4.1.2.1" ;
             ex:pcfID "10235" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10222 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop baseline demand forecasts" .


###  http://example.org/apqc#PCF_10236
ex:PCF_10236 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Working closely with the organization's customers to understand their drives and behavior, with the objective of estimating future demand. Reach out to customers through various means to understand their behavior patterns, usage elasticity, and degree of variability--and ultimately determine demand for each offering." ;
             ex:designatesProcessType ex:P10236 ;
             ex:hierarchyID "4.1.2.2" ;
             ex:pcfID "10236" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10222 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Collaborate demand with customers" .


###  http://example.org/apqc#PCF_10237
ex:PCF_10237 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Arriving at a consensus over the forecasted levels of demand for products/services. Consensus is achieved by juxtaposing decisions developed in the baseline forecast with those reached at by collaborating with customers. Enlist senior-level decision makers of the sales and marketing functions." ;
             ex:designatesProcessType ex:P10237 ;
             ex:hierarchyID "4.1.2.3" ;
             ex:pcfID "10237" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10222 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop demand consensus forecast" .


###  http://example.org/apqc#PCF_10238
ex:PCF_10238 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identify the volume of products/services that may be committed for delivery to fulfill sales. Figure out the amount of stock available. Forecast its volumes." ;
             ex:designatesProcessType ex:P10238 ;
             ex:hierarchyID "4.1.2.4" ;
             ex:pcfID "10238" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10222 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine available to promise" .


###  http://example.org/apqc#PCF_10239
ex:PCF_10239 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Picking out any activity that deviates from the forecast, and adjusting it. Closely track and study the levels of demand as they emerge. Refine the consensus forecast as needed." ;
             ex:designatesProcessType ex:P10239 ;
             ex:hierarchyID "4.1.2.5" ;
             ex:pcfID "10239" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10222 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor activity against demand forecast and revise forecast" .


###  http://example.org/apqc#PCF_10240
ex:PCF_10240 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the methodology used to estimate future demand. Refine it in light of current market realities and demand." ;
             ex:designatesProcessType ex:P10240 ;
             ex:hierarchyID "4.1.2.6" ;
             ex:pcfID "10240" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10222 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate and revise demand forecasting approach" .


###  http://example.org/apqc#PCF_10241
ex:PCF_10241 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating and inspecting the accuracy of demand forecasts. Use metrics to check the reliability of the forecasts created. " ;
             ex:designatesProcessType ex:P10241 ;
             ex:hierarchyID "4.1.2.7" ;
             ex:pcfID "10241" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10222 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure demand forecast accuracy" .


###  http://example.org/apqc#PCF_10242
ex:PCF_10242 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a plan for raw materials and other inventory items in order to meet market demand. Ensure the availability of all inventory items such as raw materials and spares. Create a blueprint in line with Define labor and materials policies [10230]. " ;
             ex:designatesProcessType ex:P10242 ;
             ex:hierarchyID "4.1.3.1" ;
             ex:pcfID "10242" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10223 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create unconstrained plan" .


###  http://example.org/apqc#PCF_10243
ex:PCF_10243 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Collaborating with vendors and contractual manufacturers with the objective of ensuring a continual supply of raw materials and spares. Leverage long-term connections/relationships with various suppliers, and cultivate new ones. Track the activities of all vendors. Receive regular updates to prepare for any fluctuations in supply." ;
             ex:designatesProcessType ex:P10243 ;
             ex:hierarchyID "4.1.3.2" ;
             ex:pcfID "10243" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10223 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Collaborate with supplier and contract manufacturers" .


###  http://example.org/apqc#PCF_10244
ex:PCF_10244 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying principal materials needed for the manufacturing process and the levels of supply that may be ensured for them. Determine the essential and crucial inventory items required for the smooth functioning of all manufacturing processes. Estimate the average, peak, and baseline capacities of various vendors and suppliers. Establish the capability of individual suppliers from the market and the vendors." ;
             ex:designatesProcessType ex:P10244 ;
             ex:hierarchyID "4.1.3.3" ;
             ex:pcfID "10244" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10223 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify critical materials and supplier capacity" .


###  http://example.org/apqc#PCF_10245
ex:PCF_10245 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Observing and surveying all inventory items in order to check for the veracity of their specifications. Monitor various attributes and characteristics for respective inventory items such as density, volume, and size, as well as contextualized specifications particular to the respective materials." ;
             ex:designatesProcessType ex:P10245 ;
             ex:hierarchyID "4.1.3.4" ;
             ex:pcfID "10245" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10223 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor material specifications" .


###  http://example.org/apqc#PCF_10246
ex:PCF_10246 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Generating a bounded plan that takes stock of the actual supply chain scenario. Take stock of all information collected while creating an inventory supply plan. " ;
             ex:designatesProcessType ex:P10246 ;
             ex:hierarchyID "4.1.3.5" ;
             ex:pcfID "10246" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10223 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Generate constrained plan" .


###  http://example.org/apqc#PCF_10252
ex:PCF_10252 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Maintaining and preserving the master data plan for distribution requirements. Create a systematic collection of facts and figures regarding the distribution of the inventories. Maintain policies, processes, and tools covering the distribution function." ;
             ex:designatesProcessType ex:P10252 ;
             ex:hierarchyID "4.1.5.1" ;
             ex:pcfID "10252" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain master data" .


###  http://example.org/apqc#PCF_10253
ex:PCF_10253 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Interact with the concerned person at the destination to validate the requirements and to avoid any miscommunication of information." ;
             ex:designatesProcessType ex:P10253 ;
             ex:hierarchyID "4.1.5.2" ;
             ex:pcfID "10253" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine finished goods inventory requirements at destination" .


###  http://example.org/apqc#PCF_10254
ex:PCF_10254 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Interact with the concerned authority at the destination to reach a specific figure that correctly represents requirements." ;
             ex:designatesProcessType ex:P10254 ;
             ex:hierarchyID "4.1.5.4" ;
             ex:pcfID "10254" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate requirements at destination" .


###  http://example.org/apqc#PCF_10255
ex:PCF_10255 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the aggregate volume of products/services consolidated at the source. Calculate the number of finished products that are ready to be delivered to the customers, particularly at one date." ;
             ex:designatesProcessType ex:P10255 ;
             ex:hierarchyID "4.1.5.5" ;
             ex:pcfID "10255" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate consolidation at source" .


###  http://example.org/apqc#PCF_10256
ex:PCF_10256 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the plan for collaborative replenishment of goods. Replenish inventory by creating a plan in case of faulty production." ;
             ex:designatesProcessType ex:P10256 ;
             ex:hierarchyID "4.1.5.6" ;
             ex:pcfID "10256" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage collaborative replenishment planning" .


###  http://example.org/apqc#PCF_10258
ex:PCF_10258 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Estimating the timing and duration of the delivery of the inventory from the source to the destination. Plan the logistic details of all the distribution routes and activities." ;
             ex:designatesProcessType ex:P10258 ;
             ex:hierarchyID "4.1.5.7" ;
             ex:pcfID "10258" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate and optimize destination dispatch plan" .


###  http://example.org/apqc#PCF_10259
ex:PCF_10259 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Accomplishing the dispatch plan. Strictly follow the schedule, and adjust for deviations. Coordinate with the concerned authorities at various destinations." ;
             ex:designatesProcessType ex:P10259 ;
             ex:hierarchyID "4.1.5.8" ;
             ex:pcfID "10259" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage dispatch plan attainment" .


###  http://example.org/apqc#PCF_10260
ex:PCF_10260 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the plans for delivering loads to destinations. Create a systematic plan that specifies the load plans for every single destination." ;
             ex:designatesProcessType ex:P10260 ;
             ex:hierarchyID "4.1.5.9" ;
             ex:pcfID "10260" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate and optimize destination load plans" .


###  http://example.org/apqc#PCF_10261
ex:PCF_10261 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the load plan for partners. Manage the delivery, and dispatch from the source to the partners." ;
             ex:designatesProcessType ex:P10261 ;
             ex:hierarchyID "4.1.5.10" ;
             ex:pcfID "10261" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage partner load plan" .


###  http://example.org/apqc#PCF_10262
ex:PCF_10262 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing all expenses to provide products/services in the market. Estimate the overall cost of supplying of products/inventory, including the cost distributing it through various partners and channels. Consider the cost of all the logistical processes that occur from the moment a product is ready to be dispatched to the time it reaches the destination." ;
             ex:designatesProcessType ex:P10262 ;
             ex:hierarchyID "4.1.5.11" ;
             ex:pcfID "10262" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage cost of supply" .


###  http://example.org/apqc#PCF_10263
ex:PCF_10263 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the capacity utilization of the organization's production process. Realize the extent to which an enterprise uses its installed productive capacity (i.e., the relationship between output and the potential output if capacity was fully used)." ;
             ex:designatesProcessType ex:P10263 ;
             ex:hierarchyID "4.1.5.12" ;
             ex:pcfID "10263" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage capacity utilization" .


###  http://example.org/apqc#PCF_10264
ex:PCF_10264 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the system that defines how the products/inventory would reach from the source (i.e., manufacturer) to the destination (i.e., retailer/distributer)." ;
             ex:designatesProcessType ex:P10264 ;
             ex:hierarchyID "4.1.7.1" ;
             ex:pcfID "10264" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10227 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review distribution network" .


###  http://example.org/apqc#PCF_10265
ex:PCF_10265 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing relationships with transportation/distribution sources in order to ensure an effective distribution network and strategy. Screen and evaluate various sources available to pick out the best among them." ;
             ex:designatesProcessType ex:P10265 ;
             ex:hierarchyID "4.1.7.2" ;
             ex:pcfID "10265" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10227 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish sourcing relationships" .


###  http://example.org/apqc#PCF_10266
ex:PCF_10266 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating strategic guidelines on the availability of the products at all the distribution centers. Create a dynamic network to ensure availability at all times, even in cases of defaults." ;
             ex:designatesProcessType ex:P10266 ;
             ex:hierarchyID "4.1.7.3" ;
             ex:pcfID "10266" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10227 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish dynamic deployment policies" .


###  http://example.org/apqc#PCF_10267
ex:PCF_10267 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Instituting the constraints for creating a layout for distribution center. Consider factors such as the number of customers, demand forecasting, product groups, condition of product conservation, warehousing, and transportation management." ;
             ex:designatesProcessType ex:P10267 ;
             ex:hierarchyID "4.1.6.1" ;
             ex:pcfID "10267" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10226 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish distribution center layout constraints" .


###  http://example.org/apqc#PCF_10268
ex:PCF_10268 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining any problems that might be faced while managing inventory. Identify problems and possible issues in managing the warehousing of the raw materials, spares, and other items of inventory. Take stock of inventory needs, and determine the exact quantity of the inventory needed in the near future." ;
             ex:designatesProcessType ex:P10268 ;
             ex:hierarchyID "4.1.6.2" ;
             ex:pcfID "10268" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10226 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish inventory management constraints" .


###  http://example.org/apqc#PCF_10269
ex:PCF_10269 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying any potential constraints while deciding on the dispatch and delivery plan from the source to the various distribution centers. Decide how the inventory will be transported , which and how many transportation means to use, what route to take, etc." ;
             ex:designatesProcessType ex:P10269 ;
             ex:hierarchyID "4.1.6.3" ;
             ex:pcfID "10269" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10226 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish transportation management constraints" .


###  http://example.org/apqc#PCF_10270
ex:PCF_10270 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing key measures that analyze and interpret how effectively the business is achieving its objectives." ;
             ex:designatesProcessType ex:P10270 ;
             ex:hierarchyID "13.6.3.1" ;
             ex:pcfID "10270" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20147 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish performance indicators (measures)" .


###  http://example.org/apqc#PCF_10271
ex:PCF_10271 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Deciding on the appropriate amount of supervisions that are needed to effectively assess the performance of business plans." ;
             ex:designatesProcessType ex:P10271 ;
             ex:hierarchyID "13.6.3.2" ;
             ex:pcfID "10271" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20147 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish monitoring frequency" .


###  http://example.org/apqc#PCF_10272
ex:PCF_10272 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Measuring the performance of process planning. Quantify the performance, record results of the performance tests, and report them to the appropriate authority." ;
             ex:designatesProcessType ex:P10272 ;
             ex:hierarchyID "13.6.3.4" ;
             ex:pcfID "10272" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20147 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate performance measures" .


###  http://example.org/apqc#PCF_10273
ex:PCF_10273 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing the trends in performance. Carefully and strategically assess the results in order to effectively spot the trends." ;
             ex:designatesProcessType ex:P10273 ;
             ex:hierarchyID "13.6.3.5" ;
             ex:pcfID "10273" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20147 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify performance trends" .


###  http://example.org/apqc#PCF_10274
ex:PCF_10274 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the gaps between achieved and benchmarked performance. Analyze how performance differs from the optimal or expected performance. " ;
             ex:designatesProcessType ex:P10274 ;
             ex:hierarchyID "13.6.3.6" ;
             ex:pcfID "10274" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20147 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze performance" .


###  http://example.org/apqc#PCF_10275
ex:PCF_10275 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating reports that systematically record and represent the performance planning. Construct a detailed report specifying the performance, and include indicators such as the performance gaps, performance trends, and analysis." ;
             ex:designatesProcessType ex:P10275 ;
             ex:hierarchyID "13.6.3.7" ;
             ex:pcfID "10275" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20147 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prepare performance reports" .


###  http://example.org/apqc#PCF_10276
ex:PCF_10276 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Using performance indicators to report, analyze, and create a detailed performance improvement plan to bridge the performance gaps." ;
             ex:designatesProcessType ex:P10276 ;
             ex:hierarchyID "13.6.3.8" ;
             ex:pcfID "10276" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20147 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop performance improvement plan" .


###  http://example.org/apqc#PCF_10277
ex:PCF_10277 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating strategies for procuring materials and services from various sources, and for managing and evaluating categories. Establish a procurement process that describes the approach for obtaining products and purchasing activities. Evaluate the sources. Create sourcing relationships in order to continuously improve. Re-evaluate purchasing activities. " ;
             ex:designatesProcessType ex:P10277 ;
             ex:hierarchyID "4.2.1" ;
             ex:pcfID "10277" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide sourcing governance and perform category management" .


###  http://example.org/apqc#PCF_10278
ex:PCF_10278 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating supplier options to select the most effective and efficient suppliers. Validate selected suppliers. Establish and manage supplier contracts." ;
             ex:designatesProcessType ex:P10278 ;
             ex:hierarchyID "4.2.2" ;
             ex:pcfID "10278" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select suppliers and develop/maintain contracts" .


###  http://example.org/apqc#PCF_10279
ex:PCF_10279 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and approving requisitions and distributing purchase orders accordingly. Hasten the procurement process to satisfy internal needs." ;
             ex:designatesProcessType ex:P10279 ;
             ex:hierarchyID "4.2.3" ;
             ex:pcfID "10279" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Order materials and services" .


###  http://example.org/apqc#PCF_10280
ex:PCF_10280 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Collecting and analyzing new information in order to track and rate suppliers through a supplier information management system." ;
             ex:designatesProcessType ex:P10280 ;
             ex:hierarchyID "4.2.4" ;
             ex:pcfID "10280" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage suppliers" .


###  http://example.org/apqc#PCF_10281
ex:PCF_10281 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan for procuring materials and services. Plan what to buy, when, and from what sources. Include project requirements, the procurement team, the justification for the procurement, a timeline of events, and an explanation of the supplier selection process. Outline specific actions to start and complete purchases in order to adhere to best practices." ;
             ex:designatesProcessType ex:P10281 ;
             ex:hierarchyID "4.2.1.1" ;
             ex:pcfID "10281" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10277 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop procurement plan" .


###  http://example.org/apqc#PCF_10282
ex:PCF_10282 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the purchasing requirements for materials and services. Specify the exact inventory required for the production process. Create a specific quotation for all the sources in order to avoid any duplication or overlap." ;
             ex:designatesProcessType ex:P10282 ;
             ex:hierarchyID "4.2.1.2" ;
             ex:pcfID "10282" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10277 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Clarify purchasing requirements" .


###  http://example.org/apqc#PCF_10283
ex:PCF_10283 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a strategy to deal with issues projected to arise during implementation of the inventory plan. Identify how to react to issues that arise and require changes to the inventory plan, such as a vendor failing to deliver materials on time. Collaborate with production and suppliers to prepare solutions to projected problems." ;
             ex:designatesProcessType ex:P10283 ;
             ex:hierarchyID "4.2.1.3" ;
             ex:pcfID "10283" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10277 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish materials management contingency plans" .


###  http://example.org/apqc#PCF_10284
ex:PCF_10284 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Synchronizing the requirements of materials and services and the capacity of suppliers for providing these materials and services. Revamp the procurement needs of the company in consideration of the capabilities of the suppliers. " ;
             ex:designatesProcessType ex:P10284 ;
             ex:hierarchyID "4.2.1.4" ;
             ex:pcfID "10284" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10277 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Match needs to supply capabilities" .


###  http://example.org/apqc#PCF_10285
ex:PCF_10285 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the spend profile of the organization. Collect, cleanse, classify, and analyze the procurement data with the purpose of reducing procurement costs, improving efficiency, and monitoring compliance." ;
             ex:designatesProcessType ex:P10285 ;
             ex:hierarchyID "4.2.1.5" ;
             ex:pcfID "10285" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10277 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze organization’s spend profile" .


###  http://example.org/apqc#PCF_10286
ex:PCF_10286 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Seeking the most efficient sourcing and procurement opportunities." ;
             ex:designatesProcessType ex:P10286 ;
             ex:hierarchyID "4.2.1.6" ;
             ex:pcfID "10286" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10277 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Seek opportunities to improve efficiency and value" .


###  http://example.org/apqc#PCF_10287
ex:PCF_10287 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Collaborating with the suppliers of materials and services in order to determine new opportunities for sourcing. " ;
             ex:designatesProcessType ex:P10287 ;
             ex:hierarchyID "4.2.1.7" ;
             ex:pcfID "10287" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10277 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Collaborate with suppliers to identify sourcing opportunities" .


###  http://example.org/apqc#PCF_10288
ex:PCF_10288 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the pros and cons of various suppliers. Choose the most appropriate and cost-effective suppliers on the basis of their material quality, delivery schedules, and costs." ;
             ex:designatesProcessType ex:P10288 ;
             ex:hierarchyID "4.2.2.1" ;
             ex:pcfID "10288" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10278 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select suppliers" .


###  http://example.org/apqc#PCF_10289
ex:PCF_10289 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Validating the supply sources, and provide certification as an official supplier." ;
             ex:designatesProcessType ex:P10289 ;
             ex:hierarchyID "4.2.2.2" ;
             ex:pcfID "10289" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10278 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Certify and validate suppliers" .


###  http://example.org/apqc#PCF_10290
ex:PCF_10290 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Legally binding suppliers with the company. Negotiate contracts individually with all the suppliers that include the promised material delivery, the delivery dates and duration, etc." ;
             ex:designatesProcessType ex:P10290 ;
             ex:hierarchyID "4.2.2.3" ;
             ex:pcfID "10290" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10278 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Negotiate and establish contracts" .


###  http://example.org/apqc#PCF_10291
ex:PCF_10291 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Keeping contracts up-to-date with routine evaluation. Maintain order and discipline with the contracts in order to avoid any loss of information and mishaps." ;
             ex:designatesProcessType ex:P10291 ;
             ex:hierarchyID "4.2.2.4" ;
             ex:pcfID "10291" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10278 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage contracts" .


###  http://example.org/apqc#PCF_10292
ex:PCF_10292 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling operations related to processing/reviewing the requisitions. Establish and maintain procedures for the initiation, authorization, and processing of purchase requirements to procure products/services." ;
             ex:designatesProcessType ex:P10292 ;
             ex:hierarchyID "4.2.3.1" ;
             ex:pcfID "10292" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10279 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process/Review requisitions" .


###  http://example.org/apqc#PCF_10293
ex:PCF_10293 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Approving requisitions for materials and services. Examine distributor-specific requests, and validate them individually." ;
             ex:designatesProcessType ex:P10293 ;
             ex:hierarchyID "4.2.3.2" ;
             ex:pcfID "10293" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10279 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Approve requisitions" .


###  http://example.org/apqc#PCF_10294
ex:PCF_10294 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Requesting quotes from suppliers. Use a request for quotation (RFQ) to invite suppliers into a bidding process for specific products/services." ;
             ex:designatesProcessType ex:P10294 ;
             ex:hierarchyID "4.2.3.3" ;
             ex:pcfID "10294" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10279 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Solicit supplier quotes" .


###  http://example.org/apqc#PCF_10295
ex:PCF_10295 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and placing the orders for purchasing materials and services from suppliers. Analyze vendor quotes. Choose the most cost-effective vendors. Create vendor-specific orders. Distribute them in order to initiate the purchasing process." ;
             ex:designatesProcessType ex:P10295 ;
             ex:hierarchyID "4.2.3.4" ;
             ex:pcfID "10295" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10279 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create/Distribute purchase orders" .


###  http://example.org/apqc#PCF_10296
ex:PCF_10296 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Accelerating the purchase orders in order to fulfill the internal needs (for raw materials) depicted through inquiries. " ;
             ex:designatesProcessType ex:P10296 ;
             ex:hierarchyID "4.2.3.5" ;
             ex:pcfID "10296" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10279 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Expedite orders and satisfy inquiries" .


###  http://example.org/apqc#PCF_10297
ex:PCF_10297 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Verify that purchase orders are filled as expected: verify that items and quantities are delivered as expected, based on purchase order details and goods receipts." ;
             ex:designatesProcessType ex:P10297 ;
             ex:hierarchyID "4.2.3.6" ;
             ex:pcfID "10297" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10279 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Reconcile purchase orders" .


###  http://example.org/apqc#PCF_10298
ex:PCF_10298 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and resolving any exceptions. Address the internal needs/inquiries for materials that cannot be procured immediately. Research inquiries that require the need of exceptional materials." ;
             ex:designatesProcessType ex:P10298 ;
             ex:hierarchyID "4.2.3.7" ;
             ex:pcfID "10298" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10279 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Research/Resolve order exceptions" .


###  http://example.org/apqc#PCF_10299
ex:PCF_10299 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining procurement and vendor performance. Report delivery timing and the quality of the materials procured through different vendors." ;
             ex:designatesProcessType ex:P10299 ;
             ex:hierarchyID "4.2.4.1" ;
             ex:pcfID "10299" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10280 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor/Manage supplier information" .


###  http://example.org/apqc#PCF_10300
ex:PCF_10300 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assisting the production and inventory processes through the information and reports created. Use the information and metrics of the procurement and vendor performance to enhance or improve the production process." ;
             ex:designatesProcessType ex:P10300 ;
             ex:hierarchyID "4.2.4.2" ;
             ex:pcfID "10300" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10280 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prepare/Analyze procurement and supplier performance" .


###  http://example.org/apqc#PCF_10301
ex:PCF_10301 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Support inventory and production processes by analyzing impact of procurement decisions and collaborating to constantly improve. (For example, perhaps minimum order requirements could be negotiated to be lower, to reduce excessive inventory and make production more flexible.)" ;
             ex:designatesProcessType ex:P10301 ;
             ex:hierarchyID "4.2.4.3" ;
             ex:pcfID "10301" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10280 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Support inventory and production processes" .


###  http://example.org/apqc#PCF_10302
ex:PCF_10302 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Track the performance of the suppliers on product quality. Use this information to further improve sourcing and supplier performance. " ;
             ex:designatesProcessType ex:P10302 ;
             ex:hierarchyID "4.2.4.4" ;
             ex:pcfID "10302" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10280 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor quality of product delivered" .


###  http://example.org/apqc#PCF_10303
ex:PCF_10303 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Scheduling the production of final products. Generate a detailed schedule plan. Create and release production orders and lots. Schedule the planned and unplanned maintenance orders." ;
             ex:designatesProcessType ex:P10303 ;
             ex:hierarchyID "4.3.1" ;
             ex:pcfID "10303" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10217 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Schedule production" .


###  http://example.org/apqc#PCF_10304
ex:PCF_10304 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Manufacturing the product. Convert the raw materials to develop consumer-ready products. Manage the raw materials to implement the detailed production schedule. Reproduce defectives to establish and remediate cause. Ensure production optimization and benchmark performance." ;
             ex:designatesProcessType ex:P10304 ;
             ex:hierarchyID "4.3.2" ;
             ex:pcfID "10304" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10217 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Produce/Assemble product" .


###  http://example.org/apqc#PCF_10306
ex:PCF_10306 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Initiating the line-level plan for production. Break down the production schedule into specific lines, specifying the various objectives the production schedule." ;
             ex:designatesProcessType ex:P10306 ;
             ex:hierarchyID "4.3.1.2" ;
             ex:pcfID "10306" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10303 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Generate line level plan" .


###  http://example.org/apqc#PCF_10307
ex:PCF_10307 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Broadening the line-level plan. Specify all the individual production processes, along with the timing and the duration to come up with a working schedule that tracks the whole process and any deviations that might occur." ;
             ex:designatesProcessType ex:P10307 ;
             ex:hierarchyID "4.3.1.3" ;
             ex:pcfID "10307" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10303 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Generate detailed schedule" .


###  http://example.org/apqc#PCF_10308
ex:PCF_10308 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a schedule to commence production of orders received, and creating lots to consolidate the processing. Plan when the production orders are to be initiated by commencing the operations for processing products/services. Specify which materials to produce, where to produce them, which operations will facilitate this, and on which date production is to start. Define the size of production lots, demarcating the durations of batch production." ;
             ex:designatesProcessType ex:P10308 ;
             ex:hierarchyID "4.3.1.4" ;
             ex:pcfID "10308" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10303 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Schedule production orders and create lots" .


###  http://example.org/apqc#PCF_10309
ex:PCF_10309 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Initiating the delivery of production orders, and creating lots. Communicate the order that specifies which material to produce, where to produce it, which operations to require, and on which date production takes place. Define how to settle the order costs. Create production lots, which is a particular production unit of an assembly that is planned and manufactured." ;
             ex:designatesProcessType ex:P10309 ;
             ex:hierarchyID "4.3.1.7" ;
             ex:pcfID "10309" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10303 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Release production orders and create lots" .


###  http://example.org/apqc#PCF_10310
ex:PCF_10310 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the inventory of raw materials. Manage the total cost of all component parts in stock but not yet used. Manage the cost of the direct materials (i.e., materials incorporated into the final product) and indirect materials (i.e., materials not incorporated into the final product but consumed during the production process)." ;
             ex:hierarchyID "4.3.2.1" ;
             ex:pcfID "10310" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10304 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage raw material inventory" .


###  http://example.org/apqc#PCF_10311
ex:PCF_10311 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and implementing the detailed line production schedule on the ground level. " ;
             ex:designatesProcessType ex:P10311 ;
             ex:hierarchyID "4.3.2.2" ;
             ex:pcfID "10311" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10304 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute detailed line schedule" .


###  http://example.org/apqc#PCF_10313
ex:PCF_10313 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reproducing the items produced defectively. Assess the produced items by conducting quality and standardization tests in order to diagnose any discrepancies. Reproduce defective items." ;
             ex:designatesProcessType ex:P10313 ;
             ex:hierarchyID "4.3.2.4" ;
             ex:pcfID "10313" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10304 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Rerun defective items" .


###  http://example.org/apqc#PCF_10314
ex:PCF_10314 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing and benchmarking the production process to judge its effectiveness and efficiency. Create production metrics to numerically calculate the performance of the production process." ;
             ex:designatesProcessType ex:P10314 ;
             ex:hierarchyID "4.3.2.6" ;
             ex:pcfID "10314" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10304 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess production performance" .


###  http://example.org/apqc#PCF_10315
ex:PCF_10315 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Scheduling planned maintenance of the production equipment." ;
             ex:designatesProcessType ex:P10315 ;
             ex:hierarchyID "4.3.1.5" ;
             ex:pcfID "10315" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10303 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan for preventive maintenance" .


###  http://example.org/apqc#PCF_10316
ex:PCF_10316 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Scheduling requested maintenance in order to address breakdowns where repairs or corrective remedies are needed immediately. Create a scheme for undertaking unplanned maintenance work on equipment/machinery that has come to be in urgent need for it. Express turnaround to redress using specialized personnel." ;
             ex:designatesProcessType ex:P10316 ;
             ex:hierarchyID "4.3.1.6" ;
             ex:pcfID "10316" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10303 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Request unplanned maintenance" .


###  http://example.org/apqc#PCF_10318
ex:PCF_10318 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Regulating the equipment used for performing quality tests. Assess correspondence between the quality testing equipment and the desired quality standards. Ensure the calibration standard is more accurate than the instrument being tested." ;
             ex:designatesProcessType ex:P10318 ;
             ex:hierarchyID "4.3.3.1" ;
             ex:pcfID "10318" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10369 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calibrate test equipment" .


###  http://example.org/apqc#PCF_10319
ex:PCF_10319 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recording and reporting any deviations or issues in the maintenance schedule, in the performance to the production management team, and for unplanned maintenance." ;
             ex:designatesProcessType ex:P10319 ;
             ex:hierarchyID "4.3.2.3" ;
             ex:pcfID "10319" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10304 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report maintenance issues" .


###  http://example.org/apqc#PCF_10320
ex:PCF_10320 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Acquiring or soliciting information about specific service requirements for individual customers through the customer service function. Obtain information about customer specific requests, process these requests, and create customer profiles to generate a service order." ;
             ex:designatesProcessType ex:P10320 ;
             ex:hierarchyID "6.3.4.1" ;
             ex:pcfID "10320" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10218 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Confirm specific service requirements for individual customer" .


###  http://example.org/apqc#PCF_10321
ex:PCF_10321 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining and scheduling the resources required to fulfill customer service requirements. Create a detailed schedule about the service orders and development of these service orders. " ;
             ex:designatesProcessType ex:P10321 ;
             ex:hierarchyID "6.3.4.2" ;
             ex:pcfID "10321" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10218 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify and schedule resources to meet service requirements" .


###  http://example.org/apqc#PCF_10322
ex:PCF_10322 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Dispatching resources for managing and fulfilling daily service requirements. Manage the progress of order fulfillment. Complete order blocks. " ;
             ex:designatesProcessType ex:P10322 ;
             ex:hierarchyID "6.3.4.3" ;
             ex:pcfID "10322" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10218 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide service to specific customers" .


###  http://example.org/apqc#PCF_10323
ex:PCF_10323 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Guaranteeing the quality of service provided to customers. Identify the successful and unsuccessful orders along with the service failures. Collect customer feedback. Process the feedback to ensure the quality of service in the future. " ;
             ex:designatesProcessType ex:P10323 ;
             ex:hierarchyID "6.3.4.4" ;
             ex:pcfID "10323" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10218 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Ensure quality of service" .


###  http://example.org/apqc#PCF_10324
ex:PCF_10324 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Soliciting or acquiring information using various sources such as databases, customer interactions, and customer request forms. Hand them further up the hierarchy to deal with them. Categorize the user's request, determining if the request is supportable and prioritizing the request." ;
             ex:designatesProcessType ex:P10324 ;
             ex:hierarchyID "6.3.4.1.1" ;
             ex:pcfID "10324" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10320 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process customer request" .


###  http://example.org/apqc#PCF_10325
ex:PCF_10325 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Documenting the individual customer service requirements solicited, along with personal information of the customers, in order to generate customized profiles that hasten the delivery process." ;
             ex:designatesProcessType ex:P10325 ;
             ex:hierarchyID "6.3.4.1.2" ;
             ex:pcfID "10325" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10320 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create customer profile" .


###  http://example.org/apqc#PCF_10326
ex:PCF_10326 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing a short-term agreement between the service provider and customer. One-time services are ordered by the service recipient and resource-related billing is performed upon completion. Use the service order to document service and customer service work." ;
             ex:designatesProcessType ex:P10326 ;
             ex:hierarchyID "6.3.4.1.3" ;
             ex:pcfID "10326" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10320 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Generate service order" .


###  http://example.org/apqc#PCF_10327
ex:PCF_10327 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a plan for sourcing and deploying the resources required to fulfill customer service needs. Document a detailed summary of all types of resources (equipment, finance, personnel, time, etc.) required to complete customer service requests and procure these resources. Identify and assess various sources in order to effectively create a resourcing plan." ;
             ex:designatesProcessType ex:P10327 ;
             ex:hierarchyID "6.3.4.2.1" ;
             ex:pcfID "10327" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10321 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create resourcing plan and schedule" .


###  http://example.org/apqc#PCF_10328
ex:PCF_10328 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing a detailed summary of customer service order requirements, along with information concerning the timing and duration for these services. Categorize the customer needs. Monitor the services delivered." ;
             ex:designatesProcessType ex:P10328 ;
             ex:hierarchyID "6.3.4.2.2" ;
             ex:pcfID "10328" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10321 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create service order fulfillment schedule" .


###  http://example.org/apqc#PCF_10330
ex:PCF_10330 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Laying out a daily plan of specific service orders that need to be fulfilled. Document and systematically order these activities to ensure high effectiveness and efficiency." ;
             ex:designatesProcessType ex:P10330 ;
             ex:hierarchyID "6.3.4.3.1" ;
             ex:pcfID "10330" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10322 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Organize daily service order fulfillment schedule" .


###  http://example.org/apqc#PCF_10331
ex:PCF_10331 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Dispatching and delivering the resources needed for the specific service requirements from the source/warehouse. Manage the dispatch, transportation, and delivery of the services." ;
             ex:designatesProcessType ex:P10331 ;
             ex:hierarchyID "6.3.4.3.2" ;
             ex:pcfID "10331" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10322 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute product repair" .


###  http://example.org/apqc#PCF_10332
ex:PCF_10332 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling and managing orders fulfilled, along with the orders are not or partially fulfilled to track the order fulfillment progress. Use electronic devices such as trackers and GPS in order track and ensure delivery of the orders." ;
             ex:designatesProcessType ex:P10332 ;
             ex:hierarchyID "6.3.4.3.3" ;
             ex:pcfID "10332" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10322 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage service order fulfillment" .


###  http://example.org/apqc#PCF_10334
ex:PCF_10334 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the service orders that have been successfully delivered. Identify the service orders completed and delivered to the customer. Leverage communication systems to ensure coordination with the customers in order to avoid mishaps." ;
             ex:designatesProcessType ex:P10334 ;
             ex:hierarchyID "6.3.4.4.1" ;
             ex:pcfID "10334" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10323 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify completed service orders for feedback" .


###  http://example.org/apqc#PCF_10335
ex:PCF_10335 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining orders which have not been completed or delivered. Identify the service orders that are partially or entirely incomplete, as well as the orders that have not been delivered to the customer. Use techniques such as project trackers to recognize the progress of the service orders." ;
             ex:designatesProcessType ex:P10335 ;
             ex:hierarchyID "6.3.4.4.2" ;
             ex:pcfID "10335" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10323 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify incomplete service orders and service failures" .


###  http://example.org/apqc#PCF_10336
ex:PCF_10336 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Obtaining and procuring customer reviews or feedback on the services delivered. Design a customer feedback form, or communicate with the customer through the phone or online." ;
             ex:designatesProcessType ex:P10336 ;
             ex:hierarchyID "6.3.4.4.3" ;
             ex:pcfID "10336" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10323 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Solicit customer feedback on services delivered" .


###  http://example.org/apqc#PCF_10337
ex:PCF_10337 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing and incorporating customer reviews/feedback into the service plan to ensure high quality of service. " ;
             ex:designatesProcessType ex:P10337 ;
             ex:hierarchyID "6.3.4.4.4" ;
             ex:pcfID "10337" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10323 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process customer feedback on services delivered" .


###  http://example.org/apqc#PCF_10338
ex:PCF_10338 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the strategy for managing logistics. Translate customer requirements logistic requirements. Create an efficient logistic network and outsourcing portions of logistics activities. Design a logistics strategy that optimizes transportation costs and schedule. Define key performance indicators." ;
             ex:designatesProcessType ex:P10338 ;
             ex:hierarchyID "4.4.1" ;
             ex:pcfID "10338" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10219 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide logistics governance" .


###  http://example.org/apqc#PCF_10340
ex:PCF_10340 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Tracking the inventory deployment. Accept and store products. Ship the products. Measure the accuracy of the inventory. Assess the performance of the outsourced logistics activities." ;
             ex:designatesProcessType ex:P10340 ;
             ex:hierarchyID "4.4.3" ;
             ex:pcfID "10340" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10219 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Operate warehousing" .


###  http://example.org/apqc#PCF_10341
ex:PCF_10341 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan that specifies the schedule and system for transportation and delivery of the outbound products, as well as tracking the performance of the carrier delivery system. Conduct vehicle management and processing of all carrier-related documents." ;
             ex:designatesProcessType ex:P10341 ;
             ex:hierarchyID "4.4.4" ;
             ex:pcfID "10341" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10219 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Operate outbound transportation" .


###  http://example.org/apqc#PCF_10343
ex:PCF_10343 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the requirements for managing the flow of things between the point of origin and the point of consumption by assessing the service requirements of the customers." ;
             ex:designatesProcessType ex:P10343 ;
             ex:hierarchyID "4.4.1.1" ;
             ex:pcfID "10343" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10338 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Translate customer service requirements into logistics requirements" .


###  http://example.org/apqc#PCF_10344
ex:PCF_10344 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a network for logistical activities. Create a network of entities through which materials and information flow, encompassing all related activities associated with the flow of transformation of products." ;
             ex:designatesProcessType ex:P10344 ;
             ex:hierarchyID "4.4.1.2" ;
             ex:pcfID "10344" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10338 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design logistics network" .


###  http://example.org/apqc#PCF_10345
ex:PCF_10345 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conveying outsourcing needs within the organization, with the objective of sourcing the assistance required. Define the portion of logistical activities that can be transferred to outside suppliers. Assess third-party agencies to carefully select the most appropriate agencies for outsourcing. Convey these needs to management or the appropriate authority." ;
             ex:designatesProcessType ex:P10345 ;
             ex:hierarchyID "4.4.1.3" ;
             ex:pcfID "10345" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10338 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate outsourcing needs" .


###  http://example.org/apqc#PCF_10346
ex:PCF_10346 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing rules and regulations, as well as the terms and conditions regarding the delivery of service by the company. Develop a delivery plan that specifies what, how, when, and in which way to deliver services to the customer." ;
             ex:designatesProcessType ex:P10346 ;
             ex:hierarchyID "4.4.1.4" ;
             ex:pcfID "10346" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10338 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and maintain delivery service policy" .


###  http://example.org/apqc#PCF_10347
ex:PCF_10347 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Optimizing the schedule and costs of transportation services. Design a logistics strategy by strategically creating delivery routes and systems, which optimizes the overall transportation schedules and costs. Evaluate different transportation sources in order to select the most appropriate and cost-effective sources." ;
             ex:designatesProcessType ex:P10347 ;
             ex:hierarchyID "4.4.1.5" ;
             ex:pcfID "10347" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10338 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Optimize transportation schedules and costs" .


###  http://example.org/apqc#PCF_10348
ex:PCF_10348 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing measures for evaluating the performance of the logistics strategy of the organization. Establish key performance indicators, including the logistics performance index, delivery in full, and delivery on time." ;
             ex:designatesProcessType ex:P10348 ;
             ex:hierarchyID "4.4.1.6" ;
             ex:pcfID "10348" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10338 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define key performance measures" .


###  http://example.org/apqc#PCF_10349
ex:PCF_10349 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the receipts of inbound materials. Create a plan accounting for the materials procured from the source of supply and the materials delivered to the distribution center or the warehouse." ;
             ex:designatesProcessType ex:P10349 ;
             ex:hierarchyID "4.4.2.1" ;
             ex:pcfID "10349" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20936 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan inbound material receipts" .


###  http://example.org/apqc#PCF_10350
ex:PCF_10350 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing all the internal activities related to the flow/transfer of materials. Manage materials being delivered to distribution center or warehouse. Gauge the time taken for delivery and if the delivery process is on time. " ;
             ex:designatesProcessType ex:P10350 ;
             ex:hierarchyID "4.4.2.2" ;
             ex:pcfID "10350" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20936 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage inbound material flow" .


###  http://example.org/apqc#PCF_10351
ex:PCF_10351 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Overseeing the performance of an inbound delivery system. Check the present delivery system's efficiency, cost effectiveness, and adherence to a delivery schedule." ;
             ex:designatesProcessType ex:P10351 ;
             ex:hierarchyID "4.4.2.3" ;
             ex:pcfID "10351" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20936 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor inbound delivery performance" .


###  http://example.org/apqc#PCF_10352
ex:PCF_10352 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Tracking and taking care of the products that have been internally returned either because of their deficiency or in cases of incorrect delivery. " ;
             ex:designatesProcessType ex:P10352 ;
             ex:hierarchyID "4.4.2.4" ;
             ex:pcfID "10352" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20936 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage flow of returned products" .


###  http://example.org/apqc#PCF_10353
ex:PCF_10353 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Tracking the logistical act of delivering or releasing an inventory item or entity to targeted end users. Track how much inventory has been deployed at all the distribution centers, individually." ;
             ex:designatesProcessType ex:P10353 ;
             ex:hierarchyID "4.4.3.1" ;
             ex:pcfID "10353" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10340 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage and track inventory deployment" .


###  http://example.org/apqc#PCF_10354
ex:PCF_10354 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Coordinating the incoming inbound materials/products. Accept the delivery of these materials and the subsequent storage. Track them at the warehouse/distribution center. " ;
             ex:designatesProcessType ex:P10354 ;
             ex:hierarchyID "4.4.3.2" ;
             ex:pcfID "10354" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10340 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Receive, inspect, and store inbound deliveries" .


###  http://example.org/apqc#PCF_10355
ex:PCF_10355 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Keeping track of the availability of different materials/products at the warehouse and distribution centers. " ;
             ex:designatesProcessType ex:P10355 ;
             ex:hierarchyID "4.4.3.3" ;
             ex:pcfID "10355" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10340 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track product availability" .


###  http://example.org/apqc#PCF_10356
ex:PCF_10356 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Packing and shipping the product to deliver to the customer. Take care of the internal and external packaging of the products in order to ensure safe transportation of the products from the warehouse to delivery locations. Notify the ERP system and/or Accounts Receivable Dept." ;
             ex:designatesProcessType ex:P10356 ;
             ex:hierarchyID "4.4.3.4" ;
             ex:pcfID "10356" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10340 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Pick, pack, and ship product for delivery" .


###  http://example.org/apqc#PCF_10357
ex:PCF_10357 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Monitoring any discrepancies between electronic records that represent the inventory and the physical state of the inventory. Look for discrepancies such as phantom inventory, which includes products that an inventory accounting system considers to be available at the storage location but are not actually available." ;
             ex:designatesProcessType ex:P10357 ;
             ex:hierarchyID "4.4.3.5" ;
             ex:pcfID "10357" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10340 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track inventory accuracy" .


###  http://example.org/apqc#PCF_10358
ex:PCF_10358 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Keeping a track on the storage and shipping performance of third-party agencies. Monitor logistics storage and shipping performance for third-party agencies. Use measures such as a logistics scoreboard, activity-based costing, economic value analysis, and balanced scorecards." ;
             ex:designatesProcessType ex:P10358 ;
             ex:hierarchyID "4.4.3.6" ;
             ex:pcfID "10358" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10340 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track third-party logistics storage and shipping performance" .


###  http://example.org/apqc#PCF_10359
ex:PCF_10359 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the movement of the finished products that are processed by the organization through its warehouses. Track goods through the use of systems such as barcodes in order to monitor the volumes available, quantity of out-flowing goods, remaining shelf life of the product, etc.--ultimately, to best manage the warehouse capacity." ;
             ex:designatesProcessType ex:P10359 ;
             ex:hierarchyID "4.4.3.7" ;
             ex:pcfID "10359" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10340 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage physical finished goods inventory" .


###  http://example.org/apqc#PCF_10360
ex:PCF_10360 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Organizing the transportation and delivery of outbound products. Plan and organize the transportation, shipping, and delivery of the end products. Create a plan that specifies dispatch and delivery of the product to its destination, as well the transportation." ;
             ex:designatesProcessType ex:P10360 ;
             ex:hierarchyID "4.4.4.1" ;
             ex:pcfID "10360" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10341 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan, transport, and deliver outbound product" .


###  http://example.org/apqc#PCF_10361
ex:PCF_10361 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Monitoring delivery performance when carrying products from the warehouse/distribution centers to the retailers or end consumers. Create a performance metrics based on the key performance indicators." ;
             ex:designatesProcessType ex:P10361 ;
             ex:hierarchyID "4.4.4.2" ;
             ex:pcfID "10361" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10341 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track carrier delivery performance" .


###  http://example.org/apqc#PCF_10362
ex:PCF_10362 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Taking care of a range of functions related to the means of transport used for delivering the end products. Manage vehicle financing, vehicle maintenance, vehicle telematics (tracking and diagnostics), driver management, speed management, fuel management, and health and safety management." ;
             ex:designatesProcessType ex:FleetManagementCapability ;
             ex:hierarchyID "4.4.4.3" ;
             ex:pcfID "10362" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10341 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage transportation fleet" .


###  http://example.org/apqc#PCF_10363
ex:PCF_10363 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Organizing and inspecting all account statements and any other documentation for the carriers used in delivery. Create, manage, and inspect all documents related to the financial, regulatory, and administrative accounts of all the carriers/freights. Generate receipts for all freight transactions." ;
             ex:designatesProcessType ex:P10363 ;
             ex:hierarchyID "4.4.4.4" ;
             ex:pcfID "10363" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10341 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process and audit carrier invoices and documents" .


###  http://example.org/apqc#PCF_10364
ex:PCF_10364 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Approving and carrying forward the requests by the customers to return the product. This is part of the process of returning a product in order to receive a refund, replacement, or repair during the product's warranty period." ;
             ex:designatesProcessType ex:P10364 ;
             ex:hierarchyID "6.2.4.1" ;
             ex:pcfID "10364" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20094 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Authorize return" .


###  http://example.org/apqc#PCF_10366
ex:PCF_10366 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Executing activities for reinstating the returned products. Present the customer with additional incentives of compensation in case of any defective products delivery or any discrepancy in the product specifications in order to save the order from being permanently returned." ;
             ex:designatesProcessType ex:P10366 ;
             ex:hierarchyID "4.4.2.5.2" ;
             ex:pcfID "10366" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_20109 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform salvage activities" .


###  http://example.org/apqc#PCF_10368
ex:PCF_10368 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing standards and procedures for maintaining the quality of products/services. Establish desired quality targets. Create standardized procedures for the quality. Ensure quality specifications are effectively communicated." ;
             ex:designatesProcessType ex:P10368 ;
             ex:hierarchyID "4.1.8" ;
             ex:pcfID "10368" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop quality standards and procedures" .


###  http://example.org/apqc#PCF_10369
ex:PCF_10369 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Executing tests to evaluate the quality of the products manufactured. Calibrate the test equipment. Conduct the actual tests. Record the results and outcomes of the quality test conducted." ;
             ex:designatesProcessType ex:P10369 ;
             ex:hierarchyID "4.3.3" ;
             ex:pcfID "10369" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10217 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform quality testing" .


###  http://example.org/apqc#PCF_10370
ex:PCF_10370 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Perpetuating the production records by systematically documenting and using it to ensure the effective management of lots. Determine the lot numbering system and its use. (The lot number enables tracking of the constituent parts, as well as labor and equipment records involved in the manufacturing of a product. It enables manufacturers and to perform quality control checks, calculate expiration dates, and issue corrections of their production output.)" ;
             ex:designatesProcessType ex:P10370 ;
             ex:hierarchyID "4.3.4" ;
             ex:pcfID "10370" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10217 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain production records and manage lot traceability" .


###  http://example.org/apqc#PCF_10371
ex:PCF_10371 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining specific qualitative and quantitative target figures." ;
             ex:designatesProcessType ex:P10371 ;
             ex:hierarchyID "4.1.8.1" ;
             ex:pcfID "10371" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10368 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish quality targets" .


###  http://example.org/apqc#PCF_10372
ex:PCF_10372 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating standard procedures for testing the quality of products/services. Describe the steps of key processes to help ensure consistent and quality output. Define the routine instructions for performing the quality testing activity." ;
             ex:designatesProcessType ex:P10372 ;
             ex:hierarchyID "4.1.8.2" ;
             ex:pcfID "10372" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10368 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop standard testing procedures" .


###  http://example.org/apqc#PCF_10373
ex:PCF_10373 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Communicating the desired quality specifications to the manufacturing units, as well as the distribution centers, to avoid any misunderstanding or misinterpretation." ;
             ex:designatesProcessType ex:P10373 ;
             ex:hierarchyID "4.1.8.3" ;
             ex:pcfID "10373" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10368 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate quality specifications" .


###  http://example.org/apqc#PCF_10374
ex:PCF_10374 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Performing testing using calibrated equipment and in consent with the standard testing procedure, including testing time." ;
             ex:designatesProcessType ex:P10374 ;
             ex:hierarchyID "4.3.3.2" ;
             ex:pcfID "10374" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10369 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform testing using the standard testing procedure" .


###  http://example.org/apqc#PCF_10375
ex:PCF_10375 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Documenting the results and outcomes of the quality tests. Track the performance of the production process. Record/Document it to evaluate the qualitative efficiency of the production process. Use electronic devices and software in order to ensure effectiveness in recording the results and outcomes of the test." ;
             ex:designatesProcessType ex:P10375 ;
             ex:hierarchyID "4.3.3.4" ;
             ex:pcfID "10375" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10369 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Record test results" .


###  http://example.org/apqc#PCF_10376
ex:PCF_10376 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Allotting an identification number to a particular quantity or lot of material manufactured. Assign lot numbers on the basis of specific production units, material similarity, etc. Place lot numbers on the outside of packaging." ;
             ex:designatesProcessType ex:P10376 ;
             ex:hierarchyID "4.3.4.1" ;
             ex:pcfID "10376" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10370 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine lot numbering system" .


###  http://example.org/apqc#PCF_10377
ex:PCF_10377 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying the use of production lots. Define where, how, and when to use a specific production lot." ;
             ex:designatesProcessType ex:P10377 ;
             ex:hierarchyID "4.3.4.2" ;
             ex:pcfID "10377" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10370 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine lot use" .


###  http://example.org/apqc#PCF_10378
ex:PCF_10378 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining a plan that removes customer obstacles by gathering operational insight and competitive insight, as well as improving soft skills and forward resolution for employees. Develop customer segmentation. Define rules and regulations for customer service. Establish service levels for customers." ;
             ex:designatesProcessType ex:P10378 ;
             ex:hierarchyID "6.1" ;
             ex:pcfID "10378" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_20085 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop customer service strategy" .


###  http://example.org/apqc#PCF_10379
ex:PCF_10379 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Planning and administering work force operations for customer service provision by taking care of customer services requests/inquiries, as well as the complaints." ;
             ex:hierarchyID "6.2" ;
             ex:pcfID "10379" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_20085 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan and manage customer service contacts" .


###  http://example.org/apqc#PCF_10382
ex:PCF_10382 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the framework of policies and methods for developing customer service strategy. Establish the rules and regulations that serve as a guideline for the customer service strategy. Take into account customer needs and behavior." ;
             ex:designatesProcessType ex:P10382 ;
             ex:hierarchyID "6.1.4" ;
             ex:pcfID "10382" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10378 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define customer service policies and procedures" .


###  http://example.org/apqc#PCF_10383
ex:PCF_10383 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining and implementing levels for customer services. Benchmark certain customer service practices, and base customer level services on those benchmarks. Create a service level agreement, which is a negotiated agreement designed to create a common understanding about services, priorities, and responsibilities." ;
             ex:designatesProcessType ex:P10383 ;
             ex:hierarchyID "6.1.5" ;
             ex:pcfID "10383" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10378 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish target service level for each customer segment" .


###  http://example.org/apqc#PCF_10387
ex:PCF_10387 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and administering the work force deployed for the customer service process. Forecast the customer work force needs to correctly schedule the work force. Track the utility of the work force deployed. Examine the interactions between the customer and customer service representatives to achieve high quality." ;
             ex:designatesProcessType ex:CustomerServiceWorkforceManagementCapability ;
             ex:hierarchyID "6.2.1" ;
             ex:pcfID "10387" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10379 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan and manage customer service work force" .


###  http://example.org/apqc#PCF_10388
ex:PCF_10388 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling the requests and inquiries from customers that seek information regarding the organization's products/services. Obtain the customer requests online and by phone. Direct these requests to higher-level representatives. Approve requests, and respond to customers." ;
             ex:designatesProcessType ex:CustomerInquiryManagementCapability ;
             ex:hierarchyID "6.2.2" ;
             ex:pcfID "10388" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10379 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage customer service problems, requests, and inquiries" .


###  http://example.org/apqc#PCF_10389
ex:PCF_10389 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Obtaining customer complaints online or by phone. Direct these complaints to higher-level representatives as appropriate. Resolve them. Respond to customers." ;
             ex:designatesProcessType ex:CustomerComplaintManagementCapability ;
             ex:hierarchyID "6.2.3" ;
             ex:pcfID "10389" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10379 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage customer complaints" .


###  http://example.org/apqc#PCF_10390
ex:PCF_10390 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Projecting the total work force required to service customer service inquiries in order to effectively predict the volume of vendor contracts required. Estimate the number of the customer service contracts in an agreed-upon time frame in order to strategically maintain the work force necessitated for customer inquires. Analyze historical data around customer service contracts, the universe of customer inquiries, frequency of inquiries, servicing capability (per head) of the employees, etc." ;
             ex:designatesProcessType ex:P10390 ;
             ex:hierarchyID "6.2.1.1" ;
             ex:pcfID "10390" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Forecast volume of customer service contacts" .


###  http://example.org/apqc#PCF_10391
ex:PCF_10391 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Deploying the work force to manage customer service contracts. Create a systematic summary of the operations and service required, as well as the specific amount of work force that is to be deployed to the customer service operations. Ensure work force is directly proportional to the estimated forecast of customer service contracts." ;
             ex:designatesProcessType ex:P10391 ;
             ex:hierarchyID "6.2.1.2" ;
             ex:pcfID "10391" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Schedule customer service work force" .


###  http://example.org/apqc#PCF_10392
ex:PCF_10392 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Tracking the utilization of work force deployed for managing customer service operations. Monitor the utility of the work force deployed for managing customer service operations in order to evaluate its efficiency and cost effectiveness. Calculate the overall labor effectiveness, which measures the utility, performance, and quality of the work force." ;
             ex:designatesProcessType ex:P10392 ;
             ex:hierarchyID "6.2.1.3" ;
             ex:pcfID "10392" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track work force utilization" .


###  http://example.org/apqc#PCF_10393
ex:PCF_10393 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Tracking and determining the quality of interactions between the customer and customer representatives. Use electronic devices to record and effectively assess customer representatives' interactions. " ;
             ex:designatesProcessType ex:P10393 ;
             ex:hierarchyID "6.2.1.4" ;
             ex:pcfID "10393" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor and evaluate quality of customer interactions with customer service representatives" .


###  http://example.org/apqc#PCF_10394
ex:PCF_10394 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Receiving requests for information from customers over multiple channels. Receive various requests and inquiries from customers regarding products/services. Accept these inquiries through channels such as email, telephone, online forms, text messages, social media, and in person. Supply dedicated equipment, systems, and personnel." ;
             ex:designatesProcessType ex:P10394 ;
             ex:hierarchyID "6.2.2.1" ;
             ex:pcfID "10394" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10388 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Receive customer problems, requests, and inquiries" .


###  http://example.org/apqc#PCF_10395
ex:PCF_10395 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Routing customer inquiries in order to service them with the most apposite response. Direct customer inquires to the best suited personnel or system. Have a system or procedure capable of efficiently channeling these requests." ;
             ex:designatesProcessType ex:P10395 ;
             ex:hierarchyID "6.2.2.3" ;
             ex:pcfID "10395" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10388 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Resolve customer problems, requests, and inquiries" .


###  http://example.org/apqc#PCF_10396
ex:PCF_10396 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Responding to customer requests by email, conversation, interactive voice response, mail, etc. with the most appropriate reply. Instill a robust process to locate the right information for a solution to a customer's problem." ;
             ex:designatesProcessType ex:P10396 ;
             ex:hierarchyID "6.2.2.4" ;
             ex:pcfID "10396" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10388 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Respond to customer problems, requests, and inquiries" .


###  http://example.org/apqc#PCF_10397
ex:PCF_10397 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Receiving any complaints or grievances from customers for the organization's products/services. Receive objections, complaints, and criticism from customers regarding products/services through email, telephone, online forms, text messages, social media, in person, etc. Dedicate equipment, systems, and personnel." ;
             ex:designatesProcessType ex:P10397 ;
             ex:hierarchyID "6.2.3.1" ;
             ex:pcfID "10397" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10389 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Receive customer complaints" .


###  http://example.org/apqc#PCF_10398
ex:PCF_10398 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Routing any complaints or grievances received from customers in order to address them in the most appropriate manner. Direct complaints to the best suited personnel or system. Implement a system or procedure capable of efficiently channeling the various objections, complaints, and criticism from customers over the offerings provided by the organization." ;
             ex:designatesProcessType ex:P10398 ;
             ex:hierarchyID "6.2.3.2" ;
             ex:pcfID "10398" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10389 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Route customer complaints" .


###  http://example.org/apqc#PCF_10399
ex:PCF_10399 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Resolving any customer complaints that are deemed to be sound and reasonable. Redress any objections, grievances, and complaints received from customers regarding the offerings provided by the organization. Identify the legitimate complaints, where the situation needs to be appropriately corrected. Deploy personnel who can rectify the issue within a stipulated time frame." ;
             ex:designatesProcessType ex:P10399 ;
             ex:hierarchyID "6.2.3.3" ;
             ex:pcfID "10399" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10389 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Resolve customer complaints" .


###  http://example.org/apqc#PCF_10400
ex:PCF_10400 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Responding to customer complaints including all activities necessitated to service any objections, complaints, or grievances with the most appropriate reply. Source the right information to formulate a response that eases the discomfort being experienced by the customer. (Closely coordinate with Resolve customer complaints [10399].)" ;
             ex:designatesProcessType ex:P10400 ;
             ex:hierarchyID "6.2.3.4" ;
             ex:pcfID "10400" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10389 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Respond to customer complaints" .


###  http://example.org/apqc#PCF_10401
ex:PCF_10401 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating satisfaction levels of customers by effectively evaluating the process of handling requests/inquiries of customers. Effectively calculate the performance of customer-requests/inquiries handling and resolution. Obtain information regarding requests/inquiries handling and resolution through customer feedback. Use it to explore new ideas and opportunities for enhanced customer requests/inquiries handling and resolution process." ;
             ex:designatesProcessType ex:P10401 ;
             ex:hierarchyID "6.5.1" ;
             ex:pcfID "10401" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20595 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure customer satisfaction with customer problems, requests, and inquiries handling" .


###  http://example.org/apqc#PCF_10402
ex:PCF_10402 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Measuring the satisfaction level of customers as pertains to how their complaints are handled and resolved. This process element requires the organization to estimate the customers level of fulfillment with the process reconciling their complaints and towards the objective of ensuring customer retention. The feedback received can be used to develop concepts for new opportunities to boost the level of customer satisfaction." ;
             ex:designatesProcessType ex:P10402 ;
             ex:hierarchyID "6.5.2" ;
             ex:pcfID "10402" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20595 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure customer satisfaction with customer- complaint handling and resolution" .


###  http://example.org/apqc#PCF_10403
ex:PCF_10403 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Calculating satisfaction levels of customers with products/services. Obtain customer feedback on products/services, as well as the effectiveness of the advertising campaigns. Examine this information to reach meaningful conclusions, which could then be used to enhance the customer service operations." ;
             ex:designatesProcessType ex:P10403 ;
             ex:hierarchyID "6.5.3" ;
             ex:pcfID "10403" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20595 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure customer satisfaction with products and services" .


###  http://example.org/apqc#PCF_10410
ex:PCF_10410 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining and handling employee requirements. Recruit or source the candidates as per the requirements. Screen and select the most appropriate candidates. Take care of the newly hired and re-hired employees. Maintain records of information for all applicants. " ;
             ex:designatesProcessType ex:P10410 ;
             ex:hierarchyID "7.2" ;
             ex:pcfID "10410" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10007 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Recruit, source, and select employees" .


###  http://example.org/apqc#PCF_10412
ex:PCF_10412 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating frameworks for rewarding and recognizing employees with the objective of retaining them. Create and manage programs for provision of rewards, recognition, and motivation. Manage and administer the benefits for employees. Help assist and retain employees. Administer payroll to employees." ;
             ex:designatesProcessType ex:CompensationAndBenefitsCapability ;
             ex:hierarchyID "7.5" ;
             ex:pcfID "10412" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10007 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Reward and retain employees" .


###  http://example.org/apqc#PCF_10413
ex:PCF_10413 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the reassignment and retirement of employees. Manage the process of employee promotion and demotion. Administer separation, retirement, and leaves of absence. Outplace employees. Deploy personnel. Relocate employees in order to manage assignments." ;
             ex:designatesProcessType ex:P10413 ;
             ex:hierarchyID "7.6" ;
             ex:pcfID "10413" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10007 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Redeploy and retire employees" .


###  http://example.org/apqc#PCF_10417
ex:PCF_10417 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Supervising the HR strategy, plans, and policies in order to refurbish them whenever needed. Determine the performance of HR plans and policies by measuring the objective achievement rate and its contribution to the overall business strategy. Ensure that information about these plans and strategies is effectively communicated to various stakeholders. Incorporate any suggestions by these stakeholders when revising HR plans and policies." ;
             ex:designatesProcessType ex:P10417 ;
             ex:hierarchyID "7.1.3" ;
             ex:pcfID "10417" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17043 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor and update strategy, plans, and policies" .


###  http://example.org/apqc#PCF_10418
ex:PCF_10418 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Strategically defining the current and future needs for developing an efficient HR strategy. " ;
             ex:designatesProcessType ex:P10418 ;
             ex:hierarchyID "7.1.1.1" ;
             ex:pcfID "10418" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20958 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify strategic HR needs" .


###  http://example.org/apqc#PCF_10419
ex:PCF_10419 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the charge and duty of the HR function by defining its responsibility areas, as well as ensuring its accountability. Establish the HR function by laying out the roles and responsibilities for this function and the rules and regulations guiding HR. Define the goals and objectives of the HR, as well as a mission and vision for this function. Create a mechanism involving a set of policies, code of conduct, and institutional procedure to ensure HR accountability." ;
             ex:designatesProcessType ex:P10419 ;
             ex:hierarchyID "7.1.1.2" ;
             ex:pcfID "10419" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20958 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define HR and business function roles and accountability" .


###  http://example.org/apqc#PCF_10420
ex:PCF_10420 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ascertaining the costs and expenses of the HR function. Identify and report HR investments using, for example, a cost approach or a present value of future earnings approach." ;
             ex:designatesProcessType ex:P10420 ;
             ex:hierarchyID "7.1.1.5" ;
             ex:pcfID "10420" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20958 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine HR costs" .


###  http://example.org/apqc#PCF_10421
ex:PCF_10421 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the performance of HR function. Lay out the course of HR procedures that would formulate a plan of action needed to fulfill strategic HR needs. Deploy measures such as hiring policies, leave management, internal code of conducts, and compensation structure." ;
             ex:designatesProcessType ex:P10421 ;
             ex:hierarchyID "7.1.1.6" ;
             ex:pcfID "10421" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20958 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish HR measures" .


###  http://example.org/apqc#PCF_10422
ex:PCF_10422 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conveying the strategies of HR function to employees and management. Effectively explain the vision, plans, and anticipated benefits of the HR strategy employees, as well as the public. Develop statements and messages that are easy to read, informative, and relevant to the audience." ;
             ex:designatesProcessType ex:P10422 ;
             ex:hierarchyID "7.1.1.7" ;
             ex:pcfID "10422" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20958 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate HR strategies" .


###  http://example.org/apqc#PCF_10423
ex:PCF_10423 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the current and future skill requirements of the organization with regard to the overall corporate strategy of the organization and market conditions. Identify and establish the minimum skills needed for the requisite HR needs." ;
             ex:designatesProcessType ex:P10423 ;
             ex:hierarchyID "7.1.2.1" ;
             ex:pcfID "10423" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform workforce planning" .


###  http://example.org/apqc#PCF_10424
ex:PCF_10424 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the requirements for employees and the need for employee resourcing for each every unit/function. Lay out a plan detailing employee resourcing requirements of individual functions and the organization as a whole." ;
             ex:designatesProcessType ex:P10424 ;
             ex:hierarchyID "7.1.2.2" ;
             ex:pcfID "10424" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform operational workforce planning" .


###  http://example.org/apqc#PCF_10425
ex:PCF_10425 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing a plan that specifies the combination of wages, salaries, and benefits the employees receive in exchange for work. Define the total amount of compensation, in addition to the manner in which the compensation is paid and the purposes for which employees can receive bonuses, salary increases, and incentives." ;
             ex:designatesProcessType ex:P10425 ;
             ex:hierarchyID "7.1.2.3" ;
             ex:pcfID "10425" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop compensation strategy" .


###  http://example.org/apqc#PCF_10426
ex:PCF_10426 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and implementing the plan for continuation of key positions within the organization. Identify internal people with the potential to fill key business leadership positions. Provide critical development experiences to employees who can move into important roles. Engage leaders to support the development of high-potential leaders." ;
             ex:designatesProcessType ex:P10426 ;
             ex:hierarchyID "7.1.2.4" ;
             ex:pcfID "10426" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop succession plan" .


###  http://example.org/apqc#PCF_10427
ex:PCF_10427 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and implementing the plan for ensuring a diverse work force. Develop and hire employees with varying characteristics including, but not limited to, religious and political beliefs, gender, ethnicity, education, socioeconomic background, sexual orientation, and geographic location." ;
             ex:designatesProcessType ex:P10427 ;
             ex:hierarchyID "7.1.2.6" ;
             ex:pcfID "10427" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop diversity, equity, and inclusion plan" .


###  http://example.org/apqc#PCF_10428
ex:PCF_10428 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating HR programs and services such as employee engagements programs to promote positive employee behavior. Create a variety of programs and services to support employees' professional and personal needs at work and at home." ;
             ex:designatesProcessType ex:P10428 ;
             ex:hierarchyID "7.1.2.10" ;
             ex:pcfID "10428" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop other HR programs" .


###  http://example.org/apqc#PCF_10429
ex:PCF_10429 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating rules and regulations that govern the HR function. Develop a policy plan that serves as a guideline for setting rules and regulations that help in achieving the HR goals and objectives." ;
             ex:designatesProcessType ex:P10429 ;
             ex:hierarchyID "7.1.2.11" ;
             ex:pcfID "10429" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop HR policies" .


###  http://example.org/apqc#PCF_10430
ex:PCF_10430 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ensuring rules and regulations are followed and are flexible enough to accommodate indispensable deviations." ;
             ex:designatesProcessType ex:P10430 ;
             ex:hierarchyID "7.1.2.12" ;
             ex:pcfID "10430" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Administer HR policies" .


###  http://example.org/apqc#PCF_10431
ex:PCF_10431 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Planning benefits in kind (also called fringe benefits, perquisites, or perks). Include various types of non-wage compensations provided to employees in addition to normal wages or salaries." ;
             ex:designatesProcessType ex:P10431 ;
             ex:hierarchyID "7.1.2.13" ;
             ex:pcfID "10431" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan employee benefits" .


###  http://example.org/apqc#PCF_10432
ex:PCF_10432 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a strategy for the use of systems/technologies/tools in operating the HR function. Create a strategy concerning the use and utility of HR support tools and technologies. Decide what specific tools to use and in what quantity. Determine the levels of technology required for the HR management." ;
             ex:designatesProcessType ex:P10432 ;
             ex:hierarchyID "7.1.1.8" ;
             ex:pcfID "10432" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20958 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop strategy for HR systems/technologies/tools" .


###  http://example.org/apqc#PCF_10433
ex:PCF_10433 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and implementing models for effectively strategizing the work force of the organization. Develop a model that specifies the organization's overall approach for maximizing the performance of its work force by defining the goals, objectives, and expectations of the work force. Manage all aspects of performance required for the work force to function, including recruitment, selection, retention, and professional development." ;
             ex:designatesProcessType ex:P10433 ;
             ex:hierarchyID "7.1.2.14" ;
             ex:pcfID "10433" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17045 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop workforce strategy models" .


###  http://example.org/apqc#PCF_10434
ex:PCF_10434 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the accomplishment of HR goals and objectives. Evaluate the effectiveness of the HR function by estimating the present rate of achievement of the established objectives. Use metrics to determine if the objectives are being realized. Leverage measures such as turnover, training, return on human capital, costs of labor, and expenses per employee." ;
             ex:designatesProcessType ex:P10434 ;
             ex:hierarchyID "7.1.3.1" ;
             ex:pcfID "10434" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10417 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure realization of objectives" .


###  http://example.org/apqc#PCF_10435
ex:PCF_10435 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the role of HR function in implementing the organizational strategy. Measure the correlation between the HR performance and the overall business strategy. Calculate the amount of contribution of the HR function to the overall business growth." ;
             ex:designatesProcessType ex:P10435 ;
             ex:hierarchyID "7.1.3.2" ;
             ex:pcfID "10435" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10417 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure contribution to business strategy" .


###  http://example.org/apqc#PCF_10436
ex:PCF_10436 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conveying the plans for HR function to stakeholders. Ensure that the HR plans and strategy are effectively communicated to the people who can affect or be affected by the organization's actions, objectives, and policies such as the creditors, shareholders, employees, and suppliers. Provide regular updates to these stakeholders to ensure effective communication." ;
             ex:designatesProcessType ex:P10436 ;
             ex:hierarchyID "7.1.3.3" ;
             ex:pcfID "10436" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10417 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate plans and provide updates to stakeholders" .


###  http://example.org/apqc#PCF_10438
ex:PCF_10438 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reassessing the strategies, plans, and policies of the HR function, with the objective of revising them. Revisit the schematic plans for the HR function. Taking stock of any suggestions or feedback from the stakeholders, revamp the blueprint of HR strategies and plans." ;
             ex:designatesProcessType ex:P10438 ;
             ex:hierarchyID "7.1.3.4" ;
             ex:pcfID "10438" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10417 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review and revise HR plans" .


###  http://example.org/apqc#PCF_10439
ex:PCF_10439 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling the requirements for new employees. Create and open job requisitions by clearly defining the job descriptions. Post these requirements internally and externally, and modify them as appropriate. Manage the dates of the whole requisition process." ;
             ex:designatesProcessType ex:P10439 ;
             ex:hierarchyID "7.2.1" ;
             ex:pcfID "10439" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage employee requisitions" .


###  http://example.org/apqc#PCF_10440
ex:PCF_10440 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recruiting new candidates for deployment across various functional areas inside the organization. Select methods for sourcing new employees. Manage relationships with third-party agencies. Stage recruitment fairs and drives. Manage employee referral programs." ;
             ex:designatesProcessType ex:P10440 ;
             ex:hierarchyID "7.2.2" ;
             ex:pcfID "10440" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Recruit/Source candidates" .


###  http://example.org/apqc#PCF_10443
ex:PCF_10443 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and making job offers to the selected candidates. Fairly negotiate the job offers. Agree on terms with the candidate to complete the hiring process." ;
             ex:designatesProcessType ex:P10443 ;
             ex:hierarchyID "7.2.4" ;
             ex:pcfID "10443" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage new hire/re-hire" .


###  http://example.org/apqc#PCF_10444
ex:PCF_10444 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and maintaining a system for managing the information of applicants. Create records for all candidates who apply. Maintain and track information through the use applicant-tracking systems." ;
             ex:designatesProcessType ex:P10444 ;
             ex:hierarchyID "7.2.5" ;
             ex:pcfID "10444" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage applicant information" .


###  http://example.org/apqc#PCF_10445
ex:PCF_10445 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a correspondence between the plan for hiring new employees and the desired employee requirements. Staff an adequate amount of people with the appropriate skills to effectively accomplish its legislative, regulatory, service, and production requirements." ;
             ex:designatesProcessType ex:P10445 ;
             ex:hierarchyID "7.2.1.1" ;
             ex:pcfID "10445" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Align staffing plan to work force plan and business unit strategies/resource needs" .


###  http://example.org/apqc#PCF_10446
ex:PCF_10446 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing specific job requisitions, and ensuring their accessibility. Create and open a job requisition to fill the vacant positions within the organization. Clearly describe the job title, department, fill date, and the requisite skills and qualifications for the job." ;
             ex:designatesProcessType ex:P10446 ;
             ex:hierarchyID "7.2.1.3" ;
             ex:pcfID "10446" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Open job requisitions" .


###  http://example.org/apqc#PCF_10447
ex:PCF_10447 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating descriptions for job requisitions. Define the normal components of a job description, such as the overall position description with general areas of responsibility listed, essential functions of the job described with a couple of examples of each, required knowledge, skills, abilities, required education and experience, a description of the physical demands, and a description of the work environment." ;
             ex:designatesProcessType ex:P10447 ;
             ex:hierarchyID "7.2.1.2" ;
             ex:pcfID "10447" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and maintain job descriptions" .


###  http://example.org/apqc#PCF_10448
ex:PCF_10448 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Posting and advertising job descriptions. Display open job descriptions internally and externally. Use public portals, online portals, and websites to upload these requisitions in order for applications to be received." ;
             ex:designatesProcessType ex:P10448 ;
             ex:hierarchyID "7.2.1.4" ;
             ex:pcfID "10448" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Post job requisitions" .


###  http://example.org/apqc#PCF_10450
ex:PCF_10450 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Making the necessary alterations to job requisitions. Revamp or revise the job requisitions in case a position is filled or is not vacant anymore, as well as in case of any new openings. (It involves Manage the internal/external job posting websites [10449] to make the necessary changes.)" ;
             ex:designatesProcessType ex:P10450 ;
             ex:hierarchyID "7.2.1.5" ;
             ex:pcfID "10450" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Modify job requisitions" .


###  http://example.org/apqc#PCF_10451
ex:PCF_10451 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Informing and communicating with the hiring manager. Notify the manager responsible for the hiring process in cases of any new position openings or changes." ;
             ex:designatesProcessType ex:P10451 ;
             ex:hierarchyID "7.2.1.6" ;
             ex:pcfID "10451" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Notify hiring manager" .


###  http://example.org/apqc#PCF_10452
ex:PCF_10452 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining and managing the dates for the employee requisition process. " ;
             ex:designatesProcessType ex:P10452 ;
             ex:hierarchyID "7.2.1.7" ;
             ex:pcfID "10452" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage requisition dates" .


###  http://example.org/apqc#PCF_10453
ex:PCF_10453 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the methods and channels for recruitments in order to maximize the amount of candidate availability. Use channels such as headhunting, job postings, job portals, networking websites, and media advertising. Choose from the various methods of recruitment such as internal/external third-party sourcing." ;
             ex:designatesProcessType ex:P10453 ;
             ex:hierarchyID "7.2.2.1" ;
             ex:pcfID "10453" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10440 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine recruitment methods and channels" .


###  http://example.org/apqc#PCF_10454
ex:PCF_10454 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Organizing and executing recruiting activities and events. Activities and events include on-campus hiring, refresher courses, information sessions, career fairs, etc. to increase the coverage of the sourcing in order to ensure that the most deserving and appropriate candidates are hired." ;
             ex:designatesProcessType ex:P10454 ;
             ex:hierarchyID "7.2.2.2" ;
             ex:pcfID "10454" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10440 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform recruiting activities/events" .


###  http://example.org/apqc#PCF_10455
ex:PCF_10455 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and maintaining relationships with recruitment vendors (suppliers). Create and maintain relationships with third-party agencies such as staffing and firms to expand. Use these relationships to implement the sourcing process effectively." ;
             ex:hierarchyID "7.2.2.3" ;
             ex:pcfID "10455" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10440 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage recruitment vendors" .


###  http://example.org/apqc#PCF_10456
ex:PCF_10456 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and implementing tools for the selection of candidates. Recognize candidate selection tools such as screening, telephone interviews, hiring manager interviews, drug testing, and skills assessment. Effectively deploy these tools to check if the candidates fit in the workplace or not, as well as to ensure workplace safety." ;
             ex:designatesProcessType ex:P10456 ;
             ex:hierarchyID "7.2.3.1" ;
             ex:pcfID "10456" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20123 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify and deploy candidate selection tools" .


###  http://example.org/apqc#PCF_10457
ex:PCF_10457 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the candidates by their performance in the interviews. Conduct HR interview, technical interview, hiring manager interview, etc. Understand the mindset of the candidate, and comprehend his/her personal and professional lives." ;
             ex:designatesProcessType ex:P10457 ;
             ex:hierarchyID "7.2.3.2" ;
             ex:pcfID "10457" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20123 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Interview candidates" .


###  http://example.org/apqc#PCF_10458
ex:PCF_10458 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the candidates through tests. Prepare tools such as aptitude, technical, and grammar tests. Test the skills of the candidate through a written, oral, or computerized test." ;
             ex:designatesProcessType ex:P10458 ;
             ex:hierarchyID "7.2.3.3" ;
             ex:pcfID "10458" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20123 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Test candidates" .


###  http://example.org/apqc#PCF_10459
ex:PCF_10459 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Approving the deserving candidates, and rejecting the others. Examining the performance of candidates. Ensure candidates would fit well with the organization. (Assess performance from Interview candidates [10457] and Test candidates [10458].)" ;
             ex:designatesProcessType ex:P10459 ;
             ex:hierarchyID "7.2.3.4" ;
             ex:pcfID "10459" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20123 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select and reject candidates" .


###  http://example.org/apqc#PCF_10460
ex:PCF_10460 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conducting a background investigation on the candidates with the objective of looking up and compiling criminal, commercial, and financial records." ;
             ex:designatesProcessType ex:P10460 ;
             ex:hierarchyID "7.2.5.1" ;
             ex:pcfID "10460" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10444 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Obtain candidate background information" .


###  http://example.org/apqc#PCF_10463
ex:PCF_10463 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Compiling job-related information for the selected candidates in order to make up a job. Include information about the job description, reporting relationship, salary, bonus potential, benefits, and vacation allotment." ;
             ex:designatesProcessType ex:P10463 ;
             ex:hierarchyID "7.2.4.1" ;
             ex:pcfID "10463" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10443 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Draw up and make offer" .


###  http://example.org/apqc#PCF_10464
ex:PCF_10464 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Negotiating an offer with selected candidates. Discuss the job offer with the candidate to ensure a mutual understanding. " ;
             ex:designatesProcessType ex:P10464 ;
             ex:hierarchyID "7.2.4.2" ;
             ex:pcfID "10464" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10443 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Negotiate offer" .


###  http://example.org/apqc#PCF_10465
ex:PCF_10465 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Wrapping up the process for hiring candidates. Agree to all hiring terms and conditions. Have the candidate accept and sign the job offer. " ;
             ex:designatesProcessType ex:P10465 ;
             ex:hierarchyID "7.2.4.3" ;
             ex:pcfID "10465" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10443 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Hire candidate" .


###  http://example.org/apqc#PCF_10466
ex:PCF_10466 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and documenting the records of all applicants. Manage all individual applicants, including hires and non-hires. Maintain records to avoid any duplication and promote efficiency." ;
             ex:designatesProcessType ex:P10466 ;
             ex:hierarchyID "7.2.5.2" ;
             ex:pcfID "10466" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10444 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create applicant record" .


###  http://example.org/apqc#PCF_10467
ex:PCF_10467 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Keeping track of all the information about the candidates who apply for jobs. Use applicant-tracking systems that can be accessed online as a central location and database for recruitment efforts. " ;
             ex:designatesProcessType ex:ApplicantDataManagementCapability ;
             ex:hierarchyID "7.2.5.3" ;
             ex:pcfID "10467" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10444 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage/track applicant data" .


###  http://example.org/apqc#PCF_10468
ex:PCF_10468 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Retaining and storing the records of the candidates who were rejected and not hired to ensure future availability in case the need arises. Create a centralized repository of profiles. Label these records in order to readily identify them. Add remarks for any future consideration." ;
             ex:designatesProcessType ex:P10468 ;
             ex:hierarchyID "7.2.5.4" ;
             ex:pcfID "10468" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10444 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Archive and retain records of non-hires" .


###  http://example.org/apqc#PCF_10469
ex:PCF_10469 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and maintaining various employee on-boarding programs typically known as induction programs in order to ensure that the new employees are effectively introduced to the organization and its existing employees. Examine and evaluate the performance of these induction programs. Execute these programs on the ground level." ;
             ex:designatesProcessType ex:EmployeeOrientationAndDeploymentCapability ;
             ex:hierarchyID "7.3.1" ;
             ex:pcfID "10469" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20599 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage employee orientation and deployment" .


###  http://example.org/apqc#PCF_10470
ex:PCF_10470 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining individual performance objectives. Review performance in order to provide appraisals. Evaluate the efficiency and effectiveness of the current performance program. Update it regularly." ;
             ex:designatesProcessType ex:EmployeePerformanceManagementCapability ;
             ex:hierarchyID "7.3.2" ;
             ex:pcfID "10470" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20599 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage employee performance" .


###  http://example.org/apqc#PCF_10472
ex:PCF_10472 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing employee development guidelines. Lay out career paths and plans for them. Manage the development of their skills to enhance their skills, ability, and knowledge." ;
             ex:designatesProcessType ex:EmployeeCareerDevelopmentCapability ;
             ex:hierarchyID "7.3.3" ;
             ex:pcfID "10472" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20599 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage employee career development" .


###  http://example.org/apqc#PCF_10473
ex:PCF_10473 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a link between employee and organizational development needs. Conduct and manage employee training programs by considering the need and availability of these programs. " ;
             ex:designatesProcessType ex:EmployeeTrainingCapability ;
             ex:hierarchyID "7.3.4" ;
             ex:pcfID "10473" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20599 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and train employees" .


###  http://example.org/apqc#PCF_10474
ex:PCF_10474 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and maintaining a mechanism through which new employees acquire the necessary knowledge, skills, and behaviors to become effective organizational members and insiders. Conduct formal meetings, lectures, videos, printed materials, and/or computer-based orientations to introduce newcomers to their new jobs and the organization." ;
             ex:designatesProcessType ex:P10474 ;
             ex:hierarchyID "7.3.1.1" ;
             ex:pcfID "10474" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10469 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create/maintain employee onboarding program" .


###  http://example.org/apqc#PCF_10477
ex:PCF_10477 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing a program to systematically introduce newly hired employees to the organizational culture of the company." ;
             ex:designatesProcessType ex:P10477 ;
             ex:hierarchyID "7.3.1.1.1" ;
             ex:pcfID "10477" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10474 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop employee induction program" .


###  http://example.org/apqc#PCF_10478
ex:PCF_10478 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the orientation and training of new employees about the organizational culture of the company." ;
             ex:designatesProcessType ex:P10478 ;
             ex:hierarchyID "7.3.1.1.2" ;
             ex:pcfID "10478" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10474 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain/Update employee induction program" .


###  http://example.org/apqc#PCF_10479
ex:PCF_10479 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the objectives for employee performance. Establish key performance objectives and measures such as customer-focus objectives, financially focused objectives, and employee growth objectives." ;
             ex:designatesProcessType ex:P10479 ;
             ex:hierarchyID "7.3.2.1" ;
             ex:pcfID "10479" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10470 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define employee performance objectives" .


###  http://example.org/apqc#PCF_10481
ex:PCF_10481 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing and revamping performance programs, including the instruments used to measure employee performance standards. Review and upgrade these performance programs to avoid any deprivations and ensure effectiveness." ;
             ex:designatesProcessType ex:P10481 ;
             ex:hierarchyID "7.3.2.4" ;
             ex:pcfID "10481" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10470 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate and review performance program" .


###  http://example.org/apqc#PCF_10483
ex:PCF_10483 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing labor relations, the collective bargaining process, and the relationships between the labor and management. Take care of employee grievances." ;
             ex:designatesProcessType ex:LaborRelationsCapability ;
             ex:hierarchyID "7.4.1" ;
             ex:pcfID "10483" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17052 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage labor relations" .


###  http://example.org/apqc#PCF_10484
ex:PCF_10484 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing any negotiations between an employer and a group of employees that determine the conditions of employment. Engage employees to reach agreements in regulating working conditions. " ;
             ex:designatesProcessType ex:P10484 ;
             ex:hierarchyID "7.4.2" ;
             ex:pcfID "10484" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17052 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage collective bargaining process" .


###  http://example.org/apqc#PCF_10485
ex:PCF_10485 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling partnerships between labor and management. Develop a lasting two-way relationship that is beneficial for the labor, management, and the organization." ;
             ex:designatesProcessType ex:LaborManagementPartnershipCapability ;
             ex:hierarchyID "7.4.3" ;
             ex:pcfID "10485" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17052 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage labor management partnerships" .


###  http://example.org/apqc#PCF_10487
ex:PCF_10487 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the guidelines for development of employees. Design development policies and procedures to identify areas of growth for employees, either in their current position or in preparation for future roles. Include topics related to knowledge and skill development." ;
             ex:designatesProcessType ex:P10487 ;
             ex:hierarchyID "7.3.3.1" ;
             ex:pcfID "10487" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10472 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define employee development guidelines" .


###  http://example.org/apqc#PCF_10488
ex:PCF_10488 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing a future career path for the employees that encourages them to explore and gather information. " ;
             ex:designatesProcessType ex:P10488 ;
             ex:hierarchyID "7.3.3.2" ;
             ex:pcfID "10488" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10472 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop employee career plans and career paths" .


###  http://example.org/apqc#PCF_10490
ex:PCF_10490 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Aligning the needs of the employees to development needs." ;
             ex:designatesProcessType ex:P10490 ;
             ex:hierarchyID "7.3.4.1" ;
             ex:pcfID "10490" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10473 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Align employee with organization development needs" .


###  http://example.org/apqc#PCF_10491
ex:PCF_10491 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Aligning the learning programs with the core capabilities and competencies of the organization. Contextualize the training programs so that employees can expand their knowledge base and add new skills in line with the core competencies of the organization." ;
             ex:designatesProcessType ex:P10491 ;
             ex:hierarchyID "7.3.4.3" ;
             ex:pcfID "10491" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10473 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Align learning programs with competencies and skills" .


###  http://example.org/apqc#PCF_10492
ex:PCF_10492 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the training necessitated by business processes, using an examination of skill sets that are needed by the organization and those already possessed. Examine the various skills required by individual employees. Design training in light of the availability of resources to provide specific segments of training." ;
             ex:designatesProcessType ex:P10492 ;
             ex:hierarchyID "7.3.4.4" ;
             ex:pcfID "10492" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10473 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish training needs by analysis of required and available skills" .


###  http://example.org/apqc#PCF_10493
ex:PCF_10493 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating, implementing, and managing the programs for training employees. Create and design sessions on the basis of the needs and the availability of the skills. Conduct the sessions on the ground. Manage all aspects related to the training programs. Consider including literacy training, interpersonal skills training, technical training, problem-solving training, diversity or sensitivity training, etc." ;
             ex:designatesProcessType ex:P10493 ;
             ex:hierarchyID "7.3.4.5" ;
             ex:pcfID "10493" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10473 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop, conduct, and manage employee and/or management training programs" .


###  http://example.org/apqc#PCF_10495
ex:PCF_10495 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing and ensuring benefits enrollment by the employees. Process any benefit claims made by the employees. Balance the estimated amount and entitled amount of benefits." ;
             ex:designatesProcessType ex:P10495 ;
             ex:hierarchyID "7.5.2" ;
             ex:pcfID "10495" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10412 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage and administer benefits" .


###  http://example.org/apqc#PCF_10497
ex:PCF_10497 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the sum of all financial records of salaries for an employee, including wages, bonuses, and deductions. Use a payroll management system to deal with the financial aspects of employees' salaries, allowances, deductions, gross pay, net pay, etc. Generate pay slips for a specific period." ;
             ex:designatesProcessType ex:P10497 ;
             ex:hierarchyID "7.5.4" ;
             ex:pcfID "10497" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10412 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Administer payroll" .


###  http://example.org/apqc#PCF_10498
ex:PCF_10498 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating the framework for the provision of salary/compensation to employees. Break down the salary structure into different components such as fixed pay, variable pay, bonus, and allowances such medical allowance, and rent allowance, etc. Develop, adjust, and maintain a pay structure." ;
             ex:designatesProcessType ex:P10498 ;
             ex:hierarchyID "7.5.1.1" ;
             ex:pcfID "10498" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop salary/compensation structure and plan" .


###  http://example.org/apqc#PCF_10499
ex:PCF_10499 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a plan for provision of rewards, commission, and benefits to employees. Plan health benefits, retirement benefits, non-monetary benefits, etc." ;
             ex:designatesProcessType ex:P10499 ;
             ex:hierarchyID "7.5.1.2" ;
             ex:pcfID "10499" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop benefits and rewards plan" .


###  http://example.org/apqc#PCF_10500
ex:PCF_10500 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing and evaluating the organization's benefits and rewards plan. Compare/Benchmark the benefits and employees plan with other organizations to adhere to industry standard practices." ;
             ex:designatesProcessType ex:P10500 ;
             ex:hierarchyID "7.5.1.3" ;
             ex:pcfID "10500" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform competitive analysis of benefits and rewards" .


###  http://example.org/apqc#PCF_10501
ex:PCF_10501 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing the employee requirements for compensation on the basis of the financial, benefits, and HR policies of the organization. Recognize individual compensation requirements regarding the financial policies of the organization. Consider the benefits plan and overall HR policies while selecting compensation requirements." ;
             ex:designatesProcessType ex:P10501 ;
             ex:hierarchyID "7.5.1.4" ;
             ex:pcfID "10501" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify compensation requirements based on financial, benefits, and HR policies" .


###  http://example.org/apqc#PCF_10502
ex:PCF_10502 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the provision of compensations and rewards to the employees while maintaining consistency with the compensation and benefits plan. Follow the compensation and benefits plan rigorously in order to avoid any discrepancies." ;
             ex:designatesProcessType ex:P10502 ;
             ex:hierarchyID "7.5.1.5" ;
             ex:pcfID "10502" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Administer compensation and rewards to employees" .


###  http://example.org/apqc#PCF_10503
ex:PCF_10503 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Rewarding and stimulating the performance efforts of employees. Create methods for motivating employees. Spur extrinsic and intrinsic motivation." ;
             ex:designatesProcessType ex:P10503 ;
             ex:hierarchyID "7.5.1.6" ;
             ex:pcfID "10503" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Reward and motivate employees" .


###  http://example.org/apqc#PCF_10504
ex:PCF_10504 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing the programs that specify employee benefits, other than salary provided, such as those concerning medical care, death, and disability." ;
             ex:designatesProcessType ex:P10504 ;
             ex:hierarchyID "7.5.2.1" ;
             ex:pcfID "10504" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10495 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Deliver employee benefits program" .


###  http://example.org/apqc#PCF_10505
ex:PCF_10505 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling the employee enrollment for obtaining benefits. Manage employee enrollment and eligibility. Encourage employees to enroll for benefits." ;
             ex:designatesProcessType ex:P10505 ;
             ex:hierarchyID "7.5.2.2" ;
             ex:pcfID "10505" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10495 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Administer benefit enrollment" .


###  http://example.org/apqc#PCF_10506
ex:PCF_10506 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Processing any formal requests or demands made by the employees claiming that they have earned some benefits. Send the request further up the managerial hierarchy to ensure approval." ;
             ex:designatesProcessType ex:P10506 ;
             ex:hierarchyID "7.5.2.3" ;
             ex:pcfID "10506" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10495 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process claims" .


###  http://example.org/apqc#PCF_10507
ex:PCF_10507 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Carrying out reconciliation of benefits delivered to employees. Compare the estimated benefit requirement made by the employee and the actual amount of benefits the employee is entitled to receive." ;
             ex:designatesProcessType ex:P10507 ;
             ex:hierarchyID "7.5.2.4" ;
             ex:pcfID "10507" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10495 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform benefit reconciliation" .


###  http://example.org/apqc#PCF_10508
ex:PCF_10508 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing programs that prompt proper balance between work (i.e., career and ambition) and lifestyle (i.e., health, pleasure, leisure, family, and spiritual development/meditation). Account for dependent care, flexible working arrangements, leaves of absence, on-the-job training, etc." ;
             ex:designatesProcessType ex:P10508 ;
             ex:hierarchyID "7.5.3.1" ;
             ex:pcfID "10508" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Deliver programs to support work/life balance for employees" .


###  http://example.org/apqc#PCF_10509
ex:PCF_10509 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a support structure that aligns with local and federal laws that allow for support for families. This could include things like maternity leave, care for a family member, or in some cases, extended sick leave." ;
             ex:designatesProcessType ex:P10509 ;
             ex:hierarchyID "7.5.3.2" ;
             ex:pcfID "10509" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop family support systems" .


###  http://example.org/apqc#PCF_10510
ex:PCF_10510 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reassessing the indicators for retention and motivation of employees. Monitor the indicators that signal the levels of motivation and retention. Regularly update and upgrade indicators to avoid depreciation and ensure high efficiency." ;
             ex:designatesProcessType ex:P10510 ;
             ex:hierarchyID "7.5.1.7" ;
             ex:pcfID "10510" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review retention and motivation indicators" .


###  http://example.org/apqc#PCF_10511
ex:PCF_10511 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing existing compensation plans and making changes necessary to continue to retain employees. " ;
             ex:designatesProcessType ex:P10511 ;
             ex:hierarchyID "7.5.1.8" ;
             ex:pcfID "10511" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21438 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review compensation plan" .


###  http://example.org/apqc#PCF_10512
ex:PCF_10512 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the process of promoting and demoting employees. Design a system for advancing or demoting an employee's rank or position. Leverage techniques such as horizontal promotion, vertical promotion, dry promotion, and involuntary/voluntary demotion." ;
             ex:designatesProcessType ex:P10512 ;
             ex:hierarchyID "7.6.1" ;
             ex:pcfID "10512" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage promotion and demotion process" .


###  http://example.org/apqc#PCF_10513
ex:PCF_10513 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the process of employee separation, including resignations, discharges, and layoffs. Inform the employee of the termination. Complete paperwork for continuation of benefits." ;
             ex:designatesProcessType ex:P10513 ;
             ex:hierarchyID "7.6.2" ;
             ex:pcfID "10513" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage separation" .


###  http://example.org/apqc#PCF_10514
ex:PCF_10514 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing and administering instances where a person stops employment completely." ;
             ex:designatesProcessType ex:P10514 ;
             ex:hierarchyID "7.6.3" ;
             ex:pcfID "10514" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage retirement" .


###  http://example.org/apqc#PCF_10515
ex:PCF_10515 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the period of time that an employee must be away from their primary job, while maintaining the status of employee (i.e., paid and unpaid leave of absence but not vacations, holidays, hiatuses, sabbaticals, and work-from-home programs)." ;
             ex:designatesProcessType ex:P10515 ;
             ex:hierarchyID "7.6.4" ;
             ex:pcfID "10515" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage leave of absence" .


###  http://example.org/apqc#PCF_10516
ex:PCF_10516 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Helping former employees transition to new jobs or to re-orient themselves in the job market. Deliver help through one-on-one sessions or in a group format. Provide guidance in career evaluation, resume writing, interview preparation, developing networks, and job searching." ;
             ex:designatesProcessType ex:P10516 ;
             ex:hierarchyID "7.6.5" ;
             ex:pcfID "10516" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and implement employee outplacement" .


###  http://example.org/apqc#PCF_10517
ex:PCF_10517 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Allocating employees. Deploy personnel to ensure that the labor of the organization is continuously in an optimal relation to the jobs and organizational structure. " ;
             ex:designatesProcessType ex:P10517 ;
             ex:hierarchyID "7.6.6.2" ;
             ex:pcfID "10517" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20132 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage resource deployment" .


###  http://example.org/apqc#PCF_10520
ex:PCF_10520 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing foreign resources. Manage employees who are sent to live abroad for a defined time period, as well as non-native employees." ;
             ex:designatesProcessType ex:P10520 ;
             ex:hierarchyID "7.6.7.1" ;
             ex:pcfID "10520" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17055 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage expatriates" .


###  http://example.org/apqc#PCF_10522
ex:PCF_10522 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing information and reports regarding employees to management." ;
             ex:designatesProcessType ex:P10522 ;
             ex:hierarchyID "7.7.1" ;
             ex:pcfID "10522" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17056 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage reporting processes" .


###  http://example.org/apqc#PCF_10523
ex:PCF_10523 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling instances where an employee believes that he/she has been inappropriately treated or he/she desires clarification. Encourage employees to inquire when needed. Record and clarify the issues for which the enquiry has been made." ;
             ex:designatesProcessType ex:P10523 ;
             ex:hierarchyID "7.7.2" ;
             ex:pcfID "10523" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17056 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage employee inquiry process" .


###  http://example.org/apqc#PCF_10524
ex:PCF_10524 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Capturing and updating employee information and data and information on the employees. " ;
             ex:designatesProcessType ex:P10524 ;
             ex:hierarchyID "7.7.3" ;
             ex:pcfID "10524" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17056 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage and maintain employee data" .


###  http://example.org/apqc#PCF_10525
ex:PCF_10525 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering and maintaining HR information systems that take care of activities related to HR, accounting, management, and payroll." ;
             ex:designatesProcessType ex:HumanResourcesInformationSystemCapability ;
             ex:hierarchyID "7.7.4" ;
             ex:pcfID "10525" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17056 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage human resource information systems HRIS" .


###  http://example.org/apqc#PCF_10526
ex:PCF_10526 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and maintaining performance metrics for employees. Create and manage a strategic system of data and statistics to accurately gauge each employee's information. Consider productivity metrics, efficiency metrics, training metrics, etc." ;
             ex:designatesProcessType ex:P10526 ;
             ex:hierarchyID "7.7.5" ;
             ex:pcfID "10526" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17056 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and manage employee measures" .


###  http://example.org/apqc#PCF_10527
ex:PCF_10527 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and maintaining systems for managing the time and attendance of employees. Routinely upgrade the process and systems that track when employees start and stop work, the department where the work is performed, attendance in addition to tracking meals and breaks, the type of work performed, and the number of items produced." ;
             ex:designatesProcessType ex:TimeAndAttendanceManagementCapability ;
             ex:hierarchyID "7.7.6" ;
             ex:pcfID "10527" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17056 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and manage time and attendance systems" .


###  http://example.org/apqc#PCF_10529
ex:PCF_10529 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan for managing communication among employees. Inform employees of direction. Counter resistance with change management approaches. Seek specific areas of input to the decision-making process. Seek varying degrees of involvement and co-creation." ;
             ex:designatesProcessType ex:P10529 ;
             ex:hierarchyID "7.8.1" ;
             ex:pcfID "10529" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21451 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop employee communication plan" .


###  http://example.org/apqc#PCF_10530
ex:PCF_10530 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Procuring and handling suggestions from employees, and performing research on employees. Manage and analyze the programs that help the organization to tap into employee ideas for improving the organization's processes and/or products. Use surveys, focus groups, and other data-gathering methods to find out the attitudes, opinions, and feelings of members of an organization." ;
             ex:designatesProcessType ex:P10530 ;
             ex:hierarchyID "7.7.9" ;
             ex:pcfID "10530" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17056 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage/Collect employee suggestions and perform employee research" .


###  http://example.org/apqc#PCF_10531
ex:PCF_10531 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Taking care or resolving any complaint raised by an employee by procedures provided for in a collective agreement, an employment contract, or by other mechanisms established by an employer." ;
             ex:designatesProcessType ex:P10531 ;
             ex:hierarchyID "7.4.4" ;
             ex:pcfID "10531" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17052 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage employee grievances" .


###  http://example.org/apqc#PCF_10532
ex:PCF_10532 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing the communication plan for employees. Initiate dialogues and engagement by monitoring the exchange of ideas and opinions, the development of personal relationships, etc." ;
             ex:designatesProcessType ex:P10532 ;
             ex:hierarchyID "7.8.3" ;
             ex:pcfID "10532" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21451 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Deliver employee communications" .


###  http://example.org/apqc#PCF_10728
ex:PCF_10728 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining different stages of the planning process and accounting. Classify, determine, analyze, interpret, and communicate information to make up-to-date business decisions for better management and control functions." ;
             ex:designatesProcessType ex:P10728 ;
             ex:hierarchyID "9.1" ;
             ex:pcfID "10728" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform planning and management accounting" .


###  http://example.org/apqc#PCF_10729
ex:PCF_10729 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Comparing revenue targets to reality. Review all transactions and entries passed in final accounts in a year in order to examine profits." ;
             ex:designatesProcessType ex:P10729 ;
             ex:hierarchyID "9.2" ;
             ex:pcfID "10729" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform revenue accounting" .


###  http://example.org/apqc#PCF_10730
ex:PCF_10730 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Making statements about business activities and functions. Prepare financial statements (balance sheet, income statement, statement of cash flows, and statement of stockholders' equity) according to accounting concepts and principles." ;
             ex:designatesProcessType ex:P10730 ;
             ex:hierarchyID "9.3" ;
             ex:pcfID "10730" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform general accounting and reporting" .


###  http://example.org/apqc#PCF_10731
ex:PCF_10731 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing accounts for large funds-invested projects. Manage and account for fixed assets projects (capital projects), which required significant capital investments over many years." ;
             ex:designatesProcessType ex:FixedAssetProjectAccountingCapability ;
             ex:hierarchyID "9.4" ;
             ex:pcfID "10731" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage fixed-asset project accounting" .


###  http://example.org/apqc#PCF_10732
ex:PCF_10732 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling reporting time, managing pay, and processing taxes from salaries. Pay employees. Withhold taxes. Confirm the correct funds are paid to the correct government agency." ;
             ex:designatesProcessType ex:P10732 ;
             ex:hierarchyID "9.5" ;
             ex:pcfID "10732" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process payroll" .


###  http://example.org/apqc#PCF_10733
ex:PCF_10733 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling bills and reimbursements to be made. Make payments for goods or services taken or used on behalf of the organization." ;
             ex:designatesProcessType ex:P10733 ;
             ex:hierarchyID "9.6" ;
             ex:pcfID "10733" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process accounts payable and expense reimbursements" .


###  http://example.org/apqc#PCF_10734
ex:PCF_10734 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing business's investments in trading in bonds, currencies, financial derivatives, etc. Manage the financial assets and holdings of the organization. Optimize the organization's liquidity. Invest excess cash. Reduce financial risks." ;
             ex:designatesProcessType ex:P10734 ;
             ex:hierarchyID "9.7" ;
             ex:pcfID "10734" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage treasury operations" .


###  http://example.org/apqc#PCF_10735
ex:PCF_10735 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering internal controls. This process requires the organization to manage entity's board of trustees, management, and other personnel in order to offer judicious assurance about the achievement of effectiveness, proficiency of operations, and reliability of financial reporting." ;
             ex:designatesProcessType ex:InternalControlCapability ;
             ex:hierarchyID "9.8" ;
             ex:pcfID "10735" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage internal controls" .


###  http://example.org/apqc#PCF_10736
ex:PCF_10736 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Estimating the organization's periodic tax liabilities. Ensure that appropriate taxing authorities receive tax return filings and payments when due." ;
             ex:designatesProcessType ex:TaxManagementCapability ;
             ex:hierarchyID "9.9" ;
             ex:pcfID "10736" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage taxes" .


###  http://example.org/apqc#PCF_10737
ex:PCF_10737 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing cash collections and disbursements made by operating units across the enterprise. When appropriate, transfer cash from the operating units to parent-level bank accounts managed by the organization's treasury team." ;
             ex:designatesProcessType ex:InternationalFundsManagementCapability ;
             ex:hierarchyID "9.10" ;
             ex:pcfID "10737" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage international funds/consolidation" .


###  http://example.org/apqc#PCF_10738
ex:PCF_10738 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Allocating funds to meet future and current financial goals. Led by the chief financial officer, have the finance function plan, budget, and forecast in order to determine and describe long and short-term financial goals." ;
             ex:designatesProcessType ex:P10738 ;
             ex:hierarchyID "9.1.1" ;
             ex:pcfID "10738" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10728 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform planning/budgeting/forecasting" .


###  http://example.org/apqc#PCF_10739
ex:PCF_10739 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining costs to be incurred and methods for optimum utilization. Determine the costs of products, processes, projects, etc. to compile in the financial statements, as well as to assist management in making decisions regarding planning and control. Control costs by managing and reducing business expenses." ;
             ex:designatesProcessType ex:P10739 ;
             ex:hierarchyID "9.1.2" ;
             ex:pcfID "10739" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10728 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform cost accounting and control" .


###  http://example.org/apqc#PCF_10740
ex:PCF_10740 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Deciding which expenses can be avoided to reduce some costs and increase revenues. Plan and control the organization's budget to forecast future expenditures. " ;
             ex:designatesProcessType ex:P10740 ;
             ex:hierarchyID "9.1.3" ;
             ex:pcfID "10740" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10728 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform cost management" .


###  http://example.org/apqc#PCF_10741
ex:PCF_10741 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Checking and achieving predetermined financial targets and timelines. Assess and manage the profitability, feasibility, and consistency of a business or project. Study the revenues generated." ;
             ex:designatesProcessType ex:P10741 ;
             ex:hierarchyID "9.1.4" ;
             ex:pcfID "10741" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10728 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate and manage financial performance" .


###  http://example.org/apqc#PCF_10742
ex:PCF_10742 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating and processing requests for advances. Evaluate credit requests by customers requiring loans to buy products/services. " ;
             ex:designatesProcessType ex:P10742 ;
             ex:hierarchyID "9.2.1" ;
             ex:pcfID "10742" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10729 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process customer credit" .


###  http://example.org/apqc#PCF_10743
ex:PCF_10743 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Preparing detailed reports of customer purchases. Prepare a commercial document between the seller and customer with details about transaction. Detail the quantity purchased, price of products/services, date, parties involved, unique invoice number, and tax information." ;
             ex:designatesProcessType ex:P10743 ;
             ex:hierarchyID "9.2.2" ;
             ex:pcfID "10743" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10729 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Invoice customer" .


###  http://example.org/apqc#PCF_10744
ex:PCF_10744 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Processing payments due from customers. This includes all processing of funds received, whether by check or electronically. This does not include the generation of invoices." ;
             ex:designatesProcessType ex:P10744 ;
             ex:hierarchyID "9.2.3" ;
             ex:pcfID "10744" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10729 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process accounts receivable (AR)" .


###  http://example.org/apqc#PCF_10745
ex:PCF_10745 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Posting entries to respective accounts, and preparing accounts for receivables. Manage the cash collected by the business from its debtors. Record it in the books of accounts to provide clear information about the availability of the cash." ;
             ex:designatesProcessType ex:P10745 ;
             ex:hierarchyID "9.2.4" ;
             ex:pcfID "10745" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10729 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage and process collections" .


###  http://example.org/apqc#PCF_10746
ex:PCF_10746 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and providing funds for necessary adjustments and deductions, including all expenses that were required for the business at certain point in time." ;
             ex:designatesProcessType ex:P10746 ;
             ex:hierarchyID "9.2.5" ;
             ex:pcfID "10746" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10729 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage and process adjustments/deductions" .


###  http://example.org/apqc#PCF_10747
ex:PCF_10747 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating procedures to perform general accounting and reporting. Follow the rules and regulations made for a particular process in the business. Publish accounting policies. " ;
             ex:hierarchyID "9.3.1" ;
             ex:pcfID "10747" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10730 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage financial policies and procedures" .


###  http://example.org/apqc#PCF_10748
ex:PCF_10748 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Applying basic principles, concepts, and accounting practices in recording and preparing final accounts, and using accounting information in management." ;
             ex:designatesProcessType ex:P10748 ;
             ex:hierarchyID "9.3.2" ;
             ex:pcfID "10748" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10730 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform general accounting" .


###  http://example.org/apqc#PCF_10749
ex:PCF_10749 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Accounting for long-term and fixed assets. Record purchased, fixed assets that are not easily convertible into cash. Account for costs, useful life, resale value, depreciation, and amortization." ;
             ex:designatesProcessType ex:P10749 ;
             ex:hierarchyID "9.3.3" ;
             ex:pcfID "10749" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10730 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform fixed-asset accounting" .


###  http://example.org/apqc#PCF_10750
ex:PCF_10750 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reporting on the organization's financial status to stakeholders. Include balance sheets, income statements, cash flow statements, and statements of shareholders' equity." ;
             ex:designatesProcessType ex:P10750 ;
             ex:hierarchyID "9.3.4" ;
             ex:pcfID "10750" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10730 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform financial reporting" .


###  http://example.org/apqc#PCF_10751
ex:PCF_10751 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Preparing a project finance report to solicit approvals in capital projects. Prepare budgets for projects that require heavy investments. Report on project finances to solicit approvals from management." ;
             ex:designatesProcessType ex:P10751 ;
             ex:hierarchyID "9.4.1" ;
             ex:pcfID "10751" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10731 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform capital planning and project approval" .


###  http://example.org/apqc#PCF_10752
ex:PCF_10752 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Accounting for large-scale and large-cost investments. Manage and account for ongoing activities related to capital projects, including setting up new projects, recording project transactions, monitoring and tracking spending, closing and capitalizing projects, and measuring the financial returns on completed projects." ;
             ex:designatesProcessType ex:P10752 ;
             ex:hierarchyID "9.4.2" ;
             ex:pcfID "10752" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10731 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform capital project accounting" .


###  http://example.org/apqc#PCF_10753
ex:PCF_10753 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recording the reporting time of employees on-site. Track working days, salary calculations, holidays taken, number of hours spend in the office, billing hours, etc." ;
             ex:designatesProcessType ex:P10753 ;
             ex:hierarchyID "9.5.1" ;
             ex:pcfID "10753" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10732 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report time" .


###  http://example.org/apqc#PCF_10754
ex:PCF_10754 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the total payments made in employees payroll, including bonuses and compensation." ;
             ex:designatesProcessType ex:P10754 ;
             ex:hierarchyID "9.5.2" ;
             ex:pcfID "10754" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10732 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage pay" .


###  http://example.org/apqc#PCF_10755
ex:PCF_10755 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Deducting and paying taxes from employees' salaries." ;
             ex:designatesProcessType ex:P10755 ;
             ex:hierarchyID "9.5.3" ;
             ex:pcfID "10755" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10732 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage and process payroll taxes" .


###  http://example.org/apqc#PCF_10756
ex:PCF_10756 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Processing payments of operating expenses and other supplier charges. This includes the development of policies and procedures around processing of accounts payable and all operations. This process is often supported by key technology enablers." ;
             ex:designatesProcessType ex:P10756 ;
             ex:hierarchyID "9.6.1" ;
             ex:pcfID "10756" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10733 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process accounts payable (AP)" .


###  http://example.org/apqc#PCF_10757
ex:PCF_10757 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Processing reimbursements to employees for the expenses incurred during the course of business. Approve and process advancements and reimbursements for employee expenses on the organization's behalf. Capture and report relevant tax data and manage personal accounts. " ;
             ex:designatesProcessType ex:P10757 ;
             ex:hierarchyID "9.6.2" ;
             ex:pcfID "10757" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10733 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process expense reimbursements" .


###  http://example.org/apqc#PCF_10758
ex:PCF_10758 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing rules and regulations for investments in trading in bonds, currencies, financial derivatives, etc. Establish policies and procedures for investments made. Optimize liquidity in treasury operations." ;
             ex:designatesProcessType ex:P10758 ;
             ex:hierarchyID "9.7.1" ;
             ex:pcfID "10758" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10734 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage treasury policies and procedures" .


###  http://example.org/apqc#PCF_10759
ex:PCF_10759 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Taking care of all cash-related activities in the business. Manage and reconcile cash positions. Manage cash equivalents. Process and oversee electronic fund transfers. Develop cash flow forecasts. Manage cash flows. Produce cash management accounting transactions and reports. Manage and oversee banking relationships. Analyze, negotiate, resolve, and confirm bank fees." ;
             ex:designatesProcessType ex:P10759 ;
             ex:hierarchyID "9.7.2" ;
             ex:pcfID "10759" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10734 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage cash" .


###  http://example.org/apqc#PCF_10760
ex:PCF_10760 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
