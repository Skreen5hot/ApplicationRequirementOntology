                                       owl:someValuesFrom ex:P20009
                                     ] ;
                     ex:enablesProcess ex:P10163 ,
                                       ex:P10164 ,
                                       ex:P10165 ,
                                       ex:P10166 ,
                                       ex:P11495 ,
                                       ex:P11496 ,
                                       ex:P11497 ,
                                       ex:P17684 ,
                                       ex:P18948 ,
                                       ex:P20009 ;
                     rdfs:comment "Standing capability behind 3.2.2 and 3.3.3 (R6, the 'Develop and manage pricing' standing function PCF 20593). Realized-in axioms attached additively below." ;
                     rdfs:label "Pricing Capability" ;
                     skos:definition "An Organization Capability that is realized in Acts of formulating, executing, and refining pricing." .


###  http://example.org/apqc#PricingGuideline
ex:PricingGuideline rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 3.2.2.2. Directive: guidelines prescribe how to price (Formulation genus)." ;
                    rdfs:label "Pricing Guideline" ;
                    skos:definition "A Directive Information Content Entity that prescribes a uniform methodology and rules for setting and discounting the price of individual offerings." .


###  http://example.org/apqc#PricingPerformanceEvaluation
ex:PricingPerformanceEvaluation rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Output of 3.3.3.5. Descriptive (Appraisal genus)." ;
                                rdfs:label "Pricing Performance Evaluation" ;
                                skos:definition "A Descriptive Information Content Entity that describes the assessed efficiency and revenue impact of an organization's pricing." .


###  http://example.org/apqc#PricingPlan
ex:PricingPlan rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ;
               rdfs:comment "Output/instrument of 3.3.3 (develop and manage pricing), 3.3.3.8. Directive (Formulation)." ;
               rdfs:label "Pricing Plan" ;
               skos:definition "A Directive Information Content Entity that prescribes a pricing mechanism producing prices for all offerings across their lifecycle." .


###  http://example.org/apqc#PricingStrategy
ex:PricingStrategy rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of 3.2.2, 3.3.3.3, 3.3.3.6. Directive (Formulation)." ;
                   rdfs:label "Pricing Strategy" ;
                   skos:definition "A Directive Information Content Entity that prescribes the strategy and methodology guiding the pricing of an organization's products and services." .


###  http://example.org/apqc#PricingTarget
ex:PricingTarget rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:comment "Output of 3.2.2.3. Directive: a target price prescribes what to charge (Formulation genus)." ;
                 rdfs:label "Pricing Target" ;
                 skos:definition "A Directive Information Content Entity that prescribes the optimum price set for individual products or services." .


###  http://example.org/apqc#PrioritizedInitiativeList
ex:PrioritizedInitiativeList rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Minted for PCF 19980: no shared-vocab ICE captures a ranked order of initiatives. Directive (prescribes order of pursuit)." ;
                             rdfs:label "Prioritized Initiative List" ;
                             skos:definition "A Directive Information Content Entity that ranks strategic initiatives from most to least important to guide which are pursued first." .


###  http://example.org/apqc#ProceedApprovalDecision
ex:ProceedApprovalDecision rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Shared section-5.0 output (5.3.2.5). Directive: an approval prescribes that work may continue." ;
                           rdfs:label "Proceed Approval Decision" ;
                           skos:definition "A Directive Information Content Entity that prescribes authorization to proceed with delivering a service-delivery solution." .


###  http://example.org/apqc#ProcessAnalysis
ex:ProcessAnalysis rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:BusinessProcess
                                   ] ;
                   rdfs:comment "is-about target is the subject ex:BusinessProcess (an occurrent), NOT the ex:ProcessOwner Agent who is accountable for it. S8 (is-about-on-ICE) is subject-only and confirmed not to constrain the filler kind, so an occurrent filler is legal here." ;
                   rdfs:label "Process Analysis" ;
                   skos:definition "A Descriptive Information Content Entity that describes how a business process works and how participants from different groups work together to achieve a business goal." .


###  http://example.org/apqc#ProcessBaseline
ex:ProcessBaseline rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:label "Process Baseline" ;
                   skos:definition "A Descriptive Information Content Entity that describes a standard reference level of process performance against which current performance is benchmarked." .


###  http://example.org/apqc#ProcessControlObjective
ex:ProcessControlObjective rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Minted for 9.8.1.4. Directive (prescribes intended accomplishment). Paired with a descriptive ex:RiskAssessment describing the risks attached to the process." ;
                           rdfs:label "Process Control Objective" ;
                           skos:definition "A Directive Information Content Entity that prescribes what a business process is intended to accomplish and the control objectives governing it." ;
                           skos:example "A documented objective that all disbursements above a threshold require dual authorization." .


###  http://example.org/apqc#ProcessControlPointSpecification
ex:ProcessControlPointSpecification rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000965 ;
                                    rdfs:label "Process Control Point Specification" ;
                                    skos:definition "A Directive Information Content Entity that prescribes checkpoints in a business process that prevent its continuation unless stated requirements are satisfied." .


###  http://example.org/apqc#ProcessFramework
ex:ProcessFramework rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:label "Process Framework" ;
                    skos:definition "A Directive Information Content Entity that prescribes the required business processes of an Organization, their key elements, and how they should interact." .


###  http://example.org/apqc#ProcessGovernanceFramework
ex:ProcessGovernanceFramework rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:label "Process Governance Framework" ;
                              skos:definition "A Directive Information Content Entity that prescribes an Organization's approach, standards, and priorities for governing business process management." .


###  http://example.org/apqc#ProcessImprovementMethodologySelection
ex:ProcessImprovementMethodologySelection rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000965 ;
                                          rdfs:comment "Directive: the output of a selection act, prescribing the chosen methodology. Reused as input to 13.4.3.2 reengineering." ;
                                          rdfs:label "Process Improvement Methodology Selection" ;
                                          skos:definition "A Directive Information Content Entity that prescribes the process-improvement methodology (e.g. Lean, Six Sigma) chosen for an improvement effort." .


###  http://example.org/apqc#ProcessModel
ex:ProcessModel rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Documentation/representation of an as-is or to-be process (descriptive). Distinct from ex:ProcessFramework, which prescribes the required process set." ;
                rdfs:label "Process Model" ;
                skos:definition "A Descriptive Information Content Entity that describes what a business entity does, who is responsible, the standard to which a business process should be completed, and how its success is determined." .


###  http://example.org/apqc#ProcessOwner
ex:ProcessOwner rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001017 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000196 ;
                                  owl:someValuesFrom ex:ProcessOwnerRole
                                ] ;
                rdfs:label "Process Owner" ;
                skos:definition "An Agent that bears a process-owner role." .


###  http://example.org/apqc#ProcessOwnerRole
ex:ProcessOwnerRole rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000984 ;
                    rdfs:comment "Minted for recurring APQC 13.1 participant 'process owner'. Borne by an independent continuant (the assigned Agent), never by a process or ICE." ;
                    rdfs:label "Process Owner Role" ;
                    skos:definition "A Role that is borne by an Agent in virtue of being assigned accountability for identifying, analyzing, and improving a given business process within an Organization." .


###  http://example.org/apqc#ProcessPerformanceReport
ex:ProcessPerformanceReport rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:label "Process Performance Report" ;
                            skos:definition "A Descriptive Information Content Entity that describes the measured performance of business processes against defined performance indicators." .


###  http://example.org/apqc#ProcessScopeStatement
ex:ProcessScopeStatement rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:label "Process Scope Statement" ;
                         skos:definition "A Directive Information Content Entity that prescribes the extent and limits of a business process in terms of the activities and tasks it comprises." .


###  http://example.org/apqc#ProcessSpecificationData
ex:ProcessSpecificationData rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Minted: process-spec master data not in shared list. Modeled Descriptive as managed reference data." ;
                            rdfs:label "Process Specification Data" ;
                            skos:definition "A Descriptive Information Content Entity that describes the procedural data followed across different functions and mission-critical applications." .


###  http://example.org/apqc#ProcurementCapability
ex:ProcurementCapability rdf:type owl:Class ;
                         rdfs:subClassOf ex:SupplyChainManagementCapability ;
                         ex:enablesProcess ex:P10216 ;
                         rdfs:label "Procurement Capability" ;
                         skos:definition "A Supply Chain Management Capability that is realized in acts of sourcing, selecting suppliers, ordering, and managing the supply of materials and services." .


###  http://example.org/apqc#ProcurementImpactAnalysis
ex:ProcurementImpactAnalysis rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Minted: no shared-vocab ICE for this cross-process impact study. Descriptive because it represents an analytical finding." ;
                             rdfs:label "Procurement Impact Analysis" ;
                             skos:definition "A Descriptive Information Content Entity that describes the effect of procurement decisions on inventory levels and production flexibility." ;
                             skos:example "An analysis showing how minimum-order-quantity terms drive excess raw-material inventory." .


###  http://example.org/apqc#ProcurementPlan
ex:ProcurementPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:label "Procurement Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes what materials and services to buy, when, and from what sources, together with the supplier-selection approach and timeline." .


###  http://example.org/apqc#ProductClassification
ex:ProductClassification rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Product Trade Classification" ;
                         skos:definition "A Descriptive Information Content Entity that assigns products or services to trade categories according to national and international standards." .


###  http://example.org/apqc#ProductDataManagementCapability
ex:ProductDataManagementCapability rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000568 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11741
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11750
                                                   ] ;
                                   ex:enablesProcess ex:P11741 ,
                                                     ex:P11750 ;
                                   rdfs:comment "Models APQC 2.1.4 (PCF 11740) as a standing function, not a process (R5/R6); realized in ex:ActOfDataManagement instances." ;
                                   rdfs:label "Product/Service Master Data Management Capability" ;
                                   skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to securely store, control, and govern access to product/service master data and other critical data." .


###  http://example.org/apqc#ProductManagementTeam
ex:ProductManagementTeam rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00001017 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty obo:BFO_0000196 ;
                                           owl:someValuesFrom ex:ProductManagerRole
                                         ] ;
                         rdfs:comment "Minted. Recipient named in 6.5.1.3, 6.5.3.5 (Provide feedback/insights to product management / appropriate teams). Denotes a team-level COLLECTIVE agent (not an individual). Kept under cco:Agent: CCO's Group of Agents (cco:ont00000300) is an Object Aggregate, not an Agent, so it would not bear the agent/recipient role used here." ;
                         rdfs:label "Product Management Team" ;
                         skos:definition "An Agent that bears a product-manager role and to which customer feedback and improvement insights are routed for use in improving offerings." .


###  http://example.org/apqc#ProductManagerRole
ex:ProductManagerRole rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000984 ;
                      rdfs:label "Product Manager Role" ;
                      skos:definition "A Role that is borne by an Agent in virtue of being tasked with managing and improving an organization's products or services." .


###  http://example.org/apqc#ProductMarketingContent
ex:ProductMarketingContent rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cco:ont00001808 ;
                                             owl:someValuesFrom ex:Offering
                                           ] ;
                           rdfs:comment "Output of 3.3.9.1 (images), 3.3.9.2 (copy). Descriptive: it describes the product (is about the Offering). Persuasive intent does not make it directive -- it states facts/claims about the offering." ;
                           rdfs:label "Product Marketing Content" ;
                           skos:definition "A Descriptive Information Content Entity, consisting of text and optionally images, that describes a product promotionally and informatively to initiate or increase sales." .


###  http://example.org/apqc#ProductMaterialClassification
ex:ProductMaterialClassification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Minted: classification record not in shared list. Descriptive." ;
                                 rdfs:label "Product/Material Classification" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the classification of products and input materials throughout the production process." .


###  http://example.org/apqc#ProductMixDecision
ex:ProductMixDecision rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Minted: a decision/selection record (Directive ICE), distinct from descriptive analyses. Output of an Act of Selection (ex:P10785)." ;
                      rdfs:label "Product-Mix Decision" ;
                      skos:definition "A Directive Information Content Entity that prescribes the chosen combination of products and customer segments offered to the market." ;
                      skos:example "A decision to offer products X and Y to segment A and product Z to segment B." .


###  http://example.org/apqc#ProductPortfolioAssessment
ex:ProductPortfolioAssessment rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "Output of 3.1.1.5 (evaluate existing products/services). Descriptive (Appraisal genus)." ;
                              rdfs:label "Product Portfolio Assessment" ;
                              skos:definition "A Descriptive Information Content Entity that describes the relative market position of an organization's existing brands and products." .


###  http://example.org/apqc#ProductRegistration
ex:ProductRegistration rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Output of 6.3.1 (Register products)." ;
                       rdfs:label "Product Registration" ;
                       skos:definition "A Descriptive Information Content Entity that records the registration of a product, associating it with a customer for warranty and service purposes." .


###  http://example.org/apqc#ProductSample
ex:ProductSample rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000995 ;
                 rdfs:label "Product Sample" ;
                 skos:definition "A Material Artifact consisting of a set of elements drawn from a product lot in order to infer the quality of the lot." .


###  http://example.org/apqc#ProductServiceCharacteristicsSpecification
ex:ProductServiceCharacteristicsSpecification rdf:type owl:Class ;
                                              rdfs:subClassOf cco:ont00000965 ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cco:ont00001808 ;
                                                                owl:someValuesFrom ex:ProductServiceOffering
                                                              ] ;
                                              rdfs:comment "Output of 2.3.2.3 (finalize characteristics) and managed at 2.1.4.4. Directive: it fixes what the offering must be." ;
                                              rdfs:label "Product/Service Characteristics Specification" ;
                                              skos:definition "A Directive Information Content Entity that prescribes the finalized attributes and characteristics a new product or service is to have." .


###  http://example.org/apqc#ProductServiceConcept
ex:ProductServiceConcept rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cco:ont00001808 ;
                                           owl:someValuesFrom ex:ProductServiceOffering
                                         ] ;
                         rdfs:comment "Directive: a settled concept fixes a course of development (formulated at 2.2.2.4, selected at 2.1.1.3). Distinct from the earlier Descriptive ex:ProductServiceIdea." ;
                         rdfs:label "Product/Service Concept" ;
                         skos:definition "A Directive Information Content Entity that prescribes a defined, committed concept for a new or revised product or service offering." .


###  http://example.org/apqc#ProductServiceIdea
ex:ProductServiceIdea rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Descriptive: an idea describes a possible offering; once a committed concept/plan is formed it is the Directive ex:ProductServiceConcept (section 5)." ;
                      rdfs:label "Product/Service Idea" ;
                      skos:definition "A Descriptive Information Content Entity that describes a proposed new or improved product or service offering at the ideation stage." .


###  http://example.org/apqc#ProductServiceLifecycleManagementCapability
ex:ProductServiceLifecycleManagementCapability rdf:type owl:Class ;
                                               rdfs:subClassOf cco:ont00000568 ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                 owl:someValuesFrom ex:P10077
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                 owl:someValuesFrom ex:P10078
                                                               ] ;
                                               ex:enablesProcess ex:P10077 ,
                                                                 ex:P10078 ;
                                               rdfs:comment "Models APQC 2.1.2 (PCF 10067) as a standing function, not a process (R5/R6)." ;
                                               rdfs:label "Product/Service Lifecycle Management Capability" ;
                                               skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to introduce, sustain, and withdraw product/service offerings across their life cycle." .


###  http://example.org/apqc#ProductServiceModificationPlan
ex:ProductServiceModificationPlan rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:comment "Output of 2.1.1.6, 2.2.2.5, and 2.3.3.2." ;
                                  rdfs:label "Product/Service Modification Plan" ;
                                  skos:definition "A Directive Information Content Entity that prescribes a programmatic procedure for changing, designing, processing, and delivering products or services." .


###  http://example.org/apqc#ProductServiceOffering
ex:ProductServiceOffering rdf:type owl:Class ;
                          rdfs:subClassOf obo:BFO_0000001 ;
                          rdfs:comment "Anchored at obo:BFO_0000001 (Entity) deliberately: APQC 'product/service' spans material products (continuants) and services (occurrents/dispositions), so no narrower common genus is asserted. Used as the subject filler of 'is about' and as the developed output of group 2.3." ;
                          rdfs:label "Product/Service Offering" ;
                          skos:definition "An Entity that is a product or service offered, or proposed to be offered, by an organization to its customers." .


###  http://example.org/apqc#ProductServicePerformanceData
ex:ProductServicePerformanceData rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:label "Product/Service Performance Data" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the performance of existing products or services, including measures of profitability, market penetration, and value delivered." .


###  http://example.org/apqc#ProductServicePerformanceEvaluation
ex:ProductServicePerformanceEvaluation rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000853 ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty cco:ont00001808 ;
                                                         owl:someValuesFrom ex:ProductServiceOffering
                                                       ] ;
                                       rdfs:comment "Output of 2.1.1.1; descriptive evaluation, not a prescription." ;
                                       rdfs:label "Product/Service Performance Evaluation" ;
                                       skos:definition "A Descriptive Information Content Entity that describes a judgement of the capabilities and performance of existing products or services against market opportunities." .


###  http://example.org/apqc#ProductServicePortfolioManagementCapability
ex:ProductServicePortfolioManagementCapability rdf:type owl:Class ;
                                               rdfs:subClassOf cco:ont00000568 ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                 owl:someValuesFrom ex:P10063
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                 owl:someValuesFrom ex:P10074
                                                               ] ;
                                               ex:enablesProcess ex:P10063 ,
                                                                 ex:P10074 ;
                                               rdfs:comment "Models APQC 2.1.1 (PCF 10061) as a standing function, not a process (R5/R6); realized in its bounded child acts. Bearer is an Organization." ;
                                               rdfs:label "Product/Service Portfolio Management Capability" ;
                                               skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to maintain and revamp a portfolio of product/service offerings in alignment with business strategy and market opportunities." .


###  http://example.org/apqc#ProductServicePriorityList
ex:ProductServicePriorityList rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Output of 2.1.1.3 (prioritize and select). Directive: it commits the organization to an ordering." ;
                              rdfs:label "Product/Service Priority List" ;
                              skos:definition "A Directive Information Content Entity that prescribes a ranked ordering of product/service concepts selected for development." .


###  http://example.org/apqc#ProductServicePrototype
ex:ProductServicePrototype rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000995 ;
                           rdfs:comment "Material output of 2.3.1.9 (build prototypes) and material input to in-house testing (2.3.1.12). Anchored under cco:ont00000995 (Material Artifact). SCOPED to the material prototype -- a built physical instance used as a participant in build/test acts. Where a service prototype denotes a process design, mock workflow, or specification, model that as the appropriate ICE (Directive/Descriptive), not as this Material Artifact." ;
                           rdfs:label "Product/Service Prototype" ;
                           skos:definition "A Material Artifact that is an early built instance of a prospective product or service produced to demonstrate and test its design." .


###  http://example.org/apqc#ProductServiceRequirementSpecification
ex:ProductServiceRequirementSpecification rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000965 ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty cco:ont00001808 ;
                                                            owl:someValuesFrom ex:ProductServiceOffering
                                                          ] ;
                                          rdfs:comment "Output of 2.2.3.1 and its derive-requirement tasks (2.2.3.1.1-.8), and documented at 2.3.1.6. Directive: requirements prescribe what must hold." ;
                                          rdfs:label "Product/Service Requirement Specification" ;
                                          skos:definition "A Directive Information Content Entity that prescribes the functional, interoperability, safety, security, regulatory-compliance, and experience requirements a product or service must satisfy." .


###  http://example.org/apqc#ProductionAndMaterialsStrategy
ex:ProductionAndMaterialsStrategy rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:comment "Shared 4.0 supporting class. Directive: a strategy prescribes a course of action (GOLDEN PRINCIPLE). Output of an Act of Formulation." ;
                                  rdfs:label "Production and Materials Strategy" ;
                                  skos:definition "A Directive Information Content Entity that prescribes an organization's intended approach to production processes and the management of materials, including production and supply constraints." .


###  http://example.org/apqc#ProductionBalanceAndControlScheme
ex:ProductionBalanceAndControlScheme rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:label "Production Balance and Control Scheme" ;
                                     skos:definition "A Directive Information Content Entity that prescribes an equilibrium production volume and a control scheme for systematically planning, coordinating, and directing manufacturing activities." .


###  http://example.org/apqc#ProductionCapability
ex:ProductionCapability rdf:type owl:Class ;
                        rdfs:subClassOf ex:SupplyChainManagementCapability ;
                        ex:enablesProcess ex:P10217 ;
                        rdfs:label "Production Capability" ;
                        skos:definition "A Supply Chain Management Capability that is realized in acts of scheduling, producing, assembling, and quality-testing physical products." .


###  http://example.org/apqc#ProductionDeliveryProcessDesign
ex:ProductionDeliveryProcessDesign rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000965 ;
                                   rdfs:comment "Minted: co-output of 2.3.1.10; not in shared list. Directive." ;
                                   rdfs:label "Production/Delivery Process Design" ;
                                   skos:definition "A Directive Information Content Entity that prescribes a manufacturing or service-delivery process created for a new product or service." .


###  http://example.org/apqc#ProductionEquipment
ex:ProductionEquipment rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000995 ;
                       rdfs:comment "APQC 'machinery - hardware and software - needed to arrange production lines' (2.3.3.1)." ;
                       rdfs:label "Production Equipment" ;
                       skos:definition "A Material Artifact that is machinery or tooling used to manufacture or deliver a product or service." ,
                                       "A Material Artifact, such as machinery, used in a production process and subject to planned or unplanned maintenance." .


###  http://example.org/apqc#ProductionFacility
ex:ProductionFacility rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000192 ;
                      rdfs:label "Production Facility" ;
                      skos:definition "A Facility designed for processing inventory into finished products or services." .


###  http://example.org/apqc#ProductionLot
ex:ProductionLot rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000995 ;
                 rdfs:label "Production Lot" ;
                 skos:definition "A Material Artifact consisting of a particular production unit of an assembly that is planned and manufactured together and tracked under a single lot number." .


###  http://example.org/apqc#ProductionNetworkModel
ex:ProductionNetworkModel rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Modeled as Directive when the model functions as a prescriptive blueprint for how the production network is to be configured or operated. A descriptive network representation (a model OF the current network for simulation/analysis) would instead be a Descriptive ICE; that reading is out of scope here. Reused for the plant model (4.3.1.1)." ;
                          rdfs:label "Production Network Model" ;
                          skos:definition "A Directive Information Content Entity that represents the logical production system, providing the framework of sequential flow and capacity relationships among raw materials, parts, resources, and finished products to enable simulation and optimization." .


###  http://example.org/apqc#ProductionNetworkSimulationResult
ex:ProductionNetworkSimulationResult rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000853 ;
                                     rdfs:label "Production Network Simulation Result" ;
                                     skos:definition "A Descriptive Information Content Entity that describes the outcomes of simulating and optimizing a production network model under given resources, volumes, and processes." .


###  http://example.org/apqc#ProductionOrder
ex:ProductionOrder rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:label "Production Order" ;
                   skos:definition "A Directive Information Content Entity that prescribes which material to produce, where, by which operations, and on which date." .


###  http://example.org/apqc#ProductionPerformanceAssessment
ex:ProductionPerformanceAssessment rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000853 ;
                                   rdfs:label "Production Performance Assessment" ;
                                   skos:definition "A Descriptive Information Content Entity that describes a judgement of the effectiveness and efficiency of a production process, including production metrics." .


###  http://example.org/apqc#ProductionProcessSpecification
ex:ProductionProcessSpecification rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:label "Production Process Specification" ;
                                  skos:definition "A Directive Information Content Entity that prescribes the scheme for processing inventory into finished products or services, including the materials, machinery, and skills to be used." .


###  http://example.org/apqc#ProductionRecord
ex:ProductionRecord rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:label "Production Record" ;
                    skos:definition "A Descriptive Information Content Entity that documents the constituent parts, labor, and equipment involved in the manufacturing of a product, enabling lot traceability." .


###  http://example.org/apqc#ProductionSchedule
ex:ProductionSchedule rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Genus for the line-level plan and the detailed schedule; group modules may specialize." ;
                      rdfs:label "Production Schedule" ;
                      skos:definition "A Directive Information Content Entity that prescribes the timing and sequencing of production activities for final products." .


###  http://example.org/apqc#ProductionStateReport
ex:ProductionStateReport rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Minted (D5) as the monitoring-specific descriptive output of Monitor and optimize production process [19566], distinct from ex:ProductionPerformanceAssessment (an appraisal judgement, output of Assess production performance [10314]). Descriptive state/deviation report, agreeing with the Act of Monitoring genus (GOLDEN PRINCIPLE)." ;
                         rdfs:label "Production State Report" ;
                         skos:definition "A Descriptive Information Content Entity that reports the current state of a running production process and any deviations of its parameters from expected setpoints." ;
                         skos:example "A control-room dashboard snapshot showing live process variables and flagged deviations during a shift." .


###  http://example.org/apqc#ProductionWorkplaceLayoutPlan
ex:ProductionWorkplaceLayoutPlan rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:label "Production Workplace Layout Plan" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the floor plan and infrastructure of a processing facility for delivering finished products or services." .


###  http://example.org/apqc#ProductiveAsset
ex:ProductiveAsset rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000995 ;
                   rdfs:comment "Central material subject of section 10.0. Anchored at CCO Material Artifact (designed to realize a Function)." ;
                   rdfs:label "Productive Asset" ;
                   skos:definition "A Material Artifact, such as a machine, tool, or factory, that an organization constructs, acquires, operates, maintains, and ultimately disposes of in the course of production." .


###  http://example.org/apqc#ProfessionalServicesProvider
ex:ProfessionalServicesProvider rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00001017 ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000196 ;
                                                  owl:someValuesFrom ex:ProfessionalServicesProviderRole
                                                ] ;
                                rdfs:comment "Modeled as Agent (not strictly Organization) so it covers both individual consultants and consulting firms." ;
                                rdfs:label "Professional Services Provider" ;
                                skos:definition "An Agent that bears a professional services provider role." .


###  http://example.org/apqc#ProfessionalServicesProviderRole
ex:ProfessionalServicesProviderRole rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000506 ;
                                    rdfs:comment "Covers APQC 'specialist professional services providers' engaged for due-diligence and deal evaluation (1.1.5)." ;
                                    rdfs:label "Professional Services Provider Role" ;
                                    skos:definition "A Role that is borne by an Agent or Organization in virtue of being engaged externally to supply legal, accounting, consulting, or advisory services to a focal organization." .


###  http://example.org/apqc#ProfitabilityAnalysis
ex:ProfitabilityAnalysis rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Output of 3.4.3.5 (net profit) and 3.5.3.10. Descriptive (Analysis genus)." ;
                         rdfs:label "Profitability Analysis" ;
                         skos:definition "A Descriptive Information Content Entity that describes the analyzed profitability of a proposal, product, or sales activity." ,
                                         "A Descriptive Information Content Entity that describes the revenues, costs, and resulting profit attributable to a customer, product, unit, or project." .


###  http://example.org/apqc#ProgramManagementCapability
ex:ProgramManagementCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16406
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16407
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16408
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16409
                                               ] ;
                               ex:enablesProcess ex:P16406 ,
                                                 ex:P16407 ,
                                                 ex:P16408 ,
                                                 ex:P16409 ;
                               rdfs:comment "Standing-function reading of APQC 13.2.2 'Manage programs' (PCF 16405). No ex:P16405 process is minted; the catalog node ex:PCF_16405 designates this capability. Wired with obo:BFO_0000054 (realized in) to ex:P16406..ex:P16409, mirroring the 13.1/13.5 capability pattern." ;
                               rdfs:label "Program Management Capability" ;
                               skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish, execute, and report on business programs comprising related projects, realized in its constituent acts." .


###  http://example.org/apqc#ProgramManager
ex:ProgramManager rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00001017 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000196 ;
                                    owl:someValuesFrom ex:ProgramManagerRole
                                  ] ;
                  rdfs:label "Program Manager" ;
                  skos:definition "An Agent that bears a program-manager role." .


###  http://example.org/apqc#ProgramManagerRole
ex:ProgramManagerRole rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000984 ;
                      rdfs:comment "Minted for recurring APQC 13.2.2 participant; also referenced in 13.2.3.4.5 project reviews with program managers." ;
                      rdfs:label "Program Manager Role" ;
                      skos:definition "A Role that is borne by an Agent in virtue of being responsible for establishing, executing, and reporting on a business program comprising related projects." .


###  http://example.org/apqc#ProgramPerformanceReport
ex:ProgramPerformanceReport rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:label "Program Performance Report" ;
                            skos:definition "A Descriptive Information Content Entity that describes the evaluated performance of a business program against its goals, completion dates, defects, and cost-effectiveness." .


###  http://example.org/apqc#ProgramStructureSpecification
ex:ProgramStructureSpecification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:label "Program Structure Specification" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the framework and approach for managing a business program, including governance, alignment, assurance, and management." .


###  http://example.org/apqc#ProjectAccountCode
ex:ProjectAccountCode rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Local mint. Rejected ex:ChartOfAccounts (the master account structure) as too broad for a single per-project classification code. Descriptive (it identifies/classifies, it does not prescribe)." ;
                      rdfs:label "Project Account Code" ;
                      skos:definition "A Descriptive Information Content Entity that is a reference code identifying a capital project within a system of accounts so that its transactions can be classified and aggregated." ;
                      skos:example "Cost-collection code 'CP-2026-014' assigned to a new turbine-replacement project." .


###  http://example.org/apqc#ProjectApprovalDecision
ex:ProjectApprovalDecision rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Go/no-go decision in capital planning (9.4)." ;
                           rdfs:label "Project Approval Decision" ;
                           skos:definition "A Directive Information Content Entity that prescribes whether a capital project or fixed-asset acquisition is authorized to proceed." .


###  http://example.org/apqc#ProjectContinuationDecision
ex:ProjectContinuationDecision rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Directive go/no-go decision in capital project accounting (9.4.2). Minted for ex:P10851 ('Decide whether to proceed based on the revenues generated'), mirroring ex:ProjectApprovalDecision." ;
                               rdfs:label "Project Continuation Decision" ;
                               skos:definition "A Directive Information Content Entity that prescribes whether to proceed with a capital project on the basis of the returns it has generated." .


###  http://example.org/apqc#ProjectLaunchPlan
ex:ProjectLaunchPlan rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:label "Project Launch Plan" ;
                     skos:definition "A Directive Information Content Entity that prescribes when to initiate a project and how to introduce it to its target audience, including team, objectives, timelines, and milestones." .


###  http://example.org/apqc#ProjectManagementCapability
ex:ProjectManagementCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P11119
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16411
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16413
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16414
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16417
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16418
                                               ] ;
                               ex:enablesProcess ex:P11119 ,
                                                 ex:P16411 ,
                                                 ex:P16413 ,
                                                 ex:P16414 ,
                                                 ex:P16417 ,
                                                 ex:P16418 ;
                               rdfs:comment "Standing-function reading of APQC 13.2.3 'Manage projects' (PCF 16410). No ex:P16410 process is minted; the catalog node ex:PCF_16410 designates this capability. Wired with obo:BFO_0000054 (realized in) to its constituent Activity acts ex:P16411/ex:P11119/ex:P16413/ex:P16414/ex:P16417/ex:P16418, mirroring the 13.1/13.5 capability pattern." ;
                               rdfs:label "Project Management Capability" ;
                               skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to scope, plan, execute, review, and close business projects, realized in its constituent acts." .


###  http://example.org/apqc#ProjectManagementImpactAssessment
ex:ProjectManagementImpactAssessment rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000853 ;
                                     rdfs:comment "Descriptive (an assessment/judgement of impact). Output of ex:P11131 'Evaluate impact of project management on measures and outcomes'." ;
                                     rdfs:label "Project Management Impact Assessment" ;
                                     skos:definition "A Descriptive Information Content Entity that describes the assessed impact of project-management strategy and projects on the organization's measures and outcomes." .


###  http://example.org/apqc#ProjectManagementMethodologySelection
ex:ProjectManagementMethodologySelection rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000965 ;
                                         rdfs:label "Project Management Methodology Selection" ;
                                         skos:definition "A Directive Information Content Entity that prescribes the project-management methodology chosen for designing, planning, implementing, and achieving project objectives." .


###  http://example.org/apqc#ProjectManager
ex:ProjectManager rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00001017 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000196 ;
                                    owl:someValuesFrom ex:ProjectManagerRole
                                  ] ;
                  rdfs:label "Project Manager" ;
                  skos:definition "An Agent that bears a project-manager role." .


###  http://example.org/apqc#ProjectManagerRole
ex:ProjectManagerRole rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000984 ;
                      rdfs:comment "Minted for recurring APQC 13.2.3 participant." ;
                      rdfs:label "Project Manager Role" ;
                      skos:definition "A Role that is borne by an Agent in virtue of being responsible for scoping, planning, executing, reporting on, and closing a business project." .


###  http://example.org/apqc#ProjectPerformanceReport
ex:ProjectPerformanceReport rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:label "Project Performance Report" ;
                            skos:definition "A Descriptive Information Content Entity that describes a project's performance against scope, schedule, quality, cost, and risk criteria, including deviations from plan." .


###  http://example.org/apqc#ProjectPlan
ex:ProjectPlan rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ;
               rdfs:comment "Shared section-5.0 output/input (5.3.1.3). Directive: a project plan prescribes intended work." ;
               rdfs:label "Project Plan" ;
               skos:definition "A Directive Information Content Entity that prescribes the resources, roles, IT requirements, training, communication, reward approaches, and launch for executing a business project." ,
                               "A Directive Information Content Entity that prescribes the scope, tasks, and sequence by which a service-delivery engagement is to be carried out." .


###  http://example.org/apqc#ProjectPortfolioSelection
ex:ProjectPortfolioSelection rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Directive (a selection/prioritization decision). Output of ex:P21454 'Prioritize and select projects for the portfolio'." ;
                             rdfs:label "Project Portfolio Selection" ;
                             skos:definition "A Directive Information Content Entity that prescribes which projects are selected and prioritized for the portfolio based on preestablished criteria." .


###  http://example.org/apqc#ProjectReadinessAssessment
ex:ProjectReadinessAssessment rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Project Readiness Assessment" ;
                              skos:definition "A Descriptive Information Content Entity that describes the culture and readiness of an organizational environment for adopting a project-management approach." .


###  http://example.org/apqc#ProjectRequirementsStatement
ex:ProjectRequirementsStatement rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "FALSE FRIEND: despite the label 'Requirement', this is a DESCRIPTIVE (853) record of requirements gathered by a discernment act; the directive requirement itself (deliverables MUST satisfy X) is modeled separately. Parallel to the sibling outputs ex:ProjectResourceRequirementsStatement (853, P16412) and ex:ITRequirementsStatement (853, P11124). Output of ex:P11117 'Identify project requirements and objectives'. Any directive force would be a separate downstream Directive ICE composed by a Formulation act -- mirroring how ex:BusinessCase (P11120) stays descriptive and leaves the go/no-go as a separate Directive -- and is not modeled by this discernment act." ;
                                rdfs:label "Project Requirements Statement" ;
                                skos:definition "A Descriptive Information Content Entity that describes the discerned capabilities, features, and attributes a project's deliverables are required to have, as recognized and registered by a requirements-discernment act." .


###  http://example.org/apqc#ProjectResourceRequirementsStatement
ex:ProjectResourceRequirementsStatement rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000853 ;
                                        rdfs:comment "FALSE FRIEND: despite the label 'Requirement', this is a DESCRIPTIVE (853) record of requirements gathered by a discernment act; the directive requirement itself is modeled separately. An enumeration of identified resource prerequisites. Output of ex:P16412 'Identify project resource requirements'." ;
                                        rdfs:label "Project Resource Requirements Statement" ;
                                        skos:definition "A Descriptive Information Content Entity that describes the people, skills, capital, facilities, equipment, material, and information a project requires." .


###  http://example.org/apqc#ProjectReviewRecord
ex:ProjectReviewRecord rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:label "Project Review Record" ;
                       skos:definition "A Descriptive Information Content Entity that describes the findings and lessons learned from a post-project or after-action review." .


###  http://example.org/apqc#ProjectScopeStatement
ex:ProjectScopeStatement rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:label "Project Scope Statement" ;
                         skos:definition "A Directive Information Content Entity that prescribes the goals, deliverables, tasks, costs, deadlines, and boundaries of a business project." .


###  http://example.org/apqc#ProjectStatusReport
ex:ProjectStatusReport rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:label "Project Status Report" ;
                       skos:definition "A Descriptive Information Content Entity that describes the current status of a project, including completed, incomplete, and planned tasks and problems faced." .


###  http://example.org/apqc#PromotionalPerformanceEvaluation
ex:PromotionalPerformanceEvaluation rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:comment "Output of 3.3.4.6, 3.3.6.5. Descriptive (Appraisal genus)." ;
                                    rdfs:label "Promotional Performance Evaluation" ;
                                    skos:definition "A Descriptive Information Content Entity that describes the measured success and impact of promotional programs." .


###  http://example.org/apqc#PromotionalPlan
ex:PromotionalPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of 3.3.4.1, 3.3.4.4. Directive (Formulation)." ;
                   rdfs:label "Promotional Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes the concept, objectives, scheme, and scheduling of a promotional program or campaign." .


###  http://example.org/apqc#PropertyAlignmentAssessment
ex:PropertyAlignmentAssessment rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Minted because the section-10.0 shared vocabulary has no output ICE for the 'confirm alignment' appraisal (10.1.1.1). Descriptive (not Directive) because it represents a judgement of consistency rather than prescribing an action." ;
                               rdfs:label "Property Alignment Assessment" ;
                               skos:definition "A Descriptive Information Content Entity that describes the degree to which an organization's property requirements are consistent with its business strategy." ;
                               skos:example "A one-page sign-off noting that the requested space matches the firm's expansion plan." .


###  http://example.org/apqc#PropertyRequirementsSpecification
ex:PropertyRequirementsSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "Directive: it states required conditions that candidate properties/facilities must meet, not a description of a portion of reality." ;
                                     rdfs:label "Property Requirements Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes the property, facility, and workspace requirements an organization must satisfy." .


###  http://example.org/apqc#PropertySelectionDecision
ex:PropertySelectionDecision rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Minted because the section-10.0 shared vocabulary has no output ICE for the 'select property' decision (10.1.2.3). Directive (not Descriptive) because a selection prescribes the chosen option rather than describing it." ;
                             rdfs:label "Property Selection Decision" ;
                             skos:definition "A Directive Information Content Entity that prescribes which property, among the reviewed options, an organization will acquire or occupy." ;
                             skos:example "A documented decision committing the firm to lease Building C." .


###  http://example.org/apqc#PropertyStrategy
ex:PropertyStrategy rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Directive; output of Act of Formulation (develop property strategy and long-term vision)." ;
                    rdfs:label "Property Strategy" ;
                    skos:definition "A Directive Information Content Entity that prescribes a long-term vision and approach for managing an organization's purchased and retained properties." .


###  http://example.org/apqc#ProspectiveCustomer
ex:ProspectiveCustomer rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001017 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:ProspectiveCustomerRole
                                       ] ;
                       rdfs:comment "Subject of sales leads (3.5.1). Bears ProspectiveCustomerRole." ;
                       rdfs:label "Prospective Customer" ;
                       skos:definition "An Agent that bears a prospective-customer role as a potential target of sales and marketing." .


###  http://example.org/apqc#ProspectiveCustomerRole
ex:ProspectiveCustomerRole rdf:type owl:Class ;
                           rdfs:subClassOf obo:BFO_0000023 ;
                           rdfs:comment "Borne by the prospect (lead). Distinct from CustomerRole (already purchasing)." ;
                           rdfs:label "Prospective Customer Role" ;
                           skos:definition "A Role that is borne by an Agent or Organization in virtue of being a potential but not-yet-converted target of an organization's sales and marketing." .


###  http://example.org/apqc#PrototypeTestResult
ex:PrototypeTestResult rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Minted: co-output of 2.3.1.10; not in shared list. Descriptive." ;
                       rdfs:label "Prototype Test Result" ;
                       skos:definition "A Descriptive Information Content Entity that records the outcome of trial runs that test a prototype production or service-delivery process." .


###  http://example.org/apqc#PublicRelationsCapability
ex:PublicRelationsCapability rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000568 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P11066
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P11067
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P11068
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P11069
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P11070
                                             ] ;
                             ex:enablesProcess ex:P11066 ,
                                               ex:P11067 ,
                                               ex:P11068 ,
                                               ex:P11069 ,
                                               ex:P11070 ;
                             rdfs:comment "Supports 12.5 (Manage public relations program) when modeled as a standing function. The catalog node ex:PCF_11014 designates this capability." ;
                             rdfs:label "Public Relations Capability" ;
                             skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to manage its public image and relationships with the community, media, and the public." .


###  http://example.org/apqc#PurchaseOrder
ex:PurchaseOrder rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:label "Purchase Order" ;
                 skos:definition "A Directive Information Content Entity that directs a specified supplier to provide stated materials or services in stated quantities at agreed terms." .


###  http://example.org/apqc#PurchaseOrderReconciliationReport
ex:PurchaseOrderReconciliationReport rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000853 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty cco:ont00001808 ;
                                                       owl:someValuesFrom ex:PurchaseOrder
                                                     ] ;
                                     rdfs:label "Purchase Order Reconciliation Report" ;
                                     skos:definition "A Descriptive Information Content Entity that describes whether the items and quantities of a purchase order were delivered as expected against goods receipts." .


###  http://example.org/apqc#PurchaseRequisition
ex:PurchaseRequisition rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:label "Purchase Requisition" ;
                       skos:definition "A Directive Information Content Entity that requests authorization to procure specified products or services to satisfy an internal need." .


###  http://example.org/apqc#PurchasingForecast
ex:PurchasingForecast rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000626 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001808 ;
                                        owl:someValuesFrom ex:Customer
                                      ] ;
                      rdfs:comment "Output of 3.1.1.1.2 (predict customer purchasing behavior). Predictive ICE: describes an uncertain future. is about the Customer." ;
                      rdfs:label "Customer Purchasing Forecast" ;
                      skos:definition "A Predictive Information Content Entity that describes the expected future purchasing behavior of a customer segment." .


###  http://example.org/apqc#PurchasingRequirementSpecification
ex:PurchasingRequirementSpecification rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000965 ;
                                      rdfs:label "Purchasing Requirement Specification" ;
                                      skos:definition "A Directive Information Content Entity that prescribes the exact materials and services required for procurement, avoiding duplication or overlap." .


###  http://example.org/apqc#QualityControlReport
ex:QualityControlReport rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "Quality Control Report" ;
                        skos:definition "A Descriptive Information Content Entity that describes the results of verifying that construction or maintenance work was performed correctly, including any errors found and rework required." .


###  http://example.org/apqc#QualityControlSpecification
ex:QualityControlSpecification rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:label "Quality Control Specification" ;
                               skos:definition "A Directive Information Content Entity that prescribes the process steps, methods, and competencies for controlling enterprise quality." .


###  http://example.org/apqc#QualityImprovementActionDecision
ex:QualityImprovementActionDecision rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000965 ;
                                    rdfs:comment "Directive: a decision selecting and committing to a subset of recommended actions. Minted so that 17490 (produces the recommendation) -> 17491 (decides which recommended actions to adopt, producing this decision) form a non-degenerate input->output chain, rather than 17491 emitting its own input." ;
                                    rdfs:label "Quality Improvement Action Decision" ;
                                    skos:definition "A Directive Information Content Entity that prescribes which of the recommended quality-improvement actions the organization has decided to adopt." ;
                                    skos:example "Management's documented decision to adopt two of the four recommended control-limit changes next quarter." .


###  http://example.org/apqc#QualityImprovementRecommendation
ex:QualityImprovementRecommendation rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000965 ;
                                    rdfs:comment "Directive: a recommendation that prescribes actions for management to consider." ;
                                    rdfs:label "Quality Improvement Recommendation" ;
                                    skos:definition "A Directive Information Content Entity that prescribes recommended measures for improving the quality plan based on test results." .


###  http://example.org/apqc#QualityInspectionDocument
ex:QualityInspectionDocument rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Minted: inspection-procedure document not in shared list. Directive (it prescribes a procedure)." ;
                             rdfs:label "Quality/Inspection Document" ;
                             skos:definition "A Directive Information Content Entity that prescribes the procedures for assessing whether a product/service meets defined delivery criteria." .


###  http://example.org/apqc#QualityManagerRole
ex:QualityManagerRole rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000984 ;
                      rdfs:comment "Minted for recurring APQC 13.3 participant ('quality management team')." ;
                      rdfs:label "Quality Manager Role" ;
                      skos:definition "A Role that is borne by an Agent in virtue of being responsible for establishing, evaluating, and maintaining enterprise quality requirements and the quality management system." .


###  http://example.org/apqc#QualityPartnershipAgreement
ex:QualityPartnershipAgreement rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Minted: directive artifact governing an established quality partnership (output of ex:P17506)." ;
                               rdfs:label "Quality Partnership Agreement" ;
                               skos:definition "A Directive Information Content Entity that prescribes the terms of a partnership with a third party formed to advance quality excellence." .


###  http://example.org/apqc#QualityPerformanceReview
ex:QualityPerformanceReview rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Minted: no shared-list ICE captures the delivered-quality judgement. Descriptive." ;
                            rdfs:label "Quality Performance Review" ;
                            skos:definition "A Descriptive Information Content Entity that describes a judgement of the quality and performance of a product/service delivered to customers." .


###  http://example.org/apqc#QualityPlan
ex:QualityPlan rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ;
               rdfs:label "Quality Plan" ;
               skos:definition "A Directive Information Content Entity that prescribes how critical-to-quality characteristics will be achieved, controlled, ensured, and managed throughout a product or service lifecycle." .


###  http://example.org/apqc#QualityStandard
ex:QualityStandard rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:label "Quality Standard" ;
                   skos:definition "A Directive Information Content Entity that prescribes qualitative and quantitative quality targets for products or services." .


###  http://example.org/apqc#QualityStrategy
ex:QualityStrategy rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:label "Quality Strategy" ;
                   skos:definition "A Directive Information Content Entity that prescribes an Organization's techniques, standards, responsibilities, and procedures for managing enterprise quality." .


###  http://example.org/apqc#QualityTarget
ex:QualityTarget rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:comment "Output of 2.1.1.4; reused as input to 2.3.1.11." ;
                 rdfs:label "Quality Target" ;
                 skos:definition "A Directive Information Content Entity that prescribes the intended quality standards for a product or service portfolio." .


###  http://example.org/apqc#QualityTestDataRecord
ex:QualityTestDataRecord rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Quality Test Data Record" ;
                         skos:definition "A Descriptive Information Content Entity that describes the data and results collected from testing organizational outputs against the quality plan." .


###  http://example.org/apqc#QualityTestResult
ex:QualityTestResult rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cco:ont00001808 ;
                                       owl:someValuesFrom ex:FinishedProduct
                                     ] ;
                     rdfs:label "Quality Test Result" ;
                     skos:definition "A Descriptive Information Content Entity that describes the documented outcomes of a quality test conducted on manufactured products." .


###  http://example.org/apqc#QualityTestResultDisposition
ex:QualityTestResultDisposition rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "Directive: a disposition decision prescribes a course of action on the tested item." ;
                                rdfs:label "Quality Test Result Disposition" ;
                                skos:definition "A Directive Information Content Entity that prescribes the action to take on a quality test result, such as quarantine, scrap, or rework." .


###  http://example.org/apqc#QualityTestSummary
ex:QualityTestSummary rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Quality Test Summary" ;
                      skos:definition "A Descriptive Information Content Entity that describes the major facts, figures, and conclusions of quality test results." .


###  http://example.org/apqc#QualityTestingProcedure
ex:QualityTestingProcedure rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:label "Quality Testing Procedure" ;
                           skos:definition "A Directive Information Content Entity that prescribes the standard steps and routine instructions for testing the quality of products or services." .


###  http://example.org/apqc#QuasiGovernmentBody
ex:QuasiGovernmentBody rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001180 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:QuasiGovernmentBodyRole
                                       ] ;
                       rdfs:comment "Minted for 12.2.2. Includes regulatory and auditing agencies." ;
                       rdfs:label "Quasi-Government Body" ;
                       skos:definition "An Organization that bears a quasi-government-body role in virtue of operating under government supervision while remaining distinct and self-directed from the government." .


###  http://example.org/apqc#QuasiGovernmentBodyRole
ex:QuasiGovernmentBodyRole rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000187 ;
                           rdfs:label "Quasi-Government Body Role" ;
                           skos:definition "A Role that is borne by an Organization in virtue of operating under government supervision while remaining distinct and self-directed from the government." .


###  http://example.org/apqc#ROIForecast
ex:ROIForecast rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000626 ;
               rdfs:comment "Output of 3.3.2.4 (projected ROI). Predictive ICE: describes an uncertain future return (Forecasting genus)." ;
               rdfs:label "Return-on-Investment Forecast" ;
               skos:definition "A Predictive Information Content Entity that describes the expected return on a marketing or sales investment." .


###  http://example.org/apqc#RawMaterial
ex:RawMaterial rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000457 ;
               rdfs:comment "APQC 'feedstock or raw materials needed to prepare the finished products' (2.3.3.1). Bare material entity because raw stock need not be an artifact." ,
                            "Anchored under cco:ont00000457 (Portion of Material), whose CCO definition is a portion produced to be used as the input for another Act of Material Artifact Processing -- an exact fit for raw materials." ;
               rdfs:label "Raw Material" ;
               skos:definition "A Material Entity that is feedstock or input material consumed in producing a finished product." ,
                               "A Portion of Material that is provided as input to an act of production and incorporated into, or consumed during, the manufacture of a finished product." .


###  http://example.org/apqc#RawMaterialInventoryManagementCapability
ex:RawMaterialInventoryManagementCapability rdf:type owl:Class ;
                                            rdfs:subClassOf cco:ont00000568 ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P10304
                                                            ] ;
                                            ex:enablesProcess ex:P10304 ;
                                            rdfs:comment "Minted for APQC 4.3.2.1 'Manage raw material inventory', a standing administrative function (R5/R6) rather than a bounded process. Realized in ex:P10304 (Produce/Assemble product), the production acts that consume the managed inventory. Not in the shared vocabulary (ex:ProductionCapability is broader); proposed as a section-4.0 capability addition." ;
                                            rdfs:label "Raw Material Inventory Management Capability" ;
                                            skos:definition "An Organization Capability that inheres in a supply-chain organization in virtue of its capacity to administer the stock and total cost of raw materials supporting production." .


###  http://example.org/apqc#RealProperty
ex:RealProperty rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000040 ;
                rdfs:comment "Anchored at BFO material entity rather than Material Artifact because raw land is not an artifact. Subject of property-selection and build/buy/lease decisions." ,
                             "Scope caution (material asset vs legal interest): this class denotes the MATERIAL real-property asset (land + buildings/fixtures, obo:BFO_0000040). It does NOT represent legal rights or interests in the property (title, freehold/leasehold, easements, liens); those are generically-dependent continuants, not material entities, and would be modeled separately (e.g. a Directive/role-bearing ICE) if the corpus later covers property law." ;
                rdfs:label "Real Property" ;
                skos:definition "A Material Entity, comprising land together with any buildings or fixtures on it, that an organization may build, buy, lease, retain, or dispose of." .


###  http://example.org/apqc#RecallCommunication
ex:RecallCommunication rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:DefectiveProduct
                                       ] ;
                       rdfs:comment "Output of 6.4.3 (Manage recall related communications) and the public communication of 6.4.6 (Manage recall termination)." ;
                       rdfs:label "Recall Communication" ;
                       skos:definition "A Descriptive Information Content Entity issued to the public and stakeholders that conveys information about a product recall." .


###  http://example.org/apqc#RecallEffectivenessAssessment
ex:RecallEffectivenessAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Output of 6.4.5 (Monitor and audit recall effectiveness) and the review of 6.5.5 (Evaluate recall performance)." ;
                                 rdfs:label "Recall Effectiveness Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes an analysis of the effectiveness of a product recall." .


###  http://example.org/apqc#RecallInitiationRecord
ex:RecallInitiationRecord rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cco:ont00001808 ;
                                            owl:someValuesFrom ex:DefectiveProduct
                                          ] ;
                          rdfs:comment "Minted per Gate-F as the Descriptive output of P20111 (6.4.1 'Initiate recall'). The initiation act LAUNCHES the recall by applying the standing recall strategy; it does not re-produce that strategy. Distinct from ex:RecallStrategy (the Directive procedure, output of 6.1.7), which P20111 consumes as input." ;
                          rdfs:label "Recall Initiation Record" ;
                          skos:definition "A Descriptive Information Content Entity that records that a product recall has been commenced and the removal of the defective product launched." .


###  http://example.org/apqc#RecallManagementCapability
ex:RecallManagementCapability rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000568 ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P20110
                                              ] ;
                              ex:enablesProcess ex:P20110 ;
                              rdfs:comment "Target for R5 'Manage product recalls ...' standing functions (group 6.4). Realized in the end-to-end recall-execution process ex:P20110 (R6)." ;
                              rdfs:label "Recall Management Capability" ;
                              skos:definition "An Organization Capability that is realized in the acts by which an organization initiates, communicates, reports on, and terminates product recalls." .


###  http://example.org/apqc#RecallStrategy
ex:RecallStrategy rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:comment "Sole output of 6.1.7 (Develop recall strategy). Per Gate-F it is NOT re-produced by 6.4.1 (Initiate recall), which CONSUMES it as input to launch the operational removal; two process classes must not both assert has output some ex:RecallStrategy." ;
                  rdfs:label "Recall Strategy" ;
                  skos:definition "A Directive Information Content Entity that prescribes the procedures for handling recalls of defective products." .


###  http://example.org/apqc#RecognitionAndRewardPlan
ex:RecognitionAndRewardPlan rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:comment "Shared across 13.2.3.3.5 and 13.4.2.6." ;
                            rdfs:label "Recognition and Reward Plan" ;
                            skos:definition "A Directive Information Content Entity that prescribes incentives, bonuses, and recognition for extraordinary performance within a project or change initiative." .


###  http://example.org/apqc#RecoveredMaterial
ex:RecoveredMaterial rdf:type owl:Class ;
                     rdfs:subClassOf obo:BFO_0000040 ;
                     rdfs:comment "Minted locally (10.4). Distinct from ex:WasteMaterial: recovered material re-enters a value stream rather than being discarded." ;
                     rdfs:label "Recovered Material" ;
                     skos:definition "A Material Entity recovered from end-of-life asset parts for reuse or recycling into new material stock." .


###  http://example.org/apqc#RecruitmentChannelManagementCapability
ex:RecruitmentChannelManagementCapability rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000568 ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty obo:BFO_0000054 ;
                                                            owl:someValuesFrom ex:P10440
                                                          ] ;
                                          ex:enablesProcess ex:P10440 ;
                                          rdfs:comment "APQC 7.2.2.5 (PCF 17048) is a standing function ('establishing and maintaining channels', open-ended), modeled as a capability per R5/R6. R6 fix: realized-in corrected from the narrow ex:P10454 (Perform recruiting activities/events) -- which does not realize channel-management -- to the group sourcing process ex:P10440 (Recruit/Source candidates), under which recruitment-channel operation occurs (P10453 Determine recruitment methods and channels is a part of P10440)." ;
                                          rdfs:label "Recruitment Channel Management Capability" ;
                                          skos:definition "An Organization Capability that is realized in Acts of establishing and maintaining recruitment channels and the processes that operate them." .


###  http://example.org/apqc#RecruitmentMethodSpecification
ex:RecruitmentMethodSpecification rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:label "Recruitment Method Specification" ;
                                  skos:definition "A Directive Information Content Entity that prescribes the methods and channels to be used for recruiting candidates." .


###  http://example.org/apqc#RecruitmentVendor
ex:RecruitmentVendor rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00001180 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000196 ;
                                       owl:someValuesFrom ex:RecruitmentVendorRole
                                     ] ;
                     rdfs:comment "Third-party staffing/recruiting agency in group 7.2." ;
                     rdfs:label "Recruitment Vendor" ;
                     skos:definition "An Organization that bears a recruitment-vendor role in virtue of supplying candidate-sourcing services to a focal organization under contract." .


###  http://example.org/apqc#RecruitmentVendorManagementCapability
ex:RecruitmentVendorManagementCapability rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000568 ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P10440
                                                         ] ;
                                         ex:enablesProcess ex:P10440 ;
                                         rdfs:comment "APQC 7.2.2.3 (PCF 10455) is a standing function ('establishing and maintaining relationships', no natural end), so per R5/R6 it is modeled as a capability rather than a process class. R6 fix: realized-in relaxed from the narrow ex:P10454 (Perform recruiting activities/events = career fairs/campus events, which does not realize vendor-relationship management) to the group sourcing process ex:P10440 (Recruit/Source candidates), whose source text explicitly covers 'Manage relationships with third-party agencies'." ;
                                         rdfs:label "Recruitment Vendor Management Capability" ;
                                         skos:definition "An Organization Capability that is realized in Acts of establishing and maintaining ongoing relationships with recruitment vendors to support sourcing." .


###  http://example.org/apqc#RecruitmentVendorRole
ex:RecruitmentVendorRole rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000506 ;
                         rdfs:label "Recruitment Vendor Role" ;
                         skos:definition "A Role that is borne by an Organization in virtue of supplying candidate-sourcing services to a focal organization under contract." .


###  http://example.org/apqc#RegulatorRelationshipManagementCapability
ex:RegulatorRelationshipManagementCapability rdf:type owl:Class ;
                                             rdfs:subClassOf cco:ont00000568 ;
                                             rdfs:comment "Reality-layer correlate of APQC 11.2.2.9 (PCF 16470), an ongoing relational standing function with no natural end and no definitional informational output; modeled as a capability (R5/R6) rather than a process." ;
                                             rdfs:label "Regulator Relationship Management Capability" ;
                                             skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to develop and preserve appropriate working relationships with its regulators without compromising the legal basis of those relationships." .


###  http://example.org/apqc#RegulatorRole
ex:RegulatorRole rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000187 ;
                 rdfs:label "Regulator Role" ;
                 skos:definition "A Role that is borne by an authority in virtue of having legal power to issue and enforce financial, tax, or trade rules binding on an Organization." .


###  http://example.org/apqc#RegulatoryAuthority
ex:RegulatoryAuthority rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001180 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:RegulatorRole
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:RegulatoryAuthorityRole
                                       ] ;
                       rdfs:comment "APQC 'sovereign or multinational authorities', 'appropriate regulatory body/agencies' (group 2.1.3)." ,
                                    "Covers tax authorities, securities exchanges, and customs agencies referenced in 9.3, 9.8, 9.9, 9.11." ,
                                    "Minted for 12.4.4 (Ensure compliance); e.g. the Securities and Exchange Commission." ,
                                    "Recipient/counterparty in 11.2 (maintain relationships with regulators 11.2.2.9; submit reports 11.2.2.8) and source of requirements investigated in 11.3.4." ;
                       rdfs:label "Regulatory Authority" ;
                       skos:definition "An Organization that bears a regulator role and issues or enforces financial, tax, or trade rules binding on other organizations." ,
                                       "An Organization that bears a regulatory authority role in relation to a focal organization." ,
                                       "An Organization that bears a regulatory authority role in relation to construction, maintenance, or hazardous-material activities." ,
                                       "An Organization that bears a regulatory-authority role in virtue of issuing and enforcing statutes, regulatory directions, or legal principles binding on an organization." ,
                                       "An Organization that bears a regulatory-authority role, issuing laws, statutes, permits, or requirements and overseeing an organization's compliance." .


###  http://example.org/apqc#RegulatoryAuthorityRole
ex:RegulatoryAuthorityRole rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000187 ;
                           rdfs:comment "Borne by the authority Organization, never by the permit or requirements ICE it issues." ,
                                        "Borne by the authority Organization, never by the requirement or report ICE it issues or receives." ,
                                        "Borne by the external authority Organization, not by the regulatory ICEs it issues (group 2.1.3)." ;
                           rdfs:label "Regulatory Authority Role" ;
                           skos:definition "A Role that is borne by an Organization in virtue of issuing, administering, or enforcing laws, statutes, permits, codes, or regulatory requirements binding on a focal organization, and overseeing its compliance with them." .


###  http://example.org/apqc#RegulatoryBody
ex:RegulatoryBody rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000408 ;
                  rdfs:comment "Genus cco:ont00000408 (Government Organization) reused -- its definition (oversight/administration of governmental functions) fits the watchdog/regulatory agencies of 6.2.5 and 6.4. Distinguished by being a recipient of regulatory reports." ;
                  rdfs:label "Regulatory Body" ;
                  skos:definition "A Government Organization that is responsible for the oversight, regulation, or auditing of an industry and to which incidents, risks, and recall reports are submitted." .


###  http://example.org/apqc#RegulatoryComplianceManagementCapability
ex:RegulatoryComplianceManagementCapability rdf:type owl:Class ;
                                            rdfs:subClassOf ex:ComplianceManagementCapability ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P16464
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P16465
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P16466
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P16467
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P16468
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P16469
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P19595
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P19596
                                                            ] ;
                                            ex:enablesProcess ex:P16464 ,
                                                              ex:P16465 ,
                                                              ex:P16466 ,
                                                              ex:P16467 ,
                                                              ex:P16468 ,
                                                              ex:P16469 ,
                                                              ex:P19595 ,
                                                              ex:P19596 ;
                                            rdfs:comment "Reality-layer correlate of APQC 11.2.2 (PCF 16463), a standing 'Manage' function with no natural end; modeled as a capability (R5/R6). Its APQC children that are bounded occurrents (16464, 16465, 16466, 16467, 16468, 16469, 19595, 19596) are the acts in which it is realized -- not process parts, since a capability is not a process. ex:RegulatoryComplianceManagementCapability is a specialization of ex:ComplianceManagementCapability." ;
                                            rdfs:label "Regulatory Compliance Management Capability" ;
                                            skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to obey the laws, guidelines, strategies, and stipulations applicable to its business, realized in acts of developing procedures, identifying requirements, monitoring the regulatory environment, assessing and testing its compliance position, implementing controls, and reporting on compliance." .


###  http://example.org/apqc#RegulatoryComplianceObligationEvaluation
ex:RegulatoryComplianceObligationEvaluation rdf:type owl:Class ;
                                            rdfs:subClassOf cco:ont00000853 ;
                                            rdfs:comment "8.3.3.1 / 8.3.5.1 output. Descriptive." ;
                                            rdfs:label "Regulatory and Compliance Obligation Evaluation" ;
                                            skos:definition "A Descriptive Information Content Entity that describes an evaluation of an organization's enterprise regulatory requirements and compliance obligations." ;
                                            skos:example "A report mapping enterprise IT obligations to applicable regulations." .


###  http://example.org/apqc#RegulatoryConcernRegister
ex:RegulatoryConcernRegister rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Reused naming from the reference module. Output of review/determine-needs acts (2.1.3.1-.3)." ;
                             rdfs:label "Regulatory Concern Register" ;
                             skos:definition "A Descriptive Information Content Entity that describes identified patent, copyright, and regulatory concerns and needs." ,
                                             "A Descriptive Information Content Entity that describes identified public-policy and regulatory concerns." .


###  http://example.org/apqc#RegulatoryData
ex:RegulatoryData rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "Regulatory Data" ;
                  skos:definition "A Descriptive Information Content Entity that describes public-policy and regulatory measures issued by sovereign or multinational authorities." .


###  http://example.org/apqc#RegulatoryEnvironmentAnalysis
ex:RegulatoryEnvironmentAnalysis rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Output of 11.2.2.3 (monitor the regulatory environment), produced by ex:ActOfMonitoring (inlined above)." ;
                                 rdfs:label "Regulatory Environment Analysis" ;
                                 skos:definition "A Descriptive Information Content Entity that describes an examination of the regulatory environment to spot changing or emerging regulations relevant to an organization." .


###  http://example.org/apqc#RegulatoryEnvironmentAssessment
ex:RegulatoryEnvironmentAssessment rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000853 ;
                                   rdfs:comment "Minted locally (group 7.4, used by P21437) as the definitional output of monitoring the legal/regulatory environment. Descriptive: it represents the regulatory state of affairs rather than prescribing a course of action." ;
                                   rdfs:label "Employment Regulatory Environment Assessment" ;
                                   skos:definition "A Descriptive Information Content Entity that describes the employment-related legislation and regulatory requirements currently in force across the jurisdictions relevant to an organization." ;
                                   skos:example "A quarterly brief summarizing labor-law changes in each operating country." .


###  http://example.org/apqc#RegulatoryFiling
ex:RegulatoryFiling rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:label "Regulatory Filing" ;
                    skos:definition "A Descriptive Information Content Entity submitted to a regulatory authority that reports required financial, tax, or compliance information." .


###  http://example.org/apqc#RegulatoryIncidentReport
ex:RegulatoryIncidentReport rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Output of 6.2.5 (Report incidents and risks to regulatory bodies) and the regulatory reports of 6.4.4 / 6.4.6." ;
                            rdfs:label "Regulatory Incident Report" ;
                            skos:definition "A Descriptive Information Content Entity that conveys to stakeholders and regulatory bodies an account of incidents and risks related to a return or recall." .


###  http://example.org/apqc#RegulatoryRecord
ex:RegulatoryRecord rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Maintained/updated at 2.1.3.5.2-.3 by ex:ActOfDataManagement instances." ;
                    rdfs:label "Regulatory Record" ;
                    skos:definition "A Descriptive Information Content Entity that records information maintained for, or submitted to, a regulatory authority." .


###  http://example.org/apqc#RegulatoryRequirement
ex:RegulatoryRequirement rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Directive (not Descriptive): a regulatory requirement prescribes obligatory conduct. Shared input across 11.2 (identify applicable requirements 11.2.2.2) and 11.3 (investigate legal aspects 11.3.4). Anchored to cco:ont00000965 (Directive/Prescriptive ICE)." ,
                                      "Directive (not Descriptive): it prescribes obligations. Input for 12.4.4 (Ensure compliance), 12.4.3 (preventive law programs)." ;
                         rdfs:label "Regulatory Requirement" ;
                         skos:definition "A Directive Information Content Entity that prescribes a statute, regulatory direction, or legal principle with which an organization must comply." ,
                                         "A Directive Information Content Entity, issued by a governing authority, that prescribes a law, guideline, statute, or stipulation with which an organization must comply." .


###  http://example.org/apqc#RegulatoryRequirementData
ex:RegulatoryRequirementData rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Descriptive: it states which requirements obtain. The organization's own derived requirement specifications are Directive (see section 5)." ,
                                          "Section-8.0 shared input. APQC 8.3.1.1 determine/evaluate regulatory and audit requirements, 8.3.6, 8.3.5.1. Descriptive: it states externally-imposed requirements." ;
                             rdfs:label "Regulatory Requirement Data" ;
                             skos:definition "A Descriptive Information Content Entity that describes public-policy, regulatory, and compliance requirements applicable to a product or service." ,
                                             "A Descriptive Information Content Entity that describes the IT-relevant regulatory, audit, and legal requirements imposed on an organization by external authorities." .


###  http://example.org/apqc#RegulatoryRequirementsBriefing
ex:RegulatoryRequirementsBriefing rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Minted (Gate-F) as the DESCRIPTIVE product of the communication act 10.4.11.2 (ex:P12181), which relays externally-authored regulatory requirements. Descriptive (an account/statement given by a reporting act), matching the Act-of-Reporting genus per the GOLDEN PRINCIPLE; the Directive ex:RegulatoryRequirementsStatement is the communicated content (has input), not a product of this act." ;
                                  rdfs:label "Regulatory Requirements Briefing" ;
                                  skos:definition "A Descriptive Information Content Entity that gives an account, to the personnel responsible for compliance, of the hazardous-material regulatory requirements they must follow." ;
                                  skos:example "A briefing note summarizing updated transport rules for corrosives for the disposal team." .


###  http://example.org/apqc#RegulatoryRequirementsStatement
ex:RegulatoryRequirementsStatement rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000965 ;
                                   rdfs:comment "Directive: it conveys externally-authored prescriptions that the organization must satisfy and communicate." ,
                                                "False-friend caution (Directive vs Descriptive): this Regulatory Requirements STATEMENT is the prescriptive content -- the externally-authored requirements the organization must satisfy (cco:ont00000965). It is NOT ex:RegulatoryRequirementsBriefing (cco:ont00000853), the descriptive account GIVEN ABOUT those requirements to compliance personnel; a reporting act (e.g. ex:P12181) takes this Statement as has-input and produces the Briefing as has-output." ;
                                   rdfs:label "Regulatory Requirements Statement" ;
                                   skos:definition "A Directive Information Content Entity that prescribes the regulatory requirements applicable to hazardous-material handling, disposal, and reporting." .


###  http://example.org/apqc#RegulatoryReview
ex:RegulatoryReview rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Minted: distinct from RegulatoryConcernRegister/RegulatoryRecord; this records a performance/enforcement review. Descriptive." ;
                    rdfs:label "Regulatory Review" ;
                    skos:definition "A Descriptive Information Content Entity that describes a judgement of the enforcement of intellectual-property and regulatory protection processes." .


###  http://example.org/apqc#RelationshipAssessment
ex:RelationshipAssessment rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Output of 12.2.1.1 (Assess relationships). The subject (the external-party relationship) is named in the definition; no formal 'is about' (cco:ont00001808) restriction is asserted because no reality-layer relationship class exists in the slice, and the only candidate filler ex:RelationshipData is the Descriptive ICE consumed as this act's has-input -- pointing is-about at the input data would mis-state the subject as the data rather than the relationship." ;
                          rdfs:label "Relationship Assessment" ;
                          skos:definition "A Descriptive Information Content Entity that describes a judgement of the state of an organization's relationship with an external party and areas needing growth." .


###  http://example.org/apqc#RelationshipData
ex:RelationshipData rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Input for assessing/monitoring relationships (12.2.1.1, 12.2.1.3, 12.2.3.2)." ;
                    rdfs:label "Relationship Data" ;
                    skos:definition "A Descriptive Information Content Entity that describes the current state of an organization's relationship with an external party." .


###  http://example.org/apqc#RelationshipStatusReport
ex:RelationshipStatusReport rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Output of monitoring rows (12.2.1.3 Monitor relationships, 12.2.3.2 Monitor partnership success). The subject (the monitored external-party relationships) is named in the definition; no formal 'is about' (cco:ont00001808) restriction is asserted -- the only candidate filler ex:RelationshipData is these acts' has-input, so an is-about to it would mis-state the subject as the input data." ;
                            rdfs:label "Relationship Status Report" ;
                            skos:definition "A Descriptive Information Content Entity that describes the current standing of an organization's relationships as observed through ongoing monitoring." .


###  http://example.org/apqc#RelocatedPersonnel
ex:RelocatedPersonnel rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00001017 ;
                      rdfs:comment "Minted (Gate-F) for 10.1.4.1 'Relocate people': the relocated population is the Object whose location is changed, which is distinct from ex:FacilityManagementPersonnel (the facilities staff who PERFORM the move). CCO Act of Location Change (ont00000065) moves an Object, so the moved employees -- not the facility managers -- are the definitional participant standing in for that Object." ;
                      rdfs:label "Relocated Personnel" ;
                      skos:definition "An Agent that is a staff member or employee of an organization moved from one location to another in the course of a relocation act." .


###  http://example.org/apqc#RelocationPlan
ex:RelocationPlan rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:comment "Minted locally (group 7.6, used by P17055/P10520). Directive because it prescribes relocation logistics/terms rather than describing a portion of reality." ;
                  rdfs:label "Relocation Plan" ;
                  skos:definition "A Directive Information Content Entity that prescribes the arrangements for transferring an employee, their family, or a department to a new work location for an assignment." ;
                  skos:example "A relocation package and timeline issued for an employee moving to an overseas posting." .


###  http://example.org/apqc#RemedialActionSpecification
ex:RemedialActionSpecification rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Shared between 13.7.11 'Identify remedial actions' and corrective-action work in 13.4.4.3." ;
                               rdfs:label "Remedial Action Specification" ;
                               skos:definition "A Directive Information Content Entity that prescribes the steps to be taken to correct identified shortcomings." .


###  http://example.org/apqc#RemediationManagementCapability
ex:RemediationManagementCapability rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000568 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11201
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11202
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11203
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11204
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11205
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P11206
                                                   ] ;
                                   ex:apqcSourceText "Administering the efforts and activities for remediation. This process element requires the organization to create plans for corrective action in collaboration with government agencies and pertinent professional services agencies which specialize in remediation efforts relevant to the organization's operations. Additionally, the organization needs to consult experts to validate the plan, determine resources allocation, resolve any legal concerns, and formulate a company-wide policy for remediation." ;
                                   ex:enablesProcess ex:P11201 ,
                                                     ex:P11202 ,
                                                     ex:P11203 ,
                                                     ex:P11204 ,
                                                     ex:P11205 ,
                                                     ex:P11206 ;
                                   ex:hierarchyID "11.3" ;
                                   ex:pcfID "11185" ;
                                   rdfs:comment "Models the standing function of 11.3 'Manage remediation efforts' (R5/R6)." ;
                                   rdfs:label "Remediation Management Capability" ;
                                   skos:definition "An Organization Capability that is realized in acts of planning, resourcing, investigating, and policy-making for the remediation of environmental adulteration." .


###  http://example.org/apqc#RemediationPlan
ex:RemediationPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:ContaminatedMaterial
                                   ] ;
                   rdfs:comment "Output of 11.3.1 (create remediation plans), produced by ex:ActOfFormulation (reused from ext). Directive: a plan prescribes intended corrective acts." ,
                                "Section-8.0 shared output. APQC 8.1.7.2 triage and plan remediation, 8.3.6.4 remediation requirements, 8.5.5.1.3 service/solution remediation, 8.6.4.9 roll-back plan. Directive." ;
                   rdfs:label "Remediation Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes corrective actions, resources, and responsibilities for closing identified IT gaps, compliance issues, or service/solution defects." ,
                                   "A Directive Information Content Entity, about a case of contamination, that prescribes the corrective actions for identifying and treating environmental adulteration so that an affected area becomes operational again." .


###  http://example.org/apqc#RemediationPolicy
ex:RemediationPolicy rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output of 11.3.6 (amend or create policy), produced by ex:ActOfFormulation (reused from ext)." ;
                     rdfs:label "Remediation Policy" ;
                     skos:definition "A Directive Information Content Entity that prescribes a company-wide framework of policies and procedures for deploying remediation efforts, adapted to applicable national and international regulatory frameworks." .


###  http://example.org/apqc#ReplacementNeedAssessment
ex:ReplacementNeedAssessment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cco:ont00001808 ;
                                               owl:someValuesFrom ex:ProductiveAsset
                                             ] ;
                             rdfs:comment "Minted (Gate-F) as the descriptive output of 10.2.3.5 (ex:P19234) once its lead act is correctly read as a determination/appraisal ('Determining the need to replace existing assets'), not a build. Descriptive (a judgement), satisfying the GOLDEN PRINCIPLE for an Act of Appraisal." ;
                             rdfs:label "Replacement Need Assessment" ;
                             skos:definition "A Descriptive Information Content Entity, about an asset, that describes a judgement of whether the asset needs to be renewed or replaced." ;
                             skos:example "An engineer's finding that a worn machine has reached the point where replacement is warranted." .


###  http://example.org/apqc#ReplenishmentPlan
ex:ReplenishmentPlan rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:label "Replenishment Plan" ;
                     skos:definition "A Directive Information Content Entity that prescribes the collaborative replenishment of inventory, including provision for faulty production." .


###  http://example.org/apqc#ReprocessingRecord
ex:ReprocessingRecord rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Reprocessing and Disposal Activity Record" ;
                      skos:definition "A Descriptive Information Content Entity that documents the disposition, disposal, and reprocessing activities performed on hazardous materials or waste." ;
                      skos:example "A logged record of a batch of solvent sent for reprocessing, with quantities, handler, and destination." .


###  http://example.org/apqc#RequestForProposal
ex:RequestForProposal rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Input received in 3.5.3.1. Descriptive: it states the customer's requirements (a description), not the supplier's prescribed plan." ;
                      rdfs:label "Request for Proposal (RFP/RFQ)" ;
                      skos:definition "A Descriptive Information Content Entity issued by a prospective customer that describes requirements, scope, and evaluation criteria solicited from suppliers." .


###  http://example.org/apqc#RequestForQuotation
ex:RequestForQuotation rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:label "Request for Quotation" ;
                       skos:definition "A Directive Information Content Entity that solicits suppliers to submit price quotes for specified products or services." .


###  http://example.org/apqc#RequiredCapabilityList
ex:RequiredCapabilityList rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Minted (Gate-F) for P19972 'Identify required capabilities'. A register of discerned required skills, agreeing with the ex:ActOfIdentification genus; replaces the mis-scoped ex:CoreCompetencyAnalysis output." ;
                          rdfs:label "Required Capability List" ;
                          skos:definition "A Descriptive Information Content Entity that registers the skills and competencies required to operate a function or support structure." .


###  http://example.org/apqc#RequisitionApprovalDecision
ex:RequisitionApprovalDecision rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Minted: distinct from ex:PurchaseRequisition (the request) and ex:PurchaseOrder (the order). Directive because an approval authorizes rather than describes." ;
                               rdfs:label "Requisition Approval Decision" ;
                               skos:definition "A Directive Information Content Entity that prescribes that a purchase requisition is authorized to proceed to procurement." ;
                               skos:example "A signed approval record releasing a requisition for purchase-order creation." .


###  http://example.org/apqc#ResearchAndDevelopmentCapability
ex:ResearchAndDevelopmentCapability rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00001379 ;
                                    ex:enablesProcess ex:P10070 ,
                                                      ex:P10071 ,
                                                      ex:P10072 ;
                                    rdfs:label "Research and Development Capability" ;
                                    skos:definition "An Agent Capability that is realized in Acts of discovering, developing, and assessing new technologies and product/service concepts." .


###  http://example.org/apqc#ResearchAndDevelopmentPersonnel
ex:ResearchAndDevelopmentPersonnel rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00001017 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000196 ;
                                                     owl:someValuesFrom ex:ResearchAndDevelopmentRole
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cco:ont00001954 ;
                                                     owl:someValuesFrom ex:ResearchAndDevelopmentCapability
                                                   ] ;
                                   rdfs:comment "APQC 'research division(s)', 'R&D function' (group 2.2)." ;
                                   rdfs:label "Research and Development Personnel" ;
                                   skos:definition "An Agent that has a research-and-development capability and bears a research-and-development role." .


###  http://example.org/apqc#ResearchAndDevelopmentRole
ex:ResearchAndDevelopmentRole rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000984 ;
                              rdfs:comment "Recurs across the discovery-research and concept-generation processes (group 2.2)." ;
                              rdfs:label "Research and Development Role" ;
                              skos:definition "A Role that is borne by an Agent in virtue of being tasked with discovering, developing, or assessing new technologies and product/service concepts on behalf of an Organization." .


###  http://example.org/apqc#ResearchPublication
ex:ResearchPublication rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Reused naming from the reference module." ;
                       rdfs:label "Research Publication" ;
                       skos:definition "A Descriptive Information Content Entity published as a report, brief, or article and used as analytic input." ,
                                       "A Descriptive Information Content Entity published as a report, brief, or article and used as analytic or developmental input." .


###  http://example.org/apqc#ResearchQuestion
ex:ResearchQuestion rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Modeled as Descriptive because it RECORDS the question to be investigated; the methodology or analytics plan that prescribes HOW to conduct the investigation is modeled separately as a Directive ICE." ;
                    rdfs:label "Research Question" ;
                    skos:definition "A Descriptive Information Content Entity that registers a discrete research question framed from stakeholder requirements to guide workforce analytics." .


###  http://example.org/apqc#ResourceAllocationPlan
ex:ResourceAllocationPlan rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Minted: output of 2.3.1.1; not in shared list. Directive." ;
                          rdfs:label "Resource Allocation Plan" ;
                          skos:definition "A Directive Information Content Entity that prescribes the funds, personnel, and time allocated to a product or service development project." .


###  http://example.org/apqc#ResourceAvailabilityAssessment
ex:ResourceAvailabilityAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Shared section-5.0 output. Recurs across 5.1.2.3, 5.2.1.5, 5.2.2.3, 5.3.1.5." ;
                                  rdfs:label "Resource Availability Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes a judgement of whether the resources, skills, and capacity needed for service delivery are available." .


###  http://example.org/apqc#ResourceManagementCapability
ex:ResourceManagementCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ;
                                ex:enablesProcess ex:P20050 ,
                                                  ex:P20056 ;
                                rdfs:comment "Shared section-5.0 capability for resource-management standing-functions in 5.2 (e.g. 5.2.2.6 'Monitor and manage resource capacity')." ;
                                rdfs:label "Resource Management Capability" ;
                                skos:definition "An Organization Capability that is realized in the acts by which an organization plans, allocates, and monitors the resources needed for service delivery." .


###  http://example.org/apqc#ResourcePlan
ex:ResourcePlan rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:comment "Shared section-5.0 output (5.2.2.2, 5.3.1.6). Directive: a plan prescribes intended provisioning." ;
                rdfs:label "Resource Plan" ;
                skos:definition "A Directive Information Content Entity that prescribes how the personnel, physical resources, and capabilities required to deliver services are to be provisioned and allocated." ,
                                "A Directive Information Content Entity that prescribes the resources to be allocated to a body of work in light of analyzed workload needs." .


###  http://example.org/apqc#ResourceRequirementsAssessment
ex:ResourceRequirementsAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Output of 11.3.3 (identify/dedicate resources). The actual dedication of resources is a directive/planning act; this ICE is the descriptive identification step." ;
                                  rdfs:label "Resource Requirements Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the resources discerned to be needed for managing remediation efforts and the rationale for their dedication." .


###  http://example.org/apqc#ResourceSchedule
ex:ResourceSchedule rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Section-8.0 shared output. APQC 8.7.3.1.x schedule service-delivery resources / batch jobs / change-release windows / backup activities, 8.6.2.2 / 8.6.3.5 deployment schedule. Directive (output of ex:ActOfScheduling)." ;
                    rdfs:label "Resource Schedule" ;
                    skos:definition "A Directive Information Content Entity that prescribes the timing, sequencing, and resource allocation of IT service-delivery, batch, change/release, or backup activities." .


###  http://example.org/apqc#ResourcingPlan
ex:ResourcingPlan rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:comment "Output of 6.3.4.2.1 (Create resourcing plan and schedule)." ;
                  rdfs:label "Resourcing Plan" ;
                  skos:definition "A Directive Information Content Entity that prescribes the sourcing and deployment of the resources required to fulfill customer service requirements." .


###  http://example.org/apqc#ResponsiblePartyDetermination
ex:ResponsiblePartyDetermination rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Output of 6.3.2.4 (Determine responsible party). Descriptive: it represents who is responsible, an information-processing judgement." ;
                                 rdfs:label "Responsible Party Determination" ;
                                 skos:definition "A Descriptive Information Content Entity that identifies the party responsible for settling a warranty claim." .


###  http://example.org/apqc#RestitutionManagementCapability
ex:RestitutionManagementCapability rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000568 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P17059
                                                   ] ;
                                   ex:enablesProcess ex:P17059 ;
                                   rdfs:comment "Models APQC 9.11.9 'Handle restitution' (PCF 14097). R5: 'Administering and overseeing all restitution activities... Manage compliance' is a standing managerial function with no natural end -- a capability, not a bounded process. Realized in the underlying restitution/compliance acts (R6)." ;
                                   rdfs:label "Restitution Management Capability" ;
                                   skos:definition "An Organization Capability that is realized in the ongoing administration and oversight of an organization's restitution obligations, including maintaining compliance with applicable legal frameworks and discharging any fines or non-financial measures imposed by authorities." ;
                                   skos:example "A legal function's standing capacity to manage court-ordered restitution and regulatory penalties." .


###  http://example.org/apqc#RestructuringOpportunityAnalysis
ex:RestructuringOpportunityAnalysis rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:label "Restructuring Opportunity Analysis" ;
                                    skos:definition "A Descriptive Information Content Entity that describes identified opportunities for restructuring an organization in light of internal viability and external contingency." .


###  http://example.org/apqc#ReturnAuthorization
ex:ReturnAuthorization rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:ReturnedProduct
                                       ] ;
                       rdfs:comment "Output of 6.2.4.1 (Authorize return); reused in 6.3.3.2." ;
                       rdfs:label "Return Authorization" ;
                       skos:definition "A Directive Information Content Entity that prescribes approval for a customer to return a product for refund, replacement, or repair." .


###  http://example.org/apqc#ReturnReasonRecord
ex:ReturnReasonRecord rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001808 ;
                                        owl:someValuesFrom ex:ReturnedProduct
                                      ] ;
                      rdfs:comment "Output of 6.2.4.2 (Process return and record reason)." ;
                      rdfs:label "Return Reason Record" ;
                      skos:definition "A Descriptive Information Content Entity that records the reason for the return of a product." .


###  http://example.org/apqc#ReturnRequest
ex:ReturnRequest rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Minted per Gate-F as the dedicated input to P10364 (6.2.4.1 'Authorize return'). Distinct from ex:ServiceRequest (an individual customer's service requirements, minted for 6.3.4.1): the verbatim source for 10364 is a product-RETURN request, a different informational object. Reusing ex:ServiceRequest there conflated two unrelated ICEs." ;
                 rdfs:label "Return Request" ;
                 skos:definition "A Descriptive Information Content Entity that records a customer's request to return a product for refund, replacement, or repair." .


###  http://example.org/apqc#ReturnedPartQualityAssessment
ex:ReturnedPartQualityAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cco:ont00001808 ;
                                                   owl:someValuesFrom ex:ReturnedProduct
                                                 ] ;
                                 rdfs:label "Returned Part Quality Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes whether a returned part meets acceptable quality standards, supporting a disposition decision." .


###  http://example.org/apqc#ReturnedProduct
ex:ReturnedProduct rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000995 ;
                   rdfs:comment "Material input to 6.2.4 (Process returns); may be scrapped or salvaged per the source." ;
                   rdfs:label "Returned Product" ;
                   skos:definition "A Material Artifact that a customer has sent back to an organization for refund, replacement, or repair." ,
                                   "A Material Artifact that has been returned by a buyer to the seller or an intermediary, pending inspection, salvage, repair, or restocking." .


###  http://example.org/apqc#RevenueEstimate
ex:RevenueEstimate rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "Output of 3.4.3.2 (10143). Descriptive (Analysis genus): a computed quantity, not a prescription. Distinct from ex:SalesForecast (a Predictive demand estimate). PROPOSE-VOCAB candidate." ;
                   rdfs:label "Revenue Estimate" ;
                   skos:definition "A Descriptive Information Content Entity that describes the estimated revenue from the sale of an organization's products and services, computed as anticipated sales multiplied by selling price." .


###  http://example.org/apqc#ReverseLogisticsStrategy
ex:ReverseLogisticsStrategy rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:label "Reverse Logistics Strategy" ;
                            skos:definition "A Directive Information Content Entity that prescribes the handling, information processing, and disposition of products and packaging returned by a buyer to a seller or intermediary." .


###  http://example.org/apqc#ReviewedRequisition
ex:ReviewedRequisition rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Minted (D5) as the distinct output of Process/Review requisitions [10292], replacing the degenerate input-class=output-class restriction. Directive because it is a requisition (a request that authorizes/initiates procurement) bearing an added review status, not a mere description. Distinct from ex:PurchaseRequisition (the un-reviewed request) and ex:RequisitionApprovalDecision (the later authorization)." ;
                       rdfs:label "Reviewed Requisition" ;
                       skos:definition "A Directive Information Content Entity consisting of a purchase requisition that has been received, checked against procurement policy, and marked ready for authorization." ;
                       skos:example "An incoming requisition validated against policy and queued for a budget owner's approval." .


###  http://example.org/apqc#RewardsAndIncentivesPlan
ex:RewardsAndIncentivesPlan rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:label "Rewards and Incentives Plan" ;
                            skos:definition "A Directive Information Content Entity that prescribes the rewards and incentives for employees who exhibit the behavior desired by a change." .


###  http://example.org/apqc#Risk
ex:Risk rdf:type owl:Class ;
        rdfs:subClassOf obo:BFO_0000017 ;
        rdfs:comment "ex:Risk is the REALITY-LAYER risk disposition (BFO Realizable Entity, obo:BFO_0000017): the standing possibility of an adverse outcome borne by some entity -- NOT a process and NOT an information artifact. CAUTION for contributors: information artifacts ABOUT risks are modeled separately as ICEs -- ex:RiskRegister, ex:RiskAssessment, ex:RiskAnalysisReport, etc. (each cco:ont00000853 Descriptive ICE, 'is about' some ex:Risk). Do NOT use ex:Risk as an ICE / has-output filler; use the corresponding artifact class." ;
        rdfs:label "Risk" ;
        skos:definition "A Realizable Entity that is the disposition of some entity to give rise, under specified conditions, to an adverse or uncertain consequence for an organization's objectives." .


###  http://example.org/apqc#RiskAnalysisReport
ex:RiskAnalysisReport rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Output of 11.1.3.6 (analyze risk activities and update plans)." ;
                      rdfs:label "Risk Analysis Report" ;
                      skos:definition "A Descriptive Information Content Entity that describes an examination of the impact of risk activities, including the potential for adverse consequences and the methods available to manage them." .


###  http://example.org/apqc#RiskAssessment
ex:RiskAssessment rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cco:ont00001808 ;
                                    owl:someValuesFrom ex:Risk
                                  ] ;
                  rdfs:comment "Shared output of appraisal acts (11.1.2.2, 11.1.3.2). Descriptive (a judgement), per GOLDEN PRINCIPLE for Act of Appraisal." ;
                  rdfs:label "Financial Risk Assessment" ,
                             "Risk Assessment" ;
                  skos:definition "A Descriptive Information Content Entity that describes an organization's exposure to interest-rate, foreign-exchange, credit, or market risk." ,
                                  "A Descriptive Information Content Entity, about one or more risks, that describes a judgement of the likelihood and impact of those risks together with their root causes, used to determine which to mitigate." .


###  http://example.org/apqc#RiskExposureData
ex:RiskExposureData rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Definitional input to exposure-determination analyses (9.7.5). Used by ex:P19584; parallels ex:MarketRateData (the input to the rate-exposure analyses ex:P19576 / ex:P19580) so all three exposure-determination rows carry a definitional input." ;
                    rdfs:label "Risk Exposure Data" ;
                    skos:definition "A Descriptive Information Content Entity that describes an Organization's current counterparty or customer exposures, positions, and the limits applicable to them." .


###  http://example.org/apqc#RiskKnowledge
ex:RiskKnowledge rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Shared informational payload of the reporting/communication acts in 11.1.1.4 (P16443, coordinate sharing of risk knowledge) and 11.4.5 (P16471, share knowledge of specific risks). Descriptive content; per the Gate-F reconciliation both acts are anchored at cco:ont00000151 (Act of Reporting, a Representative Communication) and emit this ICE as a has-output only (it is not consumed as an input)." ;
                 rdfs:label "Risk Knowledge" ;
                 skos:definition "A Descriptive Information Content Entity that describes information about specific risks and resilience strategies, shared across an organization so prospective risks can be anticipated and avoided." .


###  http://example.org/apqc#RiskManager
ex:RiskManager rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00001017 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000196 ;
                                 owl:someValuesFrom ex:RiskManagerRole
                               ] ;
               rdfs:comment "Definitional participant in enterprise and business-unit risk acts across 11.1." ;
               rdfs:label "Risk Manager" ;
               skos:definition "An Agent that bears a risk-manager role." .


###  http://example.org/apqc#RiskManagerRole
ex:RiskManagerRole rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000984 ;
                   rdfs:label "Risk Manager Role" ;
                   skos:definition "A Role that is borne by an Agent in virtue of being tasked with identifying, assessing, mitigating, monitoring, and reporting risk on behalf of an organization or business unit." .


###  http://example.org/apqc#RiskMitigationPlan
ex:RiskMitigationPlan rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Output of 11.1.3.3 (develop mitigation plans); input to 11.1.3.4 (implement) and 11.1.2.4 (verify implementation). Directive: it prescribes mitigation actions." ;
                      rdfs:label "Risk Mitigation Plan" ;
                      skos:definition "A Directive Information Content Entity that prescribes the arrangements and activities for improving opportunities and reducing deviations to project objectives in response to identified risks." .


###  http://example.org/apqc#RiskMitigationStrategy
ex:RiskMitigationStrategy rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Output of 11.1.2.3 (develop risk mitigation and management strategy), produced by ex:ActOfFormulation (reused from ext)." ;
                          rdfs:label "Risk Mitigation and Management Strategy" ;
                          skos:definition "A Directive Information Content Entity that prescribes the organization's objectives, strategies, and policies for improving opportunities and lessening threats, integrated with existing performance-management processes." .


###  http://example.org/apqc#RiskMitigationVerificationReport
ex:RiskMitigationVerificationReport rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:comment "Output of 11.1.2.4 (verify mitigation plans are implemented), produced by ex:ActOfVerification (inlined above). Gate-F mint: a dedicated one-shot conformance-finding ICE, separating verification findings from the continuous-monitoring ex:RiskMonitoringReport (a false friend) so that genus (Verification) and output ICE share semantic traceability. Both are Descriptive (cco:ont00000853)." ;
                                    rdfs:label "Risk Mitigation Verification Report" ;
                                    skos:definition "A Descriptive Information Content Entity that describes the finding of a bounded check of whether business-unit and functional risk mitigation plans have been correctly implemented." .


###  http://example.org/apqc#RiskMonitoringReport
ex:RiskMonitoringReport rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Output of monitoring acts (11.1.2.5, 11.1.3.5) produced by ex:ActOfMonitoring (inlined above). NOTE (Gate-F): this is a continuous time-series monitoring artifact and is a FALSE FRIEND for one-shot verification findings; verification acts (11.1.2.4, 11.1.2.8, 11.1.2.9) use the dedicated conformance-finding ICEs below instead." ;
                        rdfs:label "Risk Monitoring Report" ;
                        skos:definition "A Descriptive Information Content Entity that describes the observed status of risks and risk-mitigation actions tracked over time against expected parameters." .


###  http://example.org/apqc#RiskRegister
ex:RiskRegister rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Shared output of identification acts across 11.1 (11.1.2.1 identify enterprise-level risks, 11.1.3.1 identify risks) and input to assessment acts. Descriptive: it registers discerned risks rather than prescribing action." ;
                rdfs:label "Risk Register" ;
                skos:definition "A Descriptive Information Content Entity that enumerates and describes the risks identified for an organization, business unit, or project, including their sources and potential consequences." .


###  http://example.org/apqc#RiskTolerance
ex:RiskTolerance rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:comment "Output of 11.1.1.1 (determine risk tolerance). Directive: it prescribes acceptable-risk thresholds that govern downstream decisions." ;
                 rdfs:label "Risk Tolerance Statement" ;
                 skos:definition "A Directive Information Content Entity that prescribes the level of risk an organization is willing to accept, given risk-return trade-offs for anticipated and predictable consequences." .


###  http://example.org/apqc#RiskToleranceSpecification
ex:RiskToleranceSpecification rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Minted for 9.8.1.5. Directive because it prescribes binding limits, not a description of current risk (that is ex:RiskAssessment)." ;
                              rdfs:label "Risk Tolerance Specification" ;
                              skos:definition "A Directive Information Content Entity that prescribes the maximum acceptable risk, in quantitative terms, for an entity or organizational unit across strategic, operational, financial, and compliance risk subcategories." ;
                              skos:example "A board-approved statement capping aggregate operational loss exposure at 2% of revenue." .


###  http://example.org/apqc#RoadmapPlan
ex:RoadmapPlan rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ;
               rdfs:label "Roadmap" ;
               skos:definition "A Directive Information Content Entity that lays out, in phases over time, the intended sequence of outcomes and the work to reach them." .


###  http://example.org/apqc#Role
ex:Role rdf:type owl:Class ;
        rdfs:subClassOf obo:BFO_0000023 ;
        rdfs:label "FNSR Role" ;
        skos:definition "A position an agent occupies while performing work. Frames the work and may bear permissions; not a competence and not an action." .


###  http://example.org/apqc#RoleActivityDiagram
ex:RoleActivityDiagram rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:label "Role Activity Diagram" ;
                       skos:definition "A Descriptive Information Content Entity that describes the constituent activities of a work-related role and the hand-offs among them." .


###  http://example.org/apqc#RoleDefinitionSpecification
ex:RoleDefinitionSpecification rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Shared across 13.4.2.8 'Establish/Clarify new roles' and 13.2.3.3.1 'Define roles and resources'." ;
                               rdfs:label "Role Definition Specification" ;
                               skos:definition "A Directive Information Content Entity that prescribes the new roles and responsibilities to be assigned to personnel." .


###  http://example.org/apqc#RootCauseAnalysis
ex:RootCauseAnalysis rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cco:ont00001808 ;
                                       owl:someValuesFrom ex:DefectivePart
                                     ] ;
                     rdfs:comment "Output of 6.3.2.3.4 (Investigate issue / perform root cause analysis)." ,
                                  "Shared with 13.3.3.3; also relevant to risk/root-cause work in 13.4." ;
                     rdfs:label "Root Cause Analysis" ;
                     skos:definition "A Descriptive Information Content Entity that describes the diagnosed root cause of a warranty issue or product fault." ,
                                     "A Descriptive Information Content Entity that describes the identified origin of a problem and the reasoning establishing what happened, why, and how to reduce recurrence." ,
                                     "A Descriptive Information Content Entity that describes the underlying causes of a problematic outcome, such as a negative customer experience." ,
                                     "A Descriptive Information Content Entity that describes the underlying causes that triggered a non-conformance event or activity." .


###  http://example.org/apqc#Routing
ex:Routing rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00000853 ;
           rdfs:comment "Minted: routing record not in shared list. Modeled Descriptive (a record of the operation flow as managed master data)." ;
           rdfs:label "Routing" ;
           skos:definition "A Descriptive Information Content Entity that describes the flow of operations from raw form to finished product for a specific product/service layout." .


###  http://example.org/apqc#SLAComplianceAssessment
ex:SLAComplianceAssessment rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cco:ont00001808 ;
                                             owl:someValuesFrom ex:ServiceLevelAgreement
                                           ] ;
                           rdfs:comment "Section-8.0 shared output. APQC 8.1.7.1 assess SLA compliance. Descriptive; carries 'is about' the service level agreement it evaluates." ;
                           rdfs:label "SLA Compliance Assessment" ;
                           skos:definition "A Descriptive Information Content Entity that describes the measured attainment of the service targets defined in a service level agreement over a review period." .


###  http://example.org/apqc#SafetyComplianceRecord
ex:SafetyComplianceRecord rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Shared across 10.2.4.4 (sites) and 10.3.2.5 (maintenance work safety)." ;
                          rdfs:label "Safety Compliance Record" ;
                          skos:definition "A Descriptive Information Content Entity that records that safety, security, and access controls at a work site conform to applicable laws, regulations, and organizational guidelines." .


###  http://example.org/apqc#SalesAgentRole
ex:SalesAgentRole rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000984 ;
                  rdfs:label "Sales Agent Role" ;
                  skos:definition "A Role that is borne by an Agent in virtue of being tasked with pursuing sales leads and selling an organization's offerings." .


###  http://example.org/apqc#SalesAgreement
ex:SalesAgreement rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:comment "Output of 3.5.1.8.4 (close the sale). Directive: a contract/agreement prescribes mutual obligations." ;
                  rdfs:label "Sales Agreement" ;
                  skos:definition "A Directive Information Content Entity that prescribes the agreed terms, price, and conditions of a concluded sale." .


###  http://example.org/apqc#SalesBudget
ex:SalesBudget rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ;
               rdfs:comment "Output of 3.4.3, 3.4.3.6. Directive (Formulation)." ;
               rdfs:label "Sales Budget" ;
               skos:definition "A Directive Information Content Entity that prescribes the planned revenue, costs, and resource outlay for the sales function." .


###  http://example.org/apqc#SalesForecast
ex:SalesForecast rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000626 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cco:ont00001808 ;
                                   owl:someValuesFrom ex:Offering
                                 ] ;
                 rdfs:comment "Output of 3.4.1, 3.4.1.3. Predictive ICE (Forecasting genus). is about the Offering(s) being forecast." ;
                 rdfs:label "Sales Forecast" ;
                 skos:definition "A Predictive Information Content Entity that describes the estimated future demand for an organization's portfolio of offerings." .


###  http://example.org/apqc#SalesGoal
ex:SalesGoal rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000965 ;
             rdfs:comment "Output of 3.4.4, and the goal-setting in 3.4.2.4, 3.4.2.8. Directive (Formulation)." ;
             rdfs:label "Sales Goal and Target" ;
             skos:definition "A Directive Information Content Entity that prescribes quantitative and qualitative sales targets and the measures used to track them." .


###  http://example.org/apqc#SalesLead
ex:SalesLead rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000853 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cco:ont00001808 ;
                               owl:someValuesFrom ex:ProspectiveCustomer
                             ] ;
             rdfs:comment "Output of 3.5.1, 3.5.1.1, 3.5.1.2. Descriptive (the lead record represents a prospect); is about the ProspectiveCustomer. The prospect itself is an Agent/Organization modeled separately." ,
                          "Output of 6.2.2.5 (Identify and capture upsell/cross-sell opportunities); delivered to the sales team in 6.2.2.6." ;
             rdfs:label "Sales Lead" ;
             skos:definition "A Descriptive Information Content Entity that describes a qualified prospective customer and their potential as a sales opportunity." ,
                             "A Descriptive Information Content Entity that describes an upsell or cross-sell opportunity identified during a customer interaction." .


###  http://example.org/apqc#SalesManagementCapability
ex:SalesManagementCapability rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000568 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:ManageCustomerRelationships
                                             ] ;
                             ex:enablesProcess ex:ManageCustomerRelationships ;
                             rdfs:comment "Standing capability behind the 'Manage...' nodes of 3.5 (R6). R6 target for PCF 11174 'Manage customer relationships' (a standing function with no natural end, NOT minted as a process); realized in the bounded customer-relationship-management acts (ex:ManageCustomerRelationships)." ;
                             rdfs:label "Sales Management Capability" ;
                             skos:definition "An Organization Capability that is realized in Acts of managing leads, accounts, proposals, orders, and sales execution, and the ongoing relationships with customers." .


###  http://example.org/apqc#SalesOrder
ex:SalesOrder rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000965 ;
              rdfs:comment "Output of 3.5.4 (manage sales orders) and the sales-execution channels 3.5.6-8. Directive: an accepted order prescribes what must be delivered. Distinct from ex:SalesOrderData (the descriptive aggregate record used as forecasting input)." ;
              rdfs:label "Sales Order" ;
              skos:definition "A Directive Information Content Entity that prescribes a customer's order of products or services to be fulfilled by the organization." .


###  http://example.org/apqc#SalesOrderData
ex:SalesOrderData rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Input to 3.4.1 (forecast) and 3.5.4 (order management). Descriptive record of orders." ;
                  rdfs:label "Sales Order Data" ;
                  skos:definition "A Descriptive Information Content Entity that describes current and historical sales orders, including product, quantity, customer, price, and terms." .


###  http://example.org/apqc#SalesPartner
ex:SalesPartner rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001180 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000196 ;
                                  owl:someValuesFrom ex:SalesPartnerRole
                                ] ;
                rdfs:comment "Subject of PartnerMasterData / PartnerEvaluation (3.4.2, 3.5.5). Modeled as Organization (economic agent)." ;
                rdfs:label "Sales Partner" ;
                skos:definition "An Organization that bears a sales-partner role, collaborating with a focal organization to market, sell, or distribute its offerings." .


###  http://example.org/apqc#SalesPartnerRole
ex:SalesPartnerRole rdf:type owl:Class ;
                    rdfs:subClassOf obo:BFO_0000023 ;
                    rdfs:comment "Covers channel partners, alliance partners, distributors, resellers (3.2.3, 3.4.2, 3.5.5). Borne by the partner Organization/Agent." ;
                    rdfs:label "Sales Partner/Alliance Role" ;
                    skos:definition "A Role that is borne by an Organization or Agent in virtue of partnering with a focal organization to market, sell, or distribute its offerings." .


###  http://example.org/apqc#SalesPersonnel
ex:SalesPersonnel rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00001017 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000196 ;
                                    owl:someValuesFrom ex:SalesProfessionalRole
                                  ] ;
                  rdfs:comment "The sales-function participant across 3.4, 3.5." ;
                  rdfs:label "Sales Personnel" ;
                  skos:definition "An Agent that bears a sales-professional role." .


###  http://example.org/apqc#SalesPlan
ex:SalesPlan rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000965 ;
             rdfs:comment "Output of 3.4.2.11 (11523) and 3.5.2.2 (key account plan). Directive (Formulation)." ;
             rdfs:label "Sales Plan" ;
             skos:definition "A Directive Information Content Entity that prescribes strategic and tactical sales actions, objectives, and resource use for a customer or account." .


###  http://example.org/apqc#SalesProfessionalRole
ex:SalesProfessionalRole rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000984 ;
                         rdfs:comment "Covers sales personnel across 3.4 and 3.5." ;
                         rdfs:label "Sales Professional Role" ;
                         skos:definition "A Role that is borne by an Agent in virtue of being tasked with selling an organization's offerings." .


###  http://example.org/apqc#SalesProposal
ex:SalesProposal rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:comment "Output of 3.5.3, 3.5.1.8.2, 3.5.3.14. Directive: a proposal/bid prescribes what the supplier will deliver and on what terms (Formulation genus)." ;
                 rdfs:label "Sales Proposal/Bid/Quote" ;
                 skos:definition "A Directive Information Content Entity that prescribes an organization's proposed solution, pricing, and schedule in response to a customer requirement." .


###  http://example.org/apqc#SalesReport
ex:SalesReport rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000853 ;
               rdfs:label "Sales Report" ;
               skos:definition "A Descriptive Information Content Entity that describes sales volumes, revenue, and market response for a product or service." .


###  http://example.org/apqc#SalesTeam
ex:SalesTeam rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00001017 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty obo:BFO_0000196 ;
                               owl:someValuesFrom ex:SalesAgentRole
                             ] ;
             rdfs:comment "Minted. Recipient named in 6.2.2.6 (Deliver opportunity to sales team). Denotes a team-level COLLECTIVE agent (not an individual); kept under cco:Agent (CCO's Group of Agents cco:ont00000300 is an Object Aggregate, not an Agent)." ;
             rdfs:label "Sales Team" ;
             skos:definition "An Agent that bears a sales-agent role and to which qualified sales leads are delivered for follow-up." .


###  http://example.org/apqc#SalesTrainingMaterial
ex:SalesTrainingMaterial rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cco:ont00001808 ;
                                           owl:someValuesFrom ex:Offering
                                         ] ;
                         rdfs:comment "Distributed in 3.5.5.1, 3.5.5.1.1. Descriptive; is about the Offering." ;
                         rdfs:label "Sales Training Material" ;
                         skos:definition "A Descriptive Information Content Entity that describes an organization's products and services for the instruction of sales partners and personnel." .


###  http://example.org/apqc#SalesTrendAnalysis
ex:SalesTrendAnalysis rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Output of 3.4.1.2, 3.4.1.4. Descriptive (Analysis genus)." ;
                      rdfs:label "Sales Trend Analysis" ;
                      skos:definition "A Descriptive Information Content Entity that describes patterns and trends discerned in sales order data." .


###  http://example.org/apqc#SampleSignificanceAssessment
ex:SampleSignificanceAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:label "Sample Significance Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes whether a test sample is representative of the larger output and meets acceptance requirements." .


###  http://example.org/apqc#SamplingPlan
ex:SamplingPlan rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:label "Sampling Plan" ;
                skos:definition "A Directive Information Content Entity that prescribes which parameters to measure, sample sizes, the sampling scheme, and the roles for taking samples." .


###  http://example.org/apqc#SanctionedPartyList
ex:SanctionedPartyList rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Minted for group 9.11. Input to sanctioned-party screening. Descriptive (it represents who may trade), not Directive." ;
                       rdfs:label "Sanctioned Party List" ;
                       skos:definition "A Descriptive Information Content Entity that describes the parties approved or prohibited for engaging in international trade, together with their granted legal rights and credentials." ;
                       skos:example "A consolidated denied-/approved-parties screening list maintained for export controls." .


###  http://example.org/apqc#SanctionedPartyScreeningResult
ex:SanctionedPartyScreeningResult rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Minted for group 9.11. Output of 9.11.1. Descriptive (it records a clearance judgement) per the GOLDEN PRINCIPLE for an Appraisal act." ;
                                  rdfs:label "Sanctioned Party Screening Result" ;
                                  skos:definition "A Descriptive Information Content Entity that describes a judgement of whether the parties to a prospective transaction are clear to engage in international trade, based on evaluation of the approved-party list and their credentials." ;
                                  skos:example "A trade-compliance clearance record flagging a counterparty as cleared or blocked." .


###  http://example.org/apqc#SeniorManagement
ex:SeniorManagement rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00001017 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty obo:BFO_0000196 ;
                                      owl:someValuesFrom ex:SeniorManagementRole
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty obo:BFO_0000196 ;
                                      owl:someValuesFrom ex:SeniorManagerRole
                                    ] ;
                    rdfs:comment "APQC 'senior management executives'. cco:Agent (not bare material entity) excludes non-agentive participants." ,
                                 "Section-wide participant: APQC repeatedly assigns strategy formulation/selection to 'senior management executives'." ;
                    rdfs:label "Senior Management" ;
                    skos:definition "An Agent that bears a senior management role." ,
                                    "An Agent that bears a senior manager role." .


###  http://example.org/apqc#SeniorManagementRole
ex:SeniorManagementRole rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000984 ;
                        rdfs:comment "Recurs where APQC says 'Enlist senior management executives' (2.1.1.2, 2.1.1.4, 2.2.1.x)." ;
                        rdfs:label "Senior Management Role" ;
                        skos:definition "A Role that is borne by an Agent in virtue of holding senior executive authority over strategy, investment, or product decisions within an Organization." .


###  http://example.org/apqc#SeniorManagerRole
ex:SeniorManagerRole rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000984 ;
                     rdfs:comment "Narrower than the 1.1.1 reference module's ex:ManagerRole; used where APQC text specifies senior executives / senior strategy personnel. MERGE DECISION: this Senior pair (ex:SeniorManagerRole / ex:SeniorManagement) deliberately supersedes the reference's generic ex:ManagerRole / ex:ManagementPersonnel for the 1.1.1.8 (P10024) participant, which APQC scopes to 'mid- to senior-level management'. The generic role/agent pair is intentionally not carried over: no process in this merged module requires a non-senior management universal, so re-adding it would leave orphaned classes. Re-mint ex:ManagerRole (and ex:ManagementPersonnel bearing it) as the rdfs:subClassOf parent of this pair only if a future merged process needs the generic universal." ;
                     rdfs:label "Senior Manager Role" ;
                     skos:definition "A Role that is borne by an Agent in virtue of exercising senior managerial or executive authority over the strategy and direction of an Organization." .


###  http://example.org/apqc#ServiceComponentSelectionCriteria
ex:ServiceComponentSelectionCriteria rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "8.5.1.4 output / 8.5.1.5 input. Directive." ;
                                     rdfs:label "Service Component Selection Criteria" ;
                                     skos:definition "A Directive Information Content Entity that prescribes the standards by which IT service components are selected." ;
                                     skos:example "A checklist of mandatory criteria a reusable component must satisfy to be adopted." .


###  http://example.org/apqc#ServiceDeliveryCapability
ex:ServiceDeliveryCapability rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000568 ;
                             ex:enablesProcess ex:P20058 ,
                                               ex:P20059 ,
                                               ex:P20069 ,
                                               ex:P20076 ,
                                               ex:P20077 ;
                             rdfs:comment "Shared section-5.0 capability. Standing-function nodes (R5) realize this; the group agent that mints those acts adds the 'realized in some <act>' restriction (R6)." ;
                             rdfs:label "Service Delivery Capability" ;
                             skos:definition "An Organization Capability that is realized in the acts by which an organization renders services to its customers." .


###  http://example.org/apqc#ServiceDeliveryCompletionConfirmation
ex:ServiceDeliveryCompletionConfirmation rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000853 ;
                                         rdfs:comment "Minted locally (Gate-F fix, 5.3.3.5): output of ex:P20082, supplying the descriptive completion-confirmation its Act-of-Appraisal genus definitionally produces. Descriptive: a confirmation reports a verified state." ;
                                         rdfs:label "Service Delivery Completion Confirmation" ;
                                         skos:definition "A Descriptive Information Content Entity that describes a confirmed judgement that all internal and external aspects of a service delivery have been completed." ;
                                         skos:example "A closeout checklist signed off once every internal and external completion item is cleared." .


###  http://example.org/apqc#ServiceDeliveryContract
ex:ServiceDeliveryContract rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Shared section-5.0 input/output. Recurs across 5.3.1.1, 5.3.3.3. Directive: a contract prescribes binding obligations." ;
                           rdfs:label "Service Delivery Contract" ;
                           skos:definition "A Directive Information Content Entity that prescribes the agreed terms and obligations governing the delivery of a service to a customer." .


###  http://example.org/apqc#ServiceDeliveryDevelopmentManagementCapability
ex:ServiceDeliveryDevelopmentManagementCapability rdf:type owl:Class ;
                                                  rdfs:subClassOf ex:ServiceDeliveryGovernanceCapability ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty obo:BFO_0000054 ;
                                                                    owl:someValuesFrom ex:P20027
                                                                  ] ;
                                                  ex:enablesProcess ex:P20027 ;
                                                  rdfs:comment "Minted for the R5/R6 demotion of APQC activity 5.1.1.3 'Manage service delivery development and direction' [20030]: a standing guidance/management function with no natural end, hence an Organization Capability (cco:ont00000568) not a bounded process. Specializes the shared ex:ServiceDeliveryGovernanceCapability; realized in the bounded governance establishment act ex:P20027 (R6)." ;
                                                  rdfs:label "Service Delivery Development and Direction Management Capability" ;
                                                  skos:definition "A Service Delivery Governance Capability that is realized in the ongoing acts by which an organization guides the resources that keep the development and direction of service delivery in line with customer needs." .


###  http://example.org/apqc#ServiceDeliveryGoal
ex:ServiceDeliveryGoal rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Shared section-5.0 output (5.1.2.1). Directive: a goal prescribes an intended end-state." ;
                       rdfs:label "Service Delivery Goal" ;
                       skos:definition "A Directive Information Content Entity that prescribes a target outcome an organization's service delivery is intended to achieve for its customers." .


###  http://example.org/apqc#ServiceDeliveryGovernanceCapability
ex:ServiceDeliveryGovernanceCapability rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000568 ;
                                       ex:enablesProcess ex:P20026 ,
                                                         ex:P20027 ;
                                       rdfs:comment "Shared section-5.0 capability for the governance standing-functions in 5.1.1 (e.g. 5.1.1.1-5.1.1.3 'Manage ...' nodes that R5 resolves to capability, not process)." ;
                                       rdfs:label "Service Delivery Governance Capability" ;
                                       skos:definition "An Organization Capability that is realized in the acts by which an organization governs the performance, development, and direction of its service delivery." .


###  http://example.org/apqc#ServiceDeliveryPerformanceManagementCapability
ex:ServiceDeliveryPerformanceManagementCapability rdf:type owl:Class ;
                                                  rdfs:subClassOf ex:ServiceDeliveryGovernanceCapability ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty obo:BFO_0000054 ;
                                                                    owl:someValuesFrom ex:P20027
                                                                  ] ;
                                                  ex:enablesProcess ex:P20027 ;
                                                  rdfs:comment "Minted for the R5/R6 demotion of APQC activity 5.1.1.2 'Manage service delivery performance' [20029]: a standing oversight function with no natural end, so an Organization Capability (cco:ont00000568) rather than a bounded process. Specializes the shared ex:ServiceDeliveryGovernanceCapability; realized in the bounded governance establishment act ex:P20027 (R6)." ;
                                                  rdfs:label "Service Delivery Performance Management Capability" ;
                                                  skos:definition "A Service Delivery Governance Capability that is realized in the ongoing acts by which an organization conducts and implements performance measures to ensure successful delivery of service to the customer." .


###  http://example.org/apqc#ServiceDeliveryPersonnel
ex:ServiceDeliveryPersonnel rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00001017 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty obo:BFO_0000196 ;
                                              owl:someValuesFrom ex:ServiceDeliveryPersonnelRole
                                            ] ;
                            rdfs:comment "Shared section-5.0 participant (5.3.1.6, 5.2.3.4, 5.2.3.5). The 'resources' assigned and trained for delivery." ;
                            rdfs:label "Service Delivery Personnel" ;
                            skos:definition "An Agent that bears a service-delivery personnel role in virtue of being assigned to perform the work of delivering a service to a customer." .


###  http://example.org/apqc#ServiceDeliveryPersonnelRole
ex:ServiceDeliveryPersonnelRole rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000984 ;
                                rdfs:label "Service Delivery Personnel Role" ;
                                skos:definition "A Role that is borne by an Agent in virtue of being assigned to perform the work of delivering a service to a customer." .


###  http://example.org/apqc#ServiceDeliveryPlan
ex:ServiceDeliveryPlan rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Shared section-5.0 output (5.2, 5.3.1, 5.3.1.7). Distinct from ex:ProjectPlan: the action plan for the delivery itself rather than the overall engagement." ;
                       rdfs:label "Service Delivery Plan" ;
                       skos:definition "A Directive Information Content Entity that prescribes the plan of action for rendering a service-delivery solution to a customer." .


###  http://example.org/apqc#ServiceDeliveryProcessSpecification
ex:ServiceDeliveryProcessSpecification rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000965 ;
                                       rdfs:comment "Shared section-5.0 output (5.1.2.5, 5.1.2.6, 5.3.1.2). Directive: a procedure prescribes how the work is to be carried out." ;
                                       rdfs:label "Service Delivery Process Specification" ;
                                       skos:definition "A Directive Information Content Entity that prescribes the policies and procedures by which a service is delivered within an organization's operating parameters." .


###  http://example.org/apqc#ServiceDeliveryRecord
ex:ServiceDeliveryRecord rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Shared section-5.0 output/input (5.3.3.7). Descriptive: it documents what occurred." ;
                         rdfs:label "Service Delivery Record" ;
                         skos:definition "A Descriptive Information Content Entity that records facts about a delivered service for archival and system-of-record purposes." .


###  http://example.org/apqc#ServiceDeliveryReview
ex:ServiceDeliveryReview rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Shared section-5.0 output (5.3.3.1). Descriptive: it appraises and reports outcomes." ;
                         rdfs:label "Service Delivery Review" ;
                         skos:definition "A Descriptive Information Content Entity that describes an end-to-end evaluation of the success of a completed service-delivery engagement." .


###  http://example.org/apqc#ServiceDeliverySatisfactionAssessment
ex:ServiceDeliverySatisfactionAssessment rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000853 ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty cco:ont00001808 ;
                                                           owl:someValuesFrom ex:Customer
                                                         ] ;
                                         rdfs:comment "Shared section-5.0 output (5.1.1.4). 'is about' the Customer whose satisfaction it characterises." ;
                                         rdfs:label "Service Delivery Satisfaction Assessment" ;
                                         skos:definition "A Descriptive Information Content Entity that describes a judgement, derived from customer feedback, of how satisfactorily a service was delivered." .


###  http://example.org/apqc#ServiceDeliverySolution
ex:ServiceDeliverySolution rdf:type owl:Class ;
                           rdfs:subClassOf obo:BFO_0000040 ;
                           rdfs:comment "Shared section-5.0 output (5.3.2.6, 5.3.2.7). Modeled as a material entity per the operations material-I/O allowance; where a particular solution is purely informational, group agents may instead use ex:SolutionSpecification. ex:SolutionSpecification (Directive ICE) prescribes it; this class is the delivered artifact." ;
                           rdfs:label "Service Delivery Solution (deployed artifact)" ;
                           skos:definition "A Material Entity (a built or purchased artifact) that is deployed to a customer to fulfil a service-delivery need." .


###  http://example.org/apqc#ServiceDeliveryStrategy
ex:ServiceDeliveryStrategy rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Shared section-5.0 output (5.1.2). Directive: a strategy prescribes an intended course of action." ;
                           rdfs:label "Service Delivery Strategy" ;
                           skos:definition "A Directive Information Content Entity that prescribes the goals, policies, processes, and procedures by which an organization intends to deliver services." .


###  http://example.org/apqc#ServiceKnowledgeBase
ex:ServiceKnowledgeBase rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cco:ont00001808 ;
                                          owl:someValuesFrom ex:ServiceDeliveryProcessSpecification
                                        ] ;
                        rdfs:comment "Shared section-5.0 output (5.3.3.6). 'is about' the service-delivery process the knowledge concerns." ;
                        rdfs:label "Service Knowledge Base" ;
                        skos:definition "A Descriptive Information Content Entity that describes accumulated lessons and information harvested from completed service-delivery engagements." .


###  http://example.org/apqc#ServiceLevelAgreement
ex:ServiceLevelAgreement rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Output of 6.1.5 (Establish target service level for each customer segment)." ,
                                      "Section-8.0 shared output. APQC 8.1.5.4 / 8.1.5.6 define/negotiate SLAs, 8.1.7.1 SLA compliance, 8.7.5.1 SLAs. Directive: an SLA prescribes commitments." ;
                         rdfs:label "Service Level Agreement" ,
                                    "Service-Level Agreement" ;
                         skos:definition "A Directive Information Content Entity that prescribes the negotiated commitments, service targets, priorities, and responsibilities governing the provision of IT services to a customer." ,
                                         "A Directive Information Content Entity that prescribes the negotiated service levels, priorities, and responsibilities agreed for a customer segment." ,
                                         "A Directive Information Content Entity, agreed between parties, that prescribes the scope, quality, and responsibilities of a service." .


###  http://example.org/apqc#ServiceOrder
ex:ServiceOrder rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:comment "Output of 6.3.4.1.3 (Generate service order). Directive -> producing act is Formulation." ;
                rdfs:label "Service Order" ;
                skos:definition "A Directive Information Content Entity that prescribes a short-term agreement between a service provider and a customer for a one-time service and its resource-related billing." .


###  http://example.org/apqc#ServiceOrderFulfillmentSchedule
ex:ServiceOrderFulfillmentSchedule rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000965 ;
                                   rdfs:comment "Output of 6.3.4.2.2 and the daily schedule of 6.3.4.3.1." ;
                                   rdfs:label "Service Order Fulfillment Schedule" ;
                                   skos:definition "A Directive Information Content Entity that prescribes the timing and duration of the services required to fulfill service orders." .


###  http://example.org/apqc#ServiceOrderFulfillmentStatus
ex:ServiceOrderFulfillmentStatus rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Minted: output of P10332 (monitoring); input to P10334/P10335. Descriptive state report." ;
                                 rdfs:label "Service Order Fulfillment Status" ;
                                 skos:definition "A Descriptive Information Content Entity that reports the current fulfillment progress of one or more service orders, including fully, partially, and unfulfilled orders." .


###  http://example.org/apqc#ServiceProvider
ex:ServiceProvider rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00001017 ,
                                   cco:ont00001180 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001954 ;
                                     owl:someValuesFrom ex:ServiceDeliveryCapability
                                   ] ;
                   rdfs:comment "Shared section-5.0 agent: the focal organization rendering service. Capability borne on the Organization, not on any ICE (D4)." ;
                   rdfs:label "Service Provider" ;
                   skos:definition "An Organization that has the capability to deliver services to customers." .


###  http://example.org/apqc#ServiceQualityAssessment
ex:ServiceQualityAssessment rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Output of 6.3.4.4 (Ensure quality of service)." ;
                            rdfs:label "Service Quality Assessment" ;
                            skos:definition "A Descriptive Information Content Entity that describes a judgement of the quality of service delivered to customers, including successes, failures, and incorporated feedback." .


###  http://example.org/apqc#ServiceRequest
ex:ServiceRequest rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Input to 6.3.4.1 (Confirm specific service requirements for individual customer)." ;
                  rdfs:label "Service Request" ;
                  skos:definition "A Descriptive Information Content Entity that records an individual customer's specific service requirements." .


###  http://example.org/apqc#Shareholder
ex:Shareholder rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00001017 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000196 ;
                                 owl:someValuesFrom ex:ShareholderRole
                               ] ;
               rdfs:comment "Minted for 12.1.3 (Communicate with shareholders). Agent (not Organization) because a shareholder may be an individual or an organization." ;
               rdfs:label "Shareholder" ;
               skos:definition "An Agent that bears a shareholder role in virtue of holding an equity interest in an organization." .


###  http://example.org/apqc#ShareholderCommunication
ex:ShareholderCommunication rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Subject of 12.1.3 (Communicate with shareholders)." ;
                            rdfs:label "Shareholder Communication" ;
                            skos:definition "A Descriptive Information Content Entity that describes information conveyed to shareholders, such as a shareholders' letter, earnings-call statement, or meeting briefing." .


###  http://example.org/apqc#ShareholderRole
ex:ShareholderRole rdf:type owl:Class ;
                   rdfs:subClassOf obo:BFO_0000023 ;
                   rdfs:label "Shareholder Role" ;
                   skos:definition "A Role that is borne by an Agent in virtue of holding an equity interest in a focal organization." .


###  http://example.org/apqc#SiteStatusReport
ex:SiteStatusReport rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:label "Site Status Report" ;
                    skos:definition "A Descriptive Information Content Entity that describes the status of an abandoned or remediated site for the duration required by regulators." .


###  http://example.org/apqc#SkillRequirementData
ex:SkillRequirementData rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "Skill Requirement Data" ;
                        skos:definition "A Descriptive Information Content Entity that describes the skills, knowledge, and competencies required by an organization or a position." .


###  http://example.org/apqc#SkillsCapabilityTestResult
ex:SkillsCapabilityTestResult rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "Minted locally (5.2.3.6): distinct from ex:TrainingEffectivenessEvaluation (an aggregate appraisal); this records a single test administration outcome. Descriptive because it reports measured performance." ;
                              rdfs:label "Skills and Capability Test Result" ;
                              skos:definition "A Descriptive Information Content Entity that describes the outcome of administering a skill or capability test to service delivery personnel following training." ;
                              skos:example "A pass/fail record from a hands-on competency test administered after a technical training course." .


###  http://example.org/apqc#SkillsGapAnalysis
ex:SkillsGapAnalysis rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:label "Skills Gap Analysis" ;
                     skos:definition "A Descriptive Information Content Entity that describes the difference between the skills required by an organization and those currently available in its workforce." .


###  http://example.org/apqc#SkillsTaxonomy
ex:SkillsTaxonomy rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Shared section-5.0 output (5.2.2.1). Descriptive: a classification describes how skills are organized; it does not prescribe action." ;
                  rdfs:label "Skills Taxonomy" ;
                  skos:definition "A Descriptive Information Content Entity that classifies and organizes the skills required to perform an organization's services." .


###  http://example.org/apqc#SocioculturalData
ex:SocioculturalData rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:label "Sociocultural Data" ;
                     skos:definition "A Descriptive Information Content Entity that describes societal composition, distribution, and value systems." .


###  http://example.org/apqc#SocioculturalShiftAnalysis
ex:SocioculturalShiftAnalysis rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Sociocultural Shift Analysis" ;
                              skos:definition "A Descriptive Information Content Entity that describes shifts in societal makeup and cultural composition." .


###  http://example.org/apqc#SolutionBuildRecord
ex:SolutionBuildRecord rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Shared section-5.0 output (5.3.2.6). The informational deliverable of make/build-or-buy: every process has output is an ICE (D3 / S3), whereas the produced ex:ServiceDeliverySolution artifact (a material entity) is consumed downstream by deployment (5.3.2.7) only as an input. ex:SolutionSpecification (Directive ICE) prescribes the solution; this records that it was built/bought." ;
                       rdfs:label "Solution Build Record" ;
                       skos:definition "A Descriptive Information Content Entity that records that a service-delivery solution has been constructed or purchased and documents how it was realized." .


###  http://example.org/apqc#SolutionChangeSpecification
ex:SolutionChangeSpecification rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Minted locally: APQC 5.3.2.4 output; no shared-vocab ICE supplied. Directive because it prescribes changes to be applied." ;
                               rdfs:label "Solution Change Specification" ;
                               skos:definition "A Directive Information Content Entity that prescribes corrections to a drafted solution in response to identified issues." ;
                               skos:example "A change request listing fixes required before a solution can be approved." .


###  http://example.org/apqc#SolutionSpecification
ex:SolutionSpecification rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Shared section-5.0 output (5.3.2.2). Directive: a specification prescribes what is to be produced." ;
                         rdfs:label "Solution Specification" ;
                         skos:definition "A Directive Information Content Entity that prescribes the service-delivery solution to be built, bought, or deployed to meet a customer's needs." .


###  http://example.org/apqc#SolutionValidationResult
ex:SolutionValidationResult rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Shared section-5.0 output (5.3.2.3, 5.3.2.4). Descriptive: it records a validation judgement." ;
                            rdfs:label "Solution Validation Result" ;
                            skos:definition "A Descriptive Information Content Entity that describes a judgement of whether a proposed service-delivery solution is feasible and meets customer needs." .


###  http://example.org/apqc#SourcingOpportunityAssessment
ex:SourcingOpportunityAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Minted: shared vocab has no opportunity-register ICE. Descriptive because it represents identified opportunities, not a chosen course of action." ;
                                 rdfs:label "Sourcing Opportunity Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes discerned opportunities to improve sourcing efficiency, value, or coverage." ;
                                 skos:example "A register of consolidation and dual-sourcing opportunities found across the supply base." .


###  http://example.org/apqc#SpendProfileAnalysis
ex:SpendProfileAnalysis rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "Spend Profile Analysis" ;
                        skos:definition "A Descriptive Information Content Entity that describes an organization's procurement spend, classified and analyzed to reduce cost and monitor compliance." .


###  http://example.org/apqc#StaffingPlan
ex:StaffingPlan rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:label "Staffing Plan" ;
                skos:definition "A Directive Information Content Entity that prescribes how many people with which skills are to be hired to meet an organization's requirements." .


###  http://example.org/apqc#Stakeholder
ex:Stakeholder rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00001017 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000196 ;
                                 owl:someValuesFrom ex:StakeholderRole
                               ] ;
               rdfs:comment "Recipient of HR plan communications and source of requirements in groups 7.1, 7.7." ,
                            "Where the stakeholder is itself an Organization (e.g. a partner firm), use cco:ont00001180 as the genus instead." ;
               rdfs:label "Stakeholder" ;
               skos:definition "An Agent that bears a stakeholder role in virtue of being able to affect or be affected by an organization's HR actions, objectives, and policies." ,
                               "An Agent that bears a stakeholder role with respect to an Organization's initiative." ,
                               "An Agent that bears a stakeholder role." .


###  http://example.org/apqc#StakeholderAlignmentPlan
ex:StakeholderAlignmentPlan rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000974 ;
                            rdfs:comment "Output of 1.1.4.2 'Align stakeholders around strategic vision'." ;
                            rdfs:label "Stakeholder Alignment Plan" ;
                            skos:definition "A Plan that prescribes how stakeholders are to be oriented and positioned in support of an organization's strategic vision." .


###  http://example.org/apqc#StakeholderAssessment
ex:StakeholderAssessment rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Stakeholder Assessment" ;
                         skos:definition "A Descriptive Information Content Entity that describes the internal and external stakeholders affected by a change and the degree of influence the change has on them." .


###  http://example.org/apqc#StakeholderNeedsStatement
ex:StakeholderNeedsStatement rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:label "Stakeholder Needs Statement" ;
                             skos:definition "A Descriptive Information Content Entity that describes the needs and requirements gathered from stakeholders prior to conducting analytics." .


###  http://example.org/apqc#StakeholderRelationshipManagementCapability
ex:StakeholderRelationshipManagementCapability rdf:type owl:Class ;
                                               rdfs:subClassOf cco:ont00000568 ;
                                               ex:enablesProcess ex:P11012 ,
                                                                 ex:P11038 ,
                                                                 ex:P11039 ,
                                                                 ex:P11040 ,
                                                                 ex:P11041 ;
                                               rdfs:comment "Shared capability for the 'Manage/Build ... relations' standing-function rows (12.1, 12.2.x, 12.3, 12.5.x), realized in the relevant relationship-management acts via obo:BFO_0000054 (realized in)." ;
                                               rdfs:label "Stakeholder Relationship Management Capability" ;
                                               skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to build and maintain relationships with external stakeholders such as investors, government bodies, and the public." .


###  http://example.org/apqc#StakeholderRequirements
ex:StakeholderRequirements rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Despite the 'Requirements' label this is DESCRIPTIVE (D6 false-friend guard): it records/describes requirements expressed by stakeholders, not the directive rule or obligation itself, which would be a Directive ICE modeled separately." ;
                           rdfs:label "Stakeholder Requirements" ;
                           skos:definition "A Descriptive Information Content Entity that describes the requirements expressed by enterprise stakeholders, used as input to analytics and planning." .


###  http://example.org/apqc#StakeholderRole
ex:StakeholderRole rdf:type owl:Class ;
                   rdfs:subClassOf obo:BFO_0000023 ;
                   rdfs:comment "Minted because CCO 2.0 has no Stakeholder class/role. Superset of customer, partner, and regulator relations relative to a focal organization." ,
                                "Minted for the cross-cutting 'stakeholder' participant referenced across 13.2, 13.4, 13.7, 13.8, 13.9." ;
                   rdfs:label "Stakeholder Role" ;
                   skos:definition "A Role that is borne by an Agent or Organization in virtue of having an interest in, or being affected by, the operations, strategy, processes, programs, or policies of a focal organization." .


###  http://example.org/apqc#StandardOperatingProcedure
ex:StandardOperatingProcedure rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:label "Standard Operating Procedure" ;
                              skos:definition "A Directive Information Content Entity that prescribes step-by-step methods to be followed routinely for the performance of designated operations." .


###  http://example.org/apqc#StorageRequirementAssessment
ex:StorageRequirementAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Minted (D5) as the descriptive output of Determine product storage facility requirements [19555], whose source leads with 'Evaluate constraints, needs, parameters, and conditions'. Descriptive because it represents an appraisal of storage requirements rather than prescribing a storage plan. Distinct from ex:LogisticsRequirementSpecification (a Directive spec)." ;
                                rdfs:label "Storage Requirement Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes an evaluation of the constraints, needs, parameters, and conditions for the physical storage and retrieval of components or products in a storage facility." ;
                                skos:example "An assessment of the racking, temperature, and throughput needs evaluated for a candidate storage facility." .


###  http://example.org/apqc#StrategicAlignmentAssessment
ex:StrategicAlignmentAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cco:ont00001808 ;
                                                  owl:someValuesFrom ex:BusinessStrategy
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cco:ont00001808 ;
                                                  owl:someValuesFrom ex:ProductServiceOffering
                                                ] ;
                                rdfs:comment "Gate-F mint: output of 2.1.1.2. Distinct from ex:FeasibilityAssessment, which judges practicability/realizability; this judges STRATEGIC ALIGNMENT, a different subject. Replacing the FeasibilityAssessment filler on ex:P10066 corrects an inclusiveness/exclusiveness violation (the output ICE described the wrong subject)." ;
                                rdfs:label "Strategic Alignment Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes a judgement of whether a product/service concept aligns with the organization's business strategy." .


###  http://example.org/apqc#StrategicGoals
ex:StrategicGoals rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "Strategic Goals" ;
                  skos:definition "A Descriptive Information Content Entity that describes the strategic goals of an organization against which human-resource requirements are to be aligned." .


###  http://example.org/apqc#StrategicHRNeedsAssessment
ex:StrategicHRNeedsAssessment rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Strategic HR Needs Assessment" ;
                              skos:definition "A Descriptive Information Content Entity that describes the current and future human-resource needs of an organization." .


###  http://example.org/apqc#StrategicInitiativeEvaluation
ex:StrategicInitiativeEvaluation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:label "Strategic Initiative Evaluation" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the applicability and feasibility of a strategic initiative relative to an organization's vision and constraints." .


###  http://example.org/apqc#StrategicInitiativeSpecification
ex:StrategicInitiativeSpecification rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000965 ;
                                    rdfs:comment "Output of 1.3.1 'Develop strategic initiatives'; consumed (as input) by 1.3.2/1.3.3 evaluation and selection." ;
                                    rdfs:label "Strategic Initiative Specification" ;
                                    skos:definition "A Directive Information Content Entity that prescribes a discretionary, time-bound strategic project lying beyond an organization's routine operations." .


###  http://example.org/apqc#StrategicOption
ex:StrategicOption rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Directive (a candidate prescription) and distinct from ex:StrategicOptionAnalysis, which describes the assessed impact of options." ;
                   rdfs:label "Strategic Option" ;
                   skos:definition "A Directive Information Content Entity that prescribes one candidate course of strategic action available to an organization." .


###  http://example.org/apqc#StrategicOptionAnalysis
ex:StrategicOptionAnalysis rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Covers the impact/option assessments produced across 1.2.2 (B2B, B2C, partner, IP, innovation, sustainability, support, shared-services, lean options)." ;
                           rdfs:label "Strategic Option Analysis" ;
                           skos:definition "A Descriptive Information Content Entity that describes the assessed impact and consequences of one or more candidate strategic options." .


###  http://example.org/apqc#StrategicPlanningCapability
ex:StrategicPlanningCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ;
                               ex:enablesProcess ex:P10020 ,
                                                 ex:P10037 ,
                                                 ex:P10039 ,
                                                 ex:P10043 ,
                                                 ex:P10045 ,
                                                 ex:P19949 ;
                               rdfs:comment "Use as the realizable behind standing 'develop/define strategy' functions. Subclass of ont00000568 because the bearer is the Organization as a whole." ;
                               rdfs:label "Strategic Planning Capability" ;
                               skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to formulate vision, mission, and strategy through intentional acts of strategy formulation and selection." .


###  http://example.org/apqc#StrategicPriority
ex:StrategicPriority rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000476 ;
                     rdfs:comment "Reuses CCO Objective. Output of 1.3.1.1 'Identify strategic priorities'; priorities are objectives ordered by importance." ;
                     rdfs:label "Strategic Priority" ;
                     skos:definition "An Objective that prescribes a ranked organizational direction used to guide resource-allocation decisions." .


###  http://example.org/apqc#StrategicVision
ex:StrategicVision rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Directive output of 1.1.4 'Establish strategic vision' and 1.2.8 customer-experience vision." ;
                   rdfs:label "Strategic Vision" ;
                   skos:definition "A Directive Information Content Entity that prescribes an organization's intended long-term direction and aspirational future state." .


###  http://example.org/apqc#StrategistRole
ex:StrategistRole rdf:type owl:Class ;
                  rdfs:subClassOf ex:Role ,
                                  cco:ont00000984 ;
                  rdfs:label "Strategist role" ;
                  skos:definition "The occupation role of an agent acting as a strategy author/owner." .


###  http://example.org/apqc#StrategyAlignmentPlan
ex:StrategyAlignmentPlan rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000974 ;
                         rdfs:comment "Minted (Gate-F) for P10040 'Coordinate and align cross-functional and process strategies'. Units/processes-oriented, replacing the stakeholder-oriented ex:StakeholderAlignmentPlan, which concerns orienting stakeholders rather than calibrating unit plans." ;
                         rdfs:label "Strategy Alignment Plan" ;
                         skos:definition "A Plan that prescribes how the plans and methods of an organization's individual units, departments, and processes are to be calibrated to the adopted enterprise strategy." .


###  http://example.org/apqc#StrategyPersonnel
ex:StrategyPersonnel rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00001017 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000196 ;
                                       owl:someValuesFrom ex:StrategyPersonnelRole
                                     ] ;
                     rdfs:label "Strategy Personnel" ;
                     skos:definition "An Agent that bears a strategy personnel role." .


###  http://example.org/apqc#StrategyPersonnelRole
ex:StrategyPersonnelRole rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000984 ;
                         rdfs:comment "Covers APQC 'strategy personnel', 'strategy executives', and 'business-unit strategy personnel'." ;
                         rdfs:label "Strategy Personnel Role" ;
                         skos:definition "A Role that is borne by an Agent in virtue of being tasked with formulating, evaluating, or coordinating an Organization's strategy." .


###  http://example.org/apqc#StrategyReviewReport
ex:StrategyReviewReport rdf:type owl:Class ;
                        rdfs:subClassOf ex:PerformanceReport ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cco:ont00001808 ;
                                          owl:someValuesFrom ex:BusinessStrategy
                                        ] ;
                        rdfs:comment "Minted (Gate-F) for P19977 'Review with stakeholders'. A specialization of ex:PerformanceReport carrying an is-about (cco:ont00001808) to ex:BusinessStrategy, so the reviewed strategy is captured as the report's subject matter rather than as a (mis-typed) has-input to a communication act." ;
                        rdfs:label "Strategy Review Report" ;
                        skos:definition "A Performance Report that describes an evaluation of an organization's business objectives and strategies and is about the business strategy reviewed." .


###  http://example.org/apqc#SubjectMatterExpert
ex:SubjectMatterExpert rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001017 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:SubjectMatterExpertRole
                                       ] ;
                       rdfs:comment "Definitional participant in 11.3.2 (contact and confer with experts)." ;
                       rdfs:label "Subject Matter Expert" ;
                       skos:definition "An Agent that bears a subject-matter-expert role and is consulted to validate remediation plans." .


###  http://example.org/apqc#SubjectMatterExpertRole
ex:SubjectMatterExpertRole rdf:type owl:Class ;
                           rdfs:subClassOf obo:BFO_0000023 ;
                           rdfs:label "Subject Matter Expert Role" ;
                           skos:definition "A Role that is borne by an Agent in virtue of possessing specialized expertise solicited to advise on and validate remediation plans." .


###  http://example.org/apqc#Subsidiary
ex:Subsidiary rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00001180 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty obo:BFO_0000196 ;
                                owl:someValuesFrom ex:SubsidiaryRole
                              ] ;
              rdfs:label "Subsidiary" ;
              skos:definition "An Organization that bears a subsidiary role, being a separate legal entity controlled by a parent Organization." .


###  http://example.org/apqc#SubsidiaryRole
ex:SubsidiaryRole rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000023 ;
                  rdfs:comment "Used in consolidation, in-house banking, and international-funds processes (9.3, 9.7, 9.10)." ;
                  rdfs:label "Subsidiary Role" ;
                  skos:definition "A Role that is borne by an Organization in virtue of being a separate legal entity controlled by a parent Organization." .


###  http://example.org/apqc#SubstitutionBusinessCase
ex:SubstitutionBusinessCase rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:label "Substitution Business Case" ;
                            skos:definition "A Descriptive Information Content Entity that describes an argument for or against a course of action in light of substitute products or services." .


###  http://example.org/apqc#SuccessionPlan
ex:SuccessionPlan rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:label "Succession Plan" ;
                  skos:definition "A Directive Information Content Entity that prescribes how key positions within an organization are to be continued, including identified successors and their development." .


###  http://example.org/apqc#SuggestionRegister
ex:SuggestionRegister rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Minted as the output of the suggestion-program-management facet de-conflated out of compound row P10530 (see ex:P10530_SuggestionProgram)." ;
                      rdfs:label "Employee Suggestion Register" ;
                      skos:definition "A Descriptive Information Content Entity that records and tracks the suggestions and ideas collected from employees through an organization's suggestion program." .


###  http://example.org/apqc#Supplier
ex:Supplier rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00001180 ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty obo:BFO_0000196 ;
                              owl:someValuesFrom ex:SupplierRole
                            ] ;
            rdfs:comment "Minted (no CCO Supplier class). Counterparty in 6.1.6.3 (Agree on warranty responsibilities with suppliers) and 6.3.3 (Manage supplier recovery)." ,
                         "Modeled as Organization per APQC 'vendors/suppliers'. Use cco:Agent for an individual supplier where needed." ,
                         "Shared section-5.0 participant (5.2.2.4, 5.2.2.5, 5.3.1.1). Modeled as cco:Agent to admit both organizational and individual suppliers." ,
                         "Vendor counterparty for accounts payable (9.6)." ;
            rdfs:label "Supplier" ;
            skos:definition "An Agent that bears a supplier role and provides goods or services to a focal Organization for payment." ,
                            "An Agent that bears a supplier role in relation to an organization to which it furnishes goods, parts, or services and with which it shares warranty obligations." ,
                            "An Agent that bears a supplier role in virtue of providing resources, skills, or capabilities that supplement an organization's service delivery." ,
                            "An Organization that bears a supplier role in relation to a procuring organization, providing materials or services." .


###  http://example.org/apqc#SupplierCapacityProfile
ex:SupplierCapacityProfile rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cco:ont00001808 ;
                                             owl:someValuesFrom ex:Supplier
                                           ] ;
                           rdfs:label "Supplier Capacity Profile" ;
                           skos:definition "A Descriptive Information Content Entity that describes the average, peak, and baseline supply capacities of vendors and suppliers." .


###  http://example.org/apqc#SupplierCertification
ex:SupplierCertification rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Minted: shared vocab has no supplier-certification artifact. Directive because it grants and governs an authorized status rather than describing one." ;
                         rdfs:label "Supplier Certification" ;
                         skos:definition "A Directive Information Content Entity that confers and prescribes the status of an entity as an official approved supplier." ;
                         skos:example "A certificate designating a vendor as an approved supplier for a given material category." .


###  http://example.org/apqc#SupplierContract
ex:SupplierContract rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:label "Supplier Contract" ;
                    skos:definition "A Directive Information Content Entity that prescribes the mutually binding obligations between an organization and a supplier, including promised delivery, dates, and duration." .


###  http://example.org/apqc#SupplierPerformanceReport
ex:SupplierPerformanceReport rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cco:ont00001808 ;
                                               owl:someValuesFrom ex:Supplier
                                             ] ;
                             rdfs:label "Supplier Performance Report" ;
                             skos:definition "A Descriptive Information Content Entity that describes the delivery timing and product quality achieved by suppliers." .


###  http://example.org/apqc#SupplierQuote
ex:SupplierQuote rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cco:ont00001808 ;
                                   owl:someValuesFrom ex:Supplier
                                 ] ;
                 rdfs:label "Supplier Quote" ;
                 skos:definition "A Descriptive Information Content Entity in which a supplier states its proposed price and terms for specified products or services." .


###  http://example.org/apqc#SupplierRecoveryClaim
ex:SupplierRecoveryClaim rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Output of 6.3.3.1 (Create supplier recovery claims). Descriptive: it asserts a cost-recovery basis rather than prescribing action." ;
                         rdfs:label "Supplier Recovery Claim" ;
                         skos:definition "A Descriptive Information Content Entity that asserts an organization's right to recover from a supplier the costs of a settled warranty claim." .


###  http://example.org/apqc#SupplierRole
ex:SupplierRole rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:comment "Used for accounts-payable counterparties (vendors) in 9.6." ;
                rdfs:label "Supplier Role" ;
                skos:definition "A Role that is borne by an Agent or Organization in virtue of furnishing goods, materials, resources, or services to a procuring organization, typically for consideration." .


###  http://example.org/apqc#SupplierSelectionDecision
ex:SupplierSelectionDecision rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cco:ont00001808 ;
                                               owl:someValuesFrom ex:Supplier
                                             ] ;
                             rdfs:comment "Directive because it selects and commits to a supplier for future action (Phase 3: a decision that authorizes/selects is a Directive ICE). Output of an Act of Selection." ;
                             rdfs:label "Supplier Selection Decision" ;
                             skos:definition "A Directive Information Content Entity that prescribes which supplier or suppliers are chosen, on the basis of material quality, delivery schedules, and cost." .


###  http://example.org/apqc#SupplierValidationAssessment
ex:SupplierValidationAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Minted: distinct from ex:SupplierPerformanceReport (ongoing performance) and ex:SupplierCertification (the resulting authorization). Descriptive because it represents a validation judgement." ;
                                rdfs:label "Supplier Validation Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes a judgement of whether a supply source meets the requirements to be an approved supplier." ;
                                skos:example "An audit finding that a vendor's quality system conforms to the required standard." .


###  http://example.org/apqc#SupplierWarrantyResponsibilityAgreement
ex:SupplierWarrantyResponsibilityAgreement rdf:type owl:Class ;
                                           rdfs:subClassOf cco:ont00000965 ;
                                           rdfs:comment "Minted: negotiated output of PCF 20090. Directive because it prescribes each party's obligations; the ICE generated by the contract-formation act." ;
                                           rdfs:label "Supplier Warranty Responsibility Agreement" ;
                                           skos:definition "A Directive Information Content Entity that prescribes the warranty obligations apportioned between an organization and its suppliers or dealers." ;
                                           skos:example "A signed supplier addendum specifying which warranty repairs the manufacturer reimburses." .


###  http://example.org/apqc#SupplyChainEffectivenessReview
ex:SupplyChainEffectivenessReview rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Minted: shared list has SupplyChainPerformanceData (input) but no effectiveness-review output. Descriptive (a judgement). Output of the 2.1.2.5.3 APPRAISAL act only; the sibling 2.1.2.5.4 analysis act now outputs the distinct ex:SupplyChainMethodologyAnalysis." ;
                                  rdfs:label "Supply Chain Effectiveness Review" ;
                                  skos:definition "A Descriptive Information Content Entity that describes a judgement of whether a supply chain and distribution network meets the demands of its stakeholders." .


###  http://example.org/apqc#SupplyChainManagementCapability
ex:SupplyChainManagementCapability rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000568 ;
                                   ex:enablesProcess ex:P10215 ,
                                                     ex:P10216 ,
                                                     ex:P10217 ,
                                                     ex:P10338 ,
                                                     ex:P10340 ,
                                                     ex:P10341 ,
                                                     ex:P20936 ;
                                   rdfs:comment "Top section-4.0 capability. The four group-level capabilities below specialize it; group modules may add 'realized in' restrictions to specific process classes (R6)." ;
                                   rdfs:label "Supply Chain Management Capability" ;
                                   skos:definition "An Organization Capability that is realized in the planning, procurement, production, and logistics acts by which an organization manages its supply chain for physical products." .


###  http://example.org/apqc#SupplyChainMethodologyAnalysis
ex:SupplyChainMethodologyAnalysis rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Gate-F mint: output of the 2.1.2.5.4 analysis act (ex:P19647). Distinct from ex:SupplyChainEffectivenessReview (the 2.1.2.5.3 appraisal verdict): the .4 source ('Collecting and examining raw data ... drawing conclusions ... Apply the information to make better business decisions') yields an analytic conclusion, not an effectiveness judgement. Previously both sibling acts shared the same effectiveness-review filler despite different act genera (Analysis vs Appraisal); giving .4 a distinct output resolves that inconsistent anchoring. Descriptive." ;
                                  rdfs:label "Supply Chain Methodology Analysis" ;
                                  skos:definition "A Descriptive Information Content Entity that describes a data-analytics conclusion correlating gaps and efficiencies across an organization's existing supply-chain methodologies." .


###  http://example.org/apqc#SupplyChainOrganization
ex:SupplyChainOrganization rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00001017 ,
                                           cco:ont00001180 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cco:ont00001954 ;
                                             owl:someValuesFrom ex:SupplyChainManagementCapability
                                           ] ;
                           rdfs:comment "The focal agent for section 4.0 standing functions (R5 capability bearers). Group modules attach Organization Capabilities to this class." ;
                           rdfs:label "Supply Chain Organization" ;
                           skos:definition "An Organization that has a supply-chain management capability realized in supply-chain planning, procurement, production, and logistics acts." .


###  http://example.org/apqc#SupplyChainPartner
ex:SupplyChainPartner rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00001180 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty obo:BFO_0000196 ;
                                        owl:someValuesFrom ex:SupplyChainPartnerRole
                                      ] ;
                      rdfs:comment "APQC 'suppliers, vendors, contractors, subcontractors, distribution partners'. Use cco:Agent for individual partners." ;
                      rdfs:label "Supply Chain Partner" ;
                      skos:definition "An Organization that bears a supply chain partner role in relation to a focal organization." .


###  http://example.org/apqc#SupplyChainPartnerRole
ex:SupplyChainPartnerRole rdf:type owl:Class ;
                          rdfs:subClassOf obo:BFO_0000023 ;
                          rdfs:comment "Covers APQC 'suppliers, vendors, contractors, subcontractors, distribution partners' (2.1.2.5.3, 2.3.1.14, 2.3.3.x)." ;
                          rdfs:label "Supply Chain Partner Role" ;
                          skos:definition "A Role that is borne by an Organization in virtue of supplying, distributing, or co-producing on behalf of a focal organization within its supply chain." .


###  http://example.org/apqc#SupplyChainPerformanceData
ex:SupplyChainPerformanceData rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Supply Chain Performance Data" ;
                              skos:definition "A Descriptive Information Content Entity that describes the performance and effectiveness of a supply chain and distribution network." .


###  http://example.org/apqc#SupplyChainPlanningCapability
ex:SupplyChainPlanningCapability rdf:type owl:Class ;
                                 rdfs:subClassOf ex:SupplyChainManagementCapability ;
                                 ex:enablesProcess ex:P10215 ;
                                 rdfs:label "Supply Chain Planning Capability" ;
                                 skos:definition "A Supply Chain Management Capability that is realized in acts of planning and aligning production, materials, demand, and distribution resources." .


###  http://example.org/apqc#SupplyConstraintAnalysis
ex:SupplyConstraintAnalysis rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Shared section-5.0 output (5.1.2.4). Descriptive: it identifies and characterises constraints." ;
                            rdfs:label "Supply Constraint Analysis" ;
                            skos:definition "A Descriptive Information Content Entity that describes the limitations imposed on an organization's service-delivery network and supply." .


###  http://example.org/apqc#SupplyCostEstimate
ex:SupplyCostEstimate rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Supply Cost Estimate" ;
                      skos:definition "A Descriptive Information Content Entity that describes the estimated overall cost of supplying products to market, including distribution and logistics costs." .


###  http://example.org/apqc#SupportModelSpecification
ex:SupportModelSpecification rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Output of 2.2.3.2 (define post launch support model)." ;
                             rdfs:label "Post-Launch Support Model Specification" ;
                             skos:definition "A Directive Information Content Entity that prescribes service-level agreements and service-level key performance indicators for post-launch support." .


###  http://example.org/apqc#SustainabilityGoalSpecification
ex:SustainabilityGoalSpecification rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000965 ;
                                   rdfs:label "Sustainability Goal Specification" ;
                                   skos:definition "A Directive Information Content Entity that prescribes an Organization's measurable sustainability goals and qualitative and quantitative targets." .


###  http://example.org/apqc#SustainabilityManagementCapability
ex:SustainabilityManagementCapability rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000568 ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:BFO_0000054 ;
                                                        owl:someValuesFrom ex:P21589
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:BFO_0000054 ;
                                                        owl:someValuesFrom ex:P21598
                                                      ] ;
                                      ex:enablesProcess ex:P21589 ,
                                                        ex:P21598 ;
                                      rdfs:comment "Standing-function reading of APQC 13.9 'Manage sustainability' (PCF 21588). Per R5 the 'Manage' group node is a standing function -> Organization Capability; the catalog node ex:PCF_21588 designates this capability. Its two bounded process children (ex:P21589 Develop sustainability capability, ex:P21598 Manage sustainability capability) are wired as obo:BFO_0000054 (realized in) fillers, mirroring the 13.1/13.5 capability pattern (previously a hollow stub with no realized-in restrictions). No ex:P21588 process is minted." ;
                                      rdfs:label "Sustainability Management Capability" ;
                                      skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop and manage its sustainability (ESG) practices, policies, requirements, and reporting, realized in its bounded sustainability acts." .


###  http://example.org/apqc#SustainabilityManagerRole
ex:SustainabilityManagerRole rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000984 ;
                             rdfs:comment "Minted for recurring APQC 13.9 participant." ;
                             rdfs:label "Sustainability Manager Role" ;
                             skos:definition "A Role that is borne by an Agent in virtue of being responsible for developing and managing an Organization's sustainability (ESG) capability, policies, and reporting." .


###  http://example.org/apqc#SustainabilityMeasureSpecification
ex:SustainabilityMeasureSpecification rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000965 ;
                                      rdfs:label "Sustainability Measure Specification" ;
                                      skos:definition "A Directive Information Content Entity that prescribes organization-wide sustainability measures, including data-collection strategies, calculations, analytics, and reporting formats." .


###  http://example.org/apqc#SustainabilityPerformanceMeasurement
ex:SustainabilityPerformanceMeasurement rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000853 ;
                                        rdfs:comment "Descriptive appraisal record. Output of ex:P21602 'Measure sustainability performance' (an Act of Appraisal) and has-input of ex:P21603." ;
                                        rdfs:label "Sustainability Performance Measurement" ;
                                        skos:definition "A Descriptive Information Content Entity that describes collected and validated sustainability performance data appraised against requirements and targets, including audit findings and identified gaps and variances." .


###  http://example.org/apqc#SustainabilityPlan
ex:SustainabilityPlan rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:label "Sustainability Plan" ;
                      skos:definition "A Directive Information Content Entity that prescribes the sustainability actions for an Organization, its functional units, and support services, aligned to requirements, goals, and governance." .


###  http://example.org/apqc#SustainabilityPolicy
ex:SustainabilityPolicy rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:label "Sustainability Policy" ;
                        skos:definition "A Directive Information Content Entity that prescribes the written procedures and supporting tools by which an Organization will meet its sustainability requirements." .


###  http://example.org/apqc#SustainabilityRequirementSpecification
ex:SustainabilityRequirementSpecification rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000965 ;
                                          rdfs:label "Sustainability Requirement Specification" ;
                                          skos:definition "A Directive Information Content Entity that prescribes the disclosure, governance, functional, and performance requirements an Organization must satisfy for sustainability (ESG)." .


###  http://example.org/apqc#SustainabilityStatement
ex:SustainabilityStatement rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:label "Sustainability Statement" ;
                           skos:definition "A Descriptive Information Content Entity that describes an Organization's sustainability performance prepared for reporting to its audiences." .


###  http://example.org/apqc#SystemSecurityRequirement
ex:SystemSecurityRequirement rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Local mint for 9.7.1.8. Directive because requirements prescribe what a system must satisfy." ;
                             rdfs:label "System Security Requirement" ;
                             skos:definition "A Directive Information Content Entity that prescribes requirements for controlling access, information reliability, accountability, and availability within an organization's treasury systems." .


###  http://example.org/apqc#SystemsAndTechnologyAnalysis
ex:SystemsAndTechnologyAnalysis rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:label "Systems and Technology Analysis" ;
                                skos:definition "A Descriptive Information Content Entity that describes the capabilities of technology and process-automation systems deployed within an organization." .


###  http://example.org/apqc#TalentAcquisitionCapability
ex:TalentAcquisitionCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ;
                               ex:enablesProcess ex:P10410 ;
                               rdfs:comment "For standing functions in group 7.2." ;
                               rdfs:label "Talent Acquisition Capability" ;
                               skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to recruit, source, screen, and select employees." .


###  http://example.org/apqc#TargetSegmentDefinition
ex:TargetSegmentDefinition rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Output of 3.1.2.2 and 3.3.4.3. Directive: selecting/committing to target segments prescribes a course of marketing action (Selection genus)." ;
                           rdfs:label "Target Segment Definition" ;
                           skos:definition "A Directive Information Content Entity that prescribes which customer segments the organization will target." .


###  http://example.org/apqc#TaxData
ex:TaxData rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00000853 ;
           rdfs:label "Tax Data" ;
           skos:definition "A Descriptive Information Content Entity that describes income, deductions, and liabilities relevant to an Organization's taxation." .


###  http://example.org/apqc#TaxInquiryResponse
ex:TaxInquiryResponse rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001808 ;
                                        owl:someValuesFrom ex:TaxData
                                      ] ;
                      rdfs:comment "Minted because no shared section-9.0 ICE denotes a response to an external tax inquiry; ex:TaxReturn (a filing) and ex:ComplianceReport (internal controls) do not fit. Descriptive (it represents/answers, not prescribes). Reuses verified cco:ont00000853 and cco:ont00001808 (is about)." ;
                      rdfs:label "Tax Inquiry Response" ;
                      skos:definition "A Descriptive Information Content Entity that describes the organization's answer to a tax query raised by a regulatory or government authority, drawing on historical taxation records." ;
                      skos:example "A written reply to a revenue authority's audit question, citing the relevant prior-year filings." .


###  http://example.org/apqc#TaxManagementCapability
ex:TaxManagementCapability rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000568 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty obo:BFO_0000054 ;
                                             owl:someValuesFrom ex:P10866
                                           ] ;
                           ex:enablesProcess ex:P10866 ;
                           rdfs:label "Tax Management Capability" ;
                           skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to estimate, plan, file, and pay its tax liabilities." .


###  http://example.org/apqc#TaxReturn
ex:TaxReturn rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000853 ;
             rdfs:label "Tax Return" ;
             skos:definition "A Descriptive Information Content Entity that reports an Organization's or individual's taxable income, deductions, and tax owed to a tax authority." .


###  http://example.org/apqc#TaxStrategy
ex:TaxStrategy rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ;
               rdfs:label "Tax Strategy" ;
               skos:definition "A Directive Information Content Entity that prescribes how an Organization will manage and minimize its tax liabilities." .


###  http://example.org/apqc#TechnicalAssessment
ex:TechnicalAssessment rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Output of 2.3.1.2 / revisited in 2.3.2.4." ;
                       rdfs:label "Technical Assessment" ;
                       skos:definition "A Descriptive Information Content Entity that describes a judgement of an organization's technical capacity and know-how to develop a product or service." .


###  http://example.org/apqc#TechnologyAssessment
ex:TechnologyAssessment rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Section-8.0 shared output. APQC 8.2.1.2 monitor/map technologies, 8.2.7.2 analyze emerging concepts, 8.5.2.1 track capabilities, 8.7.2.6 support tools. Descriptive. (Mirrors the reference-module ex:TechnologyAssessment of slice 1.1.1; kept identically labeled and defined for cross-section consistency.)" ;
                        rdfs:label "Technology Assessment" ;
                        skos:definition "A Descriptive Information Content Entity that describes a judgement of current, emerging, and disruptive technologies relevant to an organization's IT vision and capabilities." ,
                                        "A Descriptive Information Content Entity that describes a judgement of current, emerging, and disruptive technologies." .


###  http://example.org/apqc#TechnologyData
ex:TechnologyData rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Reused naming from the reference module; minted here for section 2.0." ;
                  rdfs:label "Technology Data" ;
                  skos:definition "A Descriptive Information Content Entity that describes deployed, emerging, and disruptive technologies relevant to product/service development." ,
                                  "A Descriptive Information Content Entity that describes deployed, emerging, and disruptive technologies." .


###  http://example.org/apqc#ThirdPartyLogisticsPerformanceReport
ex:ThirdPartyLogisticsPerformanceReport rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000853 ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty cco:ont00001808 ;
                                                          owl:someValuesFrom ex:ThirdPartyLogisticsProvider
                                                        ] ;
                                        rdfs:label "Third-Party Logistics Performance Report" ;
                                        skos:definition "A Descriptive Information Content Entity that describes the storage and shipping performance of third-party logistics providers." .


###  http://example.org/apqc#ThirdPartyLogisticsProvider
ex:ThirdPartyLogisticsProvider rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00001180 ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000196 ;
                                                 owl:someValuesFrom ex:LogisticsServiceProviderRole
                                               ] ;
                               rdfs:label "Third-Party Logistics Provider" ;
                               skos:definition "An Organization that bears a logistics service provider role, performing outsourced storage, shipping, or transportation activities on behalf of another organization." .


###  http://example.org/apqc#TimeAndAttendanceManagementCapability
ex:TimeAndAttendanceManagementCapability rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000568 ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:ActOfAdministration
                                                         ] ;
                                         ex:enablesProcess ex:ActOfAdministration ;
                                         rdfs:comment "R5/R6: APQC 7.7.6 (PCF 10527) 'Develop and manage time and attendance systems' is a standing system-administration function with no natural end, so it is modeled as an Organization Capability rather than a process. Realized in Acts of Administration." ;
                                         rdfs:label "Time and Attendance Management Capability" ;
                                         skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop and maintain the systems that track employee time and attendance, realized in repeated acts of time-and-attendance system administration." .


###  http://example.org/apqc#TimeRecord
ex:TimeRecord rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000853 ;
              rdfs:label "Employee Time Record" ;
              skos:definition "A Descriptive Information Content Entity that describes the working days, hours, billing hours, and leave of an employee over a reporting period." ;
              skos:example "A weekly timesheet capturing each employee's hours and billable time." .


###  http://example.org/apqc#TraceabilityData
ex:TraceabilityData rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Minted: traceability record not in shared list. Descriptive." ;
                    rdfs:label "Traceability Data" ;
                    skos:definition "A Descriptive Information Content Entity that describes the genealogy and access history of product/material data accessible only via permitted touch points." .


###  http://example.org/apqc#TradeDocumentation
ex:TradeDocumentation rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Output of 9.11 document-trade processes." ;
                      rdfs:label "Trade Documentation" ;
                      skos:definition "A Descriptive Information Content Entity that records the description, quantity, transport, indemnity, and inspection details of an international-trade transaction." .


###  http://example.org/apqc#TradeMarketingCalendar
ex:TradeMarketingCalendar rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Minted (Gate-F) for 3.4.2.10 (P11522 output) and 3.4.2.12 (P11468 input). Distinct from ex:CommunicationCalendar, whose definition denotes marketing-MESSAGE-delivery scheduling, not a trade/promotion EVENT timetable; reusing that ICE here was a subject-matter mismatch (D5). Directive: a schedule prescribes when to act." ;
                          rdfs:label "Trade Marketing Calendar" ;
                          skos:definition "A Directive Information Content Entity that prescribes the timing of promotional, category-management, and trade-marketing events combined into a unified timetable." .


###  http://example.org/apqc#TradeOrIndustryGroup
ex:TradeOrIndustryGroup rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00001180 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:BFO_0000196 ;
                                          owl:someValuesFrom ex:TradeOrIndustryGroupRole
                                        ] ;
                        rdfs:comment "Minted for 12.2.3." ;
                        rdfs:label "Trade or Industry Group" ;
                        skos:definition "An Organization that bears a trade-or-industry-group role in virtue of being established and financed by businesses operating in a specific industry." .


###  http://example.org/apqc#TradeOrIndustryGroupRole
ex:TradeOrIndustryGroupRole rdf:type owl:Class ;
                            rdfs:subClassOf obo:BFO_0000023 ;
                            rdfs:label "Trade or Industry Group Role" ;
                            skos:definition "A Role that is borne by an Organization in virtue of being established and financed by businesses operating in a specific industry." .


###  http://example.org/apqc#TradePreferenceDocumentation
ex:TradePreferenceDocumentation rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Minted for group 9.11. Output of 9.11.8. Descriptive (it evidences eligibility); the preferential-rate entitlement it records derives from external trade agreements, not from this artifact prescribing conduct." ;
                                rdfs:label "Trade Preference Documentation" ;
                                skos:definition "A Descriptive Information Content Entity that describes a shipment's eligibility for trade under preference, by which products may be imported or exported at a lower or nil rate of customs duty or levy." ;
                                skos:example "A certificate of origin claiming preferential tariff treatment under a free-trade agreement." .


###  http://example.org/apqc#TraineeRole
ex:TraineeRole rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000023 ;
               rdfs:comment "Minted for the training-recipient participant of EHS training (13.8.3.5). Distinct from ex:StakeholderRole (an interested/affected party): a trainee is the recipient of the imparted competence." ;
               rdfs:label "Trainee Role" ;
               skos:definition "A Role that is borne by an Agent in virtue of being a recipient of training -- the Agent to whom knowledge, skills, or values are imparted by an Act of Training." .


###  http://example.org/apqc#TrainerRole
ex:TrainerRole rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000984 ;
               rdfs:comment "Shared section-5.0 role for the training processes (5.2.3.4, 5.2.3.5)." ;
               rdfs:label "Trainer Role" ;
               skos:definition "A Role that is borne by an Agent in virtue of being tasked with imparting service-delivery skills or behaviours to other Agents." .


###  http://example.org/apqc#TrainingEffectivenessEvaluation
ex:TrainingEffectivenessEvaluation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000853 ;
                                   rdfs:comment "Shared section-5.0 output (5.2.3.6, 5.2.3.7). Descriptive: it reports an evaluation judgement." ;
                                   rdfs:label "Training Effectiveness Evaluation" ;
                                   skos:definition "A Descriptive Information Content Entity that describes a judgement of how effectively delivered training imparted the targeted skills or behaviours." .


###  http://example.org/apqc#TrainingFeedback
ex:TrainingFeedback rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Minted locally (Gate-F fix, 5.2.3.7): input to ex:P12135. Distinct from ex:CustomerFeedback (a CUSTOMER's evaluation of SERVICES RENDERED). The APQC source for 12135 specifies 'manager or student feedback ... to evaluate training effectiveness' -- i.e. trainee/manager feedback ABOUT TRAINING, not customer feedback about delivered services; reusing ex:CustomerFeedback here was a definitional category error. Descriptive: it reports an evaluation." ;
                    rdfs:label "Training Feedback" ;
                    skos:definition "A Descriptive Information Content Entity that describes a manager's or trainee's evaluation of training that has been provided, solicited to gauge its effectiveness." ;
                    skos:example "A post-course survey in which a line manager rates how well a trainee can now perform the taught task." .


###  http://example.org/apqc#TrainingMaterial
ex:TrainingMaterial rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000253 ;
                    rdfs:comment "Shared section-5.0 output (5.2.3.2). Re-anchored to cco:ont00000253 (Information Bearing Entity) -- the right mid-level for a material/digital bearer of training content -- which is still a material entity (IBE subClassOf Object subClassOf Material Entity), so the material-I/O usage holds. Non-informational training equipment, if needed, would be a separate class." ;
                    rdfs:label "Training Material" ;
                    skos:definition "An Information Bearing Entity (manual, slide deck, e-learning file, workbook, CBT module) produced to support the comprehensive training of personnel in skills or behaviours needed to deliver services." .


###  http://example.org/apqc#TrainingMaterialSpecification
ex:TrainingMaterialSpecification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Shared section-5.0 output (5.2.3.2). Despite the 'Specification' label this is DESCRIPTIVE (D6 false-friend guard): it records the content and structure of produced training materials, not a prescriptive requirement. A prescriptive training-material requirement would be a Directive ICE, modeled separately. The informational deliverable of training-material development (every has-output is an ICE, D3/S3); the produced ex:TrainingMaterial bearer is consumed downstream as an input." ;
                                 rdfs:label "Training Material Specification" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the content and structure of the training materials developed to teach service-delivery skills or behaviours." .


###  http://example.org/apqc#TrainingPlan
ex:TrainingPlan rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:comment "Shared across 13.2.3.3.4, 13.4.2.3, 13.5.1.7." ,
                             "Shared section-5.0 output (5.2.3.1). Directive: a training plan prescribes how training is to be conducted." ;
                rdfs:label "Training Plan" ;
                skos:definition "A Directive Information Content Entity that prescribes the actions for equipping personnel with the skills and abilities to fulfill their roles." ,
                                "A Directive Information Content Entity that prescribes the actions, timing, locations, and instructors for teaching service-delivery personnel a skill or behaviour." .


###  http://example.org/apqc#TrainingProgramSpecification
ex:TrainingProgramSpecification rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:label "Training Program Specification" ;
                                skos:definition "A Directive Information Content Entity that prescribes the content, format, and delivery of an employee or management training program." .


###  http://example.org/apqc#TrainingSchedule
ex:TrainingSchedule rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Minted locally (5.2.3.3): a schedule prescribes (Directive) when/where training occurs; no shared-vocab ICE covers it." ;
                    rdfs:label "Training Schedule" ;
                    skos:definition "A Directive Information Content Entity that prescribes the times, places, and sequence in which training sessions are to be delivered to trainees." ;
                    skos:example "A calendar prescribing which cohorts attend which training modules over a quarter." .


###  http://example.org/apqc#TransactionRecord
ex:TransactionRecord rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:label "Transaction Record" ;
                     skos:definition "A Descriptive Information Content Entity that registers an individual financial transaction together with its amount, date, and parties." .


###  http://example.org/apqc#TransportationVehicle
ex:TransportationVehicle rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000713 ;
                         rdfs:label "Transportation Vehicle" ;
                         skos:definition "A Vehicle used to convey inbound or outbound products between supply-chain locations." .


###  http://example.org/apqc#Treasurer
ex:Treasurer rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00001017 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty obo:BFO_0000196 ;
                               owl:someValuesFrom ex:TreasurerRole
                             ] ;
             rdfs:label "Treasurer" ;
             skos:definition "An Agent that bears a treasurer role and manages an Organization's cash, liquidity, debt, investments, and financial risk." .


###  http://example.org/apqc#TreasurerRole
ex:TreasurerRole rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000984 ;
                 rdfs:label "Treasurer Role" ;
                 skos:definition "A Role that is borne by an Agent in virtue of being tasked with managing an Organization's cash, liquidity, debt, investments, and financial risk." .


###  http://example.org/apqc#TreasuryGovernanceCharter
ex:TreasuryGovernanceCharter rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Local mint for 9.7.1.1; no fitting class in the shared section vocabulary. Directive because it prescribes scope and authority rather than describing them." ;
                             rdfs:label "Treasury Governance Charter" ;
                             skos:definition "A Directive Information Content Entity that prescribes the scope of treasury operations and designates the authoritative body governing investment decisions." .


###  http://example.org/apqc#TreasuryManagementCapability
ex:TreasuryManagementCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ;
                                ex:enablesProcess ex:P10885 ,
                                                  ex:P10893 ,
                                                  ex:P12974 ,
                                                  ex:P14079 ;
                                rdfs:label "Treasury Management Capability" ;
                                skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to manage cash, liquidity, debt, investments, and financial risk." .


###  http://example.org/apqc#TrialBalance
ex:TrialBalance rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Minted for ex:P10826 ('Prepare trial balance'). A trial balance is a distinct derived statement, not the general ledger from which it is computed; modeling its output as ex:GeneralLedger asserted a falsehood about the definitional artifact." ;
                rdfs:label "Trial Balance" ;
                skos:definition "A Descriptive Information Content Entity that lists the debit and credit balances of all ledger accounts to verify that total debits equal total credits." .


###  http://example.org/apqc#TroubleshootingMethodologyReview
ex:TroubleshootingMethodologyReview rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:comment "Minted: output of 2.3.1.8.4; not in shared list. Descriptive." ;
                                    rdfs:label "Troubleshooting Methodology Review" ;
                                    skos:definition "A Descriptive Information Content Entity that records an appraisal of the design and approach for troubleshooting a product." .


###  http://example.org/apqc#UnconstrainedMaterialsPlan
ex:UnconstrainedMaterialsPlan rdf:type owl:Class ;
                              rdfs:subClassOf ex:MaterialsPlan ;
                              rdfs:label "Unconstrained Materials Plan" ;
                              skos:definition "A Materials Plan that prescribes raw-material and inventory provision to meet market demand without yet accounting for supply-chain constraints." .


###  http://example.org/apqc#UnderservedSegmentFinding
ex:UnderservedSegmentFinding rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Output of 3.1.2.2.1 (PCF 18941). Descriptive because it registers a state of affairs rather than prescribing action." ;
                             rdfs:label "Under-served and Saturated Segment Finding" ;
                             skos:definition "A Descriptive Information Content Entity that describes which market segments lack access to (under-served) or already have access to (saturated) an organization's offerings." .


###  http://example.org/apqc#UsefulLifeAssessment
ex:UsefulLifeAssessment rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cco:ont00001808 ;
                                          owl:someValuesFrom ex:ProductiveAsset
                                        ] ;
                        rdfs:label "Useful Life Assessment" ;
                        skos:definition "A Descriptive Information Content Entity, about an asset, that describes the asset's status against its planned useful life using criteria such as age, maintenance history, and capacity." .


###  http://example.org/apqc#UserExperienceDesignSpecification
ex:UserExperienceDesignSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty cco:ont00001808 ;
                                                       owl:someValuesFrom ex:ProductServiceOffering
                                                     ] ;
                                     rdfs:comment "Minted: output of 2.3.1.4; not in shared list. Directive, is about the offering." ;
                                     rdfs:label "User Experience Design Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes the usability and user-experience characteristics of a product or service offering." .


###  http://example.org/apqc#UserTestingPlan
ex:UserTestingPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "8.6.2.4 output. Directive because a plan prescribes a course of action." ;
                   rdfs:label "User Testing Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes the methodologies, resources, and sequence for user testing of an IT deployment." .


###  http://example.org/apqc#ValidatedRequirementAssessment
ex:ValidatedRequirementAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Minted (D5) as the descriptive output of Determine finished goods inventory requirements at destination [10253], whose source is purely a validation/communication-confirmation act. Descriptive because it represents a confirmation of existing requirements rather than composing a new prescriptive plan. Distinct from ex:LogisticsRequirementSpecification (the Directive requirements artifact that this act confirms, not authors)." ;
                                  rdfs:label "Validated Requirement Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the confirmation, obtained by interacting with the concerned party at a destination, that the stated finished-goods inventory requirements at that destination are correct and free of miscommunication." ;
                                  skos:example "A planner's confirmation note that the regional DC manager has agreed the stated stocking requirement is correct." .


###  http://example.org/apqc#ValueProposition
ex:ValueProposition rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 3.2.1 and 3.2.1.1/.2. Directive: a value proposition commits the organization to a positioning (Formulation genus)." ;
                    rdfs:label "Customer Value Proposition" ;
                    skos:definition "A Directive Information Content Entity that prescribes the suite of benefits an organization's offering delivers to a customer and how it is positioned." .


###  http://example.org/apqc#ValuePropositionValidation
ex:ValuePropositionValidation rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "Output of 3.2.1.3. Descriptive (not Directive): it reports a validation judgement gathered from customer feedback. Distinct from ex:OpportunityValidation (about market opportunities)." ;
                              rdfs:label "Value Proposition Validation Result" ;
                              skos:definition "A Descriptive Information Content Entity that records the substantiated desirability and benefits of an offering's value proposition as corroborated against a target customer segment." .


###  http://example.org/apqc#VarianceAnalysis
ex:VarianceAnalysis rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:label "Variance Analysis" ;
                    skos:definition "A Descriptive Information Content Entity that describes the differences between budgeted or forecasted figures and actual financial results." .


###  http://example.org/apqc#VendorMasterFile
ex:VendorMasterFile rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cco:ont00001808 ;
                                      owl:someValuesFrom ex:Supplier
                                    ] ;
                    rdfs:comment "Minted locally for 9.6: no shared-vocab ICE covers the supplier/vendor account register used in AP verification (shared ex:CustomerMasterFile is the customer-side analogue). Is about a Supplier (cco:ont00001808)." ;
                    rdfs:label "Vendor Master File" ;
                    skos:definition "A Descriptive Information Content Entity that records the account particulars of an organization's suppliers, against which accounts-payable entries are matched." .


###  http://example.org/apqc#Warehouse
ex:Warehouse rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000192 ;
             rdfs:label "Warehouse" ;
             skos:definition "A Facility designed for the storage, handling, and movement of inventory and finished goods." .


###  http://example.org/apqc#WarrantyAdministratorRole
ex:WarrantyAdministratorRole rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000984 ;
                             rdfs:label "Warranty Administrator Role" ;
                             skos:definition "A Role that is borne by an Agent in virtue of being tasked with receiving, validating, investigating, and dispositioning warranty claims on behalf of an organization." .


###  http://example.org/apqc#WarrantyClaim
ex:WarrantyClaim rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Central informational object processed throughout 6.3.2. Modeled as Descriptive (it asserts a state of affairs / fault), not Directive." ;
                 rdfs:label "Warranty Claim" ;
                 skos:definition "A Descriptive Information Content Entity submitted by an originator that asserts a product fault and requests remedy under the terms of a warranty." .


###  http://example.org/apqc#WarrantyClaimCode
ex:WarrantyClaimCode rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output of 6.1.6.2; reused as input to claim definition/validation (6.3.2)." ;
                     rdfs:label "Warranty Claim Code" ;
                     skos:definition "A Directive Information Content Entity that prescribes the rules for processing and routing warranty claims, including coverage lists, fault and trouble codes, and repair-time setups." .


###  http://example.org/apqc#WarrantyClaimDefinition
ex:WarrantyClaimDefinition rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Minted: verbatim output of PCF 20089 'Define warranty claims'. Directive because it sets governing terms/conditions. Distinct from ex:WarrantyClaim (an input claim) and ex:WarrantyPolicy (customer-facing assurance)." ;
                           rdfs:label "Warranty Claim Definition" ;
                           skos:definition "A Directive Information Content Entity that prescribes the exact terms and conditions under which specific warranties apply to certain goods or services." ;
                           skos:example "A warranty-terms schedule listing covered defects, time windows, and product lines." .


###  http://example.org/apqc#WarrantyClaimValidation
ex:WarrantyClaimValidation rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Minted: output of P12671 (validate warranty claim) and input to P12668 (approve/reject). Descriptive: it represents a finding rather than prescribing action. Distinct from ex:ClaimDisposition (the final approve/reject directive)." ;
                           rdfs:label "Warranty Claim Validation" ;
                           skos:definition "A Descriptive Information Content Entity that records the judgement of whether a warranty claim falls within the parameters of the applicable warranty." .


###  http://example.org/apqc#WarrantyIssueDefinition
ex:WarrantyIssueDefinition rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cco:ont00001808 ;
                                             owl:someValuesFrom ex:WarrantyClaim
                                           ] ;
                           rdfs:comment "Output of 6.3.2.3.1 (Define issue)." ;
                           rdfs:label "Warranty Issue Definition" ;
                           skos:definition "A Descriptive Information Content Entity that describes the issue underlying a warranty claim, established by reference to claim codes and collected evidence." .


###  http://example.org/apqc#WarrantyManagementCapability
ex:WarrantyManagementCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ;
                                ex:enablesProcess ex:P12669 ,
                                                  ex:P12672 ;
                                rdfs:comment "Target for R5 'Manage warranty ...' standing functions (group 6.3 / 6.5.4)." ;
                                rdfs:label "Warranty Management Capability" ;
                                skos:definition "An Organization Capability that is realized in the acts by which an organization defines, processes, and evaluates product warranties and warranty claims." .


###  http://example.org/apqc#WarrantyOffering
ex:WarrantyOffering rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Minted: the warranty offering communicated to customers in PCF 20091. Directive because it specifies warranty terms extended to customers. Per Gate-F, P20091 is an Act of Communication that conveys this offering (has input), not an act that composes it (has output)." ;
                    rdfs:label "Warranty Offering" ;
                    skos:definition "A Directive Information Content Entity that specifies the warranties offered to customers for promoted products or services." ;
                    skos:example "A product page listing a 2-year limited warranty bundled with a promoted appliance." .


###  http://example.org/apqc#WarrantyPerformanceReport
ex:WarrantyPerformanceReport rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Output of 6.5.4 and 6.5.4.2 (Monitor and report on warranty management metrics)." ;
                             rdfs:label "Warranty Performance Report" ;
                             skos:definition "A Descriptive Information Content Entity that describes warranty management metrics and the conclusions drawn from comparing warranties." .


###  http://example.org/apqc#WarrantyPolicy
ex:WarrantyPolicy rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cco:ont00001808 ;
                                    owl:someValuesFrom ex:DefectiveProduct
                                  ] ;
                  rdfs:comment "Directive (prescribes obligations). Output of 6.1.6.1 (Determine and document warranty policies); reused as input wherever claims are validated against warranty parameters (6.3.2.2)." ;
                  rdfs:label "Warranty Policy" ;
                  skos:definition "A Directive Information Content Entity that prescribes the terms and conditions under which an organization will guarantee, repair, or replace its goods or services." .


###  http://example.org/apqc#WarrantyRecommendation
ex:WarrantyRecommendation rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Output of 2.3.1.5." ;
                          rdfs:label "Warranty Recommendation" ;
                          skos:definition "A Directive Information Content Entity that prescribes a recommended warranty plan and pricing for a product or service." .


###  http://example.org/apqc#WarrantyTeam
ex:WarrantyTeam rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001017 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000196 ;
                                  owl:someValuesFrom ex:WarrantyAdministratorRole
                                ] ;
                rdfs:comment "Minted. Named as the actor in 6.3.2 (Process warranty claims) and its tasks. Genus Agent to admit both individual administrators and warranty teams." ;
                rdfs:label "Warranty Team" ;
                skos:definition "An Agent that bears a warranty-administrator role, by which it receives, validates, investigates, and dispositions warranty claims on behalf of an organization." .


###  http://example.org/apqc#WarrantyTransactionReconciliation
ex:WarrantyTransactionReconciliation rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000853 ;
                                     rdfs:comment "Minted: output of P12667 (reconcile warranty transaction). Descriptive judgement of completion." ;
                                     rdfs:label "Warranty Transaction Reconciliation" ;
                                     skos:definition "A Descriptive Information Content Entity that records confirmation that a warranty transaction has been completed and is internally consistent." .


###  http://example.org/apqc#WasteMaterial
ex:WasteMaterial rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000980 ;
                 rdfs:comment "Reuses CCO Portion of Waste Material (ont00000980), verified: 'serves no further use ... such that the Agent wants to dispose of it.'" ;
                 rdfs:label "Waste Material" ;
                 skos:definition "A Portion of Waste Material that arises from asset end-of-life activities and is subject to disposition, disposal, or reprocessing under regulatory requirements." .


###  http://example.org/apqc#WorkAndAssetRecord
ex:WorkAndAssetRecord rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001808 ;
                                        owl:someValuesFrom ex:ProductiveAsset
                                      ] ;
                      rdfs:comment "Shared record across 10.2.4.3 (create) and 10.3.2.4 (update). Descriptive: a record of past events." ;
                      rdfs:label "Work and Asset Record" ;
                      skos:definition "A Descriptive Information Content Entity, about an asset, that records the construction or maintenance work performed on it, the assets serviced, and any issues that arose." .


###  http://example.org/apqc#WorkPerformanceReport
ex:WorkPerformanceReport rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Shared monitoring output across 10.2 and 10.3." ;
                         rdfs:label "Work Performance Report" ;
                         skos:definition "A Descriptive Information Content Entity that describes the observed timeliness, regulatory compliance, and quality of construction or maintenance work." .


###  http://example.org/apqc#WorkPlan
ex:WorkPlan rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000965 ;
            rdfs:label "Work Plan" ;
            skos:definition "A Directive Information Content Entity that prescribes the procedures by which productive assets are to be maintained." .


###  http://example.org/apqc#WorkProductDeliverable
ex:WorkProductDeliverable rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Minted for 12.4.5.4: no other shared-vocab ICE captures counsel deliverables together with committed-effort records used to confirm fees. Genus Descriptive ICE because it records what was delivered/performed. Used ONLY as the has-input (received deliverable) of 12.4.5.4; the validated effort/fee record that act produces is the distinct ex:WorkProductValidationRecord." ;
                          rdfs:label "Work Product Deliverable" ;
                          skos:definition "A Descriptive Information Content Entity that records a deliverable produced by engaged outside counsel and the effort committed to a matter." ;
                          skos:example "A memorandum and timesheet delivered by outside counsel on a litigation matter." .


###  http://example.org/apqc#WorkProductValidationRecord
ex:WorkProductValidationRecord rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Minted for 12.4.5.4 (P11059) as the definitional OUTPUT of the monitoring act, distinct from its has-input ex:WorkProductDeliverable (the raw received deliverable). Separating input and output ICEs corrects the Gate-F finding that the same class was asserted as both has-input and has-output (a vacuous distinction / thin-class over-commitment)." ;
                               rdfs:label "Work Product Validation Record" ;
                               skos:definition "A Descriptive Information Content Entity that records the validated work product and verified committed effort of engaged outside counsel, used to confirm the fees due." ;
                               skos:example "A signed-off matter ledger confirming the briefs filed and billable hours verified before fee approval." .


###  http://example.org/apqc#WorkRequirementsSpecification
ex:WorkRequirementsSpecification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Output of 12.4.5.1 (Assess problem and determine work requirements) and 12.2.3.1 (Evaluate the requirements for strategic relationships). Directive: it specifies required actions." ;
                                 rdfs:label "Work Requirements Specification" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the tasks and action requirements for engaging outside counsel on a legal problem, or for entering into a strategic relationship." .


###  http://example.org/apqc#WorkTaskList
ex:WorkTaskList rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:comment "Directive: a prioritized task list prescribes the acts to be performed and their ordering." ;
                rdfs:label "Work Task List" ;
                skos:definition "A Directive Information Content Entity that prescribes the prioritized set of tasks required to complete asset-maintenance work." .


###  http://example.org/apqc#WorkforceAnalysis
ex:WorkforceAnalysis rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cco:ont00001808 ;
                                       owl:someValuesFrom ex:Employee
                                     ] ;
                     rdfs:comment "Output of the workforce-analytics acts in group 7.7; about the workforce (Employees)." ;
                     rdfs:label "Workforce Analysis" ;
                     skos:definition "A Descriptive Information Content Entity that describes insights derived from analyzing workforce data in support of organizational requirements." .


###  http://example.org/apqc#WorkforceAnalysisMethodology
ex:WorkforceAnalysisMethodology rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:label "Workforce Analysis Methodology" ;
                                skos:definition "A Directive Information Content Entity that prescribes the research methodology selected for conducting workforce analytics." .


###  http://example.org/apqc#WorkforceAnalyticsCapability
ex:WorkforceAnalyticsCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P21441
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P21447
                                                ] ;
                                ex:enablesProcess ex:P21441 ,
                                                  ex:P21447 ;
                                rdfs:comment "For standing functions in group 7.7." ;
                                rdfs:label "Workforce Analytics Capability" ;
                                skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to manage employee information, metrics, systems, and analytics in support of decision-making." .


###  http://example.org/apqc#WorkforceData
ex:WorkforceData rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:label "Workforce Data" ;
                 skos:definition "A Descriptive Information Content Entity that describes the size, composition, capabilities, and characteristics of an organization's workforce." .


###  http://example.org/apqc#WorkforceDeploymentCapability
ex:WorkforceDeploymentCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ;
                                 ex:enablesProcess ex:P10413 ;
                                 rdfs:comment "For standing functions in group 7.6." ;
                                 rdfs:label "Workforce Deployment Capability" ;
                                 skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to redeploy, schedule, relocate, separate, and retire its employees." .


###  http://example.org/apqc#WorkforceDevelopmentNeedsAlignment
ex:WorkforceDevelopmentNeedsAlignment rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000853 ;
                                      rdfs:comment "Minted locally (group 7.3, used by P10490). Descriptive: it represents the reconciled needs picture; the prescriptive programs that act on it are separate Directive ICEs." ;
                                      rdfs:label "Workforce Development Needs Alignment" ;
                                      skos:definition "A Descriptive Information Content Entity that describes the correspondence between individual employee development needs and the development needs of the organization." ;
                                      skos:example "A matrix mapping each role's growth needs to organizational capability gaps." .


###  http://example.org/apqc#WorkforcePlan
ex:WorkforcePlan rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:label "Workforce Plan" ;
                 skos:definition "A Directive Information Content Entity that prescribes the current and future workforce and skill requirements of an organization or its units." .


###  http://example.org/apqc#WorkforcePlanningCapability
ex:WorkforcePlanningCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ;
                               ex:enablesProcess ex:P10417 ,
                                                 ex:P17045 ,
                                                 ex:P17046 ,
                                                 ex:P20958 ;
                               rdfs:comment "For standing functions in group 7.1." ;
                               rdfs:label "Workforce Planning Capability" ;
                               skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to plan, develop, and maintain its workforce strategy, plans, and policies." .


###  http://example.org/apqc#WorkforceSchedule
ex:WorkforceSchedule rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output of 6.2.1.2 (Schedule customer service work force) and 6.3.2.3.2 (Schedule field service). Directive -> producing act is Scheduling (proposed genus)." ;
                     rdfs:label "Workforce Schedule" ;
                     skos:definition "A Directive Information Content Entity that prescribes the deployment of the customer service work force across operations and time." .


###  http://example.org/apqc#WorkforceStrategy
ex:WorkforceStrategy rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:label "Workforce Strategy" ;
                     skos:definition "A Directive Information Content Entity that prescribes an organization's approach to administering, resourcing, and developing its workforce." .


###  http://example.org/apqc#WorkforceStrategyModel
ex:WorkforceStrategyModel rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:label "Workforce Strategy Model" ;
                          skos:definition "A Directive Information Content Entity that prescribes an organization's overall approach to maximizing workforce performance by defining workforce goals, objectives, and expectations." .


###  http://example.org/apqc#WorkforceUtilizationReport
ex:WorkforceUtilizationReport rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "Output of 6.2.1.3 (Track work force utilization)." ;
                              rdfs:label "Workforce Utilization Report" ;
                              skos:definition "A Descriptive Information Content Entity that describes the utilization, performance, and quality of the deployed customer service work force." .


###  http://example.org/apqc#WorkplaceLayoutPlan
ex:WorkplaceLayoutPlan rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Shared section-5.0 output (5.1.2.7). Directive: a layout plan prescribes an intended arrangement." ;
                       rdfs:label "Workplace Layout Plan" ;
                       skos:definition "A Directive Information Content Entity that prescribes the physical layout and infrastructure of a workplace to support service delivery." .


###  http://example.org/apqc#Workspace
ex:Workspace rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000192 ;
             rdfs:comment "Subject of acquire/change-fit-form-function activities in 10.1.3." ;
             rdfs:label "Workspace" ;
             skos:definition "A Facility, together with its supporting assets such as furniture and equipment, provided to occupants to perform work." .


###  http://purl.obolibrary.org/obo/BFO_0000001
obo:BFO_0000001 rdf:type owl:Class ;
                rdfs:subClassOf owl:Thing ;
                <http://purl.org/dc/elements/1.1/identifier> "001-BFO" ;
                rdfs:label "entity"@en ;
                skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en ;
                skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en .


###  http://purl.obolibrary.org/obo/BFO_0000002
obo:BFO_0000002 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000001 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:allValuesFrom obo:BFO_0000002
                                ] ;
                owl:disjointWith obo:BFO_0000003 ;
                <http://purl.org/dc/elements/1.1/identifier> "008-BFO" ;
                rdfs:label "continuant"@en ;
                skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en ;
                skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en .


###  http://purl.obolibrary.org/obo/BFO_0000003
obo:BFO_0000003 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000001 ;
                <http://purl.org/dc/elements/1.1/identifier> "077-BFO" ;
                rdfs:label "occurrent"@en ;
                skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en ;
                skos:example "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en .


###  http://purl.obolibrary.org/obo/BFO_0000004
obo:BFO_0000004 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:allValuesFrom obo:BFO_0000004
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "017-BFO" ;
                rdfs:label "independent continuant"@en ;
                skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en ;
                skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en .


###  http://purl.obolibrary.org/obo/BFO_0000006
obo:BFO_0000006 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000141 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:allValuesFrom obo:BFO_0000006
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "035-BFO" ;
                rdfs:label "spatial region"@en ;
                skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en ;
                skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en .


###  http://purl.obolibrary.org/obo/BFO_0000008
obo:BFO_0000008 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:allValuesFrom obo:BFO_0000008
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000139 ;
                                  owl:allValuesFrom obo:BFO_0000008
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "100-BFO" ;
                rdfs:label "temporal region"@en ;
                skos:definition "(Elucidation) A temporal region is an occurrent over which processes can unfold"@en ;
                skos:example "As for zero-dimensional temporal region and one-dimensional temporal region"@en .


###  http://purl.obolibrary.org/obo/BFO_0000009
obo:BFO_0000009 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000006 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000009
                                                                    obo:BFO_0000018
                                                                    obo:BFO_0000026
                                                                  )
                                                    ]
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "039-BFO" ;
                rdfs:label "two-dimensional spatial region"@en ;
                skos:definition "(Elucidation) A two-dimensional spatial region is a spatial region that is a whole consisting of a surface together with zero or more surfaces which may have spatial regions of lower dimension as parts"@en ;
                skos:example "The surface of a sphere-shaped part of space; an infinitely thin plane in space"@en .


###  http://purl.obolibrary.org/obo/BFO_0000011
obo:BFO_0000011 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:allValuesFrom obo:BFO_0000011
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000139 ;
                                  owl:allValuesFrom obo:BFO_0000011
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "095-BFO" ;
                rdfs:label "spatiotemporal region"@en ;
                skos:definition "(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime"@en ;
                skos:example "The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite"@en ;
                skos:scopeNote "'Spacetime' here refers to the maximal instance of the universal spatiotemporal region."@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
obo:BFO_0000015 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000117 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000015
                                                                    obo:BFO_0000035
                                                                  )
                                                    ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:allValuesFrom obo:BFO_0000015
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000139 ;
                                  owl:allValuesFrom obo:BFO_0000015
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "083-BFO" ;
                rdfs:label "process"@en ;
                skos:altLabel "event"@en ;
                skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
                skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en .


###  http://purl.obolibrary.org/obo/BFO_0000016
obo:BFO_0000016 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                owl:disjointWith obo:BFO_0000023 ;
                <http://purl.org/dc/elements/1.1/identifier> "062-BFO" ;
                rdfs:label "disposition"@en ;
                skos:altLabel "internally-grounded realizable entity"@en ;
                skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en ;
                skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en .


###  http://purl.obolibrary.org/obo/BFO_0000017
obo:BFO_0000017 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                owl:disjointWith obo:BFO_0000019 ;
                <http://purl.org/dc/elements/1.1/identifier> "058-BFO" ;
                rdfs:label "realizable entity"@en ;
                skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en ;
                skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000018
obo:BFO_0000018 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000006 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom obo:BFO_0000018
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "037-BFO" ;
                rdfs:label "zero-dimensional spatial region"@en ;
                skos:definition "(Elucidation) A zero-dimensional spatial region is one or a collection of more than one spatially disjoint points in space"@en ;
                skos:example "The spatial region occupied at some time instant by the North Pole"@en .


###  http://purl.obolibrary.org/obo/BFO_0000019
obo:BFO_0000019 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                <http://purl.org/dc/elements/1.1/identifier> "055-BFO" ;
                rdfs:label "quality"@en ;
                skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en ;
                skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en .


###  http://purl.obolibrary.org/obo/BFO_0000020
obo:BFO_0000020 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                <http://purl.org/dc/elements/1.1/identifier> "050-BFO" ;
                rdfs:label "specifically dependent continuant"@en ;
                skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en ;
                skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en ,
                             "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en .


###  http://purl.obolibrary.org/obo/BFO_0000023
obo:BFO_0000023 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                <http://purl.org/dc/elements/1.1/identifier> "061-BFO" ;
                rdfs:label "role"@en ;
                skos:altLabel "externally-grounded realizable entity"@en ;
                skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en ;
                skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en .


###  http://purl.obolibrary.org/obo/BFO_0000024
obo:BFO_0000024 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000040 ;
                <http://purl.org/dc/elements/1.1/identifier> "027-BFO" ;
                rdfs:label "fiat object part"@en ;
                skos:definition "(Elucidation) A fiat object part b is a material entity & such that if b exists then it is continuant part of some object c & demarcated from the remainder of c by one or more fiat surfaces"@en ;
                skos:example "The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA:regional parts of an intact human body"@en .


###  http://purl.obolibrary.org/obo/BFO_0000026
obo:BFO_0000026 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000006 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000018
                                                                    obo:BFO_0000026
                                                                  )
                                                    ]
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "038-BFO" ;
                rdfs:label "one-dimensional spatial region"@en ;
                skos:definition "(Elucidation) A one-dimensional spatial region is a whole consisting of a line together with zero or more lines which may have points as parts"@en ;
                skos:example "An edge of a cube-shaped portion of space; a line connecting two points; two parallel lines extended in space"@en .


###  http://purl.obolibrary.org/obo/BFO_0000027
obo:BFO_0000027 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000040 ;
                <http://purl.org/dc/elements/1.1/identifier> "025-BFO" ;
                rdfs:label "object aggregate"@en ;
                skos:definition "(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit"@en ;
                skos:example "The aggregate of the musicians in a symphony orchestra and their instruments; the aggregate of bearings in a constant velocity axle joint; the nitrogen atoms in the atmosphere; a collection of cells in a blood biobank"@en ;
                skos:scopeNote "'Exactly' means that there are no parts of the object aggregate other than its member parts." ,
                               "The unit can, at certain times, consist of exactly one object, for example, when a wolf litter loses all but one of its pups, but it must at some time have a plurality of member parts." .


###  http://purl.obolibrary.org/obo/BFO_0000028
obo:BFO_0000028 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000006 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom obo:BFO_0000006
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "040-BFO" ;
                rdfs:label "three-dimensional spatial region"@en ;
                skos:definition "(Elucidation) A three-dimensional spatial region is a whole consisting of a spatial volume together with zero or more spatial volumes which may have spatial regions of lower dimension as parts"@en ;
                skos:example "A cube-shaped region of space; a sphere-shaped region of space; the region of space occupied by all and only the planets in the solar system at some point in time"@en .


###  http://purl.obolibrary.org/obo/BFO_0000029
obo:BFO_0000029 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000141 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000029
                                                                    obo:BFO_0000040
                                                                  )
                                                    ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000029
                                                                    obo:BFO_0000140
                                                                  )
                                                    ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000210 ;
                                  owl:allValuesFrom obo:BFO_0000028
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "034-BFO" ;
                rdfs:label "site"@en ;
                skos:definition "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity"@en ;
                skos:example "A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist"@en .


###  http://purl.obolibrary.org/obo/BFO_0000030
obo:BFO_0000030 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000040 ;
                <http://purl.org/dc/elements/1.1/identifier> "024-BFO" ;
                rdfs:label "object"@en ;
                skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en ;
                skos:example "An organism; a fish tank; a planet; a laptop; a valve; a block of marble; an ice cube"@en ;
                skos:scopeNote "A description of three primary sorts of causal unity is provided in Basic Formal Ontology 2.0. Specification and User Guide"@en .


###  http://purl.obolibrary.org/obo/BFO_0000031
obo:BFO_0000031 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                <http://purl.org/dc/elements/1.1/identifier> "074-BFO" ;
                rdfs:label "generically dependent continuant"@en ;
                skos:altLabel "g-dependent continuant"@en ;
                skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en ;
                skos:example "The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint"@en .


###  http://purl.obolibrary.org/obo/BFO_0000034
obo:BFO_0000034 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000016 ;
                <http://purl.org/dc/elements/1.1/identifier> "064-BFO" ;
                rdfs:label "function"@en ;
                skos:definition "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort"@en ;
                skos:example "The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000035
obo:BFO_0000035 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000117 ;
                                  owl:allValuesFrom obo:BFO_0000035
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000121 ;
                                  owl:allValuesFrom obo:BFO_0000035
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000015
                                                                    obo:BFO_0000035
                                                                  )
                                                    ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000139 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000015
                                                                    obo:BFO_0000035
                                                                  )
                                                    ]
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "084-BFO" ;
                rdfs:label "process boundary"@en ;
                skos:definition "p is a process boundary =Def p is a temporal part of a process & p has no proper temporal parts"@en ;
                skos:example "The boundary between the 2nd and 3rd year of your life"@en .


###  http://purl.obolibrary.org/obo/BFO_0000038
obo:BFO_0000038 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000008 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000121 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000038
                                                                    obo:BFO_0000148
                                                                  )
                                                    ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000139 ;
                                  owl:allValuesFrom obo:BFO_0000038
                                ] ;
                owl:disjointWith obo:BFO_0000148 ;
                <http://purl.org/dc/elements/1.1/identifier> "103-BFO" ;
                rdfs:label "one-dimensional temporal region"@en ;
                skos:definition "(Elucidation) A one-dimensional temporal region is a temporal region that is a whole that has a temporal interval and zero or more temporal intervals and temporal instants as parts"@en ;
                skos:example "The temporal region during which a process occurs"@en .


###  http://purl.obolibrary.org/obo/BFO_0000040
obo:BFO_0000040 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000004 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:allValuesFrom obo:BFO_0000040
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000029
                                                                    obo:BFO_0000040
                                                                    obo:BFO_0000140
                                                                  )
                                                    ]
                                ] ;
                owl:disjointWith obo:BFO_0000141 ;
                <http://purl.org/dc/elements/1.1/identifier> "019-BFO" ;
                rdfs:label "material entity"@en ;
                skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en ;
                skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en .


###  http://purl.obolibrary.org/obo/BFO_0000140
obo:BFO_0000140 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000141 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000124 ;
                                  owl:allValuesFrom obo:BFO_0000140
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom obo:BFO_0000140
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "029-BFO" ;
                rdfs:label "continuant fiat boundary"@en ;
                skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en ;
                skos:example "As for fiat point, fiat line, fiat surface"@en .


###  http://purl.obolibrary.org/obo/BFO_0000141
obo:BFO_0000141 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000004 ;
                <http://purl.org/dc/elements/1.1/identifier> "028-BFO" ;
                rdfs:label "immaterial entity"@en ;
                skos:definition "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en ;
                skos:example "As for fiat point, fiat line, fiat surface, site"@en .


###  http://purl.obolibrary.org/obo/BFO_0000142
obo:BFO_0000142 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000140 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                      owl:unionOf ( obo:BFO_0000142
                                                                    obo:BFO_0000147
                                                                  )
                                                    ]
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "032-BFO" ;
                rdfs:label "fiat line"@en ;
                skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en ;
                skos:example "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of your tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin"@en .


###  http://purl.obolibrary.org/obo/BFO_0000144
obo:BFO_0000144 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ;
                rdfs:label "Process Profile"@en ;
                skos:definition "An occurrent that is an occurrent part of some process by virtue of the rate, or pattern, or amplitude of change in an attribute of one or more participants of said process."@en ;
                skos:example "On a somewhat higher level of complexity are what we shall call rate process profiles, which are the targets of selective abstraction focused not on determinate quality magnitudes plotted over time, but rather on certain ratios between these magnitudes and elapsed times. A speed process profile, for example, is represented by a graph plotting against time the ratio of distance covered per unit of time. Since rates may change, and since such changes, too, may have rates of change, we have to deal here with a hierarchy of process profile universals at successive levels; One important sub-family of rate process profiles is illustrated by the beat or frequency profiles of cyclical processes, illustrated by the 60 beats per minute beating process of John’s heart, or the 120 beats per minute drumming process involved in one of John’s performances in a rock band, and so on. Each such process includes what we shall call a beat process profile instance as part, a subtype of rate process profile in which the salient ratio is not distance covered but rather number of beat cycles per unit of time. Each beat process profile instance instantiates the determinable universal beat process profile. But it also instantiates multiple more specialized universals at lower levels of generality, selected from rate process profilebeat process profileregular beat process profile3 bpm beat process profile4 bpm beat process profileirregular beat process profileincreasing beat process profileand so on.In the case of a regular beat process profile, a rate can be assigned in the simplest possible fashion by dividing the number of cycles by the length of the temporal region occupied by the beating process profile as a whole. Irregular process profiles of this sort, for example as identified in the clinic, or in the readings on an aircraft instrument panel, are often of diagnostic significance.; The simplest type of process profiles are what we shall call ‘quality process profiles’, which are the process profiles which serve as the foci of the sort of selective abstraction that is involved when measurements are made of changes in single qualities, as illustrated, for example, by process profiles of mass, temperature, aortic pressure, and so on."@en ;
                skos:scopeNote "b process_profile_of c holds when b proper_occurrent_part_of c& there is some proper_occurrent_part d of c which has no parts in common with b & is mutually dependent on b& is such that b, c and d occupy the same temporal region (axiom label in BFO2 Reference: [094-005])"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/BFO_0000145
obo:BFO_0000145 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ;
                <http://purl.org/dc/elements/1.1/identifier> "057-BFO" ;
                rdfs:label "relational quality"@en ;
                skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en ;
                skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en .


###  http://purl.obolibrary.org/obo/BFO_0000146
obo:BFO_0000146 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000140 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom obo:BFO_0000140
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "033-BFO" ;
                rdfs:label "fiat surface"@en ;
                skos:definition "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected"@en ;
                skos:example "The surface of the Earth; the plane separating the smoking from the non-smoking zone in a restaurant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000147
obo:BFO_0000147 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000140 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000178 ;
                                  owl:allValuesFrom obo:BFO_0000147
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "031-BFO" ;
                rdfs:label "fiat point"@en ;
                skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en ;
                skos:example "The geographic North Pole; the quadripoint where the boundaries of Colorado, Utah, New Mexico and Arizona meet; the point of origin of some spatial coordinate system"@en .


###  http://purl.obolibrary.org/obo/BFO_0000148
obo:BFO_0000148 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000008 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000121 ;
                                  owl:allValuesFrom obo:BFO_0000148
                                ] ;
                <http://purl.org/dc/elements/1.1/identifier> "102-BFO" ;
                rdfs:label "zero-dimensional temporal region"@en ;
                skos:definition "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts"@en ;
                skos:example "A temporal region that is occupied by a process boundary; the moment at which a finger is detached in an industrial accident"@en .


###  http://purl.obolibrary.org/obo/BFO_0000182
obo:BFO_0000182 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000015 ;
                <http://purl.org/dc/elements/1.1/identifier> "138-BFO" ;
                rdfs:label "history"@en ;
                skos:definition "(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity"@en ;
                skos:example "The life of an organism from the beginning to the end of its existence"@en .


###  http://purl.obolibrary.org/obo/BFO_0000202
obo:BFO_0000202 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000038 ;
                <http://purl.org/dc/elements/1.1/identifier> "155-BFO" ;
                rdfs:label "temporal interval"@en ;
                skos:definition "(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks"@en ;
                skos:example "The year 2018."@en ;
                skos:scopeNote "A one-dimensional temporal region can include as parts not only temporal intervals but also temporal instants separated from other parts by gaps."@en .


###  http://purl.obolibrary.org/obo/BFO_0000203
obo:BFO_0000203 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000148 ;
                <http://purl.org/dc/elements/1.1/identifier> "209-BFO" ;
                rdfs:label "temporal instant"@en ;
                skos:definition "(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part"@en ;
                skos:example "The millennium"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class ;
                   rdfs:subClassOf owl:Thing .


###  https://www.commoncoreontologies.org/ont00000001
cco:ont00000001 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000804 ;
                rdfs:label "Deflecting Prism"@en ;
                skos:definition "A Prism designed to deflect a beam of light entering the Prism by a fixed angle."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000002
cco:ont00000002 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Cooling Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system decreases."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000003
cco:ont00000003 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000686 ;
                owl:disjointWith cco:ont00000649 ;
                rdfs:label "Designative Name"@en ;
                skos:altLabel "Name"@en ;
                skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified cultural or social namespace and which is typically a word or phrase in a natural language that has an accepted cultural or social significance."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000004
cco:ont00000004 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000015 ;
                rdfs:label "Change"@en ;
                skos:definition "A Process in which some independent continuant endures and 1) one or more of the dependent entities it bears increase or decrease in intensity, 2) the entity begins to bear some dependent entity or 3) the entity ceases to bear some dependent entity."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000005
cco:ont00000005 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000015 ;
                rdfs:label "Act"@en ;
                skos:definition "A Process in which at least one Agent plays a causative role."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000006
cco:ont00000006 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000530 ;
                rdfs:label "Upper Midrange Frequency"@en ;
                skos:definition "A Sonic Frequency that is between 2 and 4 kHz."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000007
cco:ont00000007 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000015 ;
                rdfs:label "Natural Process"@en ;
                skos:definition "A Process existing in or produced by nature; rather than by the intent of human beings."@en ;
                cco:ont00001754 "http://www.thefreedictionary.com/natural+process" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000008
cco:ont00000008 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000862 ,
                                cco:ont00001047 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:someValuesFrom cco:ont00000675
                                ] ;
                rdfs:label "Sound Frequency"@en ;
                skos:definition "A Frequency that is the rate of Oscillations per second of a Sound Wave."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000009
cco:ont00000009 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ;
                rdfs:label "Mass Density"@en ;
                skos:altLabel "Density"@en ;
                skos:definition "A Quality that inheres in a bearer in virtue of that bearer's mass per unit volume."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000010
cco:ont00000010 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001180 ;
                rdfs:label "Incorporated Organization"@en ;
                skos:altLabel "Corporation"@en ;
                skos:definition "An Organization formed by an Act of Incorporation that consists of an association of individuals, created by law or under authority of law, having a continuous existence independent of the existences of its members and owners, and having powers and liabilities distinct from those of its members and owners."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/corporation" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000011
cco:ont00000011 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000135 ;
                rdfs:label "Nominal Stasis"@en ;
                skos:altLabel "Nominal"@en ;
                skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has a level of intensity or functionality that falls within the designed, expected, or acceptable range such that the Independent Continuant is of normal value, usefulness, or functionality."@en ;
                cco:ont00001754 "https://en.oxforddictionaries.com/definition/nominal (Definition 6)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000012
cco:ont00000012 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000781 ;
                rdfs:label "Propulsion Control System"@en ;
                skos:definition "A Control System that consists of control devices, displays, indicators, or modules designed to control a Propulsion System."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000013
cco:ont00000013 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000554 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000057 ;
                                  owl:someValuesFrom [ owl:intersectionOf ( obo:BFO_0000004
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty obo:BFO_0000101 ;
                                                                              owl:someValuesFrom obo:BFO_0000031
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ]
                                ] ;
                rdfs:label "Gain of Generically Dependent Continuant"@en ;
                skos:definition "A Gain of Dependent Continuant wherein some Independent Continuant becomes the carrier of some Generically Dependent Continuant."@en ;
                skos:example "A Person forms a Plan, A Person is initiated into a Religion, A photgraphic image is produced." ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000015
cco:ont00000015 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001104 ;
                rdfs:label "Shotgun"@en ;
                skos:definition "A Long Gun that fires packets of shot, a single slug, a sabot, or a specialty round (such as tear gas, bolo shell, or a breaching round) over shorter ranges than that of Rifles and with less accuracy."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Shotgun&oldid=1062571691"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000016
cco:ont00000016 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001286 ;
                rdfs:label "Triangular Waveform"@en ;
                skos:definition "A Waveform that is characterized by a triangular shape due to the continuous linear zig-zag transitions between minimum and maximum Amplitudes of the Wave Cycle."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000017
cco:ont00000017 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000026 ;
                rdfs:label "Minor Axis"@en ;
                skos:definition "A One-Dimensional Spatial Region that is the longest line segment perpendicular to the Major Axis that connects two points on the edge of an Ellipse."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Semi-major_and_semi-minor_axes&oldid=1047911304"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000018
cco:ont00000018 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001346 ;
                rdfs:label "Title Document"@en ;
                skos:definition "A Legal Instrument that is designed as evidence of ownership."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Title_(property)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000019
cco:ont00000019 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000961 ;
                rdfs:label "Power Inverting Artifact Function"@en ;
                skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Material Artifact is used to convert direct current (DC) to alternating current (AC)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000020
cco:ont00000020 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Container"@en ;
                skos:definition "A Material Artifact that is designed to contain (wholly or partially) some material entity."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000021
cco:ont00000021 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000040
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000196 ;
                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                  owl:unionOf ( cco:ont00000023
                                                                                                cco:ont00002074
                                                                                              )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf obo:BFO_0000040 ;
                rdfs:label "Sensor Platform"@en ;
                skos:definition "A Material Entity that bears a Sensor Platform Artifact Function or Sensor Platform Role."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000022
cco:ont00000022 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000422 ;
                rdfs:label "Radio Communication Reception Artifact Function"@en ;
                skos:definition "A Communication Reception Artifact Function that is realized during events in which a Material Artifact receives information transmitted from another Material Artifact, where the transmission of information occurs using radio waves."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000023
cco:ont00000023 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Sensor Deployment Artifact Function"@en ;
                skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to support or convey one or more Sensors while the Sensors are realizing their own Artifact Functions."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000024
cco:ont00000024 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000133 ;
                rdfs:label "Act of Advising"@en ;
                skos:definition "An Act of Directive Communication performed by providing advice or counsel to another agent."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/advising" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000025
cco:ont00000025 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001278 ;
                rdfs:label "Electronic Stock"@en ;
                skos:definition "Stock that consists of Bytes."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000026
cco:ont00000026 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ;
                rdfs:label "Hair Color"@en ;
                skos:definition "A Quality inhering in a portion of Hair by virtue of its color."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000027
cco:ont00000027 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000517 ;
                rdfs:label "Mailing"@en ;
                skos:altLabel "Act of Mailing"@en ;
                skos:definition "An Act of Communication by Media in which information and tangible objects, usually written documents, are delivered to destinations around the world."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mail&oldid=1057401839"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000028
cco:ont00000028 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000804 ;
                rdfs:label "Dispersive Prism"@en ;
                skos:definition "A Prism designed to break up a beam of light entering the Prism into its constituent spectral colors by leveraging the refractive index of light based on its Frequency."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000029
cco:ont00000029 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000745 ;
                rdfs:label "Median Point Estimate Information Content Entity"@en ;
                skos:altLabel "Median"@en ;
                skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to either the middle value or the average of the two values which separate the set into two equally populated upper and lower sets."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000030
cco:ont00000030 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000288 ;
                rdfs:label "Nuclear Reactor"@en ;
                skos:definition "A Power Source that is designed to initiate and control a self-sustained nuclear chain reaction to produce power in the form of heat, which can be transferred to a working fluid for further conversion to mechanical or electrical energy."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_reactor&oldid=1063370273"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000031
cco:ont00000031 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001081 ;
                rdfs:label "Atmospheric Feature"@en ;
                skos:definition "A Geographic Feature that is part of the atmosphere (including the atmosphere itself as a non-proper part) having a relatively stable lifecycle and which has a location that can be distinguished from the surrounding portion of the atmosphere."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000032
cco:ont00000032 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000052 ;
                rdfs:label "Church"@en ;
                skos:definition "A Religious Facility that is designed for Christian worship and prayer."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Church_(building)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000033
cco:ont00000033 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000854 ;
                rdfs:label "Decrease of Role"@en ;
                skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Role that it bears."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000034
cco:ont00000034 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000448 ;
                rdfs:label "Conveyance Artifact Function"@en ;
                skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function conveys entities from one location to another."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle&oldid=1063682179"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000035
cco:ont00000035 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000490 ;
                rdfs:label "Soft X-ray Frequency"@en ;
                skos:definition "An X-Ray Frequency that is between 30 petahertz and 3 exahertz."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000036
cco:ont00000036 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001301 ;
                rdfs:label "Waste Management Artifact Function"@en ;
                skos:definition "A Service Artifact Function that is realized in processes of collecting, transporting, processing, recycling, monitoring, or disposing of waste materials."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Waste_management&oldid=1062844209"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000037
cco:ont00000037 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Observation"@en ;
                skos:definition "A Planned Act of acquiring information from a source via the use of one or more senses."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Observation&oldid=1062502087"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000038
cco:ont00000038 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "System Role"@en ;
                skos:definition "A Role that inheres in an entity in virtue of its parts or elements being arranged in such a way that they together exhibit behavior or meaning that they do not exhibit individually."@en ;
                cco:ont00001754 "https://www.incose.org/about-systems-engineering/system-and-se-definition/general-system-definition"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000039
cco:ont00000039 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000838 ;
                rdfs:label "Portion of Solid Fuel"@en ;
                skos:definition "A Portion of Fuel that is stored in a solid state."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000040
cco:ont00000040 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001102 ;
                rdfs:label "Grocery Store"@en ;
                skos:definition "A Commercial Facility that is designed to sell food."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Grocery_store&oldid=1060022873"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000041
cco:ont00000041 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000410 ;
                rdfs:label "Hostel"@en ;
                skos:definition "A Residential Facility that is designed to temporarily lodge guests in a sociable environment for relatively low costs."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hostel&oldid=1057812930"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000042
cco:ont00000042 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001059 ;
                rdfs:label "Semicircular"@en ;
                skos:definition "A Shape quality inhering in a bearer in virtue of the bearer having the shape of half a circle."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000043
cco:ont00000043 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000593 ;
                rdfs:label "Portion of Solid Propellant"@en ;
                skos:definition "A Portion of Propellant that is stored in a solid state."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000044
cco:ont00000044 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000197 ;
                                  owl:someValuesFrom cco:ont00000404
                                ] ;
                rdfs:label "Eye Color"@en ;
                skos:definition "A Quality inhering in an Eye by virtue of the color of the Eye's Iris."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000045
cco:ont00000045 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000881 ;
                rdfs:label "Petroleum Depot"@en ;
                skos:definition "A Storage Facility that is designed to store petroleum, oil, or lubricants."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000046
cco:ont00000046 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000126 ;
                rdfs:label "Province"@en ;
                skos:definition "A First-Order Administrative Region that is part of a Country and delimits the authority of a magistrate who holds constitutionally-defined administrative jurisdiction over the defined geographic territory that bounds the Province."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Province&oldid=1062496131"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000047
cco:ont00000047 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000598 ;
                rdfs:label "Flow Control Valve"@en ;
                skos:definition "A Valve that is designed to regulate the flow or Pressure of a fluid."@en ;
                skos:scopeNote "Flow Control Valves are often more complex than a simple Valve and typically include an Actuator that is capable of automatically adjusting the state of the valve in response to signals from a connected Sensor or Controller."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flow_control_valve&oldid=1013438085"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000048
cco:ont00000048 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000499 ;
                rdfs:label "Random Wire Antenna"@en ;
                skos:definition "A Wire Antenna that consists of a long wire suspended above the ground with a length that does not bear a relation to the wavelength of the radio waves used and which is typically used as a receiving antenna on the long, medium, and short wave bands."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Random_wire_antenna&oldid=1058546356"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000049
cco:ont00000049 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000475 ;
                rdfs:label "Banknote"@en ;
                skos:definition "A Portion of Cash that consists of a portable slips of paper or fabric designed to bear some specified Financial Value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000050
cco:ont00000050 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000903 ;
                rdfs:label "Very High Frequency Communication Instrument"@en ;
                skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some Very High Frequency."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000051
cco:ont00000051 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000908 ;
                rdfs:label "Act of Construction"@en ;
                skos:definition "An Act of Material Artifact Processing wherein Material Artifacts are built on site as prescribed by some contract."@en ;
                skos:scopeNote "An Act of Construction typically involves the production of only one or a limited number of goods, such as in the construction of an airport or a community of condominiums."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000052
cco:ont00000052 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Religious Facility"@en ;
                skos:definition "A Facility that is designed for worship and prayer."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Religion&oldid=1063431202"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000053
cco:ont00000053 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000618 ;
                rdfs:label "Ground Motor Vehicle"@en ;
                skos:definition "A Ground Vehicle that is designed to receive its motive power from an Engine and is not designed to travel on rails."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Motor_vehicle&oldid=1063627395"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000054
cco:ont00000054 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000431 ;
                rdfs:label "Stirling Engine"@en ;
                skos:definition "An External Combusion Engine that is designed to compress and expand some working fluid at different temperatures, such that there is a net conversion of heat energy to mechanical work."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Stirling_engine&oldid=1061164490"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000055
cco:ont00000055 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Healthcare Facility"@en ;
                skos:definition "A Facility that is designed for the diagnosis, treatment, and prevention of disease."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Medicine&oldid=1062226814"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000056
cco:ont00000056 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000210 ;
                rdfs:label "Reaction Engine"@en ;
                skos:altLabel "Reaction Motor"@en ;
                skos:definition "An Engine that provides propulsion by expelling Reaction Mass."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reaction_engine&oldid=1046981784"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000057
cco:ont00000057 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000907 ;
                rdfs:label "Mobile Telephone"@en ;
                skos:definition "A Telephone that is connected to a Telephone Network by radio waves."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mobile_phone&oldid=1061800841"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000058
cco:ont00000058 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000084 ;
                rdfs:label "Scalp Hair"@en ;
                skos:definition "A Bodily Component that consists of a portion of hair that grows on the scalp of a human or other animal."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000059
cco:ont00000059 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000825 ;
                rdfs:label "Telephone Line"@en ;
                skos:altLabel "Telephone Circuit"@en ;
                skos:definition "A Telecommunication Network Line that consists of a physical wire or other signaling medium that is designed to be part of a Telephone Network."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_line&oldid=1063429738"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000060
cco:ont00000060 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000639 ;
                rdfs:label "Open Pit Mine"@en ;
                skos:definition "A Mine that is designed to support the extraction of materials from the ground directly without using tunnels."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Open-pit_mining&oldid=1059271938"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000061
cco:ont00000061 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Flow"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which portions of a substance pass per unit of time."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000062
cco:ont00000062 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001100 ;
                rdfs:label "Frequency Measurement Artifact Function"@en ;
                skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Frequency of a specified object or class of objects."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000063
cco:ont00000063 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000202 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001924 ;
                                  owl:someValuesFrom cco:ont00001058
                                ] ;
                rdfs:label "Multi-Hour Temporal Interval"@en ;
                skos:definition "A one-dimensional temporal region that is measured in Hours and spans at least one Hour."@en ;
                skos:scopeNote "This is a defined class."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000064
cco:ont00000064 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001298 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000101 ;
                                  owl:someValuesFrom cco:ont00002040
                                ] ;
                rdfs:label "Material Copy of a Book"@en ;
                skos:altLabel "Book"@en ;
                skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity by means of ink, paper, parchment, or other materials fastened together to hinge at one side."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Book&oldid=1063132471"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000065
cco:ont00000065 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000357 ;
                rdfs:label "Act of Location Change"@en ;
                skos:definition "An Act of Motion in which the location of some Object is changed by some Agent."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000066
cco:ont00000066 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001301 ;
                rdfs:label "Military Artifact Function"@en ;
                skos:definition "A Service Artifact Function that is realized in processes related to the armed services."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000067
cco:ont00000067 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001328 ;
                rdfs:label "Civil Time Reference System"@en ;
                skos:definition "A Temporal Reference System that is a statutory time scale as designated by civilian authorities to determine local time(s)."@en ;
                skos:scopeNote "In traditional astronomical usage, civil time is mean solar time as calculated from midnight as the beginning of the Civil Day."@en ,
                               "Note that Civil Time Reference System is more accurately represented as a Temporal Reference System that participates in an act of usage that is sanctioned by an appropriate civil authority. As such, it should be represented as a defined class."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000068
cco:ont00000068 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000028 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001855 ;
                                  owl:someValuesFrom cco:ont00001348
                                ] ;
                rdfs:label "Three-Dimensional Path"@en ;
                skos:definition "A Three-Dimensional Spatial Region that encompasses the spatial region through which some Object travels."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000069
cco:ont00000069 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001298 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000101 ;
                                  owl:someValuesFrom cco:ont00002041
                                ] ;
                rdfs:label "Material Copy of a Transcript"@en ;
                skos:altLabel "Transcript"@en ;
                skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity that was originally recorded in a different medium."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transcript&oldid=1038510063"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000070
cco:ont00000070 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000018 ;
                rdfs:label "Ground Track Point"@en ;
                skos:definition "A Zero-Dimensional Spatial Region that is an idealized point located on the surface of an Astronomical Body directly below an Object Track Point."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000071
cco:ont00000071 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000460 ;
                rdfs:label "Town"@en ;
                skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a Village but smaller than that of a City; is designated as a town based on a particular administrative, legal, or historical status; and which delimits a local Government that typically exercises less power than that of a City Government."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/town" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000072
cco:ont00000072 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000224 ;
                rdfs:label "Low Density Residential Area"@en ;
                skos:definition "A Populated Place where houses are on lots of more than one acre."@en ;
                cco:ont00001754 "Anderson et. al. A Land Use and Land Cover Classification System for use with Remote Sensor Data, Geological Survey Professional Paper 964" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000073
cco:ont00000073 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000399
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001916 ;
                                                             owl:someValuesFrom obo:BFO_0000038
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000399 ;
                rdfs:label "Temporal Interval Identifier"@en ;
                skos:altLabel "One-Dimensional Temporal Region Identifier"@en ;
                skos:definition "A Temporal Region Identifier that designates some Temporal Interval."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000074
cco:ont00000074 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Acceleration"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which objects change their velocities per unit of time."@en ;
                skos:example "feet per second per second, kilometers per second per second" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000075
cco:ont00000075 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000304 ;
                rdfs:label "Optical Microscope"@en ;
                skos:altLabel "Light Microscope"@en ;
                skos:definition "A Microscope that is designed to use visible light and a system of Optical Lenses to produce a significantly enlarged image of the Object."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_microscope&oldid=1063131242"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000076
cco:ont00000076 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000727 ;
                rdfs:label "Wired Communication Artifact Function"@en ;
                skos:definition "A Communication Artifact Function that is realized in a process that conveys meaningful signs by means of a (usually cylindrical) flexible strand or rod of metal."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000077
cco:ont00000077 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000649 ;
                owl:disjointWith cco:ont00000923 ;
                rdfs:label "Code Identifier"@en ;
                skos:altLabel "Code ID"@en ,
                              "ID Code"@en ,
                              "Identifier Code"@en ;
                skos:definition "A Non-Name Identifier that consists of a string of characters that was created and assigned according to an encoding system such that metadata can be derived from the identifier."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000078
cco:ont00000078 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000345 ;
                rdfs:label "Act of Estimation"@en ;
                skos:altLabel "Act of Approximation"@en ;
                skos:definition "An Act of Measuring that involves the comparison of a measurement of a similar Entity or of a portion of the Entity being estimated to produce an approximated measurement of the target Entity."@en ;
                skos:example "measuring how much time a train will add to your commute by measuring how long it takes for 10 train cars to pass a given point and then combining this information with an estimate of how many train cars are in a typical train based on your past experience" ,
                             "measuring the amount of time required to do a task based on how long it took to do a similar task in the past" ,
                             "measuring the height of a building by counting the number of floors and multiplying it by the height of an average floor in an average building" ,
                             "measuring the property value of a house based on its square footage and the average cost per square foot of other houses in the area" ;
                skos:scopeNote "Although the boundary between Act of Estimation and guessing is vague, estimation can be partially distinguished from guessing in that every Act of Estimation has as input some relevant information; whereas an act of guessing can occur sans information (or at least sans pertinent information). For example, if Mr. Green were asked how many blades of grass are in his lawn, he could simply choose a number (i.e. he could guess) or he could estimate the number by counting how many baldes of grass are in 1 square foot of his lawn, measuring the square footage of his lawn, and then multiplying these values to arrive at a number. Hence, many estimates may be loosely considered to be educated guesses."@en ,
                               "In all cases, the Agent in an Act of Estimation either lacks complete information, lacks access to the relevant information, or chooses not to use the complete information (perhaps to save money or time) about the thing being estimated; instead, the Agent uses some or all of the relevant information that the Agent does have as a basis for arriving at the estimate."@en ,
                               "Note that, while every Act of Measuring arguably involves some degree of estimation (for example, a measuring instrument rounding to the nearest ten-thousandth or an Agent reading an analog display), it would be a mistake to classify all Acts of Measuring as Acts of Estimation. This holds even for cases (e.g. census taking) in which sofisticated estimations are often more accurate than other means of measuring (e.g. enumeration)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000079
cco:ont00000079 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001327 ;
                rdfs:label "Act of Social Movement"@en ;
                skos:definition "A Social Act composed of a series of performances, displays and campaigns directed at implementing, resisting or undoing a change in society."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Social_movement&oldid=1062720561"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000080
cco:ont00000080 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000827 ;
                rdfs:label "Standard Time of Day Identifier"@en ;
                skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using the Hours, Minutes, and Seconds of the Day that preceded the Temporal Instant."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000081
cco:ont00000081 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000445 ;
                rdfs:label "Cutting Weapon"@en ;
                skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of separating some portion of its target into two or more portions through the application of acutely directed force."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cutting&oldid=1058846915"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000082
cco:ont00000082 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000378 ;
                rdfs:label "Green"@en ;
                skos:definition "A Color that is between Yellow and Cyan with a wavelength in the visible spectrum, typically between 520 to 560 nanometers."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000083
cco:ont00000083 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000035 ;
                rdfs:label "Process Ending"@en ;
                skos:definition "A Process Boundary that occupies a Zero-Dimensional Temporal Region that is the ending instant of the One-Dimensional Temporal Region that the Process, of which the Process Boundary is a part, occupies."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000084
cco:ont00000084 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000024 ;
                rdfs:label "Bodily Component"@en ;
                skos:definition "A Fiat Object Part located within or on the surface of an Agent."@en ;
                skos:example "Bodily Components include anatomical structures, body flora, pathogens, toxins, and their combinations." ;
                cco:ont00001754 "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3017014/" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000085
cco:ont00000085 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000202 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001869 ;
                                  owl:someValuesFrom cco:ont00001058
                                ] ;
                rdfs:label "Minute"@en ;
                skos:definition "A Temporal Interval that is equal to sixty consecutive Seconds."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=minute" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000086
cco:ont00000086 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000723 ;
                rdfs:label "Autopilot System"@en ;
                skos:altLabel "Autopilot"@en ;
                skos:definition "A Vehicle Control System that is designed to enable some Agent to control the trajectory of a Vehicle without constant 'hands-on' control."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Autopilot&oldid=1063382206"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000087
cco:ont00000087 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000894 ;
                rdfs:label "Ordinal Date Identifier"@en ;
                skos:altLabel "Ordinal Date"@en ;
                skos:definition "A Decimal Date Identifier that designates some Day by using a number to indicate the sequential ordering of the Day since the beginning of the Year."@en ;
                skos:scopeNote "An Ordinal Date Identifier may or may not also contain a number indicating a specific Year. If both numbers are included, the ISO 8601 ordinal date format stipulates that the two numbers be formatted as YYYY-DDD or YYYYDDD where [YYYY] indicates a year and [DDD] is the day of that year, from 001 through 365 (or 366 in leap years)."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ordinal_date&oldid=1061989434"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000088
cco:ont00000088 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001051 ;
                rdfs:label "Firearm"@en ;
                skos:definition "A Projectile Launcher that is designed to launch Bullets or Cartridges."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Firearm&oldid=1061216363"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000089
cco:ont00000089 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00001379
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001889 ;
                                                             owl:someValuesFrom cco:ont00001262
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00001379 ;
                rdfs:label "Skill"@en ;
                skos:definition "An Agent Capability that inheres in a Person to the extent of that Person's capacity to realize it in Intentional Acts of a certain type."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000090
cco:ont00000090 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000547 ;
                rdfs:label "Infrared Telescope"@en ;
                skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing infrared light to form an enhanced image of the Object."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared_telescope&oldid=1062918090"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000091
cco:ont00000091 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000457 ;
                rdfs:label "Portion of Coolant"@en ;
                skos:definition "A Portion of Material that is designed to be used in a thermal control system to reduce or maintain the temperature of an object to or at a specified level."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000092
cco:ont00000092 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000736 ;
                rdfs:label "Bidirectional Transducer"@en ;
                skos:definition "A Transducer that is designed to receive a signal in the form of physical phenomena and convert it into an electrical signal, and vice versa."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transducer&oldid=1053290948"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000093
cco:ont00000093 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001278 ;
                rdfs:label "Preferred Stock"@en ;
                skos:definition "Stock that entitles its holder to receive a certain level of dividend payments before any dividends can be issued to other holders."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000094
cco:ont00000094 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000946 ;
                rdfs:label "Seat of National Government"@en ;
                skos:definition "A Government Building that is designed for the administration of a sovereign nation."@en ;
                skos:example "Parliament of Canada" ,
                             "United States Capitol" ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Seat_of_government&oldid=1063047501"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000095
cco:ont00000095 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Control Surface"@en ;
                skos:definition "A Material Artifact that is designed to deflect air, water, or another medium around its surface in order to change the Attitude of a Vehicle by rotating the Vehicle on one or more of its Axes of Rotation."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flight_control_surfaces&oldid=1019271264"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000096
cco:ont00000096 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Propulsion System"@en ;
                skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another and which consists of a source of mechanical power and a means of converting this power into propulsive force to generate the movement."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propulsion&oldid=1022034059"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000097
cco:ont00000097 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001207 ;
                rdfs:label "Complex Optical Lens"@en ;
                skos:altLabel "Lens System"@en ;
                skos:definition "An Optical Lens consisting of more than one Simple Optical Lenses."@en ;
                cco:ont00001754 "Hecht, Eugene (1987). Optics (2nd ed.). Addison Wesley. ISBN 978-0-201-11609-0. Chapters 5 & 6."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000098
cco:ont00000098 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Electrical Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to perform a process involving electrical power."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000099
cco:ont00000099 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000007 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000062 ;
                                  owl:someValuesFrom cco:ont00000765
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001777 ;
                                  owl:someValuesFrom cco:ont00000752
                                ] ;
                rdfs:label "Wave Process"@en ;
                skos:definition "A Natural Process that involves Oscillation accompanied by a transfer of energy that travels through a portion of matter or spatial region."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wave&oldid=1062648180"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000100
cco:ont00000100 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001132 ;
                rdfs:label "Stasis of Partially Mission Capable"@en ;
                skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing some but not all of its primary functions for the specified Mission."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000101
cco:ont00000101 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000255 ;
                rdfs:label "Portion of Liquid Oxygen"@en ;
                skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid oxygen."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000102
cco:ont00000102 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ;
                rdfs:label "Skin Type"@en ;
                skos:definition "A Quality inhering in a portion of skin by virtue of its color and natural tendency to respond to ultraviolet light."@en ;
                skos:scopeNote "Skin Type is classified according to a reference system such as the Fitzpatrick scale: https://en.wikipedia.org/wiki/Fitzpatrick_scale"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000103
cco:ont00000103 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Vehicle Compartment"@en ;
                skos:altLabel "Compartment"@en ;
                skos:definition "A Material Artifact that is designed to partition a Vehicle into subdivisions for various purposes."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000104
cco:ont00000104 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000639 ;
                rdfs:label "Underwater Mine"@en ;
                skos:definition "A Mine that is designed to support the extraction of materials from the ocean floor."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Naval_mine&oldid=1062538523"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000105
cco:ont00000105 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001369 ;
                rdfs:label "Square"@en ;
                skos:definition "A Rectangular shape which has four equal length sides and four 90 degree angles."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000106
cco:ont00000106 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001213 ;
                rdfs:label "End of Life Stasis"@en ;
                skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when the participating Material Artifact is no longer capable of realizing all of its designed primary Artifact Functions."@en ;
                skos:scopeNote "An End of Life Stasis (EoL) is distinguished from a Stasis of Partially Mission Capable or Stasis of Non-Mission Capable in that EoL is more inclusive such that the participating Material Artifact may be either Partially or Non-Mission Capable. Additionally, EoL applies only to Artifacts and is typically determined in relation to its original mission and designed primary functions. In contrast, an Artifact's level of Mission Capability depends on the requirements of the mission under consideration such that a given Artifact may simultaneously be Fully Mission Capable for mission1, Partially Mission Capable for mission2, and Non-Mission Capable for mission3."@en ;
                cco:ont00001753 "EOL" ,
                                "EoL" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000107
cco:ont00000107 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001048 ;
                rdfs:label "Increase of Generically Dependent Continuant"@en ;
                skos:definition "An Increase of Dependent Continuant in which some Independent Continuant has an increase of some Generically Dependent Continuant that it bears."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000108
cco:ont00000108 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000226 ;
                rdfs:label "Rail Facility"@en ;
                skos:definition "A Transportation Facility that is designed for transferring people or cargo to and from Trains."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Train_station&oldid=1063922802"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000109
cco:ont00000109 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Military Force"@en ;
                skos:definition "A Planned Act of employing a Military Force to achieve some desired result."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000110
cco:ont00000110 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000015 ;
                rdfs:label "Mechanical Process"@en ;
                skos:definition "A Process that is the realization of some Disposition of a Material Artifact"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000111
cco:ont00000111 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000256 ;
                rdfs:label "Air Inlet"@en ;
                skos:altLabel "Air Intake"@en ;
                skos:definition "A Fluid Control Artifact that consists of an opening that is designed to capture and direct the flow of air into the system it is part of."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000112
cco:ont00000112 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001384 ;
                rdfs:label "Translucent"@en ;
                skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's capacity to transmit some but not all electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs some but not all electromagnetic radiation of that frequency."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000113
cco:ont00000113 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Ventilation Control Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to control the quality of air in some space."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000114
cco:ont00000114 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000203 ;
                rdfs:label "Unix Temporal Instant"@en ;
                skos:definition "A Temporal Instant as specified by the number of Seconds that have elapsed since the specified Epoch Time as described by an implementation of Unix Time."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000115
cco:ont00000115 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000246 ;
                rdfs:label "Stasis of Disposition"@en ;
                skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Disposition that remains unchanged during a Temporal Interval."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000116
cco:ont00000116 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000256 ;
                rdfs:label "Pump"@en ;
                skos:definition "A Fluid Control Artifact that is designed to impart motion to a portion of fluid to transport it within a system through the use of mechanical action."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000117
cco:ont00000117 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Information Processing Artifact"@en ;
                skos:definition "A Material Artifact that is designed to use algorithms to transform some Information Content Entity into another Information Content Entity."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000118
cco:ont00000118 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000965
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000176 ;
                                                             owl:someValuesFrom cco:ont00001045
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001942 ;
                                                             owl:someValuesFrom cco:ont00000323
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:label "Artifact Function Specification"@en ;
                skos:definition "A Prescriptive Information Content Entity that prescribes some Material Artifact Function and which is part of some Material Artifact Model."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000119
cco:ont00000119 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000145 ;
                rdfs:label "Spatial Orientation"@en ;
                skos:altLabel "Attitude"@en ;
                skos:definition "A Relational Quality that is the angle of Rotation of an Object relative to one or more Plane of Reference or Axis of Rotation."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Orientation_(geometry)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000120
cco:ont00000120 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:label "Measurement Unit"@en ;
                skos:definition "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Unit_of_measurement&oldid=1061038125"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000121
cco:ont00000121 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000588 ;
                rdfs:label "Act of Conducting Mass Media Interview"@en ;
                skos:definition "An Act of Mass Media Communication involving a conversation between a reporter and a person of public interest, used as a basis of a broadcast or publication."@en ;
                cco:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000122
cco:ont00000122 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000170 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001944 ;
                                  owl:someValuesFrom cco:ont00000904
                                ] ;
                rdfs:label "Vehicle Track Point"@en ;
                skos:definition "An Object Track Point that is where a Vehicle is or was located during some motion."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000123
cco:ont00000123 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000402 ;
                rdfs:label "Act of Expressive Communication"@en ;
                skos:definition "An Act of Communication in which an Agent expresses their attitudes or emotions towards some entity."@en ;
                skos:scopeNote "Examples: apologizing, condoling, congratulating, greeting, thanking, accepting (acknowledging an acknowledgment)"@en ;
                cco:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000124
cco:ont00000124 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001328 ;
                rdfs:label "Solar Time Reference System"@en ;
                skos:definition "A Temporal Reference System that is based on the position of the Sun in the sky."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000125
cco:ont00000125 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000373
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000176 ;
                                                             owl:someValuesFrom cco:ont00000358
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000373 ;
                rdfs:label "Bounding Box Point"@en ;
                skos:definition "A Geospatial Position that is a proper part of some Geospatial Region Bounding Box."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000126
cco:ont00000126 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001152 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:someValuesFrom cco:ont00000139
                                ] ;
                rdfs:label "First-Order Administrative Region"@en ;
                skos:definition "A Government Domain that is a primary administrative division of a Country."@en ;
                skos:example "a state in the United States" ;
                cco:ont00001754 "http://www.geonames.org/export/codes.html" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000127
cco:ont00000127 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001980 ;
                                  owl:someValuesFrom obo:BFO_0000001
                                ] ;
                rdfs:label "Performance Specification"@en ;
                skos:definition "A Prescriptive Information Content Entity that prescribes some aspect of the behavior of a participant in a Process given one or more operating conditions."@en ;
                skos:example "Maximum Speed at high altitude; Rate of Ascent at 10 degrees celsius with nominal payload." ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000128
cco:ont00000128 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000255 ;
                rdfs:label "Portion of Liquid Hydrogen"@en ;
                skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid hydrogen."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000129
cco:ont00000129 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000084 ;
                rdfs:label "Tattoo"@en ;
                skos:definition "A Bodily Component that consists of a typically permanent mark or design on a portion of skin that is created by a process of pricking and ingraining an indelible pigment or by raising scars."@en ;
                cco:ont00001754 "http://www.thefreedictionary.com/tattoo" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000130
cco:ont00000130 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Power Transformer"@en ;
                skos:definition "A Material Artifact that is designed to transfer electrical energy between two or more circuits through electromagnetic induction."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transformer&oldid=1062163369"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000131
cco:ont00000131 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001214 ;
                rdfs:label "Increase of Quality"@en ;
                skos:definition "An Increase of Specifically Dependent Continuant in which some Indpendent Continuant has an increase of some Quality that it bears."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000132
cco:ont00000132 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000117 ;
                rdfs:label "Recording Device"@en ;
                skos:definition "An Information Processing Artifact that is designed to capture some information and store it in some recording format on some storage medium."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Record&oldid=1062776450"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000133
cco:ont00000133 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000402 ;
                rdfs:label "Act of Directive Communication"@en ;
                skos:definition "An Act of Communication that is intended to cause the hearer to take a particular action."@en ;
                skos:scopeNote "Examples: advising, admonishing, asking, begging, dismissing, excusing, forbidding, instructing, ordering, permitting, requesting, requiring, suggesting, urging, warning"@en ;
                cco:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000134
cco:ont00000134 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001152 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:someValuesFrom cco:ont00000405
                                ] ;
                rdfs:label "Third-Order Administrative Region"@en ;
                skos:definition "A Government Domain that is a subdivision of a Second-Order Administrative Region."@en ;
                cco:ont00001754 "http://www.geonames.org/export/codes.html" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000135
cco:ont00000135 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000819 ;
                rdfs:label "Stasis of Specifically Dependent Continuant"@en ;
                skos:definition "A Stasis in which some Independent Continuant bears some Specifically Dependent Continuant that remains unchanged during a Temporal Interval."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000136
cco:ont00000136 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Optical Instrument"@en ;
                skos:definition "A Material Artifact that is designed to process light waves."@en ;
                skos:scopeNote "Light waves can be processed in a variety of ways including via reflection, refraction, diffraction, deflection, focusing, collimation, dispersion, and interference."@en ,
                               "Optical Instruments are typically constructed for the purpose of being used to aid in vision or the analysis of light."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_instrument&oldid=1061981216"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000137
cco:ont00000137 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000836 ;
                rdfs:label "Act of Financial Deposit"@en ;
                skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent (the Depositor) to another Agent to create a liability to be repaid to the Depositor through an Act of Financial Withdrawal."@en ;
                cco:ont00001754 "http://en.wikipedia.org/wiki/Deposit_(bank)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000138
cco:ont00000138 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000503 ;
                rdfs:label "Maximum Power"@en ;
                skos:definition "A Power that is characterized by the maximum rate of Work, or Energy consumed, done in a given time period."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000139
cco:ont00000139 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001152 ;
                dct:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023." ;
                dct:creator "https://cubrc.org"^^xsd:anyURI ;
                rdfs:label "Domain of a Country"@en ;
                skos:definition "A Government Domain that is associated with certain distinct political, ethnic, or cultural characteristics, and which delimits a Government that has legitimate authority over a Populace."@en ;
                skos:editorialNote "'Country' is an unclear term. Does it refer to the people, the government, the site, or the material in the site? Furthermore, what is properly referred to as a 'Country' is highly dependent on the classification practices of the international community. For example: The United Kingdom is a sovereign country that has Wales, a non-sovereign Country, as a member. Vatican City is a sovereign country that is landlocked by a city: Rome, Italy. Puerto Rico is not a country (it's a territory) but has a government, a distinct culture, and so on. Thus, here we do not define 'Country' but instead define 'Domain of a Country'."@en ;
                skos:prefLabel "Domain of a Country"@en ;
                cco:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000140
cco:ont00000140 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Amount of Substance"@en ;
                skos:altLabel "Measurement Unit of Chemical Amount"@en ,
                              "Measurement Unit of Enplethy"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of the number of a specified type of particle in a portion of matter."@en ;
                skos:example "mole, pound-mole" ;
                skos:scopeNote "The type of particle quantified is typically either atoms or molecules, but may also be protons, neutrons, electrons, quarks, or other particles. The type of particle being measured should always be specified along with the measurement and its unit."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology" .


###  https://www.commoncoreontologies.org/ont00000141
cco:ont00000141 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000914 ;
                rdfs:label "Populace"@en ;
                skos:definition "A Group of Persons forming the total population of some Government Domain."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Population&oldid=1059148871"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000142
cco:ont00000142 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Government"@en ;
                skos:definition "A Planned Act that is initiated or supported by some Geopolitical Entity and enforced by some Government Agent."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000143
cco:ont00000143 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000103 ;
                rdfs:label "Cargo Cabin"@en ;
                skos:definition "A Vehicle Compartment that is used to store goods or materials during transportation."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000144
cco:ont00000144 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000433 ;
                rdfs:label "Act of Meeting"@en ;
                skos:definition "An Act of Association wherein two or more Persons assemble for some common purpose."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=meet (Sense Key: meet%2:41:00, get together%2:41:00)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000145
cco:ont00000145 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000445 ;
                rdfs:label "Incendiary Weapon"@en ;
                skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of starting a fire."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Incendiary_device&oldid=1055642422"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000146
cco:ont00000146 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001175 ;
                owl:disjointWith cco:ont00000496 ;
                rdfs:label "Artificial Language"@en ;
                skos:definition "A Language that is developed through conscious planning and premeditation, rather than one that was developed through use and repetition."@en ;
                skos:example "Esperanto" ,
                             "Python Programming Language" ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Constructed_language&oldid=1062733589"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000147
cco:ont00000147 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000325 ;
                rdfs:label "Flight Transponder"@en ;
                skos:definition "A Radio Transponder that is designed to produce a specified response (typically for identification, location, or status update purposes) when it receives a radio-frequency interrogation."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transponder_(aeronautics)&oldid=1052688836"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000148
cco:ont00000148 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000368 ;
                rdfs:label "Clockwise Rotational Motion"@en ;
                skos:altLabel "CW Rotational Motion"@en ,
                              "Clockwise Rotation"@en ;
                skos:definition "A Rotational Motion in which the direction of rotation is toward the right as seen relative to the designated side of the plane of rotation."@en ;
                skos:example "the axial rotation of the Earth as seen from above the South Pole" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000149
cco:ont00000149 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000517 ;
                rdfs:label "Instant Messaging"@en ;
                skos:altLabel "Act of IMing"@en ,
                              "Act of Instant Messaging"@en ;
                skos:definition "An Act of Communication by Media in which real-time direct text-based communication occurs between two or more people using personal computers or other devices, along with shared Instant Messaging Client Software conveyed over a network, such as the Internet."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Instant_messaging&oldid=1062873579"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000150
cco:ont00000150 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000754 ;
                rdfs:label "Radio Frequency"@en ;
                skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 3 kHz and 300 GHz."@en ;
                cco:ont00001753 "RF" ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_wave&oldid=1062110903"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000151
cco:ont00000151 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000379 ;
                rdfs:label "Act of Reporting"@en ;
                skos:definition "An Act of Representative Communication performed by giving a detailed account or statement."@en ;
                cco:ont00001754 "http://www.merriam-webster.com/dictionary/report" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000152
cco:ont00000152 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000998 ;
                rdfs:label "Telephone Network"@en ;
                skos:definition "A Telecommunication Network that is designed to allow telephone calls to be made between two or more parties connected to the network."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000153
cco:ont00000153 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000781 ;
                rdfs:label "Generator Control Unit"@en ;
                skos:definition "A Control System that is designed to regulate the voltage of some Electrical Power Source."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000154
cco:ont00000154 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000745 ;
                rdfs:label "Mode Point Estimate Information Content Entity"@en ;
                skos:altLabel "Mode"@en ,
                              "Statistical Mode"@en ;
                skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the value or values that occur most often in the set."@en ;
                skos:scopeNote "While there is always at least one Mode for every set of data, it is possible for any given set of data to have multiple Modes. The Mode is typically most useful when the members of the set are all Nominal Measurement Information Content Entities."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000155
cco:ont00000155 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001337 ;
                rdfs:label "Near Infrared Light Frequency"@en ;
                skos:definition "An Infrared Light Frequency that is between 214 and 400 terahertz."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000156
cco:ont00000156 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000088 ;
                rdfs:label "Hand Gun"@en ;
                skos:definition "A Firearm that is designed to have a relatively short barrel and to be held in one or two hands and to be fired without being braced against the shoulder."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Handgun&oldid=1060570395"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000157
cco:ont00000157 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000084 ;
                rdfs:label "Facial Hair"@en ;
                skos:definition "A Bodily Component that consists of a portion of hair that grows on the face of a human (typically male) or other animal."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000158
cco:ont00000158 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001105 ;
                rdfs:label "Lithium-ion Electric Battery"@en ;
                skos:definition "A Secondary Cell Electric Battery that produces electricity when lithium ions move from anode to cathode."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lithium-ion_battery&oldid=1064099588"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000159
cco:ont00000159 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000798 ;
                rdfs:label "Material Copy of a Timekeeping Instrument"@en ;
                skos:altLabel "Timekeeping Instrument"@en ;
                skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity that is about some temporal region."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Timekeeper&oldid=1061681902"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000160
cco:ont00000160 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000581 ;
                rdfs:label "Manual Tool"@en ;
                skos:altLabel "Hand Tool"@en ;
                skos:definition "A Tool that is designed to be powered by manual labor rather than by an engine."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hand_tool&oldid=1060741381"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000161
cco:ont00000161 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000026 ;
                rdfs:label "Coordinate System Axis"@en ;
                skos:definition "A One-Dimensional Spatial Region defined by a Coordinate System for the purpose of identifying the position of entities along one dimension of the Coordinate System's spatial framework."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000162
cco:ont00000162 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000795 ;
                rdfs:label "Electrical Connector Artifact Function"@en ;
                skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used to join electrical terminations to create an electrical circuit."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000163
cco:ont00000163 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000161 ;
                rdfs:label "z-Axis"@en ;
                skos:definition "A Coordinate System Axis designated by the variable 'z'."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000164
cco:ont00000164 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001010 ;
                rdfs:label "Minimum Ordinal Measurement Information Content Entity"@en ;
                skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the smallest or having the least amount relative to a nominally described set of like entities."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000165
cco:ont00000165 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Criminal Act"@en ;
                skos:definition "A Planned Act committed in violation of rules or laws for which some governing authority (via mechanisms such as legal systems) can prescribe a conviction."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Crime&oldid=1062237249"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000166
cco:ont00000166 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000099 ;
                rdfs:label "Wave Cycle"@en ;
                skos:definition "A Wave Process that consists of a portion of a Wave Process that begins at an arbitrary point of the Wave Process and ends at the next point when the pattern of the Wave Process begins to repeat."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000167
cco:ont00000167 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001173 ;
                rdfs:label "Large-Scale Rocket Launcher"@en ;
                skos:definition "A Rocket Launcher that is designed to contain multiple Rocket Launchers."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000168
cco:ont00000168 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000433 ;
                rdfs:label "Act of Interpersonal Relationship"@en ;
                skos:definition "An Act of Association between two or more Persons that may range from fleeting to enduring."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Interpersonal_relationship&oldid=1060991304"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000169
cco:ont00000169 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000150 ;
                rdfs:label "Very High Frequency"@en ;
                skos:altLabel "ITU Band Number 8"@en ;
                skos:definition "A Radio Frequency that is between 30 and 300 MHz."@en ;
                skos:scopeNote "The corresponding Wavelength range is 10–1 m"@en ;
                cco:ont00001753 "VHF" ;
                cco:ont00001754 "International Telecommunication Union (ITU) and IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000170
cco:ont00000170 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000018 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001944 ;
                                  owl:someValuesFrom cco:ont00000205
                                ] ;
                rdfs:label "Object Track Point"@en ;
                skos:definition "A Zero-Dimensional Spatial Region that is an idealized point where an Object is or was located during some motion."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000171
cco:ont00000171 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000344 ;
                rdfs:label "Detergent Artifact Function"@en ;
                skos:definition "A Surfactant Artifact Function that is realized in a process that cleans substances in dilute solutions."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Detergent&oldid=1064079329"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000172
cco:ont00000172 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000483 ;
                rdfs:label "Base of Operations"@en ;
                skos:altLabel "Main Operating Base"@en ;
                skos:definition "A Military Base with permanently stationed operating forces, robust Infrastructure, and strengthened force protection measures such that it is designed to launch and support large-scale operations, support smaller or less-permanent bases, and organize supply facilities."@en ;
                cco:ont00001753 "MOB" ;
                cco:ont00001754 "http://www.jcs.mil/Portals/36/Documents/Doctrine/pubs/dictionary.pdf?ver=2018-08-27-122235-653" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000173
cco:ont00000173 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "Civilian Role"@en ;
                skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents not being part of either an Armed Force or police force."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000174
cco:ont00000174 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000547 ;
                rdfs:label "Ultraviolet Telescope"@en ;
                skos:altLabel "UV Telescope"@en ;
                skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing ultraviolet light to form an enhanced image of the Object."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000175
cco:ont00000175 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "Organization Member Role"@en ;
                skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill as a member of some Organization."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000176
cco:ont00000176 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00001180
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000196 ;
                                                             owl:someValuesFrom cco:ont00000898
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00001180 ;
                dct:bibliographicCitation "Lee, David S., and Brad Glosserman. “How Companies Can Navigate Today’s Geopolitical Risks.” Harvard Business Review, 28 Nov. 2022. hbr.org, https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks." ,
                                          "University, Utah State. Geopolitical Power | Aggies GO. https://chass.usu.edu/international-studies/aggies-go/power. Accessed 6 Apr. 2023." ;
                dct:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
                dct:creator "https://cubrc.org"^^xsd:anyURI ;
                rdfs:label "Geopolitical Organization"@en ;
                skos:definition "An Organization that bears a Geopolitical Power Role."@en ;
                skos:prefLabel "Geopolitical Organization"@en ;
                cco:ont00001754 "https://chass.usu.edu/international-studies/aggies-go/power" ,
                                "https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000177
cco:ont00000177 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                rdfs:label "Affordance"@en ;
                skos:definition "A Realizable Entity of an Independent Continuant that creates an opportunity for an Agent to realize some Agent Capability or Disposition in some Act."@en ;
                cco:ont00001754 "J. J. Gibson, \"The Theory of Affordances,\" in The Ecological Approach to Visual Perception (NY: Taylor & Francis Group, 1986): 127-143. Available at: https://archive.org/details/pdfy-u5hmFOvOM2Civ4Gz/page/n70/mode/1up."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000178
cco:ont00000178 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001150 ;
                rdfs:label "Arrow"@en ;
                skos:definition "A Portion of Ammunition that is designed to be fired from a Bow and consists of a long straight stiff shaft with stabilizers (fletchings) and a slot (the nock) on one end and a weighted tip (the arrowhead) on the other end."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Arrow&oldid=1058445874"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000179
cco:ont00000179 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000570 ;
                rdfs:label "Thrust"@en ;
                skos:definition "A Force that is equal in magnitude to but in the opposite direction of an exerted Force and which is used to describe the forward Force of a Jet or Rocket Engine in reaction to the Acceleration of its Reaction Mass in the opposite direction."@en ;
                skos:scopeNote "More generally, Thrust is the propulsive Force of a Rocket."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000180
cco:ont00000180 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000410 ;
                rdfs:label "Hotel"@en ;
                skos:definition "A Residential Facility that is designed to provide lodging that is paid for on a short-term basis."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hotel&oldid=1063583593"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000181
cco:ont00000181 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000089 ;
                rdfs:label "Language Skill"@en ;
                skos:definition "A Skill that is realized by an Act which is prescribed by a Language."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000182
cco:ont00000182 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000123 ;
                rdfs:label "Act of Thanking"@en ;
                skos:definition "An Act of Expressive Communication performed by expressing gratitude."@en ;
                cco:ont00001754 " http://www.merriam-webster.com/dictionary/thanks" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000183
cco:ont00000183 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Fragrance Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in processes of emitting a pleasant or sweet odor."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Perfume&oldid=1062785740"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000184
cco:ont00000184 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000202 ;
                rdfs:label "Axial Rotation Period"@en ;
                skos:definition "A Temporal Interval that is equal to the length of time required for a spinning Object to complete one rotation around its Axis of Rotation."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000185
cco:ont00000185 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001059 ;
                rdfs:label "Blunt"@en ;
                skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer not having a sharp edge or point."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000186
cco:ont00000186 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001010 ;
                rdfs:label "Artifact Version Ordinality"@en ;
                skos:definition "An Ordinal Measurement Information Content Entity that is about the form of a Material Artifact which differs in some respects from previous or future forms of that Material Artifact."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000187
cco:ont00000187 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "Authority Role"@en ;
                skos:definition "A Role that is realized by Processes which create, modify, transfer, or eliminate Process Regulations or other Authority Roles, and inheres in an Agent in virtue of collective acceptance of that Agent's ability to issue binding directives."@en ;
                skos:scopeNote "Authority Roles are externally grounded in a social group's collective acceptance of the binding force of the agent's directives. This acceptance can be direct or indirect (e.g., by accepting a procedure for deputizing authority). Such collective acceptance need not be explicit or cognized; rather, collective acceptance can be expressed in the dispositions and attitudes of people toward that agent's directives. In many cases, the directives issued by Authority Roles are backed by threats of punishment or sanction for failure to comply, but the issuing of a directive plus a threat is not sufficient for authority. Rather, an agent's authority must be accepted either directly or indirectly through the acceptance of a procedure for bestowing authority (e.g., elections)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000188
cco:ont00000188 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000026 ;
                rdfs:label "Ground Track"@en ;
                skos:altLabel "Ground Trace"@en ;
                skos:definition "A One-Dimensional Spatial Region defined by the line formed on the surface of an Astronomical Body by projecting an imaginary line from the center of the tracked Object to the center of the Astronomical Body as the Object travels above the surface."@en ;
                skos:scopeNote "The Ground Track is the line on the surface of the Earth or other Astronomical Body that is located directly below the Object Track."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ground_track&oldid=1058025510"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000189
cco:ont00000189 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000798 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000101 ;
                                  owl:someValuesFrom cco:ont00002002
                                ] ;
                rdfs:label "Material Copy of a Certificate"@en ;
                skos:altLabel "Certificate"@en ;
                skos:definition "An Information Bearing Artifact that bears an Information Content Entity which attests to certain demonstrated characteristics of an Object, Person, or Organization."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/degree" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000190
cco:ont00000190 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001353 ;
                rdfs:label "Minimum Speed Artifact Function"@en ;
                skos:definition "A Speed Artifact Function that is realized in some process in which the Material Artifact bearing the Artifact Function attains the lowest speed at which that Material Artifact is designed to operate."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000191
cco:ont00000191 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000978 ,
                                cco:ont00001147 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001803 ;
                                  owl:someValuesFrom cco:ont00000920
                                ] ;
                rdfs:label "Act of Homicide"@en ;
                skos:definition "An Act of Violence which causes the unlawful killing of another person."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000192
cco:ont00000192 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000171 ;
                                  owl:someValuesFrom cco:ont00001341
                                ] ;
                rdfs:label "Facility"@en ;
                skos:definition "A Material Artifact that is designed as a building or campus dedicated to some specific purpose."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000193
cco:ont00000193 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000059 ;
                rdfs:label "Telephone Subscriber Line"@en ;
                skos:definition "A Telephone Line that connects a Communication Endpoint to another node in a Telecommunication Network to enable service to a user's Telephone."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_line&oldid=1063429738"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000194
cco:ont00000194 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000795 ;
                rdfs:label "Electrical Contact Artifact Function"@en ;
                skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used as an endpoint of an electrical circuit from which an electrical current is passed via physical contact with the endpoint."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000195
cco:ont00000195 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001078 ;
                rdfs:label "Heliport"@en ;
                skos:definition "An Airport that is designed for launching, receiving, and housing Rotorcraft."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heliport&oldid=1049937701"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000196
cco:ont00000196 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000378 ;
                rdfs:label "Purple"@en ;
                skos:definition "A Color that is aproximately midway between Red and Blue."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000197
cco:ont00000197 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000035 ;
                rdfs:label "Process Beginning"@en ;
                skos:definition "A Process Boundary that occupies a Zero-Dimensional Temporal Region that is the starting instant of the One-Dimensional Temporal Region that the Process, of which the Process Boundary is a part, occupies."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000198
cco:ont00000198 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Sound Level"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of the level (the loudness) of sounds."@en ;
                skos:example "decibels, sones" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000199
cco:ont00000199 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000771 ;
                rdfs:label "Camera"@en ;
                skos:definition "An Imaging Instrument that is designed to form and digitally or physically record an image of an entity."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/camera" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000200
cco:ont00000200 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000890 ;
                rdfs:label "Act of Pilgrimage"@en ;
                skos:definition "An Act of Travel to a location of importance to a person's beliefs and faith."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pilgrimage&oldid=1056524204"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000201
cco:ont00000201 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000065 ;
                rdfs:label "Act of Change of Residence"@en ;
                skos:definition "An Act of Location Change involving one or more Persons moving from one place of residence to another."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000202
cco:ont00000202 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001075 ;
                rdfs:label "Act of Terrorist Training Instruction"@en ;
                skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Terrorist Organization by imparting knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature to an Agent either directly or indirectly through some communication medium."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=terrorism" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000203
cco:ont00000203 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000293 ;
                rdfs:label "Event Status Nominal Information Content Entity"@en ;
                skos:definition "A Nominal Measurement Information Content Entity that is a measurement of the current state of a process."@en ;
                skos:example "proposed, approved, planned, in progress, completed, failed, or successful" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000204
cco:ont00000204 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001104 ;
                rdfs:label "Rifle"@en ;
                skos:definition "A Long Gun that is designed to have a rifled barrel and to fire single Bullets over long ranges with high accuracy."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rifle&oldid=1056172452"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000205
cco:ont00000205 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000026 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001855 ;
                                  owl:someValuesFrom cco:ont00000170
                                ] ;
                rdfs:label "Object Track"@en ;
                skos:definition "A One-Dimensional Spatial Region that consists of the idealized line along which an Object has traversed during some motion."@en ;
                skos:scopeNote "The exact line of the Object Track may be drawn based on the Center of Mass of the Object or another reference point, such as the location of a transponder beacon or the center of a radar cross-section, depending on the Object being tracked."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000206
cco:ont00000206 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Friction Reduction Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized in processes of reducing the force resisting the relative motion of surfaces in contact."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Friction&oldid=1061569068"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000207
cco:ont00000207 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000142 ;
                rdfs:label "One-Dimensional Geospatial Boundary"@en ;
                skos:definition "A Fiat Line that is a boundary of some Geospatial Region."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000208
cco:ont00000208 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000123 ;
                rdfs:label "Act of Congratulating"@en ;
                skos:definition "An Act of Expressive Communication performed by expressing vicarious pleasure to a person on the occasion of their success or good fortune."@en ;
                cco:ont00001754 "http://www.merriam-webster.com/dictionary/congratulate" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000209
cco:ont00000209 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000313 ;
                rdfs:label "Sound Wavelength"@en ;
                skos:definition "A Wavelength that is the distance a Sound Wave traverses during one Wave Cycle."@en ;
                cco:ont00001754 "http://www.physicsclassroom.com/Class/waves/u10l2b.cfm" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000210
cco:ont00000210 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Engine"@en ;
                skos:altLabel "Motor"@en ;
                skos:definition "A Material Artifact that is designed to convert one form of energy into mechanical energy."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Engine&oldid=1063879193"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000211
cco:ont00000211 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000202 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001924 ;
                                  owl:someValuesFrom cco:ont00000800
                                ] ;
                rdfs:label "Multi-Day Temporal Interval"@en ;
                skos:definition "A one-dimensional temporal region that is measured in Days and spans at least one Day."@en ;
                skos:scopeNote "This is a defined class."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000212
cco:ont00000212 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000445 ;
                rdfs:label "Chemical Weapon"@en ;
                skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of releasing toxic chemicals."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_weapon&oldid=1054342645"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000213
cco:ont00000213 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000472 ;
                rdfs:label "Subcontinent"@en ;
                skos:definition "A Geospatial Region that is bounded by a large, relatively self-contained landmass forming a subdivision of a Continent."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Continent&oldid=1064057312"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000214
cco:ont00000214 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000289 ;
                rdfs:label "Moving Target Indication Artifact Function"@en ;
                skos:definition "A Radar Imaging Artifact Function that inheres in Material Artifacts that are designed to identify and produce visual representations of moving entities by using a radar to emit successive phase coherent pulses, which are sampled and added to the subsequent pulse to cancel out signals from non-moving entities such that only signals from moving entities remain and are displayed."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000215
cco:ont00000215 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000547 ;
                rdfs:label "Radio Telescope"@en ;
                skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves to form an enhanced image of the Object."@en ;
                skos:scopeNote "A Radio Telescope consists of a specialized Antenna and a Radio Receiver and is typically used to receive radio waves from sources in outer space."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_telescope&oldid=1052819190"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000216
cco:ont00000216 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001150 ;
                rdfs:label "Shell"@en ;
                skos:definition "A Portion of Ammunition that is designed to be a non-self-propelled projectile and to carry a payload (explosive or other) over a relatively short distance."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Shell_(projectile)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000217
cco:ont00000217 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Area"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of two-dimensional regions or Geospatial Regions."@en ;
                skos:example "square feet, square meters, acre, hectare" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000218
cco:ont00000218 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000026 ;
                rdfs:label "Major Axis"@en ;
                skos:definition "A One-Dimensional Spatial Region that is the longest line segment that connects two points on the edge of an Ellipse."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000219
cco:ont00000219 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001009 ;
                rdfs:label "Reflecting Optical Telescope"@en ;
                skos:altLabel "Reflecting Telescope"@en ,
                              "Reflector"@en ;
                skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light via reflection through the use of one or more curved Mirrors to form an enhanced image of the Object."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reflecting_telescope&oldid=1062982683"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000220
cco:ont00000220 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000881 ;
                rdfs:label "Ammunition Depot"@en ;
                skos:definition "A Storage Facility that is designed to store Portions of Ammunition."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ammunition_dump&oldid=1044466765"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000221
cco:ont00000221 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000026 ;
                rdfs:label "Semi-Minor Axis"@en ;
                skos:definition "A One-Dimensional Spatial Region that is equal to half the length of the Minor Axis of an Ellipse."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000222
cco:ont00000222 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000530 ;
                rdfs:label "Presence Frequency"@en ;
                skos:definition "A Sonic Frequency that is between 4 and 6 kHz."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000223
cco:ont00000223 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000203 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:someValuesFrom cco:ont00000800
                                ] ;
                rdfs:label "Time of Day"@en ;
                skos:definition "A Temporal Instant that is part of a Day."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000224
cco:ont00000224 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001197 ;
                rdfs:label "Populated place"@en ;
                skos:definition "An Anthropogenic Feature at which people live or have lived."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Human_settlement&oldid=1060418164"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000225
cco:ont00000225 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000202 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001869 ;
                                  owl:someValuesFrom cco:ont00000832
                                ] ;
                rdfs:label "Month"@en ;
                skos:definition "A Temporal Interval that is based on the approximate length of time required for a Natural Satellite to complete one cycle of its rotational motion around its Primary Body."@en ;
                skos:scopeNote "Unless otherwise specified, it is assumed that a Month is specified relative to the Rotational Motion of the Moon around the Earth. Earth Months are approximately equal to four consecutive Weeks or 30 consecutive Days."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=month" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000226
cco:ont00000226 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Transportation Facility"@en ;
                skos:definition "A Facility that is designed for commencing or concluding the transportation of transportation artifacts, or for housing transportation artifacts."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transport&oldid=1063526665"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000227
cco:ont00000227 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000674 ;
                rdfs:label "Julian Year"@en ;
                skos:definition "A Calendar Year in the Julian Calendar."@en ;
                skos:scopeNote "A Julian Year begins concurrently with January 1, ends concurrently with December 31, and has an average duration of exactly 365.25 Julian Days. Julian Years are typically indicated by prefixing a capital 'J' in front of the Year number, e.g. J2000.0 or J2018."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000228
cco:ont00000228 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000005 ;
                rdfs:label "Planned Act"@en ;
                skos:altLabel "Intentional Act"@en ;
                skos:definition "An Act in which at least one Agent plays a causative role and which is prescribed by some Prescriptive Information Content Entity held by at least one of the Agents."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000229
cco:ont00000229 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Power"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of rates of work."@en ;
                skos:example "watt, horsepower" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000230
cco:ont00000230 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000136 ;
                rdfs:label "Diffraction Grating"@en ;
                skos:definition "An Optical Instrument with a periodic structure that is designed to split and defract a beam of light into several beams travelling in different directions."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Diffraction_grating&oldid=1060463366"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000231
cco:ont00000231 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001051 ;
                rdfs:label "Torpedo Tube"@en ;
                skos:definition "A Projectile Launcher that is designed to launch Torpedoes."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torpedo_tube&oldid=1063672665"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000232
cco:ont00000232 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000677 ;
                rdfs:label "Pumping Station"@en ;
                skos:definition "A Product Transport Facility that is designed to pump fluids from one place to another."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pumping_station&oldid=1045678418"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000233
cco:ont00000233 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001278 ;
                rdfs:label "Stock Certificate"@en ;
                skos:definition "Stock that consists of a Certificate."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000234
cco:ont00000234 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Training"@en ;
                skos:definition "A Planned Act in which knowledge, skills or values are imparted from one or more Agents to at least one other Agent."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000235
cco:ont00000235 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000687 ;
                rdfs:label "Act of Vocational Training Acquisition"@en ;
                skos:definition "An Act of Training Acquisition performed by an Agent by acquiring skills required for a specific occupation in industry, agriculture or trade from an Agent or communication medium that realizes a capacity derived from its affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=vocational%20training" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000236
cco:ont00000236 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Lighting System"@en ;
                skos:definition "A Material Artifact that is designed to emit light within some area."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000237
cco:ont00000237 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000687 ;
                rdfs:label "Act of Terrorist Training Acquisition"@en ;
                skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature from an Agent or communication medium that realizes a capacity derived from its affiliation with a Terrorist Organization."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=terrorism" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000238
cco:ont00000238 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Propeller"@en ;
                skos:altLabel "Propelling Screw"@en ;
                skos:definition "A Material Artifact that is designed to convert rotary motion from an Engine or other mechanical Power Source into propulsive Force."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Propeller_(aeronautics)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000239
cco:ont00000239 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Mass"@en ;
                skos:definition "A Measurement Unit that is used as a standard for measurement of an object's resistance to Acceleration when a Force is applied to the object."@en ;
                skos:example "ounce, gram, pound" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000240
cco:ont00000240 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001162 ;
                rdfs:label "Act of Oath Taking"@en ;
                skos:definition "An Act of Commissive Communication performed by stating or promising, usually calling upon something or someone that the oath maker considers sacred."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Oath&oldid=1052326917"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000243
cco:ont00000243 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Heat Sink"@en ;
                skos:definition "A Material Artifact that is designed to regulate the temperature of a computer by the passive transfer of heat away from other components in the computer."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heat_sink&oldid=1062822080"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000244
cco:ont00000244 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001153 ;
                rdfs:label "Fragmentation Artifact Function"@en ;
                skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of a detonation which causes fragmentation."@en ;
                cco:ont00001754 "http://www.dictionary.com/browse/fragmentation" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000245
cco:ont00000245 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000782 ;
                rdfs:label "Petroleum Manufacturing Facility"@en ;
                skos:definition "A Factory that is designed to manufacture petroleum-based products."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Petroleum&oldid=1062956217"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000246
cco:ont00000246 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000135 ;
                rdfs:label "Stasis of Realizable Entity"@en ;
                skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Realizable Entity that remains unchanged during a Temporal Interval."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000247
cco:ont00000247 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001326 ;
                rdfs:label "Road"@en ;
                skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to travel from one location to another."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Road&oldid=1063402841" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000248
cco:ont00000248 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000782 ;
                rdfs:label "Chemical Manufacturing Facility"@en ;
                skos:definition "A Factory that is designed to manufacture or process chemicals."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_industry&oldid=1061177027"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000249
cco:ont00000249 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Shaft"@en ;
                skos:definition "A Material Artifact that is designed to rotate and transmit Torque, Power, or Rotational Motion from one machine element to another."@en ;
                skos:scopeNote "A Shaft is usually used to connect other components of a drive train that cannot be connected directly either because of the distance between them or the need to allow for relative movement between those components."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Shaft&oldid=1023963656"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000250
cco:ont00000250 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000865 ;
                rdfs:label "Loss of Realizable Entity"@en ;
                skos:definition "A Loss of Specifically Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Realizable Entity."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000251
cco:ont00000251 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000472 ;
                rdfs:label "Continent"@en ;
                skos:definition "A Geospatial Region that is bounded by any of the Earth's main continuous expanses of land."@en ;
                cco:ont00001754 "JC3IEDM version 3.0.2" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000252
cco:ont00000252 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000256 ;
                rdfs:label "Nozzle"@en ;
                skos:definition "A Fluid Control Artifact that is designed to control the speed, direction, rate, shape, or pressure of the flow of fluid exiting it."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000253
cco:ont00000253 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000030
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000101 ;
                                                             owl:someValuesFrom cco:ont00000958
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf obo:BFO_0000030 ;
                rdfs:label "Information Bearing Entity"@en ;
                skos:altLabel "IBE"@en ,
                              "Information Carrying Entity"@en ;
                skos:definition "An Object upon which an Information Content Entity generically depends."@en ;
                skos:scopeNote "This class continues to use the word ‘bearing’ in its rdfslabel because of potential confusion with the acronym ‘ICE’, which is widely used for information content entity."@en ;
                cco:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000178"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000254
cco:ont00000254 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Transportation Artifact"@en ;
                skos:definition "A Material Artifact that is fixed in place and designed to enable the movement of Vehicles and Agents from one location to another."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000255
cco:ont00000255 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000457 ;
                rdfs:label "Portion of Cryogenic Material"@en ;
                skos:definition "A Portion of Material that has been reduced to a very low temperature (below -180 degrees Celcius)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000256
cco:ont00000256 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Fluid Control Artifact"@en ;
                skos:definition "A Material Artifact that is designed to manipulate the flow of a fluid (i.e. a liquid or a gas)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000257
cco:ont00000257 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000620 ;
                rdfs:label "Radiopaque"@en ;
                skos:altLabel "Radiodense"@en ;
                skos:definition "A Radiopacity that inheres in a bearer in virtue of its capacity to prevent most X-rays from passing through it."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000259
cco:ont00000259 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000225 ;
                rdfs:label "Calendar Month"@en ;
                skos:definition "A Month that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Month."@en ;
                skos:example "January; February; March; April; May; June; July; August; September; October; November; December" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000260
cco:ont00000260 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000675 ;
                rdfs:label "Muzzle Blast"@en ;
                skos:definition "A Sound Wave Process that is caused by a projectile being pushed from the barrel of a firearm by an explosive charge."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000261
cco:ont00000261 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000754 ;
                rdfs:label "Gamma Ray Frequency"@en ;
                skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is above 30 exahertz."@en ;
                skos:scopeNote """Currently gamma radiation is distinguished from x-rays by their source--either inside or outside of the nucleus--rather than by frequency, energy, and wavelength.
https://en.wikipedia.org/wiki/Gamma_ray#Naming_conventions_and_overlap_in_terminology"""@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gamma_ray&oldid=1062115897"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000262
cco:ont00000262 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001102 ;
                rdfs:label "Shop"@en ;
                skos:definition "A Commercial Facility designed to sell small lots of goods to consumers."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Retail&oldid=1061431295"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000263
cco:ont00000263 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001328 ;
                rdfs:label "Clock Time System"@en ;
                skos:definition "A Temporal Reference System that is a convention for keeping and displaying the Time of Day."@en ;
                skos:scopeNote "A single Clock Time System does not provide a complete means for identifying or measuring times. Depending on the particular Clock Time System, it may be compatible for use with one or more other Temporal Reference Systems."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000264
cco:ont00000264 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000020 ;
                rdfs:label "Hydraulic Fluid Reservoir"@en ;
                skos:definition "A Container that is designed to store some hydraulic fluid for use in some Hyrdraulic Power Source."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000265
cco:ont00000265 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001327 ;
                rdfs:label "Election"@en ;
                skos:altLabel "Act of Political Election"@en ;
                skos:definition "A Social Act by which a population chooses an individual to hold public office."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Election&oldid=1063238552"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000266
cco:ont00000266 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001381 ;
                rdfs:label "Hearing Aid"@en ;
                skos:definition "A Medical Artifact that is designed to improve hearing for its user."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hearing_aid&oldid=1062688647"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000267
cco:ont00000267 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000791 ;
                rdfs:label "Catalyst Artifact Function"@en ;
                skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which the rate of a chemical reaction is increased due to the participation of an additional substance, without that substance being consumed in the reaction."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Catalysis&oldid=1063864001"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000268
cco:ont00000268 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001051 ;
                rdfs:label "Cannon"@en ;
                skos:definition "A Projectile Launcher that is designed to use a controlled explosion to launch a relatively large Portion of Ammunition, such as a Round Shot or a Shell, at a significant Velocity."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cannon&oldid=1063792906"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000269
cco:ont00000269 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000903 ;
                rdfs:label "Radio Transmitter"@en ;
                skos:definition "A Radio Communication Instrument that is an electronic device that is designed to generate a radio frequency alternating current, which can be applied to a Radio Antenna to be transmitted as radio waves."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transmitter&oldid=1061735586"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000270
cco:ont00000270 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Educational Facility"@en ;
                skos:definition "A Facility that is designed for facilitating learning, or the acquisition of knowledge, skills, values, beliefs, and habits."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000271
cco:ont00000271 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000639 ;
                rdfs:label "Underground Mine"@en ;
                skos:definition "A Mine that is designed to support the extraction of materials from the ground using underground tunnels and shafts."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Underground_mining_(hard_rock)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000272
cco:ont00000272 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000007 ;
                rdfs:label "Combustion"@en ;
                skos:altLabel "Burning Process"@en ,
                              "Combustion Process"@en ;
                skos:definition "A Natural Process in which a Portion of Fuel or other Material Entity is burned."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000273
cco:ont00000273 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Communication Interference Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to interfere with the transmission of information for the purpose of preventing communication."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000274
cco:ont00000274 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001180 ;
                rdfs:label "Armed Force"@en ;
                skos:definition "An Organization having the Objective to further the foreign and domestic policies of a Government and to defend that body and the nation it represents from external and internal aggressors."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000275
cco:ont00000275 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000398 ;
                rdfs:label "Spatial Reference System"@en ;
                skos:altLabel "Coordinate System"@en ,
                              "Spatial Coordinate System"@en ,
                              "Spatial Reference Frame"@en ;
                skos:definition "A Reference System that describes a set of standards for uniquely identifying the position of an entity or the direction of a vector within a defined spatial region by means of measurements along one or more Coordinate System Axes."@en ;
                skos:scopeNote "Note that, while reference systems and reference frames are treated as synonyms here, some people treat them as related but separate entities. See: http://www.ggos-portal.org/lang_en/GGOS-Portal/EN/Topics/GeodeticApplications/GeodeticReferenceSystemsAndFrames/GeodeticReferenceSystemsAndFrames.html"@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Coordinate_system&oldid=1060461397"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000276
cco:ont00000276 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000891 ;
                rdfs:label "Solar Calendar System"@en ;
                skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of an Astronomical Body's Orbit around the Sun."@en ;
                skos:scopeNote "Unless otherwise specified, a Solar Calendar System is assumed to be relative to the Orbit of the Earth around the Sun."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solar_calendar&oldid=1058016588"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000277
cco:ont00000277 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000445 ;
                rdfs:label "Nuclear Weapon"@en ;
                skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of a destructive nuclear reaction, either through fission or through a combination of fission and fusion."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_weapon&oldid=1060854171"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000278
cco:ont00000278 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000144 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:someValuesFrom cco:ont00001133
                                ] ;
                rdfs:label "Momentum"@en ;
                skos:definition "A Process Profile of an object in Motion that is the product of its Mass and Velocity with respect to a frame of reference."@en ;
                skos:scopeNote "The SI unit of measure for Momentum is Newton seconds (N s)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000279
cco:ont00000279 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000392 ;
                rdfs:label "Enemy Role"@en ;
                skos:definition "An Allegiance Role that inheres in an Agent by virtue of that Agent having committed offensive Acts or exhibited intent to perform such Acts towards a particular Agent or Group of Agents or has been declared as hostile by some appropriate authority."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000280
cco:ont00000280 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001124 ;
                rdfs:label "Torpedo"@en ;
                skos:definition "A Precision-Guided Missile that is designed to be fired into a body of water, be self-propelled through the water, and carry an explosive payload."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torpedo&oldid=1062609830"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000281
cco:ont00000281 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001137 ;
                rdfs:label "Albedo"@en ;
                skos:definition "A Radiation Reflectivity that inheres in a bearer in virtue of the capacity of its surface to reflect incident electromagnetic radiation of a particular wavelength."@en ;
                skos:scopeNote "Albedo is a reflection coefficient and is measured as the ratio of radiation reflected from the surface to the incident radiation. Albedo is dimensionless, can be expressed as a percentage, and is measured on a scale from 0 for no reflection to 1 for perfect reflection of a surface. Albedo depends on the wavelength of the radiation; when no wavelength is specified, it typically refers to some appropriate average across the spectrum of visible light."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Albedo&oldid=1063352646"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000282
cco:ont00000282 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000719 ;
                rdfs:label "Counterfeit Financial Instrument"@en ;
                skos:definition "A Counterfeit Instrument that is designed to be a fake replica of some legally sanctioned Financial Instrument."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Counterfeit_money&oldid=1064052318"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000283
cco:ont00000283 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001360 ;
                rdfs:label "Cylindrical"@en ;
                skos:altLabel "Columnar"@en ;
                skos:definition "A Three Dimensional Shape inhering in a bearer in virtue of the bearer having an elongated shape with round bases."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000284
cco:ont00000284 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                rdfs:label "Strength"@en ;
                skos:definition "A Realizable Entity that is realized when its bearer exerts or resists some power, influence, or force."@en ;
                skos:scopeNote "Strength is intended to be understood broadly here. Physical strength is only one type of Strength. Other subtypes of Strength may include military strength, psychological strength, emotional strength, political strength, technological strength, and so on."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000285
cco:ont00000285 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000269 ;
                rdfs:label "Emergency Locator Transmitter"@en ;
                skos:definition "A Radio Transmitter that is designed to signal distress and provide positional data for the entity it is located on."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Emergency_position-indicating_radiobeacon&oldid=1063407242"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000286
cco:ont00000286 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000100 ;
                rdfs:label "Stasis of Partially Mission Capable Maintenance"@en ;
                skos:definition "A Stasis of Partially Mission Capable during which the participating Continuant is not capable of performing some of its primary functions for the specified Mission due to participating in an Act Of Maintenance."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000287
cco:ont00000287 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001187 ;
                rdfs:label "Inertial Navigation System"@en ;
                skos:altLabel "INS"@en ;
                skos:definition "A Navigation System that is designed to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Inertial_navigation_system&oldid=1063682725"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000288
cco:ont00000288 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Power Source"@en ;
                skos:definition "A Material Artifact that is designed to supply power to some other Material Artifact."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_source&oldid=1032888635"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000289
cco:ont00000289 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000601 ;
                rdfs:label "Radar Imaging Artifact Function"@en ;
                skos:definition "An Imaging Artifact Function that inheres in Material Artifacts that are designed to produce visual representations of entities using radio waves."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000290
cco:ont00000290 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000726 ;
                rdfs:label "Decrease of Specifically Dependent Continuant"@en ;
                skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in some Specifically Dependent Continuant that it bears."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000291
cco:ont00000291 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000566 ;
                rdfs:label "Act of Decoy Use"@en ;
                skos:definition "An Act of Artifact Employment in which some Agent uses some Decoy."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000292
cco:ont00000292 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000686
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001916 ;
                                                             owl:someValuesFrom cco:ont00000995
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000686 ;
                rdfs:label "Artifact Identifier"@en ;
                skos:definition "A Designative Information Content Entity which designates some Material Artifact."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000293
cco:ont00000293 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00001163
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001868 ;
                                                             owl:someValuesFrom obo:BFO_0000001
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00001163 ;
                owl:disjointWith cco:ont00001010 ,
                                 cco:ont00001022 ,
                                 cco:ont00001364 ;
                rdfs:label "Nominal Measurement Information Content Entity"@en ;
                skos:definition "A Measurement Information Content Entity that consists of a symbol that classifies Entities according to some shared, possibly arbitrary, characteristic."@en ;
                skos:example "The sentence \"January 20, 1985 was a cold day in Chicago, IL\" is the carrier of a nominal measurement."@en ,
                             "a measurement that classifies automobiles as sedans, coupes, hatchbacks, or convertibles" ,
                             "a measurement that classifies military intelligence as strategic, operational, or tactical" ,
                             "a measurement that classifies rocks as igneous, sedimentary, or metamorphic" ;
                skos:scopeNote "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000294
cco:ont00000294 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000533 ;
                rdfs:label "Air-Breathing Jet Engine"@en ;
                skos:altLabel "Ducted Jet Engine"@en ;
                skos:definition "A Jet Engine that is propelled by a jet of hot exhaust gases formed from air that is drawn into the Engine via an Air Inlet."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Airbreathing_jet_engine&oldid=1062364308"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000295
cco:ont00000295 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ;
                rdfs:label "Wetness"@en ;
                skos:definition "A Quality that inheres in a bearer in virtue of the degree to which the bearer is covered by a liquid, typically on a continuum of dry to wet."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000296
cco:ont00000296 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000763 ;
                rdfs:label "Angular Velocity"@en ;
                skos:altLabel "Rotational Velocity"@en ;
                skos:definition "A Velocity that is characterized by both the angular Speed of an object and the Axis about which the object is Rotating."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Angular_velocity&oldid=1060081663"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000297
cco:ont00000297 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000024 ;
                rdfs:label "Portion of Hydrosphere"@en ;
                skos:definition "A fiat object part of the combined mass of water found on, under, and above the surface of a natural satellite"@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hydrosphere&oldid=1128848972"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000298
cco:ont00000298 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001173 ;
                rdfs:label "Shoulder-Fired Rocket Launcher"@en ;
                skos:definition "A Rocket Launcher that is designed to be small enough to be carried by a single person and fired while supported on the person's shoulder."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000299
cco:ont00000299 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000715 ;
                rdfs:label "Prosthetic Leg"@en ;
                skos:definition "A Prosthesis that is designed to replace a missing leg."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000300
cco:ont00000300 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000027 ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000115 ;
                                                         owl:someValuesFrom cco:ont00001017
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000115 ;
                                                         owl:allValuesFrom cco:ont00001017
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                rdfs:label "Group of Agents"@en ;
                skos:definition "An Object Aggregate that has only Agents as member parts."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000301
cco:ont00000301 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000663 ;
                rdfs:label "Vehicle Transmission"@en ;
                skos:altLabel "Gearbox"@en ,
                              "Transmission"@en ;
                skos:definition "A Power Transmission Artifact that is designed to vary the output speed and torque in a rotating power transfer system."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Transmission_(mechanics)"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000302
cco:ont00000302 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001049 ;
                rdfs:label "Alternating Current Power Source"@en ;
                skos:definition "An Electrical Power Source that is designed to transfer electrical power in the form of alternating current."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000303
cco:ont00000303 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001036 ;
                rdfs:label "Intercommunication System"@en ;
                skos:definition "A Communication System that is designed to enable some Act of Communication between end points within a building, small collection of buildings, or within a small area of service."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Intercom&oldid=1055934442"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000304
cco:ont00000304 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000771 ;
                rdfs:label "Microscope"@en ;
                skos:definition "An Imaging Instrument that is designed to enable users to see Objects that are otherwise too small to be seen by the naked eye by producing a significantly enlarged image of the Object."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Microscope&oldid=1059024357"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000305
cco:ont00000305 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000380 ;
                rdfs:label "Sound Pressure"@en ;
                skos:altLabel "Acoustic Pressure"@en ;
                skos:definition "A Pressure that is caused by a Sound Wave and is a local deviation from the ambient Pressure."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000306
cco:ont00000306 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001370 ;
                rdfs:label "Hinge"@en ;
                skos:definition "A Machine Bearing that is designed to limit the angle of Rotation between two solid objects."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hinge&oldid=1059935559"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000307
cco:ont00000307 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001084 ;
                rdfs:label "Portion of Food"@en ;
                skos:definition "A Portion of Processed Material that is designed to be consumed and ingested for nutrition or taste."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Food&oldid=1062824590"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000308
cco:ont00000308 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001226 ;
                rdfs:label "Act of Military Service"@en ;
                skos:definition "An Act of Employment by an Organization wherein a Person serves as a member of a Military Force, whether voluntarily or by conscription."@en ;
                cco:ont00001754 "http://www.collinsdictionary.com/dictionary/english/military-service" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000309
cco:ont00000309 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001301 ;
                rdfs:label "Healthcare Artifact Function"@en ;
                skos:definition "A Service Artifact Function that is realized in processes of treating and preventing illness."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Health_care&oldid=1064015344"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000310
cco:ont00000310 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000552 ;
                rdfs:label "Grenade"@en ;
                skos:altLabel "Hand Grenade"@en ;
                skos:definition "An Explosive Weapon that is designed to be relatively small and to be thrown by hand."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Grenade&oldid=1060366148"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000311
cco:ont00000311 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001999 ;
                rdfs:label "Filtration Artifact Function"@en ;
                skos:definition "A Filter Function that is realized in a process in which some solid entity is prevented from moving along with some quantity of liquid."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Filtration&oldid=1061655528"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000312
cco:ont00000312 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000007 ;
                rdfs:label "Propulsion Process"@en ;
                skos:definition "A Natural Process in which one or more Forces are generated and applied to a participating Object such that the Object is set in Motion or has the direction or magnitude of its Motion altered."@en ;
                skos:example "a twin-engine turboprop plane rotating both of its propellers against a portion of atmosphere to propel the plane forward" ,
                             "an apple falling to the ground under the power of Earth's gravitational force" ,
                             "burning a portion of fuel to produce exhaust that is ejected through a jet nozzle to propel a rocket and its payload" ,
                             "heat from a fire causing ashes to rise into the sky" ,
                             "launching a water balloon using a sling shot" ,
                             "the wind blowing leaves across a lawn" ,
                             "turning a paddle wheel against a portion of water to propel the paddle boat forward" ;
                skos:scopeNote "In each case, a Propulsion Process minimally involves the Object being propelled, a Reaction Mass (e.g. a portion of water, atmosphere, exhaust, etc.), and the Force(s) acting between these two entities."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000313
cco:ont00000313 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000752 ;
                rdfs:label "Wavelength"@en ;
                skos:definition "A Wave Process Profile that is the distance the Wave Process traverses during one Wave Cycle."@en ;
                skos:scopeNote "Assuming a non-dispersive media, the Wavelength will be the inverse of the Frequency."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000314
cco:ont00000314 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000197 ;
                                  owl:someValuesFrom cco:ont00000253
                                ] ;
                rdfs:label "Information Quality Entity"@en ;
                skos:altLabel "IQE"@en ;
                skos:definition "A Quality that concretizes some Information Content Entity."@en ;
                skos:scopeNote "Typically, an IQE will be a complex pattern made up of multiple qualities joined together spatially."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000315
cco:ont00000315 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000918 ;
                rdfs:label "Telecommunication Switching Node"@en ;
                skos:definition "A Telecommunication Network Node that is capable of redirecting a communication transmission to another Telecommunication Network Node."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications_network&oldid=1063347482"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000316
cco:ont00000316 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000255 ;
                rdfs:label "Portion of Liquid Helium"@en ;
                skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid helium."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000317
cco:ont00000317 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001218 ;
                rdfs:label "Electronic Signal Processing Artifact Function"@en ;
                skos:definition "A Signal Processing Artifact Function that inheres in Material Artifacts that are designed to process or transfer information contained in electronic signals."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000318
cco:ont00000318 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000016 ;
                rdfs:label "Disease"@en ;
                skos:definition "A Disposition to undergo pathological processes that exists in an organism because of one or more disorders in that organism."@en ;
                cco:ont00001754 "http://purl.obolibrary.org/obo/OGMS_0000031" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000319
cco:ont00000319 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001942 ;
                                  owl:someValuesFrom cco:ont00000995
                                ] ;
                rdfs:label "Artifact Design"@en ;
                skos:definition "A Prescriptive Information Content Entity that is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Design&oldid=1063941625"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000320
cco:ont00000320 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001251 ;
                rdfs:label "Act of Reconnaissance"@en ;
                skos:definition "An Act of Intelligence Gathering used to determine an Agent's disposition and intention; the composition and capabilities of Equipment and Facilities, and the surrounding landforms and weather conditions."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reconnaissance&oldid=1038843823"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000321
cco:ont00000321 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001301 ;
                rdfs:label "Residential Artifact Function"@en ;
                skos:definition "A Service Artifact Function that is realized in processes of residing in a dwelling or home."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Residence&oldid=1019728937"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000322
cco:ont00000322 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000836 ;
                rdfs:label "Act of Funding"@en ;
                skos:definition "An Act of Financial Instrument Use in which an Agent (the Funder) provides some Financial Instrument to another Agent (the recipient of the funds) as a resource pool that is earmarked by the Funder for a future transaction."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000323
cco:ont00000323 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000034 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000197 ;
                                  owl:someValuesFrom cco:ont00000995
                                ] ;
                rdfs:label "Artifact Function"@en ;
                skos:definition "A Function that inheres in some Material Artifact in virtue of that Material Artifact being designed to be used in processes that require that Function to be realized."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000324
cco:ont00000324 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001367 ;
                rdfs:label "Width"@en ;
                skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a horizontal direction."@en ;
                cco:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000325
cco:ont00000325 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000903 ;
                rdfs:label "Radio Transponder"@en ;
                skos:altLabel "Transmitter-Responder"@en ;
                skos:definition "A Radio Communication Instrument that is an electronic device that acts as both a Radio Transmitter and responder and is used to wirelessly receive and transmit electrical signals."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000327
cco:ont00000327 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ;
                rdfs:label "Texture"@en ;
                skos:definition "A Quality that inheres in a bearer in virtue of the size, shape, and distribution of features on its surface, typically on a continuum from smooth to rough."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000328
cco:ont00000328 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000870 ;
                rdfs:label "Transportation Infrastructure"@en ;
                skos:definition "An Infrastructure System that has continuant part one or more Transportation Artifacts and bears a function that, if realized, is realized in Acts of Cargo Transportation"@en ;
                cco:ont00001754 "http://www.cfr.org/infrastructure/transportation-infrastructure-moving-america/p18611" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000329
cco:ont00000329 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000202 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001924 ;
                                  owl:someValuesFrom cco:ont00000225
                                ] ;
                rdfs:label "Multi-Month Temporal Interval"@en ;
                skos:definition "A one-dimensional temporal region that is measured in Months and spans at least one Month."@en ;
                skos:scopeNote "This is a defined class."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000330
cco:ont00000330 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001076 ;
                rdfs:label "Thermal Power Plant"@en ;
                skos:definition "An Electric Power Station that is designed to convert heat energy into electrical energy."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermal_power_station&oldid=1062208548"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000331
cco:ont00000331 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000410 ;
                rdfs:label "House"@en ;
                skos:definition "A Residential Facility that is designed to provide a self-standing, permanent residence for an individual, family, household, multiple families, or similar-sized group."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=House&oldid=1062818553"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000332
cco:ont00000332 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Training Camp"@en ;
                skos:definition "A Facility that is designed for rigorous and focused training in order to learn or improve skills, usually involving physical actions."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Training_camp&oldid=1059977631"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000333
cco:ont00000333 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000394 ;
                rdfs:label "Gas Turbine"@en ;
                skos:altLabel "Combustion Turbine"@en ;
                skos:definition "An Internal Combustion Engine that has a rotating compressor and a turbine and is designed to operate utilizing continous Combustion to produce Thrust, either directly via exhaust or indirectly via a prop."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gas_turbine&oldid=1062398125"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000334
cco:ont00000334 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000303 ;
                rdfs:label "Interphone"@en ;
                skos:definition "An Intercommunication System that that is designed to facilitate some Act of Communication between agents by means of audio messages."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000335
cco:ont00000335 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000819 ;
                rdfs:label "Stasis of Generically Dependent Continuant"@en ;
                skos:definition "A Stasis in which some Independent Continuant bears some Generically Dependent Continuant that remains unchanged during a Temporal Interval."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000336
cco:ont00000336 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000410 ;
                rdfs:label "Apartment Building"@en ;
                skos:definition "A Residential Facility that is designed to contain multiple permanent residences comprised of a suite of rooms."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Apartment&oldid=1064019048"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000337
cco:ont00000337 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001029 ;
                rdfs:label "Rocket-Propelled Grenade"@en ;
                skos:definition "An Unguided Rocket that is designed to contain an explosive warhead, be fired from a Shoulder-Fired Rocket Launcher, and be used against Tanks."@en ;
                cco:ont00001753 "RPG" ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket-propelled_grenade&oldid=1063641548"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000338
cco:ont00000338 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000256 ;
                rdfs:label "Fan"@en ;
                skos:definition "A Fluid Control Artifact that consists of a rotating arrangement of vanes or blades that are designed to act on a portion of fluid to create flow within it."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Fan_(machine)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000339
cco:ont00000339 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Agricultural Facility"@en ;
                skos:definition "A Facility that is designed as a building or campus for agricultural processes with the aim of cultivating animals, plants, or fungi for food, fiber, biofuel, medicinal plants, or other products to sustain and enhance human life."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Agriculture&oldid=1063222666"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000340
cco:ont00000340 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000268 ;
                rdfs:label "Mortar"@en ;
                skos:definition "A Cannon that is designed to fire projectiles at relatively low velocities over relatively short ranges."@en ;
                cco:ont00001754 "https://en.wikipedia.org/wiki/Mortar_(weapon)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000341
cco:ont00000341 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000715 ;
                rdfs:label "Prosthetic Arm"@en ;
                skos:definition "A Prosthesis that is designed to replace a missing arm."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000342
cco:ont00000342 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Brake"@en ;
                skos:definition "A Material Artifact that is designed to inhibit the Vehicle's Motion by absorbing energy from a moving system."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Brake&oldid=1047693009"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000343
cco:ont00000343 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000634 ;
                rdfs:label "Reciprocating Steam Engine"@en ;
                skos:definition "A Steam Engine that is designed to use one or more reciprocating pistons to convert pressure into a rotating motion."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reciprocating_engine&oldid=1057783145"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000344
cco:ont00000344 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001281 ;
                rdfs:label "Surfactant Artifact Function"@en ;
                skos:definition "An Emulsifier Artifact Function that is realized in a process that lowers the surface tension between two liquids or between a liquid and a solid."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Surfactant&oldid=1063693411"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000345
cco:ont00000345 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Measuring"@en ;
                skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en ;
                skos:example "putting an object on a scale to measure its weight in kilograms" ,
                             "rating Hollywood movies on a 1 to 5 star scale" ,
                             "using a tape measure to determine the height and width of a doorway in inches" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000346
cco:ont00000346 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Communication Instrument"@en ;
                skos:definition "A Material Artifact that is designed to facilitate communication between at least two entities."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000347
cco:ont00000347 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001159 ;
                rdfs:label "Electronic Bond"@en ;
                skos:definition "A Bond that consists of Bytes."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000348
cco:ont00000348 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000995
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000196 ;
                                                             owl:someValuesFrom cco:ont00001999
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Filter"@en ;
                skos:definition "A Material Artifact that bears a Filter Function."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000349
cco:ont00000349 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000479 ;
                rdfs:label "Police Station"@en ;
                skos:definition "A Public Safety Facility that is designed for the professional and clerical processes of a local police force."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Police_station&oldid=1056208781"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000350
cco:ont00000350 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000453 ;
                rdfs:label "Cooling System"@en ;
                skos:definition "An Environment Control System that is designed to cool the air or objects in a Site."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000351
cco:ont00000351 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000133 ;
                rdfs:label "Act of Commanding"@en ;
                skos:definition "An Act of Directive Communication through which an Agent exercises authoritative control or power over another Agent's actions."@en ;
                cco:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=commanding (Edited 08-22-2016)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000352
cco:ont00000352 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001139 ;
                rdfs:label "Satellite Artifact"@en ;
                skos:definition "A Spacecraft that is designed to Orbit a Space Object (typically Earth)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000353
cco:ont00000353 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Research Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to perform research on a specified entity or class of entities."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000354
cco:ont00000354 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000379 ;
                rdfs:label "Act of Testifying"@en ;
                skos:definition "An Act of Representative Communication performed by stating one's personal knowledge or belief."@en ;
                cco:ont00001754 "http://www.merriam-webster.com/dictionary/testify" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000355
cco:ont00000355 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001009 ;
                rdfs:label "Refracting Optical Telescope"@en ;
                skos:altLabel "Refracting Telescope"@en ,
                              "Refractor"@en ;
                skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light via refraction through the use of one or more Lenses to form an enhanced image of the Object."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refracting_telescope&oldid=1059975066"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000356
cco:ont00000356 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000588 ;
                rdfs:label "Act of Publishing Mass Media Article"@en ;
                skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of a non-fictional essay, especially one included with others in a newspaper, magazine, journal, etc."@en ;
                cco:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000357
cco:ont00000357 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Motion"@en ;
                skos:definition "A Planned Act by which an Agent causes the position or location of some Object to change."@en ;
                cco:ont00001754 "http://www.merriam-webster.com/dictionary/motion" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000358
cco:ont00000358 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001130 ;
                rdfs:label "Geospatial Region Bounding Box"@en ;
                skos:definition "A Geospatial Polygon that has some Geospatial Region as a non-tangential proper part."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000359
cco:ont00000359 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000223 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000132 ;
                                  owl:someValuesFrom cco:ont00000498
                                ] ;
                rdfs:label "Julian Date"@en ;
                skos:definition "A Time of Day as specified according to the Julian Calendar using the Julian Date epoch."@en ;
                cco:ont00001753 "JD" ;
                cco:ont00001754 "https://www.defit.org/julian-date/" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000360
cco:ont00000360 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001289 ;
                rdfs:label "Wounded Stasis"@en ;
                skos:altLabel "Wounded"@en ;
                skos:definition "A Damaged Stasis in which a Person or other organism is the bearer of a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to an injuring event."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000361
cco:ont00000361 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001356 ;
                rdfs:label "Increase of Function"@en ;
                skos:definition "An Increase of Disposition in which some Independent Continuant has an increase of some Function that it bears."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000362
cco:ont00000362 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000533 ;
                rdfs:label "Rocket Engine"@en ;
                skos:altLabel "Thruster"@en ;
                skos:definition "A Jet Engine that is designed to use only stored Rocket Propellant to form a high speed propulsive jet in order to generate Thrust."@en ;
                skos:scopeNote "Most rocket engines are also Internal Combustion Engines, however non-combusting forms also exist. For example, an untied balloon full of air that is released and allowed to zoom around the room may be both a Rocket Engine and a Physically Powered Engine."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket_engine&oldid=1063879464"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000363
cco:ont00000363 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000998 ;
                rdfs:label "Wireless Telecommunication Network"@en ;
                skos:altLabel "Wireless Network"@en ;
                skos:definition "A Telecommunication Network that uses wireless connections to connect Telecommunication Network Nodes."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wireless_network&oldid=1060257041"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000364
cco:ont00000364 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001221 ;
                rdfs:label "Pneumatic Motor"@en ;
                skos:altLabel "Air Motor"@en ,
                              "Compressed Air Engine"@en ;
                skos:definition "A Physically Powered Engine that converts potential energy stored in a portion of compressed air into mechanical energy."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000365
cco:ont00000365 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000161 ;
                rdfs:label "x-Axis"@en ;
                skos:definition "A Coordinate System Axis designated by the variable 'x'."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000366
cco:ont00000366 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Information Processing"@en ;
                skos:definition "A Planned Act in which one or more input Information Content Entities are received, manipulated, transferred, or stored by an Agent."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000367
cco:ont00000367 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001075 ;
                rdfs:label "Act of Military Training Instruction"@en ;
                skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Military Organization by imparting knowledge of the tactics, techniques, and/or strategies of Military Operations to an Agent either directly or indirectly through some communication medium."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000368
cco:ont00000368 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001133 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001777 ;
                                  owl:someValuesFrom cco:ont00000296
                                ] ;
                rdfs:label "Rotational Motion"@en ;
                skos:altLabel "Rotation"@en ;
                skos:definition "A Motion Process in which an Object moves in a Circular or Elliptical Path around an Axis of Rotation."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rotation&oldid=1055998344"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000369
cco:ont00000369 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001010 ;
                rdfs:label "Priority Measurement Information Content Entity"@en ;
                skos:altLabel "Criticality Measurement"@en ,
                              "Importance Measurement"@en ,
                              "Priority Measurement"@en ;
                skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of the relative importance of an entity."@en ;
                skos:example "low, normal, high, urgent, or immediate priority" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000370
cco:ont00000370 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000123 ;
                rdfs:label "Act of Condoling"@en ;
                skos:definition "An Act of Expressive Communication performed by expressing sympathy or sorrow."@en ;
                cco:ont00001754 "http://www.thefreedictionary.com/condoling" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000371
cco:ont00000371 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Prediction"@en ;
                skos:definition "A Planned Act that involves the generation of a Predictive Information Content entity that is intended to describe an uncertain possible future event, value, entity, or attribute of an entity."@en ;
                skos:example "a chess master predicting the next 8 moves his opponent will make" ,
                             "predicting that a particular stock will double in value over the next fiscal quarter" ,
                             "using sample exit polls data to predict the winners of an election" ;
                skos:scopeNote "An Act of Prediction may involve the use of some or no relevant information. An Act of Prediction that utilizes relevant information may also be (or at least involve) an Act of Estimation. Hence, these two classes are not disjoint. Furthermore, neither class subsumes the other since estimates can be made about existing entities and not all predictions produce measurements (e.g. predicting that it will rain tomorrow)."@en ,
                               "Predictions can only be made about things that are not yet the case (i.e. future things) and are further restricted to being about things that do not have a probability of either 1 (necessary) or 0 (impossible). For example, assuming that no organism is immortal, one cannot predict of a given organism that it will eventually die; however, one may predict uncertain things about the organism's eventual death, such as its precise cause or time."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000372
cco:ont00000372 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Power Transformer Rectifier Unit"@en ;
                skos:altLabel "TRU"@en ;
                skos:definition "A Material Artifact that is designed to perform the functions of both a Rectifier and a Transformer."@en ;
                cco:ont00001754 "http://www.skybrary.aero/index.php/Transformer_Rectifier_Unit_(TRU)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000373
cco:ont00000373 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000147 ;
                rdfs:label "Geospatial Position"@en ;
                skos:definition "A Fiat Point that is at or near the surface of the Earth and fixed according to some Geospatial Coordinate Reference System."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000374
cco:ont00000374 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000061 ;
                rdfs:label "Measurement Unit of Volumetric Flow Rate"@en ;
                skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which volumes of fluid pass per unit time."@en ;
                skos:example "cubic metres per second, standard cubic centimeters per minute, cubic feet per second, gallons per minute" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000375
cco:ont00000375 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000881 ;
                rdfs:label "Warehouse"@en ;
                skos:definition "A Storage Facility that is designed to store commercial goods."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Warehouse&oldid=1063721454"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000376
cco:ont00000376 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000457 ;
                rdfs:label "Portion of Gallium Arsenide"@en ;
                skos:altLabel "Portion of GaAs"@en ;
                skos:definition "A Portion of Material that is composed of a compound of the elements gallium and arsenic."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000377
cco:ont00000377 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000019 ;
                rdfs:label "Disability"@en ;
                skos:definition "A Quality inhering in an Agent by virtue a physical or mental condition that limits the Agent's movements, senses, or activities."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000378
cco:ont00000378 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000784 ;
                rdfs:label "Color"@en ;
                skos:definition "An Optical Property that inheres in a bearer in virtue of that bearer's Color Hue, Color Saturation and Color Brightness."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000379
cco:ont00000379 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000402 ;
                rdfs:label "Act of Representative Communication"@en ;
                skos:definition "An Act of Communication that commits a speaker to the truth of the expressed proposition."@en ;
                skos:scopeNote "Examples: affirming, alleging, announcing, answering, attributing, claiming, classifying, concurring, confirming, conjecturing, denying, disagreeing, disclosing, disputing, identifying, informing, insisting, predicting, ranking, reporting, stating, stipulating"@en ;
                cco:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000380
cco:ont00000380 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000570 ;
                rdfs:label "Pressure"@en ;
                skos:definition "A Force that is applied perpendicular to the surface of an Object per unit area over which that Force is distributed."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000381
cco:ont00000381 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000782 ;
                rdfs:label "Weapon Manufacturing Facility"@en ;
                skos:definition "A Factory that is designed to produce or assemble weapons."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Arms_industry&oldid=1063811497"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000382
cco:ont00000382 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001298 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000101 ;
                                  owl:someValuesFrom cco:ont00002042
                                ] ;
                rdfs:label "Material Copy of a Spreadsheet"@en ;
                skos:altLabel "Spreadsheet"@en ;
                skos:definition "A Material Copy of a Document that is designed to carry some Information Content Entity in an interactive, tabular form."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spreadsheet&oldid=1064060503"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000383
cco:ont00000383 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000837 ;
                rdfs:label "Nuclear Family"@en ;
                skos:definition "A Family composed of parents and their children."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000384
cco:ont00000384 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000789 ;
                rdfs:label "Rectilinear Motion"@en ;
                skos:altLabel "Linear Motion"@en ;
                skos:definition "A Translational Motion process in which an Object moves along a straight path."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000385
cco:ont00000385 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001059 ;
                rdfs:label "Wide"@en ;
                skos:altLabel "Broad"@en ,
                              "Fat"@en ;
                skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a width or depth which is significantly larger in proportion to its length or height."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000386
cco:ont00000386 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000517 ;
                rdfs:label "Webcast"@en ;
                skos:altLabel "Act of Webcasting"@en ;
                skos:definition "An Act of Communciation by Media transmitted to an audience over the Internet using streaming media technology to distribute a single content source that may be distributed live or on demand."@en ;
                skos:scopeNote "Essentially, webcasting is “broadcasting” over the Internet."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Webcast&oldid=1062685084"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000387
cco:ont00000387 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000026 ;
                rdfs:label "Axis of Rotation"@en ;
                skos:altLabel "Rotational Axis"@en ;
                skos:definition "A One-Dimensional Spatial Region defined by the line around which a spinning body rotates."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000388
cco:ont00000388 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00001262
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000196 ;
                                                             owl:someValuesFrom cco:ont00000987
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00001262 ;
                rdfs:label "Citizen"@en ;
                skos:definition "A Person who is the bearer of some Citizen Role."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000389
cco:ont00000389 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001334 ;
                rdfs:label "Act of Buying"@en ;
                skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Buyer) to acquire ownership of a good from another Agent (the Seller)."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000390
cco:ont00000390 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000686
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001916 ;
                                                             owl:someValuesFrom obo:BFO_0000006
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000686 ;
                rdfs:label "Spatial Region Identifier"@en ;
                skos:definition "A Designative Information Content Entity that designates some Spatial Region."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000391
cco:ont00000391 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000754 ;
                rdfs:label "Tremendously High Frequency"@en ;
                skos:altLabel "ITU Band Number 12"@en ,
                              "Submillimeter Band Frequency"@en ,
                              "Terahertz Radiation Frequency"@en ;
                skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 GHz and 3 THz."@en ;
                skos:scopeNote "The corresponding Wavelength range is 1–0.1 mm"@en ;
                cco:ont00001753 "THF" ;
                cco:ont00001754 "International Telecommunication Union (ITU)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000392
cco:ont00000392 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "Allegiance Role"@en ;
                skos:definition "A Role that inheres in an Agent by virtue of the support it has committed to provide to another Agent when that Agent is involved in a conflict."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000393
cco:ont00000393 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000387 ;
                rdfs:label "Yaw Axis"@en ;
                skos:altLabel "Vertical Axis"@en ;
                skos:definition "An Axis of Rotation that passes through the center of an object's Mass from the top to the bottom and is perpendicular to the direction of the object's motion. For objects in Orbit, the Yaw Axis passes through the Barycenter of its Orbit."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000394
cco:ont00000394 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000746 ;
                rdfs:label "Internal Combustion Engine"@en ;
                skos:definition "A Combustion Engine that is designed to have an internal Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy that is then converted into mechanical energy."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Internal_combustion_engine&oldid=1063281505"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000395
cco:ont00000395 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000554 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000057 ;
                                  owl:someValuesFrom [ owl:intersectionOf ( obo:BFO_0000004
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty obo:BFO_0000196 ;
                                                                              owl:someValuesFrom obo:BFO_0000020
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ]
                                ] ;
                rdfs:label "Gain of Specifically Dependent Continuant"@en ;
                skos:definition "A Gain of Dependent Continuant in which some Independent Continuant becomes the bearer of some Specifically Dependent Continuant."@en ;
                skos:example "A Person becomes pregnant (gain of quality), A person becomes forgetful (gain of disposition), A vehicle becomes amphibious (gain of function), A Person becomes a Database Administrator (gain of role)." ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000396
cco:ont00000396 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000150 ;
                rdfs:label "Extremely Low Frequency"@en ;
                skos:altLabel "ITU Band Number 1"@en ;
                skos:definition "A Radio Frequency that is between 3 and 30 Hz."@en ;
                skos:scopeNote "The corresponding Wavelength range is 100,000–10,000 km"@en ;
                cco:ont00001753 "ELF" ;
                cco:ont00001754 "International Telecommunication Union (ITU)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000397
cco:ont00000397 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000995 ;
                rdfs:label "Combustion Chamber"@en ;
                skos:altLabel "Burner"@en ,
                              "Combustor"@en ,
                              "Flame Holder"@en ;
                skos:definition "A Material Artifact that is designed to wholly or partially bound an internal Site where a Combustion process is intended to occur."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000398
cco:ont00000398 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:label "Reference System"@en ;
                skos:definition "A Descriptive Information Content Entity that describes a set of standards for organizing and understanding data of the specified type or domain."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000399
cco:ont00000399 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00000686
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001916 ;
                                                             owl:someValuesFrom obo:BFO_0000008
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf cco:ont00000686 ;
                rdfs:label "Temporal Region Identifier"@en ;
                skos:definition "A Designative Information Content Entity that designates some Temporal Region."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000400
cco:ont00000400 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001197 ;
                rdfs:label "Park"@en ;
                skos:definition "An Anthropogenic Feature that is a bounded area of land, or water, usually in its natural or semi-natural (landscaped) state and set aside for some purpose, usually to do with recreation or conservation."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Park&oldid=1061073992"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000401
cco:ont00000401 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000008 ;
                rdfs:label "Fundamental Frequency"@en ;
                skos:definition "A Sound Frequency that is the lowest Frequency of a Sound Wave."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000402
cco:ont00000402 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Communication"@en ;
                skos:definition "A Planned Act in which some Information Content Entity is transferred from some Agent to Another."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communication&oldid=1063752020"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000403
cco:ont00000403 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000323 ;
                rdfs:label "Diffraction Artifact Function"@en ;
                skos:definition "An Artifact Function that is realized by a Material Artifact participating in a diffraction event in which the Material Artifact forces a wave to bend around the corners of an obstacle or aperture into the region of geometrical shadow of the obstacle."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000404
cco:ont00000404 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000084 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:someValuesFrom cco:ont00000500
                                ] ;
                rdfs:label "Iris"@en ;
                skos:definition "A Bodily Component that consists of the part of an Eye that is a pigmented, round, contractile membrane, suspended between the cornea and lens and perforated by the pupil, and which canonically regulates the amount of light entering the Eye."@en ;
                cco:ont00001754 "http://www.thefreedictionary.com/iris" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000405
cco:ont00000405 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001152 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:someValuesFrom cco:ont00000126
                                ] ;
                rdfs:label "Second-Order Administrative Region"@en ;
                skos:definition "A Government Domain that is a subdivision of a First-Order Administrative Region."@en ;
                cco:ont00001754 "http://www.geonames.org/export/codes.html" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000406
cco:ont00000406 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000120 ;
                rdfs:label "Measurement Unit of Geocoordinate"@en ;
                skos:definition "A Measurement Unit specifying the geospatial coordinates of a location."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000407
cco:ont00000407 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000098 ;
                rdfs:label "Electrical Resistance Artifact Function"@en ;
                skos:definition "An Electrical Artifact Function that is realized in processes in which a Material Artifact opposes the flow of an electric current."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electrical_resistivity_and_conductivity&oldid=1063749049"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000408
cco:ont00000408 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001180 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000176 ;
                                  owl:someValuesFrom cco:ont00001335
                                ] ;
                rdfs:label "Government Organization"@en ;
                skos:definition "An Organization that is part of a Government and is responsible for the oversight or administration of specific governmental functions."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000409
cco:ont00000409 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000742 ;
                rdfs:label "Spark Ignition System"@en ;
                skos:definition "An Ignition System that is designed to produce a spark in order to initiate an Ignition process."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000410
cco:ont00000410 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
                rdfs:label "Residential Facility"@en ;
                skos:definition "A Facility that is designed to house one or more Persons."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Residence&oldid=1019728937"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000411
cco:ont00000411 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001100 ;
                rdfs:label "Speed Measurement Artifact Function"@en ;
                skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Speed of a specified object's or class of objects' Motion."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000412
cco:ont00000412 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000791 ;
                rdfs:label "Oxidizer Artifact Function"@en ;
                skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which electrons are removed from a reactant in a redox reaction."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Redox&oldid=1063866348"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000413
cco:ont00000413 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000304 ;
                rdfs:label "Electron Microscope"@en ;
                skos:definition "A Microscope that is designed to use a beam of accelerated electrons to illuminate the target and produce a significantly enlarged image of the Object."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electron_microscope&oldid=1060512240"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000414
cco:ont00000414 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001286 ;
                rdfs:label "Square Waveform"@en ;
                skos:definition "A Waveform that is characterized by a square shape due to the near-instantaneous transitions between minimum and maximum Amplitudes of the Wave Cycle."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000415
cco:ont00000415 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000828 ;
                rdfs:label "Anti-Microbial Artifact Function"@en ;
                skos:definition "A Pesticide Artifact Function that is realized in a process which causes illness in, or the death of, a microorganism."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Antimicrobial&oldid=1064100151"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000416
cco:ont00000416 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000588 ;
                rdfs:label "Act of Publishing Mass Media Press Release"@en ;
                skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of an official statement issued to one or more members of the media for the purpose of announcing newsworthy information."@en ;
                cco:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000417
cco:ont00000417 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000715 ;
                rdfs:label "Prosthetic Hand"@en ;
                skos:definition "A Prosthesis that is designed to replace a missing hand."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


