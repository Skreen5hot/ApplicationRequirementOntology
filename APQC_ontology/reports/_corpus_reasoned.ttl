                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing technologies and tools related to the confidentiality, integrity, and availability of data in order to ensure the security of the organization's information." ;
             ex:designatesProcessType ex:ControlsTechnologyMaintenanceCapability ;
             ex:hierarchyID "11.2.1.4" ;
             ex:pcfID "14137" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17468 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain controls-related technologies and tools" .


###  http://example.org/apqc#PCF_14187
ex:PCF_14187 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reviewing past credit scores to determine the if a line of credit will be extended to potential customers. This could also include extending additional credit to existing accounts." ;
             ex:designatesProcessType ex:P14187 ;
             ex:hierarchyID "9.2.1.3" ;
             ex:pcfID "14187" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10742 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze credit scoring history" .


###  http://example.org/apqc#PCF_14188
ex:PCF_14188 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Planning credit score requirements based on established credit policies. " ;
             ex:designatesProcessType ex:P14188 ;
             ex:hierarchyID "9.2.1.4" ;
             ex:pcfID "14188" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10742 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Forecast credit scoring requirement" .


###  http://example.org/apqc#PCF_14189
ex:PCF_14189 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Formulating strategic options that create opportunities for the sustenance and prosperity of the business in the long run. Go beyond business longevity to consider alternate strategies that allow the organizations preservation of vitality over time. Earmark resources and target processes, the former of which are dedicated to the absorption of sustainable practices in the latter." ;
             ex:designatesProcessType ex:P14189 ;
             ex:hierarchyID "1.2.3.2" ;
             ex:pcfID "14189" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10039 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop sustainability strategy" .


###  http://example.org/apqc#PCF_14193
ex:PCF_14193 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the scheme of processing inventory into finished products/services. This includes the use of raw materials, machinery, skill sets, and knowledge to create new offerings." ;
             ex:designatesProcessType ex:P14193 ;
             ex:hierarchyID "4.1.1.7" ;
             ex:pcfID "14193" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define production process" .


###  http://example.org/apqc#PCF_14194
ex:PCF_14194 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the floor plans for the processing facility that is meant for delivering finished products/services. Identify the totality of infrastructure needed for using this space in the manufacturing process, including machinery, factory floors, offices, and furniture." ;
             ex:designatesProcessType ex:P14194 ;
             ex:hierarchyID "4.1.1.9" ;
             ex:pcfID "14194" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define production workplace layout and infrastructure" .


###  http://example.org/apqc#PCF_14196
ex:PCF_14196 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining an equitable volume for the production of products/services that adheres to an equilibrium value, and creating a scheme of control for processing items. Create schematics for systematically planning, coordinating, and directing the manufacturing activities in line with the production balance determined." ;
             ex:designatesProcessType ex:P14196 ;
             ex:hierarchyID "4.1.3.6" ;
             ex:pcfID "14196" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10223 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define production balance and control" .


###  http://example.org/apqc#PCF_14197
ex:PCF_14197 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing strategies for the optimization of processes and the improvement of functional areas in order to improve the bottom line. Create a road map of decision choices that would allow the organization to continuously enhance process efficiencies and advance performance standards." ;
             ex:designatesProcessType ex:P14197 ;
             ex:hierarchyID "1.2.3.7" ;
             ex:pcfID "14197" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10039 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop lean/continuous improvement strategy" .


###  http://example.org/apqc#PCF_14208
ex:PCF_14208 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the corpus of data relating all customers acquired over time. Manage the storage, maintenance, access, revision, and usage of all data on customers. Ensure its security, and determine legitimate use cases that are beneficial to the organization." ;
             ex:designatesProcessType ex:P14208 ;
             ex:hierarchyID "3.5.2.5" ;
             ex:pcfID "14208" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10183 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage customer master data" .


###  http://example.org/apqc#PCF_14209
ex:PCF_14209 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the repository of data relating to the organization's partners/alliances over time. Store, maintain, access, revise, and use all data on partners/alliances. Manage data. Ensure its security. Determine legitimate use cases that are beneficial to the organization." ;
             ex:designatesProcessType ex:P14209 ;
             ex:hierarchyID "3.5.5.4" ;
             ex:pcfID "14209" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10187 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage sales partner/alliance master data" .


###  http://example.org/apqc#PCF_14210
ex:PCF_14210 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Supervising the interest paid or received by the organization. Arrange and supervise interest rate swap transactions to manage exposure to fluctuations in interest rates. Or attain a marginally lower rate of interest than could be gained through a swap. " ;
             ex:designatesProcessType ex:P14210 ;
             ex:hierarchyID "9.7.4.8" ;
             ex:pcfID "14210" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10761 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process and oversee interest rate transactions" .


###  http://example.org/apqc#PCF_16378
ex:PCF_16378 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and administering governance for management of the processes. Outline and manage the frameworks for management of the processes. Define the business processes. Administer the performance of the processes. Enhance the business processes." ;
             ex:designatesProcessType ex:BusinessProcessManagementCapability ;
             ex:hierarchyID "13.1" ;
             ex:pcfID "16378" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage business processes" .


###  http://example.org/apqc#PCF_16379
ex:PCF_16379 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining and managing the organization's approach to governing business process management. Establish and manage tools to support the governance process. Assign ownership for all business processes. Perform activities to administer the governing process." ;
             ex:designatesProcessType ex:P16379 ;
             ex:hierarchyID "13.1.1" ;
             ex:pcfID "16379" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_16378 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish and maintain process management governance" .


###  http://example.org/apqc#PCF_16380
ex:PCF_16380 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining and managing the methodology for administering business process management (BPM). Define the method for setting standards and priorities for BPM efforts. Identify BPM governance leaders. Define BPM project participants' roles." ;
             ex:designatesProcessType ex:P16380 ;
             ex:hierarchyID "13.1.1.1" ;
             ex:pcfID "16380" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16379 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define and manage governance approach" .


###  http://example.org/apqc#PCF_16381
ex:PCF_16381 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Instituting, organizing, and maintaining the upkeep of the techniques used for business process management (BPM). Create and maintain templates of BPM tools that can be readily implemented, including process engine, business analytics, content management, and collaboration tools." ;
             ex:designatesProcessType ex:P16381 ;
             ex:hierarchyID "13.1.1.2" ;
             ex:pcfID "16381" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16379 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish and maintain process tools and templates" .


###  http://example.org/apqc#PCF_16382
ex:PCF_16382 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assigning resources (employees) ownership of tasks. These include the responsibility of identifying, analyzing, and improving business processes in order to meet the goals and objectives such as increasing profits and performance, reducing costs, and accelerating schedules." ;
             ex:designatesProcessType ex:P16382 ;
             ex:hierarchyID "13.1.1.3" ;
             ex:pcfID "16382" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16379 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assign and support process ownership" .


###  http://example.org/apqc#PCF_16383
ex:PCF_16383 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing and executing activities for governing business processes. Execute activities that encourage participation, accountability, transparency, responsiveness, equity and inclusiveness, etc. within the business processes." ;
             ex:designatesProcessType ex:P16383 ;
             ex:hierarchyID "13.1.1.4" ;
             ex:pcfID "16383" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16379 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform process governance activities" .


###  http://example.org/apqc#PCF_16384
ex:PCF_16384 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining and organizing the structural composition of business processes. Design, establish, and administer the framework. Identify any cross-functional processes that are mandatory for achieving business excellence." ;
             ex:designatesProcessType ex:P16384 ;
             ex:hierarchyID "13.1.2" ;
             ex:pcfID "16384" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_16378 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define and manage process frameworks" .


###  http://example.org/apqc#PCF_16385
ex:PCF_16385 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining and managing the framework that outlines the required business processes of the organization, key elements, and how they should interact. Institute strategy infrastructure and product, operations, and enterprise management." ;
             ex:designatesProcessType ex:P16385 ;
             ex:hierarchyID "13.1.2.1" ;
             ex:pcfID "16385" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16384 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish and maintain process framework" .


###  http://example.org/apqc#PCF_16386
ex:PCF_16386 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing the different functional areas working on the same project or goal. " ;
             ex:designatesProcessType ex:P16386 ;
             ex:hierarchyID "13.1.2.2" ;
             ex:pcfID "16386" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16384 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify cross-functional processes" .


###  http://example.org/apqc#PCF_16387
ex:PCF_16387 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining and establishing the business processes of the organization. Scope, analyze, map, and publish processes for the employees who may require it." ;
             ex:designatesProcessType ex:P16387 ;
             ex:hierarchyID "13.1.3" ;
             ex:pcfID "16387" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_16378 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define processes" .


###  http://example.org/apqc#PCF_16388
ex:PCF_16388 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the extent and limits of business processes. Define the range and diversity of all the set of activities and tasks that, once completed, will accomplish an organizational goal." ;
             ex:designatesProcessType ex:P16388 ;
             ex:hierarchyID "13.1.3.1" ;
             ex:pcfID "16388" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Scope processes" .


###  http://example.org/apqc#PCF_16389
ex:PCF_16389 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing and examining the set of activities and tasks that, once completed, will accomplish an organizational goal. Create a business process model that captures how a business process works and how individuals from different groups work together to achieve a business goal." ;
             ex:designatesProcessType ex:P16389 ;
             ex:hierarchyID "13.1.3.2" ;
             ex:pcfID "16389" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze processes" .


###  http://example.org/apqc#PCF_16390
ex:PCF_16390 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining what a business entity does, who is responsible, to what standard a business process should be completed, and how the success of a business process can be determined. Identify processes, gather information gathering, interview participants, map processes, and perform analysis." ;
             ex:designatesProcessType ex:P16390 ;
             ex:hierarchyID "13.1.3.4" ;
             ex:pcfID "16390" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Model and document processes" .


###  http://example.org/apqc#PCF_16391
ex:PCF_16391 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Disclosing the information available on business processes. Ensure the availability of the information regarding the business processes to all process team members, business stakeholders, and process owners. Use BPM software, as well as business process diagrams and documents that help depict the required information." ;
             ex:designatesProcessType ex:P16391 ;
             ex:hierarchyID "13.1.3.5" ;
             ex:pcfID "16391" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16387 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Publish processes" .


###  http://example.org/apqc#PCF_16392
ex:PCF_16392 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating and handling the performance of business processes. Provide training to process owners. Support the execution of business processes. Measure and report the performance of the business processes." ;
             ex:designatesProcessType ex:P16392 ;
             ex:hierarchyID "13.1.4" ;
             ex:pcfID "16392" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_16378 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage process performance" .


###  http://example.org/apqc#PCF_16393
ex:PCF_16393 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing training for the employees and process owners that administer the business processes. Design internal training programs or source third party agencies to provide the skills and training necessary." ;
             ex:designatesProcessType ex:P16393 ;
             ex:hierarchyID "13.1.4.1" ;
             ex:pcfID "16393" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16392 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide process training" .


###  http://example.org/apqc#PCF_16394
ex:PCF_16394 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assisting and executing the business processes. Use business process execution language (BEPL), which is a standard, executable language for specifying actions within the business processes with the use of web services." ;
             ex:designatesProcessType ex:P16394 ;
             ex:hierarchyID "13.1.4.2" ;
             ex:pcfID "16394" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16392 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Support process execution" .


###  http://example.org/apqc#PCF_16395
ex:PCF_16395 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining and using performance indicators to consider the financial perspective, customer perspective, internal process perspective, and learning perspective of the organization." ;
             ex:designatesProcessType ex:P16395 ;
             ex:hierarchyID "13.1.4.3" ;
             ex:pcfID "16395" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16392 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure and report process performance" .


###  http://example.org/apqc#PCF_16397
ex:PCF_16397 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Helping a process owner to identify, analyze, and improve existing business processes within an organization to meet new goals and objectives." ;
             ex:designatesProcessType ex:P16397 ;
             ex:hierarchyID "13.1.5.1" ;
             ex:pcfID "16397" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21453 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify and select improvement opportunities" .


###  http://example.org/apqc#PCF_16398
ex:PCF_16398 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and implementing a systematic approach to help the organization optimize its underlying processes in order to achieve more efficient results. Systematically gather information to clarify issues or problems. Intervene for improvements. Restructure training programs as appropriate to increase effectiveness. " ;
             ex:designatesProcessType ex:P16398 ;
             ex:hierarchyID "13.1.5.3" ;
             ex:pcfID "16398" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21453 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage improvement projects" .


###  http://example.org/apqc#PCF_16399
ex:PCF_16399 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Persistently implementing activities for improving business processes. " ;
             ex:designatesProcessType ex:P16399 ;
