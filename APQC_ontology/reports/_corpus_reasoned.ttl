###  http://example.org/apqc#PCF_16401
ex:PCF_16401 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the business portfolio of the organization, including investments, holdings, products, businesses, and brands. Establish a portfolio strategy. Define portfolio governance. Monitor and control the portfolio." ;
             ex:designatesProcessType ex:PortfolioManagementCapability ;
             ex:hierarchyID "13.2.1" ;
             ex:pcfID "16401" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_16400 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage portfolio" .


###  http://example.org/apqc#PCF_16402
ex:PCF_16402 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Instituting the strategy for managing business portfolio. Create a systematic plan that defines the strategy for managing investments, holdings, products, businesses, and brands." ;
             ex:designatesProcessType ex:P16402 ;
             ex:hierarchyID "13.2.1.1" ;
             ex:pcfID "16402" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16401 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish portfolio strategy" .


###  http://example.org/apqc#PCF_16403
ex:PCF_16403 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the administration of business portfolio of the organization. Create and manage the rules and regulations regarding the business processes in order to identify, select, prioritize, and monitor portfolio components. Include a set of metrics to indicate the health and progress of the portfolio in the most vital area." ;
             ex:designatesProcessType ex:P16403 ;
             ex:hierarchyID "13.2.1.2" ;
             ex:pcfID "16403" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16401 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define portfolio governance" .


###  http://example.org/apqc#PCF_16404
ex:PCF_16404 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Overseeing and administering the business portfolio of the organization. Monitor all activities related to investments, holdings, products, businesses, and brands by effectively monitoring and supervising these activities." ;
             ex:designatesProcessType ex:P16404 ;
             ex:hierarchyID "13.2.1.3" ;
             ex:pcfID "16404" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16401 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor and control portfolio" .


###  http://example.org/apqc#PCF_16405
ex:PCF_16405 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing, implementing, and managing business programs. Successfully handle related projects that together constitute a program. Establish the program structure and approach. Coordinate with stakeholders and partners. Execute the program. Assess and report the performance of the program. Coordinate and prioritize resources across projects. Manage links between the projects and the overall costs and risks of the program." ;
             ex:designatesProcessType ex:ProgramManagementCapability ;
             ex:hierarchyID "13.2.2" ;
             ex:pcfID "16405" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_16400 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage programs" .


###  http://example.org/apqc#PCF_16406
ex:PCF_16406 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Constructing and instituting the framework and approach to manage business programs. Monitor key factors such as governance, alignment with the overall business vision, assurance, and management." ;
             ex:designatesProcessType ex:P16406 ;
             ex:hierarchyID "13.2.2.1" ;
             ex:pcfID "16406" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16405 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish program structure and approach" .


###  http://example.org/apqc#PCF_16407
ex:PCF_16407 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing relationships with stakeholders and partners of the business programs. " ;
             ex:designatesProcessType ex:P16407 ;
             ex:hierarchyID "13.2.2.2" ;
             ex:pcfID "16407" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16405 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage program stakeholders and partners" .


###  http://example.org/apqc#PCF_16408
ex:PCF_16408 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering and implementing business programs. Implement and execute programs with the intention of improving an organization's performance. Execute all the individual projects of the program to ensure the desired success." ;
             ex:designatesProcessType ex:P16408 ;
             ex:hierarchyID "13.2.2.3" ;
             ex:pcfID "16408" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16405 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage program execution" .


###  http://example.org/apqc#PCF_16409
ex:PCF_16409 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating and documenting the performance of business programs. Evaluate the performance of the programs. Create reports on the basis of the analysis. Use performance indicators and metrics such as desired/achieved goals, completion dates, issues and defects, and cost effectiveness." ;
             ex:designatesProcessType ex:P16409 ;
             ex:hierarchyID "13.2.2.4" ;
             ex:pcfID "16409" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16405 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review and report program performance" .


###  http://example.org/apqc#PCF_16410
ex:PCF_16410 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing the scope of the projects. Create plans for implementing the projects. Initiate projects. Review and report project performance to management. Close projects." ;
             ex:designatesProcessType ex:ProjectManagementCapability ;
             ex:hierarchyID "13.2.3" ;
             ex:pcfID "16410" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_16400 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage projects" .


###  http://example.org/apqc#PCF_16411
ex:PCF_16411 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing the horizons of business projects. Identify the objectives of the program, along with the resource requirements. Assess the readiness for the project management approach. Identify methodologies for project management. Obtain funding. Develop performance measures and indicators." ;
             ex:designatesProcessType ex:P16411 ;
             ex:hierarchyID "13.2.3.1" ;
             ex:pcfID "16411" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish project scope" .


###  http://example.org/apqc#PCF_16412
ex:PCF_16412 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying the prerequisites of business projects. Identify the people with appropriate and applicable skills and competencies. Locate resources such as capital, facilities, equipment, material, and information required to accomplish the objectives of a specific project." ;
             ex:designatesProcessType ex:P16412 ;
             ex:hierarchyID "13.2.3.1.2" ;
             ex:pcfID "16412" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16411 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify project resource requirements" .


###  http://example.org/apqc#PCF_16413
ex:PCF_16413 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the resources and their roles. Identify IT requirements. Create plans for effective training and communication. Design reward approaches. Plan the launch of project. Deploy the project." ;
             ex:designatesProcessType ex:P16413 ;
             ex:hierarchyID "13.2.3.3" ;
             ex:pcfID "16413" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop project plans" .


###  http://example.org/apqc#PCF_16414
ex:PCF_16414 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing the business projects of the organization. Evaluate the impact of project management. Record and report the status of the project. Manage the project scope. Promote and sustain activities and involvement. Realign and revamp the project management strategy and approach. " ;
             ex:designatesProcessType ex:P16414 ;
             ex:hierarchyID "13.2.3.4" ;
             ex:pcfID "16414" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute projects" .


###  http://example.org/apqc#PCF_16415
ex:PCF_16415 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recording and documenting the current status and position of the project. Record and report items such as completed tasks, incomplete tasks, planned tasks, and problems faced." ;
             ex:designatesProcessType ex:P16415 ;
             ex:hierarchyID "13.2.3.4.2" ;
             ex:pcfID "16415" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16414 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report the status of project" .


###  http://example.org/apqc#PCF_16416
ex:PCF_16416 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining and documenting a list of specific project goals, deliverables, tasks, costs, and deadlines. Use the scope statement to explain the boundaries of the project. Assign responsibilities for team members. Set up procedures for verifying and approving the completed tasks." ;
             ex:designatesProcessType ex:P16416 ;
             ex:hierarchyID "13.2.3.4.3" ;
             ex:pcfID "16416" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16414 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage project scope" .


###  http://example.org/apqc#PCF_16417
ex:PCF_16417 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Measuring the performance of a business project against key performance indicators including the project scope, schedule, quality, cost, and risk criteria. Identify any deviations from the plan. Assess the impact of these deviations on the project, as well as on the overall program. Report results to key stakeholders." ;
             ex:designatesProcessType ex:P16417 ;
             ex:hierarchyID "13.2.3.5" ;
             ex:pcfID "16417" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review and report project performance" .


###  http://example.org/apqc#PCF_16418
ex:PCF_16418 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Settling each contract. Close each contract applicable to the project or project phase. Finalize all activities across all of the process groups in order to formally close the project or a project phase." ;
             ex:designatesProcessType ex:P16418 ;
             ex:hierarchyID "13.2.3.6" ;
             ex:pcfID "16418" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Close projects" .


###  http://example.org/apqc#PCF_16437
ex:PCF_16437 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ensuring that an organization effectively manages its risk. Process groups are aligned with traditional risk management activities." ;
             ex:hierarchyID "11.0" ;
             ex:pcfID "16437" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage Enterprise Risk, Compliance, Remediation, and Resiliency" .


###  http://example.org/apqc#PCF_16439
ex:PCF_16439 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating an agenda for the rules and regulations of enterprise risk that deal with hazardous, financial, operational, and strategic risks." ;
             ex:designatesProcessType ex:P16439 ;
             ex:hierarchyID "11.1.1" ;
             ex:pcfID "16439" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17060 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish the enterprise risk framework and policies" .


###  http://example.org/apqc#PCF_16440
ex:PCF_16440 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing the organization's tolerance for risk, given risk-return trade-offs for one or more anticipated and predictable consequences." ;
             ex:designatesProcessType ex:P16440 ;
             ex:hierarchyID "11.1.1.1" ;
             ex:pcfID "16440" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine risk tolerance for organization" .


###  http://example.org/apqc#PCF_16441
ex:PCF_16441 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and maintaining the policies and procedures for managing risk. Create rules and regulations for enterprise risk dealing with hazardous, financial, operational, and strategic risks." ;
             ex:designatesProcessType ex:P16441 ;
             ex:hierarchyID "11.1.1.2" ;
             ex:pcfID "16441" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and maintain enterprise risk policies and procedures" .


###  http://example.org/apqc#PCF_16442
ex:PCF_16442 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing and implementing tools for managing risk. Identify and apply enterprise risk management tools. Leverage methods and processes to manage risks and opportunities associated with business objectives." ;
             ex:designatesProcessType ex:P16442 ;
             ex:hierarchyID "11.1.1.3" ;
             ex:pcfID "16442" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify and implement enterprise risk management tools" .


###  http://example.org/apqc#PCF_16443
ex:PCF_16443 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Communicating the knowledge about risk within the organization. Identify operational risks. Share risk information within the organization." ;
             ex:designatesProcessType ex:P16443 ;
             ex:hierarchyID "11.1.1.4" ;
             ex:pcfID "16443" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Coordinate the sharing of risk knowledge across the organization" .


###  http://example.org/apqc#PCF_16444
ex:PCF_16444 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Preparing and presenting reports about enterprise risk to the management of the organization. Create reports for management on hazard risks (e.g., property damage and liability torts), financial risks (e.g., currency and liquidity risks), and operational risks (e.g., product failure, customer satisfaction, social trends, and competition)." ;
             ex:designatesProcessType ex:P16444 ;
             ex:hierarchyID "11.1.1.5" ;
             ex:pcfID "16444" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16439 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prepare and report enterprise risk to executive management and board" .


###  http://example.org/apqc#PCF_16445
ex:PCF_16445 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Coordinating to plan, organize, lead, and control the activities of an organization in order to minimize the special effects of risk on capital and earnings." ;
             ex:designatesProcessType ex:P16445 ;
             ex:hierarchyID "11.1.2" ;
             ex:pcfID "16445" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17060 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Oversee and coordinate enterprise risk management activities" .


###  http://example.org/apqc#PCF_16446
ex:PCF_16446 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining risks that could thwart objectives. Document and communicate the concern." ;
             ex:designatesProcessType ex:P16446 ;
             ex:hierarchyID "11.1.2.1" ;
             ex:pcfID "16446" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify enterprise level risks" .


###  http://example.org/apqc#PCF_16447
ex:PCF_16447 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying options/actions to enhance opportunities and reduce threats. Recognize the root reasons of the identified risks." ;
             ex:designatesProcessType ex:P16447 ;
             ex:hierarchyID "11.1.2.2" ;
             ex:pcfID "16447" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess risks to determine which to mitigate" .


###  http://example.org/apqc#PCF_16448
ex:PCF_16448 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing activities to improve opportunities and lessen threats. Specify the organization's objectives. Evolve strategies and policies to attain these objectives. Assign resources to project objectives. " ;
             ex:designatesProcessType ex:P16448 ;
             ex:hierarchyID "11.1.2.3" ;
             ex:pcfID "16448" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop risk mitigation and management strategy and integrate with existing performance management processes" .


###  http://example.org/apqc#PCF_16449
ex:PCF_16449 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Checking that the blueprint created for managing risk in individual business units and divisions is correctly effectuated. Validate the implementation of all activities geared to mitigate risks." ;
             ex:designatesProcessType ex:P16449 ;
             ex:hierarchyID "11.1.2.4" ;
             ex:pcfID "16449" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Verify business unit and functional risk mitigation plans are implemented" .


###  http://example.org/apqc#PCF_16450
ex:PCF_16450 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ensuring risk monitoring and mitigation activities. Monitor actions to enhance opportunities and reduce threats to project objectives." ;
             ex:designatesProcessType ex:P16450 ;
             ex:hierarchyID "11.1.2.5" ;
             ex:pcfID "16450" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Ensure risks and risk mitigation actions are monitored" .


###  http://example.org/apqc#PCF_16451
ex:PCF_16451 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a report of activities to address hazard risks, liability torts, financial risks, operational risks, social trends, competition, etc." ;
             ex:designatesProcessType ex:P16451 ;
             ex:hierarchyID "11.1.2.6" ;
             ex:pcfID "16451" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report on enterprise risk activities" .


###  http://example.org/apqc#PCF_16452
ex:PCF_16452 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Coordinating risk management activities to improve opportunities and lessen threats. Specify the organization's objectives. Assign resources to project objectives. " ;
             ex:designatesProcessType ex:P16452 ;
             ex:hierarchyID "11.1.2.7" ;
             ex:pcfID "16452" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Coordinate business unit and functional risk management activities" .


###  http://example.org/apqc#PCF_16453
ex:PCF_16453 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Checking each business unit's/function's options and activities to improve opportunities and lessen threats." ;
             ex:designatesProcessType ex:P16453 ;
             ex:hierarchyID "11.1.2.8" ;
             ex:pcfID "16453" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Ensure that each business unit/function follows the enterprise risk management process" .


###  http://example.org/apqc#PCF_16454
ex:PCF_16454 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Checking the reporting process of each business unit's/function's options and activities to improve opportunities and lessen threats." ;
             ex:designatesProcessType ex:P16454 ;
             ex:hierarchyID "11.1.2.9" ;
             ex:pcfID "16454" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16445 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Ensure that each business unit/function follows the enterprise risk reporting process" .


###  http://example.org/apqc#PCF_16456
ex:PCF_16456 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a timely and continuous process to identify activities that might hinder a project's goals." ;
             ex:designatesProcessType ex:P16456 ;
             ex:hierarchyID "11.1.3.1" ;
             ex:pcfID "16456" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17462 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify risks" .


###  http://example.org/apqc#PCF_16457
ex:PCF_16457 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the possibility that a specified undesirable event will occur using established tools, implements, and frameworks. Use risk assessments to determine, for example, whether to undertake a particular venture, what rate of return a particular investment requires, and how to mitigate an activity's potential losses." ;
             ex:designatesProcessType ex:P16457 ;
             ex:hierarchyID "11.1.3.2" ;
             ex:pcfID "16457" ;
