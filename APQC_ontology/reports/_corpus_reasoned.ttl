ex:PCF_19669 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Producing and defining ideologies for new product/service offerings." ;
             ex:designatesProcessType ex:P19669 ;
