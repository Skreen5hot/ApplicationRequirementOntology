             skos:prefLabel "Obtain required resources" .


###  http://example.org/apqc#PCF_19248
ex:PCF_19248 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing a checks and balances system to verify that the maintenance was performed correctly. Rework when errors are found. " ;
             ex:designatesProcessType ex:P19248 ;
             ex:hierarchyID "10.3.2.3" ;
             ex:pcfID "19248" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19245 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Undertake quality control" .


###  http://example.org/apqc#PCF_19249
ex:PCF_19249 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Modifying existing maintenance records to include all new work that has been performed, what assets were serviced, and any issues that might have arisen. " ;
             ex:designatesProcessType ex:P19249 ;
             ex:hierarchyID "10.3.2.4" ;
             ex:pcfID "19249" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19245 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Update work and asset records" .


###  http://example.org/apqc#PCF_19250
ex:PCF_19250 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assuring that all safety laws and regulations are being implemented and followed. Align practices with regulatory bureaus such as OSHA , EHS, and ISO. " ;
             ex:designatesProcessType ex:P19250 ;
             ex:hierarchyID "10.3.2.5" ;
             ex:pcfID "19250" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19245 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage maintenance work safety" .


###  http://example.org/apqc#PCF_19251
ex:PCF_19251 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining what should be achieved through predictive indicators with regard to performing maintenance. This could include the length of time it takes to perform routine maintenance or how often unplanned maintenance feasibly occur." ;
             ex:designatesProcessType ex:P19251 ;
             ex:hierarchyID "10.3.2.6" ;
             ex:pcfID "19251" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19245 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define maintenance performance targets" .


###  http://example.org/apqc#PCF_19252
ex:PCF_19252 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Following set performance targets, monitor and gage the success of the organization in meeting those targets." ;
             ex:designatesProcessType ex:P19252 ;
             ex:hierarchyID "10.3.2.7" ;
             ex:pcfID "19252" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19245 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor maintenance performance against targets/contracts" .


###  http://example.org/apqc#PCF_19253
ex:PCF_19253 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Engaging in all aspects of asset maintenance. Ensure that all assets are functioning properly and to all specified codes and regulations where applicable. Maintenance includes all preventative, routine, and corrective activates." ;
             ex:designatesProcessType ex:P19253 ;
             ex:hierarchyID "10.3.3" ;
             ex:pcfID "19253" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_19238 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform asset maintenance" .


###  http://example.org/apqc#PCF_19254
ex:PCF_19254 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Carrying out required maintenance to continue upkeep of equipment or assets. " ;
             ex:designatesProcessType ex:P19254 ;
             ex:hierarchyID "10.3.3.2" ;
             ex:pcfID "19254" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19253 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform routine asset maintenance" .


###  http://example.org/apqc#PCF_19255
ex:PCF_19255 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Repairing or correcting faults that occur with an asset. This could be a break or other repairable damage. " ;
             ex:designatesProcessType ex:P19255 ;
             ex:hierarchyID "10.3.3.3" ;
             ex:pcfID "19255" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19253 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform corrective asset maintenance and repairs" .


###  http://example.org/apqc#PCF_19256
ex:PCF_19256 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Realizing potential or current problems with assets that would require unplanned maintenance. Unplanned maintenance is a repair or change that needs to be made that is not preventative or routine." ;
             ex:designatesProcessType ex:P19256 ;
             ex:hierarchyID "10.3.3.4" ;
             ex:pcfID "19256" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19253 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify unplanned maintenance requirements" .


###  http://example.org/apqc#PCF_19257
ex:PCF_19257 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Performing repairs that occur outside of normal routine or preventative maintenance. " ;
             ex:designatesProcessType ex:P19257 ;
             ex:hierarchyID "10.3.3.5" ;
             ex:pcfID "19257" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19253 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform unplanned maintenance and repairs" .


###  http://example.org/apqc#PCF_19258
ex:PCF_19258 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Retiring assets that are no longer viable to the business. Decommission assets that are no longer in working order, are out of date, or whose maintenance exceeds the cost of replacement." ;
             ex:designatesProcessType ex:P19258 ;
             ex:hierarchyID "10.4.2" ;
             ex:pcfID "19258" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21576 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Decommission productive assets" .


###  http://example.org/apqc#PCF_19465
ex:PCF_19465 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing and reporting site status. Align efforts to all legal, regulatory and social/environmental responsibilities." ;
             ex:designatesProcessType ex:P19465 ;
             ex:hierarchyID "10.4.10.3" ;
             ex:pcfID "19465" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21582 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor site for duration of time required by regulators" .


###  http://example.org/apqc#PCF_19507
ex:PCF_19507 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Successfully implement strategic initiatives. Execution of strategy is also defined as the process of implementing logical set of connected activities by an organization to make a strategy work." ;
             ex:designatesProcessType ex:P19507 ;
             ex:hierarchyID "1.3.5" ;
             ex:pcfID "19507" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10016 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute strategic initiatives" .


###  http://example.org/apqc#PCF_19551
ex:PCF_19551 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing or prescribing methods to be followed routinely for the performance of designated operations or in designated situations. This may include step-by-step instructions to help workers carry out complex routine operations. The goal is to improve efficiency, quality, and uniformity of performance, while reducing miscommunication, failure, or rework." ;
             ex:designatesProcessType ex:P19551 ;
             ex:hierarchyID "4.1.1.8" ;
             ex:pcfID "19551" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10221 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define standard operating procedures" .


###  http://example.org/apqc#PCF_19555
ex:PCF_19555 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluate constraints, needs, parameters, and conditions for physical storage and retrieval of components or products for future use or shipment in a storage facility within a certain timeframe." ;
             ex:designatesProcessType ex:P19555 ;
             ex:hierarchyID "4.1.5.3" ;
             ex:pcfID "19555" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17042 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine product storage facility requirements" .


###  http://example.org/apqc#PCF_19558
ex:PCF_19558 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining potential constraints for physical storage and retrieval of components or products in a storage facility within a certain timeframe. Consider factors such as the building shape, height, capacity, door locations, lift equipment, automation, etc." ;
             ex:designatesProcessType ex:P19558 ;
             ex:hierarchyID "4.1.6.4" ;
             ex:pcfID "19558" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10226 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish storage management constraints" .


###  http://example.org/apqc#PCF_19563
ex:PCF_19563 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a representation of plant facilities to optimize material flow, resource utilization, and logistics for all levels of plant planning from global production facilities, through local plants, to specific lines and enabling the comparison of production�alternatives,." ;
             ex:designatesProcessType ex:P19563 ;
             ex:hierarchyID "4.3.1.1" ;
             ex:pcfID "19563" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10303 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Model and simulate plant" .


###  http://example.org/apqc#PCF_19566
ex:PCF_19566 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Integrating different resources in the production process: material, personnel, equipment, robotics, etc. Includes automating and controlling the plant, performing advanced process control and real-time optimization. This activity also includes managing plant alarms and alerts." ;
             ex:designatesProcessType ex:P19566 ;
             ex:hierarchyID "4.3.2.5" ;
             ex:pcfID "19566" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10304 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor and optimize production process" .


###  http://example.org/apqc#PCF_19567
ex:PCF_19567 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and applying technology to monitor and control the production and delivery of products and services. Automation involves a broad range of technologies." ;
             ex:designatesProcessType ex:P19567 ;
             ex:hierarchyID "4.3.2.5.1" ;
             ex:pcfID "19567" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_19566 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Automate and control plant" .


###  http://example.org/apqc#PCF_19568
ex:PCF_19568 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Including a broad range of techniques and technologies implemented within industrial process control systems that are routinely reviewed, audited, and improved, advanced process controls typically address particular performance or economic improvement opportunities. An advanced set of process control measures can be used to reduce variation and identify primary improvement options. Results of analysis are fed back into process design for incorporation into production. " ;
             ex:designatesProcessType ex:P19568 ;
             ex:hierarchyID "4.3.2.5.2" ;
             ex:pcfID "19568" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_19566 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform advanced process control" .


###  http://example.org/apqc#PCF_19569
ex:PCF_19569 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Helping organizations increase performance and efficiency, real-time optimization is a category of closed-loop process control that aims at optimizing process performance in real time for systems. It is normally built upon model-based optimization systems and is usually large scale. Real-time optimization automatically detects errors, and can modify and eliminate both random and non-random errors, as well as analyze and monitor all systems involved." ;
             ex:designatesProcessType ex:P19569 ;
             ex:hierarchyID "4.3.2.5.3" ;
             ex:pcfID "19569" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_19566 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform real-time optimization" .


###  http://example.org/apqc#PCF_19570
ex:PCF_19570 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Applying human factors and instrumentation engineering and systems thinking to manage the design of an alarm or alert system to increase its usability. Typical challenges include having too many alarms in a plant, poorly designed alarms/alerts, improperly set alarm/alert points, unclear alarm/alert messages, etc. Poor alarm management is one of the leading causes of unplanned downtime." ;
             ex:designatesProcessType ex:P19570 ;
             ex:hierarchyID "4.3.2.5.4" ;
             ex:pcfID "19570" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_19566 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage plant alarms and alerts" .


