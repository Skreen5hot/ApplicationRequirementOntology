             ex:apqcSourceText "Systematically categorizing products/services for their suitability to international trade. Create classes and categories for demarcating the types of products suitable for international trade. Study requisite national and international standards and the adherence of the organization's portfolio of offerings to these." ;
             ex:designatesProcessType ex:P14092 ;
             ex:hierarchyID "9.11.3" ;
             ex:pcfID "14092" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17059 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Classify products" .


###  http://example.org/apqc#PCF_14093
ex:PCF_14093 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Computing the excise duty to be paid during international trade." ;
             ex:designatesProcessType ex:P14093 ;
             ex:hierarchyID "9.11.5" ;
             ex:pcfID "14093" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17059 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate duty" .


###  http://example.org/apqc#PCF_14094
ex:PCF_14094 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Communicating with the customs department to ensure fluid compliance. Share pertinent information mandated by law with the government agency that controls and collects the duties levied for the international exchange of products/services." ;
             ex:designatesProcessType ex:P14094 ;
             ex:hierarchyID "9.11.6" ;
             ex:pcfID "14094" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17059 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate with customs" .


###  http://example.org/apqc#PCF_14095
ex:PCF_14095 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Documenting and recording the trade processes while making transactions, noting the description, quality, number, transportation medium, indemnity, and inspection." ;
             ex:designatesProcessType ex:P14095 ;
             ex:hierarchyID "9.11.7" ;
             ex:pcfID "14095" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17059 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Document trade" .


###  http://example.org/apqc#PCF_14096
ex:PCF_14096 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Preparing global trade under preference, which allows the organization to import/export products at a lower or nil rate of customs duty and/or levy charge." ;
             ex:designatesProcessType ex:P14096 ;
             ex:hierarchyID "9.11.8" ;
             ex:pcfID "14096" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17059 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process trade preferences" .


###  http://example.org/apqc#PCF_14097
ex:PCF_14097 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering and overseeing all restitution activities the organization may be subjected to. Manage compliance with apposite legal frameworks. Make any restitution that may be required by law; comply with authorities over any fines or non-financial measures imposed." ;
             ex:designatesProcessType ex:RestitutionManagementCapability ;
             ex:hierarchyID "9.11.9" ;
             ex:pcfID "14097" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17059 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Handle restitution" .


###  http://example.org/apqc#PCF_14098
ex:PCF_14098 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a document assuring that a seller will receive payment when certain delivery conditions are met. (If the buyer is unable to make payment on the purchase, a bank covers the outstanding amount.)" ;
             ex:designatesProcessType ex:P14098 ;
             ex:hierarchyID "9.11.10" ;
             ex:pcfID "14098" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17059 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prepare letter of credit" .


###  http://example.org/apqc#PCF_14133
ex:PCF_14133 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing accounts and prepare regular reports on financial performance." ;
             ex:designatesProcessType ex:InternalAuditManagementCapability ;
             ex:hierarchyID "11.2.1.3" ;
             ex:pcfID "14133" ;
