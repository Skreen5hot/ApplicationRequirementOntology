###  http://example.org/apqc#HRTechnologyStrategy
ex:HRTechnologyStrategy rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:label "HR Technology Strategy" ;
                        skos:definition "A Directive Information Content Entity that prescribes the selection and use of systems, technologies, and tools for operating the human-resources function." .


###  http://example.org/apqc#HazardRiskAssessment
ex:HazardRiskAssessment rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cco:ont00001808 ;
                                          owl:someValuesFrom ex:DefectiveProduct
                                        ] ;
                        rdfs:comment "Output of 6.4.2 (Assess the likelihood and consequences of occurrence of any hazards)." ;
                        rdfs:label "Hazard Risk Assessment" ;
                        skos:definition "A Descriptive Information Content Entity that describes the identified hazards of a product, their likelihood, and their adverse consequences." .


###  http://example.org/apqc#HazardousMaterial
ex:HazardousMaterial rdf:type owl:Class ;
                     rdfs:subClassOf obo:BFO_0000040 ;
                     rdfs:label "Hazardous Material" ;
                     skos:definition "A Material Entity that poses a health, safety, or environmental hazard and whose handling, shipment, and disposal are subject to legal and regulatory control." .


###  http://example.org/apqc#HedgeRequirementSpecification
ex:HedgeRequirementSpecification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Local mint for 9.7.5.2.3 and 9.7.5.3.3. Directive because it prescribes which hedges must be put in place." ;
                                 rdfs:label "Hedge Requirement Specification" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the hedging requirements for a class of market exposures in accordance with an organization's risk policy." .


###  http://example.org/apqc#HedgeSelectionDecision
ex:HedgeSelectionDecision rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Local mint for 9.7.5.5.4. Directive because a selection decision commits to a chosen option." ;
                          rdfs:label "Hedge Selection Decision" ;
                          skos:definition "A Directive Information Content Entity that prescribes which hedging option is to be executed after evaluation of available options." .


###  http://example.org/apqc#HedgingStrategy
ex:HedgingStrategy rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:label "Hedging Strategy" ;
                   skos:definition "A Directive Information Content Entity that prescribes the positions an Organization will take to offset exposure to financial risk." .


###  http://example.org/apqc#HiringManager
ex:HiringManager rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00001017 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty obo:BFO_0000196 ;
                                   owl:someValuesFrom ex:HiringManagerRole
                                 ] ;
                 rdfs:label "Hiring Manager" ;
                 skos:definition "An Agent that bears a hiring-manager role in virtue of being responsible for deciding which candidate fills an open position." .


###  http://example.org/apqc#HiringManagerRole
ex:HiringManagerRole rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000984 ;
                     rdfs:label "Hiring Manager Role" ;
                     skos:definition "A Role that is borne by an Agent in virtue of being responsible for deciding which candidate fills an open position." .


###  http://example.org/apqc#HistoricalContactData
ex:HistoricalContactData rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Input to 6.2.1.1 (Forecast volume of customer service contacts)." ;
                         rdfs:label "Historical Contact Data" ;
                         skos:definition "A Descriptive Information Content Entity that describes the past volume, frequency, and servicing capacity of customer service contacts." .


###  http://example.org/apqc#HistoricalDemandData
ex:HistoricalDemandData rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Shared section-5.0 forecasting input (5.2.1.2)." ;
                        rdfs:label "Historical Demand Data" ;
                        skos:definition "A Descriptive Information Content Entity that describes past levels of customer demand for an organization's services, used as input to forecasting." .


###  http://example.org/apqc#HumanCapitalManagementCapability
ex:HumanCapitalManagementCapability rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000568 ;
                                    ex:enablesProcess ex:P10410 ,
                                                      ex:P10413 ,
                                                      ex:P10417 ,
                                                      ex:P17045 ,
                                                      ex:P17046 ,
                                                      ex:P20958 ;
                                    rdfs:comment "Top shared capability for 'Manage human capital / HR function' standing functions." ;
                                    rdfs:label "Human Capital Management Capability" ;
                                    skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to develop and manage its human capital, realized in the human-resources acts of section 7.0." .


###  http://example.org/apqc#HumanResourcesFunction
ex:HumanResourcesFunction rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00001180 ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty obo:BFO_0000196 ;
                                            owl:someValuesFrom ex:HumanResourcesFunctionRole
                                          ] ;
                          rdfs:comment "The HR department/function as an organizational unit (an Organization), NOT a realizable function/capability despite the 'Function' label. Bearer of the HR management capability and the agent of most section 7.0 acts." ;
                          rdfs:label "Human Resources Function" ;
                          skos:definition "An Organization that bears a human-resources-function role within a larger organization in virtue of being tasked with developing and managing the organization's human capital." .


###  http://example.org/apqc#HumanResourcesFunctionRole
ex:HumanResourcesFunctionRole rdf:type owl:Class ;
                              rdfs:subClassOf obo:BFO_0000023 ;
                              rdfs:label "Human Resources Function Role" ;
                              skos:definition "A Role that is borne by an Organization in virtue of being charged with developing and managing the human capital of a larger organization." .


###  http://example.org/apqc#HumanResourcesInformationSystemCapability
ex:HumanResourcesInformationSystemCapability rdf:type owl:Class ;
                                             rdfs:subClassOf cco:ont00000568 ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty obo:BFO_0000054 ;
                                                               owl:someValuesFrom ex:ActOfAdministration
                                                             ] ;
                                             ex:enablesProcess ex:ActOfAdministration ;
                                             rdfs:comment "R5/R6: APQC 7.7.4 (PCF 10525) 'Manage human resource information systems HRIS' is a standing function with no natural end ('administering and maintaining' a system), so it is modeled as an Organization Capability rather than a process. Realized in Acts of Administration." ;
                                             rdfs:label "Human Resources Information System Capability" ;
                                             skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to administer and maintain the HR information systems supporting HR, accounting, management, and payroll activities, realized in repeated acts of HR-system administration." .


###  http://example.org/apqc#HumanResourcesProfessional
ex:HumanResourcesProfessional rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00001017 ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000196 ;
                                                owl:someValuesFrom ex:HumanResourcesProfessionalRole
                                              ] ;
                              rdfs:label "Human Resources Professional" ;
                              skos:definition "An Agent that bears a human-resources-professional role in virtue of performing human-capital management activities on behalf of an organization." .


###  http://example.org/apqc#HumanResourcesProfessionalRole
ex:HumanResourcesProfessionalRole rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000984 ;
                                  rdfs:label "Human Resources Professional Role" ;
                                  skos:definition "A Role that is borne by an Agent in virtue of being tasked with carrying out human-capital management activities on behalf of an organization." .


###  http://example.org/apqc#HumanResourcesStrategy
ex:HumanResourcesStrategy rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:label "Human Resources Strategy" ;
                          skos:definition "A Directive Information Content Entity that prescribes a long-term plan associating human-resource requirements with the strategic goals of an organization." .


###  http://example.org/apqc#Hypothesis
ex:Hypothesis rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000853 ;
              rdfs:comment "Descriptive (853): a hypothesis is a proposed explanation -- a candidate account of how reality is -- not a prescription. CAUTION: the study-design / data-collection PLAN that prescribes how to TEST the hypothesis (what to sample, measure, and collect) is a separate Directive (965) ICE; do not conflate the descriptive conjecture with the directive test plan." ;
              rdfs:label "Hypothesis" ;
              skos:definition "A Descriptive Information Content Entity that describes a proposed explanation of empirical data, used to guide feature selection during data collection." .


###  http://example.org/apqc#IPNeedsAssessment
ex:IPNeedsAssessment rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Minted: no shared-list IP-needs ICE. Descriptive." ;
                     rdfs:label "Intellectual Property Needs Assessment" ;
                     skos:definition "A Descriptive Information Content Entity that describes an analysis of the business need for patents and copyrights for given products or services." .


###  http://example.org/apqc#IPThreatMeasureSpecification
ex:IPThreatMeasureSpecification rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "Carried over from the 1.1.1 reference module." ;
                                rdfs:label "IP Threat Measure Specification" ;
                                skos:definition "A Directive Information Content Entity that prescribes measures and procedures for identifying intellectual-property threats." ;
                                skos:example "A documented procedure listing IP-threat indicators and the steps to screen for them." .


###  http://example.org/apqc#ITAlignmentPrinciples
ex:ITAlignmentPrinciples rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "8.2.1.5 output. Directive: principles prescribe rather than describe." ;
                         rdfs:label "IT Alignment Principles" ;
                         skos:definition "A Directive Information Content Entity that prescribes the guiding principles governing how information technology is used in relation to business objectives." .


###  http://example.org/apqc#ITArchitectureConformanceAssessment
ex:ITArchitectureConformanceAssessment rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000853 ;
                                       rdfs:comment "8.5.3.7 output. Descriptive." ;
                                       rdfs:label "IT Architecture Conformance Assessment" ;
                                       skos:definition "A Descriptive Information Content Entity that describes the functional compliance of an IT service/solution architecture with applicable architecture guidelines." ;
                                       skos:example "A conformance report flagging two deviations from the reference architecture." .


###  http://example.org/apqc#ITArchitectureConstraintAssessment
ex:ITArchitectureConstraintAssessment rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000853 ;
                                      rdfs:comment "8.5.3.1 output. Descriptive." ;
                                      rdfs:label "IT Architecture Constraint Assessment" ;
                                      skos:definition "A Descriptive Information Content Entity that describes limitations in IT application and infrastructure architecture that may hinder expected performance." ;
                                      skos:example "A findings note that the current message bus caps throughput below the target SLA." .


###  http://example.org/apqc#ITArchitectureExceptionResolution
ex:ITArchitectureExceptionResolution rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "8.5.3.8 output. Directive." ;
                                     rdfs:label "IT Architecture Exception Resolution" ;
                                     skos:definition "A Directive Information Content Entity that prescribes how an identified architectural exception is to be resolved or waived." ;
                                     skos:example "A signed waiver permitting a non-standard database for one legacy integration." .


###  http://example.org/apqc#ITAsset
ex:ITAsset rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00000995 ;
           rdfs:comment "Section-8.0 shared material entity. APQC 8.1.2.2 / 8.3 'IT Assets', 8.7.7.4 'IT asset records'. Genus Material Artifact (cco:ont00000995); use the narrower ex:ITInfrastructureComponent for deployed computing/network hardware. Material I/O is legal in operations category 8.0." ;
           rdfs:label "IT Asset" ;
           skos:definition "A Material Artifact that is a hardware or software resource owned or used by an organization to store, retrieve, transmit, or manipulate data in support of business operations." .


###  http://example.org/apqc#ITAuditReport
ex:ITAuditReport rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "8.3.8.5/.8 output. Descriptive." ;
                 rdfs:label "IT Audit Report" ;
                 skos:definition "A Descriptive Information Content Entity that describes the findings of examining IT processes or systems - such as user identity and authorization systems or their integration - against required regulations." ;
                 skos:example "An audit report confirming that the identity-management system meets access-review regulations." .


###  http://example.org/apqc#ITBusinessCase
ex:ITBusinessCase rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Minted locally (8.1.4.7 & 8.1.4.8): no shared ICE captures a business case. Descriptive (an argument/representation) per the gold-template treatment of business cases." ;
                  rdfs:label "IT Business Case" ;
                  skos:definition "A Descriptive Information Content Entity that describes the current situation, proposed solution, financial analysis, and measurable benefits of a proposed IT initiative for its customers." ;
                  skos:example "A document justifying an ERP upgrade with cost-benefit figures and projected savings." .


###  http://example.org/apqc#ITBusinessConstraintAssessment
ex:ITBusinessConstraintAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "8.5.3.2 output. Descriptive." ;
                                  rdfs:label "IT Business Constraint Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes business limitations that may hinder the performance of an IT service/solution." ;
                                  skos:example "An assessment that a fixed annual budget constrains the chosen solution's scaling." .


###  http://example.org/apqc#ITCapabilityCommunication
ex:ITCapabilityCommunication rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cco:ont00001808 ;
                                               owl:someValuesFrom ex:BusinessObjectives
                                             ] ;
                             rdfs:comment "Minted locally (8.1.6.4) as the communicated descriptive product of P20645 'Communicate IT capabilities'. Descriptive: it gives an account of IT's goals and contribution rather than prescribing action -- the has-output the communication act previously lacked (Gate-F fix). Carries 'is about' the business objectives it relates IT capability to." ;
                             rdfs:label "IT Capability Communication" ;
                             skos:definition "A Descriptive Information Content Entity that conveys, to staff and departments across an organization, the goals and objectives of the IT function and how it contributes to the overall business objectives." ;
                             skos:example "A town-hall deck describing the IT function's goals and its contribution to corporate objectives." .


###  http://example.org/apqc#ITChangeControlRecord
ex:ITChangeControlRecord rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Section-8.0 shared output. Minted for the change/release control gate and documentation outputs (8.6.3 manage change deployment control, 8.6.3.7 document change/release outcome). Descriptive: it records the change-control disposition and outcome. Distinct from ex:ITServiceSupportRecord, which is scoped to 8.7.8 help-desk incident/request resolution (whose definition is the disposition of a resolved issue/request) -- Gate-F fix on P20840/P20847, where the output filler previously mismatched the skos:definition." ;
                         rdfs:label "IT Change Control Record" ;
                         skos:definition "A Descriptive Information Content Entity that describes the control disposition of an IT change or release, including the impact, compliance, and risk findings, the approval decision, and the recorded deployment outcome." .


###  http://example.org/apqc#ITCommunicationStandard
ex:ITCommunicationStandard rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "8.3.3.7 output. Directive." ;
                           rdfs:label "IT Communication Standard" ;
                           skos:definition "A Directive Information Content Entity that prescribes standards for communications within an organization, creating a road map for understanding strategic IT and business initiatives." ;
                           skos:example "A standard mandating a common template for IT-change communications." .


###  http://example.org/apqc#ITComplianceAuditReport
ex:ITComplianceAuditReport rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Section-8.0 shared output. APQC 8.3.6 conduct and analyze IT compliance assessments, 8.3.6.2 compliance control auditing, 8.3.6.3 compliance reporting, 8.3.8.5 audit identity systems, 8.4.4.3 usage audits, 8.6.3.2 confirm change compliance. Descriptive: an audit report records findings (output of ex:ActOfVerification)." ;
                           rdfs:label "IT Compliance Audit Report" ;
                           skos:definition "A Descriptive Information Content Entity that describes the findings of an audit evaluating whether IT capability and resources conform to applicable regulations, standards, and legislation." .


###  http://example.org/apqc#ITComplianceIssueRegister
ex:ITComplianceIssueRegister rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "8.3.6.4 output. Descriptive." ;
                             rdfs:label "IT Compliance Issue and Remediation Requirement Register" ;
                             skos:definition "A Descriptive Information Content Entity that describes identified and escalated IT compliance issues together with the corrective and remediation requirements they call for." ;
                             skos:example "An escalated finding that a service breaches a retention regulation, with the required remediation noted." .


###  http://example.org/apqc#ITComplianceObjective
ex:ITComplianceObjective rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "8.3.1.6 output. Directive." ;
                         rdfs:label "IT Compliance Objective" ;
                         skos:definition "A Directive Information Content Entity that prescribes a compliance objective ensuring that an organization has systems of internal controls adequately measuring and managing IT risk." ;
                         skos:example "An objective requiring all IT changes to pass a documented control review before release." .


###  http://example.org/apqc#ITComplianceRequirementSpecification
ex:ITComplianceRequirementSpecification rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000965 ;
                                        rdfs:comment "Section-8.0 shared output. APQC 8.3.3.3 create/maintain compliance requirements, 8.3.1.6 compliance objectives. Directive." ;
                                        rdfs:label "IT Compliance Requirement Specification" ;
                                        skos:definition "A Directive Information Content Entity that prescribes the compliance standards and control requirements an organization's IT must satisfy to meet regulatory and audit obligations." .


###  http://example.org/apqc#ITComplianceSupportSystemIdentification
ex:ITComplianceSupportSystemIdentification rdf:type owl:Class ;
                                           rdfs:subClassOf cco:ont00000853 ;
                                           rdfs:comment "8.3.1.7 output. Descriptive." ;
                                           rdfs:label "IT Compliance Support System Identification" ;
                                           skos:definition "A Descriptive Information Content Entity that describes the information-technology solutions identified and adopted to support changing regulatory compliance." ;
                                           skos:example "A shortlist of GRC tools selected to track regulatory obligations." .


###  http://example.org/apqc#ITContinuityGapRegister
ex:ITContinuityGapRegister rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "8.3.4.2 output. Descriptive." ;
                           rdfs:label "IT Continuity Gap Register" ;
                           skos:definition "A Descriptive Information Content Entity that describes the limitations of an IT organization's ability to remediate disruptions in IT services." ;
                           skos:example "A register listing services lacking a tested recovery procedure." .


###  http://example.org/apqc#ITContinuityPlan
ex:ITContinuityPlan rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Section-8.0 shared output. APQC 8.3.7.2 business continuity planning, 8.3.4 plan and manage IT continuity, 8.7.8.6 continuity and recovery action. Directive." ;
                    rdfs:label "IT Continuity Plan" ;
                    skos:definition "A Directive Information Content Entity that prescribes the resources, procedures, and actions required to maintain or rapidly recover critical IT services when exposed to internal or external disruption." .


###  http://example.org/apqc#ITControlGovernanceModel
ex:ITControlGovernanceModel rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:comment "8.2.5.2 output. Directive: prescribes the control/assurance structure and procedures." ;
                            rdfs:label "IT Control and Assurance Governance Model" ;
                            skos:definition "A Directive Information Content Entity that prescribes the control points, evaluation procedures, and quality-control procedures by which control is exercised over the IT management system." .


###  http://example.org/apqc#ITCustomer
ex:ITCustomer rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00001017 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty obo:BFO_0000196 ;
                                owl:someValuesFrom ex:ITCustomerRole
                              ] ;
              rdfs:comment "Section-8.0 shared. APQC 8.1 'staff dependent on information technology' / internal IT user base. Modeled as Agent (may be an individual user or, where APQC says 'community', a Group); use cco:ont00001180 (Organization) when the customer is specifically an organizational unit." ;
              rdfs:label "IT Customer" ;
              skos:definition "An Agent that bears an IT customer role in virtue of consuming or depending on the information-technology services and solutions provided by an organization's IT function." .


###  http://example.org/apqc#ITCustomerContract
ex:ITCustomerContract rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Minted locally (8.1.5.5): distinct from a Service Level Agreement (a contract may bundle hardware/software provision and support channels). Directive because it prescribes obligations." ;
                      rdfs:label "IT Customer Contract" ;
                      skos:definition "A Directive Information Content Entity that records a binding commitment of IT service or product provision to a customer, including delivery and support channels." ;
                      skos:example "A signed agreement to provide and support a hardware refresh for a department." .


###  http://example.org/apqc#ITCustomerFeedback
ex:ITCustomerFeedback rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Section-8.0 shared input. APQC 8.1.7.3 collect feedback, 8.1.5.2 customer feedback in forecasting. Descriptive." ;
                      rdfs:label "IT Customer Feedback" ;
                      skos:definition "A Descriptive Information Content Entity that describes IT customers' evaluations of the effectiveness and satisfaction of delivered IT products and services." .


###  http://example.org/apqc#ITCustomerNeedsAssessment
ex:ITCustomerNeedsAssessment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Section-8.0 shared output. APQC 8.1.1 understand IT customer needs, 8.1.1.2 assess operational capabilities. Descriptive: it represents an understanding (GOLDEN PRINCIPLE)." ;
                             rdfs:label "IT Customer Needs Assessment" ;
                             skos:definition "A Descriptive Information Content Entity that describes an understanding of IT customers' needs, capabilities, and usage gathered from interaction and evaluation." .


###  http://example.org/apqc#ITCustomerRelationshipManagementCapability
ex:ITCustomerRelationshipManagementCapability rdf:type owl:Class ;
                                              rdfs:subClassOf cco:ont00000568 ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:BFO_0000054 ;
                                                                owl:someValuesFrom ex:P20608
                                                              ] ;
                                              ex:enablesProcess ex:P20608 ;
                                              rdfs:comment "Section-8.0 shared. Target for standing 'Develop and manage IT customer relationships' / 'Manage IT customer relationships' headings (8.1, 8.1.6) that fail the R5 test. 8.1.3.1 (PCF 20618) and 8.1.6 (PCF 20641) are standing functions realized (R6) in the bounded IT-customer-relationship acts of group 8.1." ;
                                              rdfs:label "IT Customer Relationship Management Capability" ;
                                              skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to establish, coordinate, and sustain relationships with its IT customers over multiple touch points." .


###  http://example.org/apqc#ITCustomerRequirements
ex:ITCustomerRequirements rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Section-8.0 shared input. APQC 8.1.4.2 collect, 8.1.4.3 analyze, 8.2.4.2 / 8.5.4.1.1 requirements. Descriptive: it states needs rather than prescribing action." ;
                          rdfs:label "IT Customer Requirements" ;
                          skos:definition "A Descriptive Information Content Entity that describes the needs, expectations, and business requirements that IT customers place on the IT services and solutions to be delivered." .


###  http://example.org/apqc#ITCustomerRole
ex:ITCustomerRole rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000023 ;
                  rdfs:label "IT Customer Role" ;
                  skos:definition "A Role that is borne by an Agent in virtue of consuming or depending on the IT services and solutions delivered by an organization's IT function." .


###  http://example.org/apqc#ITDeploymentCommunication
ex:ITDeploymentCommunication rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Output of 8.6.2.6 and 8.6.5.2. Treated as Directive because deployment notices prescribe expected user actions; demote to cco:ont00000853 if a given instance is purely informational." ;
                             rdfs:label "IT Deployment Communication" ;
                             skos:definition "A Directive Information Content Entity that conveys to employees and stakeholders the forthcoming changes to IT services and solutions and the actions expected of them." .


###  http://example.org/apqc#ITDeploymentImpactAssessment
ex:ITDeploymentImpactAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Section-8.0 shared output. APQC 8.6.1.1 assess deployment business impact, 8.6.1.6 analyze outcomes, 8.6.3.1 change/release impact, 8.6.2.1 / 8.6.3.3 deployment risk. Descriptive: an assessment reports a judgement." ;
                                rdfs:label "IT Deployment Impact Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes a judgement of the business impact, benefit, and risk of deploying an IT change or release." .


###  http://example.org/apqc#ITDevelopmentToolStandard
ex:ITDevelopmentToolStandard rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "8.5.1.3 output. Directive." ;
                             rdfs:label "IT Development Methodology and Tool Standard" ;
                             skos:definition "A Directive Information Content Entity that prescribes the development methodologies and tools adopted for building IT services/solutions." ;
                             skos:example "A standards page mandating the approved CI/CD pipeline and IDE toolchain." .


###  http://example.org/apqc#ITDevelopmentValueAssessment
ex:ITDevelopmentValueAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "8.5.1.1 output. Descriptive." ;
                                rdfs:label "IT Development Value Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes the cost-effectiveness and development value of candidate IT service/solution development methods." ;
                                skos:example "A pros/cons cost-benefit memo comparing two solution-development approaches." .


###  http://example.org/apqc#ITInfrastructureComponent
ex:ITInfrastructureComponent rdf:type owl:Class ;
                             rdfs:subClassOf ex:ITAsset ,
                                             cco:ont00000117 ;
                             rdfs:comment "Section-8.0 shared. APQC 8.5.4.1.3 'build and test components', 8.6.4 / 8.7.7.3 install/configure/upgrade components, 8.7.7.1 configuration items. Doubly anchored: an IT Asset (cco:ont00000995) and an Information Processing Artifact (cco:ont00000117, designed to transform ICEs)." ;
                             rdfs:label "IT Infrastructure Component" ;
                             skos:definition "An IT Asset that is also an Information Processing Artifact, comprising a discrete hardware, software, or network element of an organization's IT infrastructure (such as a server, network device, or installed software package)." .


###  http://example.org/apqc#ITInfrastructureManagementCapability
ex:ITInfrastructureManagementCapability rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000568 ;
                                        ex:enablesProcess ex:P20888 ,
                                                          ex:P20889 ,
                                                          ex:P20890 ,
                                                          ex:P20891 ,
                                                          ex:P20892 ,
                                                          ex:P20893 ,
                                                          ex:P20915 ,
                                                          ex:P20916 ,
                                                          ex:P20917 ,
                                                          ex:P20918 ,
                                                          ex:P20919 ,
                                                          ex:P20920 ;
                                        rdfs:comment "Section-8.0 shared. Target for standing 'Develop and manage infrastructure resource planning' / 'Manage infrastructure resource administration' headings (8.7.4, 8.7.7) that fail the R5 test." ;
                                        rdfs:label "IT Infrastructure Management Capability" ;
                                        skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to plan, administer, and maintain the IT infrastructure resources, inventory, and assets that support business operations." .


###  http://example.org/apqc#ITInnovationPromotionDecision
ex:ITInnovationPromotionDecision rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "8.2.7.6 output. Directive: selects and prescribes the concepts to advance." ;
                                 rdfs:label "IT Innovation Promotion Decision" ;
                                 skos:definition "A Directive Information Content Entity that prescribes which viable IT innovation concepts are to be promoted in pursuit of business objectives." .


###  http://example.org/apqc#ITInterdependencyManagementCapability
ex:ITInterdependencyManagementCapability rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000568 ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P20690
                                                         ] ;
                                         ex:apqcSourceText "Manage capabilities required for the successful delivery of information technology projects, which, by extension, affect the success of the overall IT services." ;
                                         ex:enablesProcess ex:P20690 ;
                                         ex:hierarchyID "8.2.5.7" ;
                                         ex:pcfID "20689" ;
                                         rdfs:comment "R5/R6 fix for APQC 8.2.5.7 [20689]: managing interdependencies among projects and services is a standing coordination function with no natural end, modeled as an Organization Capability rather than a bounded act. Realized in ex:P20690 (Report IT service and project performance), among the bounded control acts that exercise this coordination. The catalog node ex:PCF_20689 designates this capability." ;
                                         rdfs:label "IT Projects and Services Interdependency Management Capability" ;
                                         skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to manage the interdependencies among IT projects and services required for their successful delivery." ;
                                         skos:example "A portfolio office's continuous coordination of cross-project and cross-service dependencies." .


###  http://example.org/apqc#ITInvestmentBalanceAssessment
ex:ITInvestmentBalanceAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "8.2.2.2 output. Descriptive: reports a state of the portfolio." ;
                                 rdfs:label "IT Investment Balance Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the uninvested portion of the total approved amount for IT management, investments, projects, and activities." .


###  http://example.org/apqc#ITInvestmentProjectEvaluation
ex:ITInvestmentProjectEvaluation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "8.2.2.3 output. Descriptive: judges proposed projects without prescribing the portfolio decision." ;
                                 rdfs:label "IT Investment Project Evaluation" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the assessed implementation feasibility, efficiency, and profitability of proposed IT investment projects relative to business objectives." .


###  http://example.org/apqc#ITIssueRequest
ex:ITIssueRequest rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Section-8.0 shared input/work item. APQC 8.7.8 operate IT user support (triage/manage/escalate/resolve requests), 8.7.5.9 triage incidents. Descriptive: it records the reported matter." ;
                  rdfs:label "IT Issue/Request" ;
                  skos:definition "A Descriptive Information Content Entity that describes a reported IT incident, problem, or service request raised by a user for routing, tracking, and resolution." .


###  http://example.org/apqc#ITIssueRequestData
ex:ITIssueRequestData rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Minted because group 8.7 demand analysis consumes a corpus of past issues/requests; distinct from the shared ex:ITIssueRequest (a single issue/request instance)." ;
                      rdfs:label "IT Issue/Request Data" ;
                      skos:definition "A Descriptive Information Content Entity that describes the recorded history of IT issues and requests used as analytic input for demand profiling." .


###  http://example.org/apqc#ITKnowledgeRepository
ex:ITKnowledgeRepository rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Section-8.0 shared output/asset. APQC 8.7.5.3 maintain knowledge repository, 8.7.5.4 maintain support learning. Descriptive: it consists of knowledge describing IT and its issues." ;
                         rdfs:label "IT Knowledge Repository" ;
                         skos:definition "A Descriptive Information Content Entity that constitutes a maintained body of service-support knowledge stored for access, revision, and reuse in resolving IT issues." .


###  http://example.org/apqc#ITLandscapeData
ex:ITLandscapeData rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "Section-8.0 shared input. APQC 8.1.2.2 'understand IT landscape', 8.7.4.3 existing infrastructure capabilities, 8.7.7.1 configuration, 8.7.7.4 asset records. Descriptive." ;
                   rdfs:label "IT Landscape Data" ;
                   skos:definition "A Descriptive Information Content Entity that describes the logical structure, hardware and software configuration, and working of an organization's existing IT environment." .


###  http://example.org/apqc#ITMarketingMessage
ex:ITMarketingMessage rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Minted locally (8.1.3.4): no shared ICE captures persuasive marketing content. Modeled as Directive ICE when the message prescribes expected actions, commitments, or positioning to be used; a purely informational communication about an already-determined state should be modeled as Descriptive ICE (cco:ont00000853)." ;
                      rdfs:label "IT Marketing Message" ;
                      skos:definition "A Directive Information Content Entity that positions the value proposition of IT offerings to a segment of IT customers in order to influence their choices." ;
                      skos:example "A one-line value statement promoting a self-service portal to internal IT users." .


###  http://example.org/apqc#ITMarketingPlan
ex:ITMarketingPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Minted locally (8.1.3.5): no shared ICE captures a marketing plan. Directive because it prescribes a course of action." ;
                   rdfs:label "IT Service Marketing Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes the budget, media, content, and promotional activities for marketing IT offerings to customers." ;
                   skos:example "A quarterly plan allocating budget across newsletters and webinars to promote a new IT service." .


###  http://example.org/apqc#ITNeedsAssessment
ex:ITNeedsAssessment rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Minted locally: not present in the shared vocabulary list. Descriptive (judges/represents requirements) per the GOLDEN PRINCIPLE; it is the definitional output of ex:P11106." ;
                     rdfs:label "IT Needs Assessment" ;
                     skos:definition "A Descriptive Information Content Entity that describes the information-technology requirements for building and implementing a knowledge-management strategy." .


###  http://example.org/apqc#ITPerformanceData
ex:ITPerformanceData rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Section-8.0 shared input. APQC 8.1.7, 8.2.5.x monitor/analyze performance, 8.7.6.4. Descriptive: it records measured values. Distinct from ex:ITPerformanceReport (the analysed output)." ;
                     rdfs:label "IT Performance Data" ;
                     skos:definition "A Descriptive Information Content Entity that describes measured values of IT cost, utilization, availability, quality, and service-level attainment used to evaluate IT performance." .


###  http://example.org/apqc#ITPerformanceIndicatorSpecification
ex:ITPerformanceIndicatorSpecification rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000965 ;
                                       rdfs:comment "Minted locally (8.1.3.3): no shared ICE captures a KPI-definition artifact. Directive because it prescribes what to measure rather than describing a measurement." ;
                                       rdfs:label "IT Performance Indicator Specification" ;
                                       skos:definition "A Directive Information Content Entity that prescribes the key performance indicators by which IT performance is to be measured across an organization." ;
                                       skos:example "A definition document fixing IT cost as a percentage of revenue, IT maintenance ratio, and system downtime as the official IT KPIs." .


###  http://example.org/apqc#ITPerformanceMeasureSpecification
ex:ITPerformanceMeasureSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "8.2.5.1 output. Directive: a measure/KPI specification prescribes how performance is to be measured." ;
                                     rdfs:label "IT Performance Measure Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes the key performance indicators and measures, including the IT services performance index, used to evaluate IT performance." .


###  http://example.org/apqc#ITPerformanceReport
ex:ITPerformanceReport rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Section-8.0 shared output. APQC 8.2.5 control IT management system, 8.2.5.8 report performance, 8.1.7.4 synthesize/distribute performance, 8.7.6.4 infrastructure performance. Descriptive: it reports measured/analysed performance." ;
                       rdfs:label "IT Performance Report" ;
                       skos:definition "A Descriptive Information Content Entity that describes the analyzed performance of IT services, projects, finances, and value against established measures and targets." .


###  http://example.org/apqc#ITPolicy
ex:ITPolicy rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000965 ;
            rdfs:comment "Section-8.0 shared output. APQC 8.3.3.4 / 8.3.5.3 security and privacy policies, 8.4.3.1 information policies, 8.6.1.2 deployment policies, 8.3.8.1 authorization policies. Directive." ;
            rdfs:label "IT Policy" ;
            skos:definition "A Directive Information Content Entity that prescribes rules and standards governing the creation, use, security, privacy, access, and disposition of an organization's IT services, data, and infrastructure." .


###  http://example.org/apqc#ITPortfolioAdjustmentDecision
ex:ITPortfolioAdjustmentDecision rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "8.2.6.4 output. Directive: a decision prescribing the adjustments to enact." ;
                                 rdfs:label "IT Portfolio Adjustment Decision" ;
                                 skos:definition "A Directive Information Content Entity that prescribes adjustments to IT investments, projects, and activities in response to technological advancements in pursuit of business objectives." .


###  http://example.org/apqc#ITPortfolioPlan
ex:ITPortfolioPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Section-8.0 shared output. APQC 8.2.2 manage IT portfolio strategy, 8.2.6.4 portfolio adjustments, 8.2.7.7 plan investment projects, 8.7.1.2 / 8.7.2.2 delivery/support portfolio. Directive: it prescribes resource allocation and prioritization." ;
                   rdfs:label "IT Portfolio Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes the prioritized allocation of resources across an organization's IT investments, projects, and activities to achieve business objectives." .


###  http://example.org/apqc#ITPrioritizationDecision
ex:ITPrioritizationDecision rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:comment "Minted locally (8.1.4.4 & 8.1.4.6): shared vocab has no prioritization-decision ICE. Directive because a ranking commits to a course of action." ;
                            rdfs:label "IT Prioritization Decision" ;
                            skos:definition "A Directive Information Content Entity that prescribes a ranking of IT opportunities or outcomes by their relative importance, effectiveness, and efficiency." ;
                            skos:example "A ranked list designating three IT opportunities as high priority for the coming year." .


###  http://example.org/apqc#ITProcessExceptionResolution
ex:ITProcessExceptionResolution rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "8.5.4.1.7 output. Directive." ;
                                rdfs:label "IT Service/Solution Process Exception Resolution" ;
                                skos:definition "A Directive Information Content Entity that prescribes how an internal service/solution process exception or inquiry is to be resolved." ;
                                skos:example "A documented decision granting an exceptional build path for an urgent feature." .


###  http://example.org/apqc#ITProjectPrioritization
ex:ITProjectPrioritization rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "8.2.2.4 / 8.2.3.4 output. Directive: a ranked decision prescribing which projects take precedence." ;
                           rdfs:label "IT Project Prioritization" ;
                           skos:definition "A Directive Information Content Entity that prescribes a ranked ordering of IT projects from most to least critical to business operations." .


###  http://example.org/apqc#ITRegulatoryAuditRequirementAssessment
ex:ITRegulatoryAuditRequirementAssessment rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000853 ;
                                          rdfs:comment "8.3.1.1 output. Descriptive." ;
                                          rdfs:label "IT Regulatory and Audit Requirement Assessment" ;
                                          skos:definition "A Descriptive Information Content Entity that describes the IT regulatory and audit requirements applicable to an organization together with an evaluation of their implications." ;
                                          skos:example "A compliance team's documented evaluation of which audit and regulatory obligations apply to a new IT product." .


###  http://example.org/apqc#ITRelationshipManagementMechanismSpecification
ex:ITRelationshipManagementMechanismSpecification rdf:type owl:Class ;
                                                  rdfs:subClassOf cco:ont00000965 ;
                                                  rdfs:comment "Minted locally (8.1.6.1): no shared ICE captures a relationship-mechanism design. Directive because it prescribes how relations are to be conducted." ;
                                                  rdfs:label "IT Relationship Management Mechanism Specification" ;
                                                  skos:definition "A Directive Information Content Entity that prescribes the mechanisms and touch points for managing public relations and goodwill with IT customers." ;
                                                  skos:example "A defined cadence of newsletters, social-media outreach, and direct conversations for an IT customer segment." .


###  http://example.org/apqc#ITRequirementsAnalysis
ex:ITRequirementsAnalysis rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cco:ont00001808 ;
                                            owl:someValuesFrom ex:ITCustomerRequirements
                                          ] ;
                          rdfs:comment "Section-8.0 shared output. APQC 8.1.4.3 analyze requirements, 8.5.4.1.1 assess/validate requirements. Descriptive analysis; carries 'is about' its subject IT customer requirements." ;
                          rdfs:label "IT Requirements Analysis" ;
                          skos:definition "A Descriptive Information Content Entity that describes the result of assessing collected IT customer requirements, including identified gaps between expected and current business outcomes." .


###  http://example.org/apqc#ITRequirementsStatement
ex:ITRequirementsStatement rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "FALSE FRIEND: despite the label 'Requirement', this is a DESCRIPTIVE (853) record of requirements gathered by a discernment act; the directive requirement itself is modeled separately. An enumeration of discerned IT requirements. Output of ex:P11124 'Identify specific IT requirements'." ;
                           rdfs:label "IT Requirements Statement" ;
                           skos:definition "A Descriptive Information Content Entity that describes the information-technology requirements -- computers and telecommunications equipment to store, retrieve, transmit, and manipulate data -- of a specific project." .


###  http://example.org/apqc#ITResearchFindings
ex:ITResearchFindings rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Section-8.0 shared output. APQC 8.2.3.3 research technologies to innovate, 8.2.7.3 / 8.2.7.4 execute research projects, 8.2.7.5 evaluate outcomes. Descriptive." ;
                      rdfs:label "IT Research Findings" ;
                      skos:definition "A Descriptive Information Content Entity that describes the insights and conclusions reached by systematically investigating technologies and sources to innovate IT services and solutions." .


###  http://example.org/apqc#ITResearchOutcomeAssessment
ex:ITResearchOutcomeAssessment rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "8.2.7.5 output. Descriptive: appraises research outcomes." ;
                               rdfs:label "IT Research Outcome Assessment" ;
                               skos:definition "A Descriptive Information Content Entity that describes the assessed results of IT research projects against their defined outcome expectations." .


###  http://example.org/apqc#ITResearchSelectionCriteria
ex:ITResearchSelectionCriteria rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "8.2.7.1 output. Directive: criteria prescribe which research initiatives qualify." ;
                               rdfs:label "IT Research Selection Criteria" ;
                               skos:definition "A Directive Information Content Entity that prescribes the standards for selecting IT research initiatives so they align with organizational criteria for implementing future technologies." .


###  http://example.org/apqc#ITResilienceAssessment
ex:ITResilienceAssessment rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "8.3.1.9 / 8.3.2.1 / 8.3.4.1 output. Descriptive." ;
                          rdfs:label "IT Resilience Assessment" ;
                          skos:definition "A Descriptive Information Content Entity that describes a judgement of an organization's IT resilience strategies and its ability to manage and recover from risk." ;
                          skos:example "An assessment rating the resilience of IT delivery against named disruption scenarios." .


###  http://example.org/apqc#ITResilienceStrategy
ex:ITResilienceStrategy rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "8.3.2 output. Directive." ;
                        rdfs:label "IT Resilience Strategy" ;
                        skos:definition "A Directive Information Content Entity that prescribes how IT across an organization is to adapt to and avoid prospective risks and disruptions." ;
                        skos:example "An enterprise IT resilience strategy specifying redundancy, recovery, and adaptation measures." .


###  http://example.org/apqc#ITResourceOptimizationPlan
ex:ITResourceOptimizationPlan rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "8.2.5.6 output. Directive: prescribes the resource-allocation process." ;
                              rdfs:label "IT Resource Optimization Plan" ;
                              skos:definition "A Directive Information Content Entity that prescribes the process for assigning and managing IT assets in support of an organization's strategic goals." .


###  http://example.org/apqc#ITReuseOpportunityRegister
ex:ITReuseOpportunityRegister rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "8.5.3.4 output. Descriptive." ;
                              rdfs:label "IT Component Reuse Opportunity Register" ;
                              skos:definition "A Descriptive Information Content Entity that registers identified opportunities for reusing IT components." ;
                              skos:example "A list of existing modules that could be reused in new solutions to cut cost." .


###  http://example.org/apqc#ITRiskAssessment
ex:ITRiskAssessment rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Section-8.0 shared output. APQC 8.3.1.8 identify and evaluate IT risk, 8.3.2.2 critical risks, 8.3.3.8 risk and threat assessments. Descriptive: an assessment reports a judgement." ;
                    rdfs:label "IT Risk Assessment" ;
                    skos:definition "A Descriptive Information Content Entity that describes identified IT risks together with a judgement of their likelihood, impact, and criticality to IT operations and objectives." .


###  http://example.org/apqc#ITRiskManagementCapability
ex:ITRiskManagementCapability rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000568 ;
                              ex:enablesProcess ex:P20706 ,
                                                ex:P20721 ;
                              rdfs:comment "Section-8.0 shared. Target for standing 'Develop and manage IT resilience and risk' / 'Control IT risk, compliance, and security' headings (8.3, 8.3.3) that fail the R5 test." ;
                              rdfs:label "IT Risk Management Capability" ;
                              skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to identify, evaluate, mitigate, and control risks to its IT operations and assets." .


###  http://example.org/apqc#ITRiskManagementRoleSpecification
ex:ITRiskManagementRoleSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "8.3.1.5 output. Directive." ;
                                     rdfs:label "IT Risk Management Role Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes the specialized risk-management roles for each IT risk area together with their escalation structure." ;
                                     skos:example "A definition of a 'Cloud Risk Lead' role and its escalation path to the IT risk committee." .


###  http://example.org/apqc#ITRiskMitigationStrategy
ex:ITRiskMitigationStrategy rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:comment "Section-8.0 shared output. APQC 8.3.1.10 / 8.3.2.4 mitigation strategies and approaches, 8.3.2 resilience strategy. Directive." ;
                            rdfs:label "IT Risk Mitigation Strategy" ;
                            skos:definition "A Directive Information Content Entity that prescribes activities and approaches for reducing threats to, and improving the resilience of, an organization's IT operations and projects." .


###  http://example.org/apqc#ITRiskOwner
ex:ITRiskOwner rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00001017 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000196 ;
                                 owl:someValuesFrom ex:ITRiskOwnerRole
                               ] ;
               rdfs:comment "Section-8.0 shared. APQC 8.3.1.4 'establish risk ownership' -- an individual or group ultimately accountable for IT risk. Agent (individual or group)." ;
               rdfs:label "IT Risk Owner" ;
               skos:definition "An Agent that bears an IT risk owner role in virtue of being accountable for ensuring that a defined category of IT risk is managed appropriately." .


###  http://example.org/apqc#ITRiskOwnerRole
ex:ITRiskOwnerRole rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000984 ;
                   rdfs:comment "APQC 8.3.1.4 / 8.3.1.5 risk ownership and risk-management roles." ;
                   rdfs:label "IT Risk Owner Role" ;
                   skos:definition "A Role that is borne by an Agent in virtue of being accountable for ensuring that a defined category of IT risk is managed appropriately." .


###  http://example.org/apqc#ITRiskOwnershipAssignment
ex:ITRiskOwnershipAssignment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "8.3.1.4 output. Directive." ;
                             rdfs:label "IT Risk Ownership Assignment" ;
                             skos:definition "A Directive Information Content Entity that prescribes which individual or group is ultimately accountable for ensuring that IT risks are managed appropriately." ;
                             skos:example "A RACI entry naming the CISO as accountable owner of cyber-security risk." .


###  http://example.org/apqc#ITRiskPrioritization
ex:ITRiskPrioritization rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "8.3.2.3 output. Gate-F fix: reclassified from Descriptive (cco:ont00000853) to Directive (cco:ont00000965) for consistency with the parallel ranking outputs ex:ITProjectPrioritization and ex:ITPrioritizationDecision, both Directive. A risk ranking that commits to a mitigation order prescribes a course of action (output of ex:ActOfSelection at P20719). Also serves as the Directive input to P20720 'Establish mitigation approaches for IT risks'." ;
                        rdfs:label "IT Risk Prioritization" ;
                        skos:definition "A Directive Information Content Entity that prescribes a ranked ordering of potential IT risks by business need, committing the organization to a mitigation sequence so as to support overall IT stability." ;
                        skos:example "A ranked risk register placing data-loss risk above intermittent-latency risk, fixing the mitigation order." .


###  http://example.org/apqc#ITRiskReportingSpecification
ex:ITRiskReportingSpecification rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "8.3.3.6 output. Directive." ;
                                rdfs:label "IT Risk Reporting Specification" ;
                                skos:definition "A Directive Information Content Entity that prescribes the processes, capabilities, and responsibilities for communicating IT risk throughout an organization." ;
                                skos:example "A reporting matrix specifying who escalates which IT risk to whom and when." .


###  http://example.org/apqc#ITRiskToleranceSpecification
ex:ITRiskToleranceSpecification rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "8.3.1.3 output. Directive." ;
                                rdfs:label "IT Risk Tolerance Specification" ;
                                skos:definition "A Directive Information Content Entity that prescribes the maximum acceptable risk, in quantitative terms, for each relevant IT risk sub-category (strategic, operational, financial, and compliance)." ;
                                skos:example "A board-approved statement that operational IT downtime risk shall not exceed a stated annual loss threshold." .


###  http://example.org/apqc#ITRoadmap
ex:ITRoadmap rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000965 ;
             rdfs:comment "Section-8.0 shared output. APQC 8.1.2.4 service expectations roadmap, 8.1.4.9 transformation roadmap. Directive: a roadmap prescribes a course of action over time." ;
             rdfs:label "IT Roadmap" ;
             skos:definition "A Directive Information Content Entity that prescribes a sequenced plan of milestones for moving the IT environment from its current state to a planned future state." .


###  http://example.org/apqc#ITRollBackManagementCapability
ex:ITRollBackManagementCapability rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000568 ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty obo:BFO_0000054 ;
                                                    owl:someValuesFrom ex:P20857
                                                  ] ;
                                  ex:apqcSourceText "Manage IT roll-back procedures to return a deployment to its previous operating state when a change or release impedes operational expectations." ;
                                  ex:enablesProcess ex:P20857 ;
                                  ex:hierarchyID "8.6.2.7" ;
                                  ex:pcfID "20839" ;
                                  rdfs:comment "R5/R6: APQC 8.6.2.7 [20839] 'Manage IT roll-back procedures' is a standing roll-back governance function with no natural end, so it is an Organization Capability (cco:ont00000568), not a process. Realized in ex:P20857 (Execute roll-back plan). Specialization of the shared ex:ITServiceManagementCapability." ;
                                  rdfs:label "IT Roll-Back Management Capability" ;
                                  skos:definition "An Organization Capability that is realized in acts of executing IT roll-back plans to return a deployment to its previous operating state." .


###  http://example.org/apqc#ITSecurityBreach
ex:ITSecurityBreach rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "8.3.8.6 output. Descriptive." ;
                    rdfs:label "IT Security Breach Record" ;
                    skos:definition "A Descriptive Information Content Entity that describes an unauthorized network breach - such as unauthorized access to or usage of data, applications, services, networks, or devices - together with its root cause and corrective resolution." ;
                    skos:example "An incident record of an unauthorized data-exfiltration event and its remediation." .


###  http://example.org/apqc#ITSecurityControlReview
ex:ITSecurityControlReview rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "8.3.5.4/.5/.6 output. Descriptive." ;
                           rdfs:label "IT Security Control Review" ;
                           skos:definition "A Descriptive Information Content Entity that describes the findings of identifying, examining, and reviewing IT security controls or measures (physical, logical, application, or environmental)." ;
                           skos:example "A review documenting that access-control and cryptographic measures meet policy." .


###  http://example.org/apqc#ITSecurityGovernanceSpecification
ex:ITSecurityGovernanceSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "8.3.5.2 output. Directive." ;
                                     rdfs:label "IT Security and Privacy Governance Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes an organization's approach to governing IT security and the privacy of data flows, together with the tools supporting that governance." ;
                                     skos:example "A governance charter defining decision rights and tooling for data-privacy controls." .


###  http://example.org/apqc#ITSecurityThreatAnalysis
ex:ITSecurityThreatAnalysis rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Section-8.0 shared output. APQC 8.3.3.2 analyze IT security threat impact, 8.3.8.7 penetration-test findings, 8.7.6.7 infrastructure security. Descriptive." ;
                            rdfs:label "IT Security Threat Analysis" ;
                            skos:definition "A Descriptive Information Content Entity that describes the analyzed impact of security threats on an organization's critical IT assets and functions." .


###  http://example.org/apqc#ITSecurityThreatData
ex:ITSecurityThreatData rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Section-8.0 shared input. APQC 8.3.3.2 analyze threat impact, 8.3.8.2 network breaches, 8.3.8.7 pen testing, 8.7.6.7. Descriptive." ;
                        rdfs:label "IT Security Threat Data" ;
                        skos:definition "A Descriptive Information Content Entity that describes threats, vulnerabilities, and breach points affecting an organization's critical IT assets and data flows." .


###  http://example.org/apqc#ITServiceCatalog
ex:ITServiceCatalog rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Section-8.0 shared output. APQC 8.1.3 plan and communicate IT services, 8.1.5.3 maintain catalog, 8.2.4.3 / 8.7.1.2 define catalog/portfolio. Directive: a catalog prescribes the available offerings and how to obtain them (a curated specification), not a mere description of reality." ;
                    rdfs:label "IT Service Catalog" ;
                    skos:definition "A Directive Information Content Entity that constitutes an organized, curated collection of the IT-related services that may be performed by, for, or within an organization, together with their deliverables, prices, contact points, and request processes." .


###  http://example.org/apqc#ITServiceDemandForecast
ex:ITServiceDemandForecast rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000626 ;
                           rdfs:comment "Section-8.0 shared output. APQC 8.1.5.2 forecast IT service demand, 8.1.3.2 define future IT services, 8.7.5.1 support demand patterns. Modeled as Predictive ICE (cco:ont00000626) because a forecast represents an uncertain future demand state; co-asserted Descriptive ICE (cco:ont00000853, its CCO parent) so generic report/description queries still resolve. Mirrors the corpus forecast pattern (3.0 SalesForecast, 5.0 DemandForecast, 6.0 ContactVolumeForecast)." ;
                           rdfs:label "IT Service Demand Forecast" ;
                           skos:definition "A Predictive Information Content Entity that estimates the anticipated future demand and usage of an organization's IT services." .


###  http://example.org/apqc#ITServiceManagementCapability
ex:ITServiceManagementCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P20632
                                                 ] ;
                                 ex:enablesProcess ex:P20632 ;
                                 rdfs:comment "Section-8.0 shared. Carries the standing 'Define IT service management strategy' heading (8.2.4) that fails the R5 bounded-occurrent test. Organization Capability per CCO (realized in Intentional Acts of a certain type). Gate-F fix on P20632: 8.1.5 'Develop and manage IT service levels' is modeled as a bounded ex:ActOfFormulation (its concrete deliverable, the SLA, passes R5), so it is NOT listed here as an R5 failure; the standing 'manage service levels' aspect is wired up via the obo:BFO_0000054 (realized in) restriction onto ex:P20632 above, mirroring how ex:ITCustomerRelationshipManagementCapability is realized in ex:P20608." ;
                                 rdfs:label "IT Service Management Capability" ;
                                 skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to design, deliver, manage, and improve the IT services used within an organization." .


###  http://example.org/apqc#ITServiceManagementPlan
ex:ITServiceManagementPlan rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Section-8.0 shared output. APQC 8.2.4 define IT service management strategy/framework, 8.5.2 lifecycle planning, 8.7.1.3 / 8.7.2.3 delivery/support model. Directive." ;
                           rdfs:label "IT Service Management Plan" ;
                           skos:definition "A Directive Information Content Entity that prescribes the processes, people, technology, and lifecycle approach by which IT services are designed, delivered, supported, and improved within an organization." .


###  http://example.org/apqc#ITServiceProvider
ex:ITServiceProvider rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00001180 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000196 ;
                                       owl:someValuesFrom ex:ITServiceProviderRole
                                     ] ;
                     rdfs:comment "Section-8.0 shared. The focal IT function / organization across 8.1, 8.5, 8.6, 8.7. Organization (a Group of Agents) per APQC 'the IT function'." ;
                     rdfs:label "IT Service Provider" ;
                     skos:definition "An Organization that bears an IT service provider role in virtue of designing, delivering, and supporting information-technology services and solutions for its customers." .


###  http://example.org/apqc#ITServiceProviderRole
ex:ITServiceProviderRole rdf:type owl:Class ;
                         rdfs:subClassOf obo:BFO_0000023 ;
                         rdfs:label "IT Service Provider Role" ;
                         skos:definition "A Role that is borne by an Organization in virtue of being responsible for designing, delivering, and supporting IT services and solutions for customers." .


###  http://example.org/apqc#ITServiceSolution
ex:ITServiceSolution rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000117 ;
                     rdfs:comment "Section-8.0 shared. The realized, deployable 'IT service/solution' that 8.5 creates/tests, 8.6 deploys, and 8.7 supports -- as a built artifact (material output of development/deployment via obo:BFO_0000057 has participant, never has output which is reserved for ICEs). Distinct from the INFORMATIONAL descriptors ex:ITServiceCatalog / ex:ITSolutionDesignSpecification, which are ICEs about it." ;
                     rdfs:label "IT Service/Solution" ;
                     skos:definition "An Information Processing Artifact that is an assembled, deployable information-technology offering (a configured system, application, or service package) made available by an IT function for use by its customers." .


###  http://example.org/apqc#ITServiceSolutionApproach
ex:ITServiceSolutionApproach rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "8.5.2.3 output. Directive." ;
                             rdfs:label "IT Service/Solution Delivery Approach" ;
                             skos:definition "A Directive Information Content Entity that prescribes the approach for delivering an IT service/solution in alignment with business needs and cost/delivery controls." ;
                             skos:example "An agreed delivery-approach document selecting an iterative build with managed cost gates." .


###  http://example.org/apqc#ITServiceSolutionRegister
ex:ITServiceSolutionRegister rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "8.5.2.2 output. Descriptive." ;
                             rdfs:label "IT Service/Solution Register" ;
                             skos:definition "A Descriptive Information Content Entity that enumerates the IT services and solutions offered to customers and the procedures that realize them." ;
                             skos:example "A register listing each offered IT service with its design, delivery, and control procedures." .


###  http://example.org/apqc#ITServiceSolutionSunsetPlan
ex:ITServiceSolutionSunsetPlan rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "8.5.2.5 output. Directive." ;
                               rdfs:label "IT Service/Solution Sunset Plan" ;
                               skos:definition "A Directive Information Content Entity that prescribes the retirement of IT service/solution resources once the service/solution is no longer feasible." ;
                               skos:example "A decommissioning plan scheduling shutdown of a deprecated reporting service." .


###  http://example.org/apqc#ITServiceSupportRecord
ex:ITServiceSupportRecord rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Section-8.0 shared output. APQC 8.7.8.5 resolve issues/requests, 8.7.8.3 manage requests. Descriptive: it records what was done. Distinct from the input ex:ITIssueRequest. SCOPE: confined to 8.7.8 incident/request resolution; change/release control and outcome documentation (8.6.3 / 8.6.3.7) now use the dedicated ex:ITChangeControlRecord (Gate-F fix on P20840/P20847)." ;
                          rdfs:label "IT Service Support Record" ;
                          skos:definition "A Descriptive Information Content Entity that describes the disposition of a resolved IT issue or request, including the diagnosis and corrective actions taken." .


###  http://example.org/apqc#ITSolutionDesignSpecification
ex:ITSolutionDesignSpecification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Section-8.0 shared output. APQC 8.1.4.5 facilitate solution design, 8.5.4.1.2 create service/solution design, 8.5.5.1.2 modify design, 8.6.1.3 deployment workflow. Directive: a design specification prescribes an artifact-to-be (output of ex:ActOfDesign)." ;
                                 rdfs:label "IT Solution Design Specification" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the form, structure, and behavior of a prospective IT service or solution so that it may be built and deployed." .


###  http://example.org/apqc#ITSolutionValidationResult
ex:ITSolutionValidationResult rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "Section-8.0 shared output. APQC 8.5.4.1.5 validation, 8.6.4.6 verify implementation success, 8.6.4.4 confirm completion, 8.6.4.1 confirm operational status. Descriptive: it records a validation judgement (output of ex:ActOfVerification)." ;
                              rdfs:label "IT Solution Validation Result" ;
                              skos:definition "A Descriptive Information Content Entity that describes the result of testing or validating that an IT service or solution is feasible and meets the customer requirements it is intended to satisfy." .


###  http://example.org/apqc#ITStandard
ex:ITStandard rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000965 ;
              rdfs:comment "Section-8.0 shared output. APQC 8.2.3.1 architecture principles, 8.5.1.2 development standards, 8.6.1.4 change/release standards, 8.3.3.7 communication standards. Directive: a standard prescribes required criteria." ;
              rdfs:label "IT Standard" ;
              skos:definition "A Directive Information Content Entity that prescribes the principles, criteria, and conformance requirements that govern IT architecture, development, change, and deployment decisions." .


###  http://example.org/apqc#ITStrategicAlignmentMaintenanceCapability
ex:ITStrategicAlignmentMaintenanceCapability rdf:type owl:Class ;
                                             rdfs:subClassOf cco:ont00000568 ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty obo:BFO_0000054 ;
                                                               owl:someValuesFrom ex:P20657
                                                             ] ;
                                             ex:apqcSourceText "Maintaining alignment of the organization's business divisions and staff members with the organization's planned objectives for IT." ;
                                             ex:enablesProcess ex:P20657 ;
                                             ex:hierarchyID "8.2.1.6" ;
                                             ex:pcfID "20659" ;
                                             rdfs:comment "R5/R6 fix for APQC 8.2.1.6 [20659]: 'Maintaining alignment ...' is a standing function with no natural end, modeled as an Organization Capability rather than a bounded act. Realized in ex:P20657 (Develop IT strategic alignment), the bounded act that establishes the alignment this capability sustains. The catalog node ex:PCF_20659 designates this capability." ;
                                             rdfs:label "IT Strategic Alignment Maintenance Capability" ;
                                             skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to keep the organization's business divisions and staff continuously aligned with its planned IT objectives." ;
                                             skos:example "An IT governance team's ongoing function of keeping business units aligned to IT objectives." .


###  http://example.org/apqc#ITStrategicAlignmentSpecification
ex:ITStrategicAlignmentSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "8.2 supporting class. Directive: prescribes the intended alignment. Output of develop/align acts (8.2.1.4, 8.2.2.5, 8.2.2.6)." ;
                                     rdfs:label "IT Strategic Alignment Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes how an organization's business divisions, staff, and resources are to be aligned with its planned IT objectives." .


###  http://example.org/apqc#ITStrategicIntelligenceCapability
ex:ITStrategicIntelligenceCapability rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000568 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P20655
                                                     ] ;
                                     ex:apqcSourceText "Building and maintaining intelligence towards changing organizational goals, supporting management, and operational or functional levels of the business. It is the ability to understand business trends that present threats or opportunities for IT in an organization." ;
                                     ex:enablesProcess ex:P20655 ;
                                     ex:hierarchyID "8.2.1.1" ;
                                     ex:pcfID "20654" ;
                                     rdfs:comment "R5/R6 fix for APQC 8.2.1.1 [20654]: the source explicitly states 'It is the ability to understand business trends', a standing capacity with no natural end, so it is modeled as an Organization Capability rather than a bounded act. Realized in ex:P20655 (Monitor and map current and emerging technologies), the bounded acts that exercise this intelligence. The catalog node ex:PCF_20654 designates this capability per the ADR-001 R4 bridge." ;
                                     rdfs:label "IT Strategic Intelligence Capability" ;
                                     skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to understand business trends presenting threats or opportunities for IT and to maintain intelligence supporting management and operational levels." ;
                                     skos:example "An IT strategy office's standing market-and-technology-intelligence function feeding IT planning." .


###  http://example.org/apqc#ITStrategy
ex:ITStrategy rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000965 ;
              rdfs:comment "Section-8.0 shared output. APQC 8.2.1 business technology and governance strategy, 8.2.1.6 digital transformation strategy, 8.2.4 service-management strategy, 8.5.1, 8.7.1/8.7.2 delivery/support strategy. Directive: it prescribes a direction." ;
              rdfs:label "IT Strategy" ;
              skos:definition "A Directive Information Content Entity that prescribes an organization-wide direction for the IT function, aligning IT investments, capabilities, and activities with business objectives." .


###  http://example.org/apqc#ITSupportCapability
ex:ITSupportCapability rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000568 ;
                       ex:enablesProcess ex:P20921 ,
                                         ex:P20923 ;
                       rdfs:comment "Section-8.0 shared. Target for standing 'Create and manage support services/solutions' / 'Operate IT user support' headings (8.7, 8.7.8) and the standing rollout-support nodes 8.6.5.3/.5/.6 [PCF 20861/20863/20864] that fail the R5 test. APQC 8.7.8.2 / 8.6.5.6 'IT resolution capabilities'." ;
                       rdfs:label "IT Support Capability" ;
                       skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to provide support to users of its IT services and solutions, including issue and request resolution." .


###  http://example.org/apqc#ITTrainingProgram
ex:ITTrainingProgram rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Section-8.0 shared output / instrument. APQC 8.3.3.5 risk-management training, 8.3.7.4 resilience training, 8.6.2.5 / 8.6.5.1 IT training. Directive: a program prescribes what is to be taught and to whom." ;
                     rdfs:label "IT Training Program" ;
                     skos:definition "A Directive Information Content Entity that prescribes the content, audience, and delivery of instruction provided to IT staff or users on IT services, risk, resilience, or change." .


###  http://example.org/apqc#ITTransformationPlan
ex:ITTransformationPlan rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "Section-8.0 shared output. APQC 8.1.4.1 develop transformation plans, 8.7.4.4 infrastructure change. Directive." ;
                        rdfs:label "IT Transformation Plan" ;
                        skos:definition "A Directive Information Content Entity that prescribes how an organization is to replace or upgrade its IT operating model, governance, service delivery, and workforce from a current to an expected state." .


###  http://example.org/apqc#ITUser
ex:ITUser rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00001017 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000196 ;
                            owl:someValuesFrom ex:ITUserRole
                          ] ;
          rdfs:comment "Section-8.0 shared. APQC 8.3.8 user identity and authorization, 8.6.5 / 8.7.8 user support. Distinct from ex:ITCustomer (the demand-side relationship counterpart); a user is the access-side identity holder." ;
          rdfs:label "IT User" ;
          skos:definition "An Agent that bears an IT user role in virtue of holding an established identity by which it is authenticated and authorized to access an organization's applications, systems, IT components, or networks." .


###  http://example.org/apqc#ITUserAuthorizationPolicy
ex:ITUserAuthorizationPolicy rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "8.3.8.1 output. Directive." ;
                             rdfs:label "IT User Identity and Authorization Policy" ;
                             skos:definition "A Directive Information Content Entity that prescribes how authorization policies are integrated with the authorized profiles of users permitted to access network resources." ;
                             skos:example "A policy binding role-based access entitlements to authenticated user profiles." .


###  http://example.org/apqc#ITUserDirectory
ex:ITUserDirectory rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "8.3.8.2 entity managed. Descriptive." ;
                   rdfs:label "IT User Directory" ;
                   skos:definition "A Descriptive Information Content Entity that describes user profiles and access requirements across different levels of an organization's IT network." ;
                   skos:example "An LDAP directory of user accounts and group memberships." .


###  http://example.org/apqc#ITUserRole
ex:ITUserRole rdf:type owl:Class ;
              rdfs:subClassOf obo:BFO_0000023 ;
              rdfs:label "IT User Role" ;
              skos:definition "A Role that is borne by an Agent in virtue of holding an established identity authorized to access an organization's IT applications, systems, components, or networks." .


###  http://example.org/apqc#ITValueContributionAssessment
ex:ITValueContributionAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Section-8.0 shared output. APQC 8.2.6 manage IT value portfolio, 8.2.6.2 quantify value, 8.2.5.5 monitor value and benefits, 8.2.6.3 communicate value, 8.7.1.1 / 8.7.2.1 / 8.7.4.2 assess value contribution. Descriptive." ;
                                 rdfs:label "IT Value Contribution Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes a quantified judgement of the value and benefits that IT investments, services, and projects contribute to business operations." .


###  http://example.org/apqc#ITValueCriteria
ex:ITValueCriteria rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "8.2.2.1 output. Directive: criteria/standards prescribe how value is to be judged." ;
                   rdfs:label "IT Value Criteria" ;
                   skos:definition "A Directive Information Content Entity that prescribes the standards used to determine the value of IT investments, projects, and activities for business objectives." .


###  http://example.org/apqc#ITVision
ex:ITVision rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000965 ;
            rdfs:comment "Section-8.0 shared output. APQC 8.1.2.3 'develop IT visioning'. Directive: a vision prescribes an intended end-state. Distinct from the broader ex:ITStrategy." ;
            rdfs:label "IT Vision" ;
            skos:definition "A Directive Information Content Entity that prescribes the long-term goals, direction, and intended future state of an organization's information technology." .


###  http://example.org/apqc#ImplementPhase
ex:ImplementPhase rdf:type owl:Class ;
                  rdfs:subClassOf ex:ActOfDevelopment ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cco:ont00001986 ;
                                    owl:someValuesFrom ex:CodeChangeSet
                                  ] ;
                  ex:requiresCapability ex:CodeImplementationCapability ;
                  ex:requiresRole ex:DeveloperRole ;
                  ex:routable "true"^^xsd:boolean ;
                  rdfs:label "Implement phase" ;
                  skos:definition "An Act of Development in which a developer agent brings a planned module from its implementation plan into an existent working code change set." .


###  http://example.org/apqc#ImplementationPlanArtifact
ex:ImplementationPlanArtifact rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:label "Implementation plan" ;
                              skos:definition "A Directive Information Content Entity that prescribes the concrete tasks, owners, and falsifiable acceptance criteria by which a roadmap phase is to be delivered." .


###  http://example.org/apqc#ImportExportControlCapability
ex:ImportExportControlCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P17059
                                                 ] ;
                                 ex:enablesProcess ex:P17059 ;
                                 rdfs:comment "Models APQC 9.11.2 'Control exports and imports' (PCF 14091). R5: 'overseeing and directing the flow of trade' is a standing control function with no natural end -- a capability, not a bounded process. Realized in the global-trade-servicing acts (R6)." ;
                                 rdfs:label "Import-Export Control Capability" ;
                                 skos:definition "An Organization Capability that is realized in the ongoing oversight and direction of the flow of trade into and out of an organization so as to secure financial gains." ;
                                 skos:example "A trade-compliance department's standing capacity to govern what the firm imports and exports." .


###  http://example.org/apqc#ImprovementOpportunityAnalysis
ex:ImprovementOpportunityAnalysis rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Output of the 'identify improvement opportunities' activities across 6.5 (6.5.1.2, 6.5.2.2, 6.5.3.4, 6.5.4.3-4) and 6.3.4.4.4." ;
                                  rdfs:label "Improvement Opportunity Analysis" ;
                                  skos:definition "A Descriptive Information Content Entity that describes identified opportunities to improve customer service operations, products, or warranties." .


###  http://example.org/apqc#ImprovementOpportunityAssessment
ex:ImprovementOpportunityAssessment rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:label "Improvement Opportunity Assessment" ;
                                    skos:definition "A Descriptive Information Content Entity that describes identified opportunities to improve an existing business process to meet new goals and objectives." .


###  http://example.org/apqc#ImprovementPlan
ex:ImprovementPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of 3.2.4.5, 3.2.6.5, 3.3.4.7, 3.3.4.8. Directive (Formulation)." ;
                   rdfs:label "Improvement Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes actions to improve under-performing channels, programs, or processes and to expand those exceeding expectations." .


###  http://example.org/apqc#InboundMaterialReceiptPlan
ex:InboundMaterialReceiptPlan rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:label "Inbound Material Receipt Plan" ;
                              skos:definition "A Directive Information Content Entity that prescribes the receipt of inbound materials procured from supply sources and delivered to a distribution center or warehouse." .


###  http://example.org/apqc#IncentivePlan
ex:IncentivePlan rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:label "Incentive Plan" ;
                 skos:definition "A Directive Information Content Entity that prescribes a scheme of awards and recognition designed to elicit desired employee outcomes." .


###  http://example.org/apqc#IncentiveScheme
ex:IncentiveScheme rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of 3.3.3.2 (corporate incentives), 3.3.3.7 (promotional pricing), 3.4.2.5 (trade funding). Directive (Formulation)." ;
                   rdfs:label "Incentive Scheme" ;
                   skos:definition "A Directive Information Content Entity that prescribes financial inducements, such as discounts, offered to intermediaries or customers." .


###  http://example.org/apqc#IncompleteServiceOrderRegister
ex:IncompleteServiceOrderRegister rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Minted: output of P10335. Descriptive register." ;
                                  rdfs:label "Incomplete Service Order Register" ;
                                  skos:definition "A Descriptive Information Content Entity that registers the service orders that are partially or entirely incomplete or undelivered, together with associated service failures." .


###  http://example.org/apqc#IndividualServiceRequirement
ex:IndividualServiceRequirement rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cco:ont00001808 ;
                                                  owl:someValuesFrom ex:Customer
                                                ] ;
                                rdfs:comment "Minted per Gate-F as the individual-scope output of P10320 (6.3.4.1 'Confirm specific service requirements for individual customer'). Descriptive because the confirming act validates and records a customer's stated requirements (an appraisal/information-processing judgement), not an enterprise directive. Distinct from the enterprise-wide ex:CustomerServiceRequirementSpecification (Directive, output of 6.1.1), which prescribes behaviors/skills/policies across the enterprise -- reusing that as the output of an individual-customer confirmation act was a category error." ;
                                rdfs:label "Individual Service Requirement" ;
                                skos:definition "A Descriptive Information Content Entity that records the validated, individual-customer-specific service requirements confirmed for one customer." .


###  http://example.org/apqc#IndustryTrendAnalysis
ex:IndustryTrendAnalysis rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Output of 3.1.1.3. Descriptive." ;
                         rdfs:label "Industry and Market Trend Analysis" ;
                         skos:definition "A Descriptive Information Content Entity that describes large-scale shifts and trends affecting the uptake of an organization's products or services." .


###  http://example.org/apqc#IndustryTrendData
ex:IndustryTrendData rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Input to 3.1.1.3. Descriptive." ;
                     rdfs:label "Industry Trend Data" ;
                     skos:definition "A Descriptive Information Content Entity that describes large-scale shifts and movements in an industry or wider market relevant to an organization's offerings." .


###  http://example.org/apqc#InformationGovernanceFramework
ex:InformationGovernanceFramework rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:comment "8.4.1.2 output. Distinct from a single ex:ITPolicy in that it is the overarching set of governance guidelines. Directive." ;
                                  rdfs:label "Information Governance Framework" ;
                                  skos:definition "A Directive Information Content Entity that prescribes the guidelines, decision rights, and accountabilities ensuring the effective and efficient use of an organization's data, information, and analytics." ;
                                  skos:example "An information-governance charter defining data stewardship roles and usage rules." .


###  http://example.org/apqc#InformationManagementCapability
ex:InformationManagementCapability rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000568 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P20766
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P20770
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P20776
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P20779
                                                   ] ;
                                   ex:enablesProcess ex:P20766 ,
                                                     ex:P20770 ,
                                                     ex:P20776 ,
                                                     ex:P20779 ;
                                   rdfs:comment "Section-8.0 shared. Target for the standing 'Manage information' / 'Manage business information' headings (8.4 [PCF 20765], 8.4.4) that fail the R5 test. Realized (R6) in its four bounded child processes 8.4.1-8.4.4; the capability gets no has-process-part to its children (R3)." ;
                                   rdfs:label "Information Management Capability" ;
                                   skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to govern, administer, and control its information and content across the information lifecycle." .


###  http://example.org/apqc#InfringementAssessment
ex:InfringementAssessment rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Minted: no shared-list infringement ICE. Descriptive (a judgement)." ;
                          rdfs:label "Infringement Assessment" ;
                          skos:definition "A Descriptive Information Content Entity that describes a judgement of patentability and possible infringement, including open-source licensing usage." .


###  http://example.org/apqc#InitiativeSelectionDecision
ex:InitiativeSelectionDecision rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Directive (a decision prescribes a course of action), parallel to ex:GoNoGoDecision in the 1.1.1 reference module. Output of 1.3.3 'Select strategic initiatives'." ;
                               rdfs:label "Initiative Selection Decision" ;
                               skos:definition "A Directive Information Content Entity that prescribes which strategic initiatives an organization will pursue." .


###  http://example.org/apqc#InquiryAnalysis
ex:InquiryAnalysis rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:CustomerInquiry
                                   ] ;
                   rdfs:comment "Output of 6.2.2.2 (Analyze problems, requests, and inquiries) and 6.3.4.1.1." ;
                   rdfs:label "Inquiry Analysis" ;
                   skos:definition "A Descriptive Information Content Entity that describes the content and appropriate handling of customer problems, requests, and inquiries." .


###  http://example.org/apqc#InquiryResolution
ex:InquiryResolution rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cco:ont00001808 ;
                                       owl:someValuesFrom ex:CustomerInquiry
                                     ] ;
                     rdfs:comment "Retained for the genuine resolution artifact. Per Gate-F, it is NO LONGER the output of P10395 (6.2.2.3), which the source describes as a routing/channeling (Act of Communication) act that produces no resolution record; any genuine end-to-end inquiry resolution would be a separate downstream act." ;
                     rdfs:label "Inquiry Resolution" ;
                     skos:definition "A Descriptive Information Content Entity that records the resolution determined for a customer problem, request, or inquiry." .


###  http://example.org/apqc#InquiryResponse
ex:InquiryResponse rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:CustomerInquiry
                                   ] ;
                   rdfs:comment "Output of 6.2.2.4 (Respond to customer problems, requests, and inquiries) -> producing act is an Act of Representative Communication." ;
                   rdfs:label "Inquiry Response" ;
                   skos:definition "A Descriptive Information Content Entity communicated to a customer that conveys the answer to their problem, request, or inquiry." .


###  http://example.org/apqc#InsuranceCoverageAssessment
ex:InsuranceCoverageAssessment rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Output of 11.1.3.3.1 (assess adequacy of insurance coverage)." ;
                               rdfs:label "Insurance Coverage Assessment" ;
                               skos:definition "A Descriptive Information Content Entity that describes a judgement of the adequacy of an organization's insurance coverage against its changing needs and available providers and offerings." .


###  http://example.org/apqc#IntellectualPropertyManagementCapability
ex:IntellectualPropertyManagementCapability rdf:type owl:Class ;
                                            rdfs:subClassOf cco:ont00000568 ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P12771
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty obo:BFO_0000054 ;
                                                              owl:someValuesFrom ex:P16826
                                                            ] ;
                                            ex:enablesProcess ex:P11049 ,
                                                              ex:P12771 ,
                                                              ex:P16826 ;
                                            rdfs:comment "Models APQC 2.1.3 (PCF 19985) as a standing function, not a process (R5/R6)." ,
                                                         "Supports 12.4.6 (Protect intellectual property) when modeled as a standing function." ;
                                            rdfs:label "Intellectual Property Management Capability" ;
                                            skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to secure, maintain, protect, value, and govern its intellectual property rights, such as patents and copyrights, for its products and services." .


###  http://example.org/apqc#IntellectualPropertyPolicy
ex:IntellectualPropertyPolicy rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Output of 12.4.6.2 (Maintain intellectual property rights and restrictions)." ;
                              rdfs:label "Intellectual Property Policy" ;
                              skos:definition "A Directive Information Content Entity that prescribes the rules, procedures, and restrictions governing the use and protection of an organization's intellectual property." .


###  http://example.org/apqc#IntellectualPropertyRight
ex:IntellectualPropertyRight rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Subject/output of 12.4.6.1 (Manage copyrights, patents, and trademarks). Directive: an enforceable entitlement prescribing permitted and prohibited uses. Scope note (two-layer model): this class captures only the DIRECTIVE prescriptive content of the right (the permitted/prohibited-use rules) -- hence Directive ICE (cco:ont00000965), admissible as the definitional has-output of the output-neutral ex:ActOfAcquisition at P11062. The legal ENTITLEMENT/STATUS itself (the holder's standing over the protected subject matter) is a distinct reality-layer legal relation/role and is deliberately NOT modeled here; if later represented it should be a separate entity, not this ICE." ;
                             rdfs:label "Intellectual Property Right" ;
                             skos:definition "A Directive Information Content Entity that prescribes the exclusive legal entitlement an organization holds over a patent, copyright, or trademark." .


###  http://example.org/apqc#InteractionQualityAssessment
ex:InteractionQualityAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Output of 6.2.1.4." ;
                                rdfs:label "Interaction Quality Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes a judgement of the quality of interactions between customers and customer service representatives." .


###  http://example.org/apqc#InternalAuditManagementCapability
ex:InternalAuditManagementCapability rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000568 ;
                                     ex:enablesProcess ex:P10871 ,
                                                       ex:P10889 ,
                                                       ex:P20782 ;
                                     rdfs:comment "Reality-layer correlate of APQC 11.2.1.3 (PCF 14133), a standing 'Manage' function with no natural end; modeled as a capability (R5/R6) rather than a process. Its discrete auditing acts are modeled in the relevant audit subtree." ;
                                     rdfs:label "Internal Audit Management Capability" ;
                                     skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to plan, conduct, and report on internal audits of its accounts and performance." .


###  http://example.org/apqc#InternalCapabilityData
ex:InternalCapabilityData rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Internal Capability Data" ;
                          skos:definition "A Descriptive Information Content Entity that describes an organization's in-house skills, resources, operations, and capacities." .


###  http://example.org/apqc#InternalControlCapability
ex:InternalControlCapability rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000568 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P10762
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P10764
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P21574
                                             ] ;
                             ex:enablesProcess ex:P10762 ,
                                               ex:P10764 ,
                                               ex:P21574 ;
                             rdfs:label "Internal Control Capability" ;
                             skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish, operate, monitor, and report on internal controls over financial reporting and operations." .


###  http://example.org/apqc#InternalControlPolicy
ex:InternalControlPolicy rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:label "Internal Control Policy" ;
                         skos:definition "A Directive Information Content Entity that prescribes the controls, roles, and responsibilities an Organization adopts to assure reliable financial reporting and operations." .


###  http://example.org/apqc#InternalEnvironmentAssessment
ex:InternalEnvironmentAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Internal counterpart of ex:ExternalEnvironmentAssessment from the 1.1.1 reference module." ;
                                 rdfs:label "Internal Environment Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes a big-picture understanding of an organization's internal skills, resources, and capacities." .


###  http://example.org/apqc#InternalOperationsAnalysis
ex:InternalOperationsAnalysis rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Internal Operations Analysis" ;
                              skos:definition "A Descriptive Information Content Entity that describes the key elements and measured effectiveness of an organization's internal operations." .


###  http://example.org/apqc#InternationalFundsManagementCapability
ex:InternationalFundsManagementCapability rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000568 ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty obo:BFO_0000054 ;
                                                            owl:someValuesFrom ex:P10767
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty obo:BFO_0000054 ;
                                                            owl:someValuesFrom ex:P10768
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty obo:BFO_0000054 ;
                                                            owl:someValuesFrom ex:P10769
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty obo:BFO_0000054 ;
                                                            owl:someValuesFrom ex:P10770
                                                          ] ;
                                          ex:enablesProcess ex:P10767 ,
                                                            ex:P10768 ,
                                                            ex:P10769 ,
                                                            ex:P10770 ;
                                          rdfs:comment "Models APQC process group 9.10 (PCF 10737), a standing 'Manage...' function. Per R5/R6 it is an Organization Capability (cco:ont00000568) realized in its four child acts, NOT a process: it has no identifiable single beginning and end." ;
                                          rdfs:label "International Funds Management Capability" ;
                                          skos:definition "An Organization Capability that is realized in acts of monitoring international rates and currency exposure, managing cross-border fund transfers, hedging currency, and reporting foreign-exchange results so as to manage and consolidate funds across an enterprise's operating units." ;
                                          skos:example "An enterprise treasury team's ongoing program for consolidating subsidiary cash and managing cross-border currency risk." .


###  http://example.org/apqc#InventoryAccuracyReport
ex:InventoryAccuracyReport rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:label "Inventory Accuracy Report" ;
                           skos:definition "A Descriptive Information Content Entity that describes discrepancies between the recorded inventory and the physical state of the inventory." .


###  http://example.org/apqc#InventoryItem
ex:InventoryItem rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000995 ;
                 rdfs:label "Inventory Item" ;
                 skos:definition "A Material Artifact held in stock by an organization, such as a raw material, spare, or finished product awaiting use or sale." .


###  http://example.org/apqc#InventoryNeedsAssessment
ex:InventoryNeedsAssessment rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Minted (D5) as the descriptive output of Establish inventory management constraints [10268], whose source centres on discerning inventory problems and quantifying needs. Descriptive because it represents identified problems and a computed need rather than prescribing constraints." ;
                            rdfs:label "Inventory Needs Assessment" ;
                            skos:definition "A Descriptive Information Content Entity that describes the problems and issues discerned in managing inventory together with the exact quantity of inventory needed in the near future." ;
                            skos:example "A note listing phantom-stock and shelf-life problems in the warehouse plus the near-term reorder quantity." .


###  http://example.org/apqc#InventoryRecord
ex:InventoryRecord rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:label "Inventory Record" ;
                   skos:definition "A Descriptive Information Content Entity that describes the quantity, location, and availability of inventory items at warehouses and distribution centers." .


###  http://example.org/apqc#InvestmentPolicy
ex:InvestmentPolicy rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:label "Investment Policy" ;
                    skos:definition "A Directive Information Content Entity that prescribes the principles governing an Organization's investment decisions." .


###  http://example.org/apqc#InvestorRelationsCapability
ex:InvestorRelationsCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ;
                               ex:enablesProcess ex:P11010 ;
                               rdfs:comment "Supports 12.1 (Build investor relationships) when modeled as a standing function under R5." ;
                               rdfs:label "Investor Relations Capability" ;
                               skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to integrate finance, communication, and securities-law compliance so as to manage two-way communication with the financial community." .


###  http://example.org/apqc#Invoice
ex:Invoice rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00000853 ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty cco:ont00001808 ;
                             owl:someValuesFrom ex:Customer
                           ] ;
           rdfs:comment "Descriptive: it records the particulars of a transaction rather than prescribing a course of action; the obligation to pay is borne separately." ,
                        "Input for 12.4.5.5 (Process payment for legal services)." ;
           rdfs:label "Invoice" ;
           skos:definition "A Descriptive Information Content Entity that describes a commercial transaction between a seller and a customer, itemizing quantities, prices, dates, and tax." ,
                           "A Descriptive Information Content Entity that describes fees claimed by a service provider for services rendered." .


###  http://example.org/apqc#JobCandidate
ex:JobCandidate rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001017 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000196 ;
                                  owl:someValuesFrom ex:JobCandidateRole
                                ] ;
                rdfs:comment "Applicant/candidate prior to hire; participant of sourcing, screening, selection, and offer acts in group 7.2." ;
                rdfs:label "Job Candidate" ;
                skos:definition "An Agent that bears a job-candidate role in virtue of being considered by an organization to fill an open position." .


###  http://example.org/apqc#JobCandidateRole
ex:JobCandidateRole rdf:type owl:Class ;
                    rdfs:subClassOf obo:BFO_0000023 ;
                    rdfs:label "Job Candidate Role" ;
                    skos:definition "A Role that is borne by an Agent in virtue of being considered by an organization to fill an open position." .


###  http://example.org/apqc#JobDescription
ex:JobDescription rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Descriptive (not Directive): it characterizes a position's nature rather than prescribing a specific course of action; distinct from the prescriptive JobRequisition that authorizes filling it." ;
                  rdfs:label "Job Description" ;
                  skos:definition "A Descriptive Information Content Entity that describes the responsibilities, essential functions, required knowledge and skills, and working conditions of a position." .


###  http://example.org/apqc#JobFamilyManagementCapability
ex:JobFamilyManagementCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ;
                                 rdfs:comment "R5: APQC 7.1.1.10 (PCF 21432) 'Manage job families and positions' is a standing oversight function with no natural end, so it is modeled as a capability, not a process." ;
                                 rdfs:label "Job Family Management Capability" ;
                                 skos:definition "An Organization Capability that inheres in an organization's human resources function in virtue of its capacity to oversee groupings of positions sharing similar education, skills, training, or experience." ;
                                 skos:example "An HR function's continuing management of job-family architecture and position classifications." .


###  http://example.org/apqc#JobOffer
ex:JobOffer rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000965 ;
            rdfs:label "Job Offer" ;
            skos:definition "A Directive Information Content Entity that prescribes the terms (role, reporting, salary, bonus, benefits) on which an organization proposes to employ a selected candidate." .


###  http://example.org/apqc#JobRequisition
ex:JobRequisition rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:label "Job Requisition" ;
                  skos:definition "A Directive Information Content Entity that prescribes an authorized request to fill a vacant position, specifying the title, department, fill date, and required qualifications." .


###  http://example.org/apqc#Journalist
ex:Journalist rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00001017 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty obo:BFO_0000196 ;
                                owl:someValuesFrom ex:JournalistRole
                              ] ;
              rdfs:comment "Minted for 12.5.2 (Manage media relations)." ;
              rdfs:label "Journalist" ;
              skos:definition "An Agent that bears a journalist role in virtue of gathering, reporting, and publishing news on behalf of a media outlet." .


###  http://example.org/apqc#JournalistRole
ex:JournalistRole rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000984 ;
                  rdfs:label "Journalist Role" ;
                  skos:definition "A Role that is borne by an Agent in virtue of gathering, reporting, and publishing news on behalf of a media outlet." .


###  http://example.org/apqc#JudgeVerdict
ex:JudgeVerdict rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:label "Judge verdict" ;
                skos:definition "A Descriptive Information Content Entity that records the outcome of an evaluation of an artifact against its acceptance criteria." .


###  http://example.org/apqc#KMApproachEvaluation
ex:KMApproachEvaluation rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "KM Approach Evaluation" ;
                        skos:definition "A Descriptive Information Content Entity that describes an evaluation of existing knowledge-management procedures, policies, and guidelines against industry best practices." .


###  http://example.org/apqc#KMAwarenessCommunication
ex:KMAwarenessCommunication rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Descriptive: the communicated content disseminated to raise awareness and drive use of knowledge bases. Output of ex:P20970 'Sustain awareness and engagement' (a communication/promotion act)." ;
                            rdfs:label "KM Awareness Communication" ;
                            skos:definition "A Descriptive Information Content Entity that describes the awareness-and-engagement messaging promoting use of an Organization's available knowledge bases." ;
                            skos:example "An internal campaign message encouraging staff to contribute to and consult the knowledge base." .


###  http://example.org/apqc#KMCapabilityMaturityAssessment
ex:KMCapabilityMaturityAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:label "KM Capability Maturity Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the maturity level of existing knowledge-management initiatives." .


###  http://example.org/apqc#KMFundingModel
ex:KMFundingModel rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:label "KM Funding Model" ;
                  skos:definition "A Directive Information Content Entity that prescribes the funding approach selected for an Organization's knowledge management program." .


###  http://example.org/apqc#KMGovernanceModel
ex:KMGovernanceModel rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:label "KM Governance Model" ;
                     skos:definition "A Directive Information Content Entity that prescribes the structure, roles, and accountability for governing an Organization's collective knowledge." .


###  http://example.org/apqc#KMInitiativeLinkageAnalysis
ex:KMInitiativeLinkageAnalysis rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Minted locally: not present in the shared vocabulary list. Descriptive (represents discovered correlations) per the GOLDEN PRINCIPLE; it is the definitional output of ex:P11104." ;
                               rdfs:label "KM Initiative Linkage Analysis" ;
                               skos:definition "A Descriptive Information Content Entity that describes the correlations and dependencies between an organization's knowledge-management strategy and its other functional areas or initiatives." .


###  http://example.org/apqc#KMMethodologySpecification
ex:KMMethodologySpecification rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Covers 'KM approaches' (policies, procedures, guidelines) developed and implemented in 13.5.3/13.5.4." ;
                              rdfs:label "KM Methodology Specification" ;
                              skos:definition "A Directive Information Content Entity that prescribes the core procedures and methodologies for developing, planning, executing, and improving knowledge management." .


###  http://example.org/apqc#KMResourceModel
ex:KMResourceModel rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Minted locally: not present in the shared vocabulary list. Directive (prescribes resources/standards/guidelines) per the GOLDEN PRINCIPLE; it is the definitional output of ex:P20966." ;
                   rdfs:label "KM Resource Model" ;
                   skos:definition "A Directive Information Content Entity that prescribes the resources, standards, and guidelines an organization's knowledge-management approaches are to follow." .


###  http://example.org/apqc#KMStrategy
ex:KMStrategy rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000965 ;
              rdfs:label "KM Strategy" ;
              skos:definition "A Directive Information Content Entity that prescribes an Organization's plan for capturing, maintaining, accessing, and exploiting its knowledge base." .


###  http://example.org/apqc#KeyPerformanceIndicatorSpecification
ex:KeyPerformanceIndicatorSpecification rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000965 ;
                                        rdfs:label "Key Performance Indicator Specification" ;
                                        skos:definition "A Directive Information Content Entity that prescribes the key performance measures by which the performance of a logistics or production strategy is to be evaluated." .


###  http://example.org/apqc#KnowledgeManagementCapability
ex:KnowledgeManagementCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P11095
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P11096
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P20965
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P20969
                                                 ] ;
                                 ex:enablesProcess ex:P11095 ,
                                                   ex:P11096 ,
                                                   ex:P20965 ,
                                                   ex:P20969 ;
                                 rdfs:comment "Models APQC group 13.5 'Develop and manage enterprise-wide knowledge management capability' (PCF 11073). Per R5/R6 a standing function -> Organization Capability realized in its child acts; the catalog node ex:PCF_11073 designates this capability. No ex:P11073 process is minted." ;
                                 rdfs:label "Knowledge Management Capability" ;
                                 skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop strategy for, assess, design, implement, and sustain the management of its collective knowledge, realized in the acts of developing KM strategy, assessing KM capabilities, designing and implementing KM capabilities, and evolving and sustaining them." .


###  http://example.org/apqc#KnowledgeManagerRole
ex:KnowledgeManagerRole rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000984 ;
                        rdfs:comment "Minted for recurring APQC 13.5 participant ('KM core group' / specialized KM roles)." ;
                        rdfs:label "Knowledge Manager Role" ;
                        skos:definition "A Role that is borne by an Agent in virtue of being responsible for governing, capturing, maintaining, and providing access to an Organization's collective knowledge base." .


###  http://example.org/apqc#LaborAndMaterialsPolicy
ex:LaborAndMaterialsPolicy rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:label "Labor and Materials Policy" ;
                           skos:definition "A Directive Information Content Entity that prescribes internal rules and regulations governing employees and materials." .


###  http://example.org/apqc#LaborManagementPartnershipCapability
ex:LaborManagementPartnershipCapability rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000568 ;
                                        rdfs:comment "Models APQC 7.4.3 'Manage labor management partnerships' (PCF 10485) under R5/R6: the source seeks a 'lasting two-way relationship', a standing relationship-maintenance function with no natural end, hence an Organization Capability rather than a process. No bounded child acts are enumerated by the source, so no realized-in restriction is asserted (would be non-definitional)." ;
                                        rdfs:label "Labor-Management Partnership Capability" ;
                                        skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop and sustain a lasting cooperative relationship between labor and management for mutual benefit." .


###  http://example.org/apqc#LaborOrganization
ex:LaborOrganization rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00001180 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000196 ;
                                       owl:someValuesFrom ex:LaborOrganizationRole
                                     ] ;
                     rdfs:comment "Union / employee-representative body in group 7.4." ;
                     rdfs:label "Labor Organization" ;
                     skos:definition "An Organization that bears a labor-organization role in virtue of representing a group of employees in collective bargaining and labor-management relations." .


###  http://example.org/apqc#LaborOrganizationRole
ex:LaborOrganizationRole rdf:type owl:Class ;
                         rdfs:subClassOf obo:BFO_0000023 ;
                         rdfs:label "Labor Organization Role" ;
                         skos:definition "A Role that is borne by an Organization in virtue of representing a group of employees in collective bargaining and labor-management relations." .


###  http://example.org/apqc#LaborPolicy
ex:LaborPolicy rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ;
               rdfs:comment "Shared section-5.0 output (5.1.2.2). Directive: a policy prescribes permitted and required conduct." ;
               rdfs:label "Labor Policy" ;
               skos:definition "A Directive Information Content Entity that prescribes rules governing the use of labor resources in service delivery, consistent with organizational and regulatory requirements." .


###  http://example.org/apqc#LaborRelationsCapability
ex:LaborRelationsCapability rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000568 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty obo:BFO_0000054 ;
                                              owl:someValuesFrom ex:P10484
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty obo:BFO_0000054 ;
                                              owl:someValuesFrom ex:P10531
                                            ] ;
                            ex:enablesProcess ex:P10484 ,
                                              ex:P10531 ;
                            rdfs:comment "Models APQC 7.4.1 'Manage labor relations' (PCF 10483) under R5/R6: a standing function with no natural end, so an Organization Capability (cco:ont00000568) realized in the underlying bounded acts, not a process. Narrower than the shared ex:EmployeeRelationsCapability." ;
                            rdfs:label "Labor Relations Capability" ;
                            skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to administer the relationship between labor and management, realized in acts of collective bargaining and employee-grievance resolution." .


###  http://example.org/apqc#LaunchPlan
ex:LaunchPlan rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000965 ;
              rdfs:comment "Output of 2.1.2.1; input to launch-procedure validation (2.3.3.5)." ;
              rdfs:label "Product/Service Launch Plan" ;
              skos:definition "A Directive Information Content Entity that prescribes the program and procedures for introducing and launching a new product or service." .


###  http://example.org/apqc#LearningProgramAlignmentSpecification
ex:LearningProgramAlignmentSpecification rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000965 ;
                                         rdfs:comment "Minted locally (group 7.3, used by P10491). Directive: it prescribes how programs are to be configured rather than merely describing them." ;
                                         rdfs:label "Learning Program Alignment Specification" ;
                                         skos:definition "A Directive Information Content Entity that prescribes how learning and training programs are to be contextualized and aligned with the core competencies and capabilities of the organization." ;
                                         skos:example "A specification mapping each training module to the organizational competencies it must build." .


###  http://example.org/apqc#LearningProgramEvaluation
ex:LearningProgramEvaluation rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Minted locally (group 7.3, used by P21436)." ;
                             rdfs:label "Learning Program Evaluation" ;
                             skos:definition "A Descriptive Information Content Entity that describes a judgement of the coverage and effectiveness of an organization's learning and training programs." ;
                             skos:example "A quarterly oversight report on the impact of the organization's training catalog." .


###  http://example.org/apqc#LeaveRecord
ex:LeaveRecord rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000853 ;
               rdfs:label "Leave Report" ;
               skos:definition "A Descriptive Information Content Entity that describes the paid and unpaid leave allowed to and taken by employees." ;
               skos:example "A monthly report of vacation, sick, and unpaid leave balances per employee." .


###  http://example.org/apqc#LegalActivityRecord
ex:LegalActivityRecord rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Output of 12.4.5.6 (Track legal activity/performance)." ;
                       rdfs:label "Legal Activity Record" ;
                       skos:definition "A Descriptive Information Content Entity that describes the legal activities and performance of an organization over time." .


###  http://example.org/apqc#LegalAdvice
ex:LegalAdvice rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000853 ;
               rdfs:comment "Output of 12.4.8 (Provide legal advice/counseling). Descriptive: it informs rather than itself binding the recipient to act." ;
               rdfs:label "Legal Advice" ;
               skos:definition "A Descriptive Information Content Entity that describes counsel concerning the substance or procedure of a law as it applies to a particular situation." .


###  http://example.org/apqc#LegalAnalysis
ex:LegalAnalysis rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Output of 11.3.4 (investigate legal aspects), produced by ex:ActOfInvestigation (inlined above)." ;
                 rdfs:label "Legal Analysis" ;
                 skos:definition "A Descriptive Information Content Entity that describes an examination of regulatory and legislative frameworks bearing on an organization's remediation obligations, including liabilities for compensation, fines, and corrective effort." .


###  http://example.org/apqc#LegalAndComplianceCapability
ex:LegalAndComplianceCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ;
                                ex:enablesProcess ex:P11013 ,
                                                  ex:P11045 ,
                                                  ex:P11047 ,
                                                  ex:P11048 ,
                                                  ex:P11049 ;
                                rdfs:comment "Supports 12.4 / 12.4.4 (Manage legal and ethical issues; Ensure compliance) when modeled as standing functions." ;
                                rdfs:label "Legal and Compliance Capability" ;
                                skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to conduct legal and ethical practices and to validate adherence to applicable laws and regulations." .


###  http://example.org/apqc#LegalAndRegulatoryRequirements
ex:LegalAndRegulatoryRequirements rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Despite the 'Requirements' label this is DESCRIPTIVE (D6 false-friend guard): it records/describes the applicable legislation and regulatory requirements; the directive rules themselves are Directive ICEs modeled separately." ;
                                  rdfs:label "Legal and Regulatory Requirements" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the employment-related legislation and regulatory requirements applicable to an organization's jurisdictions." .


###  http://example.org/apqc#LegalProblemStatement
ex:LegalProblemStatement rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Input/output for 12.4.5.1 (Assess problem and determine work requirements)." ;
                         rdfs:label "Legal Problem Statement" ;
                         skos:definition "A Descriptive Information Content Entity that describes a legal or ethical problem an organization faces and the tasks for which assistance may be needed." .


###  http://example.org/apqc#LegalWorkProduct
ex:LegalWorkProduct rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Input for 12.4.5.4 (Receive work product and manage/monitor case). See also ex:WorkProductDeliverable for the deliverable-plus-effort record specifically monitored under 12.4.5.4." ;
                    rdfs:label "Legal Work Product" ;
                    skos:definition "A Descriptive Information Content Entity that describes a deliverable produced by outside counsel in the course of an engagement." .


###  http://example.org/apqc#Lender
ex:Lender rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00001180 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000196 ;
                            owl:someValuesFrom ex:LenderRole
                          ] ;
          rdfs:comment "Minted for 12.1.1 (Plan, build, and manage lender relations). Modeled as Organization (banks/lenders); use cco:Agent for an individual lender." ;
          rdfs:label "Lender" ;
          skos:definition "An Organization that bears a lender role in virtue of extending loans or credit to a borrowing organization." .


###  http://example.org/apqc#LenderRelationsManagementCapability
ex:LenderRelationsManagementCapability rdf:type owl:Class ;
                                       rdfs:subClassOf ex:StakeholderRelationshipManagementCapability ;
                                       ex:enablesProcess ex:P11035 ;
                                       rdfs:comment "Minted for 12.1.1 (P11035), re-judged under R5 as a standing function -> Organization Capability, reconciled with the parallel 'manage relations' rows 12.2.1-3 which are likewise capabilities (Gate-F cross-row consistency). Realized in the bounded lender-relationship-cultivation episodes via obo:BFO_0000054." ;
                                       rdfs:label "Lender Relations Management Capability" ;
                                       skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to build, maintain, and advance ongoing relationships with bankers and lenders so as to foster a receptive environment for favorable lending terms." .


###  http://example.org/apqc#LenderRole
ex:LenderRole rdf:type owl:Class ;
              rdfs:subClassOf obo:BFO_0000023 ;
              rdfs:label "Lender Role" ;
              skos:definition "A Role that is borne by an Organization in virtue of extending loans or credit to a focal organization." .


###  http://example.org/apqc#LessonsLearnedRecord
ex:LessonsLearnedRecord rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Shared across 13.4.4.2 and 13.2.3.4.5 project reviews." ;
                        rdfs:label "Lessons Learned Record" ;
                        skos:definition "A Descriptive Information Content Entity that describes the insights and knowledge captured from a completed change or project for reuse." .


###  http://example.org/apqc#LetterOfCredit
ex:LetterOfCredit rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:comment "Directive: it commits a bank to pay under stated conditions (9.11)." ,
                               "FALSE-FRIEND note: this class models the CONTENT of a letter of credit (the bank's prescriptive payment commitment), hence Directive ICE -- it is the 9.11 process output (has output cco:ont00001986). It does NOT model the document/artifact that bears this content, nor the trade-finance sense in which a letter of credit is a negotiable instrument; that artifact, if needed, is a separate Material Artifact (cco:ont00000995). Do not re-anchor this ICE class to cco:ont00000537." ;
                  rdfs:label "Letter of Credit" ;
                  skos:definition "A Directive Information Content Entity issued by a bank that prescribes payment to a seller upon satisfaction of specified delivery conditions." .


###  http://example.org/apqc#LicensingTerms
ex:LicensingTerms rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:comment "Output of 12.4.6.3 (Administer licensing terms) and referenced by 12.4.6.4 (Administer options)." ;
                  rdfs:label "Licensing Terms" ;
                  skos:definition "A Directive Information Content Entity that prescribes the terms and conditions governing the granting of a license to an organization's intellectual property." .


###  http://example.org/apqc#LifeCycleCostAnalysis
ex:LifeCycleCostAnalysis rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Minted: narrower than ex:CostAnalysis, which is not stage/life-cycle structured. Descriptive." ;
                         rdfs:label "Life-Cycle Cost Analysis" ;
                         skos:definition "A Descriptive Information Content Entity that describes the revenue and cost incurred at each stage of a product or process life cycle." ;
                         skos:example "A cradle-to-grave cost breakdown for a product across design, production, and disposal." .


###  http://example.org/apqc#LoadPlan
ex:LoadPlan rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000965 ;
            rdfs:label "Load Plan" ;
            skos:definition "A Directive Information Content Entity that prescribes how loads are to be delivered to a given destination or partner." .


###  http://example.org/apqc#LobbyistRole
ex:LobbyistRole rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000984 ;
                rdfs:comment "Minted for 12.2.4 (Manage lobby activities)." ;
                rdfs:label "Lobbyist Role" ;
                skos:definition "A Role that is borne by an Agent in virtue of being tasked with influencing public or government policy on behalf of a focal organization." .


###  http://example.org/apqc#LogisticsManagementCapability
ex:LogisticsManagementCapability rdf:type owl:Class ;
                                 rdfs:subClassOf ex:SupplyChainManagementCapability ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10338
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10340
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10341
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P20936
                                                 ] ;
                                 ex:enablesProcess ex:P10338 ,
                                                   ex:P10340 ,
                                                   ex:P10341 ,
                                                   ex:P20936 ;
                                 rdfs:comment "R5/R6: APQC group 4.4 'Manage logistics and warehousing' (PCF 10219) is a standing oversight function with no natural end, so it is modeled as this Organization Capability rather than a process. It is realized in the four bounded sub-processes 4.4.1-4.4.4. Reconciled: the realization axioms (originally added to ex:LogisticsManagementCapability in the 4.4 group module) are folded into this single shared declaration." ;
                                 rdfs:label "Logistics Management Capability" ;
                                 skos:definition "A Supply Chain Management Capability that is realized in acts of governing logistics, managing inbound material flow, operating warehousing, and operating outbound transportation." .


###  http://example.org/apqc#LogisticsNetworkDesign
ex:LogisticsNetworkDesign rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:label "Logistics Network Design" ;
                          skos:definition "A Directive Information Content Entity that prescribes the network of entities through which materials and information flow in logistical activities." .


###  http://example.org/apqc#LogisticsRequirementSpecification
ex:LogisticsRequirementSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:label "Logistics Requirement Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes the logistics requirements derived from customer service requirements for managing flow between origin and consumption." .


###  http://example.org/apqc#LogisticsServiceProviderRole
ex:LogisticsServiceProviderRole rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000506 ;
                                rdfs:label "Logistics Service Provider Role" ;
                                skos:definition "A Role that is borne by an Organization in virtue of performing outsourced logistics, storage, or shipping activities for another organization." .


###  http://example.org/apqc#LogisticsStrategy
ex:LogisticsStrategy rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:label "Logistics Strategy" ;
                     skos:definition "A Directive Information Content Entity that prescribes an organization's approach to managing logistics, including network design, outsourcing, and transportation cost and schedule optimization." .


###  http://example.org/apqc#LotNumberingSystemSpecification
ex:LotNumberingSystemSpecification rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000965 ;
                                   rdfs:label "Lot Numbering System Specification" ;
                                   skos:definition "A Directive Information Content Entity that prescribes the scheme for assigning lot identification numbers to quantities of manufactured material." .


###  http://example.org/apqc#LotUsageSpecification
ex:LotUsageSpecification rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cco:ont00001808 ;
                                           owl:someValuesFrom ex:ProductionLot
                                         ] ;
                         rdfs:comment "Minted (D5) as the forward-production output of Determine lot use [10377]. Distinct from ex:DispositionDecision, which is scoped to reverse logistics (it prescribes the disposition of a RETURNED PRODUCT and is about ex:ReturnedProduct); reusing it here would mis-relate the act to returns. Directive because it prescribes the allocation/consumption of a production lot." ;
                         rdfs:label "Lot Usage Specification" ;
                         skos:definition "A Directive Information Content Entity that prescribes where, how, and when a production lot is to be used." ;
                         skos:example "A plan earmarking a specific lot for a customer order and setting its consumption window." .


###  http://example.org/apqc#MacroeconomicData
ex:MacroeconomicData rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:label "Macroeconomic Data" ;
                     skos:definition "A Descriptive Information Content Entity that describes macroeconomic indicators such as interest rates, taxation, commodity prices, and unemployment." .


###  http://example.org/apqc#MacroeconomicTrendAnalysis
ex:MacroeconomicTrendAnalysis rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Macroeconomic Trend Analysis" ;
                              skos:definition "A Descriptive Information Content Entity that describes medium- to long-term macroeconomic shifts relevant to an organization." .


###  http://example.org/apqc#MaintenanceIssueReport
ex:MaintenanceIssueReport rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Maintenance Issue Report" ;
                          skos:definition "A Descriptive Information Content Entity that describes deviations or issues in the maintenance schedule or in production performance." .


###  http://example.org/apqc#MaintenancePerformanceReport
ex:MaintenancePerformanceReport rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:label "Maintenance Performance Report" ;
                                skos:definition "A Descriptive Information Content Entity that describes the organization's measured success in meeting maintenance performance targets and contractual obligations." .


###  http://example.org/apqc#MaintenancePerformanceTarget
ex:MaintenancePerformanceTarget rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "Directive: a target prescribes an intended state to be achieved (cf. CCO Objective)." ;
                                rdfs:label "Maintenance Performance Target" ;
                                skos:definition "A Directive Information Content Entity that prescribes the predictive indicators and target levels to be achieved in performing maintenance." .


###  http://example.org/apqc#MaintenancePersonnel
ex:MaintenancePersonnel rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00001017 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:BFO_0000196 ;
                                          owl:someValuesFrom ex:MaintenanceTechnicianRole
                                        ] ;
                        rdfs:label "Maintenance Personnel" ;
                        skos:definition "An Agent that bears a maintenance technician role." .


###  http://example.org/apqc#MaintenancePolicy
ex:MaintenancePolicy rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Directive (a policy prescribes required/permitted action)." ;
                     rdfs:label "Maintenance Policy" ;
                     skos:definition "A Directive Information Content Entity that prescribes the procedures and policies governing how asset maintenance is to be carried out." .


###  http://example.org/apqc#MaintenanceRequirementsForecast
ex:MaintenanceRequirementsForecast rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000626 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cco:ont00001808 ;
                                                     owl:someValuesFrom ex:ProductiveAsset
                                                   ] ;
                                   rdfs:comment "Predictive (cco:ont00000626, a specialization of Descriptive cco:ont00000853): it describes an UNCERTAIN FUTURE state (projected requirements), not a record of an existing or past subject. Re-anchored from plain cco:ont00000853 to preserve the forecast/prediction semantics; cco:ont00000853 co-asserted locally because 626 is outside the S3/S4 ICE allowlist {958,853,965}. Output of ex:P10967 (ex:ActOfForecasting)." ;
                                   rdfs:label "Maintenance Requirements Forecast" ;
                                   skos:definition "A Predictive Information Content Entity, about an asset, that describes a projection of that asset's uncertain future maintenance requirements based on its present working condition." .


###  http://example.org/apqc#MaintenanceResource
ex:MaintenanceResource rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000040 ;
                       rdfs:comment "Minted (Gate-F) for 10.3.2.2 (ex:P19247) 'Gathering resources needed to complete all maintenance work'. Distinct from ex:AssetPart, whose definition is a part resulting from DISMANTLING an end-of-life asset (a 10.4 disposition concept) -- semantically wrong for spare parts/materials gathered to PERFORM maintenance. Anchored at BFO material entity because maintenance resources span artifacts (spares, tools) and non-artifact materials (consumables)." ;
                       rdfs:label "Maintenance Resource" ;
                       skos:definition "A Material Entity, such as a spare part, consumable, tool, or material, that is gathered and consumed or employed in performing asset-maintenance work." .


###  http://example.org/apqc#MaintenanceSafetyAssuranceAct
ex:MaintenanceSafetyAssuranceAct rdf:type owl:Class ;
                                 rdfs:subClassOf ex:ActOfMonitoring ;
                                 rdfs:comment "Minted (Gate-F) as the bounded act in which the standing ex:P19250 (Manage maintenance work safety) capability is realized (R6). The recurring assurance function is the capability; each individual observe-and-record occurrence is one of these acts, producing ex:SafetyComplianceRecord. GOLDEN PRINCIPLE: monitoring -> Descriptive ICE (Safety Compliance Record). (Output recorded here rather than as a has-output restriction so this supporting act is not flagged as a PCF process requiring a pcfID; the PCF anchor for 10.3.2.5 is the capability ex:P19250.)" ;
                                 rdfs:label "Maintenance Safety Assurance Act" ;
                                 skos:definition "An Act of Monitoring that observes maintenance work practices against applicable safety laws and regulations and produces a safety compliance record." .


###  http://example.org/apqc#MaintenanceSchedule
ex:MaintenanceSchedule rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:label "Maintenance Schedule" ;
                       skos:definition "A Directive Information Content Entity that prescribes a timetable for executing the maintenance of an asset." ,
                                       "A Directive Information Content Entity that prescribes the timing of planned and unplanned maintenance of production equipment." .


###  http://example.org/apqc#MaintenanceStrategy
ex:MaintenanceStrategy rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:label "Maintenance Strategy" ;
                       skos:definition "A Directive Information Content Entity that prescribes goals and agendas for realizing an organization's asset-maintenance policies." .


###  http://example.org/apqc#MaintenanceTechnicianRole
ex:MaintenanceTechnicianRole rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000984 ;
                             rdfs:label "Maintenance Technician Role" ;
                             skos:definition "A Role that is borne by an Agent in virtue of being tasked with performing preventative, routine, corrective, and unplanned maintenance on assets." .


###  http://example.org/apqc#ManageBuildingRenovation
ex:ManageBuildingRenovation rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000970 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty obo:BFO_0000057 ;
                                              owl:someValuesFrom ex:Facility
                                            ] ;
                            rdfs:comment "Minted (Gate-F, Phase-1 de-conflation) for the 'Manage renovations according to requirements and demands' half of PCF 10962, which fuses two act kinds (build NEW + renovate EXISTING). Anchored to cco:ont00000970 (Act of Artifact Modification) because renovating an existing building changes the qualities/functions of an existing Material Artifact, mirroring 10.2.3.4 (ex:P19233), which rejects cco:ont00000051 (Act of Construction, builds NEW) for the same modify-existing sense. Attached as a process part of ex:P10962 so the modification sense is not mis-genused under Construction nor silently dropped." ;
                            rdfs:label "Manage building renovation" ;
                            skos:definition "An Act of Artifact Modification that renovates an existing building on site, changing its qualities or functions according to requirements and demands." .


###  http://example.org/apqc#ManageCustomerRelationships
ex:ManageCustomerRelationships rdf:type owl:Class ;
                               rdfs:subClassOf ex:ActOfSelling ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000057 ;
                                                 owl:someValuesFrom ex:Customer
                                               ] ;
                               ex:requiresCapability ex:SalesManagementCapability ;
                               ex:requiresRole ex:CustomerRole ;
                               rdfs:comment "Bounded relationization act; the recurring instances of this type are what ex:SalesManagementCapability (PCF 11174, R6) is realized in. Not a PCF-numbered process node." ;
                               rdfs:label "Act of Managing a Customer Relationship" ;
                               skos:definition "An Act of Selling in which an organization coordinates an interaction with a customer across a touchpoint to maintain an ongoing relationship." .


###  http://example.org/apqc#ManagementPersonnel
ex:ManagementPersonnel rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001017 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:ManagerRole
                                       ] ;
                       rdfs:comment "Mirrors the reference slice's ex:ManagementPersonnel; minted here so all 4.0 groups share one class (e.g. senior management as participant in demand-consensus and technology decisions)." ,
                                    "Reuses the supporting pattern from apqc_1_1_1; engaged in 6.5.1.2 (discuss issues with management)." ,
                                    "Shared with the reference template's ManagementPersonnel pattern; reused for participant fillers in strategy, performance, and relations acts." ;
                       rdfs:label "Management Personnel" ;
                       skos:definition "An Agent that bears a manager role and exercises managerial authority within an organization." ,
                                       "An Agent that bears a manager role in virtue of exercising managerial authority within an organization." ,
                                       "An Agent that bears a manager role within an organization." .


###  http://example.org/apqc#ManagerRole
ex:ManagerRole rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000984 ;
               rdfs:label "Manager Role" ;
               skos:definition "A Role that is borne by an Agent in virtue of exercising managerial authority within an organization." .


###  http://example.org/apqc#ManufacturingGoalSpecification
ex:ManufacturingGoalSpecification rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:label "Manufacturing Goal Specification" ;
                                  skos:definition "A Directive Information Content Entity that prescribes quantifiable strategic objectives for one or more manufacturing segments." .


###  http://example.org/apqc#Market
ex:Market rdf:type owl:Class ;
          rdfs:subClassOf obo:BFO_0000027 ;
          rdfs:comment "Subject of ex:MarketStudy. Modeled as a BFO Object Aggregate (obo:BFO_0000027, a material aggregate of participant agents and offerings) -- more precise than bare Material Entity -- not as an ICE. This is the concrete-participant reading; the abstract socio-economic market-system sense is out of scope here." ;
          rdfs:label "Market" ;
          skos:definition "An Object Aggregate of the buyers, sellers, and offerings within which an organization's products or services compete." .


###  http://example.org/apqc#MarketAcceptanceAnalysis
ex:MarketAcceptanceAnalysis rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cco:ont00001808 ;
                                              owl:someValuesFrom ex:Market
                                            ] ;
                            rdfs:comment "Minted: no shared-list ICE captures post-launch acceptance analytics. Descriptive (represents measured acceptance)." ;
                            rdfs:label "Market Acceptance Analysis" ;
                            skos:definition "A Descriptive Information Content Entity that describes user engagement and a product/service's acceptance in the market following launch." .


###  http://example.org/apqc#MarketAnalystRole
ex:MarketAnalystRole rdf:type owl:Class ;
                     rdfs:subClassOf ex:Role ,
                                     cco:ont00000984 ;
                     rdfs:label "Market analyst role" ;
                     skos:definition "The occupation role of an agent acting as a market/competitive analyst within a strategy effort." .


###  http://example.org/apqc#MarketCompensationData
ex:MarketCompensationData rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Market Compensation Data" ;
                          skos:definition "A Descriptive Information Content Entity that describes prevailing compensation, benefits, and reward practices in a labor market or industry." .


###  http://example.org/apqc#MarketData
ex:MarketData rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000853 ;
              rdfs:comment "Carried over from the 1.1.1 reference module (same IRI, same definition) so this self-contained module has every filler declared." ,
                           "Minted as a recurring input across 3.1-3.4. Reuses the same intent as the 1.1.1 reference MarketData; re-stated here so section 3.0 modules need not import the reference slice." ,
                           "Reused naming from the reference module (apqc_1_1_1.ttl); minted here because it is not in apqc-ext.ttl." ,
                           "Shared input for build/buy/lease and property-selection appraisals across 10.1 and 10.2." ;
              rdfs:label "Market Data" ;
              skos:definition "A Descriptive Information Content Entity that describes features of a market, such as property prices, construction costs, and supply conditions." ,
                              "A Descriptive Information Content Entity that describes features of a market, such as size, growth rate, trends, segments, and channels." ,
                              "A Descriptive Information Content Entity that describes features of a market." ,
                              "A Descriptive Information Content Entity that describes features, conditions, and dynamics of a market." .


###  http://example.org/apqc#MarketEnvironmentData
ex:MarketEnvironmentData rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Shared section-5.0 forecasting input (5.2.1.2). Distinct from ex:MarketData in the reference module (external-environment scan); kept local to 5.0 as a demand-forecasting input." ;
                         rdfs:label "Market Environment Data" ;
                         skos:definition "A Descriptive Information Content Entity that describes external market conditions relevant to estimating future demand for an organization's services." .


###  http://example.org/apqc#MarketIntelligenceCapability
ex:MarketIntelligenceCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ;
                                ex:enablesProcess ex:P10101 ,
                                                  ex:P10106 ,
                                                  ex:P10107 ;
                                rdfs:comment "Standing capability behind 3.1 (R6)." ;
                                rdfs:label "Market Intelligence Capability" ;
                                skos:definition "An Organization Capability that is realized in Acts of gathering and analyzing market and customer intelligence." .


###  http://example.org/apqc#MarketIntelligenceReport
ex:MarketIntelligenceReport rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Output of 3.1.1. Descriptive (Analysis/Info-Processing genus)." ;
                            rdfs:label "Market Intelligence Report" ;
                            skos:definition "A Descriptive Information Content Entity that describes the attributes, behavior, and trends of market and customer segments gathered as intelligence." .


###  http://example.org/apqc#MarketOpportunity
ex:MarketOpportunity rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Subject matter carried forward through 3.1.2 and identified in 3.4.2.1. Descriptive representation of an opportunity; quantification/prioritization/validation act on it." ;
                     rdfs:label "Market Opportunity Statement" ;
                     skos:definition "A Descriptive Information Content Entity that describes an identified opportunity to capture value in a market." .


###  http://example.org/apqc#MarketOpportunityData
ex:MarketOpportunityData rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Market Opportunity Data" ;
                         skos:definition "A Descriptive Information Content Entity that describes opportunities, demand, and gaps present in a market." .


###  http://example.org/apqc#MarketRateData
ex:MarketRateData rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Input to treasury, hedging, and international-funds processes (9.7, 9.10)." ;
                  rdfs:label "Market Rate Data" ;
                  skos:definition "A Descriptive Information Content Entity that describes prevailing interest rates, foreign-exchange rates, or other market prices." .


###  http://example.org/apqc#MarketSegmentation
ex:MarketSegmentation rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Output of 3.1.1.2 (identify market segments). Descriptive partition, not a directive to act." ;
                      rdfs:label "Market Segmentation" ;
                      skos:definition "A Descriptive Information Content Entity that describes a partition of the customer population into market segments." .


###  http://example.org/apqc#MarketShareAnalysis
ex:MarketShareAnalysis rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Output of 3.1.1.2.1 and 3.4.3.1. Descriptive analysis." ;
                       rdfs:label "Market Share Analysis" ;
                       skos:definition "A Descriptive Information Content Entity that describes the gain or loss of an organization's sales volume in targeted markets and its underlying causes." .


###  http://example.org/apqc#MarketStudy
ex:MarketStudy rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000853 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cco:ont00001808 ;
                                 owl:someValuesFrom ex:Market
                               ] ;
               rdfs:comment "Output of 2.3.2.1 (prepare detailed market study)." ;
               rdfs:label "Market Study" ;
               skos:definition "A Descriptive Information Content Entity that describes a detailed analysis of a market's competition, size, trends, segments, channels, and profitability." .


###  http://example.org/apqc#MarketingAlignmentAssessment
ex:MarketingAlignmentAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Output of 3.3.2.1. Descriptive (not Directive) because it represents a confirmation rather than prescribing a course of action." ;
                                rdfs:label "Marketing Alignment Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes a judgement of whether an organization's marketing plan corroborates its overall business strategy." .


###  http://example.org/apqc#MarketingBudget
ex:MarketingBudget rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of 3.3.2, 3.3.2.3. Directive: a budget prescribes resource allocation (Formulation genus)." ;
                   rdfs:label "Marketing Budget" ;
                   skos:definition "A Directive Information Content Entity that prescribes the planned allocation of resources to marketing activities." .


###  http://example.org/apqc#MarketingChannel
ex:MarketingChannel rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00001180 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty obo:BFO_0000196 ;
                                      owl:someValuesFrom ex:ChannelPartnerRole
                                    ] ;
                    rdfs:comment "Subject of ChannelEvaluation / ChannelPerformanceAnalysis (is about). Modeled as the partner Organization that constitutes the channel; this class denotes ONLY an organizational channel partner -- NOT a medium, route, platform, or distribution arrangement (print, radio, digital, etc.), which are left to group modules if needed." ;
                    rdfs:label "Marketing Channel" ;
                    skos:definition "An Organization, such as a distributor, wholesaler, or retailer, through which an organization markets and distributes its offerings to customers." .


###  http://example.org/apqc#MarketingCommunicationStrategy
ex:MarketingCommunicationStrategy rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:comment "Output of 3.2.5 and its sub-strategies (PR 3.2.5.2, direct 3.2.5.3, internal 3.2.5.4, new-media 3.2.5.6, POS 3.2.5.7). Directive (Formulation). Narrower than ex:MarketingStrategy: it is only the communication sub-strategy, not the whole go-to-market strategy." ;
                                  rdfs:label "Marketing Communication Strategy" ;
                                  skos:definition "A Directive Information Content Entity that prescribes how promotional messages are delivered in a coordinated way across marketing channels." .


###  http://example.org/apqc#MarketingGoal
ex:MarketingGoal rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:comment "Output of 3.3.1. Directive (Formulation)." ;
                 rdfs:label "Marketing Goal and Objective" ;
                 skos:definition "A Directive Information Content Entity that prescribes qualitative and quantitative targets to be achieved by marketing for offerings by channel and segment." .


###  http://example.org/apqc#MarketingManagementCapability
ex:MarketingManagementCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10159
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10160
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10167
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10168
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10169
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10170
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10171
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10172
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10178
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10179
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10180
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P10181
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P16630
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P18130
                                                 ] ;
                                 ex:enablesProcess ex:P10159 ,
                                                   ex:P10160 ,
                                                   ex:P10167 ,
                                                   ex:P10168 ,
                                                   ex:P10169 ,
                                                   ex:P10170 ,
                                                   ex:P10171 ,
                                                   ex:P10172 ,
                                                   ex:P10178 ,
                                                   ex:P10179 ,
                                                   ex:P10180 ,
                                                   ex:P10181 ,
                                                   ex:P16630 ,
                                                   ex:P18130 ;
                                 rdfs:comment "Standing capability behind the 'Manage...' nodes of 3.2 and 3.3 (R6). Realized-in axioms for groups 3.3 (PCF 20010 / 10154 / 16629) are attached additively below." ;
                                 rdfs:label "Marketing Management Capability" ;
                                 skos:definition "An Organization Capability that is realized in Acts of formulating and managing marketing strategy, plans, channels, and promotions." .


###  http://example.org/apqc#MarketingMessage
ex:MarketingMessage rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 3.3.4.2. Directive: this is the approved/prescribed message SPECIFICATION, crafted to persuade and to be disseminated (Formulation genus). The message content as actually communicated to a customer is descriptive/representational and, where a group needs it, is modeled separately as a Descriptive ICE." ;
                    rdfs:label "Marketing Message" ;
                    skos:definition "A Directive Information Content Entity that prescribes a central promotional statement positioning an offering's value for a customer segment." .


###  http://example.org/apqc#MarketingPersonnel
ex:MarketingPersonnel rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00001017 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty obo:BFO_0000196 ;
                                        owl:someValuesFrom ex:MarketingProfessionalRole
                                      ] ;
                      rdfs:comment "The 'marketing head/function' participant enlisted across 3.2, 3.3." ;
                      rdfs:label "Marketing Personnel" ;
                      skos:definition "An Agent that bears a marketing-professional role." .


###  http://example.org/apqc#MarketingProfessionalRole
ex:MarketingProfessionalRole rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000984 ;
                             rdfs:comment "Covers the 'marketing head/function' enlisted across 3.2 and 3.3." ;
                             rdfs:label "Marketing Professional Role" ;
                             skos:definition "A Role that is borne by an Agent in virtue of being tasked with marketing an organization's offerings." .


###  http://example.org/apqc#MarketingStrategy
ex:MarketingStrategy rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Minted (Gate-F) as the overall deliverable of 3.2 (P10102 Develop marketing strategy). Distinct from and broader than ex:MarketingCommunicationStrategy, which is only the communication sub-strategy authored by its child 3.2.5 (P16848). Directive (Formulation): it prescribes a course of action." ;
                     rdfs:label "Marketing Strategy" ;
                     skos:definition "A Directive Information Content Entity that prescribes an organization's overall go-to-market course, comprising its value proposition, pricing strategy, channel strategy, marketing communication strategy, and customer loyalty program." .


###  http://example.org/apqc#MasterProductionSchedule
ex:MasterProductionSchedule rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:label "Master Production Schedule" ;
                            skos:definition "A Directive Information Content Entity that prescribes the planned quantity, timing, and staffing of internal production and inventory activities over a planning horizon." .


###  http://example.org/apqc#MaterialSafetyDataSheet
ex:MaterialSafetyDataSheet rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cco:ont00001808 ;
                                             owl:someValuesFrom ex:HazardousMaterial
                                           ] ;
                           rdfs:comment "Descriptive: an MSDS records material properties; the handling requirements it cites are described, not authored, by it." ,
                                        "False-friend caution (Descriptive vs Directive): an MSDS is descriptive content (cco:ont00000853); any directive handling or disposal PROCEDURE it quotes is a separate Prescriptive ICE (cco:ont00000965) authored by the relevant authority, modeled as its own class if needed. Do not re-anchor the sheet to Directive on the strength of the rules it cites." ;
                           rdfs:label "Material Safety Data Sheet" ;
                           skos:definition "A Descriptive Information Content Entity, about a hazardous material, that records the safety properties and required handling and disposal information for that material." .


###  http://example.org/apqc#MaterialSpecification
ex:MaterialSpecification rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Despite the 'Specification' label, this class is DESCRIPTIVE: it records observed material attributes (density, volume, size), not a prescriptive requirement. A prescriptive material requirement should be modeled separately as a Directive ICE (e.g. a Material Requirement Specification). Label-driven false-friend guard (D6)." ;
                         rdfs:label "Material Specification" ;
                         skos:definition "A Descriptive Information Content Entity that describes the attributes and characteristics of an inventory item, such as density, volume, and size." .


###  http://example.org/apqc#MaterialsManagementContingencyPlan
ex:MaterialsManagementContingencyPlan rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000965 ;
                                      rdfs:label "Materials Management Contingency Plan" ;
                                      skos:definition "A Directive Information Content Entity that prescribes how to react to issues arising during execution of the inventory plan, such as a vendor failing to deliver on time." .


###  http://example.org/apqc#MaterialsMasterList
ex:MaterialsMasterList rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Minted: master-data record not in shared list. Descriptive." ;
                       rdfs:label "Materials Master List" ;
                       skos:definition "A Descriptive Information Content Entity that describes the storage, utilization, and supplier linkages of an organization's materials." .


###  http://example.org/apqc#MaterialsPlan
ex:MaterialsPlan rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:comment "Genus for both the unconstrained and the constrained materials plan; group modules may specialize as needed." ;
                 rdfs:label "Materials Plan" ;
                 skos:definition "A Directive Information Content Entity that prescribes the advance provision of raw materials and spares required to meet market demand." .


###  http://example.org/apqc#MeasurementMethodSelection
ex:MeasurementMethodSelection rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Minted: Directive output of choosing measurement methods from candidate tools (output of ex:P17478)." ;
                              rdfs:label "Measurement Method Selection" ;
                              skos:definition "A Directive Information Content Entity that prescribes the tools and methods chosen to measure quality levels." .


###  http://example.org/apqc#MediaOutlet
ex:MediaOutlet rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00001180 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000196 ;
                                 owl:someValuesFrom ex:MediaOutletRole
                               ] ;
               rdfs:comment "Minted for 12.5.2 / 12.5.5 (media relations, issuing press releases)." ;
               rdfs:label "Media Outlet" ;
               skos:definition "An Organization that bears a media-outlet role in virtue of producing and distributing news or content through channels such as the web, newspapers, or social media." .


###  http://example.org/apqc#MediaOutletRole
ex:MediaOutletRole rdf:type owl:Class ;
                   rdfs:subClassOf obo:BFO_0000023 ;
                   rdfs:label "Media Outlet Role" ;
                   skos:definition "A Role that is borne by an Organization in virtue of producing and distributing news or content to the public." .


###  http://example.org/apqc#MeetingRecord
ex:MeetingRecord rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Minted for 12.2.2.4 (P12878). Distinct from the input-side ex:RelationshipData ('describes the current state of a relationship', consumed as has-input in P12869/P12871/P12880): the recorded artifact a meeting produces is a meeting record (the output of recording), not the relationship-state data consumed elsewhere -- correcting the Gate-F category confusion of reusing an input class as a has-output filler." ;
                 rdfs:label "Meeting Record" ;
                 skos:definition "A Descriptive Information Content Entity that records what transpired in a meeting, including attendees, topics discussed, and outcomes, for further analysis and use." ;
                 skos:example "Minutes of a quarterly liaison meeting with a quasi-governmental body." .


###  http://example.org/apqc#MetricGapAssessment
ex:MetricGapAssessment rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Descriptive (a gap-finding/discernment), not Directive: it represents the NEED for further metrics, not the composition of any new indicator. Output of ex:P20141 'Identify additional metrics as required'. Distinct from ex:PerformanceIndicatorSpecification (the Directive artifact a later formulation act would compose)." ;
                       rdfs:label "Metric Gap Assessment" ;
                       skos:definition "A Descriptive Information Content Entity that describes whether additional performance indicators are needed to achieve a business goal and which measurement gaps exist." ;
                       skos:example "A note finding that the new on-time-delivery goal is not yet covered by any existing KPI." .


###  http://example.org/apqc#MissionStatement
ex:MissionStatement rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Directive: a mission prescribes intended direction rather than describing a state of affairs." ;
                    rdfs:label "Mission Statement" ;
                    skos:definition "A Directive Information Content Entity that prescribes the overarching purpose and practicable targets an organization aims to pursue." .


###  http://example.org/apqc#ModelIntegrationPointRegister
ex:ModelIntegrationPointRegister rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Minted for 1.4.1.3 output. Descriptive (it represents integration points) rather than Directive." ;
                                 rdfs:label "Model Integration Point Register" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the points at which a new business model must integrate with pre-existing models to remain coherent with them." .


###  http://example.org/apqc#MonitoringFrequencySpecification
ex:MonitoringFrequencySpecification rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000965 ;
                                    rdfs:comment "Minted for APQC 13.6.3.2 'Establish monitoring frequency'. Directive (not Descriptive) because it prescribes a monitoring cadence rather than describing reality. Distinct from ex:PerformanceIndicatorSpecification (which prescribes what is measured, not how often)." ;
                                    rdfs:label "Monitoring Frequency Specification" ;
                                    skos:definition "A Directive Information Content Entity that prescribes how often performance is to be supervised, measured, and assessed." .


###  http://example.org/apqc#NPDProcessAssessment
ex:NPDProcessAssessment rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Minted: process-assessment output not in shared list. Descriptive." ;
                        rdfs:label "New Product Development Process Assessment" ;
                        skos:definition "A Descriptive Information Content Entity that describes an analysis of the new-product-development steps and their effect on existing products, resources, and functions." .


###  http://example.org/apqc#NeedsSupplyAlignmentAssessment
ex:NeedsSupplyAlignmentAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Minted: no shared-vocab descriptive ICE captures a requirements-versus-capacity reconciliation. Descriptive because it represents fit rather than prescribing action." ;
                                  rdfs:label "Needs-Supply Alignment Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the degree of fit between an organization's purchasing requirements and the capacity of its suppliers." ;
                                  skos:example "A report noting that forecast demand for a part exceeds the qualified suppliers' combined monthly capacity." .


###  http://example.org/apqc#NetworkIntrusionDetectionData
ex:NetworkIntrusionDetectionData rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "8.3.5.7 input. Descriptive." ;
                                 rdfs:label "Network Intrusion Detection Data" ;
                                 skos:definition "A Descriptive Information Content Entity that describes events captured by network intrusion detection sensors for assessment of malicious activity or policy violations." ;
                                 skos:example "A stream of IDS alerts for a monitored network segment." .


###  http://example.org/apqc#NetworkIntrusionThreatResolution
ex:NetworkIntrusionThreatResolution rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:comment "8.3.5.7 output. Descriptive." ;
                                    rdfs:label "Network Intrusion Threat Resolution" ;
                                    skos:definition "A Descriptive Information Content Entity that describes malicious activity or policy violations detected in network intrusion data together with the gaps identified and threats resolved." ;
                                    skos:example "An incident record describing a blocked intrusion and the network-security gap it exposed." .


###  http://example.org/apqc#NewMediaAssessment
ex:NewMediaAssessment rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Output of 3.2.5.5. Descriptive: it identifies and describes candidate media; the strategy that capitalizes on them is the separate Directive ex:MarketingCommunicationStrategy (3.2.5.6)." ;
                      rdfs:label "New Media Assessment" ;
                      skos:definition "A Descriptive Information Content Entity that registers and describes emerging media channels identified as candidates for marketing communication." .


###  http://example.org/apqc#NewProductEvaluation
ex:NewProductEvaluation rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Minted: distinct from ex:ProfitabilityAnalysis (general profit study) - this is the appraisal of a prospective product's viability. Descriptive judgement." ;
                        rdfs:label "New-Product Evaluation" ;
                        skos:definition "A Descriptive Information Content Entity that describes a judgement of the demand and projected profitability of a new product in a market." ;
                        skos:example "A go-to-market assessment of a proposed product line for a target segment." .


###  http://example.org/apqc#NonconformanceImpactAssessment
ex:NonconformanceImpactAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:label "Nonconformance Impact Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the potential impact of a non-conformance event and the need for corrective or preventive action." .


###  http://example.org/apqc#NonconformanceRecord
ex:NonconformanceRecord rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "Nonconformance Record" ;
                        skos:definition "A Descriptive Information Content Entity that describes a closed non-conformance, including its documented root causes and the corrective and preventive actions taken." .


###  http://example.org/apqc#NonconformanceTrendAnalysis
ex:NonconformanceTrendAnalysis rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:label "Nonconformance Trend Analysis" ;
                               skos:definition "A Descriptive Information Content Entity that describes trends in the occurrence of process or product nonconformances over time." .


###  http://example.org/apqc#ObjectiveAlignmentAssessment
ex:ObjectiveAlignmentAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Minted locally: APQC 5.3.1.4 output; no shared-vocab ICE supplied." ;
                                rdfs:label "Objective Alignment Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes the degree to which a customer's business objectives align with an agreed service-delivery solution." ;
                                skos:example "A note recording that the proposed solution supports the client's stated growth objective." .


###  http://example.org/apqc#ObjectiveRealizationReport
ex:ObjectiveRealizationReport rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Objective Realization Report" ;
                              skos:definition "A Descriptive Information Content Entity that describes the extent to which HR goals and objectives have been achieved, measured against defined metrics." .


###  http://example.org/apqc#Offering
ex:Offering rdf:type owl:Class ;
            rdfs:subClassOf obo:BFO_0000040 ;
            rdfs:comment "Subject of marketing content, sales forecasts, training material (is about). Anchored at bfo:material entity (a product is a material object); operations material I/O is legal for this section. A service offering, where a group needs it specifically, should be modeled separately -- this shared class covers the predominant product sense and the generic 'offering' subject of descriptive ICEs." ;
            rdfs:label "Offering (product)" ;
            skos:definition "A Material Entity that an organization produces or provides and markets and sells to customers." .


###  http://example.org/apqc#OmniChannelStrategy
ex:OmniChannelStrategy rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Output of 3.2.3.7, 3.2.3.7.1. Directive (Formulation)." ;
                       rdfs:label "Omni-Channel Strategy" ;
                       skos:definition "A Directive Information Content Entity that prescribes how to market and serve customers seamlessly across all supported channels." .


###  http://example.org/apqc#OnboardingProgramEvaluation
ex:OnboardingProgramEvaluation rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Minted locally (group 7.3, used by P11243). Descriptive: it represents how the program performed rather than prescribing a course of action." ;
                               rdfs:label "Onboarding Program Evaluation" ;
                               skos:definition "A Descriptive Information Content Entity that describes a judgement of the performance and effectiveness of an employee onboarding program based on new-employee feedback and reviews." ;
                               skos:example "A written report summarizing new hires' survey responses on the induction program's usefulness." .


###  http://example.org/apqc#OnboardingProgramSpecification
ex:OnboardingProgramSpecification rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:label "Onboarding Program Specification" ;
                                  skos:definition "A Directive Information Content Entity that prescribes the induction and onboarding program through which new employees acquire the knowledge, skills, and behaviors to become effective organizational members." .


###  http://example.org/apqc#OpportunityPipelineData
ex:OpportunityPipelineData rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Shared section-5.0 input to pipeline monitoring (5.2.1.1)." ;
                           rdfs:label "Opportunity Pipeline Data" ;
                           skos:definition "A Descriptive Information Content Entity that describes potential service-delivery opportunities and their stage within a sales or engagement pipeline." .


###  http://example.org/apqc#OpportunityPrioritization
ex:OpportunityPrioritization rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Output of 3.1.2.3. Directive: a ranked index that prescribes which opportunities to pursue first (Selection/Formulation genus)." ;
                             rdfs:label "Opportunity Prioritization" ;
                             skos:definition "A Directive Information Content Entity that prescribes a ranked ordering of market opportunities consistent with organizational capabilities and strategy." .


###  http://example.org/apqc#OpportunityQuantification
ex:OpportunityQuantification rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Output of 3.1.2.1. Descriptive." ;
                             rdfs:label "Opportunity Quantification" ;
                             skos:definition "A Descriptive Information Content Entity that describes quantified value indicators attached to identified market opportunities." .


###  http://example.org/apqc#OpportunityValidation
ex:OpportunityValidation rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Output of 3.1.2.4 (and tasks 3.1.2.4.1, 3.1.2.4.2) and of 3.5.1.3 (validate/qualify leads). Descriptive judgement of feasibility (Appraisal genus)." ;
                         rdfs:label "Opportunity Validation Result" ;
                         skos:definition "A Descriptive Information Content Entity that describes confirmation of the feasibility and reasonableness of identified market opportunities, including whether a sales lead meets requirements for pursuit." .


###  http://example.org/apqc#OpportunityWinPlan
ex:OpportunityWinPlan rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Output of 3.5.1.5. Directive (Formulation)." ;
                      rdfs:label "Opportunity Win Plan" ;
                      skos:definition "A Directive Information Content Entity that prescribes how to close a lead and win a sales opportunity." .


###  http://example.org/apqc#OrganizationalCharacteristicsAnalysis
ex:OrganizationalCharacteristicsAnalysis rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000853 ;
                                         rdfs:label "Organizational Characteristics Analysis" ;
                                         skos:definition "A Descriptive Information Content Entity that describes the key attributes differentiating an organization in its market and underpinning its operations." .


###  http://example.org/apqc#OrganizationalDesign
ex:OrganizationalDesign rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "Output of 1.2.5 'Create organizational design'. Directive: a design prescribes (serves as a model for) the structure to be realized." ;
                        rdfs:label "Organizational Design" ;
                        skos:definition "A Directive Information Content Entity that prescribes the intended structure and relationships among an organization's units and roles." .


###  http://example.org/apqc#OrganizationalObjective
ex:OrganizationalObjective rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000476 ;
                           rdfs:comment "Reuses CCO Objective (ont00000476). Output of 1.2.6 'Develop and set organizational objectives' and the priority statements of 1.3.1." ;
                           rdfs:label "Organizational Objective" ;
                           skos:definition "An Objective that prescribes a projected state an organization intends to achieve in pursuit of its mission." .


###  http://example.org/apqc#OrganizationalPerformanceStrategy
ex:OrganizationalPerformanceStrategy rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:label "Organizational Performance Strategy" ;
                                     skos:definition "A Directive Information Content Entity that prescribes an Organization's approach for measuring, tracking, streamlining, and improving internal performance." .


###  http://example.org/apqc#OrganizationalRiskAnalysis
ex:OrganizationalRiskAnalysis rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Organizational Risk Analysis" ;
                              skos:definition "A Descriptive Information Content Entity that describes the impact and probability of threats to an Organization's critical assets." .


###  http://example.org/apqc#OrganizationalStructureAdoptionDecision
ex:OrganizationalStructureAdoptionDecision rdf:type owl:Class ;
                                           rdfs:subClassOf cco:ont00000965 ;
                                           rdfs:comment "Minted (Gate-F) for P10056 'Migrate to new organization', parallel to ex:BusinessModelAdoptionDecision. Subject-matched (an organizational structure, not a strategic initiative), replacing the mis-subjected ex:InitiativeSelectionDecision." ;
                                           rdfs:label "Organizational Structure Adoption Decision" ;
                                           skos:definition "A Directive Information Content Entity that prescribes that a particular organizational structure is to serve as the accepted basis of an organization's operations." .


###  http://example.org/apqc#OrganizationalStructureAssessment
ex:OrganizationalStructureAssessment rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000853 ;
                                     rdfs:label "Organizational Structure Assessment" ;
                                     skos:definition "A Descriptive Information Content Entity that describes the evaluated breadth, depth, and implications of an organization's structural makeup." .


###  http://example.org/apqc#OutboundTransportationPlan
ex:OutboundTransportationPlan rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:label "Outbound Transportation Plan" ;
                              skos:definition "A Directive Information Content Entity that prescribes the dispatch, transportation, and delivery of outbound products to their destinations." .


###  http://example.org/apqc#OutsideCounsel
ex:OutsideCounsel rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00001017 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000196 ;
                                    owl:someValuesFrom ex:OutsideCounselRole
                                  ] ;
                  rdfs:comment "Minted for 12.4.5 (Manage outside counsel). Agent because counsel may be an individual attorney or a law firm." ;
                  rdfs:label "Outside Counsel" ;
                  skos:definition "An Agent that bears an outside-counsel role in virtue of being an external subject-matter expert engaged to provide legal or ethical assistance to an organization." .


###  http://example.org/apqc#OutsideCounselRole
ex:OutsideCounselRole rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000506 ;
                      rdfs:label "Outside Counsel Role" ;
                      skos:definition "A Role that is borne by an Agent in virtue of being an external expert engaged to provide legal or ethical assistance to a focal organization." .


###  http://example.org/apqc#OutsourcingNeedsStatement
ex:OutsourcingNeedsStatement rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Minted (D5) as the conveyed deliverable of Communicate outsourcing needs [10345]. Descriptive because it states/reports identified outsourcing needs rather than prescribing a course of action. Distinct from ex:OutsourcingPolicy (a Directive policy artifact), which APQC does not say this act produces." ;
                             rdfs:label "Outsourcing Needs Statement" ;
                             skos:definition "A Descriptive Information Content Entity that states which portion of an organization's logistics activities is needed to be transferred to outside suppliers, prepared for conveyance to management or the appropriate authority." ;
                             skos:example "A memo to management stating the warehousing scope recommended for outsourcing and the assistance required." .


###  http://example.org/apqc#OutsourcingPolicy
ex:OutsourcingPolicy rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:label "Outsourcing Policy" ;
                     skos:definition "A Directive Information Content Entity that prescribes rules and regulations governing the contracting out of business processes to other parties." .


###  http://example.org/apqc#P10015
ex:P10015 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10037
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10038
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10039
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10040
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10041
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10042
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10043
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18916
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19959
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessStrategy
                          ] ;
          ex:apqcSourceText "Developing an organization's mission statement, strategy, and business design. Create a concise statement that clearly articulates the mission of the organization, outlining practicable targets to Establish a strategic vision [10020]. Delineate strategic options by matching these alternatives with the organization's internal capabilities. Create an organizational design, and identify goals by developing strategies at the functional and process levels." ;
          ex:hierarchyID "1.2" ;
          ex:pcfID "10015" ;
          rdfs:comment "Models APQC process group 1.2 as an occurrent. Its APQC dotted children are process parts (cco:ont00001777), not subclasses." ;
          rdfs:label "Develop business strategy" ;
          skos:definition "An Act of Planning that develops an organization's mission statement, strategy, and business design and produces a business strategy together with an organizational design." ;
          skos:example "An organization's annual strategic-planning programme that produces a refreshed mission, long-term strategy, and organizational design." .


###  http://example.org/apqc#P10016
ex:P10016 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10057
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10058
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10059
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10060
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19507
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21422
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21423
                          ] ;
          ex:apqcSourceText "Managing strategic initiatives, from development through selection, execution, and evaluation. Conduct and oversee strategic projects supporting long-term objectives. Administer programs of strategic significance by developing such initiatives, select the most appropriate projects, and formulate measures to assess their impact." ;
          ex:hierarchyID "1.3" ;
          ex:pcfID "10016" ;
          rdfs:comment "Models APQC process group 1.3 as a bounded occurrent (an end-to-end initiative cycle), not a standing function. Its APQC children are process parts, not subclasses (D1)." ;
          rdfs:label "Develop and measure strategic initiatives" ;
          skos:definition "An Act of Planning that develops, selects, executes, and evaluates programs of strategic significance and formulates the measures used to assess their impact." ;
          skos:example "An organization's annual strategic-initiative cycle, from drafting candidate initiatives to evaluating the executed ones." .


###  http://example.org/apqc#P10017
ex:P10017 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10021
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10022
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10023
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10024
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10025
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10026
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10027
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16790
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19945
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21421
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ExternalEnvironmentAssessment
                          ] ;
          ex:apqcSourceText "Assessing all forces, entities, and systems that are external to an organization but can affect its operation. Analyze far-reaching currents in the macroeconomic situation, assess the competition, evaluate technological changes, and identify societal as well as ecological issues of concern. Create a big-picture understanding of externalities, with sufficient depth across individual aspects." ;
          ex:hierarchyID "1.1.1" ;
          ex:pcfID "10017" ;
          rdfs:comment "Anchored (Gate-F) to ex:ActOfAnalysis, kept consistent with its sibling P10019 'Assess the internal environment': both differentiate on building a 'big-picture understanding' and emit a Descriptive assessment, so both are Analysis. Rejected cco:ont00000636 (Act of Appraisal): the dominant gerund is creating a synthetic understanding of externalities, not rendering a value-judgement. Was ex:AnalyzeExternalBusinessEnvironment in the GOLD module. Its APQC children are process parts, not subclasses." ;
          rdfs:label "Assess the external environment" ;
          skos:definition "An Act of Analysis that examines the external forces, entities, and systems bearing on an organization and produces a big-picture external-environment assessment." ;
          skos:example "An organization's yearly strategic environmental scan culminating in an external-environment assessment." .


###  http://example.org/apqc#P10018
ex:P10018 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10028
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19946
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19947
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerNeedsAssessment
                          ] ;
          ex:apqcSourceText "Examining the market to identify customer required solutions. Assess the relevant market(s) to determine the products/services that are needed or wanted by customers. Carry out quantitative and qualitative analyses to capture and investigate products/services. Employ creative techniques that allow for a closer appreciation of the customer, and design relevant solutions." ;
          ex:hierarchyID "1.1.2" ;
          ex:pcfID "10018" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis (information processing): it examines market/customer data into a needs assessment. Its APQC children are process parts." ;
          rdfs:label "Survey market and determine customer needs and wants" ;
          skos:definition "An Act of Analysis that examines market and customer data to determine the products and services customers need or want and produces a customer needs assessment." ;
          skos:example "A market-research team surveys a segment and reports the customer needs the firm should address." .


###  http://example.org/apqc#P10019
ex:P10019 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10030
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10031
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10032
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10033
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10034
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19948
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:InternalCapabilityData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InternalEnvironmentAssessment
                          ] ;
          ex:apqcSourceText "Undertaking a review of the organization's in-house skills and resources in order to create a big-picture understanding of internal capacities. Assess the organization's capabilities in order to advance the advantageous and weed out the detrimental aspects. Identify synergic associations within the backdrop of the forces and players active in the market, and take into account all externalities." ;
          ex:hierarchyID "1.1.3" ;
          ex:pcfID "10019" ;
          rdfs:comment "Re-anchored (Gate-F) from cco:ont00000636 (Act of Appraisal) to ex:ActOfAnalysis for sibling consistency with P10017 'Assess the external environment': the source's differentia is 'create a big-picture understanding of internal capacities', and the Descriptive ex:InternalEnvironmentAssessment output agrees with the Information-Processing genus. Rejected Act of Appraisal: building a synthetic understanding is analysis, not a value-judgement. Its APQC children are process parts." ;
          rdfs:label "Assess the internal environment" ;
          skos:definition "An Act of Analysis that reviews an organization's in-house skills, resources, and capabilities and produces a big-picture internal-environment assessment." ;
          skos:example "A strategy team reviews the firm's capabilities and produces an internal-environment assessment." .


###  http://example.org/apqc#P10020
ex:P10020 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10035
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10036
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19949
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicVision
                          ] ;
          ex:apqcSourceText "Establishing the organization's long-term vision as a strategic positioning and engagement of stakeholders. Institute the vision by creating strategic orientations of all stakeholders. Understand the strategy development frameworks in this context." ;
          ex:hierarchyID "1.1.4" ;
          ex:pcfID "10020" ;
          ex:requiresCapability ex:StrategicPlanningCapability ;
          rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it produces a directive vision. Its APQC children are process parts." ;
          rdfs:label "Establish strategic vision" ;
          skos:definition "An Act of Planning that formulates an organization's long-term strategic vision and orients stakeholders around it, producing a strategic vision." ;
          skos:example "An executive team establishes a ten-year vision and aligns stakeholders behind it." .


###  http://example.org/apqc#P10021
ex:P10021 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CompetitorData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompetitiveBenchmark
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompetitiveForcesAssessment
                          ] ;
          ex:apqcSourceText "Assessing the competitive forces in the marketplace that could potentially affect the organization. Analyze various aspects of business competition including competing firms. Aggregate competitive intelligence, create benchmarks to juxtapose processes and performance metrics, and inject crucial information about the competition into management models to synthesize insights." ;
          ex:hierarchyID "1.1.1.2" ;
          ex:pcfID "10021" ;
          rdfs:comment "Carried over from GOLD module (ex:AssessMarketplaceCompetitiveForces). Anchored to cco:ont00000636 (Act of Appraisal)." ;
          rdfs:label "Analyze and evaluate competition" ;
          skos:definition "An Act of Appraisal that has as input competitor data and market data and has as output a competitive-forces assessment and competitive benchmarks." ;
          skos:example "An analyst benchmarks rivals and issues an assessment of the competitive forces in the sector." .


###  http://example.org/apqc#P10022
ex:P10022 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MacroeconomicData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MacroeconomicTrendAnalysis
                          ] ;
          ex:apqcSourceText "Determining large-scale macroeconomic shifts and trends, with medium to long-term relevance for the organization. Vet the immediate and the larger economic ecosystem to identify broad-based movements that affect the organization. In the immediate vicinity, for example, examine the stock price of key vendors/suppliers in the organizational value-chain. In the larger economic ecosystem, analyze according to geographical distribution where factors such as interest rates, taxation structures, oil prices, and unemployment rates are explored." ;
          ex:hierarchyID "1.1.1.4" ;
          ex:pcfID "10022" ;
          rdfs:comment "Carried over from GOLD module (ex:DetermineMacroeconomicTrends)." ;
          rdfs:label "Identify economic trends" ;
          skos:definition "An Act of Analysis that has as input macroeconomic data and has as output a macroeconomic trend analysis." ;
          skos:example "An economist reviews indicators and reports the trends likely to affect the firm over five years." .


###  http://example.org/apqc#P10023
ex:P10023 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:RegulatoryData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RegulatoryConcernRegister
                          ] ;
          ex:apqcSourceText "Identifying areas of concern pertaining to public policy and regulation, established by sovereign or multinational authorities. Examine various regions and geopolitical formations to identify those political and regulatory issues-present or developing-that can potentially affect the organization. Plan for an iterative process, partitioned across regional and geopolitical entities that have a direct bearing on the organization's activities. Assess changes in environmental compliance, product standards, trade barriers, etc." ;
          ex:hierarchyID "1.1.1.5" ;
          ex:pcfID "10023" ;
          rdfs:comment "Carried over from GOLD module (ex:IdentifyRegulatoryConcerns)." ;
          rdfs:label "Identify political and regulatory factors" ;
          skos:definition "An Act of Identification that has as input regulatory data and has as output a regulatory concern register." ;
          skos:example "A compliance team screens jurisdictions and registers the regulatory changes that bear on the firm." .


###  http://example.org/apqc#P10024
ex:P10024 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SeniorManagement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:TechnologyData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:TechnologyAssessment
                          ] ;
          ex:apqcSourceText "Assessing developments in technologies presently being used by the business, new technologies that have a potential for the business, and any disruptive innovations. Conduct a survey of advancement in technologies that are already deployed with inputs from the personnel closely working with them, tracking utility and feasibility for deployment. Arrange for mid- to senior-level management personnel who explore contingent uses to assess new and disruptive technologies. Follow up with desk research, involving physical scoping and viability assessment." ;
          ex:hierarchyID "1.1.1.8" ;
          ex:pcfID "10024" ;
          ex:requiresRole ex:SeniorManagerRole ;
          rdfs:comment "Carried over from GOLD module (ex:AssessTechnologyDevelopments). Participant re-bound to shared ex:SeniorManagement per the manifest agent vocabulary." ;
          rdfs:label "Assess new technologies" ;
          skos:definition "An Act of Appraisal that has as input technology data, has as output a technology assessment, and has senior management as participant." ;
          skos:example "Senior managers appraise an emerging technology and issue a technology assessment." .


###  http://example.org/apqc#P10025
ex:P10025 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DemographicData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DemographicAnalysis
                          ] ;
          ex:apqcSourceText "Analyzing statistical data relating to the size, distribution, and composition of relevant populations, as well as their characteristics. Perform quantitative analysis over raw data-sets gathered from well-founded sources such as government census or large, private databases. Consider employing primary research in collecting required statistics. Use comprehensive studies (reports, briefs, and articles) to assist with the analysis, in place of raw data." ;
          ex:hierarchyID "1.1.1.9" ;
          ex:pcfID "10025" ;
          rdfs:comment "Carried over from GOLD module (ex:AnalyzeDemographics)." ;
          rdfs:label "Analyze demographics" ;
          skos:definition "An Act of Analysis that has as input demographic data and has as output a demographic analysis." ;
          skos:example "A team analyzes census data and produces a demographic profile of a target market." .


###  http://example.org/apqc#P10026
ex:P10026 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SocioculturalData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SocioculturalShiftAnalysis
                          ] ;
          ex:apqcSourceText "Distinguishing changes in societal makeup, as well as the cultural composite. Isolate shifts in the societal composition and distribution, as well as the value systems and attributes that bind the organization together. Analyze well-regarded publications--and gather the perspective of public intellectuals and opinion leaders--on relevant issues." ;
          ex:hierarchyID "1.1.1.7" ;
          ex:pcfID "10026" ;
          rdfs:comment "Carried over from GOLD module (ex:DistinguishSocioculturalShifts)." ;
          rdfs:label "Identify social and cultural changes" ;
          skos:definition "An Act of Identification that has as input sociocultural data and has as output a sociocultural shift analysis." ;
          skos:example "A market researcher distinguishes generational value shifts relevant to the brand." .


###  http://example.org/apqc#P10027
ex:P10027 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EcologicalData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ResearchPublication
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EcologicalConcernRegister
                          ] ;
          ex:apqcSourceText "Identifying changes in ecological ecosystems that can be directly or indirectly detrimental to the organization. Analyze ecological factors within the immediate ecosystem for near to middle-term impact. Analyze the ecology, at large, to get a sense of long-term shifts and concerns. Gather analyses from research publications. Speak to subject matter experts. Engage with advocacy groups, lawyers, journalists, and the active populations." ;
          ex:hierarchyID "1.1.1.6" ;
          ex:pcfID "10027" ;
          rdfs:comment "Carried over from GOLD module (ex:IdentifyEcologicalConcerns)." ;
          rdfs:label "Identify environmental factors" ;
          skos:definition "An Act of Identification that has as input ecological data and research publications and has as output an ecological concern register." ;
          skos:example "An ESG analyst registers ecological risks drawn from scientific publications and expert input." .


###  http://example.org/apqc#P10028
ex:P10028 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerNeedsAssessment
                          ] ;
          ex:apqcSourceText "Investigating key market features and customer characteristics, using qualitative and quantitative measures to capture relevant aspects. Distill key ingredients that allow the organization to Capture customer needs and wants [19946], and Assess customer needs and wants [19947]. Conduct standardized appraisals by defining selection parameters and setting quotas." ;
          ex:hierarchyID "1.1.2.1" ;
          ex:pcfID "10028" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis. Research/investigation of market features is information processing." ;
          rdfs:label "Conduct qualitative/quantitative research and assessments" ;
          skos:definition "An Act of Analysis that has as input market data and customer data and has as output a customer needs assessment derived from qualitative and quantitative research." ;
          skos:example "Researchers run a survey and focus groups and distill the findings into a needs assessment." .


###  http://example.org/apqc#P10030
ex:P10030 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SeniorManagement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:InternalCapabilityData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalCharacteristicsAnalysis
                          ] ;
          ex:apqcSourceText "Identifying and examining key attributes that differentiate the organization in the market and those that underscore the core of its operations. Consider how the organization functions. Reflect over tangible and intangible aspects in order to spot critical correlations and the interplay between these attributes. Have senior executives conduct the analysis, with input from management and operational personnel." ;
          ex:hierarchyID "1.1.3.1" ;
          ex:pcfID "10030" ;
          ex:requiresRole ex:SeniorManagerRole ;
          rdfs:comment "Anchored to ex:ActOfAnalysis. Senior management modeled as definitional participant per the source ('Have senior executives conduct the analysis')." ;
          rdfs:label "Analyze organizational characteristics" ;
          skos:definition "An Act of Analysis that has as input internal-capability data and has as output an organizational-characteristics analysis, with senior management as participant." ;
          skos:example "Senior executives examine the firm's differentiating attributes and document an organizational-characteristics analysis." .


###  http://example.org/apqc#P10031
ex:P10031 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceRecord
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProcessBaseline
                          ] ;
          ex:apqcSourceText "Establishing baselines that provide standards for assessing performance levels and allow for a relational benchmarking of current processes. Undertake a survey of archival performance records, conducted in conjunction by the management and the operations personnel. Take into account the organization's internal objectives, particularly for process improvement and enhancement. Understand industry best practices." ;
          ex:hierarchyID "1.1.3.3" ;
          ex:pcfID "10031" ;
          rdfs:comment "Re-anchored (Gate-F) from cco:ont00000511 (Act of Planning) to ex:ActOfAnalysis, kept consistent with its sibling P19983 'Establish baselines for business value drivers': a baseline is a Descriptive reference measure DERIVED from archival performance records (the output ex:ProcessBaseline is Descriptive), so the act is information processing. Rejected Act of Planning (would require a Directive output, but a baseline describes a reference level rather than prescribing action) and rejected cco:ont00000345 Act of Measuring (measuring determines a value AGAINST an existing standard, whereas this act DERIVES the standard from records)." ;
          rdfs:label "Create baselines for current processes" ;
          skos:definition "An Act of Analysis that has as input performance records and has as output a process baseline derived from them as a reference measure for benchmarking current processes." ;
          skos:example "Management surveys archival performance records and derives process baselines for benchmarking." .


###  http://example.org/apqc#P10032
ex:P10032 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:InternalCapabilityData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SystemsAndTechnologyAnalysis
                          ] ;
          ex:apqcSourceText "Analyzing the capabilities of technology and process automation systems deployed within the organization in order to direct future associated processes. Conduct a broad-based survey to examine various aspects associated with such systems and technologies, with the objective of identifying key facets that are of interest. Investigate the intended purpose, purpose served, utility, longevity, remaining service-life, repair or service requirements, etc." ;
          ex:hierarchyID "1.1.3.4" ;
          ex:pcfID "10032" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis: it examines deployed systems and reports their capabilities." ;
          rdfs:label "Analyze systems and technology" ;
          skos:definition "An Act of Analysis that has as input internal-capability data and has as output a systems-and-technology analysis of deployed technology and automation systems." ;
          skos:example "An IT team surveys deployed automation systems and documents a systems-and-technology analysis." .


###  http://example.org/apqc#P10033
ex:P10033 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:FinancialStatement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FinancialHealthAnalysis
                          ] ;
          ex:apqcSourceText "Appraising the financial state of the organization so that management can create resource allocation strategies. Scrutinize the organization's financials--including balance sheets, statements of income, cash-flows, equity holdings, and liquidity--with the objective of understanding the organization's financial health and capacities. (This analysis directly feeds into Conduct organizational restructuring opportunities [16792] and Define a business concept and long-term vision [17040].)" ;
          ex:hierarchyID "1.1.3.5" ;
          ex:pcfID "10033" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it appraises the financial state. Source notes its output feeds 1.1.5 and 1.1." ;
          rdfs:label "Analyze financial health" ;
          skos:definition "An Act of Appraisal that has as input financial statements and has as output a financial-health analysis of the organization's financial state." ;
          skos:example "A finance team scrutinizes the balance sheet and cash-flow statements and reports the firm's financial health." .


###  http://example.org/apqc#P10034
ex:P10034 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:InternalCapabilityData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CoreCompetencyAnalysis
                          ] ;
          ex:apqcSourceText "Determining a strategically significant aggregate of competence and capacities that differentiates the organization in the market. Identify distinguishing attributes including unique skills and resources and its brand and services in the marketplace. Have senior executives and management personnel assess competencies in order to further develop these capabilities into distinct commercial value propositions." ;
          ex:hierarchyID "1.1.3.6" ;
          ex:pcfID "10034" ;
          rdfs:comment "Anchored to ex:ActOfIdentification (discernment sense): it discerns and registers strategically significant competencies." ;
          rdfs:label "Identify core competencies" ;
          skos:definition "An Act of Identification that has as input internal-capability data and has as output a core-competency analysis registering the organization's distinguishing competencies." ;
          skos:example "Senior executives determine and document the firm's core competencies for its value proposition." .


###  http://example.org/apqc#P10035
ex:P10035 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:StrategyPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicVision
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StakeholderAlignmentPlan
                          ] ;
          ex:apqcSourceText "Orienting those entities, associated with the organization that have a direct bearing on its operations and output, in a way that advances its strategic vision. Map all stakeholders in strategic configurations, within the architectural layout of the marketplace, and position the organization relative to them. (This exercise is undertaken by senior strategy personnel, drawing upon the process Define a business concept and long-term vision [17040].)" ;
          ex:hierarchyID "1.1.4.2" ;
          ex:pcfID "10035" ;
          ex:requiresRole ex:StrategyPersonnelRole ;
          rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it produces a directive alignment plan. Strategy personnel modeled as definitional participant per the source." ;
          rdfs:label "Align stakeholders around strategic vision" ;
          skos:definition "An Act of Planning that has as input a strategic vision and has as output a stakeholder alignment plan mapping stakeholders in strategic configurations, with strategy personnel as participant." ;
          skos:example "Senior strategy personnel map stakeholders and produce a plan to align them with the vision." .


###  http://example.org/apqc#P10036
ex:P10036 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:StrategyPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StakeholderAlignmentPlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicVision
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CommunicationStrategy
                          ] ;
          ex:apqcSourceText "Developing and executing communication strategies to convey an alignment plan of all organizational stakeholders, which helps the organization realize its vision. Create custom communication strategies and delivery channels with the objective of orienting stakeholders according to the configuration maps created in the process Align stakeholders around a strategic vision [10035]. Have senior strategy personnel closely collaborate with the communications/marketing team." ;
          ex:hierarchyID "1.1.4.3" ;
          ex:pcfID "10036" ;
          ex:requiresRole ex:StrategyPersonnelRole ;
          rdfs:comment "Anchored to cco:ont00000402 (Act of Communication, verified v2.0): an ICE (the vision/alignment plan) is transferred from the organization to its stakeholders." ;
          rdfs:label "Communicate strategic vision to stakeholders" ;
          skos:definition "An Act of Communication that has as input a stakeholder alignment plan and a strategic vision and conveys the vision to stakeholders by means of a communication strategy." ;
          skos:example "Strategy personnel and marketing convey the vision to stakeholders through tailored channels." .


###  http://example.org/apqc#P10037
ex:P10037 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10044
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10045
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10046
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MissionStatement
                          ] ;
          ex:apqcSourceText "Establishing an overarching, compact statement that concisely underscores the mission of the organization. Define and communicate a clear and succinct mission statement, which encapsulates how the organization aims to proceed in order to Establish a strategic vision [10020]. Solicit critical inputs from senior management and strategy executives, and collaborate with marketing or personnel from allied functions." ;
          ex:hierarchyID "1.2.1" ;
          ex:pcfID "10037" ;
          ex:requiresCapability ex:StrategicPlanningCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation (subClassOf Act of Planning). Senior management/strategy personnel are typical (non-definitional) participants per the source." ;
          rdfs:label "Develop overall mission statement" ;
          skos:definition "An Act of Formulation that defines and communicates an organization's mission and produces a mission statement." ;
          skos:example "An executive team drafts, ratifies, and circulates a one-paragraph corporate mission statement." .


###  http://example.org/apqc#P10038
ex:P10038 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10047
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10048
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21606
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21607
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21608
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21609
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21610
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21611
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21612
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21613
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21614
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicOptionAnalysis
                          ] ;
          ex:apqcSourceText "Assessing sets of strategic decisions designed to drive the organization's long-term objectives. Identify various strategies concerning core functional areas. Appraise strategic options in light of auxiliary decision frameworks that ensure smooth functioning, the advancement of functional efficiencies, and vitality. Involve senior management executives, especially strategy and/or business unit personnel, with need-based consultative assistance from professional services providers." ;
          ex:hierarchyID "1.2.2" ;
          ex:pcfID "10038" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the group's defining act is appraising sets of strategic decisions." ;
          rdfs:label "Define and evaluate strategic options to achieve the mission" ;
          skos:definition "An Act of Appraisal that defines candidate strategic options and evaluates them against the organization's objectives, producing a strategic-option analysis." ;
          skos:example "Strategy leadership enumerates and weighs make-vs-buy, B2B, B2C, partnership, and improvement options before committing to a direction." .


###  http://example.org/apqc#P10039
ex:P10039 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14189
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14197
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16803
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16805
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19950
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19951
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19952
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicOption
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessStrategy
                          ] ;
          ex:apqcSourceText "Developing a strategy for the achievement of business goals over the distant future. Adopt one of the strategic options for realizing its mission over the long term. Enlist senior management executives, comprising strategy and/or business unit personnel." ;
          ex:hierarchyID "1.2.3" ;
          ex:pcfID "10039" ;
          ex:requiresCapability ex:StrategicPlanningCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation (Act of Planning): develops the long-term strategy. The chosen strategic option is the definitional input." ;
          rdfs:label "Set/Develop long-term enterprise strategy" ;
          skos:definition "An Act of Formulation that adopts a strategic option and develops it into a long-term enterprise strategy, producing a business strategy." ;
          skos:example "The executive committee commits to and elaborates a ten-year enterprise strategy." .


###  http://example.org/apqc#P10040
ex:P10040 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessStrategy
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategyAlignmentPlan
                          ] ;
          ex:apqcSourceText "Aligning the approach and method of individual units, departments, systems, and operations within the organization, in accordance with the larger strategic course adopted. Employ the organization's strategic path to guide the functions, divisions, and operations. Calibrate the plan and method of each functional area, as well as the processes therein, to Select the long-term business strategy [10039]." ;
          ex:hierarchyID "1.2.4" ;
          ex:pcfID "10040" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (Act of Planning): aligning unit plans to the enterprise strategy composes a coordinated plan. Output replaced (Gate-F) from the stakeholder-oriented ex:StakeholderAlignmentPlan (which concerns orienting stakeholders around the vision, the subject of 1.1.4.2) with the units/processes-oriented ex:StrategyAlignmentPlan, which matches the source ('aligning the approach and method of individual units, departments, systems, and operations'). The business strategy is the definitional input. Leaf process." ;
          rdfs:label "Coordinate and align cross-functional and process strategies" ;
          skos:definition "An Act of Formulation that calibrates the plans of individual units and processes to the adopted enterprise strategy and produces a strategy alignment plan." ;
          skos:example "A PMO calibrates each division's annual plan to the enterprise strategy and publishes the alignment plan." .


###  http://example.org/apqc#P10041
ex:P10041 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10049
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10050
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10051
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10052
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10053
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10054
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10055
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10056
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalDesign
                          ] ;
          ex:apqcSourceText "Formulating a design for the organization's resources that allow it to meet its objectives. Develop a new framework for molding the organization's various processes into a coherent and seamless whole." ;
          ex:hierarchyID "1.2.5" ;
          ex:pcfID "10041" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (Act of Planning): composes an organizational design." ;
          rdfs:label "Create organizational design" ;
          skos:definition "An Act of Formulation that designs a framework for the organization's resources and processes and produces an organizational design." ;
          skos:example "An org-design team produces a new operating-structure framework aligned to strategy." .


###  http://example.org/apqc#P10042
ex:P10042 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19953
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19954
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19955
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MissionStatement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalObjective
                          ] ;
          ex:apqcSourceText "Developing overall goals for the organization that help in accomplishing its mission. Formulate organization-wide targets in the near to middle term, which will accumulate and propel the organization to realize its long-term objectives, as outlined in Develop an overall mission statement [10037]. Enlist business unit heads or equivalent personnel, in close collaboration with senior management executives." ;
          ex:hierarchyID "1.2.6" ;
          ex:pcfID "10042" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (Act of Planning): composes objectives. The mission statement is the definitional input the objectives must support." ;
          rdfs:label "Develop and set organizational objectives" ;
          skos:definition "An Act of Formulation that develops organization-wide near- to middle-term goals supporting the mission and produces organizational objectives." ;
          skos:example "Leadership sets the firm's annual organization-wide objectives in support of the mission." .


###  http://example.org/apqc#P10043
ex:P10043 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19956
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19957
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19958
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessStrategy
                          ] ;
          ex:apqcSourceText "Charting a strategic course for business units in order to leverage opportunities, sidestep hurdles, and create synergies among each other. Create strategic road maps for the organization's units--in light of their individual resources and requirements, as well as their relationships with other business units--to achieve organizational goals." ;
          ex:hierarchyID "1.2.7" ;
          ex:pcfID "10043" ;
          ex:requiresCapability ex:StrategicPlanningCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation (Act of Planning): composes unit-level strategies." ;
          rdfs:label "Formulate business unit strategies" ;
          skos:definition "An Act of Formulation that charts strategic roadmaps for the organization's business units and produces a business strategy for each unit." ;
          skos:example "Each division head drafts a unit strategy aligned to enterprise goals." .


###  http://example.org/apqc#P10044
ex:P10044 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:InternalCapabilityData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CurrentBusinessAnalysis
                          ] ;
          ex:apqcSourceText "Defining the status quo relating to the de facto core of what the business is. Reflect over the fundamental essence of what the business accomplishes and the manner in which it operates. Look beyond the obvious solution capabilities to delineate capacities that form the basis of the business engine. Involve senior executives and management personnel and possibly professional services providers." ;
          ex:hierarchyID "1.2.1.1" ;
          ex:pcfID "10044" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis: 'reflect over' and 'delineate capacities' is examination of the status quo. Output changed (Gate-F) from the Directive ex:BusinessConcept to the Descriptive ex:CurrentBusinessAnalysis so the output's descriptive kind agrees with the Analysis genus (Golden Principle). ex:BusinessConcept (Directive) is reserved for the formulation acts P10045 'Formulate mission' and P17040 'Define the business concept and long-term vision'." ;
          rdfs:label "Define current business" ;
          skos:definition "An Act of Analysis that examines what the business does and the capacities that underpin it and produces a current-business analysis describing the status quo." ;
          skos:example "A strategy team documents the firm's de-facto business and core capacities before redrafting the mission." .


###  http://example.org/apqc#P10045
ex:P10045 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MissionStatement
                          ] ;
          ex:apqcSourceText "Outlining actionable objectives that effectively set a course to fulfill the organization's vision. In this fundamental activity, articulate certain goals or targets in broad but practicable terms to reach long-term objectives." ;
          ex:hierarchyID "1.2.1.2" ;
          ex:pcfID "10045" ;
          ex:requiresCapability ex:StrategicPlanningCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation: 'outline actionable objectives' composes the mission (a Directive ICE)." ;
          rdfs:label "Formulate mission" ;
          skos:definition "An Act of Formulation that articulates the organization's mission as actionable objectives and produces a mission statement." ;
          skos:example "Executives translate the long-term vision into a concise, actionable mission statement." .


###  http://example.org/apqc#P10046
ex:P10046 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MissionStatement
                          ] ;
          ex:apqcSourceText "Developing and executing a communication strategy to convey the mission statement. Create a universal communication strategy and appropriate delivery channels, with the objective of leveraging the latter to execute the former. Convey the inherent message of the mission to all stakeholders, including employees, customers, and the public. Ensure collaboration between senior strategy personnel and the communications/marketing team." ;
          ex:hierarchyID "1.2.1.3" ;
          ex:pcfID "10046" ;
          ex:requiresRole ex:StakeholderRole ;
          rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): an existing mission statement ICE is transferred from the organization to its stakeholders. The mission statement is the definitional input being conveyed; the Stakeholder participants are the recipients. The ex:CommunicationStrategy output is demoted (Gate-F, Phase-3): a communication strategy is only a TYPICAL vehicle (not every instance produces a fresh strategy), so it is recorded here rather than as an existential has-output." ;
          rdfs:label "Communicate mission" ;
          skos:definition "An Act of Communication that conveys an organization's mission statement to its stakeholders." ;
          skos:example "Leadership rolls out the new mission to employees, customers, and the public across email, town halls, and the website." .


###  http://example.org/apqc#P10047
ex:P10047 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18083
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MissionStatement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicOption
                          ] ;
          ex:apqcSourceText "Defining the various options available to achieve the goals highlighted in the mission statement. Delineate (in accordance with a predefined criteria) the various permutations of strategic decisions that would help the organization achieve the objectives outlined in Develop overall mission statement [10037]. Involve senior management and key strategy personnel, with timely help from professional services providers." ;
          ex:hierarchyID "1.2.2.1" ;
          ex:pcfID "10047" ;
          rdfs:comment "Anchored to ex:ActOfFormulation: defining/delineating options composes prescriptive option specifications. The mission statement is a definitional input." ;
          rdfs:label "Define strategic options" ;
          skos:definition "An Act of Formulation that delineates the candidate strategic options available to achieve the organization's mission and produces a set of strategic options." ;
          skos:example "A strategy team enumerates make-vs-buy and market-entry permutations consistent with the mission." .


###  http://example.org/apqc#P10048
ex:P10048 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P13289
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P13290
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicOption
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicOptionAnalysis
                          ] ;
          ex:apqcSourceText "Scoping and probing to study the impact of strategic options for fulfilling the organization's objectives. Estimate a measure of the impact effectuated by each set of strategic decisions, which comprise Define strategic options [10047]. Closely examine the consequences of each option." ;
          ex:hierarchyID "1.2.2.2" ;
          ex:pcfID "10048" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'estimate a measure of the impact' is an evaluation." ;
          rdfs:label "Assess and analyze impact of each option" ;
          skos:definition "An Act of Appraisal that estimates and examines the impact of each strategic option and produces a strategic-option analysis." ;
          skos:example "Analysts model the projected impact of each candidate strategy on revenue and operations." .


###  http://example.org/apqc#P10049
ex:P10049 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalStructureAssessment
                          ] ;
          ex:apqcSourceText "Evaluating the structural makeup of the organization, including pertinent features of and associated synergies among constituent elements. Examine the organization's architectural framework, paying close attention to the individual elements, the relations among them, and the conjoint and co-acting forces therein. Analyze functions and processes, as well as work-related positions. Scrutinize various relevant characteristics associated with each of them, depending upon the scale, scope, and type of organization." ;
          ex:hierarchyID "1.2.5.1" ;
          ex:pcfID "10049" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation/judgement of structure." ;
          rdfs:label "Evaluate breadth and depth of organizational structure" ;
          skos:definition "An Act of Appraisal that evaluates the structural makeup and synergies of the organization and produces an organizational structure assessment." ;
          skos:example "An org-design analyst assesses the firm's span-of-control and reporting layers." .


###  http://example.org/apqc#P10050
ex:P10050 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalStructureAssessment
                          ] ;
          ex:apqcSourceText "Appraising job-specific roles within the organizational chart and their hierarchical architecture. Analyze a map of work-related roles within the organizational structure. Examine the value added by the positions associated with jobs to be performed and how they stack up within the organization's operations." ;
          ex:hierarchyID "1.2.5.2" ;
          ex:pcfID "10050" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis: 'analyze a map of work-related roles ... examine the value added' is examination producing an understanding." ;
          rdfs:label "Perform job-specific roles mapping and value-added analyses" ;
          skos:definition "An Act of Analysis that maps job-specific roles within the organizational chart and examines the value added by each position, producing an organizational structure assessment." ;
          skos:example "An analyst maps every role to its value contribution across operations." .


###  http://example.org/apqc#P10051
ex:P10051 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RoleActivityDiagram
                          ] ;
          ex:apqcSourceText "Examining the constituent exercises and undertakings within a work-related position for the purpose of effective delegation. Deconstruct job-specific roles into activities and visualize the relations among them, with the objective of assigning responsibilities to the appropriate personnel." ;
          ex:hierarchyID "1.2.5.3" ;
          ex:pcfID "10051" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis: deconstruct roles into activities and visualize their relations." ;
          rdfs:label "Develop role activity diagrams to assess hand-off activity" ;
          skos:definition "An Act of Analysis that deconstructs job-specific roles into their constituent activities and produces a role activity diagram." ;
          skos:example "An analyst breaks a manager role into tasks and charts the hand-offs between them." .


###  http://example.org/apqc#P10052
ex:P10052 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:StrategyPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:OrganizationalDesign
                          ] ;
          ex:apqcSourceText "Organizing workshop sessions to adopt organizational redesign. Communicate the organizational structure and mapping of responsibilities against job roles in order to facilitate an effective understanding among personnel. Use a collaborative process that may include participative workshop sessions." ;
          ex:hierarchyID "1.2.5.4" ;
          ex:pcfID "10052" ;
          ex:requiresRole ex:StrategyPersonnelRole ;
          rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): the workshop transfers the organizational design ICE to personnel. The organizational design is the definitional input; personnel are participants. CHOSEN READING (Gate-F): Communication, because the source's purpose is to 'COMMUNICATE the organizational structure ... to facilitate an effective UNDERSTANDING among personnel' -- conveyance of an existing ICE. Rejected ex:ActOfFormulation (the design already exists; the workshop disseminates rather than composes it) and cco:ont00000234 Act of Training (no skills/values are imparted, only the structure is explained)." ;
          rdfs:label "Perform organization redesign workshops" ;
          skos:definition "An Act of Communication that conveys the proposed organizational design to personnel through participative workshop sessions to build shared understanding." ;
          skos:example "Facilitators run redesign workshops to walk staff through the new structure and role map." .


###  http://example.org/apqc#P10053
ex:P10053 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalDesign
                          ] ;
          ex:apqcSourceText "Fleshing out the connections and dependencies among the various units of the organization. Delineate the relationship among business units or process frameworks within the organization, in terms of activities, synergies, and shared resources and responsibilities. Formalize relationships among business units so that any mutual coherence is clearly understood and can be attended to." ;
          ex:hierarchyID "1.2.5.5" ;
          ex:pcfID "10053" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (Act of Planning): formalizes relationships as part of the organizational design." ;
          rdfs:label "Design the relationships between organizational units" ;
          skos:definition "An Act of Formulation that delineates and formalizes the relationships and dependencies among the organization's units and produces an organizational design of inter-unit relationships." ;
          skos:example "Designers formalize the dependencies and shared resources between two divisions." .


###  http://example.org/apqc#P10054
ex:P10054 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RoleActivityDiagram
                          ] ;
          ex:apqcSourceText "Creating an understanding of the fit between job roles and organizational processes in order to properly place personnel. Deconstruct key processes into constituent activities, and examine job-related roles. Take cues from Develop role activity diagrams to assess hand-off activity [10051]. Map appropriate positions against these important processes, which in turn expedite the deployment of staff members." ;
          ex:hierarchyID "1.2.5.6" ;
          ex:pcfID "10054" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis: deconstruct key processes and examine roles. Takes cues from 1.2.5.3 (PCF 10051) per the source." ;
          rdfs:label "Develop role analysis and activity diagrams for key processes" ;
          skos:definition "An Act of Analysis that deconstructs key processes into activities and examines the fit between job roles and those processes, producing a role activity diagram." ;
          skos:example "An analyst maps roles to each step of the order-to-cash process." .


###  http://example.org/apqc#P10055
ex:P10055 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:OrganizationalDesign
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalStructureAssessment
                          ] ;
          ex:apqcSourceText "Probing the repercussions of all practicable organizational design options. Analyze the significance and impact of workable organizational structure options. Closely examine the long-term impact of these frameworks over the functioning of the organization." ;
          ex:hierarchyID "1.2.5.7" ;
          ex:pcfID "10055" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation of options. The organizational design options are the definitional input." ;
          rdfs:label "Assess organizational implication of feasible alternatives" ;
          skos:definition "An Act of Appraisal that evaluates the long-term repercussions of each feasible organizational design option and produces an organizational structure assessment." ;
          skos:example "An analyst weighs the multi-year impact of three candidate structures." .


###  http://example.org/apqc#P10056
ex:P10056 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:OrganizationalDesign
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OrganizationalStructureAdoptionDecision
                          ] ;
          ex:apqcSourceText "Embracing and ratifying a new organizational structure. (Assume the new framework to be the best fit through Assess the organizational implications of feasible alternatives [10055].)" ;
          ex:hierarchyID "1.2.5.8" ;
          ex:pcfID "10056" ;
          rdfs:comment "Output replaced (Gate-F) from the subject-mismatched ex:InitiativeSelectionDecision (which prescribes which strategic INITIATIVES to pursue) with the subject-matched Directive ex:OrganizationalStructureAdoptionDecision, parallel to ex:BusinessModelAdoptionDecision. CHOSEN READING (reconciled with sibling-in-kind P20949 'Adopt the business model'): anchored to cco:ont00000228 (Planned Act). Both leaves RATIFY a single best-fit option already settled by a prior assessment (here P10055), which is a commitment/ratification, not a choice among a candidate set -- so ex:ActOfSelection (definitionally 'chooses from a SET of candidates') does not fit. No narrower CCO act denotes ratification, so it anchors at the generic Planned Act. The organizational design is the definitional input; the ratification decision is the output." ;
          rdfs:label "Migrate to new organization" ;
          skos:definition "A Planned Act that ratifies the best-fit organizational design already determined among the assessed alternatives and produces an organizational-structure adoption decision adopting the new structure." ;
          skos:example "Leadership formally ratifies the new operating structure and authorizes the move to it." .


###  http://example.org/apqc#P10057
ex:P10057 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19975
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19976
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19977
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicInitiativeSpecification
                          ] ;
          ex:apqcSourceText "Developing strategic projects that help fulfill long-term goals. Develop time-bound projects that are discretionary in nature and lie beyond the scope of the organization's routine operations." ;
          ex:hierarchyID "1.3.1" ;
          ex:pcfID "10057" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (under cco:ont00000511 Act of Planning): developing initiatives produces a Directive ICE (the specification). Children are process parts." ;
          rdfs:label "Develop strategic initiatives" ;
          skos:definition "An Act of Formulation that composes discretionary, time-bound strategic projects supporting long-term goals and produces a strategic-initiative specification." ;
          skos:example "A strategy team drafts a slate of discretionary projects to advance the firm's ten-year goals." .


###  http://example.org/apqc#P10058
ex:P10058 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19978
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19979
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicInitiativeSpecification
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicInitiativeEvaluation
                          ] ;
          ex:apqcSourceText "Examining projects of strategic significance that lie outside the purview of the organization's routine operations. Closely analyze strategic initiatives for their applicability and feasibility, given the organization's vision." ;
          ex:hierarchyID "1.3.2" ;
          ex:pcfID "10058" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the act judges applicability and feasibility. Children are process parts." ;
          rdfs:label "Evaluate strategic initiatives" ;
          skos:definition "An Act of Appraisal that examines strategic initiatives for applicability and feasibility against the organization's vision and produces a strategic-initiative evaluation." ;
          skos:example "A review board appraises each candidate initiative for fit with the firm's vision and constraints." .


###  http://example.org/apqc#P10059
ex:P10059 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SeniorManagement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19980
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19981
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicInitiativeEvaluation
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InitiativeSelectionDecision
                          ] ;
          ex:apqcSourceText "Selecting relevant projects of strategic significance that create opportunities for the organization to realize its long-term objectives, on the basis of their suitability to the organization's constraints and reality. Select from the process Evaluate strategic initiatives [10058], based on their applicability and feasibility for the organization. Enlist senior management, especially strategy personnel." ;
          ex:hierarchyID "1.3.3" ;
          ex:pcfID "10059" ;
          ex:requiresRole ex:SeniorManagerRole ;
          rdfs:comment "Anchored to ex:ActOfSelection (under cco:ont00000366 Act of Information Processing). Senior management participant is definitional (the source enlists them). Children are process parts." ;
          rdfs:label "Select strategic initiatives" ;
          skos:definition "An Act of Selection that chooses strategic initiatives from the evaluated set on the basis of suitability to the organization's constraints and produces an initiative selection decision." ;
          skos:example "Senior managers and strategists pick the initiatives the firm will fund this cycle." .


###  http://example.org/apqc#P10060
ex:P10060 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19982
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19983
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19984
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceMetric
                          ] ;
          ex:apqcSourceText "Devising measures to examine strategic projects. Formulate evaluation criteria to assess the strategic initiatives for the level of impact." ;
          ex:hierarchyID "1.3.4" ;
          ex:pcfID "10060" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (under cco:ont00000511): devising measures produces a Directive ICE (the metrics). Children are process parts." ;
          rdfs:label "Establish high-level measures" ;
          skos:definition "An Act of Formulation that devises evaluation criteria for assessing the impact of strategic initiatives and produces a set of performance metrics." ;
          skos:example "A team defines the high-level KPIs by which the initiatives' impact will be judged." .


###  http://example.org/apqc#P10062
ex:P10062 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDevelopment ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductServiceOffering
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19993
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19996
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19997
                          ] ;
          ex:apqcSourceText "Developing new products/services from scratch, including all activities associated with the design, prototyping, evaluation, and market testing of these planned offerings." ;
          ex:hierarchyID "2.3" ;
          ex:pcfID "10062" ;
          rdfs:comment "APQC Process Group 2.3 modeled as an occurrent. Its APQC children are process parts, not subclasses. The parent Category 2.0 is catalog-only (R3) and has no has-process-part to this group. The developed product/service offering (ex:ProductServiceOffering, anchored at BFO Entity, not an ICE) is the thing realized by the act, so it is its has-participant, not its informational has-output: section 2.0 is a develop/plan category whose informational outputs (per D3) are ICEs, and ex:ProductServiceOffering is produced through the design/prototype/build parts below rather than emitted as a single definitional output of the group." ;
          rdfs:label "Develop products and services" ;
          skos:definition "An Act of Development that creates new products or services from concept through design, prototyping, market testing, and preparation for production." ;
          skos:example "A firm's end-to-end new-product development programme from idea to production launch." .


###  http://example.org/apqc#P10063
ex:P10063 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketOpportunityData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductServicePerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductServicePerformanceEvaluation
                          ] ;
          ex:apqcSourceText "Assessing the capabilities and performance of existing products/services, in light of market opportunities. Examine performance of the existing line of products/services, including measures of profitability, penetration, and value delivered. Identify gaps between existing solutions' portfolio or their performance levels, on the one hand, and the current market demand, available technologies, and/or customer expectations, on the other. Consider opportunities in the present market environment and any relation with the performance. Consider input from professional services providers." ;
          ex:hierarchyID "2.1.1.1" ;
          ex:pcfID "10063" ;
          ex:requiresCapability ex:ProductServicePortfolioManagementCapability ;
          rdfs:comment "Genus is appraisal (judging capabilities/performance); output is a Descriptive ICE per the GOLDEN PRINCIPLE." ;
          rdfs:label "Evaluate performance of existing products/services against market opportunities" ;
          skos:definition "An Act of Appraisal that has as input product/service performance data and market opportunity data and has as output a product/service performance evaluation that identifies gaps against market expectations." ;
          skos:example "A product team appraises current offerings on profitability and penetration and issues a performance evaluation flagging portfolio gaps." .


###  http://example.org/apqc#P10065
ex:P10065 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10070
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10071
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10072
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:TechnologyData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:TechnicalAssessment
                          ] ;
          ex:apqcSourceText "Coordinating R&D activity to identify new technologies to integrate into the revamped portfolio of products/services. Conduct early-stage R&D activity to close gaps between existing solution offerings and changing market expectations. Triangulate appropriate technologies that can support the development of a revised product/service portfolio." ;
          ex:hierarchyID "2.2.1" ;
          ex:pcfID "10065" ;
          rdfs:comment "Coordinates R&D to triangulate technologies; an information-processing act producing a descriptive technical assessment." ;
          rdfs:label "Perform discovery research" ;
          skos:definition "An Act of Analysis that conducts early-stage research and development on emerging technologies and produces a technical assessment of technologies able to support a revised product/service portfolio." ;
          skos:example "A research division runs an exploratory technology scan and reports which emerging technologies can close gaps in the current portfolio." .


###  http://example.org/apqc#P10066
ex:P10066 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SeniorManagement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessStrategy
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductServiceConcept
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicAlignmentAssessment
                          ] ;
          ex:apqcSourceText "Checking the alignment of product/service portfolio, and its individual offerings, with the organization's overall strategy and planning for the development of new or revised solutions. Conduct reality checks on new product/service concepts prior to committing significant investment to ensure that the revamped solutions' portfolio is in line with the overall business strategy, aligns organizational processes for their development, and creates a plan for assimilating these changes in the organization's offerings. Enlist senior management executives." ;
          ex:hierarchyID "2.1.1.2" ;
          ex:pcfID "10066" ;
          ex:requiresRole ex:SeniorManagementRole ;
          rdfs:comment "Reality-check appraisal; descriptive output (the alignment judgement). Senior-management participation is definitional per the source ('Enlist senior management executives'). Gate-F: the output filler was changed from ex:FeasibilityAssessment to the dedicated ex:StrategicAlignmentAssessment, because the act judges STRATEGIC ALIGNMENT ('Checking the alignment ... with the organization's overall strategy'), not practicability/feasibility -- an inclusiveness/exclusiveness fix. The source's directive sub-output ('creates a plan for assimilating these changes') is recorded here at comment level only, not modeled as a restriction." ;
          rdfs:label "Confirm alignment of product/service concepts with business strategy" ;
          skos:definition "An Act of Appraisal that has as input product/service concepts and a business strategy and has as output a strategic alignment assessment of the concepts, with senior management as participant." ;
          skos:example "Senior executives reality-check a new concept against the business strategy and confirm its alignment before funding." .


###  http://example.org/apqc#P10068
ex:P10068 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketOpportunityData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductServiceModificationPlan
                          ] ;
          ex:apqcSourceText "Defining potential enhancements to current products/services in order to take advantage of a shift in market expectations. Identify how the existing line of products/services may be revised--through enhancements to individual solutions or across-the-board renovations--in order to capitalize on present opportunities in the market." ;
          ex:hierarchyID "2.2.2.5" ;
          ex:pcfID "10068" ;
          rdfs:comment "Although phrased as 'Identify', the definitional output is a prescriptive modification plan (Directive ICE), so the act is a formulation, not an Act of Identification (GOLDEN PRINCIPLE)." ;
          rdfs:label "Identify potential improvements to existing products and services" ;
          skos:definition "An Act of Formulation that defines potential enhancements to current products or services and produces a product/service modification plan to capitalize on shifts in market expectations." ;
          skos:example "A product manager defines a set of enhancements to an existing service line to match new market expectations." .


###  http://example.org/apqc#P10070
ex:P10070 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ResearchAndDevelopmentPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:TechnologyData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:TechnicalAssessment
                          ] ;
          ex:apqcSourceText "Determining new technologies to revise the portfolio of solution offerings. Identify recently developed technological advances that can be leveraged in the development or advancement of the organization's product/service portfolio. Enlist senior management in conjunction with personnel responsible for the design, processing, and delivery of products/services. Have the organization's research division(s) carry out the process." ;
          ex:hierarchyID "2.2.1.1" ;
          ex:pcfID "10070" ;
          ex:requiresCapability ex:ResearchAndDevelopmentCapability ;
          ex:requiresRole ex:ResearchAndDevelopmentRole ;
          rdfs:comment "Discernment sense (information processing), not cco:ont00001261. R&D personnel are definitional participants ('research division(s) carry out the process'); senior management is typical." ;
          rdfs:label "Identify new technologies" ;
          skos:definition "An Act of Identification that discerns recently developed technological advances leverageable for the product/service portfolio and produces a technical assessment registering them." ;
          skos:example "A research division registers a shortlist of emerging technologies relevant to the next portfolio refresh." .


###  http://example.org/apqc#P10071
ex:P10071 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDevelopment ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ResearchAndDevelopmentPersonnel
                          ] ;
          ex:apqcSourceText "Developing new technologies from scratch to integrate into a revised portfolio of solutions. Develop new technological processes, models, and/or implements in-house, with the objective of improving existing solutions or creating new ones. Consider market realities, as well as the portfolio of products/services. Assess the results in conjunction with senior executives and personnel responsible for the design, processing, and delivery of these solutions. Engage the R&D function, and consider external sources such as offshore providers, specialized research agencies, and crowdsourcing communities." ;
          ex:hierarchyID "2.2.1.2" ;
          ex:pcfID "10071" ;
          ex:requiresCapability ex:ResearchAndDevelopmentCapability ;
          ex:requiresRole ex:ResearchAndDevelopmentRole ;
          rdfs:comment "Builds a new technology from scratch; a Planned Act of creation, distinct from analysing or appraising existing technology. R&D personnel are participants." ;
          rdfs:label "Develop new technologies" ;
          skos:definition "An Act of Development that builds new technological processes, models, or implements in-house in order to improve existing solutions or create new ones." ;
          skos:example "An R&D group engineers a novel manufacturing process to enable a new product line." .


###  http://example.org/apqc#P10072
ex:P10072 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SeniorManagement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:TechnologyData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FeasibilityAssessment
                          ] ;
          ex:apqcSourceText "Appraising the feasibility of integrating new technologies, whether developed as a custom solution or adopted from an external source, into revised portfolio of solution offerings. Examine recently developed technological advances for suitability to incorporate them into the concept of revised and/or new solution offerings. Enlist senior management, in consultation with in-house personnel responsible for the design, processing, and delivery of these solutions, as well as key supply-chain stakeholders." ;
          ex:hierarchyID "2.2.1.3" ;
          ex:pcfID "10072" ;
          ex:requiresCapability ex:ResearchAndDevelopmentCapability ;
          ex:requiresRole ex:SeniorManagementRole ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it evaluates/judges integration feasibility. Senior management is a definitional participant; supply-chain partners are typical." ;
          rdfs:label "Assess feasibility of integrating new leading technologies into product/service concepts" ;
          skos:definition "An Act of Appraisal that judges the suitability of integrating new technologies into revised or new product/service concepts and produces a feasibility assessment." ;
          skos:example "An evaluation panel appraises whether a custom sensor technology can be integrated into the next product generation and reports its feasibility." .


###  http://example.org/apqc#P10073
ex:P10073 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SeniorManagement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CostTarget
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityTarget
                          ] ;
          ex:apqcSourceText "Setting prerequisites for the cost of development and quality standards for the new solutions' portfolio and/or its individual offerings. Set targets for the budget and quality standards for the revamped portfolio of solution offerings. Prepare a plan for the outlay required for revising and adding new product/services. Identify intended levels of quality for these, bearing in mind the existing standards of solutions offered by the organization and its competitors. Enlist senior management executives, particularly those responsible for finance and budgeting, product/service design, manufacturing/processing, delivery, and quality control." ;
          ex:hierarchyID "2.1.1.4" ;
          ex:pcfID "10073" ;
          ex:requiresRole ex:SeniorManagementRole ;
          rdfs:comment "Genus is formulation/planning; outputs are Directive ICEs (cost and quality targets) per the GOLDEN PRINCIPLE. Senior-management participation is definitional ('Enlist senior management executives')." ;
          rdfs:label "Plan and develop cost and quality targets" ;
          skos:definition "An Act of Formulation that has as output a cost target and a quality target prescribing the budget and quality prerequisites for the revised portfolio, with senior management as participant." ;
          skos:example "Finance and quality leaders set budget and quality targets for the revamped solution portfolio." .


###  http://example.org/apqc#P10074
ex:P10074 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductServiceConcept
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductServicePriorityList
                          ] ;
          ex:apqcSourceText "Selecting from among the potential new/revised solutions and capitalizing on market opportunities so that they meet the cost and quality prerequisites. Create an index of product/service concepts, and arrange them in order of preference. Base prioritization on adherence to Plan and develop cost and quality targets [10073], and choose options that would comprise the revised solution portfolio." ;
          ex:hierarchyID "2.1.1.3" ;
          ex:pcfID "10074" ;
          ex:requiresCapability ex:ProductServicePortfolioManagementCapability ;
          rdfs:comment "Genus is selection (choosing from a candidate set); output is a Directive ICE (the priority list) per the GOLDEN PRINCIPLE." ;
          rdfs:label "Prioritize and select new product/service concepts" ;
          skos:definition "An Act of Selection that has as input product/service concepts and has as output a product/service priority list prescribing the chosen concepts for the revised portfolio." ;
          skos:example "A portfolio board ranks candidate concepts and selects those meeting cost/quality targets for the revised portfolio." .


###  http://example.org/apqc#P10075
ex:P10075 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DevelopmentSchedule
                          ] ;
          ex:apqcSourceText "Determining the individual and collective timeframe for realizing new/revised solutions. Create a schedule that clearly demarcates the timeframes designated for the development of every new solution and/or revising each of the existing ones. Create a timetable by setting deadlines for each step in overhauling the product/service portfolio." ;
          ex:hierarchyID "2.1.1.5" ;
          ex:pcfID "10075" ;
          rdfs:comment "Genus is formulation; output is a Directive ICE (the schedule) per the GOLDEN PRINCIPLE." ;
          rdfs:label "Specify development timing targets" ;
          skos:definition "An Act of Formulation that has as output a development schedule prescribing the timeframes and deadlines for developing and revising the portfolio's solutions." ;
          skos:example "A program manager sets deadlines for each development step and issues the portfolio overhaul schedule." .


###  http://example.org/apqc#P10076
ex:P10076 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductServiceModificationPlan
                          ] ;
          ex:apqcSourceText "Developing a programmatic procedure for changing products/services while paying heed to all stakeholders involved and the prerequisites identified. Create a plan for changing the existing portfolio of solution offerings. Develop a systematic program for the design, processing, and delivery of the new product/service concepts. Construct project-flow diagrams. Identify the stakeholders involved and personnel responsible for each stage, as well as the necessary decisions. Earmark the budgetary outlay, and conduct any strategic planning required." ;
          ex:hierarchyID "2.1.1.6" ;
          ex:pcfID "10076" ;
          rdfs:comment "Genus is formulation; output is a Directive ICE (the modification plan) per the GOLDEN PRINCIPLE." ;
          rdfs:label "Plan for product/service offering modifications" ;
          skos:definition "An Act of Formulation that has as output a product/service modification plan prescribing a programmatic procedure for changing the portfolio of offerings." ;
          skos:example "A team builds a project-flow plan assigning stages, owners, and budget for modifying the offering portfolio." .


###  http://example.org/apqc#P10077
ex:P10077 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ;
          ex:apqcSourceText "Launching revamped product/service portfolio in to the market. Introduction in to the marketplace is done by deploying effective channels for marketing, sales, delivery, and after-sales servicing. Introduce new/revised solution offerings in a concerted effort. Coordinate a cross-functional effort." ;
          ex:hierarchyID "2.1.2.2" ;
          ex:pcfID "10077" ;
          ex:requiresCapability ex:ProductServiceLifecycleManagementCapability ;
          rdfs:comment "Operations launch occurrent (category 2.0 permits material participants). No definitional informational output; the offering deployed is ex:ProductServiceOffering (a participant, comment-level here since not every instance manifests a single material filler)." ;
          rdfs:label "Introduce new products/services" ;
          skos:definition "A Planned Act in which an Organization deploys a new or revised product/service offering into the market through marketing, sales, delivery, and after-sales channels." ;
          skos:example "A cross-functional team launches a revamped product line across marketing and distribution channels." .


###  http://example.org/apqc#P10078
ex:P10078 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ;
          ex:apqcSourceText "Removing nonconforming products and services. Withdraw those products/services that do not conform to market realities and are not positioned to take advantage of prevailing opportunities. Coordinate with processing/delivery teams within the organization and key stakeholders in the supply chain. Create mechanisms for continued after-sales servicing, as well as deploy effective public relations efforts in order to preserve the image and goodwill of the organization through the process." ;
          ex:hierarchyID "2.1.2.3" ;
          ex:pcfID "10078" ;
          ex:requiresCapability ex:ProductServiceLifecycleManagementCapability ;
          rdfs:comment "Operations withdrawal occurrent. Supply-chain-partner coordination is typical (comment-level), not definitional." ;
          rdfs:label "Retire outdated products/services" ;
          skos:definition "A Planned Act in which an Organization withdraws a nonconforming product/service offering from the market while sustaining after-sales servicing and goodwill." ;
          skos:example "A firm retires an obsolete product line and stands up continued spares support." .


###  http://example.org/apqc#P10079
ex:P10079 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceIndicatorSpecification
                          ] ;
          ex:apqcSourceText "Attuning the performance measures of products/services to better reflect the revamped portfolio of solution offerings. Revise the parameters used to measure performance, apropos the organization's product/service offerings. (Modify these standards in consideration of the changes made to the portfolio by Introduce new products/services [10077] and Retire outdated products/services [10078].)" ;
          ex:hierarchyID "2.1.2.4" ;
          ex:pcfID "10079" ;
          rdfs:comment "Genus is formulation; output is a Directive ICE (the indicator specification) per the GOLDEN PRINCIPLE." ;
          rdfs:label "Identify and refine performance indicators" ;
          skos:definition "An Act of Formulation that has as output a performance indicator specification prescribing the revised parameters for measuring product/service performance." ;
          skos:example "An analytics team revises product KPIs to reflect the new portfolio." .


###  http://example.org/apqc#P10083
ex:P10083 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19994
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ResourceAllocationPlan
                          ] ;
          ex:apqcSourceText "Allocating resources to the design, development, and evaluation of product/service concepts. Allocate funds, personnel, and time for developing the new and/or revised products/services. Begin to design the potential new product/service concepts that have been prioritized and selected for further development." ;
          ex:hierarchyID "2.3.1.1" ;
          ex:pcfID "10083" ;
          rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): the act produces a prescriptive allocation (Directive ICE)." ;
          rdfs:label "Assign resources to product/service project" ;
          skos:definition "An Act of Planning that allocates funds, personnel, and time to a product or service development project and produces a resource allocation plan." ;
          skos:example "A programme manager assigns budget and engineers to a prioritized concept." .


###  http://example.org/apqc#P10084
ex:P10084 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessCase
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:TechnicalAssessment
                          ] ;
          ex:apqcSourceText "Preparing a business-level business case and a technical feasibility assessment in order to move the product/service projects forward. Weigh the costs and benefits of designing, developing, and evaluating the shortlisted product/service concepts. Prepare a business case to justify the product/service projects. Conduct a technical appraisal to ensure that the organization has the technical know-how and resources to further develop these concepts." ;
          ex:hierarchyID "2.3.1.2" ;
          ex:pcfID "10084" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): both outputs are descriptive judgements." ;
          rdfs:label "Prepare high-level business case and technical assessment" ;
          skos:definition "An Act of Appraisal that weighs the costs and benefits and technical feasibility of shortlisted concepts and produces a business case and a technical assessment." ;
          skos:example "A team prepares a cost-benefit business case and a technical-feasibility appraisal for two concepts." .


###  http://example.org/apqc#P10085
ex:P10085 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDesign ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:DesignStaff
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DesignSpecification
                          ] ;
          ex:apqcSourceText "Creating design specifications. Create specifications for the design of new or revised product/service concepts as a measure to meet during development. Have the senior functional-level solutioning or design staff create a framework of compliance standards for these products/services." ;
          ex:hierarchyID "2.3.1.3" ;
          ex:pcfID "10085" ;
          ex:requiresRole ex:DesignStaffRole ;
          rdfs:comment "Genus ex:ActOfDesign (output is a Directive ICE). Senior/design staff participate." ;
          rdfs:label "Develop product/service design specifications" ;
          skos:definition "An Act of Design that creates design specifications for new or revised product or service concepts as a standard to meet during development." ;
          skos:example "Design staff draft a compliance-standard framework for a new product." .


###  http://example.org/apqc#P10086
ex:P10086 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDataManagement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductServiceRequirementSpecification
                          ] ;
          ex:apqcSourceText "Documenting requirements to meet in the design of new or revised products/services. Specify technical, quality, and costing requirements, as well as ergonomic, safety, and servicing requirements for such products/services. Ensure the information presented can be understood by the personnel executing the design and includes examples, anecdotal references, and illustrations." ;
          ex:hierarchyID "2.3.1.6" ;
          ex:pcfID "10086" ;
          rdfs:comment "Genus ex:ActOfDataManagement: the act records/organizes requirement ICEs. Output is a Directive requirement specification." ;
          rdfs:label "Document design specifications" ;
          skos:definition "An Act of Data Management that records and structures the technical, quality, cost, ergonomic, safety, and servicing requirements to be met in the design of a product or service, producing a documented requirement specification." ;
          skos:example "An engineer compiles an illustrated requirements document for the design team." .


###  http://example.org/apqc#P10087
ex:P10087 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:RegulatoryAuthority
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DesignSpecification
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ExternalReviewReport
                          ] ;
          ex:apqcSourceText "Conducting any mandatory and elective appraisals of the product/service design specifications in order to ensure compliance with external standards. Carry out external reviews of specifications created for the development of new product/service designs. Conduct mandatory appraisals such as legal and regulatory, as well as any optional assessments that, for instance, pitch the specifications against industrial benchmarks." ;
          ex:hierarchyID "2.3.1.7" ;
          ex:pcfID "10087" ;
          ex:requiresRole ex:RegulatoryAuthorityRole ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal). Input is the design specification; a regulatory authority participates in mandatory reviews." ;
          rdfs:label "Conduct mandatory and elective external reviews" ;
          skos:definition "An Act of Appraisal that reviews a product or service design specification against external legal, regulatory, and industrial standards and produces an external review report." ;
          skos:example "A regulator reviews a medical-device spec for legal compliance." .


###  http://example.org/apqc#P10088
ex:P10088 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDevelopment ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:DesignStaff
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductServicePrototype
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DesignSpecification
                          ] ;
          ex:apqcSourceText "Building prototypes for shortlisted product/service concepts. Develop prototypes for those product/service concepts that have been identified for further development. Provide proof-of-concepts, and test any processes involved. Build prototypes in line with the design specifications already outlined. Enlist the solutioning and/or design staff." ;
          ex:hierarchyID "2.3.1.9" ;
          ex:pcfID "10088" ;
          ex:requiresRole ex:DesignStaffRole ;
          rdfs:comment "The prototype is a cco:Material Artifact (ex:ProductServicePrototype); in this develop/plan category (2.0) the built material is the act's has-participant rather than an informational has-output (D3: informational outputs are ICEs). Design staff participate." ;
          rdfs:label "Build prototypes/proof of concepts" ;
          skos:definition "An Act of Development that builds a product or service prototype in line with the design specification, taking the design specification as input and yielding a built prototype as its material participant." ;
          skos:example "Design staff build a working proof-of-concept from the approved spec." .


###  http://example.org/apqc#P10089
ex:P10089 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDevelopment ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductServicePrototype
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:QualityTarget
                          ] ;
          ex:apqcSourceText "Eliminating any problems relating to utility of the product/service over the course of its expected lifetime. Tweak the prototype in order to comply with the required quality and reliability standards. Further refine the prototype, so it may be subjected to testing." ;
          ex:hierarchyID "2.3.1.11" ;
          ex:pcfID "10089" ;
          rdfs:comment "The refined prototype (ex:ProductServicePrototype, a Material Artifact) is the act's has-participant rather than an informational has-output: section 2.0 is a develop/plan category whose informational outputs (D3) are ICEs. Quality targets are definitional input." ;
          rdfs:label "Eliminate quality and reliability problems" ;
          skos:definition "An Act of Development that refines a product or service prototype to comply with required quality and reliability standards, taking quality and reliability targets as input and acting on the prototype as its material participant." ;
          skos:example "Engineers tweak a prototype until it meets reliability targets." .


###  http://example.org/apqc#P10090
ex:P10090 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfVerification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductServicePrototype
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FeasibilityAssessment
                          ] ;
          ex:apqcSourceText "Carrying out an in-house appraisal of the prototypes in order to validate design and feasibility. Test the product/service prototypes to confirm their compliance with design and usability standards. Corroborate the viability of the design, and validate the feasibility of their production. Identify any areas for improvement." ;
          ex:hierarchyID "2.3.1.12" ;
          ex:pcfID "10090" ;
          rdfs:comment "Genus ex:ActOfVerification (under Act of Appraisal): checks the prototype against standards, yielding a descriptive feasibility judgement. The prototype under test (ex:ProductServicePrototype, a Material Artifact) is the material participant of the verification, not an informational has-input (D3: informational I/O in this develop/plan category are ICEs)." ;
          rdfs:label "Conduct in-house product/service testing and evaluate feasibility" ;
          skos:definition "An Act of Verification that tests product or service prototypes against design and usability standards and produces a feasibility assessment." ;
          skos:example "A QA team validates a prototype's design and production feasibility in-house." .


###  http://example.org/apqc#P10091
ex:P10091 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceIndicatorSpecification
                          ] ;
          ex:apqcSourceText "Identifying performance parameters. Determine the parameters to measure performance of the design and development of the product/service concepts into prototypes." ;
          ex:hierarchyID "2.3.1.13" ;
          ex:pcfID "10091" ;
          rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): defining indicators to measure against is a prescriptive specification (Directive ICE). GOLDEN PRINCIPLE: 'identify parameters to measure' here sets directive targets, not a descriptive finding." ;
          rdfs:label "Identify design/development performance indicators" ;
          skos:definition "An Act of Planning that determines the parameters for measuring design and development performance and produces a performance indicator specification." ;
          skos:example "A team defines the KPIs that will gate the prototype phase." .


###  http://example.org/apqc#P10092
ex:P10092 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfVerification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SupplyChainPartner
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DesignSpecification
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FeasibilityAssessment
                          ] ;
          ex:apqcSourceText "Interacting with suppliers and manufactures to determine design decisions. Collaborate with vendors, suppliers, contractors, and subcontractors to verify feasibility of co-producing the prototype's design. Ensure that efforts can be coordinated with other stakeholders in the organization's supply chain ecosystem at the time of manufacturing, producing, or packaging the finished product/service." ;
          ex:hierarchyID "2.3.1.14" ;
          ex:pcfID "10092" ;
          ex:requiresRole ex:SupplyChainPartnerRole ;
          rdfs:comment "Genus ex:ActOfVerification: the text says 'verify feasibility'. Supply-chain partners participate via has participant." ;
          rdfs:label "Collaborate on design with suppliers and external partners" ;
          skos:definition "An Act of Verification that, with suppliers and external partners, checks the feasibility of co-producing the prototype's design and produces a feasibility assessment." ;
          skos:example "Engineers and a contract manufacturer confirm a design can be co-produced." .


###  http://example.org/apqc#P10093
ex:P10093 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketStudy
                          ] ;
          ex:apqcSourceText "Composing a detailed study of the market ecosystem in light of new products/services. Conduct a detailed analysis of the targeted market(s) in order to Introduce new products/services [10077]. Examine the competition, market size and growth rate, market trends, customer segments and their characteristics, market influencers, distribution channels, and profitability. Enlist in-house marketing and/or solutioning teams, or outsource to specialized professional services agencies." ;
          ex:hierarchyID "2.3.2.1" ;
          ex:pcfID "10093" ;
          rdfs:comment "Output ex:MarketStudy carries is-about ex:Market in the shared vocab. Input is market data." ;
          rdfs:label "Prepare detailed market study" ;
          skos:definition "An Act of Analysis that examines the targeted market and produces a detailed market study about the market." ;
          skos:example "A marketing team studies market size, trends, and segments for a new product." .


###  http://example.org/apqc#P10094
ex:P10094 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Customer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerTestReport
                          ] ;
          ex:apqcSourceText "Conducting both qualitative and quantitative studies to determine the fit between the newly developed products/services and the customers. Conduct external tests of the new product/service, and then refine them to maximize the customer uptake. Gather feedback from prospective customers and targeted populations by conducting surveys, focus groups, interviews, and detailed studies. Enlist professional services such as public relations or market research organizations." ;
          ex:hierarchyID "2.3.2.2" ;
          ex:pcfID "10094" ;
          ex:requiresRole ex:CustomerRole ;
          rdfs:comment "Customers participate (has participant). The report is descriptive and about the offering." ;
          rdfs:label "Conduct customer tests and interviews" ;
          skos:definition "An Act of Analysis that conducts qualitative and quantitative customer tests and interviews of a new product or service and produces a customer test report capturing customer feedback." ;
          skos:example "A team runs surveys and focus groups and reports prospective-customer feedback." .


###  http://example.org/apqc#P10095
ex:P10095 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerFeedback
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductServiceCharacteristicsSpecification
                          ] ;
          ex:apqcSourceText "Finalizing the characteristics of new products/services by appropriately weighing feedback from prospective customers against a cost-benefit analysis in order to produce a profitable business proposition. Refine the attributes of the newly developed products/services, in light of the feedback and insights collected during Conduct customer tests and interviews [10094]. Revisit the high-level business case to justify the resources assigned to the product/service project against the anticipated benefits." ;
          ex:hierarchyID "2.3.2.3" ;
          ex:pcfID "10095" ;
          rdfs:comment "Genus ex:ActOfFormulation (under Act of Planning): composes a Directive characteristics specification (the genuine defining output). Customer feedback is definitional input. Gate-F: the existential has-output to ex:BusinessCase (Descriptive) was DROPPED. The business case is sourced from 'Revisit the high-level business case' -- a revisit of an artifact produced earlier at 2.3.1.2, i.e. typical/intermediate, not necessary for every instance; promoting a Descriptive co-output to owl:someValuesFrom on a directive-aligned Formulation act both over-committed per the Phase-3 existential-necessity rule and created GOLDEN-PRINCIPLE tension. The revisited business case is recorded here at comment level / as a CQ target only." ;
          rdfs:label "Finalize product/service characteristics and business cases" ;
          skos:definition "An Act of Formulation that finalizes the characteristics of a new product or service by weighing customer feedback against a cost-benefit analysis, producing a product/service characteristics specification." ;
          skos:example "A team locks down the feature set and revises the business case after testing." .


###  http://example.org/apqc#P10096
ex:P10096 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductServiceCharacteristicsSpecification
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:TechnicalAssessment
                          ] ;
          ex:apqcSourceText "Reassessing the technical requirements in light of the final product/service attributes. Revisit the technical assessment to revalidate the organization's capacity for progressing with new product/service projects, in light of the revised product/service characteristics." ;
          ex:hierarchyID "2.3.2.4" ;
          ex:pcfID "10096" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): re-evaluates technical capacity, a descriptive judgement. Input is the characteristics specification." ;
          rdfs:label "Finalize technical requirements" ;
          skos:definition "An Act of Appraisal that reassesses technical requirements in light of the finalized product or service characteristics and produces a revised technical assessment." ;
          skos:example "Engineering revalidates technical feasibility after the feature set is locked." .


###  http://example.org/apqc#P10097
ex:P10097 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductServiceModificationPlan
                          ] ;
          ex:apqcSourceText "Identifying any changes that need to be effectuated in the organization's internal processes for manufacturing, and delivering the newly developed products/services. Determine if any changes need to be made to the production and distribution processes, in light of the new products/services. Begin production process planning. Prepare for factory layout planning. Generate shop-floor instructions and changes to the supply chain." ;
          ex:hierarchyID "2.3.3.2" ;
          ex:pcfID "10097" ;
          rdfs:comment "Gate-F re-anchor: from ex:ActOfIdentification to ex:ActOfFormulation. Although phrased as 'Identify', the definitional output is a prescriptive modification plan (Directive ICE, shop-floor and supply-chain changes), so the act composes a directive and is a formulation, not an Act of Identification (GOLDEN PRINCIPLE override of the surface verb). Mirrors the parallel row ex:P10068 (2.2.2.5), which has the identical Identify+ProductServiceModificationPlan shape and was likewise anchored at ex:ActOfFormulation." ;
          rdfs:label "Identify requirements for changes to manufacturing/delivery processes" ;
          skos:definition "An Act of Formulation that determines the changes required in manufacturing and delivery processes for a new product or service and produces a product/service modification plan." ;
          skos:example "Industrial engineers determine the line and supply-chain changes a new SKU requires." .


###  http://example.org/apqc#P10098
ex:P10098 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDevelopment ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductServicePrototype
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionDeliveryProcessDesign
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PrototypeTestResult
                          ] ;
          ex:apqcSourceText "Creating the new manufacturing/delivery processes for the new products/services, and testing them to ensure proper functioning. Create the production/delivery process for the prototypes that have been built for the new products/services. Conduct trial-runs to test these processes and their integration with the organization's other processes." ;
          ex:hierarchyID "2.3.1.10" ;
          ex:pcfID "10098" ;
          rdfs:comment "Output includes both a Directive ICE (the process design) and a Descriptive ICE (the trial-run test result). The prototype (ex:ProductServicePrototype, a Material Artifact) is the material participant whose production process is being created and trial-run, not an informational has-input (D3: informational I/O in this develop/plan category are ICEs)." ;
          rdfs:label "Develop and test prototype production and/or service delivery process" ;
          skos:definition "An Act of Development that creates the production or service-delivery process for prototyped offerings and tests it through trial runs, producing a production/delivery process design and a prototype test result." ;
          skos:example "An operations team builds and trial-runs a pilot assembly line for a prototype." .


###  http://example.org/apqc#P10099
ex:P10099 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductionEquipment
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:RawMaterial
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SupplyChainPartner
                          ] ;
          ex:apqcSourceText "Developing and/or sourcing the essential machinery needed for creating purpose-built processes, as well as the raw materials, to produce the new products/services. Either design the equipment and materials needed internally, or source from external vendors. Obtain the feedstock or raw materials needed to prepare the finished products, as well as the machinery - hardware and software - needed to arrange production lines, factory operations, assemblies, and manufacturing processes. Revisit the technologies that underpin the new or revised products/services in order to source the right equipment and materials." ;
          ex:hierarchyID "2.3.3.1" ;
          ex:pcfID "10099" ;
          ex:requiresRole ex:SupplyChainPartnerRole ;
          rdfs:comment "Genus ex:ActOfAcquisition (Planned Act): the defining outcome is obtaining held material entities. The obtained production equipment and raw materials (ex:ProductionEquipment, ex:RawMaterial) are the material participants the act brings under the organization's control, not informational has-outputs -- in this develop/plan category (2.0) material things participate rather than fill the informational output slot (D3: informational outputs are ICEs). Supply-chain partners (vendors) participate." ;
          rdfs:label "Design and obtain necessary capabilities/materials and equipment" ;
          skos:definition "A Planned Act of Acquisition that designs or sources, and obtains, the production equipment and raw materials needed to produce a new product or service." ;
          skos:example "A plant sources CNC machinery and feedstock from external vendors for a new line." .


###  http://example.org/apqc#P10100
ex:P10100 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDevelopment ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductionEquipment
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11417
                          ] ;
          ex:apqcSourceText "Finalizing production process or methodology. Install and initiate the production process to manufacture the new products, using the equipment and machinery already assembled. In the case of new services, implement delivery processes and methodologies. Validate processes for the accuracy of their operation and proper functioning." ;
          ex:hierarchyID "2.3.3.4" ;
          ex:pcfID "10100" ;
          rdfs:comment "Installation brings the process into operation (development); the validation step is captured by the monitoring process part (11417). The production equipment used (ex:ProductionEquipment, a Material Artifact) is the act's definitional material participant, not an informational has-input (D3: informational I/O in this develop/plan category are ICEs)." ;
          rdfs:label "Install and validate production/service delivery process" ;
          skos:definition "An Act of Development that installs and initiates the production or service-delivery process using assembled equipment and validates its proper functioning." ;
          skos:example "A plant installs the line, starts production, and validates output accuracy." .


###  http://example.org/apqc#P10101
ex:P10101 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10106
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10107
                          ] ;
          ex:apqcSourceText "Making sense of the market and customers to identify the right opportunities to be capitalized, given the organization's competencies. Discern trends and shift in the market and customers. Identify the right market opportunities that fit closely with the organization's capabilities and strategy by gathering intelligence on various attributes of different market/customer segments." ;
          ex:hierarchyID "3.1" ;
          ex:pcfID "10101" ;
          ex:requiresCapability ex:MarketIntelligenceCapability ;
          rdfs:comment "Models APQC process group 3.1 as a bounded occurrent. Its APQC children are process parts (cco:ont00001777), not subclasses." ;
          rdfs:label "Understand markets, customers, and capabilities" ;
          skos:definition "An Act of Analysis that examines market and customer segments and the organization's capabilities and produces an understanding of where the right market opportunities lie." ;
          skos:example "An organization's annual market-and-customer intelligence cycle culminating in a shortlist of validated opportunities." .


###  http://example.org/apqc#P10102
ex:P10102 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:MarketingPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10123
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11168
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16848
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18924
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20000
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketingStrategy
                          ] ;
          ex:apqcSourceText "Charting a strategic course for marketing products/services. This will include defining the value proposition, creating a mechanism for pricing, and determining the right mix of marketing channels. Create a specific positioning and branding for the organization's offerings. Enlist marketing head to lead, with inputs from the business development and sales functions." ;
          ex:hierarchyID "3.2" ;
          ex:pcfID "10102" ;
          ex:requiresRole ex:MarketingProfessionalRole ;
          rdfs:comment "Models APQC group 3.2 (PCF 10102) as a bounded strategy-development cycle whose output is a Directive marketing strategy; its APQC children are process parts (cco:ont00001777), not subclasses. OUTPUT CORRECTED (Gate-F): the asserted output was ex:MarketingCommunicationStrategy, which is actually the narrow communication sub-strategy authored by the child 3.2.5 (P16848); it is replaced with the minted ex:MarketingStrategy (the overall go-to-market deliverable) to agree with this class's genus-differentia definition. 3.2.4 is the standing ex:ChannelManagementCapability (R5/R6): a capability is a specifically dependent continuant, NOT an occurrent, so it cannot be a cco:has process part (occurrent range) of this act -- wiring it as one made P10102 unsatisfiable. It is instead modeled in its own block (realized in its bounded child acts) and is intentionally not asserted as a part of the bounded 3.2 strategy act." ;
          rdfs:label "Develop marketing strategy" ;
          skos:definition "An Act of Formulation that composes an organization's marketing strategy, comprising the definition of the customer value proposition, the pricing strategy, the channel strategy, the marketing communication strategy, and the customer loyalty program." ;
          skos:example "A marketing head leads a planning cycle that produces the firm's go-to-market marketing strategy for a product line." .


###  http://example.org/apqc#P10103
ex:P10103 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10129
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10130
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10131
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10132
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10133
                          ] ;
          ex:apqcSourceText "Developing concrete plans for guiding and providing support to the sales function. Chart a road map for the sales function, including an analysis of historical sales data to create forecasts for anticipated sales, forming sales targets, forging partnerships with other economic agents to boost sales, devising a budget for this function, and determining metrics to measure customer management activities as well as progress in achieving sales targets." ;
          ex:hierarchyID "3.4" ;
          ex:pcfID "10103" ;
          rdfs:comment "Models APQC group 3.4 as an occurrent. Anchored at ex:ActOfFormulation (under Act of Planning): the node composes a directive road map. Its APQC children are process parts (has process part), not subclasses (D1)." ;
          rdfs:label "Develop sales strategy" ;
          skos:definition "An Act of Formulation that charts a road map for the sales function and produces a sales strategy, comprising the development of a sales forecast, the cultivation of partner and alliance relationships, the establishment of sales budgets, and the establishment of sales goals and customer-management measures." ;
          skos:example "A sales leadership team runs its annual sales-strategy cycle, producing the forecast, partner plan, budget, and target/metric set for the year." .


###  http://example.org/apqc#P10105
ex:P10105 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10182
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10183
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10185
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10187
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11779
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21427
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21428
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21429
                          ] ;
          ex:apqcSourceText "Selling products/services. Set appropriate customer expectations. Work with customers using the same schedule that product/service development, production, and customer service functions follow. Manage sales personnel and sales partnerships/alliances." ;
          ex:hierarchyID "3.5" ;
          ex:pcfID "10105" ;
          rdfs:comment "Process-group container for PCF 3.5. Its APQC children are process parts (cco:ont00001777), not subclasses. Anchored at cco:ont00000228 (Planned Act) as a heterogeneous aggregate of selling, planning, information-processing, and communication acts." ;
          rdfs:label "Develop and manage sales plans" ;
          skos:definition "A Planned Act in which an organization plans and carries out the selling of its products and services, encompassing lead management, customer and account management, proposal development, sales-order management, and partner and alliance management." ;
          skos:example "An organization's end-to-end sales operation across a fiscal year." .


###  http://example.org/apqc#P10106
ex:P10106 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10108
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10109
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10110
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10111
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10112
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10113
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketIntelligenceReport
                          ] ;
          ex:apqcSourceText "Gathering intelligence on the market and customers. Closely examine the inherent attributes and collective behavior of the various market and customer segments. Track trends in the market. Determine what drives the customers to make purchasing decisions in order to identify opportunities in the market." ;
          ex:hierarchyID "3.1.1" ;
          ex:pcfID "10106" ;
          ex:requiresCapability ex:MarketIntelligenceCapability ;
          rdfs:label "Perform customer and market intelligence analysis" ;
          skos:definition "An Act of Analysis that has as input market data and customer data and has as output a market intelligence report covering market and customer segments, their behavior, and market trends." ;
          skos:example "An intelligence team aggregates segment, behavioral, and trend data into a market intelligence report." .


###  http://example.org/apqc#P10107
ex:P10107 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10116
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10117
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10118
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10119
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketOpportunity
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OpportunityValidation
                          ] ;
          ex:apqcSourceText "Appraising market opportunities by quantifying and subjecting them to prioritization, as well as validation tests. Closely examine the market opportunities that have been identified by Perform customer and market intelligence analysis [10106]. Triangulate those opportunities to capitalize by finding a fit between identified opportunities and the composite of organizational capabilities and business strategy." ;
          ex:hierarchyID "3.1.2" ;
          ex:pcfID "10107" ;
          ex:requiresCapability ex:MarketIntelligenceCapability ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the overall act evaluates opportunities. Its child ex:P10117 (Determine target segments) and ex:P10118 (Prioritize opportunities) are Selection acts producing Directive ICEs, decomposed via has process part." ;
          rdfs:label "Evaluate and prioritize market opportunities" ;
          skos:definition "An Act of Appraisal that has as input market opportunity statements and has as output an opportunity validation result, by quantifying, prioritizing, and validating identified market opportunities against organizational capabilities and strategy." ;
          skos:example "A strategy team quantifies, ranks, and validates the opportunities surfaced by the intelligence cycle." .


###  http://example.org/apqc#P10108
ex:P10108 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10114
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21424
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerResearchFindings
                          ] ;
          ex:apqcSourceText "Carrying out research studies to understand the behavior of customers and the realities of the market. Undertake research to understand the market conditions as well as the characteristics, drives, and desires of prospective customers. Gather highly contextualized intelligence through primary and secondary research methods, with the objective of gaining insights over how to best seize a market opportunity. Consider assistance from professional research services." ;
          ex:hierarchyID "3.1.1.1" ;
          ex:pcfID "10108" ;
          rdfs:label "Conduct customer and market research" ;
          skos:definition "An Act of Analysis that has as input market data and customer data and has as output customer research findings about customer behavior and market conditions." ;
          skos:example "A research team runs primary and secondary studies and reports findings on prospective-customer drives." .


###  http://example.org/apqc#P10109
ex:P10109 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10115
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketSegmentation
                          ] ;
          ex:apqcSourceText "Identifying a section of the customer population to target for marketing products/services. Create segments within the customer population for targeted marketing campaigns, which increase the efficacy of marketing outlay. Determine the right customer segments, craft effective marketing messages, and efficiently communicate them. Determine the optimal pricing mix. Consider assistance from professional services for market segmentation studies, with coordination and oversight from the marketing/sales functions." ;
          ex:hierarchyID "3.1.1.2" ;
          ex:pcfID "10109" ;
          rdfs:comment "Genus is Analysis (information processing yielding a descriptive partition). The cross-referenced message-crafting and pricing-mix steps belong to other groups and are not asserted as outputs here." ;
          rdfs:label "Identify market segments" ;
          skos:definition "An Act of Analysis that has as input customer data and market data and has as output a market segmentation that partitions the customer population into targetable segments." ;
          skos:example "A marketing team segments the customer base for targeted campaigns." .


###  http://example.org/apqc#P10110
ex:P10110 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:IndustryTrendData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:IndustryTrendAnalysis
                          ] ;
          ex:apqcSourceText "Examining large-scale shifts and trends, with relevance to the organization's products/services. Vet the industrial and larger market landscape to identify broad-based movements that could have a direct or tangential impact on the uptake of the organization's products/services. Examine, among other things, the market capitalization of similar products, the profitability of organizations offering competing products/services, the stock price of key vendors/suppliers in the organizational value-chain, the rate and scale of innovation activity in the organization's product/service category, the price and availability of raw materials, and the shelf-life of similar products/services. Conduct primary and secondary research, and consider enlisting professional services." ;
          ex:hierarchyID "3.1.1.3" ;
          ex:pcfID "10110" ;
          rdfs:label "Analyze market and industry trends" ;
          skos:definition "An Act of Analysis that has as input industry trend data and market data and has as output an industry and market trend analysis of large-scale shifts relevant to the organization's offerings." ;
          skos:example "A team reports the industry shifts likely to affect product uptake over the coming years." .


###  http://example.org/apqc#P10111
ex:P10111 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CompetitorData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompetitiveAnalysis
                          ] ;
          ex:apqcSourceText "Examining the strengths and weaknesses of competing organizations. Assess competing organizations for offerings, product strategy, marketing and delivery channels, etc. Analyze the usability experience, durability, USP, and other key attributes of competing and substitute products. Gather competitive intelligence, and consider enlisting professional services." ;
          ex:hierarchyID "3.1.1.4" ;
          ex:pcfID "10111" ;
          rdfs:label "Analyze competing organizations, competitive/substitute products/services" ;
          skos:definition "An Act of Analysis that has as input competitor data and has as output a competitive analysis about competing organizations and their products and substitutes." ;
          skos:example "A competitive-intelligence team profiles rivals' strengths, weaknesses, and substitute products." .


###  http://example.org/apqc#P10112
ex:P10112 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductPortfolioAssessment
                          ] ;
          ex:apqcSourceText "Examining the brands owned and products offered in the market. Determine the relative position of the existing products/brands in the marketplace." ;
          ex:hierarchyID "3.1.1.5" ;
          ex:pcfID "10112" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal) because the act evaluates and judges the relative position of existing products; output is a Descriptive ICE, satisfying the GOLDEN PRINCIPLE." ;
          rdfs:label "Evaluate existing products/services" ;
          skos:definition "An Act of Appraisal that has as input market data and has as output a product portfolio assessment of the relative market position of the organization's existing products and brands." ;
          skos:example "A brand team judges where each owned product stands against the market." .


###  http://example.org/apqc#P10113
ex:P10113 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessEnvironmentAssessment
                          ] ;
          ex:apqcSourceText "Understanding the culture and environment in which you're operating. Analyze how internal decision-making, thought processes, financial circumstances, and more affect the ability to bring new products to market. Survey or analyze the market into which the products would be introduced." ;
          ex:hierarchyID "3.1.1.6" ;
          ex:pcfID "10113" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the act judges the operating environment (internal culture, finances, external market); output is a Descriptive ICE." ;
          rdfs:label "Assess internal and external business environment" ;
          skos:definition "An Act of Appraisal that has as input market data and has as output a business environment assessment of the internal and external conditions affecting the organization's ability to bring products to market." ;
          skos:example "A planning team appraises the internal and external readiness to launch a new product line." .


###  http://example.org/apqc#P10114
ex:P10114 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerBehaviorModel
                          ] ;
          ex:apqcSourceText "Identifying the factors that drive the targeted market segment. Model customer purchasing patterns, and forecast their future purchasing behavior." ;
          ex:hierarchyID "3.1.1.1.1" ;
          ex:pcfID "10114" ;
          rdfs:comment "Genus is Analysis: the definitional output is a descriptive behavior model of past/present patterns. The text's forward-looking 'forecast' step is realized by its sibling process ex:P21424 (Predict customer purchasing behavior) and is therefore not asserted here as a predictive output." ;
          rdfs:label "Understand consumer needs and historical behaviors" ;
          skos:definition "An Act of Analysis that has as input customer data and has as output a customer behavior model that represents historical purchasing patterns and the factors driving a targeted segment." ;
          skos:example "An analyst models a segment's historical buying patterns and the drivers behind them." .


###  http://example.org/apqc#P10115
ex:P10115 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketShareAnalysis
                          ] ;
          ex:apqcSourceText "Determining the increase or decrease of the company's sales volume in the targeted markets. Conduct an analysis to determine the factors and underlying causes that affect the changes in the demand for products or services offered. Consider changes in offerings or in the business strategy to regain or increase the market share." ;
          ex:hierarchyID "3.1.1.2.1" ;
          ex:pcfID "10115" ;
          rdfs:label "Determine market share gain/loss" ;
          skos:definition "An Act of Analysis that has as input market data and has as output a market share analysis that represents the change in the organization's sales volume in targeted markets and its underlying causes." ;
          skos:example "An analyst explains a quarter's market-share decline and its drivers." .


###  http://example.org/apqc#P10116
ex:P10116 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketOpportunity
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OpportunityQuantification
                          ] ;
          ex:apqcSourceText "Attaching quantifiable indicators to opportunities that have been identified in the market. Compute estimated figures of the approximate value that can be captured with the provision of existing products/services (i.e., the extent of financial benefits that can be reaped in the market)." ;
          ex:hierarchyID "3.1.2.1" ;
          ex:pcfID "10116" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis (reused from apqc-ext.ttl; an Act of Information Processing under cco:ont00000366): computing estimated value figures and attaching quantifiable indicators is a measurement/calculation/estimation act -- an information-processing examination that yields a Descriptive ICE -- not a value-judgement. RE-ANCHORED (Gate-F): rejected cco:ont00000636 (Act of Appraisal), whose proper use (siblings P10119 validate, P10113) is judging worth/feasibility; quantification computes magnitudes. Output ex:OpportunityQuantification is Descriptive, so the GOLDEN PRINCIPLE holds under the Analysis genus. The earlier 'species of Act of Measuring' parenthetical was an unverified parent-chain assertion and is removed." ;
          rdfs:label "Quantify market opportunities" ;
          skos:definition "An Act of Analysis that has as input market opportunity statements and has as output an opportunity quantification that estimates the value capturable from each identified opportunity." ;
          skos:example "An analyst computes the estimated revenue capturable from each opportunity." .


###  http://example.org/apqc#P10117
ex:P10117 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18941
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketSegmentation
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:TargetSegmentDefinition
                          ] ;
          ex:apqcSourceText "Identifying the targeted segment of customers. Deduce those particular customer segments that are to be targeted from among the market segments." ;
          ex:hierarchyID "3.1.2.2" ;
          ex:pcfID "10117" ;
          rdfs:comment "Anchored to ex:ActOfSelection (reused from apqc-ext.ttl) because the act chooses target segments from a candidate set of market segments and yields a Directive ICE (a committing decision), satisfying the GOLDEN PRINCIPLE for directive output." ;
          rdfs:label "Determine target segments" ;
          skos:definition "An Act of Selection that has as input a market segmentation and has as output a target segment definition that prescribes which customer segments are to be targeted." ;
          skos:example "Marketing selects three segments to target from the segmentation." .


###  http://example.org/apqc#P10118
ex:P10118 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketOpportunity
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OpportunityPrioritization
                          ] ;
          ex:apqcSourceText "Creating an index of market opportunities, and arrange them in order of preference. Prioritize based on the opportunities' adherence to the overall business strategy. Correlate with the competencies and capacities that the organization, as a whole, processes." ;
          ex:hierarchyID "3.1.2.3" ;
          ex:pcfID "10118" ;
          rdfs:comment "Anchored to ex:ActOfSelection (reused): ranking opportunities by preference is a committing choice over a candidate set; output is a Directive ICE, satisfying the GOLDEN PRINCIPLE." ;
          rdfs:label "Prioritize opportunities consistent with capabilities and overall business strategy" ;
          skos:definition "An Act of Selection that has as input market opportunity statements and has as output an opportunity prioritization that prescribes the rank order of opportunities by fit to strategy and capabilities." ;
          skos:example "A committee ranks the validated opportunities by strategic fit." .


###  http://example.org/apqc#P10119
ex:P10119 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10120
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10121
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketOpportunity
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OpportunityValidation
                          ] ;
          ex:apqcSourceText "Confirming the practicability and reasonableness of the market opportunities that have been identified. Give substance to the real-time feasibility of the market opportunities." ;
          ex:hierarchyID "3.1.2.4" ;
          ex:pcfID "10119" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the act judges feasibility/reasonableness; output is a Descriptive ICE." ;
          rdfs:label "Validate opportunities" ;
          skos:definition "An Act of Appraisal that has as input market opportunity statements and has as output an opportunity validation result confirming the practicability and feasibility of the identified opportunities." ;
          skos:example "A team confirms which opportunities are realistically feasible before launch." .


###  http://example.org/apqc#P10120
ex:P10120 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerFeedback
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OpportunityValidation
                          ] ;
          ex:apqcSourceText "Validating identified market opportunities by testing company's offerings on limited-size samples of the consumer population that are hypothesized to be representative of the target market at large and to have similar purchasing behavior. The feedback gained through consumer testing can be used to modify or reject product offerings before their full scale launch, saving the company valuable resources, should the initial offering not be successful." ;
          ex:hierarchyID "3.1.2.4.1" ;
          ex:pcfID "10120" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the act judges an opportunity by sample testing; outputs are Descriptive ICEs. I/O DIRECTIONALITY CORRECTED (Gate-F): the source says feedback is gained THROUGH the test and 'can be used to modify or reject product offerings', so customer feedback is PRODUCED by the test (has output / present at the end), not consumed by it. Per CCO has-input/has-output semantics it was wrongly modeled as a has-input filler; it is now a has-output ICE alongside the opportunity validation result. (The definitional start-of-process input is the offering/sample under test, a material entity not asserted here under the Phase-3 necessity rule.)" ;
          rdfs:label "Test with customers/consumers" ;
          skos:definition "An Act of Appraisal that tests an organization's offerings on representative consumer samples and has as output customer feedback and an opportunity validation result." ;
          skos:example "A pilot test on a representative sample validates or rejects an offering before launch." .


###  http://example.org/apqc#P10121
ex:P10121 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CapabilityConfirmation
                          ] ;
          ex:apqcSourceText "Verifying that the company has sufficient infrastructure and resources to deliver their offerings in a timely and cost-effective manner, and that it is able to scale up from the small-scale market samples, used for consumer testing, to the entire identified market segment." ;
          ex:hierarchyID "3.1.2.4.2" ;
          ex:pcfID "10121" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the act judges internal sufficiency and scalability; output is a Descriptive ICE." ;
          rdfs:label "Confirm internal capabilities" ;
          skos:definition "An Act of Appraisal that has as output a capability confirmation that verifies the organization has sufficient infrastructure and resources to deliver and scale its offerings to the identified market segment." ;
          skos:example "Operations confirms the firm can scale delivery from pilot to the full target segment." .


###  http://example.org/apqc#P10123
ex:P10123 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10124
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10125
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P13169
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19999
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PricingStrategy
                          ] ;
          ex:apqcSourceText "Creating a pricing strategy and mechanism that aligns with the benefits of the products/services, as perceived by customers. Chart a strategic course and a methodology that can guide the pricing of products/services. Draw heavily from the customer value proposition, and balance the expectations of different divisions inside the organization, while delivering the maximum ROI." ;
          ex:hierarchyID "3.2.2" ;
          ex:pcfID "10123" ;
          rdfs:comment "Output ex:PricingStrategy is Directive, agreeing with the Formulation genus. ex:ValueProposition is a typical (not definitional) input - the text says it draws 'heavily from' it - so it is noted here rather than asserted as a restriction (Phase-3)." ;
          rdfs:label "Define pricing strategy" ;
          skos:definition "An Act of Formulation that charts a strategic course and methodology for pricing an organization's offerings and produces a pricing strategy." ;
          skos:example "A pricing team charts a value-based pricing methodology aligned to the customer value proposition." .


###  http://example.org/apqc#P10124
ex:P10124 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PricingGuideline
                          ] ;
          ex:apqcSourceText "Creating a framework that allows for a uniform methodology while determining the price of individual offerings. Devise a blueprint for establishing the pricing of specific products/services. Create guidelines that factor in the cost of production/servicing, price sensitivity, product lifecycle, and the price of competing/substitute products." ;
          ex:hierarchyID "3.2.2.2" ;
          ex:pcfID "10124" ;
          rdfs:comment "Output ex:PricingGuideline is Directive (a prescriptive framework), agreeing with the Formulation genus." ;
          rdfs:label "Establish guidelines for applying pricing and discounting of products/services" ;
          skos:definition "An Act of Formulation that devises a uniform framework for pricing and discounting individual offerings and produces pricing guidelines." ;
          skos:example "A pricing committee issues guidelines that fix how production cost and competitor prices feed individual list prices." .


###  http://example.org/apqc#P10125
ex:P10125 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PricingGuideline
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PricingApproval
                          ] ;
          ex:apqcSourceText "Confirming the strategy and specifications developed for pricing the organization's products/services. Approve pricing guidelines by vetting the soundness of the methodology and the guidelines' alignment with the value proposition." ;
          ex:hierarchyID "3.2.2.4" ;
          ex:pcfID "10125" ;
          rdfs:comment "Anchored to cco:ont00000228 (Planned Act), NOT ex:ActOfSelection: approval ratifies a single already-settled option (there is no candidate set to choose among), per the ActOfSelection scope note. Output ex:PricingApproval is Directive (a prescriptive ratification). ex:PricingGuideline is the definitional input being vetted." ;
          rdfs:label "Approve pricing strategies/policies and targets" ;
          skos:definition "A Planned Act that confirms the already-developed pricing strategy, guidelines, and targets and produces a pricing approval." ;
          skos:example "A pricing director signs off on the pricing guidelines after checking their alignment with the value proposition." .


###  http://example.org/apqc#P10126
ex:P10126 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ChannelData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ChannelEvaluation
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PartnerEvaluation
                          ] ;
          ex:apqcSourceText "Assessing the attributes of all marketing channels, and evaluating the key partners in those channels. Closely examine the various characteristics of all available marketing channels such as the cost of using them, durability of impact, applicability to the organization's products/services, turn-around time, involvement of middlemen, and conversion rate. Analyze key partners in the marketing channels including those who have been associated with the organization; evaluate their capabilities, the scale and scope of their operations, quality of support provided, etc." ;
          ex:hierarchyID "3.2.3.6" ;
          ex:pcfID "10126" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it evaluates channels and partners against criteria and yields Descriptive judgements (ex:ChannelEvaluation, ex:PartnerEvaluation), agreeing with the GOLDEN PRINCIPLE. ex:ChannelData is a definitional input." ;
          rdfs:label "Evaluate channel attributes and potential partners" ;
          skos:definition "An Act of Appraisal that assesses the attributes of marketing channels and the capabilities of their key partners and produces a channel evaluation and a partner evaluation." ;
          skos:example "An analyst rates each channel's cost and conversion and assesses its partners' capabilities." .


###  http://example.org/apqc#P10127
ex:P10127 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ChannelData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ChannelEvaluation
                          ] ;
          ex:apqcSourceText "Analyze the various channels for their relevance to the targeted segments. Identify the channel that can effectively market to the targeted customers in regard to the drives, desires, and characteristics of these populations, their uptake, extent of engagement, frequency of use, and effectiveness in communicating." ;
          ex:hierarchyID "3.2.3.3" ;
          ex:pcfID "10127" ;
          rdfs:comment "Output ex:ChannelEvaluation is Descriptive (is-about MarketingChannel), agreeing with the Information-Processing genus. ex:ChannelData is a definitional input." ;
          rdfs:label "Determine channel role and fit with target segments" ;
          skos:definition "An Act of Analysis that examines marketing channels for their relevance to targeted segments and produces a channel evaluation of their fit." ;
          skos:example "An analyst rates which channels best reach a target segment given its engagement patterns." .


###  http://example.org/apqc#P10128
ex:P10128 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ChannelEvaluation
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ChannelSelection
                          ] ;
          ex:apqcSourceText "Choose the most pertinent marketing channel for the targeted segments (based on Determine channel fit with target segments [10127])." ;
          ex:hierarchyID "3.2.3.4" ;
          ex:pcfID "10128" ;
          rdfs:comment "Anchored to ex:ActOfSelection (chooses from candidates, Directive output). ex:ChannelEvaluation is the definitional input (the text bases the choice on 10127)." ;
          rdfs:label "Select channels for target segments" ;
          skos:definition "An Act of Selection that chooses the most pertinent marketing channel for each target segment and produces a channel selection." ;
          skos:example "A channel team picks the single best channel per target segment from the fit analysis." .


###  http://example.org/apqc#P10129
ex:P10129 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfForecasting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10134
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10135
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10136
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10137
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesForecast
                          ] ;
          ex:apqcSourceText "Developing a sales forecast for the organization's portfolio of offerings, bearing in mind the effect of promotional events, and fine-tuning these in the context of the new forecast. Estimate the future demand for the organization's products/services by analyzing historical information and any promotional activity." ;
          ex:hierarchyID "3.4.1" ;
          ex:pcfID "10129" ;
          rdfs:comment "Genus ex:ActOfForecasting (under cco:ont00000371 Act of Prediction): the definitional output is a Predictive ICE (ex:SalesForecast). Children are process parts." ;
          rdfs:label "Develop sales forecast" ;
          skos:definition "An Act of Forecasting that estimates the future demand for an organization's portfolio of offerings from historical and promotional information and produces a sales forecast." ;
          skos:example "A demand-planning team analyzes order history and promotions and issues next year's sales forecast." .


###  http://example.org/apqc#P10130
ex:P10130 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10138
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10139
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10140
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10141
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10142
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11465
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11466
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11468
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11521
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11522
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11523
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18629
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AllianceStrategy
                          ] ;
          ex:apqcSourceText "Cultivating an alliance of partners by identifying, analyzing, negotiating, and managing partnerships with other economic agents." ;
          ex:hierarchyID "3.4.2" ;
          ex:pcfID "10130" ;
          ex:requiresCapability ex:PartnerManagementCapability ;
          rdfs:comment "Genus ex:ActOfFormulation: the node develops the relationship set and yields the directive ex:AllianceStrategy. The standing 'manage' function is modeled separately as ex:PartnerManagementCapability (R6), not by this bounded development node. Children are process parts." ;
          rdfs:label "Develop sales partner/alliance relationships" ;
          skos:definition "An Act of Formulation that cultivates an organization's set of sales partner and alliance relationships and produces a partner and alliance strategy." ;
          skos:example "A partnerships team builds out the year's alliance program, from opportunity scan to signed agreements and management goals." .


###  http://example.org/apqc#P10131
ex:P10131 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10143
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10144
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10145
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10146
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10147
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P17682
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesBudget
                          ] ;
          ex:apqcSourceText "Setting up a financial plan for the sales function. Calculate the estimated sales revenue and costs, which helps in calculating the overall net profit. Create a sound plan for resource outlay by comparing the forecast with historical data." ;
          ex:hierarchyID "3.4.3" ;
          ex:pcfID "10131" ;
          rdfs:comment "Genus ex:ActOfFormulation: a budget prescribes resource allocation, so the output is the directive ex:SalesBudget. The cost/revenue/profit calculations are its analytic process parts. The sales forecast (ex:SalesForecast) is the typical input compared against history." ;
          rdfs:label "Establish overall sales budgets" ;
          skos:definition "An Act of Formulation that sets up the financial plan for the sales function from estimated revenue, costs, and net profit and produces a sales budget." ;
          skos:example "Finance and sales jointly set the sales function's annual budget after costing the forecast." .


###  http://example.org/apqc#P10132
ex:P10132 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceMeasure
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesGoal
                          ] ;
          ex:apqcSourceText "Establishing specific quantitative and qualitative measures of realizing sales targets. Create sales targets by analyzing historical sales data and comparing the forecasts to results, in light of customer and market intelligence. Examine the performance of sales personnel in light of market opportunities. Based on this review, establish sales targets along with metrics to quantify these goals, corresponding with the overall business strategy." ;
          ex:hierarchyID "3.4.4" ;
          ex:pcfID "10132" ;
          rdfs:comment "Genus ex:ActOfFormulation: establishing targets and metrics is a directive output (ex:SalesGoal and ex:PerformanceMeasure; per the section vocab mapping of 3.4.4). 'Establish' here is a bounded act with a clear deliverable, not a standing function. The sales forecast and market intelligence are typical inputs." ;
          rdfs:label "Establish sales goals and measures" ;
          skos:definition "An Act of Formulation that establishes sales targets and the quantitative and qualitative metrics used to track their realization and produces a sales goal and a performance-measure specification." ;
          skos:example "Sales leadership sets the quarter's revenue targets and the KPI set that quantifies them." .


###  http://example.org/apqc#P10133
ex:P10133 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerManagementMeasure
                          ] ;
          ex:apqcSourceText "Identifying the appropriate measures that can represent key attributes of the customer management function. Select measures to track customer activity, feedback, satisfaction, organizational responsiveness to customer needs, and general data on how the organization is managing customer accounts, leads, and contacts. Build on customer and market intelligence to identify metrics gauging aspects related to customer management. Select measures based on the nature of the business, the type and size of customer base, strategic goals, and the model used to structure sales and customer relationships." ;
          ex:hierarchyID "3.4.5" ;
          ex:pcfID "10133" ;
          rdfs:comment "Genus ex:ActOfFormulation: selecting/establishing measures prescribes what to track, so the output is the directive ex:CustomerManagementMeasure (per the section vocab mapping of 3.4.5). Customer and market intelligence are typical inputs. Bounded act with a clear deliverable, not a standing function." ;
          rdfs:label "Establish customer management measures" ;
          skos:definition "An Act of Formulation that selects the measures representing key attributes of the customer-management function and produces a customer-management measure specification." ;
          skos:example "A CRM lead selects the satisfaction, responsiveness, and account-health metrics to govern customer management." .


###  http://example.org/apqc#P10134
ex:P10134 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ;
          ex:apqcSourceText "Gathering all information about sales orders into an index. Create a directory of all sales orders, whether open or those which have been fulfilled. Track what product/service was ordered, the quantity ordered, who ordered it, the delivery date, the shipping method, the unit price and line total, payment terms, and any discount applied." ;
          ex:hierarchyID "3.4.1.1" ;
          ex:pcfID "10134" ;
          rdfs:comment "Anchored directly at cco:ont00000366 (Act of Information Processing): gathering orders into an index is the 'received ... and stored' sense of information processing, not an analysis or appraisal. The directory it builds is the descriptive ex:SalesOrderData." ;
          rdfs:label "Gather current and historic order information" ;
          skos:definition "An Act of Information Processing that gathers and stores information about current and historical sales orders into an index and produces a sales-order data record." ;
          skos:example "A sales-ops analyst compiles open and fulfilled orders into a single order directory." .


###  http://example.org/apqc#P10135
ex:P10135 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesTrendAnalysis
                          ] ;
          ex:apqcSourceText "Analyzing sales order data to identify patterns in order to capitalize on emerging trends in the industry or the economy. Closely examine the directory of sales orders. Discern any patterns from this index, which is representative of the demand for the organization's offerings. Identify trends among the various segments of the organization's customer base to create forecasts. Glean patterns from this analysis, including the triangulation of segments that are showing the most growth in demand or those that represent the highest decline revenue, industry-wide trends such as decline/boost in overall demand, and any unusual trends that lie outside of the organization's expectations." ;
          ex:hierarchyID "3.4.1.2" ;
          ex:pcfID "10135" ;
          rdfs:comment "Genus ex:ActOfAnalysis (under cco:ont00000366): descriptive examination of the order directory yielding ex:SalesTrendAnalysis (GOLDEN PRINCIPLE: Analysis -> Descriptive ICE)." ;
          rdfs:label "Analyze sales trends and patterns" ;
          skos:definition "An Act of Analysis that examines sales-order data to discern demand patterns and produces a sales-trend analysis." ;
          skos:example "An analyst discerns which customer segments are growing fastest from the order index." .


###  http://example.org/apqc#P10136
ex:P10136 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfForecasting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesTrendAnalysis
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesForecast
                          ] ;
          ex:apqcSourceText "Calculating the future demand for the organization's products/services. Use the trends and patterns identified in the sales data to estimate future demand. Use forecast to prepare for future customer demand and to recalibrate the strategic course of functions and business units." ;
          ex:hierarchyID "3.4.1.3" ;
          ex:pcfID "10136" ;
          rdfs:comment "Genus ex:ActOfForecasting: the definitional output is the Predictive ICE ex:SalesForecast (GOLDEN PRINCIPLE: forecast -> Predictive). The sales-trend analysis (ex:SalesTrendAnalysis) from 3.4.1.2 is the typical informational input." ;
          rdfs:label "Generate sales forecast" ;
          skos:definition "An Act of Forecasting that extrapolates from identified sales trends to estimate future demand and produces a sales forecast." ;
          skos:example "A planner converts the trend analysis into a unit-demand forecast for the next four quarters." .


###  http://example.org/apqc#P10137
ex:P10137 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesTrendAnalysis
                          ] ;
          ex:apqcSourceText "Reviewing promotional activities' effect on the sales orders. Analyze all promotional events and campaigns that the organization has already employed or is planning to deploy." ;
          ex:hierarchyID "3.4.1.4" ;
          ex:pcfID "10137" ;
          rdfs:comment "Genus ex:ActOfAnalysis: descriptive review of promotional effect, output ex:SalesTrendAnalysis. Refines the forecast (3.4.1.3) but is a parallel analytic facet, so no precedence is asserted." ;
          rdfs:label "Analyze historical and planned promotions and events" ;
          skos:definition "An Act of Analysis that reviews the effect of historical and planned promotional events on sales orders and produces a sales-trend analysis of promotional impact." ;
          skos:example "An analyst quantifies how past campaigns lifted order volume to adjust the forecast." .


###  http://example.org/apqc#P10138
ex:P10138 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketOpportunity
                          ] ;
          ex:apqcSourceText "Identifying collaboration opportunities for selling, marketing, and distributing the organization's products/services. Determine any scope for partnering with other economic agents, with synergies for the marketing, sales, and/or distribution of the organization's products/services. Identify alliance opportunities that target customer segments who would be interested." ;
          ex:hierarchyID "3.4.2.1" ;
          ex:pcfID "10138" ;
          rdfs:comment "Genus ex:ActOfIdentification (discernment sense, under cco:ont00000366): output is the descriptive ex:MarketOpportunity. Not cco:ont00001261 (a communication act)." ;
          rdfs:label "Identify alliance opportunities" ;
          skos:definition "An Act of Identification that discerns collaboration opportunities for selling, marketing, and distributing an organization's offerings and produces a market-opportunity statement for partnering." ;
          skos:example "A partnerships lead identifies distributors whose reach complements the firm's target segments." .


###  http://example.org/apqc#P10139
ex:P10139 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AllianceStrategy
                          ] ;
          ex:apqcSourceText "Creating the frameworks needed to select alliance partners, and maintaining relationships with them. Create a framework for structured programs that can receive and support multiple alliances. Clearly outline the responsibilities and benefits of the alliance partners. Create frameworks for selecting the right alliance partners, and maintain a relationship with them. Create or repurpose teams of relationship managers and outline a methodology for selecting alliance partners." ;
          ex:hierarchyID "3.4.2.2" ;
          ex:pcfID "10139" ;
          rdfs:comment "Genus ex:ActOfFormulation: the frameworks/methodology are a directive specification (ex:AllianceStrategy). Referenced as the basis of selection in 3.4.2.3 [10140] and management in 3.4.2.7 [10141]." ;
          rdfs:label "Design alliance programs and methods for selecting and managing relationships" ;
          skos:definition "An Act of Formulation that composes the programs, selection methods, and relationship-management frameworks for alliance partnerships and produces a partner and alliance strategy." ;
          skos:example "A team drafts the alliance-program template and the partner-selection scorecard methodology." .


###  http://example.org/apqc#P10140
ex:P10140 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:AllianceStrategy
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AllianceSelection
                          ] ;
          ex:apqcSourceText "Choosing alliance partners using the selected programs and methodology. Select the most feasible and profitable alliance partners, based on Design alliance programs and methods for selecting and managing relationships [10139] and through a careful scrutiny of the potential alliance." ;
          ex:hierarchyID "3.4.2.3" ;
          ex:pcfID "10140" ;
          rdfs:comment "Genus ex:ActOfSelection (under cco:ont00000366): a candidate set is narrowed to chosen partners, yielding the directive ex:AllianceSelection (a decision). Definitional input is the selection methodology authored in 3.4.2.2 [10139] (ex:AllianceStrategy)." ;
          rdfs:label "Select alliances" ;
          skos:definition "An Act of Selection that chooses the most feasible and profitable alliance partners from a candidate set using the designed selection methodology and produces an alliance selection." ;
          skos:example "A committee scores prospective partners against the methodology and selects two alliances." .


###  http://example.org/apqc#P10141
ex:P10141 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AllianceStrategy
                          ] ;
          ex:apqcSourceText "Designing strategies for effectively managing, identifying, and countering any possible issues from the alliance partnerships formed. Create a strategic road map for managing the partnerships forged through Design alliance programs and methods for selecting and managing relationships [10139]. Determine where the alliance partnerships are headed, possible problems or pushback from the partners, how these issues might be countered, how these alliance partnerships would evolve in the future, any other business cases where these partnerships might be deployed, etc." ;
          ex:hierarchyID "3.4.2.7" ;
          ex:pcfID "10141" ;
          rdfs:comment "Genus ex:ActOfFormulation: a strategic road map for managing partnerships is the directive ex:AllianceStrategy. Builds on the frameworks of 3.4.2.2 [10139]." ;
          rdfs:label "Develop partner and alliance management strategies" ;
          skos:definition "An Act of Formulation that designs strategies for managing, anticipating issues in, and evolving alliance partnerships and produces a partner and alliance strategy." ;
          skos:example "A partnerships lead drafts the management road map anticipating partner pushback and exit scenarios." .


###  http://example.org/apqc#P10142
ex:P10142 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesGoal
                          ] ;
          ex:apqcSourceText "Setting targets for organizational achievement. This includes what the organization aims to achieve from and how it wishes to manage both the individual partners and the alliance as a whole. Set immediate through long-term goals including revenue targets, market penetration, footfall numbers, and geographical coverage." ;
          ex:hierarchyID "3.4.2.8" ;
          ex:pcfID "10142" ;
          rdfs:comment "Genus ex:ActOfFormulation: revenue/penetration/coverage targets are a directive ex:SalesGoal." ;
          rdfs:label "Establish partner and alliance management goals" ;
          skos:definition "An Act of Formulation that sets immediate through long-term goals and targets for managing individual partners and the alliance as a whole and produces a sales goal and target." ;
          skos:example "Management sets the alliance's revenue and geographical-coverage targets for the next three years." .


###  http://example.org/apqc#P10143
ex:P10143 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesForecast
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RevenueEstimate
                          ] ;
          ex:apqcSourceText "Estimating revenue from the sale of products/services. Approximate the anticipated sale of products/services and multiply it by the selling price of the respective offering. (This represents the total amount of money that the organization receives from the sale of its portfolio of offerings.)" ;
          ex:hierarchyID "3.4.3.2" ;
          ex:pcfID "10143" ;
          rdfs:comment "Genus ex:ActOfAnalysis: a descriptive quantitative estimate. Output is ex:RevenueEstimate (minted in shared vocab): revenue is not a cost, so ex:CostAnalysis would be a wrong genus-differentia fit; the sales forecast is the definitional input." ;
          rdfs:label "Calculate product revenue" ;
          skos:definition "An Act of Analysis that estimates the revenue from the sale of products and services by multiplying anticipated sales by selling price and produces a revenue estimate." ;
          skos:example "Finance multiplies forecast units by list price to estimate next year's product revenue." .


###  http://example.org/apqc#P10144
ex:P10144 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CostData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CostAnalysis
                          ] ;
          ex:apqcSourceText "Calculating the variable costs of production. Approximate those costs that depend on the volume of products/services produced by the organization." ;
          ex:hierarchyID "3.4.3.3" ;
          ex:pcfID "10144" ;
          rdfs:comment "Genus ex:ActOfAnalysis: descriptive cost calculation yielding ex:CostAnalysis (per the section vocab mapping of 3.4.3.2-.5 cost calculations)." ;
          rdfs:label "Determine variable costs" ;
          skos:definition "An Act of Analysis that calculates the variable production costs that depend on output volume and produces a cost analysis." ;
          skos:example "An analyst computes per-unit material and labor cost across the forecast volume." .


###  http://example.org/apqc#P10145
ex:P10145 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CostData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CostAnalysis
                          ] ;
          ex:apqcSourceText "Calculating the overhead costs associated with selling the organization's products/services. Determine fixed costs that are not directly related to the volume of products/services processed or the sale of these offerings (e.g., expense over machinery and equipment)." ;
          ex:hierarchyID "3.4.3.4" ;
          ex:pcfID "10145" ;
          rdfs:comment "Genus ex:ActOfAnalysis: descriptive fixed-cost calculation yielding ex:CostAnalysis." ;
          rdfs:label "Determine overhead and fixed costs" ;
          skos:definition "An Act of Analysis that calculates the overhead and fixed costs not directly related to output volume and produces a cost analysis." ;
          skos:example "An analyst totals equipment depreciation and facility overhead allocable to sales." .


###  http://example.org/apqc#P10146
ex:P10146 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CostAnalysis
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProfitabilityAnalysis
                          ] ;
          ex:apqcSourceText "Calculating the net income. Calculate the organization's profitability by accounting for Determine overhead and fixed costs [10145] and Determine variable costs [10144]." ;
          ex:hierarchyID "3.4.3.5" ;
          ex:pcfID "10146" ;
          rdfs:comment "Genus ex:ActOfAnalysis: descriptive profitability calculation yielding ex:ProfitabilityAnalysis (per the section vocab mapping of 3.4.3.5 net-profit calculation). Definitional inputs are the cost analyses from 3.4.3.3 [10144] and 3.4.3.4 [10145]." ;
          rdfs:label "Calculate net profit" ;
          skos:definition "An Act of Analysis that calculates net income by netting estimated revenue against variable, overhead, and fixed costs and produces a profitability analysis." ;
          skos:example "Finance derives projected net profit by subtracting all costed items from estimated revenue." .


###  http://example.org/apqc#P10147
ex:P10147 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesBudget
                          ] ;
          ex:apqcSourceText "Creating a plan in measurable terms for the financial outlay that best captures resource allocation for the sales forecast. Consider the outlay of capital, HR, raw materials, and provisions needed to reach sales targets." ;
          ex:hierarchyID "3.4.3.6" ;
          ex:pcfID "10147" ;
          rdfs:comment "Genus ex:ActOfFormulation: a budget prescribes resource allocation, so the output is the directive ex:SalesBudget (per the section vocab mapping of 3.4.3.6). The profitability analysis (ex:ProfitabilityAnalysis) is the typical input." ;
          rdfs:label "Create budget" ;
          skos:definition "An Act of Formulation that creates a measurable financial-outlay plan allocating resources to meet the sales forecast and produces a sales budget." ;
          skos:example "A manager allocates capital, headcount, and materials into the sales budget to hit targets." .


###  http://example.org/apqc#P10148
ex:P10148 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketingGoal
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceMeasure
                          ] ;
          ex:apqcSourceText "Determining what to achieve by marketing. Create qualitative and quantitative targets. Establish metrics to track performance (for individual Market segments [10109] and Channels for target segments [10129]). Enlist the head of marketing to determine marketing priorities and the related measures. (The decision in establishing these goals, objectives, and metrics is founded in Develop marketing strategy [10102] and takes cues from current priorities and organizational strategy.)" ;
          ex:hierarchyID "3.3.1" ;
          ex:pcfID "10148" ;
          rdfs:comment "Directive output (goals + performance-measure specifications) agrees with the planning genus per the GOLDEN PRINCIPLE." ;
          rdfs:label "Establish goals, objectives, and measures for products/services by channel/segment" ;
          skos:definition "An Act of Formulation that composes qualitative and quantitative marketing goals and the performance measures used to track their attainment by channel and segment." ;
          skos:example "A marketing leader sets target market-share and conversion goals with the metrics that will track them." .


###  http://example.org/apqc#P10149
ex:P10149 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10155
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10156
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10157
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P17683
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketingBudget
                          ] ;
          ex:apqcSourceText "Creating a budget for the organization's marketing efforts, in line with the business-wide strategic outlook. Create a plan to distribute resources for achieving the marketing strategy in light of the overall business strategy. Make cost assumptions; calculate the estimated total revenue from the marketing activities against the costs/expenses of these activities. Forecast the return on investment. Attribute costs to the appropriate marketing activities such as promotional campaigns, advertising, marketing communications, PR campaigns, personnel, and office space. Enlist the financial and marketing functions." ;
          ex:hierarchyID "3.3.2" ;
          ex:pcfID "10149" ;
          rdfs:comment "Directive output (a budget plan) agrees with the planning genus. Its four APQC children are process parts, not subclasses." ;
          rdfs:label "Establish marketing budgets" ;
          skos:definition "An Act of Formulation that composes a marketing budget allocating resources across marketing activities in line with the overall business strategy." ;
          skos:example "The marketing and finance functions agree an annual marketing budget with costs attributed to each campaign." .


###  http://example.org/apqc#P10153
ex:P10153 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10173
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10174
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10175
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10176
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10177
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMetricAnalysis
                          ] ;
          ex:apqcSourceText "Collating all customer-centered metrics. The objective is to create a big-picture view of the customers' mindset and their behavior pertaining to the organization's offerings." ;
          ex:hierarchyID "3.3.5" ;
          ex:pcfID "10153" ;
          rdfs:comment "Uses ex:ActOfMonitoring (PROPOSE-EXT): ongoing tracking of customer measures. Descriptive output agrees with the information-processing genus. Its five APQC children are process parts." ;
          rdfs:label "Track customer management measures" ;
          skos:definition "An Act of Monitoring that collates customer-centered metrics over time to produce a customer metric analysis giving a big-picture view of customer behavior." ;
          skos:example "A CRM team continuously collates loyalty, retention, and value metrics into a customer dashboard." .


###  http://example.org/apqc#P10155
ex:P10155 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketingAlignmentAssessment
                          ] ;
          ex:apqcSourceText "Ensuring corroboration of the marketing strategy and the organizational strategy. Ensure the organization's marketing strategy/plan aligns with the overall business strategy. Fine-tune the marketing plan according to the organizational strategy." ;
          ex:hierarchyID "3.3.2.1" ;
          ex:pcfID "10155" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal) because the act evaluates/confirms alignment. Descriptive output (an alignment judgement) agrees with the appraisal genus." ;
          rdfs:label "Confirm marketing alignment to business strategy" ;
          skos:definition "An Act of Appraisal that judges whether the marketing plan corroborates the overall business strategy and produces a marketing alignment assessment." ;
          skos:example "A planner checks the marketing plan against corporate strategy and confirms the two are aligned." .


###  http://example.org/apqc#P10156
ex:P10156 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CostData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CostAnalysis
                          ] ;
          ex:apqcSourceText "Calculating the total cost of marketing the organization's portfolio of products/services. Calculate the total outlay needed for promoting, selling, and delivering the organization's products/services to customers. Account for all costs to acquire customers and sustain a relationship with them. Include the expenses needed for promotional actives, warehousing, transactional costs, and distribution of the organization's offering." ;
          ex:hierarchyID "3.3.2.2" ;
          ex:pcfID "10156" ;
          rdfs:comment "Descriptive output (a cost analysis) agrees with the information-processing genus." ;
          rdfs:label "Determine costs of marketing" ;
          skos:definition "An Act of Analysis that has as input cost data and produces a cost analysis of the total outlay required to market the organization's portfolio." ;
          skos:example "An analyst totals promotion, warehousing, and distribution costs to determine the cost of marketing the portfolio." .


###  http://example.org/apqc#P10157
ex:P10157 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketingBudget
                          ] ;
          ex:apqcSourceText "Estimating the outlay required for promoting, selling, and distributing the products/services of the organization. Add up the expenses of all activities necessitated in marketing, such as promotional campaigns, advertising, marketing communications, PR campaigns, employing skilled personnel, and office space." ;
          ex:hierarchyID "3.3.2.3" ;
          ex:pcfID "10157" ;
          rdfs:comment "Directive output (a budget) agrees with the planning genus. Cost data is a typical input recorded here, not an existential restriction." ;
          rdfs:label "Create marketing budget" ;
          skos:definition "An Act of Formulation that composes a marketing budget by estimating and aggregating the outlay required for all marketing activities." ;
          skos:example "A budget owner sums campaign, personnel, and overhead expenses into the marketing budget." .


###  http://example.org/apqc#P10159
ex:P10159 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MarketingMessage
                          ] ;
          ex:apqcSourceText "Developing the central messages for a segment of its customers. Craft concise statements that position the value proposition of individual products/services around the pressing concerns in the market, thereby showing how the organization's offerings are the right fit for the customers." ;
          ex:hierarchyID "3.3.4.2" ;
          ex:pcfID "10159" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Directive output (a marketing message) agrees with the planning genus." ;
          rdfs:label "Develop marketing messages" ;
          skos:definition "An Act of Formulation that composes the central marketing messages positioning an offering's value proposition for a customer segment." ;
          skos:example "A copy team crafts the headline messages that position a product's value to a target segment." .


###  http://example.org/apqc#P10160
ex:P10160 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:TargetSegmentDefinition
                          ] ;
          ex:apqcSourceText "Determining the appropriate audience to direct marketing efforts at. Identify the particular group of customers to target. Discover the appropriate customer groups at a micro-level. Use techniques such as segmentation analysis, whereby the entire population is sliced according to certain demographic or behavioral attributes." ;
          ex:hierarchyID "3.3.4.3" ;
          ex:pcfID "10160" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Reuses ex:ActOfSelection (inlined): a target is chosen from candidate segments. Directive output (a target-segment definition) agrees with the selection genus." ;
          rdfs:label "Define target audience" ;
          skos:definition "An Act of Selection that chooses the target customer segment from candidate segments and produces a target segment definition." ;
          skos:example "A marketer selects the micro-segment to target after segmentation analysis." .


###  http://example.org/apqc#P10163
ex:P10163 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PricingStrategy
                          ] ;
          ex:apqcSourceText "Establishing a dynamic pricing mechanism for the organization's offerings that is supported by the number of units in production. Outline a system for determining the optimum price point for each product/service. Based this model on an estimation of the volume of anticipated sales for each offering and variable costs." ;
          ex:hierarchyID "3.3.3.3" ;
          ex:pcfID "10163" ;
          ex:requiresCapability ex:PricingCapability ;
          rdfs:comment "Directive output (a pricing strategy) agrees with the planning genus. Sales forecast is a typical input recorded here, not an existential restriction." ;
          rdfs:label "Determine pricing based on volume/unit forecast" ;
          skos:definition "An Act of Formulation that composes a pricing strategy determining optimum price points from a forecast of sales volume and variable costs." ;
          skos:example "A team builds a unit-volume pricing model that sets each offering's price point." .


###  http://example.org/apqc#P10164
ex:P10164 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PriceList
                          ] ;
          ex:apqcSourceText "Implementing the pricing mechanism to determine prices for all individual offerings in the organizational portfolio. Calculate the prices of all offerings based on the established methodology and/or formulaic structure." ;
          ex:hierarchyID "3.3.3.4" ;
          ex:pcfID "10164" ;
          ex:requiresCapability ex:PricingCapability ;
          rdfs:comment "Anchored to cco:ont00000228 (Planned Act): it executes a held pricing plan rather than making one. Directive output (a price list) is the priced realization of the methodology; pricing plan is a typical input recorded here." ;
          rdfs:label "Execute pricing plan" ;
          skos:definition "A Planned Act that applies an established pricing methodology to all offerings and produces a price list." ;
          skos:example "Pricing software applies the agreed formula to every SKU and emits the new price list." .


###  http://example.org/apqc#P10165
ex:P10165 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PricingPerformanceEvaluation
                          ] ;
          ex:apqcSourceText "Examining the efficiency of pricing with the objective of identifying any divergence from the equilibrium prices and avoiding any deadweight loss. Gauge the performance of the pricing plan by tracking growth in the revenue and/or customer uptake, secured as a result of new prices. Measure the performance of pricing by periodically checking the profits generated from the sale of each of the organization's offerings against the backdrop of any events that may have influenced the uptake of a certain good/service by the customer base." ;
          ex:hierarchyID "3.3.3.5" ;
          ex:pcfID "10165" ;
          ex:requiresCapability ex:PricingCapability ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal). Descriptive output (a performance evaluation) agrees with the appraisal genus." ;
          rdfs:label "Evaluate pricing performance" ;
          skos:definition "An Act of Appraisal that gauges the efficiency of the pricing plan and produces a pricing performance evaluation." ;
          skos:example "An analyst measures revenue growth attributable to new prices and reports pricing performance." .


###  http://example.org/apqc#P10166
ex:P10166 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PricingStrategy
                          ] ;
          ex:apqcSourceText "Refining the pricing mechanism to create equitable prices for all products/services with the objective of maximizing the profits and/or customer uptake of these offerings. Reconcile the pricing mechanism in order to achieve equilibrium pricing. Adjust the prices for all of the organization's offerings, using the insights gleaned from examining how much profit or customer uptake is generated by the present pricing strategy." ;
          ex:hierarchyID "3.3.3.6" ;
          ex:pcfID "10166" ;
          ex:requiresCapability ex:PricingCapability ;
          rdfs:comment "Directive output (a revised pricing strategy) agrees with the planning genus. Pricing performance evaluation is a typical input recorded here." ;
          rdfs:label "Refine pricing as needed" ;
          skos:definition "An Act of Formulation that adjusts the pricing mechanism toward equilibrium and produces a revised pricing strategy." ;
          skos:example "A team reconciles prices toward equilibrium based on observed profit and uptake." .


###  http://example.org/apqc#P10167
ex:P10167 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PromotionalPlan
                          ] ;
          ex:apqcSourceText "Outlining a conceptual framework for all promotional activity in order to create an overarching aspiration and ensure consistency. Create a plan for running promotional programs and designing the associated activities in order to increase visibility or sales. Determine how the organization quantifies what it wishes to achieve from these activities, what sort of messages the organization comfortable publicizing, what channels the organization wishes to employ, etc." ;
          ex:hierarchyID "3.3.4.1" ;
          ex:pcfID "10167" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Directive output (a promotional plan) agrees with the planning genus." ;
          rdfs:label "Define promotional concepts and objectives" ;
          skos:definition "An Act of Formulation that composes a promotional plan setting the conceptual framework and objectives for all promotional activity." ;
          skos:example "A team defines the promotional concept, target outcomes, and approved channels for the year." .


###  http://example.org/apqc#P10168
ex:P10168 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PromotionalPlan
                          ] ;
          ex:apqcSourceText "Developing a scheme for executing the promotional programs and campaigns, and testing these on sample audiences. Create a program plan, and carry out trials for promotional activities. Develop a scheme for how, when, where, and by whom the promotional schemes and campaigns will be deployed. Design incentives that convince or tempt the consumer to take up the organization's offerings. Conduct focus groups and pilot programs that reach out to a smaller number of people from among the target audiences to validate effectiveness." ;
          ex:hierarchyID "3.3.4.4" ;
          ex:pcfID "10168" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Directive output (a promotional plan) agrees with the planning genus. Pilot/focus-group results are typical and recorded here, not an existential restriction." ;
          rdfs:label "Plan and test promotional activities" ;
          skos:definition "An Act of Formulation that develops and trials a promotional program plan specifying how, when, where, and by whom campaigns will be deployed." ;
          skos:example "A team drafts a campaign deployment plan and validates it with focus groups." .


###  http://example.org/apqc#P10169
ex:P10169 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BrandingCollateral
                          ] ;
          ex:apqcSourceText "Executing promotional programs in the market for reaching out to the desired customer segments. Implement the promotional schemes and campaigns. Create collaterals for the dissemination of information about the product, product line, brand, or company to the target audiences in an effective manner. Leverage relationships with distributors, vendors, and retailers. Consider enlisting professional services such as design, PR, and advertising firms." ;
          ex:hierarchyID "3.3.4.5" ;
          ex:pcfID "10169" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Anchored to cco:ont00000228 (Planned Act): it carries out a held promotional plan. Directive output (branding collateral); promotional plan is a typical input recorded here." ;
          rdfs:label "Execute promotional activities" ;
          skos:definition "A Planned Act that executes promotional campaigns in the market and produces branding collateral disseminated to target audiences." ;
          skos:example "An agency deploys a campaign and ships the collateral to the target segments." .


###  http://example.org/apqc#P10170
ex:P10170 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PromotionalPerformanceEvaluation
                          ] ;
          ex:apqcSourceText "Evaluating the success of promotional programs through metrics that track the impact of these activities. Examine the performance of promotional activities. Measure the success of these programs through metrics representative of customer uptake, market penetration, sustenance of impact created, revenue growth through offerings marketed, etc. Measure through primary data collection. Analyze through various statistical techniques to generate insights." ;
          ex:hierarchyID "3.3.4.6" ;
          ex:pcfID "10170" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal). Descriptive output (a performance evaluation) agrees with the appraisal genus." ;
          rdfs:label "Evaluate promotional performance metrics" ;
          skos:definition "An Act of Appraisal that measures the success of promotional programs against metrics and produces a promotional performance evaluation." ;
          skos:example "An analyst measures uptake and revenue growth to evaluate a campaign's performance." .


###  http://example.org/apqc#P10171
ex:P10171 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ImprovementPlan
                          ] ;
          ex:apqcSourceText "Fine-tuning promotional activities by employing the insights gleaned from the quantitative, as well as any qualitative, performance evaluations. Change certain attributes of the schemes, campaigns, and programs deployed in order to increase the impact generated, in terms of measures already agreed upon such as customer uptake, market penetration, sustenance of impact created, and revenue growth through offerings marketed." ;
          ex:hierarchyID "3.3.4.7" ;
          ex:pcfID "10171" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Directive output (an improvement plan) agrees with the planning genus. Promotional performance evaluation is a typical input recorded here." ;
          rdfs:label "Refine promotional performance metrics" ;
          skos:definition "An Act of Formulation that adjusts promotional activities from evaluation insights and produces an improvement plan." ;
          skos:example "A team revises campaign attributes to raise uptake based on measured results." .


###  http://example.org/apqc#P10172
ex:P10172 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ImprovementPlan
                          ] ;
          ex:apqcSourceText "Incorporating the understanding developed by studying promotional activities as well as refining them. Include the best practices and value-enhancing attributes identified in Refine promotional activities [10171] into similarly planned schemes, programs, and campaigns. Adjust promotional activities to further increase the effectiveness of the overall promotional efforts." ;
          ex:hierarchyID "3.3.4.8" ;
          ex:pcfID "10172" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Directive output (an improvement plan) agrees with the planning genus." ;
          rdfs:label "Incorporate learning into future/planned consumer promotions" ;
          skos:definition "An Act of Formulation that incorporates lessons and best practices from prior promotions into an improvement plan for future campaigns." ;
          skos:example "Best practices from a campaign are written into the plan for next quarter's promotions." .


###  http://example.org/apqc#P10173
ex:P10173 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfForecasting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerLifetimeValue
                          ] ;
          ex:apqcSourceText "Estimating customer loyalty and the average contribution made by them to revenues, over their lifespan. Use metrics to quantify the commitment of customers to the offerings of the organization, such as measures of tendency to switch brands/providers, number/proportion of return customers, and the number of customers using multiple substitutable offerings." ;
          ex:hierarchyID "3.3.5.1" ;
          ex:pcfID "10173" ;
          rdfs:comment "Predictive output (a lifetime-value estimate) agrees with the forecasting genus per the GOLDEN PRINCIPLE." ;
          rdfs:label "Determine customer lifetime value" ;
          skos:definition "An Act of Forecasting that estimates the uncertain future revenue contribution of customers over their lifespan and produces a customer lifetime value estimate." ;
          skos:example "An analyst forecasts each segment's lifetime value from loyalty and retention measures." .


###  http://example.org/apqc#P10174
ex:P10174 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMetricAnalysis
                          ] ;
          ex:apqcSourceText "Analyzing the revenue stream generated by the sale of the organization's products/services in order to identify trends therein. Examine data relating to the inflow of revenue from individual/groups of customers in order to identify patterns in the generation and sustenance of receivables. Conduct statistical analysis over the stream of revenue collected and the point of origin associated with each unit of sale through metrics such as the accounting rate of return, the GAAP revenue over a given period, and customer lifetime revenue." ;
          ex:hierarchyID "3.3.5.2" ;
          ex:pcfID "10174" ;
          rdfs:comment "Descriptive output agrees with the information-processing genus. Customer data is a typical input recorded here." ;
          rdfs:label "Analyze customer revenue trend" ;
          skos:definition "An Act of Analysis that examines customer revenue data to identify trends and produces a customer metric analysis." ;
          skos:example "An analyst finds growth patterns in revenue by customer group." .


###  http://example.org/apqc#P10175
ex:P10175 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMetricAnalysis
                          ] ;
          ex:apqcSourceText "Calculating measures that capture the proportion of customers the organization is able to retain to those it is losing. Compute metrics such as the tendency to switch brands/providers and the proportion of return customers to comprehend the trends within the customer attrition and retention rates." ;
          ex:hierarchyID "3.3.5.3" ;
          ex:pcfID "10175" ;
          rdfs:comment "Descriptive output agrees with the information-processing genus." ;
          rdfs:label "Analyze customer attrition and retention rates" ;
          skos:definition "An Act of Analysis that computes customer attrition and retention measures and produces a customer metric analysis." ;
          skos:example "A team calculates churn and return-customer proportions to understand retention trends." .


###  http://example.org/apqc#P10176
ex:P10176 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerInsight
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMetricAnalysis
                          ] ;
          ex:apqcSourceText "Studying all measures of the customer's behavior and conduct toward the organization's offerings in order to glean insight and identify patterns into their decision making. Closely examine all categories of data sets over a customer base. Analyze data points related to customer loyalty, retention, value, conversion, level of satisfaction, attrition, etc. Flesh out measures for an all-encompassing analysis that provides a macro-level picture of the customer's behavior and mindset related to the organization's products/services." ;
          ex:hierarchyID "3.3.5.4" ;
          ex:pcfID "10176" ;
          rdfs:comment "Descriptive outputs agree with the information-processing genus." ;
          rdfs:label "Analyze customer metrics" ;
          skos:definition "An Act of Analysis that has as input customer data and produces a customer metric analysis and customer insight giving a macro-level picture of customer behavior." ;
          skos:example "An analyst studies loyalty, conversion, and satisfaction data to surface behavioral insight." .


###  http://example.org/apqc#P10177
ex:P10177 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerManagementMeasure
                          ] ;
          ex:apqcSourceText "Reviewing and reappraising the strategies, objectives, and plans for all customer-centered processes. Revisit all customer-focused processes and activities--which relate to their acquisition, conversion, and retention--with the objective of revising them in light of customer analysis. Revise accordingly." ;
          ex:hierarchyID "3.3.5.5" ;
          ex:pcfID "10177" ;
          rdfs:comment "Directive output (a revised customer-management measure) agrees with the planning genus. Customer metric analysis is a typical input recorded here." ;
          rdfs:label "Revise customer strategies, objectives, and plans based on metrics" ;
          skos:definition "An Act of Formulation that revises customer strategies, objectives, and plans in light of customer analysis and produces a revised customer management measure." ;
          skos:example "A team rewrites the customer-retention objectives after reviewing the metrics." .


###  http://example.org/apqc#P10178
ex:P10178 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PackagingStrategy
                          ] ;
          ex:apqcSourceText "Creating a strategic road map for how to package products/services into desirable solutions while increasing profitability. Create a scheme for how the organization will bundle and wrap its products/services into a presentable and sellable offering. Consider what aspects or components of an offering the organization can extract the maximum revenue from, and reduce the less profitable constituents while maintaining a high perceptible value for the customers. Balance maximizing profit with benefits to the customer." ;
          ex:hierarchyID "3.3.7.1" ;
          ex:pcfID "10178" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Directive output (a packaging strategy) agrees with the planning genus." ;
          rdfs:label "Plan packaging strategy" ;
          skos:definition "An Act of Formulation that composes a packaging strategy road map for bundling and wrapping offerings into sellable solutions." ;
          skos:example "A team drafts the road map for how products will be bundled and packaged." .


###  http://example.org/apqc#P10179
ex:P10179 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ;
          ex:apqcSourceText "Piloting the packaged products/services in the market with a test audience. Create trial runs using techniques such as focus groups of the final product, wrapped and bundled." ;
          ex:hierarchyID "3.3.7.2" ;
          ex:pcfID "10179" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Anchored to cco:ont00000228 (Planned Act): it executes trials of a held packaging strategy. The packaging strategy is a typical input and the gathered test feedback a typical output, recorded here rather than as existential restrictions." ;
          rdfs:label "Test packaging options" ;
          skos:definition "A Planned Act that pilots packaged offerings with a test audience to validate packaging options." ;
          skos:example "A team runs focus groups on wrapped, bundled product samples." .


###  http://example.org/apqc#P10180
ex:P10180 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ;
          ex:apqcSourceText "Implementing the final packaging. Put into action the packaging strategy in light of the insights accumulated from testing various options." ;
          ex:hierarchyID "3.3.7.3" ;
          ex:pcfID "10180" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Anchored to cco:ont00000228 (Planned Act): it executes a held packaging strategy. The packaging strategy is a typical input recorded here." ;
          rdfs:label "Execute packaging strategy" ;
          skos:definition "A Planned Act that implements the final packaging in line with the packaging strategy and testing insights." ;
          skos:example "Production rolls out the chosen packaging across the product line." .


###  http://example.org/apqc#P10181
ex:P10181 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PackagingStrategy
                          ] ;
          ex:apqcSourceText "Fine-tuning the packaging that has been developed and tested using insights gleaned from feedback." ;
          ex:hierarchyID "3.3.7.4" ;
          ex:pcfID "10181" ;
          ex:requiresCapability ex:MarketingManagementCapability ;
          rdfs:comment "Directive output (a revised packaging strategy) agrees with the planning genus. Customer feedback is a typical input recorded here." ;
          rdfs:label "Refine packaging" ;
          skos:definition "An Act of Formulation that fine-tunes packaging from feedback and produces a revised packaging strategy." ;
          skos:example "A team adjusts the packaging design after reviewing test feedback." .


###  http://example.org/apqc#P10182
ex:P10182 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10184
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10188
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10189
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10209
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11773
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18115
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18116
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20011
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesLead
                          ] ;
          ex:apqcSourceText "Generating leads of prospective customers to grow the organization's business. Identify viable customers based on customer and market research. Discover leads through IT applications, cold calling, reference/network development, or other sales and business development techniques. Employ a scoring model qualify the prospective customers into leads, and prioritize them." ;
          ex:hierarchyID "3.5.1" ;
          ex:pcfID "10182" ;
          rdfs:comment "Process container. 'Manage' here names the bounded lead-generation-and-qualification cycle (begin: prospecting; end: a prioritized lead set), not a standing function, so it is minted as a process whose APQC children are process parts." ;
          rdfs:label "Manage leads/opportunities" ;
          skos:definition "An Act of Selling that generates and qualifies leads of prospective customers and has as output sales leads." ;
          skos:example "A business-development team prospects, scores, and prioritizes a quarter's sales leads." .


###  http://example.org/apqc#P10183
ex:P10183 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11173
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14208
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20013
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20014
                          ] ;
          ex:apqcSourceText "Managing the customer's expectations, with the intent of responsibly increasing the sale of the organization's products/services. Create a systematic method for governing sales, using sales forecasts and customer management measures. Develop a blueprint to manage relationships with customers and the data it holds on them, as well as the sale of its products/services to these customers. Devise a recipe for handling the organization's key customers in order to manage their expectations with tact and responsibility while maximizing revenue." ;
          ex:hierarchyID "3.5.2" ;
          ex:pcfID "10183" ;
          rdfs:comment "Process container for the customer-and-account-management cycle; its APQC children are process parts. The purely standing relationship-management function (3.5.2.4) is split out as an Organization Capability (R6), not a process part." ;
          rdfs:label "Manage customers and accounts" ;
          skos:definition "An Act of Selling that governs an organization's selling to its customers and the management of their accounts, encompassing key-account selection, account planning, and master-data management." ;
          skos:example "An account team's quarterly cycle of selecting, planning, and servicing key accounts." .


###  http://example.org/apqc#P10184
ex:P10184 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10190
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10191
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10192
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10193
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20012
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesLead
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesAgreement
                          ] ;
          ex:apqcSourceText "Managing the entire sales process, from using leads to open sales to closing sales and creating records. Govern all sales activities. Make sales calls based on leads and preparatory work (drafting terms of the sale, creating proposals, suggesting prices, etc.). Close the sale, along with any administrative activities related to data entry and the processing of the sale." ;
          ex:hierarchyID "3.5.1.8" ;
          ex:pcfID "10184" ;
          rdfs:comment "Process container for the end-to-end sales-call cycle; its APQC tasks are process parts." ;
          rdfs:label "Manage customer sales calls" ;
          skos:definition "An Act of Selling that has as input sales leads and carries the sales process from opening through closing and recording, and has as output a sales agreement." ;
          skos:example "A rep works a lead through calls, pre-sales, close, and record-keeping." .


###  http://example.org/apqc#P10185
ex:P10185 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10194
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10195
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10196
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10197
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10199
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10200
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrder
                          ] ;
          ex:apqcSourceText "Taking, receiving, processing, and acknowledging new customer orders or amendments to outstanding customer orders. Monitoring status from order receipt to customer delivery/customer invoicing." ;
          ex:hierarchyID "3.5.4" ;
          ex:pcfID "10185" ;
          rdfs:comment "Process container for the order-management cycle; its APQC children are process parts." ;
          rdfs:label "Manage sales orders" ;
          skos:definition "An Act of Selling that has as input sales order data and processes customer orders from receipt through fulfillment and invoicing, and has as output sales orders." ;
          skos:example "An order desk takes, validates, and tracks a customer order to delivery." .


###  http://example.org/apqc#P10187
ex:P10187 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10211
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10214
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14209
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18641
                          ] ;
          ex:apqcSourceText "Managing the organization's partners and alliances, with the objective of maximizing revenue. Train partners regarding the organization's portfolio of products/services. Craft sales forecasts. Examine their performance. Manage all data held by the organization on these partners." ;
          ex:hierarchyID "3.5.5" ;
          ex:pcfID "10187" ;
          ex:requiresCapability ex:PartnerManagementCapability ;
          rdfs:comment "Process container for the partner-management cycle; its APQC children are process parts." ;
          rdfs:label "Manage sales partners and alliances" ;
          skos:definition "An Act of Selling that develops and governs an organization's sales partners and alliances, encompassing partner training, performance evaluation, and partner master-data management." ;
          skos:example "A channel team trains, equips, evaluates, and records its sales partners over a period." .


###  http://example.org/apqc#P10188
ex:P10188 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesLead
                          ] ;
          ex:apqcSourceText "Identifying people who can be converted into customers. Leverage personal and professional networks, business research over databases and directories, and secondary research." ;
          ex:hierarchyID "3.5.1.1" ;
          ex:pcfID "10188" ;
          rdfs:label "Identify potential customers" ;
          skos:definition "An Act of Identification that has as input customer data and market data and has as output a sales lead about a prospective customer." ;
          skos:example "A rep mines directories and networks to compile a list of viable prospects." .


###  http://example.org/apqc#P10189
ex:P10189 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesLead
                          ] ;
          ex:apqcSourceText "Qualifying the prospective customers into credible leads by gauging their behavior against the organization's offering. Triangulate leads to increase the efficiency of sales and marketing efforts. Build a detailed profile of the prospects. Determine what products/services they already use, if they have decision-making authority, their views on the products/services they already use, how prone they are to switch, if the organization's solution better in some attributes than those prospects currently use, etc." ;
          ex:hierarchyID "3.5.1.2" ;
          ex:pcfID "10189" ;
          rdfs:comment "Analysis (not selection): the act profiles and qualifies prospects into credible leads, producing a descriptive lead profile rather than committing to a choice." ;
          rdfs:label "Identify/receive leads/opportunities" ;
          skos:definition "An Act of Analysis that has as input customer data and has as output a sales lead profiling a credible prospect against the organization's offering." ;
          skos:example "An analyst triangulates prospect behavior and builds a detailed qualified-lead profile." .


###  http://example.org/apqc#P10190
ex:P10190 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SalesPersonnel
                          ] ;
          ex:apqcSourceText "Communicating with customers and prospects with the intent of creating sales opportunities. Reach out to existing and prospective customers through alternate media and networking channels, apart from cold calling/emailing." ;
          ex:hierarchyID "3.5.1.8.1" ;
          ex:pcfID "10190" ;
          ex:requiresRole ex:SalesProfessionalRole ;
          rdfs:label "Perform sales calls" ;
          skos:definition "An Act of Selling in which sales personnel communicate with customers and prospects with the intent of creating sales opportunities." ;
          skos:example "A rep cold-calls and emails prospects to open new opportunities." .


###  http://example.org/apqc#P10191
ex:P10191 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesProposal
                          ] ;
          ex:apqcSourceText "Capitalizing on sales calls by pitching on bids and closing deals. Outline the nature and scope of the work, draft agreement terms, prepare proposals and agreements, and propose timelines and prices." ;
          ex:hierarchyID "3.5.1.8.2" ;
          ex:pcfID "10191" ;
          rdfs:comment "RE-ANCHORED (Gate-F): the output ex:SalesProposal is a DIRECTIVE ICE (cco:ont00000965), but the prior genus ex:ActOfSelling is a transactional Planned Act (transfer of a good/service for a Financial Instrument) that carries no directive-output requirement -- a GOLDEN PRINCIPLE / false-friend violation ('sales' context misread as a sale transaction). Drafting scope/terms/pricing and assembling a proposal is authoring a Directive ICE, i.e. an Act of Formulation. Re-anchored to ex:ActOfFormulation, matching the sibling proposal-authoring rows P20015 (develop solution/delivery approach) and P20018 (revise bid/proposal). The directive output drives the Formulation genus (GOLDEN PRINCIPLE)." ;
          rdfs:label "Perform pre-sales activities" ;
          skos:definition "An Act of Formulation that prepares the terms, scope, and pricing of a deal and has as output a sales proposal." ;
          skos:example "A rep drafts scope, timeline, and price and assembles a proposal for a prospect." .


###  http://example.org/apqc#P10192
ex:P10192 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesAgreement
                          ] ;
          ex:apqcSourceText "Formalizing a sale by reaching an agreement on terms of the deal. Negotiate on the price, and reach a consensus on the terms and conditions." ;
          ex:hierarchyID "3.5.1.8.4" ;
          ex:pcfID "10192" ;
          rdfs:label "Close the sale" ;
          skos:definition "An Act of Selling that formalizes a sale by negotiating and reaching a sales agreement on the terms of the deal." ;
          skos:example "A rep negotiates final price and terms and the customer signs the agreement." .


###  http://example.org/apqc#P10193
ex:P10193 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrder
                          ] ;
          ex:apqcSourceText "Completing all the paper-work associated with the sale of its products/services. Exchange any pertinent legal/financial information required for completing the sale, signing of a contract/work-order, and issuing copies of bills/invoices." ;
          ex:hierarchyID "3.5.1.8.5" ;
          ex:pcfID "10193" ;
          rdfs:comment "Anchored at cco:ont00000366 (Act of Information Processing): the act stores and registers sale documentation (contracts, invoices)." ;
          rdfs:label "Record outcome of sales process" ;
          skos:definition "An Act of Information Processing that records the completed sale by capturing its legal and financial documentation and has as output a sales order." ;
          skos:example "After close, the back office files the contract and issues the invoice and order record." .


###  http://example.org/apqc#P10194
ex:P10194 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrder
                          ] ;
          ex:apqcSourceText "Receiving and confirming orders from customers. Verify that no extra expenses have to be disbursed on part of the organization for labor or inventory when processing the order." ;
          ex:hierarchyID "3.5.4.1" ;
          ex:pcfID "10194" ;
          rdfs:comment "Anchored at cco:ont00000366 (Act of Information Processing): the act receives and validates the order data, yielding a confirmed Directive sales order." ;
          rdfs:label "Accept and validate sales orders" ;
          skos:definition "An Act of Information Processing that has as input sales order data and has as output a confirmed sales order." ;
          skos:example "An order clerk confirms a customer order after checking it for hidden costs." .


###  http://example.org/apqc#P10195
ex:P10195 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10201
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10202
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10203
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10204
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10205
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10206
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10207
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10208
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Collecting and maintaining all account information. Collect information about the purchase, servicing, return, and/or commitment of any products/services on part of the organization to its customers. Bring together information from various organizational divisions, and update periodically." ;
          ex:hierarchyID "3.5.4.2" ;
          ex:pcfID "10195" ;
          rdfs:comment "Process container for the account-information tasks; its APQC tasks are process parts." ;
          rdfs:label "Collect and maintain account information" ;
          skos:definition "An Act of Information Processing that collects and maintains customer account information and has as output customer master data." ;
          skos:example "An order team consolidates purchase, service, and return history per account." .


###  http://example.org/apqc#P10196
ex:P10196 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ;
          ex:apqcSourceText "Ascertaining the volume or scale of products/services to provide to customers to fulfill sales orders. Check the finished products stored in warehouses, the production capacity, and (in the case of services) the processing speed, as well as work force availability." ;
          ex:hierarchyID "3.5.4.3" ;
          ex:pcfID "10196" ;
          rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): the act assesses available supply against order demand. The availability judgement is descriptive; left to comment per Phase-3 necessity." ;
          rdfs:label "Determine availability" ;
          skos:definition "An Act of Appraisal that has as input sales order data and judges the availability of products, services, capacity, and workforce to fulfill an order." ;
          skos:example "An order planner checks stock and capacity before confirming a delivery date." .


###  http://example.org/apqc#P10197
ex:P10197 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FulfillmentPlan
                          ] ;
          ex:apqcSourceText "Devising a blueprint for order fulfillment. Create a schematic flow encompassing all activities to deliver orders to the customers. Outline a procedure for satisfying these orders by answering questions about what needs to happen in sequence to realize an order." ;
          ex:hierarchyID "3.5.4.4" ;
          ex:pcfID "10197" ;
          rdfs:comment "Anchored at ex:ActOfFormulation: composes a Directive ICE (the fulfillment plan). GOLDEN PRINCIPLE satisfied." ;
          rdfs:label "Determine fulfillment process" ;
          skos:definition "An Act of Formulation that has as output an order fulfillment plan prescribing the sequence of activities to deliver a customer's order." ;
          skos:example "An operations planner drafts the fulfillment workflow for an order type." .


###  http://example.org/apqc#P10199
ex:P10199 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrder
                          ] ;
          ex:apqcSourceText "Processing any unfulfilled orders, and updating the status of any orders that have been accepted and are being attended to. Deliver on any purchase orders that remain unserviced due to temporary unavailability of the product/service. Manage any updates to the sales orders. Revise their status in the order system." ;
          ex:hierarchyID "3.5.4.5" ;
          ex:pcfID "10199" ;
          rdfs:comment "Anchored at cco:ont00000366 (Act of Information Processing): the act revises order-status data in the order system." ;
          rdfs:label "Process back orders and updates" ;
          skos:definition "An Act of Information Processing that has as input sales order data and updates the status of back-ordered and in-progress sales orders." ;
          skos:example "A clerk re-queues a back-ordered line and updates its status." .


###  http://example.org/apqc#P10200
ex:P10200 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SalesOrderData
                          ] ;
          ex:apqcSourceText "Attending to any queries received from the customers, even after a sales order has been serviced. Deploy ad hoc personnel for managing these enquiries." ;
          ex:hierarchyID "3.5.4.6" ;
          ex:pcfID "10200" ;
          rdfs:comment "Anchored at cco:ont00000402 (Act of Communication): the act transfers information between the customer and the organization in response to a query." ;
          rdfs:label "Handle sales order inquiries including post-order fulfillment transactions" ;
          skos:definition "An Act of Communication in which personnel respond to customer inquiries about a sales order, including after fulfillment." ;
          skos:example "Support answers a customer's question about a delivered order." .


###  http://example.org/apqc#P10201
ex:P10201 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Managing essential information of customer accounts." ;
          ex:hierarchyID "3.5.4.2.1" ;
          ex:pcfID "10201" ;
          rdfs:label "Administer key account details" ;
          skos:definition "An Act of Information Processing that maintains the essential information of customer accounts and has as output customer master data." ;
          skos:example "An admin updates the master record for a key account." .


###  http://example.org/apqc#P10202
ex:P10202 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Obtaining detailed information about customers." ;
          ex:hierarchyID "3.5.4.2.2" ;
          ex:pcfID "10202" ;
          rdfs:label "Retrieve full customer details" ;
          skos:definition "An Act of Information Processing that has as input customer master data and retrieves the detailed information held about a customer." ;
          skos:example "An agent pulls a customer's full account profile for servicing." .


###  http://example.org/apqc#P10203
ex:P10203 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Altering information about involved parties." ;
          ex:hierarchyID "3.5.4.2.3" ;
          ex:pcfID "10203" ;
          rdfs:label "Modify involved party details" ;
          skos:definition "An Act of Information Processing that revises the recorded information about parties involved in a customer account." ;
          skos:example "An agent updates a contact's role on an account." .


###  http://example.org/apqc#P10204
ex:P10204 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Documenting address information." ;
          ex:hierarchyID "3.5.4.2.4" ;
          ex:pcfID "10204" ;
          rdfs:label "Record address details" ;
          skos:definition "An Act of Information Processing that records the address information of a customer or involved party." ;
          skos:example "An agent records a new shipping address on the account." .


###  http://example.org/apqc#P10205
ex:P10205 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Documenting contact information." ;
          ex:hierarchyID "3.5.4.2.5" ;
          ex:pcfID "10205" ;
          rdfs:label "Record contact details" ;
          skos:definition "An Act of Information Processing that records the contact information of a customer or involved party." ;
          skos:example "An agent records a contact's phone and email on the account." .


###  http://example.org/apqc#P10206
ex:P10206 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Providing information about important business rules regarding communicating with customers." ;
          ex:hierarchyID "3.5.4.2.6" ;
          ex:pcfID "10206" ;
          rdfs:label "Record key customer communication profile details" ;
          skos:definition "An Act of Information Processing that records the communication-profile information and preferences governing contact with a customer." ;
          skos:example "An agent records a customer's opt-out and preferred-channel rules." .


###  http://example.org/apqc#P10207
ex:P10207 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Revising information about involved parties." ;
          ex:hierarchyID "3.5.4.2.7" ;
          ex:pcfID "10207" ;
          rdfs:label "Review involved party information" ;
          skos:definition "An Act of Information Processing that has as input customer master data and reviews the recorded information about involved parties." ;
          skos:example "An agent reviews the parties listed on an account for accuracy." .


###  http://example.org/apqc#P10208
ex:P10208 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerMasterData
                          ] ;
          ex:apqcSourceText "Dismissing information about involved parties." ;
          ex:hierarchyID "3.5.4.2.8" ;
          ex:pcfID "10208" ;
          rdfs:label "Terminate involved party information" ;
          skos:definition "An Act of Information Processing that deactivates or removes the recorded information about an involved party from a customer account." ;
          skos:example "An agent retires a departed contact from the account record." .


###  http://example.org/apqc#P10209
ex:P10209 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ;
          ex:apqcSourceText "Planning the distribution of personnel across various sales functions. Match the capabilities of individual employees with the skill sets needed for specific roles. Seek assistance from HR." ;
          ex:hierarchyID "3.5.1.7" ;
          ex:pcfID "10209" ;
          rdfs:comment "Anchored at cco:ont00000511 (Act of Planning): output is a Directive resource-allocation plan. Modeled in this comment rather than as a restriction because no single named artifact is definitional for every instance (Phase-3 necessity rule)." ;
          rdfs:label "Determine sales resource allocation" ;
          skos:definition "An Act of Planning that determines and prescribes the distribution of sales personnel across an organization's sales functions." ;
          skos:example "A sales director plans the assignment of reps to territories and accounts for the year." .


###  http://example.org/apqc#P10210
ex:P10210 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:IncentivePlan
                          ] ;
          ex:apqcSourceText "Creating a scheme of awards and recognition for sales employees to promote a results-based culture. Create specific incentives to reach desired outcomes, such as landing key clients, growing the customer base, providing exceptional servicing, and increasing profit margins." ;
          ex:hierarchyID "7.1.2.3.1" ;
          ex:pcfID "10210" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive incentive plan (Directive ICE). Process part of 7.1.2.3." ;
          rdfs:label "Establish incentive strategy" ;
          skos:definition "An Act of Formulation that produces an incentive plan specifying a scheme of awards and recognition designed to drive desired employee outcomes." ;
          skos:example "HR designs a sales-incentive program rewarding new-client acquisition." .


###  http://example.org/apqc#P10211
ex:P10211 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:SalesPartner
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20019
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20020
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20021
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesTrainingMaterial
                          ] ;
          ex:apqcSourceText "Imparting guidance and instruction to sales partners/alliances concerning products/services. Distribute literature about the organization's products/services. Conduct workshops. Disseminate useful media content to engage and enlighten partners. Create communities through group engagements." ;
          ex:hierarchyID "3.5.5.1" ;
          ex:pcfID "10211" ;
          ex:requiresRole ex:SalesPartnerRole ;
          rdfs:comment "Anchored at cco:ont00000402 (Act of Communication): training material (an ICE) is transferred to partners. Process container; its APQC tasks are process parts." ;
          rdfs:label "Provide sales and product/service training to sales partners/alliances" ;
          skos:definition "An Act of Communication that transfers sales training material about an organization's products and services to its sales partners and alliances." ;
          skos:example "A partner-enablement team runs product workshops for resellers." .


###  http://example.org/apqc#P10214
ex:P10214 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PartnerEvaluation
                          ] ;
          ex:apqcSourceText "Examining the performance of its partners/alliances in selling its products/services. Use metrics such as growth in revenue generated, conversion rate, and total outreach to customers for assessing the performance results." ;
          ex:hierarchyID "3.5.5.3" ;
          ex:pcfID "10214" ;
          rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal). GOLDEN PRINCIPLE: appraisal genus agrees with descriptive output (ex:PartnerEvaluation, is about SalesPartner)." ;
          rdfs:label "Evaluate partner/alliance results" ;
          skos:definition "An Act of Appraisal that judges the selling performance of an organization's sales partners and has as output a partner/alliance evaluation." ;
          skos:example "A channel manager scores each reseller on revenue growth and conversion." .


###  http://example.org/apqc#P10215
ex:P10215 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10221
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10222
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10223
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10224
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10226
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10227
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10368
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P17042
                          ] ;
          ex:apqcSourceText "Creating strategies for production and materials. Handle the demand for the products of the organization. Develop plans for handling materials. Develop and administer the schedule for master production. Plan for distribution requirements and its constraints by reviewing and assessing distribution policies and performance and by establishing quality standards and procedures." ;
          ex:hierarchyID "4.1" ;
          ex:pcfID "10215" ;
          ex:requiresCapability ex:SupplyChainManagementCapability ,
                                ex:SupplyChainPlanningCapability ;
          rdfs:comment "Models APQC process group 4.1 as an occurrent whose APQC children are process parts (cco:ont00001777), mirroring the GOLD treatment of group-level nodes. Not given existential has-process-part to it from Category 4.0 (R3)." ;
          rdfs:label "Plan for and align supply chain resources" ;
          skos:definition "An Act of Planning that aligns an organization's supply chain resources by formulating production, materials, demand, scheduling, distribution, and quality plans." ;
          skos:example "An organization's annual supply-chain planning cycle aligning production, materials, and distribution resources." .


###  http://example.org/apqc#P10216
ex:P10216 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10277
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10278
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10279
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10280
                          ] ;
          ex:apqcSourceText "Creating a plan for procuring materials and services. Develop strategies for sourcing materials and services. Choose the most appropriate suppliers, and develop contracts with them. Order the materials and services as per the requirements. Manage relationships with suppliers." ;
          ex:hierarchyID "4.2" ;
          ex:pcfID "10216" ;
          ex:requiresCapability ex:ProcurementCapability ,
                                ex:SupplyChainManagementCapability ;
          rdfs:comment "Models APQC process group 4.2 as a bounded procurement cycle. Its APQC children are process parts, not subclasses. No definitional single output; the cycle's deliverables are carried by its parts." ;
          rdfs:label "Procure materials and services" ;
          skos:definition "An Act of Acquisition that obtains the materials and services an organization requires by planning sourcing, selecting suppliers, ordering, and managing supplier relationships." ;
          skos:example "A manufacturer's quarterly procurement cycle from sourcing strategy through supplier management." .


###  http://example.org/apqc#P10217
ex:P10217 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfProduction ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:FinishedProduct
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10303
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10304
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10369
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10370
                          ] ;
          ex:apqcSourceText "Processing and delivering the finished goods manufactured by the organization. Schedule the production of products. Execute the product production activities. Perform tests to oversee and ensure quality of production. Maintain records of the production process. Track lots." ;
          ex:hierarchyID "4.3" ;
          ex:pcfID "10217" ;
          ex:requiresCapability ex:ProductionCapability ,
                                ex:SupplyChainManagementCapability ;
          rdfs:comment "Models APQC process group 4.3 as a bounded production-and-test cycle (occurrent). Its APQC children are process parts (cco:ont00001777), never subclasses." ;
          rdfs:label "Produce/Assemble/Test product" ;
          skos:definition "An Act of Production that schedules, executes, tests, and records the manufacture of an organization's physical products, yielding tested finished products and production records." ;
          skos:example "A plant's end-to-end run for a production order: scheduling, manufacturing, quality testing, and lot record-keeping." .


###  http://example.org/apqc#P10218
ex:P10218 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10320
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10321
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10322
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10323
                          ] ;
          ex:apqcSourceText "Validating specific service requirements for individual customers. Determine and schedule resource to fulfill these requirements. Provide service to specific individual customers. Ensure the quality of service delivery." ;
          ex:hierarchyID "6.3.4" ;
          ex:pcfID "10218" ;
          rdfs:comment "Although the APQC label is 'Service products', the Element Description denotes an end-to-end individual service-delivery process. Genus ex:ActOfServiceProvision (operations shared genus): bounded end-to-end service delivery. Its APQC children are process parts." ;
          rdfs:label "Service products" ;
          skos:definition "An Act of Service Provision that validates a customer's service requirements, schedules resources, renders the service, and assures its quality." ;
          skos:example "A field-service operation confirms requirements, schedules a technician, performs the repair, and follows up on quality." .


###  http://example.org/apqc#P10221
ex:P10221 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10229
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10230
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10231
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10232
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10233
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10234
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14193
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14194
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19551
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionAndMaterialsStrategy
                          ] ;
          ex:apqcSourceText "Creating strategies for production processes, as well as the process of managing materials. Define production and supply constraints. Design a blueprint of the workplace. Establish rules and regulations regarding the employees, outsourcing of services, and the expenditure to be incurred on the manufacturing capital." ;
          ex:hierarchyID "4.1.1" ;
          ex:pcfID "10221" ;
          rdfs:comment "Models APQC 4.1.1 as an occurrent. Its APQC children are process parts, not subclasses." ;
          rdfs:label "Develop production and materials strategies" ;
          skos:definition "An Act of Formulation that composes the strategies, policies, and constraints governing an organization's production processes and materials management, producing a production and materials strategy." ;
          skos:example "An operations team drafts the plant's production strategy together with its labor, outsourcing, and capital-expense policies." .


###  http://example.org/apqc#P10222
ex:P10222 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10235
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10236
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10237
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10238
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10239
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10240
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10241
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ConsensusDemandForecast
                          ] ;
          ex:apqcSourceText "Forecasting demand for products using secondary research and customer feedback. Refine these forecasts. Inspect the approach used in creating forecasts, and determine its accuracy." ;
          ex:hierarchyID "4.1.2" ;
          ex:pcfID "10222" ;
          rdfs:comment "Modeled as a bounded forecasting process (Act of Analysis), not an Organization Capability: the APQC description is a delimited forecast-refine-inspect cycle producing a Descriptive forecast. Its APQC children are process parts." ;
          rdfs:label "Manage demand for products" ;
          skos:definition "An Act of Analysis that forecasts and refines demand for an organization's products and has as output a consensus demand forecast." ;
          skos:example "The demand-planning team runs its monthly forecasting cycle and signs off a consensus forecast." .


###  http://example.org/apqc#P10223
ex:P10223 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10242
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10243
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10244
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10245
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10246
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14196
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MaterialsPlan
                          ] ;
          ex:apqcSourceText "Developing a scheme that allows for advance planning for the availability of raw materials and spares. Start with an unconstrained plan, and refine based on supply chain realities by identifying critical materials required for production, checking material specifications, and collaborating with all vendors over the supply." ;
          ex:hierarchyID "4.1.3" ;
          ex:pcfID "10223" ;
          rdfs:comment "Models APQC 4.1.3 as an occurrent; its APQC children are process parts." ;
          rdfs:label "Create materials plan" ;
          skos:definition "An Act of Formulation that produces a materials plan for the advance availability of raw materials and spares, refined from an unconstrained to a constrained plan." ;
          skos:example "Materials planning produces and then constrains the quarter's raw-material supply plan." .


###  http://example.org/apqc#P10224
ex:P10224 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P17041
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20023
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20024
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MasterProductionSchedule
                          ] ;
          ex:apqcSourceText "Taking care of the master production plan. The master production includes creation and implementation of the site-level production plan, as well as management of the inventory that is currently in the production process." ;
          ex:hierarchyID "4.1.4" ;
          ex:pcfID "10224" ;
          rdfs:comment "Modeled as a bounded scheduling process (Act of Scheduling), not an Organization Capability: the description centers on creating and re-setting a concrete schedule. Its APQC children are process parts." ;
          rdfs:label "Create and manage master production schedule" ;
          skos:definition "An Act of Scheduling that creates and maintains the site-level master production schedule and has as output a master production schedule." ;
          skos:example "Production control builds and weekly-updates the site master production schedule." .


###  http://example.org/apqc#P10226
ex:P10226 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10267
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10268
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10269
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19558
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DistributionPlanningConstraintSpecification
                          ] ;
          ex:apqcSourceText "Instituting the constraints for planning of distribution process. Create a plan that specifies every element in the distribution process from the blueprint of the distribution centers to how and when the inventory would reach the distribution centers." ;
          ex:hierarchyID "4.1.6" ;
          ex:pcfID "10226" ;
          rdfs:comment "Models APQC 4.1.6 as an occurrent; its APQC children are process parts." ;
          rdfs:label "Establish distribution planning constraints" ;
          skos:definition "An Act of Formulation that has as output a distribution planning constraint specification instituting the constraints governing the distribution process." ;
          skos:example "Network planning fixes the layout, inventory, transport, and storage constraints for the next design cycle." .


###  http://example.org/apqc#P10227
ex:P10227 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10264
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10265
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10266
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DistributionPolicy
                          ] ;
          ex:apqcSourceText "Revisiting and refurbishing the policies for planning the distribution process. Asses the distribution strategies, including how the products are to be made available and sent to different distributors. Set guidelines regarding relationships between the sources and the distribution centers." ;
          ex:hierarchyID "4.1.7" ;
          ex:pcfID "10227" ;
          rdfs:comment "Anchored to Act of Appraisal (the lead verb 'Review/Assess' is a judgement). Its APQC children are process parts; revised policy is produced by child 4.1.7.3." ;
          rdfs:label "Review distribution planning policies" ;
          skos:definition "An Act of Appraisal that has as input a distribution policy and reassesses the organization's distribution strategies and sourcing guidelines." ;
          skos:example "The logistics council reviews and updates the distribution policy at year end." .


###  http://example.org/apqc#P10229
ex:P10229 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ManufacturingGoalSpecification
                          ] ;
          ex:apqcSourceText "Creating quantifiable strategic objectives for each manufacturing segment in conjunction with sales projections." ;
          ex:hierarchyID "4.1.1.1" ;
          ex:pcfID "10229" ;
          rdfs:label "Define manufacturing goals" ;
          skos:definition "An Act of Formulation that has as output a manufacturing goal specification setting quantifiable strategic objectives for each manufacturing segment." ;
          skos:example "Planners set per-line output targets aligned with the annual sales projection." .


###  http://example.org/apqc#P10230
ex:P10230 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LaborAndMaterialsPolicy
                          ] ;
          ex:apqcSourceText "Setting up internal rules and regulations regarding the employees and the materials." ;
          ex:hierarchyID "4.1.1.2" ;
          ex:pcfID "10230" ;
          rdfs:label "Define labor and materials policies" ;
          skos:definition "An Act of Formulation that has as output a labor and materials policy prescribing internal rules governing employees and materials." ;
          skos:example "HR and operations jointly issue the plant's labor and materials handling policy." .


###  http://example.org/apqc#P10231
ex:P10231 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OutsourcingPolicy
                          ] ;
          ex:apqcSourceText "Creating rules and regulations regarding contracting out of a business process to another party in order to reduce costs." ;
          ex:hierarchyID "4.1.1.3" ;
          ex:pcfID "10231" ;
          rdfs:label "Define outsourcing policies" ;
          skos:definition "An Act of Formulation that has as output an outsourcing policy prescribing rules for contracting business processes to external parties." ;
          skos:example "Management publishes the criteria under which production steps may be outsourced." .


###  http://example.org/apqc#P10232
ex:P10232 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CapitalExpensePolicy
                          ] ;
          ex:apqcSourceText "Designing rules and regulations pertaining to the expenditure incurred in acquiring or upgrading the existing stock of manufacturing capital." ;
          ex:hierarchyID "4.1.1.4" ;
          ex:pcfID "10232" ;
          rdfs:label "Define capital expense policies" ;
          skos:definition "An Act of Formulation that has as output a capital expense policy prescribing rules for spending on acquiring or upgrading manufacturing capital." ;
          skos:example "Finance issues the capex approval thresholds for new production equipment." .


###  http://example.org/apqc#P10233
ex:P10233 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CapacityAssessment
                          ] ;
          ex:apqcSourceText "Outlining the manufacturing and processing capacities of the organization. Delineate the capabilities required for optimizing output with available resources. Analyze capabilities possessed by the organization concerning the raw materials required and the process necessitated for producing finished products." ;
          ex:hierarchyID "4.1.1.5" ;
          ex:pcfID "10233" ;
          rdfs:comment "Anchored to Act of Analysis (not Formulation) because the lead activity examines existing capabilities and produces a Descriptive capacity assessment rather than a prescription." ;
          rdfs:label "Define capacities" ;
          skos:definition "An Act of Analysis that examines the organization's manufacturing and processing capabilities and has as output a capacity assessment." ;
          skos:example "Engineers analyze line throughput and report the plant's effective production capacity." .


###  http://example.org/apqc#P10234
ex:P10234 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionNetworkModel
                          ] ;
          ex:apqcSourceText "Defining limitations in the ability of the organization's supply chain to deliver a new stock, and creating a network of production stakeholders. Frame and manage relationships within the flow of manufacturing and processing operations. Identify probable supply issues." ;
          ex:hierarchyID "4.1.1.6" ;
          ex:pcfID "10234" ;
          rdfs:label "Define production network and supply constraints" ;
          skos:definition "An Act of Formulation that has as output a production network model representing the network of production stakeholders and its supply constraints." ;
          skos:example "Supply-chain planners map the production stakeholder network and document its binding supply constraints." .


###  http://example.org/apqc#P10235
ex:P10235 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BaselineDemandForecast
                          ] ;
          ex:apqcSourceText "Identify the bedrock levels of market demand anticipated for the organization's products/services. Estimate future demand for product and services using historical data, analysis of the market environment and any externalities, etc. to create ex ante approximations." ;
          ex:hierarchyID "4.1.2.1" ;
          ex:pcfID "10235" ;
          rdfs:label "Develop baseline demand forecasts" ;
          skos:definition "An Act of Analysis that has as output a baseline demand forecast estimating anticipated market demand from historical and market data." ;
          skos:example "An analyst builds a statistical baseline forecast from three years of shipment history." .


###  http://example.org/apqc#P10236
ex:P10236 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfForecasting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Customer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DemandForecast
                          ] ;
          ex:apqcSourceText "Working closely with the organization's customers to understand their drives and behavior, with the objective of estimating future demand. Reach out to customers through various means to understand their behavior patterns, usage elasticity, and degree of variability--and ultimately determine demand for each offering." ;
          ex:hierarchyID "4.1.2.2" ;
          ex:pcfID "10236" ;
          ex:requiresRole ex:CustomerRole ;
          rdfs:comment "Re-anchored from ex:ActOfAnalysis to ex:ActOfForecasting: the act's definitional output is a Predictive ICE (ex:DemandForecast) and the source's objective is 'estimating future demand'. Customer collaboration is the method; the product is a forecast, matching the corpus pattern (slice 5's demand-forecast acts P20043/P20045 use ex:ActOfForecasting). Customer is a definitional participant (the act is constituted by working with customers)." ;
          rdfs:label "Collaborate demand with customers" ;
          skos:definition "An Act of Forecasting that works with customers to understand their behavior and, with that input, estimates future demand, producing a demand forecast." ;
          skos:example "Planners run joint demand-review sessions with key accounts to refine the forecast." .


###  http://example.org/apqc#P10237
ex:P10237 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ManagementPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BaselineDemandForecast
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ConsensusDemandForecast
                          ] ;
          ex:apqcSourceText "Arriving at a consensus over the forecasted levels of demand for products/services. Consensus is achieved by juxtaposing decisions developed in the baseline forecast with those reached at by collaborating with customers. Enlist senior-level decision makers of the sales and marketing functions." ;
          ex:hierarchyID "4.1.2.3" ;
          ex:pcfID "10237" ;
          ex:requiresRole ex:ManagerRole ;
          rdfs:comment "Management personnel participate as definitional senior decision makers." ;
          rdfs:label "Develop demand consensus forecast" ;
          skos:definition "An Act of Analysis that has as input a baseline demand forecast and has as output a consensus demand forecast reconciling baseline and customer-collaboration estimates." ;
          skos:example "Sales, marketing, and operations leaders sign off one consensus number in the S&OP meeting." .


###  http://example.org/apqc#P10238
ex:P10238 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AvailableToPromiseQuantity
                          ] ;
          ex:apqcSourceText "Identify the volume of products/services that may be committed for delivery to fulfill sales. Figure out the amount of stock available. Forecast its volumes." ;
          ex:hierarchyID "4.1.2.4" ;
          ex:pcfID "10238" ;
          rdfs:label "Determine available to promise" ;
          skos:definition "An Act of Analysis that has as output an available-to-promise quantity stating the volume of product that may be committed for delivery." ;
          skos:example "Planning computes the ATP quantity available against open sales orders for the week." .


###  http://example.org/apqc#P10239
ex:P10239 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ConsensusDemandForecast
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ConsensusDemandForecast
                          ] ;
          ex:apqcSourceText "Picking out any activity that deviates from the forecast, and adjusting it. Closely track and study the levels of demand as they emerge. Refine the consensus forecast as needed." ;
          ex:hierarchyID "4.1.2.5" ;
          ex:pcfID "10239" ;
          rdfs:label "Monitor activity against demand forecast and revise forecast" ;
          skos:definition "An Act of Monitoring that has as input a consensus demand forecast, tracks emerging demand against it, and has as output a revised consensus demand forecast." ;
          skos:example "Demand planners watch actual orders versus forecast and adjust the number mid-cycle." .


###  http://example.org/apqc#P10240
ex:P10240 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ForecastingMethodologyAssessment
                          ] ;
          ex:apqcSourceText "Examining the methodology used to estimate future demand. Refine it in light of current market realities and demand." ;
          ex:hierarchyID "4.1.2.6" ;
          ex:pcfID "10240" ;
          rdfs:comment "Anchored to Act of Appraisal because the lead activity evaluates/judges the forecasting METHODOLOGY. Gate-F fix: removed the erroneous [has output some ex:DemandForecastAccuracyReport] restriction -- an accuracy report appraises the forecasts and is the output of the sibling Measure demand forecast accuracy [10241], not of this act, which appraises the method. The definitional output is now ex:ForecastingMethodologyAssessment (Descriptive ICE), agreeing with the Appraisal genus (GOLDEN PRINCIPLE). The refined approach is noted in the source but not asserted as a definitional output (Phase-3 necessity)." ;
          rdfs:label "Evaluate and revise demand forecasting approach" ;
          skos:definition "An Act of Appraisal that examines the demand-forecasting methodology and produces a forecasting methodology assessment judging its fitness for current market realities." ;
          skos:example "A planning lead reviews whether the current forecasting model still fits a volatile market." .


###  http://example.org/apqc#P10241
ex:P10241 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ConsensusDemandForecast
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DemandForecastAccuracyReport
                          ] ;
          ex:apqcSourceText "Calculating and inspecting the accuracy of demand forecasts. Use metrics to check the reliability of the forecasts created." ;
          ex:hierarchyID "4.1.2.7" ;
          ex:pcfID "10241" ;
          rdfs:label "Measure demand forecast accuracy" ;
          skos:definition "An Act of Appraisal that has as input a consensus demand forecast and has as output a demand forecast accuracy report judging the reliability of the forecasts." ;
          skos:example "The team computes MAPE for last quarter's forecasts and reports the accuracy." .


###  http://example.org/apqc#P10242
ex:P10242 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:UnconstrainedMaterialsPlan
                          ] ;
          ex:apqcSourceText "Developing a plan for raw materials and other inventory items in order to meet market demand. Ensure the availability of all inventory items such as raw materials and spares. Create a blueprint in line with Define labor and materials policies [10230]." ;
          ex:hierarchyID "4.1.3.1" ;
          ex:pcfID "10242" ;
          rdfs:comment "Source cross-references Define labor and materials policies [10230]; that policy is a typical, not definitional, input." ;
          rdfs:label "Create unconstrained plan" ;
          skos:definition "An Act of Formulation that has as output an unconstrained materials plan ensuring the availability of raw materials and spares to meet market demand." ;
          skos:example "Planning drafts the ideal materials plan ignoring supplier limits as a first pass." .


###  http://example.org/apqc#P10243
ex:P10243 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ContractManufacturer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Supplier
                          ] ;
          ex:apqcSourceText "Collaborating with vendors and contractual manufacturers with the objective of ensuring a continual supply of raw materials and spares. Leverage long-term connections/relationships with various suppliers, and cultivate new ones. Track the activities of all vendors. Receive regular updates to prepare for any fluctuations in supply." ;
          ex:hierarchyID "4.1.3.2" ;
          ex:pcfID "10243" ;
          ex:requiresRole ex:SupplierRole ;
          rdfs:comment "Anchored to Act of Information Processing (receiving and acting on supply updates). Supplier and Contract Manufacturer are definitional participants; no single ICE output is definitional, so none is asserted as a restriction." ;
          rdfs:label "Collaborate with supplier and contract manufacturers" ;
          skos:definition "An Act of Information Processing in which an organization coordinates with suppliers and contract manufacturers to secure a continual supply of raw materials and spares." ;
          skos:example "Procurement holds standing supply reviews with strategic vendors and tracks their output." .


###  http://example.org/apqc#P10244
ex:P10244 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierCapacityProfile
                          ] ;
          ex:apqcSourceText "Identifying principal materials needed for the manufacturing process and the levels of supply that may be ensured for them. Determine the essential and crucial inventory items required for the smooth functioning of all manufacturing processes. Estimate the average, peak, and baseline capacities of various vendors and suppliers. Establish the capability of individual suppliers from the market and the vendors." ;
          ex:hierarchyID "4.1.3.3" ;
          ex:pcfID "10244" ;
          rdfs:label "Identify critical materials and supplier capacity" ;
          skos:definition "An Act of Identification that discerns the critical materials required for production and has as output a supplier capacity profile estimating vendor supply levels." ;
          skos:example "Sourcing flags the single-source materials and profiles each supplier's peak capacity." .


###  http://example.org/apqc#P10245
ex:P10245 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MaterialSpecification
                          ] ;
          ex:apqcSourceText "Observing and surveying all inventory items in order to check for the veracity of their specifications. Monitor various attributes and characteristics for respective inventory items such as density, volume, and size, as well as contextualized specifications particular to the respective materials." ;
          ex:hierarchyID "4.1.3.4" ;
          ex:pcfID "10245" ;
          rdfs:label "Monitor material specifications" ;
          skos:definition "An Act of Monitoring that has as input material specifications and surveys inventory items to verify their conformance to those specifications." ;
          skos:example "QA tracks incoming lots against the material spec for density and dimensional tolerance." .


###  http://example.org/apqc#P10246
ex:P10246 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SupplierCapacityProfile
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:UnconstrainedMaterialsPlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ConstrainedMaterialsPlan
                          ] ;
          ex:apqcSourceText "Generating a bounded plan that takes stock of the actual supply chain scenario. Take stock of all information collected while creating an inventory supply plan." ;
          ex:hierarchyID "4.1.3.5" ;
          ex:pcfID "10246" ;
          rdfs:label "Generate constrained plan" ;
          skos:definition "An Act of Formulation that has as input an unconstrained materials plan and a supplier capacity profile and has as output a constrained materials plan reflecting actual supply realities." ;
          skos:example "Planning re-runs MRP against real supplier capacity to produce the executable materials plan." .


###  http://example.org/apqc#P10252
ex:P10252 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DistributionMasterData
                          ] ;
          ex:apqcSourceText "Maintaining and preserving the master data plan for distribution requirements. Create a systematic collection of facts and figures regarding the distribution of the inventories. Maintain policies, processes, and tools covering the distribution function." ;
          ex:hierarchyID "4.1.5.1" ;
          ex:pcfID "10252" ;
          rdfs:comment "Gate-F R5 fix: the R5 judgement is now explicit and uniform. Although the source is phrased as a standing curatorial function ('MAINTAINING and PRESERVING the master data... MAINTAIN policies, processes, and tools'), this class is modeled as a bounded occurrent because it reduces to a discrete, repeatable master-data update task with an identifiable begin and end that can be a proper part of Plan distribution requirements [17042] -- exactly the reduction the slice applies to the other 'Maintain' rows P17041 (Maintain master production schedule) and P10262 (Manage cost of supply). The genuinely standing distribution-data-curation FUNCTION (no natural end) is the responsibility of ex:LogisticsManagementCapability / ex:SupplyChainManagementCapability, not of this bounded act. Rejected demotion to a standalone ex:DistributionMasterDataManagementCapability so as to preserve the 4.1.5 partonomy (this act is a process part of P17042); the standing aspect is already carried by the section capabilities." ;
          rdfs:label "Maintain master data" ;
          skos:definition "An Act of Information Processing that performs a bounded, repeatable update of distribution master data describing the organization's distribution of inventory." ;
          skos:example "Master-data stewards run the periodic update keeping distribution-center and lane reference data current." .


###  http://example.org/apqc#P10253
ex:P10253 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ValidatedRequirementAssessment
                          ] ;
          ex:apqcSourceText "Interact with the concerned person at the destination to validate the requirements and to avoid any miscommunication of information." ;
          ex:hierarchyID "4.1.5.2" ;
          ex:pcfID "10253" ;
          rdfs:comment "Gate-F fix: re-anchored from ex:ActOfFormulation (Act of Planning -> Directive) to ex:ActOfAnalysis (Act of Information Processing -> Descriptive). The source ('Interact with the concerned person at the destination to validate the requirements and to avoid any miscommunication') is a validation/communication-confirmation act, not the composition of a new prescriptive plan; nothing in it authors a directive. Rejected ex:ActOfFormulation: the Planning genus + Directive output disagree with the act's descriptive/confirmatory character (GOLDEN PRINCIPLE). The Directive ex:LogisticsRequirementSpecification (the requirement that is confirmed, not authored, here) is demoted to a non-definitional reference; the definitional output is the Descriptive ex:ValidatedRequirementAssessment." ;
          rdfs:label "Determine finished goods inventory requirements at destination" ;
          skos:definition "An Act of Analysis that interacts with the concerned party at a destination to validate the finished-goods inventory requirements and produces a validated requirement assessment confirming them." ;
          skos:example "A planner confirms the regional DC's stocking requirement with its manager." .


###  http://example.org/apqc#P10254
ex:P10254 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DestinationRequirementQuantity
                          ] ;
          ex:apqcSourceText "Interact with the concerned authority at the destination to reach a specific figure that correctly represents requirements." ;
          ex:hierarchyID "4.1.5.4" ;
          ex:pcfID "10254" ;
          rdfs:comment "Gate-F fix: re-anchored from ex:ActOfFormulation (Act of Planning -> Directive) to ex:ActOfAnalysis (Act of Information Processing -> Descriptive). The lead verb 'Calculate' and the product 'a figure that correctly represents requirements' is a computed/descriptive quantity, not a prescriptive plan. Rejected ex:ActOfFormulation: it would force a Directive output, contradicting the GOLDEN PRINCIPLE and breaking parallel-row consistency with its sibling Calculate consolidation at source [10255], which is correctly an Act of Analysis with a Descriptive ex:ConsolidationQuantity. Output changed from the Directive ex:LogisticsRequirementSpecification to the Descriptive ex:DestinationRequirementQuantity, mirroring P10255." ;
          rdfs:label "Calculate requirements at destination" ;
          skos:definition "An Act of Analysis that computes and has as output a destination requirement quantity giving the specific figure that correctly represents the requirements at a destination." ;
          skos:example "The team agrees the exact replenishment quantity for the destination DC." .


###  http://example.org/apqc#P10255
ex:P10255 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ConsolidationQuantity
                          ] ;
          ex:apqcSourceText "Determining the aggregate volume of products/services consolidated at the source. Calculate the number of finished products that are ready to be delivered to the customers, particularly at one date." ;
          ex:hierarchyID "4.1.5.5" ;
          ex:pcfID "10255" ;
          rdfs:label "Calculate consolidation at source" ;
          skos:definition "An Act of Analysis that computes and has as output a consolidation quantity giving the aggregate volume of finished products consolidated at the source for a given date." ;
          skos:example "Shipping totals the units ready to consolidate at the plant for Friday's outbound." .


###  http://example.org/apqc#P10256
ex:P10256 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ReplenishmentPlan
                          ] ;
          ex:apqcSourceText "Administering the plan for collaborative replenishment of goods. Replenish inventory by creating a plan in case of faulty production." ;
          ex:hierarchyID "4.1.5.6" ;
          ex:pcfID "10256" ;
          rdfs:comment "Anchored to Act of Formulation (creating/administering a plan), not an Organization Capability; the lead activity yields a Directive replenishment plan." ;
          rdfs:label "Manage collaborative replenishment planning" ;
          skos:definition "An Act of Formulation that has as output a replenishment plan for the collaborative replenishment of inventory." ;
          skos:example "Planners and the supplier agree a VMI replenishment plan for the DC." .


###  http://example.org/apqc#P10258
ex:P10258 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DispatchPlan
                          ] ;
          ex:apqcSourceText "Estimating the timing and duration of the delivery of the inventory from the source to the destination. Plan the logistic details of all the distribution routes and activities." ;
          ex:hierarchyID "4.1.5.7" ;
          ex:pcfID "10258" ;
          rdfs:label "Calculate and optimize destination dispatch plan" ;
          skos:definition "An Act of Formulation that has as output a dispatch plan specifying the timing, duration, and routing of inventory delivery from source to destination." ;
          skos:example "Transport planning builds the optimized dispatch plan for the week's outbound loads." .


###  http://example.org/apqc#P10259
ex:P10259 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DispatchPlan
                          ] ;
          ex:apqcSourceText "Accomplishing the dispatch plan. Strictly follow the schedule, and adjust for deviations. Coordinate with the concerned authorities at various destinations." ;
          ex:hierarchyID "4.1.5.8" ;
          ex:pcfID "10259" ;
          rdfs:label "Manage dispatch plan attainment" ;
          skos:definition "An Act of Monitoring that has as input a dispatch plan, tracks adherence to it, and adjusts for deviations from the schedule." ;
          skos:example "Logistics control watches dispatch execution and reschedules a delayed load." .


###  http://example.org/apqc#P10260
ex:P10260 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LoadPlan
                          ] ;
          ex:apqcSourceText "Evaluating the plans for delivering loads to destinations. Create a systematic plan that specifies the load plans for every single destination." ;
          ex:hierarchyID "4.1.5.9" ;
          ex:pcfID "10260" ;
          rdfs:label "Calculate and optimize destination load plans" ;
          skos:definition "An Act of Formulation that has as output a load plan specifying how loads are built and delivered to each destination." ;
          skos:example "Planning produces the per-destination load plan maximizing trailer fill." .


###  http://example.org/apqc#P10261
ex:P10261 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:LoadPlan
                          ] ;
          ex:apqcSourceText "Administering the load plan for partners. Manage the delivery, and dispatch from the source to the partners." ;
          ex:hierarchyID "4.1.5.10" ;
          ex:pcfID "10261" ;
          rdfs:label "Manage partner load plan" ;
          skos:definition "An Act of Monitoring that has as input a load plan and oversees its attainment for partner deliveries and dispatch from the source." ;
          skos:example "The team tracks partner load execution and resolves a missed partner pickup." .


###  http://example.org/apqc#P10262
ex:P10262 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplyCostEstimate
                          ] ;
          ex:apqcSourceText "Managing all expenses to provide products/services in the market. Estimate the overall cost of supplying of products/inventory, including the cost distributing it through various partners and channels. Consider the cost of all the logistical processes that occur from the moment a product is ready to be dispatched to the time it reaches the destination." ;
          ex:hierarchyID "4.1.5.11" ;
          ex:pcfID "10262" ;
          rdfs:comment "Anchored to Act of Appraisal (estimating value/cost); output is a Descriptive supply cost estimate." ;
          rdfs:label "Manage cost of supply" ;
          skos:definition "An Act of Appraisal that estimates and has as output a supply cost estimate of the overall cost of supplying products through distribution channels." ;
          skos:example "Finance estimates the all-in cost to land product at each region's DC." .


###  http://example.org/apqc#P10263
ex:P10263 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CapacityUtilizationReport
                          ] ;
          ex:apqcSourceText "Determining the capacity utilization of the organization's production process. Realize the extent to which an enterprise uses its installed productive capacity (i.e., the relationship between output and the potential output if capacity was fully used)." ;
          ex:hierarchyID "4.1.5.12" ;
          ex:pcfID "10263" ;
          rdfs:label "Manage capacity utilization" ;
          skos:definition "An Act of Appraisal that determines and has as output a capacity utilization report on the extent to which installed productive capacity is used." ;
          skos:example "Operations reports lines at 78 percent of installed capacity for the quarter." .


###  http://example.org/apqc#P10264
ex:P10264 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:LogisticsNetworkDesign
                          ] ;
          ex:apqcSourceText "Evaluating the system that defines how the products/inventory would reach from the source (i.e., manufacturer) to the destination (i.e., retailer/distributer)." ;
          ex:hierarchyID "4.1.7.1" ;
          ex:pcfID "10264" ;
          rdfs:comment "A network-review assessment is the typical output but is not asserted as definitional; the input logistics network design is what the act necessarily evaluates." ;
          rdfs:label "Review distribution network" ;
          skos:definition "An Act of Appraisal that has as input a logistics network design and evaluates how products reach destinations from the source." ;
          skos:example "Network analysts evaluate whether the current DC footprint still serves demand efficiently." .


###  http://example.org/apqc#P10265
ex:P10265 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Carrier
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierSelectionDecision
                          ] ;
          ex:apqcSourceText "Establishing relationships with transportation/distribution sources in order to ensure an effective distribution network and strategy. Screen and evaluate various sources available to pick out the best among them." ;
          ex:hierarchyID "4.1.7.2" ;
          ex:pcfID "10265" ;
          ex:requiresRole ex:CarrierRole ;
          rdfs:comment "Anchored to Act of Selection: a best option is chosen from a candidate set, yielding a Directive decision. Carrier is a definitional participant." ;
          rdfs:label "Establish sourcing relationships" ;
          skos:definition "An Act of Selection that screens candidate transportation and distribution sources and has as output a supplier selection decision identifying the chosen source." ;
          skos:example "Logistics screens carriers and selects the preferred regional partner." .


###  http://example.org/apqc#P10266
ex:P10266 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DistributionPolicy
                          ] ;
          ex:apqcSourceText "Creating strategic guidelines on the availability of the products at all the distribution centers. Create a dynamic network to ensure availability at all times, even in cases of defaults." ;
          ex:hierarchyID "4.1.7.3" ;
          ex:pcfID "10266" ;
          rdfs:label "Establish dynamic deployment policies" ;
          skos:definition "An Act of Formulation that has as output a distribution policy of strategic guidelines ensuring product availability across all distribution centers." ;
          skos:example "Planning sets the dynamic deployment rules that rebalance stock across DCs on stockout risk." .


###  http://example.org/apqc#P10267
ex:P10267 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DistributionPlanningConstraintSpecification
                          ] ;
          ex:apqcSourceText "Instituting the constraints for creating a layout for distribution center. Consider factors such as the number of customers, demand forecasting, product groups, condition of product conservation, warehousing, and transportation management." ;
          ex:hierarchyID "4.1.6.1" ;
          ex:pcfID "10267" ;
          rdfs:label "Establish distribution center layout constraints" ;
          skos:definition "An Act of Formulation that has as output a distribution planning constraint specification governing distribution-center layout." ;
          skos:example "Planners set the layout constraints for the DC given product mix and demand." .


###  http://example.org/apqc#P10268
ex:P10268 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InventoryNeedsAssessment
                          ] ;
          ex:apqcSourceText "Determining any problems that might be faced while managing inventory. Identify problems and possible issues in managing the warehousing of the raw materials, spares, and other items of inventory. Take stock of inventory needs, and determine the exact quantity of the inventory needed in the near future." ;
          ex:hierarchyID "4.1.6.2" ;
          ex:pcfID "10268" ;
          rdfs:comment "Gate-F fix: re-anchored from ex:ActOfFormulation (Act of Planning -> Directive) to ex:ActOfAnalysis (Act of Information Processing -> Descriptive). Unlike its siblings P10267/P10269/P19558 (which 'institute'/'identify constraints' and genuinely formulate a Directive constraint specification), this row's dominant content is problem-identification and needs-quantification ('Determining any problems... Identify problems and possible issues... Take stock of inventory needs, and determine the exact quantity needed'), which is descriptive analysis. Rejected ex:ActOfFormulation: it would force a Directive output mismatched to the discern/quantify verbs (GOLDEN PRINCIPLE). Output changed from the Directive ex:DistributionPlanningConstraintSpecification to the Descriptive ex:InventoryNeedsAssessment." ;
          rdfs:label "Establish inventory management constraints" ;
          skos:definition "An Act of Analysis that discerns the problems and issues in managing inventory and quantifies inventory needs, producing an inventory needs assessment." ;
          skos:example "The team documents storage and stock-level constraints for the warehouse." .


###  http://example.org/apqc#P10269
ex:P10269 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DistributionPlanningConstraintSpecification
                          ] ;
          ex:apqcSourceText "Identifying any potential constraints while deciding on the dispatch and delivery plan from the source to the various distribution centers. Decide how the inventory will be transported , which and how many transportation means to use, what route to take, etc." ;
          ex:hierarchyID "4.1.6.3" ;
          ex:pcfID "10269" ;
          rdfs:label "Establish transportation management constraints" ;
          skos:definition "An Act of Formulation that has as output a distribution planning constraint specification governing transportation management." ;
          skos:example "Logistics fixes mode, fleet-size, and routing constraints for source-to-DC transport." .


###  http://example.org/apqc#P10270
ex:P10270 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceIndicatorSpecification
                          ] ;
          ex:apqcSourceText "Designing key measures that analyze and interpret how effectively the business is achieving its objectives." ;
          ex:hierarchyID "13.6.3.1" ;
          ex:pcfID "10270" ;
          rdfs:comment "Directive output (a specification of indicators), so anchored under ex:ActOfFormulation per the GOLDEN PRINCIPLE." ;
          rdfs:label "Establish performance indicators (measures)" ;
          skos:definition "An Act of Formulation that designs key performance measures and composes a performance indicator specification prescribing how effectively the business is achieving its objectives." ;
          skos:example "A team defines a set of KPIs and their formulas for the order-fulfillment process." .


###  http://example.org/apqc#P10271
ex:P10271 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MonitoringFrequencySpecification
                          ] ;
          ex:apqcSourceText "Deciding on the appropriate amount of supervisions that are needed to effectively assess the performance of business plans." ;
          ex:hierarchyID "13.6.3.2" ;
          ex:pcfID "10271" ;
          rdfs:comment "Directive output (a prescription of monitoring cadence), so anchored under ex:ActOfFormulation per the GOLDEN PRINCIPLE. Output ICE ex:MonitoringFrequencySpecification is minted here (not in the shared list)." ;
          rdfs:label "Establish monitoring frequency" ;
          skos:definition "An Act of Formulation that decides and composes a monitoring frequency specification prescribing how often performance is to be supervised and assessed." ;
          skos:example "Governance decides KPIs will be reviewed monthly and the dashboard refreshed weekly." .


###  http://example.org/apqc#P10272
ex:P10272 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000345 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceMeasurement
                          ] ;
          ex:apqcSourceText "Measuring the performance of process planning. Quantify the performance, record results of the performance tests, and report them to the appropriate authority." ;
          ex:hierarchyID "13.6.3.4" ;
          ex:pcfID "10272" ;
          rdfs:comment "Anchored directly to cco:ont00000345 (Act of Measuring): it determines the quantity/extent of performance relative to a standard. Input is performance data; output is a Descriptive ICE (performance measurement)." ;
          rdfs:label "Calculate performance measures" ;
          skos:definition "An Act of Measuring that quantifies process performance against defined indicators and records the results as a performance measurement." ;
          skos:example "A scorecard calculates the period's KPI values from the collected data." .


###  http://example.org/apqc#P10273
ex:P10273 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceMeasurement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceTrendAnalysis
                          ] ;
          ex:apqcSourceText "Recognizing the trends in performance. Carefully and strategically assess the results in order to effectively spot the trends." ;
          ex:hierarchyID "13.6.3.5" ;
          ex:pcfID "10273" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis (inlined): it processes measurement ICEs into a representation of trends (Descriptive ICE). Not ex:ActOfIdentification because the emphasis is analytic trend-detection rather than enumeration." ;
          rdfs:label "Identify performance trends" ;
          skos:definition "An Act of Analysis that examines performance measurements over time and produces a performance trend analysis representing the recognized trends." ;
          skos:example "An analyst plots twelve months of KPI data and identifies a declining-quality trend." .


###  http://example.org/apqc#P10274
ex:P10274 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceMeasurement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceAssessment
                          ] ;
          ex:apqcSourceText "Evaluating the gaps between achieved and benchmarked performance. Analyze how performance differs from the optimal or expected performance." ;
          ex:hierarchyID "13.6.3.6" ;
          ex:pcfID "10274" ;
          rdfs:comment "RE-ANCHORED from ex:ActOfAnalysis to cco:ont00000636 (Act of Appraisal). The source verb is 'EVALUATING the gaps ... Analyze how performance differs', and its asserted output ex:PerformanceAssessment is defined as 'describes a JUDGEMENT of performance' -- the product of appraisal, not generic information-processing analysis. This makes the genus agree with the judgement-bearing output (GOLDEN PRINCIPLE) and makes the row consistent with its siblings P11083 and P20147, which also produce ex:PerformanceAssessment under cco:ont00000636. (If a purely analytic gap-quantification reading were wanted, a distinct descriptive ex:PerformanceGapAnalysis ICE would be used under ex:ActOfAnalysis; here the appraisal/judgement reading is adopted for sibling consistency.)" ;
          rdfs:label "Analyze performance" ;
          skos:definition "An Act of Appraisal that evaluates the gaps between achieved and benchmarked or expected performance and produces a performance assessment of how performance differs from the optimum." ;
          skos:example "An analyst explains why the period's throughput fell short of the benchmark target." .


###  http://example.org/apqc#P10275
ex:P10275 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceAssessment
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceTrendAnalysis
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceReport
                          ] ;
          ex:apqcSourceText "Creating reports that systematically record and represent the performance planning. Construct a detailed report specifying the performance, and include indicators such as the performance gaps, performance trends, and analysis." ;
          ex:hierarchyID "13.6.3.7" ;
          ex:pcfID "10275" ;
          rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): input ICEs (measurements, trends, analyses) are manipulated and assembled into an output Descriptive ICE (performance report). COMPILE-class (kept at 366, not re-anchored to ex:ActOfReporting): the source leads with 'Creating reports ... Construct a detailed report' -- composing the report ICE -- with no sharing-to-an-audience verb, so dissemination is not definitional." ;
          rdfs:label "Prepare performance reports" ;
          skos:definition "An Act of Information Processing that assembles performance measurements, trends, and analyses into a performance report that systematically records and represents performance." ;
          skos:example "A reporting analyst compiles the quarterly performance report including gaps, trends, and commentary." .


###  http://example.org/apqc#P10276
ex:P10276 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceAssessment
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceImprovementPlan
                          ] ;
          ex:apqcSourceText "Using performance indicators to report, analyze, and create a detailed performance improvement plan to bridge the performance gaps." ;
          ex:hierarchyID "13.6.3.8" ;
          ex:pcfID "10276" ;
          rdfs:comment "Directive output (a plan), so anchored under ex:ActOfFormulation per the GOLDEN PRINCIPLE. Input is the performance assessment." ;
          rdfs:label "Develop performance improvement plan" ;
          skos:definition "An Act of Formulation that uses performance indicators and assessments to compose a performance improvement plan prescribing actions to bridge identified performance gaps." ;
          skos:example "After analyzing gaps, a team drafts a performance improvement plan with owners and milestones." .


###  http://example.org/apqc#P10277
ex:P10277 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10281
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10282
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10283
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10284
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10285
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10286
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10287
                          ] ;
          ex:apqcSourceText "Creating strategies for procuring materials and services from various sources, and for managing and evaluating categories. Establish a procurement process that describes the approach for obtaining products and purchasing activities. Evaluate the sources. Create sourcing relationships in order to continuously improve. Re-evaluate purchasing activities." ;
          ex:hierarchyID "4.2.1" ;
          ex:pcfID "10277" ;
          rdfs:comment "Genus Act of Formulation (cco:ont00000511 Act of Planning): its principal deliverable is a prescriptive procurement process/sourcing strategy (a Directive ICE), per the Golden Principle." ;
          rdfs:label "Provide sourcing governance and perform category management" ;
          skos:definition "An Act of Formulation that composes the sourcing strategies and procurement process governing how an organization obtains materials and services across categories." ;
          skos:example "A procurement office defines category strategies and a documented sourcing process for the coming year." .


###  http://example.org/apqc#P10278
ex:P10278 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10288
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10289
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10290
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10291
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierSelectionDecision
                          ] ;
          ex:apqcSourceText "Evaluating supplier options to select the most effective and efficient suppliers. Validate selected suppliers. Establish and manage supplier contracts." ;
          ex:hierarchyID "4.2.2" ;
          ex:pcfID "10278" ;
          rdfs:comment "Dominant deliverable is a Supplier Selection Decision (Directive); genus Act of Selection. Contract formation and management are process parts." ;
          rdfs:label "Select suppliers and develop/maintain contracts" ;
          skos:definition "An Act of Selection that chooses suppliers from evaluated options and establishes the contracts that bind them, producing a Supplier Selection Decision." ;
          skos:example "A sourcing committee selects two qualified suppliers and puts framework contracts in place." .


###  http://example.org/apqc#P10279
ex:P10279 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10292
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10293
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10294
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10295
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10296
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10297
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10298
                          ] ;
          ex:apqcSourceText "Creating and approving requisitions and distributing purchase orders accordingly. Hasten the procurement process to satisfy internal needs." ;
          ex:hierarchyID "4.2.3" ;
          ex:pcfID "10279" ;
          rdfs:comment "Genus Act of Acquisition (Planned Act). Distinct from cco:ont00001334 Act of Purchasing, which requires actual use of a financial instrument; ordering here culminates in issued purchase orders, modeled by its parts." ;
          rdfs:label "Order materials and services" ;
          skos:definition "An Act of Acquisition that obtains required materials and services by creating and approving requisitions and issuing purchase orders to suppliers." ;
          skos:example "A buyer raises requisitions, gets approval, and dispatches purchase orders to win the needed parts." .


###  http://example.org/apqc#P10280
ex:P10280 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10299
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10300
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10301
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10302
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierPerformanceReport
                          ] ;
          ex:apqcSourceText "Collecting and analyzing new information in order to track and rate suppliers through a supplier information management system." ;
          ex:hierarchyID "4.2.4" ;
          ex:pcfID "10280" ;
          rdfs:comment "R5: although phrased 'Manage', the source reduces this to a bounded, repeatable collect-and-analyze rating cycle, so it is modeled as a process (genus Act of Analysis) with its monitoring/analysis acts as parts, rather than as an unbounded Organization Capability." ;
          rdfs:label "Manage suppliers" ;
          skos:definition "An Act of Analysis that collects and analyzes supplier information to track and rate suppliers, producing a Supplier Performance Report." ;
          skos:example "Procurement runs its periodic supplier scorecard cycle, rating vendors on delivery and quality." .


###  http://example.org/apqc#P10281
ex:P10281 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProcurementPlan
                          ] ;
          ex:apqcSourceText "Creating a plan for procuring materials and services. Plan what to buy, when, and from what sources. Include project requirements, the procurement team, the justification for the procurement, a timeline of events, and an explanation of the supplier selection process. Outline specific actions to start and complete purchases in order to adhere to best practices." ;
          ex:hierarchyID "4.2.1.1" ;
          ex:pcfID "10281" ;
          rdfs:label "Develop procurement plan" ;
          skos:definition "An Act of Formulation that composes a Procurement Plan prescribing what to buy, when, and from which sources." ;
          skos:example "A procurement lead drafts a sourcing plan with timeline, team, and supplier-selection approach for a build program." .


###  http://example.org/apqc#P10282
ex:P10282 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PurchasingRequirementSpecification
                          ] ;
          ex:apqcSourceText "Defining the purchasing requirements for materials and services. Specify the exact inventory required for the production process. Create a specific quotation for all the sources in order to avoid any duplication or overlap." ;
          ex:hierarchyID "4.2.1.2" ;
          ex:pcfID "10282" ;
          rdfs:comment "Output is a Directive ICE (a requirement specification), so the act is anchored under Act of Formulation per the Golden Principle." ;
          rdfs:label "Clarify purchasing requirements" ;
          skos:definition "An Act of Formulation that specifies the exact materials and services to be purchased, producing a Purchasing Requirement Specification." ;
          skos:example "A buyer defines exact part numbers and quantities required by a production line into a purchasing requirement spec." .


###  http://example.org/apqc#P10283
ex:P10283 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MaterialsManagementContingencyPlan
                          ] ;
          ex:apqcSourceText "Developing a strategy to deal with issues projected to arise during implementation of the inventory plan. Identify how to react to issues that arise and require changes to the inventory plan, such as a vendor failing to deliver materials on time. Collaborate with production and suppliers to prepare solutions to projected problems." ;
          ex:hierarchyID "4.2.1.3" ;
          ex:pcfID "10283" ;
          rdfs:label "Establish materials management contingency plans" ;
          skos:definition "An Act of Formulation that composes a Materials Management Contingency Plan prescribing responses to projected materials-supply disruptions." ;
          skos:example "A team prepares fallback sourcing and buffer-stock procedures for the case of a key vendor's late delivery." .


###  http://example.org/apqc#P10284
ex:P10284 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PurchasingRequirementSpecification
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SupplierCapacityProfile
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:NeedsSupplyAlignmentAssessment
                          ] ;
          ex:apqcSourceText "Synchronizing the requirements of materials and services and the capacity of suppliers for providing these materials and services. Revamp the procurement needs of the company in consideration of the capabilities of the suppliers." ;
          ex:hierarchyID "4.2.1.4" ;
          ex:pcfID "10284" ;
          rdfs:comment "Genus Act of Analysis: it manipulates requirement and capacity ICEs into a descriptive judgement of fit; revised needs follow from that judgement." ;
          rdfs:label "Match needs to supply capabilities" ;
          skos:definition "An Act of Analysis that examines purchasing requirements against supplier capacity and produces a needs-supply alignment assessment." ;
          skos:example "A planner reconciles a bill of requirements with supplier capacity profiles and reports where demand exceeds capacity." .


###  http://example.org/apqc#P10285
ex:P10285 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SpendProfileAnalysis
                          ] ;
          ex:apqcSourceText "Evaluating the spend profile of the organization. Collect, cleanse, classify, and analyze the procurement data with the purpose of reducing procurement costs, improving efficiency, and monitoring compliance." ;
          ex:hierarchyID "4.2.1.5" ;
          ex:pcfID "10285" ;
          rdfs:label "Analyze organization's spend profile" ;
          skos:definition "An Act of Analysis that examines collected procurement data and produces a Spend Profile Analysis." ;
          skos:example "A category manager classifies a year of purchase data and reports spend concentration by supplier and category." .


###  http://example.org/apqc#P10286
ex:P10286 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SourcingOpportunityAssessment
                          ] ;
          ex:apqcSourceText "Seeking the most efficient sourcing and procurement opportunities." ;
          ex:hierarchyID "4.2.1.6" ;
          ex:pcfID "10286" ;
          rdfs:comment "Genus Act of Identification (discernment): the act registers discerned opportunities as a Descriptive ICE." ;
          rdfs:label "Seek opportunities to improve efficiency and value" ;
          skos:definition "An Act of Identification that discerns sourcing and procurement opportunities for improved efficiency and value, producing a sourcing-opportunity assessment." ;
          skos:example "A sourcing analyst scans the supply base and registers consolidation and renegotiation opportunities." .


###  http://example.org/apqc#P10287
ex:P10287 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Supplier
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SourcingOpportunityAssessment
                          ] ;
          ex:apqcSourceText "Collaborating with the suppliers of materials and services in order to determine new opportunities for sourcing." ;
          ex:hierarchyID "4.2.1.7" ;
          ex:pcfID "10287" ;
          ex:requiresRole ex:SupplierRole ;
          rdfs:comment "Suppliers are definitional participants (the collaboration is constitutive of the act); modeled via has participant on ex:Supplier (shared vocab Organization)." ;
          rdfs:label "Collaborate with suppliers to identify sourcing opportunities" ;
          skos:definition "An Act of Identification that, in collaboration with suppliers, discerns new sourcing opportunities and produces a sourcing-opportunity assessment." ;
          skos:example "Buyers and key suppliers jointly identify a new co-sourcing arrangement for a component." .


###  http://example.org/apqc#P10288
ex:P10288 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SupplierQuote
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierSelectionDecision
                          ] ;
          ex:apqcSourceText "Evaluating the pros and cons of various suppliers. Choose the most appropriate and cost-effective suppliers on the basis of their material quality, delivery schedules, and costs." ;
          ex:hierarchyID "4.2.2.1" ;
          ex:pcfID "10288" ;
          rdfs:label "Select suppliers" ;
          skos:definition "An Act of Selection that chooses one or more suppliers from candidate supplier quotes and produces a Supplier Selection Decision." ;
          skos:example "A buyer compares three vendor quotes and decides which supplier wins the award." .


###  http://example.org/apqc#P10289
ex:P10289 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierValidationAssessment
                          ] ;
          ex:apqcSourceText "Validating the supply sources, and provide certification as an official supplier." ;
          ex:hierarchyID "4.2.2.2" ;
          ex:pcfID "10289" ;
          rdfs:comment "Genus Act of Appraisal (cco:ont00000636): the principal act judges the supplier's fitness, yielding a Descriptive validation assessment that agrees with the genus (GOLDEN PRINCIPLE). Gate-F fix: demoted the second output [has output some ex:SupplierCertification] from an existential restriction to this non-definitional note. Issuing a certification is an authorization act, not an appraisal, and is only a CONDITIONAL downstream artifact: an instance can validate a source, find it non-conforming, and produce NO certification, so SupplierCertification is not necessary for every instance of the type (Phase-3 necessity). Where the certification issuance is tracked, model it as a separate authorization act (an Act of Acquisition over the Directive ex:SupplierCertification) rather than as a definitional output of this appraisal." ;
          rdfs:label "Certify and validate suppliers" ;
          skos:definition "An Act of Appraisal that validates a supply source and produces a supplier validation assessment judging its fitness to be an approved supplier." ;
          skos:example "A quality team audits a vendor's facility, judges it compliant, and grants official-supplier status." .


###  http://example.org/apqc#P10290
ex:P10290 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000684 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Supplier
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierContract
                          ] ;
          ex:apqcSourceText "Legally binding suppliers with the company. Negotiate contracts individually with all the suppliers that include the promised material delivery, the delivery dates and duration, etc." ;
          ex:hierarchyID "4.2.2.3" ;
          ex:pcfID "10290" ;
          ex:requiresRole ex:SupplierRole ;
          rdfs:comment "Reuses CCO cco:ont00000684 (Act of Contract Formation) -- 'An Act of Promising ... entered into voluntarily by two or more agents ... intends to create one or more legal obligations' -- which fits exactly. Supplier is a definitional participant." ;
          rdfs:label "Negotiate and establish contracts" ;
          skos:definition "An Act of Contract Formation that, through negotiation with a supplier, establishes a legally binding Supplier Contract governing material delivery terms." ;
          skos:example "Procurement and a supplier negotiate and sign a one-year supply agreement with fixed delivery windows." .


###  http://example.org/apqc#P10291
ex:P10291 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SupplierContract
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ContractReviewAssessment
                          ] ;
          ex:apqcSourceText "Keeping contracts up-to-date with routine evaluation. Maintain order and discipline with the contracts in order to avoid any loss of information and mishaps." ;
          ex:hierarchyID "4.2.2.4" ;
          ex:pcfID "10291" ;
          rdfs:comment "R5: although phrased 'Manage', the source reduces this to routine periodic evaluation -- a bounded, repeatable review act -- so it is modeled as a process (genus Act of Appraisal), preserving the partonomy of 4.2.2, rather than as an unbounded Organization Capability." ;
          rdfs:label "Manage contracts" ;
          skos:definition "An Act of Appraisal that periodically evaluates a Supplier Contract for currency and compliance and produces a contract review assessment." ;
          skos:example "A contract administrator reviews active supplier contracts each quarter and flags terms needing update." .


###  http://example.org/apqc#P10292
ex:P10292 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PurchaseRequisition
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ReviewedRequisition
                          ] ;
          ex:apqcSourceText "Handling operations related to processing/reviewing the requisitions. Establish and maintain procedures for the initiation, authorization, and processing of purchase requirements to procure products/services." ;
          ex:hierarchyID "4.2.3.1" ;
          ex:pcfID "10292" ;
          rdfs:comment "Genus cco:ont00000366 (Act of Information Processing): requisition ICEs are received, checked, and routed. Gate-F fix: dropped the degenerate [has output some ex:PurchaseRequisition] restriction (input class = output class is semantically empty and trivially satisfied by any review); the distinct produced artifact is ex:ReviewedRequisition. R5: the source's 'Establish and maintain procedures for the initiation, authorization, and processing of purchase requirements' describes a standing SOP that is NOT modeled as a bounded occurrent here; that procedure-maintenance reduces to the standing ex:ProcurementCapability, while this class is scoped to the bounded per-requisition review (Phase-1 method-phrase criterion)." ;
          rdfs:label "Process/Review requisitions" ;
          skos:definition "An Act of Information Processing that receives and reviews purchase requisitions and produces a reviewed requisition ready for authorization." ;
          skos:example "A procurement clerk validates incoming requisitions against policy before routing them for approval." .


###  http://example.org/apqc#P10293
ex:P10293 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PurchaseRequisition
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RequisitionApprovalDecision
                          ] ;
          ex:apqcSourceText "Approving requisitions for materials and services. Examine distributor-specific requests, and validate them individually." ;
          ex:hierarchyID "4.2.3.2" ;
          ex:pcfID "10293" ;
          rdfs:comment "Anchored at cco:ont00000228 (Planned Act), not Act of Selection: approval ratifies a single already-settled requisition with no candidate set (per the apqc-ext Act of Selection note). Output is a Directive ICE." ;
          rdfs:label "Approve requisitions" ;
          skos:definition "A Planned Act that ratifies a purchase requisition and produces a Requisition Approval Decision authorizing procurement to proceed." ;
          skos:example "A budget owner signs off on a requisition, authorizing the purchase." .


###  http://example.org/apqc#P10294
ex:P10294 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RequestForQuotation
                          ] ;
          ex:apqcSourceText "Requesting quotes from suppliers. Use a request for quotation (RFQ) to invite suppliers into a bidding process for specific products/services." ;
          ex:hierarchyID "4.2.3.3" ;
          ex:pcfID "10294" ;
          rdfs:comment "Output is a Directive ICE (the RFQ prescribes what bidders must respond to), so the act is anchored under Act of Formulation per the Golden Principle." ;
          rdfs:label "Solicit supplier quotes" ;
          skos:definition "An Act of Formulation that composes and issues a Request for Quotation inviting suppliers to bid on specified products or services." ;
          skos:example "A buyer issues an RFQ to five vendors for a custom fastener and opens a bidding window." .


###  http://example.org/apqc#P10295
ex:P10295 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SupplierQuote
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PurchaseOrder
                          ] ;
          ex:apqcSourceText "Creating and placing the orders for purchasing materials and services from suppliers. Analyze vendor quotes. Choose the most cost-effective vendors. Create vendor-specific orders. Distribute them in order to initiate the purchasing process." ;
          ex:hierarchyID "4.2.3.4" ;
          ex:pcfID "10295" ;
          rdfs:comment "Principal deliverable is a Purchase Order (Directive ICE); genus Act of Formulation. Vendor quotes are a definitional input." ;
          rdfs:label "Create/Distribute purchase orders" ;
          skos:definition "An Act of Formulation that, from analyzed supplier quotes, composes and distributes vendor-specific Purchase Orders." ;
          skos:example "A buyer turns the winning quotes into purchase orders and sends them to the chosen vendors." .


###  http://example.org/apqc#P10296
ex:P10296 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ;
          ex:apqcSourceText "Accelerating the purchase orders in order to fulfill the internal needs (for raw materials) depicted through inquiries." ;
          ex:hierarchyID "4.2.3.5" ;
          ex:pcfID "10296" ;
          rdfs:comment "Anchored at cco:ont00000228 (Planned Act): expediting coordinates faster fulfillment rather than producing a definitional informational artifact. Inputs (inquiries) and the affected purchase orders are typical, not necessary, so they are noted here rather than as restrictions." ;
          rdfs:label "Expedite orders and satisfy inquiries" ;
          skos:definition "A Planned Act that accelerates outstanding purchase orders to satisfy urgent internal needs for raw materials expressed through inquiries." ;
          skos:example "A buyer chases a supplier to advance a delivery date so a production line is not starved of raw material." .


###  http://example.org/apqc#P10297
ex:P10297 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:InventoryRecord
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PurchaseOrder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PurchaseOrderReconciliationReport
                          ] ;
          ex:apqcSourceText "Verify that purchase orders are filled as expected: verify that items and quantities are delivered as expected, based on purchase order details and goods receipts." ;
          ex:hierarchyID "4.2.3.6" ;
          ex:pcfID "10297" ;
          rdfs:comment "Genus Act of Analysis: it manipulates the purchase-order and inventory-record ICEs into a descriptive reconciliation report. The delivered materials are operational context; the definitional output is informational." ;
          rdfs:label "Reconcile purchase orders" ;
          skos:definition "An Act of Analysis that compares purchase orders against goods receipts and produces a Purchase Order Reconciliation Report." ;
          skos:example "Accounts payable matches received quantities against PO lines and reports the discrepancies." .


###  http://example.org/apqc#P10298
ex:P10298 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DispositionDecision
                          ] ;
          ex:apqcSourceText "Identifying and resolving any exceptions. Address the internal needs/inquiries for materials that cannot be procured immediately. Research inquiries that require the need of exceptional materials." ;
          ex:hierarchyID "4.2.3.7" ;
          ex:pcfID "10298" ;
          rdfs:comment "Genus Act of Selection: among candidate resolution paths for an exception, one is chosen and recorded as a Disposition Decision (a Directive ICE). Reuses ex:DispositionDecision (shared vocab)." ;
          rdfs:label "Research/Resolve order exceptions" ;
          skos:definition "An Act of Selection that researches order exceptions and chooses a resolution, producing a Disposition Decision for the exceptional material need." ;
          skos:example "A buyer researches a hard-to-source material and decides to substitute an approved alternate." .


###  http://example.org/apqc#P10299
ex:P10299 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierPerformanceReport
                          ] ;
          ex:apqcSourceText "Examining procurement and vendor performance. Report delivery timing and the quality of the materials procured through different vendors." ;
          ex:hierarchyID "4.2.4.1" ;
          ex:pcfID "10299" ;
          rdfs:comment "Genus ex:ActOfMonitoring (section-4.0 ext proposal): ongoing observation of performance yielding a Descriptive performance report." ;
          rdfs:label "Monitor/Manage supplier information" ;
          skos:definition "An Act of Monitoring that tracks procurement and vendor performance over time and produces a Supplier Performance Report." ;
          skos:example "A supplier-management team logs each vendor's on-time delivery and defect rate into a performance report." .


###  http://example.org/apqc#P10300
ex:P10300 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierPerformanceReport
                          ] ;
          ex:apqcSourceText "Assisting the production and inventory processes through the information and reports created. Use the information and metrics of the procurement and vendor performance to enhance or improve the production process." ;
          ex:hierarchyID "4.2.4.2" ;
          ex:pcfID "10300" ;
          rdfs:label "Prepare/Analyze procurement and supplier performance" ;
          skos:definition "An Act of Analysis that examines procurement and supplier performance metrics and produces a Supplier Performance Report supporting production improvement." ;
          skos:example "An analyst aggregates vendor metrics into a performance report used to tune production planning." .


###  http://example.org/apqc#P10301
ex:P10301 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProcurementImpactAnalysis
                          ] ;
          ex:apqcSourceText "Support inventory and production processes by analyzing impact of procurement decisions and collaborating to constantly improve. (For example, perhaps minimum order requirements could be negotiated to be lower, to reduce excessive inventory and make production more flexible.)" ;
          ex:hierarchyID "4.2.4.3" ;
          ex:pcfID "10301" ;
          rdfs:comment "R5: 'Support' reduces here to a bounded analytical contribution (analyzing procurement-decision impact), modeled as a process rather than an unbounded capability." ;
          rdfs:label "Support inventory and production processes" ;
          skos:definition "An Act of Analysis that examines the impact of procurement decisions on inventory and production and produces a procurement-impact analysis." ;
          skos:example "An analyst shows how a high minimum-order quantity inflates inventory and recommends renegotiation." .


###  http://example.org/apqc#P10302
ex:P10302 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SupplierPerformanceReport
                          ] ;
          ex:apqcSourceText "Track the performance of the suppliers on product quality. Use this information to further improve sourcing and supplier performance." ;
          ex:hierarchyID "4.2.4.4" ;
          ex:pcfID "10302" ;
          rdfs:comment "Genus ex:ActOfMonitoring (section-4.0 ext proposal): ongoing observation of delivered-product quality yielding a Descriptive report." ;
          rdfs:label "Monitor quality of product delivered" ;
          skos:definition "An Act of Monitoring that tracks the quality of products delivered by suppliers and produces a Supplier Performance Report on product quality." ;
          skos:example "An inbound-quality team records defect rates per supplier shipment into a supplier quality report." .


###  http://example.org/apqc#P10303
ex:P10303 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10306
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10307
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10308
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10309
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10315
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10316
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19563
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionSchedule
                          ] ;
          ex:apqcSourceText "Scheduling the production of final products. Generate a detailed schedule plan. Create and release production orders and lots. Schedule the planned and unplanned maintenance orders." ;
          ex:hierarchyID "4.3.1" ;
          ex:pcfID "10303" ;
          rdfs:comment "Models APQC 4.3.1 as an occurrent; APQC children are process parts." ;
          rdfs:label "Schedule production" ;
          skos:definition "An Act of Scheduling that allocates production activities, orders, and maintenance to times and resources and produces a production schedule." ;
          skos:example "A planner builds and releases the week's production and maintenance schedule." .


###  http://example.org/apqc#P10304
ex:P10304 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfProduction ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:FinishedProduct
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10311
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10313
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10314
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10319
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19566
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:RawMaterial
                          ] ;
          ex:apqcSourceText "Manufacturing the product. Convert the raw materials to develop consumer-ready products. Manage the raw materials to implement the detailed production schedule. Reproduce defectives to establish and remediate cause. Ensure production optimization and benchmark performance." ;
          ex:hierarchyID "4.3.2" ;
          ex:pcfID "10304" ;
          ex:requiresCapability ex:RawMaterialInventoryManagementCapability ;
          rdfs:comment "Models APQC 4.3.2 as an occurrent; APQC children are process parts. The standing 'manage raw material inventory' child (4.3.2.1) is modeled as a capability (ex:RawMaterialInventoryManagementCapability), not a process part." ;
          rdfs:label "Produce/Assemble product" ;
          skos:definition "An Act of Production that converts raw materials into consumer-ready finished products as prescribed by the detailed production schedule." ;
          skos:example "A line converts raw stock into finished units for the day's orders." .


###  http://example.org/apqc#P10306
ex:P10306 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductionSchedule
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionSchedule
                          ] ;
          ex:apqcSourceText "Initiating the line-level plan for production. Break down the production schedule into specific lines, specifying the various objectives the production schedule." ;
          ex:hierarchyID "4.3.1.2" ;
          ex:pcfID "10306" ;
          rdfs:comment "Output reuses ex:ProductionSchedule (a line-scoped production schedule)." ;
          rdfs:label "Generate line level plan" ;
          skos:definition "An Act of Scheduling that breaks down the production schedule into line-level objectives and produces a line-level production schedule." ;
          skos:example "A scheduler decomposes the master plan into per-line objectives." .


###  http://example.org/apqc#P10307
ex:P10307 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductionSchedule
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionSchedule
                          ] ;
          ex:apqcSourceText "Broadening the line-level plan. Specify all the individual production processes, along with the timing and the duration to come up with a working schedule that tracks the whole process and any deviations that might occur." ;
          ex:hierarchyID "4.3.1.3" ;
          ex:pcfID "10307" ;
          rdfs:label "Generate detailed schedule" ;
          skos:definition "An Act of Scheduling that elaborates the line-level plan into a working production schedule specifying the timing and duration of all individual production processes." ;
          skos:example "A planner produces the minute-by-minute working schedule for each line." .


###  http://example.org/apqc#P10308
ex:P10308 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductionLot
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionOrder
                          ] ;
          ex:apqcSourceText "Creating a schedule to commence production of orders received, and creating lots to consolidate the processing. Plan when the production orders are to be initiated by commencing the operations for processing products/services. Specify which materials to produce, where to produce them, which operations will facilitate this, and on which date production is to start. Define the size of production lots, demarcating the durations of batch production." ;
          ex:hierarchyID "4.3.1.4" ;
          ex:pcfID "10308" ;
          rdfs:comment "Operations category: the production lot is a material participant (obo:has participant) of the act, alongside the directive production order as has output. Material products attach via has participant, not has output (has output is reserved for ICEs per the methodology and S3)." ;
          rdfs:label "Schedule production orders and create lots" ;
          skos:definition "An Act of Scheduling that plans the initiation of received production orders and defines production lots, producing a production order and a production lot." ;
          skos:example "A scheduler sets order start dates and demarcates batch lot sizes." .


###  http://example.org/apqc#P10309
ex:P10309 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductionLot
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductionOrder
                          ] ;
          ex:apqcSourceText "Initiating the delivery of production orders, and creating lots. Communicate the order that specifies which material to produce, where to produce it, which operations to require, and on which date production takes place. Define how to settle the order costs. Create production lots, which is a particular production unit of an assembly that is planned and manufactured." ;
          ex:hierarchyID "4.3.1.7" ;
          ex:pcfID "10309" ;
          rdfs:comment "Anchored under cco:ont00000228 (Planned Act), not ex:ActOfScheduling: releasing/communicating an existing order issues a held directive rather than formulating a new schedule. The production order is a held directive input; the production lot is a material participant (obo:has participant, since has output is reserved for ICEs)." ;
          rdfs:label "Release production orders and create lots" ;
          skos:definition "A Planned Act that issues an already-formulated production order to the floor and creates the corresponding production lot." ;
          skos:example "A controller releases the day's production orders and opens their lots." .


###  http://example.org/apqc#P10311
ex:P10311 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfProduction ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:FinishedProduct
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductionSchedule
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:RawMaterial
                          ] ;
          ex:apqcSourceText "Creating and implementing the detailed line production schedule on the ground level." ;
          ex:hierarchyID "4.3.2.2" ;
          ex:pcfID "10311" ;
          rdfs:comment "The detailed production schedule is a held directive input prescribing the run; raw material is the material input (has input) and finished product is a material participant (obo:has participant, since has output is reserved for ICEs)." ;
          rdfs:label "Execute detailed line schedule" ;
          skos:definition "An Act of Production that implements the detailed line production schedule on the floor, converting raw materials into finished product." ;
          skos:example "Operators run the line per the released schedule, producing finished units." .


###  http://example.org/apqc#P10313
ex:P10313 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfProduction ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:FinishedProduct
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductionLot
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:QualityTestResult
                          ] ;
          ex:apqcSourceText "Reproducing the items produced defectively. Assess the produced items by conducting quality and standardization tests in order to diagnose any discrepancies. Reproduce defective items." ;
          ex:hierarchyID "4.3.2.4" ;
          ex:pcfID "10313" ;
          rdfs:comment "A quality test result is a typical input that triggers the rerun; asserted as has input where definitional." ;
          rdfs:label "Rerun defective items" ;
          skos:definition "An Act of Production that reproduces items found defective, taking the defective production lot as input and producing conforming finished product." ;
          skos:example "A line re-manufactures a batch that failed inspection." .


###  http://example.org/apqc#P10314
ex:P10314 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductionRecord
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionPerformanceAssessment
                          ] ;
          ex:apqcSourceText "Analyzing and benchmarking the production process to judge its effectiveness and efficiency. Create production metrics to numerically calculate the performance of the production process." ;
          ex:hierarchyID "4.3.2.6" ;
          ex:pcfID "10314" ;
          rdfs:comment "Anchored under cco:ont00000636 (Act of Appraisal): it evaluates and judges, yielding a Descriptive ICE." ;
          rdfs:label "Assess production performance" ;
          skos:definition "An Act of Appraisal that benchmarks and judges the effectiveness and efficiency of the production process and produces a production performance assessment." ;
          skos:example "An operations analyst benchmarks line OEE and issues a performance assessment." .


###  http://example.org/apqc#P10315
ex:P10315 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MaintenanceSchedule
                          ] ;
          ex:apqcSourceText "Scheduling planned maintenance of the production equipment." ;
          ex:hierarchyID "4.3.1.5" ;
          ex:pcfID "10315" ;
          rdfs:label "Plan for preventive maintenance" ;
          skos:definition "An Act of Scheduling that allocates planned maintenance of production equipment to specific times and produces a maintenance schedule." ;
          skos:example "A maintenance planner books quarterly preventive servicing for each machine." .


###  http://example.org/apqc#P10316
ex:P10316 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MaintenanceSchedule
                          ] ;
          ex:apqcSourceText "Scheduling requested maintenance in order to address breakdowns where repairs or corrective remedies are needed immediately. Create a scheme for undertaking unplanned maintenance work on equipment/machinery that has come to be in urgent need for it. Express turnaround to redress using specialized personnel." ;
          ex:hierarchyID "4.3.1.6" ;
          ex:pcfID "10316" ;
          rdfs:label "Request unplanned maintenance" ;
          skos:definition "An Act of Scheduling that creates a scheme for urgent unplanned maintenance of broken-down equipment and produces a maintenance schedule." ;
          skos:example "A line supervisor raises an emergency maintenance order for a stalled machine." .


###  http://example.org/apqc#P10318
ex:P10318 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000950 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductionEquipment
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:QualityStandard
                          ] ;
          ex:apqcSourceText "Regulating the equipment used for performing quality tests. Assess correspondence between the quality testing equipment and the desired quality standards. Ensure the calibration standard is more accurate than the instrument being tested." ;
          ex:hierarchyID "4.3.3.1" ;
          ex:pcfID "10318" ;
          rdfs:comment "Anchored under cco:ont00000950 (Act of Maintenance): calibration modifies a material artifact to restore/preserve a designed quality (measurement accuracy). The test equipment is the participant; the quality standard is the directive against which it is regulated." ;
          rdfs:label "Calibrate test equipment" ;
          skos:definition "An Act of Maintenance that regulates quality-test equipment to a calibration standard so as to preserve its measurement accuracy." ;
          skos:example "A metrologist calibrates a torque wrench against a reference standard before testing." .


###  http://example.org/apqc#P10319
ex:P10319 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ManagementPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:MaintenanceIssueReport
                          ] ;
          ex:apqcSourceText "Recording and reporting any deviations or issues in the maintenance schedule, in the performance to the production management team, and for unplanned maintenance." ;
          ex:hierarchyID "4.3.2.3" ;
          ex:pcfID "10319" ;
          ex:requiresRole ex:ManagerRole ;
          rdfs:label "Report maintenance issues" ;
          skos:definition "An Act of Monitoring that records deviations and issues in scheduled maintenance and produces a maintenance issue report for the production management team." ;
          skos:example "A technician logs an out-of-tolerance reading and reports it to production management." .


###  http://example.org/apqc#P10320
ex:P10320 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10324
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10325
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10326
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerServiceRequirementSpecification
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ServiceRequest
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:IndividualServiceRequirement
                          ] ;
          ex:apqcSourceText "Acquiring or soliciting information about specific service requirements for individual customers through the customer service function. Obtain information about customer specific requests, process these requests, and create customer profiles to generate a service order." ;
          ex:hierarchyID "6.3.4.1" ;
          ex:pcfID "10320" ;
          rdfs:comment "Re-anchored to cco:ont00000636 (Act of Appraisal) and re-targeted output per Gate-F review. (1) OUTPUT: now ex:IndividualServiceRequirement (a newly minted Descriptive, individual-scope ICE) REPLACING the prior ex:CustomerServiceRequirementSpecification, which is DEFINED as the enterprise-wide Directive output of 6.1.1 'a Directive ICE that prescribes the behaviors, skills, and policies required to provide customer service across an enterprise'; reusing that enterprise policy as the output of an individual-customer confirmation act was a category error. The enterprise spec is retained as a Directive has input that constrains the act. (2) GENUS: the source verb is 'Acquiring or soliciting... validating/confirming' an individual customer's stated needs, i.e. information-processing/appraisal of stated requirements, not Formulation (composing a binding directive plan); the Appraisal genus yields the Descriptive individual requirement record, satisfying the GOLDEN PRINCIPLE. Its APQC children are process parts." ;
          rdfs:label "Confirm specific service requirements for individual customer" ;
          skos:definition "An Act of Appraisal that validates and confirms an individual customer's stated service requirements and produces an individual service requirement record." ;
          skos:example "An agent gathers and validates a customer's repair needs and records the confirmed individual requirements." .


###  http://example.org/apqc#P10321
ex:P10321 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10327
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10328
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ServiceOrder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ResourcingPlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ServiceOrderFulfillmentSchedule
                          ] ;
          ex:apqcSourceText "Determining and scheduling the resources required to fulfill customer service requirements. Create a detailed schedule about the service orders and development of these service orders." ;
          ex:hierarchyID "6.3.4.2" ;
          ex:pcfID "10321" ;
          rdfs:comment "Genus ex:ActOfScheduling (PROPOSE-EXT): allocates resources over time; Directive outputs. Its APQC children are process parts." ;
          rdfs:label "Identify and schedule resources to meet service requirements" ;
          skos:definition "An Act of Scheduling that determines and allocates the resources required to fulfill service requirements and produces a resourcing plan and a service order fulfillment schedule." ;
          skos:example "A planner sizes the crew and equipment needed and lays out the fulfillment schedule." .


###  http://example.org/apqc#P10322
ex:P10322 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10330
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10331
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10332
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ServiceOrder
                          ] ;
          ex:apqcSourceText "Dispatching resources for managing and fulfilling daily service requirements. Manage the progress of order fulfillment. Complete order blocks." ;
          ex:hierarchyID "6.3.4.3" ;
          ex:pcfID "10322" ;
          rdfs:comment "Genus ex:ActOfServiceProvision: the rendering/execution of the service. Its APQC children are process parts." ;
          rdfs:label "Provide service to specific customers" ;
          skos:definition "An Act of Service Provision that dispatches resources and carries out the daily service orders to fulfill customers' service requirements." ;
          skos:example "A dispatcher sends technicians to complete the day's scheduled repairs." .


###  http://example.org/apqc#P10323
ex:P10323 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10334
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10335
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10336
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10337
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ServiceQualityAssessment
                          ] ;
          ex:apqcSourceText "Guaranteeing the quality of service provided to customers. Identify the successful and unsuccessful orders along with the service failures. Collect customer feedback. Process the feedback to ensure the quality of service in the future." ;
          ex:hierarchyID "6.3.4.4" ;
          ex:pcfID "10323" ;
          rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): judges service quality. Its APQC children are process parts." ;
          rdfs:label "Ensure quality of service" ;
          skos:definition "An Act of Appraisal that evaluates the quality of service delivered to customers and produces a service quality assessment." ;
          skos:example "A quality lead reviews completed and failed orders and customer feedback to rate service quality." .


###  http://example.org/apqc#P10324
ex:P10324 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ServiceRequest
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InquiryAnalysis
                          ] ;
          ex:apqcSourceText "Soliciting or acquiring information using various sources such as databases, customer interactions, and customer request forms. Hand them further up the hierarchy to deal with them. Categorize the user's request, determining if the request is supportable and prioritizing the request." ;
          ex:hierarchyID "6.3.4.1.1" ;
          ex:pcfID "10324" ;
          rdfs:comment "Genus ex:ActOfAnalysis: categorizing/prioritizing a request is information processing producing a Descriptive analysis." ;
          rdfs:label "Process customer request" ;
          skos:definition "An Act of Analysis that has as input a service request and has as output an inquiry analysis that categorizes and prioritizes the request." ;
          skos:example "An agent classifies an incoming request as supportable and high priority." .


###  http://example.org/apqc#P10325
ex:P10325 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerProfile
                          ] ;
          ex:apqcSourceText "Documenting the individual customer service requirements solicited, along with personal information of the customers, in order to generate customized profiles that hasten the delivery process." ;
          ex:hierarchyID "6.3.4.1.2" ;
          ex:pcfID "10325" ;
          rdfs:comment "Anchored at cco:ont00000366 (Act of Information Processing): documenting/storing customer data; output is a Descriptive CustomerProfile." ;
          rdfs:label "Create customer profile" ;
          skos:definition "An Act of Information Processing that documents an individual customer's requirements and personal information and produces a customer profile." ;
          skos:example "An agent builds a profile capturing the customer's equipment and service history." .


###  http://example.org/apqc#P10326
ex:P10326 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerServiceRequirementSpecification
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ServiceOrder
                          ] ;
          ex:apqcSourceText "Designing a short-term agreement between the service provider and customer. One-time services are ordered by the service recipient and resource-related billing is performed upon completion. Use the service order to document service and customer service work." ;
          ex:hierarchyID "6.3.4.1.3" ;
          ex:pcfID "10326" ;
          rdfs:comment "Genus ex:ActOfFormulation (inlined): composing the service agreement yields a Directive ServiceOrder." ;
          rdfs:label "Generate service order" ;
          skos:definition "An Act of Formulation that designs a short-term service agreement and produces a service order." ;
          skos:example "An agent creates a service order specifying the one-time repair to be performed." .


###  http://example.org/apqc#P10327
ex:P10327 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ResourcingPlan
                          ] ;
          ex:apqcSourceText "Developing a plan for sourcing and deploying the resources required to fulfill customer service needs. Document a detailed summary of all types of resources (equipment, finance, personnel, time, etc.) required to complete customer service requests and procure these resources. Identify and assess various sources in order to effectively create a resourcing plan." ;
          ex:hierarchyID "6.3.4.2.1" ;
          ex:pcfID "10327" ;
          rdfs:comment "Genus ex:ActOfScheduling (PROPOSE-EXT): allocates resource types and timing; Directive ResourcingPlan output." ;
          rdfs:label "Create resourcing plan and schedule" ;
          skos:definition "An Act of Scheduling that develops a plan for sourcing and deploying service resources and produces a resourcing plan." ;
          skos:example "A planner documents the equipment, personnel, and timing needed to deliver the service." .


###  http://example.org/apqc#P10328
ex:P10328 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ServiceOrderFulfillmentSchedule
                          ] ;
          ex:apqcSourceText "Designing a detailed summary of customer service order requirements, along with information concerning the timing and duration for these services. Categorize the customer needs. Monitor the services delivered." ;
          ex:hierarchyID "6.3.4.2.2" ;
          ex:pcfID "10328" ;
          rdfs:comment "Genus ex:ActOfScheduling (PROPOSE-EXT): fixes timing/duration of service orders; Directive output." ;
          rdfs:label "Create service order fulfillment schedule" ;
          skos:definition "An Act of Scheduling that designs the timing and duration of customer service orders and produces a service order fulfillment schedule." ;
          skos:example "A planner sequences each service order with its expected timing and duration." .


###  http://example.org/apqc#P10330
ex:P10330 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ServiceOrderFulfillmentSchedule
                          ] ;
          ex:apqcSourceText "Laying out a daily plan of specific service orders that need to be fulfilled. Document and systematically order these activities to ensure high effectiveness and efficiency." ;
          ex:hierarchyID "6.3.4.3.1" ;
          ex:pcfID "10330" ;
          rdfs:comment "Genus ex:ActOfScheduling (PROPOSE-EXT): sequences the day's service orders; Directive output." ;
          rdfs:label "Organize daily service order fulfillment schedule" ;
          skos:definition "An Act of Scheduling that lays out the daily plan of specific service orders to be fulfilled and produces a service order fulfillment schedule." ;
          skos:example "A dispatcher sequences the technician's stops for the day." .


###  http://example.org/apqc#P10331
ex:P10331 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:FieldServiceAgent
                          ] ;
          ex:apqcSourceText "Dispatching and delivering the resources needed for the specific service requirements from the source/warehouse. Manage the dispatch, transportation, and delivery of the services." ;
          ex:hierarchyID "6.3.4.3.2" ;
          ex:pcfID "10331" ;
          ex:requiresRole ex:FieldServiceAgentRole ;
          rdfs:comment "Re-anchored to ex:ActOfServiceProvision (operations delivery genus, consistent with parent P10322 'Provide service to specific customers') per Gate-F review. The verbatim apqcSourceText describes a LOGISTICS/DISPATCH act, not a repair: 'Dispatching and delivering the resources needed for the specific service requirements from the source/warehouse. Manage the dispatch, transportation, and delivery of the services.' There is NO mention of modifying/repairing a product. REJECTED the prior cco:ont00000950 (Act of Maintenance) anchor as a label-vs-source false friend that Gates A-D cannot catch: maintenance restores a Material Artifact's designed qualities, which the description never describes. The prior rdfs:label 'Execute product repair' did not match the dispatch/delivery source text and has been corrected to match the source; the ex:DefectiveProduct material participant (a repair artifact) is replaced by the field service agent who performs the dispatch/delivery. If APQC truly intends repair here, this label/description discrepancy should be confirmed with the domain owner before reverting to Act of Maintenance." ;
          rdfs:label "Dispatch and deliver service resources" ;
          skos:definition "An Act of Service Provision that dispatches, transports, and delivers from the source or warehouse the resources needed to fulfil specific service requirements." ;
          skos:example "A dispatcher releases the parts and equipment from the warehouse and routes a field service agent to deliver them for the day's service orders." .


###  http://example.org/apqc#P10332
ex:P10332 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ServiceOrder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ServiceOrderFulfillmentStatus
                          ] ;
          ex:apqcSourceText "Handling and managing orders fulfilled, along with the orders are not or partially fulfilled to track the order fulfillment progress. Use electronic devices such as trackers and GPS in order track and ensure delivery of the orders." ;
          ex:hierarchyID "6.3.4.3.3" ;
          ex:pcfID "10332" ;
          rdfs:comment "Genus ex:ActOfMonitoring (PROPOSE-EXT): ongoing tracking of order progress yields a Descriptive status report. Despite the 'Manage' label the description denotes a bounded, repeatable tracking act, so it is a process." ;
          rdfs:label "Manage service order fulfillment" ;
          skos:definition "An Act of Monitoring that tracks the fulfillment progress of service orders and produces a service order fulfillment status." ;
          skos:example "A coordinator uses GPS trackers to monitor which service orders are delivered." .


###  http://example.org/apqc#P10334
ex:P10334 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ServiceOrderFulfillmentStatus
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompletedServiceOrderRegister
                          ] ;
          ex:apqcSourceText "Determining the service orders that have been successfully delivered. Identify the service orders completed and delivered to the customer. Leverage communication systems to ensure coordination with the customers in order to avoid mishaps." ;
          ex:hierarchyID "6.3.4.4.1" ;
          ex:pcfID "10334" ;
          rdfs:comment "Genus ex:ActOfIdentification (apqc-ext, discernment sense): enumerates the completed orders; Descriptive register output." ;
          rdfs:label "Identify completed service orders for feedback" ;
          skos:definition "An Act of Identification that discerns the service orders successfully completed and delivered and produces a completed service order register." ;
          skos:example "A team lists the orders confirmed delivered to solicit feedback on them." .


###  http://example.org/apqc#P10335
ex:P10335 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ServiceOrderFulfillmentStatus
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:IncompleteServiceOrderRegister
                          ] ;
          ex:apqcSourceText "Determining orders which have not been completed or delivered. Identify the service orders that are partially or entirely incomplete, as well as the orders that have not been delivered to the customer. Use techniques such as project trackers to recognize the progress of the service orders." ;
          ex:hierarchyID "6.3.4.4.2" ;
          ex:pcfID "10335" ;
          rdfs:comment "Genus ex:ActOfIdentification (apqc-ext, discernment sense): enumerates incomplete orders/failures; Descriptive register output." ;
          rdfs:label "Identify incomplete service orders and service failures" ;
          skos:definition "An Act of Identification that discerns the partially or entirely incomplete service orders and service failures and produces an incomplete service order register." ;
          skos:example "A team lists undelivered and failed orders for follow-up." .


###  http://example.org/apqc#P10336
ex:P10336 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Customer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerFeedback
                          ] ;
          ex:apqcSourceText "Obtaining and procuring customer reviews or feedback on the services delivered. Design a customer feedback form, or communicate with the customer through the phone or online." ;
          ex:hierarchyID "6.3.4.4.3" ;
          ex:pcfID "10336" ;
          ex:requiresRole ex:CustomerRole ;
          rdfs:comment "Anchored at cco:ont00000402 (Act of Communication): the customer-feedback ICE is transferred from the customer to the organization. Participant ex:Customer where definitional." ;
          rdfs:label "Solicit customer feedback on services delivered" ;
          skos:definition "An Act of Communication that obtains customer feedback on the services delivered." ;
          skos:example "An agent calls the customer to collect feedback after a repair." .


###  http://example.org/apqc#P10337
ex:P10337 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerFeedback
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ImprovementOpportunityAnalysis
                          ] ;
          ex:apqcSourceText "Assessing and incorporating customer reviews/feedback into the service plan to ensure high quality of service." ;
          ex:hierarchyID "6.3.4.4.4" ;
          ex:pcfID "10337" ;
          rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): assessing feedback to judge improvement opportunities; Descriptive output." ;
          rdfs:label "Process customer feedback on services delivered" ;
          skos:definition "An Act of Appraisal that has as input customer feedback and has as output an improvement opportunity analysis for the service plan." ;
          skos:example "A team reviews survey results and identifies improvements to the service plan." .


###  http://example.org/apqc#P10338
ex:P10338 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10343
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10344
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10345
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10346
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10347
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10348
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16905
                          ] ;
          ex:apqcSourceText "Outlining the strategy for managing logistics. Translate customer requirements logistic requirements. Create an efficient logistic network and outsourcing portions of logistics activities. Design a logistics strategy that optimizes transportation costs and schedule. Define key performance indicators." ;
          ex:hierarchyID "4.4.1" ;
          ex:pcfID "10338" ;
          ex:requiresCapability ex:LogisticsManagementCapability ,
                                ex:SupplyChainManagementCapability ;
          rdfs:comment "Planning/Formulation -> DIRECTIVE outputs (GOLDEN PRINCIPLE). Its APQC children are process parts, not subclasses." ;
          rdfs:label "Provide logistics governance" ;
          skos:definition "An Act of Formulation that composes the directive specifications governing an organization's logistics function - its logistics requirements, network design, outsourcing policy, delivery service policy, logistics strategy, performance measures, and reverse-logistics strategy." ;
          skos:example "A logistics function's annual governance cycle producing an updated logistics strategy and KPI set." .


###  http://example.org/apqc#P10340
ex:P10340 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10353
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10354
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10355
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10356
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10357
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10358
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10359
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20957
                          ] ;
          ex:apqcSourceText "Tracking the inventory deployment. Accept and store products. Ship the products. Measure the accuracy of the inventory. Assess the performance of the outsourced logistics activities." ;
          ex:hierarchyID "4.4.3" ;
          ex:pcfID "10340" ;
          ex:requiresCapability ex:LogisticsManagementCapability ,
                                ex:SupplyChainManagementCapability ;
          rdfs:comment "Heterogeneous operational aggregate anchored at the generic cco:ont00000228 (Planned Act). Its APQC children are process parts. The standing operate-warehousing function is realized by ex:LogisticsManagementCapability." ;
          rdfs:label "Operate warehousing" ;
          skos:definition "A Planned Act that carries out warehousing operations - inventory tracking, receipt and storage, picking and shipping, and accuracy and performance measurement - for an organization's goods." ;
          skos:example "A distribution center's daily warehousing cycle from inbound put-away through outbound pick-pack-ship." .


###  http://example.org/apqc#P10341
ex:P10341 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10360
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10361
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10363
                          ] ;
          ex:apqcSourceText "Creating a plan that specifies the schedule and system for transportation and delivery of the outbound products, as well as tracking the performance of the carrier delivery system. Conduct vehicle management and processing of all carrier-related documents." ;
          ex:hierarchyID "4.4.4" ;
          ex:pcfID "10341" ;
          ex:requiresCapability ex:FleetManagementCapability ,
                                ex:LogisticsManagementCapability ,
                                ex:SupplyChainManagementCapability ;
          rdfs:comment "Heterogeneous operational aggregate anchored at the generic cco:ont00000228 (Planned Act). Its APQC children are process parts. Gate-F: 4.4.4.3 'Manage transportation fleet' [10362] is NOT a process part here -- it is a standing function demoted to ex:FleetManagementCapability (R5), which is in turn realized in this bounded outbound-transport cycle." ;
          rdfs:label "Operate outbound transportation" ;
          skos:definition "A Planned Act that carries out outbound transportation operations - planning and executing transport and delivery of outbound products, tracking carrier performance, and auditing carrier documents." ;
          skos:example "A transportation team's cycle from outbound dispatch planning through carrier-invoice audit." .


###  http://example.org/apqc#P10343
ex:P10343 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LogisticsRequirementSpecification
                          ] ;
          ex:apqcSourceText "Determining the requirements for managing the flow of things between the point of origin and the point of consumption by assessing the service requirements of the customers." ;
          ex:hierarchyID "4.4.1.1" ;
          ex:pcfID "10343" ;
          rdfs:label "Translate customer service requirements into logistics requirements" ;
          skos:definition "An Act of Formulation that derives from customer service requirements and composes a logistics requirement specification for managing the flow of goods between origin and consumption." ;
          skos:example "A logistics planner converts a customer's service-level expectations into documented inbound/outbound logistics requirements." .


###  http://example.org/apqc#P10344
ex:P10344 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LogisticsNetworkDesign
                          ] ;
          ex:apqcSourceText "Developing a network for logistical activities. Create a network of entities through which materials and information flow, encompassing all related activities associated with the flow of transformation of products." ;
          ex:hierarchyID "4.4.1.2" ;
          ex:pcfID "10344" ;
          rdfs:label "Design logistics network" ;
          skos:definition "An Act of Formulation that composes a logistics network design specifying the entities through which materials and information flow." ;
          skos:example "A supply-chain team designs a hub-and-spoke distribution-center network for a product line." .


###  http://example.org/apqc#P10345
ex:P10345 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OutsourcingNeedsStatement
                          ] ;
          ex:apqcSourceText "Conveying outsourcing needs within the organization, with the objective of sourcing the assistance required. Define the portion of logistical activities that can be transferred to outside suppliers. Assess third-party agencies to carefully select the most appropriate agencies for outsourcing. Convey these needs to management or the appropriate authority." ;
          ex:hierarchyID "4.4.1.3" ;
          ex:pcfID "10345" ;
          rdfs:comment "Gate-F false-friend fix: re-anchored from ex:ActOfFormulation (Act of Planning) to cco:ont00000402 (Act of Communication). The source's lead verb is 'Conveying / Convey these needs to management or the appropriate authority' with the objective 'sourcing the assistance required' -- fundamentally a communication act, not the authoring of a directive policy. Rejected ex:ActOfFormulation: classifying a communication act under Planning is a mis-anchor; the description does not say a policy is produced. The definitional output is the conveyed Descriptive ex:OutsourcingNeedsStatement; ex:OutsourcingPolicy is dropped as the definitional output (APQC does not track a policy artifact here). The assess-and-select-agencies facet is a non-definitional sub-step. cco:ont00000402 verified: 'A Planned Act in which some Information Content Entity is transferred from some Agent to Another.'" ;
          rdfs:label "Communicate outsourcing needs" ;
          skos:definition "An Act of Communication in which an Agent determines which logistics activities to transfer to outside suppliers and conveys the resulting outsourcing needs statement to management or the appropriate authority." ;
          skos:example "A logistics manager conveys the warehousing scope to outsource to executives for action." .


###  http://example.org/apqc#P10346
ex:P10346 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DeliveryServicePolicy
                          ] ;
          ex:apqcSourceText "Establishing rules and regulations, as well as the terms and conditions regarding the delivery of service by the company. Develop a delivery plan that specifies what, how, when, and in which way to deliver services to the customer." ;
          ex:hierarchyID "4.4.1.4" ;
          ex:pcfID "10346" ;
          rdfs:label "Develop and maintain delivery service policy" ;
          skos:definition "An Act of Formulation that composes a delivery service policy prescribing the terms and conditions for delivering services to customers." ;
          skos:example "A logistics team issues a delivery-service policy defining delivery windows, modes, and customer notification terms." .


###  http://example.org/apqc#P10347
ex:P10347 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LogisticsStrategy
                          ] ;
          ex:apqcSourceText "Optimizing the schedule and costs of transportation services. Design a logistics strategy by strategically creating delivery routes and systems, which optimizes the overall transportation schedules and costs. Evaluate different transportation sources in order to select the most appropriate and cost-effective sources." ;
          ex:hierarchyID "4.4.1.5" ;
          ex:pcfID "10347" ;
          rdfs:comment "Evaluate-and-select-sources facet is folded into the strategy formulation; the definitional output is the directive logistics strategy." ;
          rdfs:label "Optimize transportation schedules and costs" ;
          skos:definition "An Act of Formulation that composes a logistics strategy of delivery routes and systems optimizing transportation schedules and costs and selecting cost-effective transportation sources." ;
          skos:example "A planner designs optimized delivery routes and selects carriers that minimize total transportation cost." .


###  http://example.org/apqc#P10348
ex:P10348 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:KeyPerformanceIndicatorSpecification
                          ] ;
          ex:apqcSourceText "Establishing measures for evaluating the performance of the logistics strategy of the organization. Establish key performance indicators, including the logistics performance index, delivery in full, and delivery on time." ;
          ex:hierarchyID "4.4.1.6" ;
          ex:pcfID "10348" ;
          rdfs:label "Define key performance measures" ;
          skos:definition "An Act of Formulation that composes a key performance indicator specification for evaluating the organization's logistics strategy." ;
          skos:example "A logistics team defines delivery-in-full and on-time KPIs and their measurement formulas." .


###  http://example.org/apqc#P10349
ex:P10349 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InboundMaterialReceiptPlan
                          ] ;
          ex:apqcSourceText "Managing the receipts of inbound materials. Create a plan accounting for the materials procured from the source of supply and the materials delivered to the distribution center or the warehouse." ;
          ex:hierarchyID "4.4.2.1" ;
          ex:pcfID "10349" ;
          rdfs:label "Plan inbound material receipts" ;
          skos:definition "An Act of Formulation that composes an inbound material receipt plan accounting for materials procured from supply and delivered to the distribution center or warehouse." ;
          skos:example "A receiving planner schedules expected inbound deliveries and dock assignments for the coming week." .


###  http://example.org/apqc#P10350
ex:P10350 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:InventoryItem
                          ] ;
          ex:apqcSourceText "Managing all the internal activities related to the flow/transfer of materials. Manage materials being delivered to distribution center or warehouse. Gauge the time taken for delivery and if the delivery process is on time." ;
          ex:hierarchyID "4.4.2.2" ;
          ex:pcfID "10350" ;
          rdfs:comment "Gate-F genus-too-narrow fix: re-anchored from ex:ActOfTransportation (Act of Location Change) to the generic cco:ont00000228 (Planned Act). The description is a coordination-plus-monitoring MANAGEMENT activity over all internal flow activities ('Managing all the internal activities related to the flow/transfer of materials'), not a single location change; reducing it to one Act of Location Change under-captured it. The monitoring facet -- 'Gauge the time taken for delivery and if the delivery process is on time' -- is now made explicit in the definition as a constituent monitoring task (it yields a descriptive delivery-timeliness judgement) rather than being silently dropped as a typical sub-step. R5: the standing 'Managing all... activities' oversight aspect is realized by ex:LogisticsManagementCapability; this class is the bounded per-cycle coordination act. Inbound inventory items participate via has participant (operations material I/O)." ;
          rdfs:label "Manage inbound material flow" ;
          skos:definition "A Planned Act that coordinates all the internal activities related to the flow and transfer of inbound materials to the distribution center or warehouse, including handling the materials and gauging whether delivery is on time." ;
          skos:example "A warehouse team routes arriving materials from the receiving dock to put-away locations and checks delivery timeliness." .


###  http://example.org/apqc#P10351
ex:P10351 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DeliveryPerformanceReport
                          ] ;
          ex:apqcSourceText "Overseeing the performance of an inbound delivery system. Check the present delivery system's efficiency, cost effectiveness, and adherence to a delivery schedule." ;
          ex:hierarchyID "4.4.2.3" ;
          ex:pcfID "10351" ;
          rdfs:label "Monitor inbound delivery performance" ;
          skos:definition "An Act of Monitoring that tracks the efficiency, cost-effectiveness, and schedule adherence of the inbound delivery system and produces a delivery performance report." ;
          skos:example "A logistics analyst reviews inbound on-time and cost metrics and issues a monthly delivery performance report." .


###  http://example.org/apqc#P10352
ex:P10352 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfTransportation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ReturnedProduct
                          ] ;
          ex:apqcSourceText "Tracking and taking care of the products that have been internally returned either because of their deficiency or in cases of incorrect delivery." ;
          ex:hierarchyID "4.4.2.4" ;
          ex:pcfID "10352" ;
          rdfs:comment "Operations material I/O (section 4.0): returned products participate via has participant. Returns arising from deficiency or incorrect delivery." ;
          rdfs:label "Manage flow of returned products" ;
          skos:definition "An Act of Transportation that moves and handles internally returned products through their reverse-logistics flow." ;
          skos:example "A returns team routes deficient returned units from receiving to the disposition staging area." .


###  http://example.org/apqc#P10353
ex:P10353 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InventoryRecord
                          ] ;
          ex:apqcSourceText "Tracking the logistical act of delivering or releasing an inventory item or entity to targeted end users. Track how much inventory has been deployed at all the distribution centers, individually." ;
          ex:hierarchyID "4.4.3.1" ;
          ex:pcfID "10353" ;
          rdfs:label "Manage and track inventory deployment" ;
          skos:definition "An Act of Monitoring that tracks how much inventory has been deployed and released to end users at each distribution center and produces an inventory record." ;
          skos:example "An inventory controller monitors per-DC deployment levels in the warehouse management system." .


###  http://example.org/apqc#P10354
ex:P10354 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfTransportation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:InventoryItem
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Warehouse
                          ] ;
          ex:apqcSourceText "Coordinating the incoming inbound materials/products. Accept the delivery of these materials and the subsequent storage. Track them at the warehouse/distribution center." ;
          ex:hierarchyID "4.4.3.2" ;
          ex:pcfID "10354" ;
          rdfs:comment "Operations material I/O (section 4.0): inbound inventory items and the warehouse participate via has participant. Inspection is a non-definitional sub-step." ;
          rdfs:label "Receive, inspect, and store inbound deliveries" ;
          skos:definition "An Act of Transportation that accepts inbound materials and moves them into storage within the warehouse or distribution center." ;
          skos:example "Dock staff receive a delivery, verify it, and put the goods away into warehouse storage." .


###  http://example.org/apqc#P10355
ex:P10355 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InventoryRecord
                          ] ;
          ex:apqcSourceText "Keeping track of the availability of different materials/products at the warehouse and distribution centers." ;
          ex:hierarchyID "4.4.3.3" ;
          ex:pcfID "10355" ;
          rdfs:label "Track product availability" ;
          skos:definition "An Act of Monitoring that tracks the availability of materials and products across warehouses and distribution centers and produces an inventory record." ;
          skos:example "A planner checks current on-hand availability of SKUs across all distribution centers." .


###  http://example.org/apqc#P10356
ex:P10356 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfTransportation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:FinishedProduct
                          ] ;
          ex:apqcSourceText "Packing and shipping the product to deliver to the customer. Take care of the internal and external packaging of the products in order to ensure safe transportation of the products from the warehouse to delivery locations. Notify the ERP system and/or Accounts Receivable Dept." ;
          ex:hierarchyID "4.4.3.4" ;
          ex:pcfID "10356" ;
          rdfs:comment "Operations material I/O (section 4.0): finished product participates via has participant. ERP/AR notification is a non-definitional sub-step." ;
          rdfs:label "Pick, pack, and ship product for delivery" ;
          skos:definition "An Act of Transportation that picks, packs, and moves finished product out of the warehouse for delivery to the customer." ;
          skos:example "A warehouse operator picks and packs an order and ships it from the dock to the customer." .


###  http://example.org/apqc#P10357
ex:P10357 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InventoryAccuracyReport
                          ] ;
          ex:apqcSourceText "Monitoring any discrepancies between electronic records that represent the inventory and the physical state of the inventory. Look for discrepancies such as phantom inventory, which includes products that an inventory accounting system considers to be available at the storage location but are not actually available." ;
          ex:hierarchyID "4.4.3.5" ;
          ex:pcfID "10357" ;
          rdfs:label "Track inventory accuracy" ;
          skos:definition "An Act of Monitoring that tracks discrepancies between inventory records and the physical state of inventory and produces an inventory accuracy report." ;
          skos:example "A cycle-count team reconciles system records against physical counts and reports phantom inventory." .


###  http://example.org/apqc#P10358
ex:P10358 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ThirdPartyLogisticsPerformanceReport
                          ] ;
          ex:apqcSourceText "Keeping a track on the storage and shipping performance of third-party agencies. Monitor logistics storage and shipping performance for third-party agencies. Use measures such as a logistics scoreboard, activity-based costing, economic value analysis, and balanced scorecards." ;
          ex:hierarchyID "4.4.3.6" ;
          ex:pcfID "10358" ;
          rdfs:label "Track third-party logistics storage and shipping performance" ;
          skos:definition "An Act of Monitoring that tracks the storage and shipping performance of third-party logistics agencies and produces a third-party logistics performance report." ;
          skos:example "A logistics manager scores a 3PL's storage and shipping metrics on a balanced scorecard." .


###  http://example.org/apqc#P10359
ex:P10359 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InventoryRecord
                          ] ;
          ex:apqcSourceText "Administering the movement of the finished products that are processed by the organization through its warehouses. Track goods through the use of systems such as barcodes in order to monitor the volumes available, quantity of out-flowing goods, remaining shelf life of the product, etc.--ultimately, to best manage the warehouse capacity." ;
          ex:hierarchyID "4.4.3.7" ;
          ex:pcfID "10359" ;
          rdfs:comment "Gate-F genus-mismatch + parallel-row fix: re-anchored from ex:ActOfTransportation to ex:ActOfMonitoring (Act of Information Processing). The defining content is administrative TRACKING/MONITORING to manage capacity ('Track goods through the use of systems such as barcodes in order to monitor the volumes available, quantity of out-flowing goods, remaining shelf life... to best manage the warehouse capacity'), not a location change. This aligns it with its sibling tracking acts 10353/10355/10357/10358, all correctly ex:ActOfMonitoring; anchoring it as Transportation was a parallel-row inconsistency. The has-participant ex:FinishedProduct/ex:Warehouse are demoted (the physical-movement administration is a non-definitional sub-step, not the genus); the definitional output is the Descriptive ex:InventoryRecord, agreeing with the monitoring genus (GOLDEN PRINCIPLE)." ;
          rdfs:label "Manage physical finished goods inventory" ;
          skos:definition "An Act of Monitoring that tracks finished goods through the warehouses -- volumes available, out-flowing quantities, and remaining shelf life -- to best manage warehouse capacity, producing an inventory record." ;
          skos:example "A warehouse supervisor monitors barcode-tracked volumes and shelf life to manage capacity." .


###  http://example.org/apqc#P10360
ex:P10360 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfTransportation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:FinishedProduct
                          ] ;
          ex:apqcSourceText "Organizing the transportation and delivery of outbound products. Plan and organize the transportation, shipping, and delivery of the end products. Create a plan that specifies dispatch and delivery of the product to its destination, as well the transportation." ;
          ex:hierarchyID "4.4.4.1" ;
          ex:pcfID "10360" ;
          rdfs:comment "Gate-F genus/output-contradiction fix: removed the [has output some ex:OutboundTransportationPlan] restriction. A location-change act does not, by its genus, author a Directive plan as its definitional output (the GOLDEN PRINCIPLE entails that a directive output requires a planning genus); authoring the plan is a planning act, while this compound 'Plan, transport, AND deliver' row is dominantly the physical move. The OutboundTransportationPlan is now a non-definitional annotation: the dispatch/delivery plan is a typical method-step input prepared for the move, not a definitional product of the location change, leaving a clean Transportation genus. (Where the planning facet is tracked separately, model it as a sibling ex:ActOfScheduling producing ex:OutboundTransportationPlan.) Finished product participates via has participant (operations material I/O)." ;
          rdfs:label "Plan, transport, and deliver outbound product" ;
          skos:definition "An Act of Transportation that moves and delivers outbound finished products to their destination." ;
          skos:example "A dispatcher plans routes and ships finished goods to their delivery destinations." .


###  http://example.org/apqc#P10361
ex:P10361 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CarrierPerformanceReport
                          ] ;
          ex:apqcSourceText "Monitoring delivery performance when carrying products from the warehouse/distribution centers to the retailers or end consumers. Create a performance metrics based on the key performance indicators." ;
          ex:hierarchyID "4.4.4.2" ;
          ex:pcfID "10361" ;
          rdfs:label "Track carrier delivery performance" ;
          skos:definition "An Act of Monitoring that tracks carrier delivery performance from warehouses to retailers or consumers and produces a carrier performance report." ;
          skos:example "A logistics analyst tracks carrier on-time delivery against KPIs and issues a carrier performance report." .


###  http://example.org/apqc#P10363
ex:P10363 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CarrierInvoice
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CarrierInvoiceAuditResult
                          ] ;
          ex:apqcSourceText "Organizing and inspecting all account statements and any other documentation for the carriers used in delivery. Create, manage, and inspect all documents related to the financial, regulatory, and administrative accounts of all the carriers/freights. Generate receipts for all freight transactions." ;
          ex:hierarchyID "4.4.4.4" ;
          ex:pcfID "10363" ;
          rdfs:comment "Information-Processing -> DESCRIPTIVE output (GOLDEN PRINCIPLE). Carrier invoice is an informational input (Descriptive ICE); receipt generation is a non-definitional sub-step." ;
          rdfs:label "Process and audit carrier invoices and documents" ;
          skos:definition "An Act of Information Processing that organizes and inspects carrier invoices and account documents and produces a carrier invoice audit result." ;
          skos:example "An accounts team reconciles carrier invoices against shipment records and flags billing discrepancies." .


###  http://example.org/apqc#P10364
ex:P10364 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ReturnRequest
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ReturnAuthorization
                          ] ;
          ex:apqcSourceText "Approving and carrying forward the requests by the customers to return the product. This is part of the process of returning a product in order to receive a refund, replacement, or repair during the product's warranty period." ;
          ex:hierarchyID "6.2.4.1" ;
          ex:pcfID "10364" ;
          rdfs:comment "Reuses shared ex:ActOfFormulation (composing a Directive ICE). Output is a Directive ICE (an authorization), agreeing with the formulation/planning genus (GOLDEN PRINCIPLE). Per Gate-F, the has input is the dedicated ex:ReturnRequest (the customer's product-return request named in the source 'requests by the customers to return the product'), REPLACING the prior false-friend reuse of ex:ServiceRequest, which is the individual-customer service-requirements ICE of 6.3.4.1 -- an unrelated informational object." ;
          rdfs:label "Authorize return" ;
          skos:definition "An Act of Formulation that has as input a customer return request and has as output a return authorization prescribing that the requested product return may proceed." ;
          skos:example "A warranty desk approves a return request and issues an RMA number." .


###  http://example.org/apqc#P10366
ex:P10366 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerCompensationOffer
                          ] ;
          ex:apqcSourceText "Executing activities for reinstating the returned products. Present the customer with additional incentives of compensation in case of any defective products delivery or any discrepancy in the product specifications in order to save the order from being permanently returned." ;
          ex:hierarchyID "4.4.2.5.2" ;
          ex:pcfID "10366" ;
          rdfs:comment "Gate-F label/text-divergence fix (D2): re-anchored from cco:ont00000950 (Act of Maintenance) to cco:ont00000402 (Act of Communication). The genus had been read from the LABEL ('salvage') rather than the de-conflated Element Description, which is about CUSTOMER INCENTIVES: 'Present the customer with additional incentives of compensation in case of any defective products delivery or any discrepancy... in order to save the order from being permanently returned.' That is a commercial communication/retention act, not physical maintenance of a Material Artifact. Rejected cco:ont00000950: nothing in the description restores an artifact's designed qualities; 'save the order' is a transactional outcome (R5 strain). CURATOR NOTE: if APQC genuinely intends physical salvage reconditioning, the source text is mismatched to the label and must be reconciled before reinstating cco:ont00000950. The has-participant ex:ReturnedProduct (definitional only under physical handling) is removed accordingly; the definitional output is the conveyed ex:CustomerCompensationOffer." ;
          rdfs:label "Perform salvage activities" ;
          skos:definition "An Act of Communication in which an Agent presents a customer with additional incentives or compensation for a defective delivery or specification discrepancy, conveying a customer compensation offer in order to save the order from being permanently returned." ;
          skos:example "A service rep offers a discrepant-order customer a discount and free reshipment to retain the sale." .


###  http://example.org/apqc#P10368
ex:P10368 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10371
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10372
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10373
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityStandard
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityTestingProcedure
                          ] ;
          ex:apqcSourceText "Developing standards and procedures for maintaining the quality of products/services. Establish desired quality targets. Create standardized procedures for the quality. Ensure quality specifications are effectively communicated." ;
          ex:hierarchyID "4.1.8" ;
          ex:pcfID "10368" ;
          rdfs:comment "Models APQC 4.1.8 as an occurrent; its APQC children are process parts." ;
          rdfs:label "Develop quality standards and procedures" ;
          skos:definition "An Act of Formulation that composes the quality targets and testing procedures for products and has as output a quality standard and a quality testing procedure." ;
          skos:example "The quality team sets target tolerances and writes the matching test procedures." .


###  http://example.org/apqc#P10369
ex:P10369 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000345 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10318
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10374
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10375
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P12045
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P12046
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20956
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityTestResult
                          ] ;
          ex:apqcSourceText "Executing tests to evaluate the quality of the products manufactured. Calibrate the test equipment. Conduct the actual tests. Record the results and outcomes of the quality test conducted." ;
          ex:hierarchyID "4.3.3" ;
          ex:pcfID "10369" ;
          rdfs:comment "Anchored under cco:ont00000345 (Act of Measuring): testing determines product quality relative to a standard. APQC children are process parts." ;
          rdfs:label "Perform quality testing" ;
          skos:definition "An Act of Measuring that evaluates the quality of manufactured products against a quality standard and produces a quality test result." ;
          skos:example "A QA lab calibrates gauges, runs tests on sampled units, and records results." .


###  http://example.org/apqc#P10370
ex:P10370 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10376
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10377
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProductionRecord
                          ] ;
          ex:apqcSourceText "Perpetuating the production records by systematically documenting and using it to ensure the effective management of lots. Determine the lot numbering system and its use. (The lot number enables tracking of the constituent parts, as well as labor and equipment records involved in the manufacturing of a product. It enables manufacturers and to perform quality control checks, calculate expiration dates, and issue corrections of their production output.)" ;
          ex:hierarchyID "4.3.4" ;
          ex:pcfID "10370" ;
          rdfs:comment "Anchored under cco:ont00000366 (Act of Information Processing): the modelable content is repeatable record-keeping producing a Descriptive ICE (production record). Its lot-definition children are process parts." ;
          rdfs:label "Maintain production records and manage lot traceability" ;
          skos:definition "An Act of Information Processing that systematically documents production into production records and establishes lot identification enabling traceability." ;
          skos:example "A plant logs each run into the batch record and assigns traceable lot numbers." .


###  http://example.org/apqc#P10371
ex:P10371 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityStandard
                          ] ;
          ex:apqcSourceText "Defining specific qualitative and quantitative target figures." ;
          ex:hierarchyID "4.1.8.1" ;
          ex:pcfID "10371" ;
          rdfs:label "Establish quality targets" ;
          skos:definition "An Act of Formulation that has as output a quality standard defining specific qualitative and quantitative quality target figures." ;
          skos:example "QA fixes the defect-rate and dimensional targets for the product family." .


###  http://example.org/apqc#P10372
ex:P10372 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityTestingProcedure
                          ] ;
          ex:apqcSourceText "Creating standard procedures for testing the quality of products/services. Describe the steps of key processes to help ensure consistent and quality output. Define the routine instructions for performing the quality testing activity." ;
          ex:hierarchyID "4.1.8.2" ;
          ex:pcfID "10372" ;
          rdfs:label "Develop standard testing procedures" ;
          skos:definition "An Act of Formulation that has as output a quality testing procedure prescribing the routine steps for testing product quality." ;
          skos:example "QA writes the inspection procedure for incoming and finished-goods testing." .


###  http://example.org/apqc#P10373
ex:P10373 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:QualityStandard
                          ] ;
          ex:apqcSourceText "Communicating the desired quality specifications to the manufacturing units, as well as the distribution centers, to avoid any misunderstanding or misinterpretation." ;
          ex:hierarchyID "4.1.8.3" ;
          ex:pcfID "10373" ;
          rdfs:comment "Re-anchored (Gate-F) to cco:ont00000402 (Act of Communication, co-anchored to cco:ont00000228 Planned Act): the act TRANSFERS an existing Directive ICE (the quality standard) to manufacturing units and distribution centers; it does not formulate the standard. Aligns with the communication anchoring of P10345 and P10366." ;
          rdfs:label "Communicate quality specifications" ;
          skos:definition "An Act of Communication that has as input a quality standard and transfers the desired quality specifications to manufacturing units and distribution centers." ;
          skos:example "QA circulates the approved quality spec sheet to all plants and DCs." .


###  http://example.org/apqc#P10374
ex:P10374 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000345 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductSample
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:QualityTestingProcedure
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityTestResult
                          ] ;
          ex:apqcSourceText "Performing testing using calibrated equipment and in consent with the standard testing procedure, including testing time." ;
          ex:hierarchyID "4.3.3.2" ;
          ex:pcfID "10374" ;
          rdfs:comment "The quality testing procedure is a held directive input prescribing the test; the product sample is the material input tested." ;
          rdfs:label "Perform testing using the standard testing procedure" ;
          skos:definition "An Act of Measuring that tests sampled product with calibrated equipment per the standard testing procedure and produces a quality test result." ;
          skos:example "A technician runs the prescribed tensile test on a sample and records the reading." .


###  http://example.org/apqc#P10375
ex:P10375 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:QualityTestResult
                          ] ;
          ex:apqcSourceText "Documenting the results and outcomes of the quality tests. Track the performance of the production process. Record/Document it to evaluate the qualitative efficiency of the production process. Use electronic devices and software in order to ensure effectiveness in recording the results and outcomes of the test." ;
          ex:hierarchyID "4.3.3.4" ;
          ex:pcfID "10375" ;
          rdfs:comment "Anchored under cco:ont00000366 (Act of Information Processing): recording manipulates and stores test outcomes as a Descriptive ICE." ;
          rdfs:label "Record test results" ;
          skos:definition "An Act of Information Processing that documents the outcomes of quality tests into a quality test result record." ;
          skos:example "A LIMS captures each gauge reading into the test record." .


###  http://example.org/apqc#P10376
ex:P10376 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LotNumberingSystemSpecification
                          ] ;
          ex:apqcSourceText "Allotting an identification number to a particular quantity or lot of material manufactured. Assign lot numbers on the basis of specific production units, material similarity, etc. Place lot numbers on the outside of packaging." ;
          ex:hierarchyID "4.3.4.1" ;
          ex:pcfID "10376" ;
          rdfs:comment "Anchored under ex:ActOfFormulation (Act of Planning): determining a numbering scheme yields a Directive ICE (the lot numbering system specification)." ;
          rdfs:label "Determine lot numbering system" ;
          skos:definition "An Act of Formulation that composes a lot numbering system specification prescribing how identification numbers are assigned to production lots." ;
          skos:example "Operations defines a YYMMDD-line-sequence lot-numbering convention." .


###  http://example.org/apqc#P10377
ex:P10377 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LotUsageSpecification
                          ] ;
          ex:apqcSourceText "Identifying the use of production lots. Define where, how, and when to use a specific production lot." ;
          ex:hierarchyID "4.3.4.2" ;
          ex:pcfID "10377" ;
          rdfs:comment "Anchored under ex:ActOfFormulation (Act of Planning): defining lot usage yields a Directive ICE, so the GOLDEN PRINCIPLE holds. Gate-F fix: replaced the wrongly-reused ex:DispositionDecision output with the dedicated ex:LotUsageSpecification. ex:DispositionDecision is defined for reverse logistics (it prescribes the salvage/repair/refurbish/restock disposition of a RETURNED PRODUCT and is about ex:ReturnedProduct); this act concerns forward production-lot allocation, so reusing it was a semantic mismatch that would mis-relate the act to ex:ReturnedProduct via the output's aboutness." ;
          rdfs:label "Determine lot use" ;
          skos:definition "An Act of Formulation that defines where, how, and when a production lot is to be used and produces a lot usage specification for the lot." ;
          skos:example "Planning earmarks a specific lot for a customer order and sets its consumption window." .


###  http://example.org/apqc#P10378
ex:P10378 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10382
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10383
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20086
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20087
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20088
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20089
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20092
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerServiceStrategy
                          ] ;
          ex:apqcSourceText "Defining a plan that removes customer obstacles by gathering operational insight and competitive insight, as well as improving soft skills and forward resolution for employees. Develop customer segmentation. Define rules and regulations for customer service. Establish service levels for customers." ;
          ex:hierarchyID "6.1" ;
          ex:pcfID "10378" ;
          rdfs:comment "Models APQC process group 6.1 as an occurrent. Its APQC children are process parts (cco:ont00001777), not subclasses. Output is a Directive ICE, agreeing with the ex:ActOfFormulation (Planning) genus." ;
          rdfs:label "Develop customer service strategy" ;
          skos:definition "An Act of Formulation that composes a customer service strategy governing how an organization removes customer obstacles, segments customers, and sets service levels." ;
          skos:example "A customer-service leadership team's annual cycle that issues the organization's customer service strategy." .


###  http://example.org/apqc#P10382
ex:P10382 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerServicePolicy
                          ] ;
          ex:apqcSourceText "Outlining the framework of policies and methods for developing customer service strategy. Establish the rules and regulations that serve as a guideline for the customer service strategy. Take into account customer needs and behavior." ;
          ex:hierarchyID "6.1.4" ;
          ex:pcfID "10382" ;
          rdfs:comment "Anchored to ex:ActOfFormulation: output is a Directive ICE (the policy)." ;
          rdfs:label "Define customer service policies and procedures" ;
          skos:definition "An Act of Formulation that composes a customer service policy establishing the rules and regulations that guide the customer service strategy." ;
          skos:example "A policy team publishes the customer service code of conduct and escalation rules." .


###  http://example.org/apqc#P10383
ex:P10383 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ServiceLevelAgreement
                          ] ;
          ex:apqcSourceText "Determining and implementing levels for customer services. Benchmark certain customer service practices, and base customer level services on those benchmarks. Create a service level agreement, which is a negotiated agreement designed to create a common understanding about services, priorities, and responsibilities." ;
          ex:hierarchyID "6.1.5" ;
          ex:pcfID "10383" ;
          rdfs:comment "Anchored to ex:ActOfFormulation: the definitional output is a Directive ICE (the SLA). Benchmarking is a typical sub-step, not the defining output, so it is not promoted to a restriction." ;
          rdfs:label "Establish target service level for each customer segment" ;
          skos:definition "An Act of Formulation that determines target customer service levels per segment and produces a service level agreement defining services, priorities, and responsibilities." ;
          skos:example "An operations manager negotiates and publishes a tiered SLA for premium and standard customer segments." .


###  http://example.org/apqc#P10390
ex:P10390 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfForecasting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:HistoricalContactData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ContactVolumeForecast
                          ] ;
          ex:apqcSourceText "Projecting the total work force required to service customer service inquiries in order to effectively predict the volume of vendor contracts required. Estimate the number of the customer service contracts in an agreed-upon time frame in order to strategically maintain the work force necessitated for customer inquires. Analyze historical data around customer service contracts, the universe of customer inquiries, frequency of inquiries, servicing capability (per head) of the employees, etc." ;
          ex:hierarchyID "6.2.1.1" ;
          ex:pcfID "10390" ;
          ex:requiresCapability ex:CustomerServiceWorkforceManagementCapability ;
          rdfs:comment "Reuses ex:ActOfForecasting (PROPOSE-EXT, section 3.0): extrapolation from historical data to a Predictive ICE. Output is descriptive/predictive (GOLDEN PRINCIPLE)." ;
          rdfs:label "Forecast volume of customer service contacts" ;
          skos:definition "An Act of Forecasting that has as input historical contact data and has as output a contact-volume forecast estimating the future number of customer service contacts over a given time frame." ;
          skos:example "A contact-center analyst projects next quarter's inquiry volume from last year's contact logs." .


###  http://example.org/apqc#P10391
ex:P10391 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfScheduling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ContactVolumeForecast
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceSchedule
                          ] ;
          ex:apqcSourceText "Deploying the work force to manage customer service contracts. Create a systematic summary of the operations and service required, as well as the specific amount of work force that is to be deployed to the customer service operations. Ensure work force is directly proportional to the estimated forecast of customer service contracts." ;
          ex:hierarchyID "6.2.1.2" ;
          ex:pcfID "10391" ;
          ex:requiresCapability ex:CustomerServiceWorkforceManagementCapability ;
          rdfs:comment "Output is a Directive ICE (a schedule), agreeing with the planning genus (GOLDEN PRINCIPLE). The forecast input is definitional (the text fixes the workforce as proportional to the forecast)." ;
          rdfs:label "Schedule customer service work force" ;
          skos:definition "An Act of Scheduling that has as input a contact-volume forecast and has as output a workforce schedule prescribing the customer service staff to be deployed over time." ;
          skos:example "A workforce planner builds the week's agent roster from the forecast contact volume." .


###  http://example.org/apqc#P10392
ex:P10392 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceUtilizationReport
                          ] ;
          ex:apqcSourceText "Tracking the utilization of work force deployed for managing customer service operations. Monitor the utility of the work force deployed for managing customer service operations in order to evaluate its efficiency and cost effectiveness. Calculate the overall labor effectiveness, which measures the utility, performance, and quality of the work force." ;
          ex:hierarchyID "6.2.1.3" ;
          ex:pcfID "10392" ;
          ex:requiresCapability ex:CustomerServiceWorkforceManagementCapability ;
          rdfs:comment "Anchored to ex:ActOfMonitoring (ongoing tracking yielding a descriptive status report), not Appraisal. Output is a Descriptive ICE (GOLDEN PRINCIPLE)." ;
          rdfs:label "Track work force utilization" ;
          skos:definition "An Act of Monitoring that tracks the utilization of the deployed customer service work force and has as output a workforce-utilization report describing its efficiency and effectiveness." ;
          skos:example "A team lead reviews dashboards and issues a monthly labor-effectiveness report." .


###  http://example.org/apqc#P10393
ex:P10393 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:CustomerServiceRepresentative
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InteractionQualityAssessment
                          ] ;
          ex:apqcSourceText "Tracking and determining the quality of interactions between the customer and customer representatives. Use electronic devices to record and effectively assess customer representatives' interactions." ;
          ex:hierarchyID "6.2.1.4" ;
          ex:pcfID "10393" ;
          ex:requiresCapability ex:CustomerServiceWorkforceManagementCapability ;
          ex:requiresRole ex:CustomerServiceRepresentativeRole ;
          rdfs:comment "Anchored to ex:ActOfMonitoring (ongoing tracking/recording of interaction quality yielding a descriptive assessment). The customer service representative whose interactions are tracked is a definitional participant." ;
          rdfs:label "Monitor and evaluate quality of customer interactions with customer service representatives" ;
          skos:definition "An Act of Monitoring that tracks the interactions between customers and customer service representatives and has as output an interaction-quality assessment describing their quality." ;
          skos:example "A QA analyst reviews recorded calls and scores agents on an interaction-quality rubric." .


###  http://example.org/apqc#P10394
ex:P10394 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Customer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerInquiry
                          ] ;
          ex:apqcSourceText "Receiving requests for information from customers over multiple channels. Receive various requests and inquiries from customers regarding products/services. Accept these inquiries through channels such as email, telephone, online forms, text messages, social media, and in person. Supply dedicated equipment, systems, and personnel." ;
          ex:hierarchyID "6.2.2.1" ;
          ex:pcfID "10394" ;
          ex:requiresCapability ex:CustomerInquiryManagementCapability ,
                                ex:CustomerServiceCapability ;
          ex:requiresRole ex:CustomerRole ;
          rdfs:comment "Anchored to cco:ont00000402 (Act of Communication: an ICE is transferred from one Agent to another); the inquiry is received, so the inquiry ICE is a definitional input and the customer a definitional participant." ;
          rdfs:label "Receive customer problems, requests, and inquiries" ;
          skos:definition "An Act of Communication in which a customer service representative receives a customer inquiry transferred by a customer over some channel." ;
          skos:example "An agent picks up a phone call in which a customer asks about a product feature." .


###  http://example.org/apqc#P10395
ex:P10395 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:CustomerServiceRepresentative
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerInquiry
                          ] ;
          ex:apqcSourceText "Routing customer inquiries in order to service them with the most apposite response. Direct customer inquires to the best suited personnel or system. Have a system or procedure capable of efficiently channeling these requests." ;
          ex:hierarchyID "6.2.2.3" ;
          ex:pcfID "10395" ;
          ex:requiresCapability ex:CustomerInquiryManagementCapability ,
                                ex:CustomerServiceCapability ;
          ex:requiresRole ex:CustomerServiceRepresentativeRole ;
          rdfs:comment "Re-anchored to cco:ont00000402 (Act of Communication) per Gate-F review, mirroring its sibling P10398 (6.2.3.2 'Route customer complaints'). The verbatim source describes NO settlement: 'Routing customer inquiries in order to service them with the most apposite response. Direct customer inquires to the best suited personnel or system. Have a system or procedure capable of efficiently channeling these requests.' This is routing/channeling, ontologically identical to the complaint-flow sibling P10398, which this module anchors at cco:ont00000402. The inquiry flow has no separate 'route' step, so the routing description was filed under the 'Resolve' label. REJECTED the prior ex:ActOfResolution anchor as a label-over-description false friend (Step-2 trap): a routing/directing act settles nothing. The existential output ex:InquiryResolution is DEMOTED -- it is not produced by routing; the inquiry remains the definitional has input (cco:ont00001921) and the customer service representative is the routing participant. If APQC genuinely intends end-to-end resolution here, the missing investigate/decide/close sub-acts would have to be added to justify a Resolution genus; absent them, the routing reading wins as the only thing the text describes." ;
          rdfs:label "Resolve customer problems, requests, and inquiries" ;
          skos:definition "An Act of Communication in which a received customer inquiry is directed to the personnel or system best suited to service it with the most apposite response." ;
          skos:example "A triage system routes a technical request to the specialist best suited to answer it." .


###  http://example.org/apqc#P10396
ex:P10396 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000379 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Customer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:InquiryResponse
                          ] ;
          ex:apqcSourceText "Responding to customer requests by email, conversation, interactive voice response, mail, etc. with the most appropriate reply. Instill a robust process to locate the right information for a solution to a customer's problem." ;
          ex:hierarchyID "6.2.2.4" ;
          ex:pcfID "10396" ;
          ex:requiresCapability ex:CustomerInquiryManagementCapability ,
                                ex:CustomerServiceCapability ;
          ex:requiresRole ex:CustomerRole ;
          rdfs:comment "Anchored to cco:ont00000379 (Act of Representative Communication: an Act of Communication committing the speaker to the truth of the asserted reply). The response ICE is the definitional output transferred to the customer." ;
          rdfs:label "Respond to customer problems, requests, and inquiries" ;
          skos:definition "An Act of Representative Communication in which a customer service representative transfers an inquiry response to the customer who raised the inquiry." ;
          skos:example "An agent emails the customer the answer and resolution steps for their request." .


###  http://example.org/apqc#P10397
ex:P10397 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Customer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerComplaint
                          ] ;
          ex:apqcSourceText "Receiving any complaints or grievances from customers for the organization's products/services. Receive objections, complaints, and criticism from customers regarding products/services through email, telephone, online forms, text messages, social media, in person, etc. Dedicate equipment, systems, and personnel." ;
          ex:hierarchyID "6.2.3.1" ;
          ex:pcfID "10397" ;
          ex:requiresCapability ex:CustomerComplaintManagementCapability ,
                                ex:CustomerServiceCapability ;
          ex:requiresRole ex:CustomerRole ;
          rdfs:comment "Anchored to cco:ont00000402 (Act of Communication). The complaint ICE is the definitional input received and the customer a definitional participant." ;
          rdfs:label "Receive customer complaints" ;
          skos:definition "An Act of Communication in which a customer service representative receives a customer complaint transferred by a customer over some channel." ;
          skos:example "A service desk logs a grievance submitted through an online complaint form." .


###  http://example.org/apqc#P10398
ex:P10398 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerComplaint
                          ] ;
          ex:apqcSourceText "Routing any complaints or grievances received from customers in order to address them in the most appropriate manner. Direct complaints to the best suited personnel or system. Implement a system or procedure capable of efficiently channeling the various objections, complaints, and criticism from customers over the offerings provided by the organization." ;
          ex:hierarchyID "6.2.3.2" ;
          ex:pcfID "10398" ;
          ex:requiresCapability ex:CustomerComplaintManagementCapability ,
                                ex:CustomerServiceCapability ;
          rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): routing transfers the complaint ICE onward to the appropriate handler. The complaint is the definitional input." ;
          rdfs:label "Route customer complaints" ;
          skos:definition "An Act of Communication in which a received customer complaint is directed to the personnel or system best suited to address it." ;
          skos:example "A triage rule forwards a billing complaint to the finance support queue." .


###  http://example.org/apqc#P10399
ex:P10399 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfResolution ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000063 ;
                            owl:someValuesFrom ex:P10400
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerComplaint
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ComplaintResolution
                          ] ;
          ex:apqcSourceText "Resolving any customer complaints that are deemed to be sound and reasonable. Redress any objections, grievances, and complaints received from customers regarding the offerings provided by the organization. Identify the legitimate complaints, where the situation needs to be appropriately corrected. Deploy personnel who can rectify the issue within a stipulated time frame." ;
          ex:hierarchyID "6.2.3.3" ;
          ex:pcfID "10399" ;
          ex:requiresCapability ex:CustomerComplaintManagementCapability ,
                                ex:CustomerServiceCapability ;
          rdfs:comment "Anchored to ex:ActOfResolution (PROPOSE-EXT): redressing a sound complaint and recording the settlement. Output is a Descriptive ICE (consistent with the Planned-Act genus)." ;
          rdfs:label "Resolve customer complaints" ;
          skos:definition "An Act of Resolution that has as input a legitimate customer complaint and has as output a complaint resolution recording the corrective action taken to redress it." ;
          skos:example "A support team issues a replacement unit and records the complaint as resolved." .


###  http://example.org/apqc#P10400
ex:P10400 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000379 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Customer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ComplaintResolution
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ComplaintResponse
                          ] ;
          ex:apqcSourceText "Responding to customer complaints including all activities necessitated to service any objections, complaints, or grievances with the most appropriate reply. Source the right information to formulate a response that eases the discomfort being experienced by the customer. (Closely coordinate with Resolve customer complaints [10399].)" ;
          ex:hierarchyID "6.2.3.4" ;
          ex:pcfID "10400" ;
          ex:requiresCapability ex:CustomerComplaintManagementCapability ,
                                ex:CustomerServiceCapability ;
          ex:requiresRole ex:CustomerRole ;
          rdfs:comment "Anchored to cco:ont00000379 (Act of Representative Communication). The response ICE is the definitional output transferred to the customer. Source text cross-references Resolve customer complaints [10399]: the resolution precedes and feeds the response." ;
          rdfs:label "Respond to customer complaints" ;
          skos:definition "An Act of Representative Communication in which a customer service representative transfers a complaint response to the customer who raised the complaint." ;
          skos:example "An agent sends the customer an apology and the steps taken to fix their issue." .


###  http://example.org/apqc#P10401
ex:P10401 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11687
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11688
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P18126
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerSatisfactionAssessment
                          ] ;
          ex:apqcSourceText "Calculating satisfaction levels of customers by effectively evaluating the process of handling requests/inquiries of customers. Effectively calculate the performance of customer-requests/inquiries handling and resolution. Obtain information regarding requests/inquiries handling and resolution through customer feedback. Use it to explore new ideas and opportunities for enhanced customer requests/inquiries handling and resolution process." ;
          ex:hierarchyID "6.5.1" ;
          ex:pcfID "10401" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges satisfaction/performance and yields the Descriptive ex:CustomerSatisfactionAssessment (GOLDEN PRINCIPLE). Customer feedback is a typical input gathered by its child 6.5.1.1, so it is recorded here as commentary rather than a definitional has-input restriction." ;
          rdfs:label "Measure customer satisfaction with customer problems, requests, and inquiries handling" ;
          skos:definition "An Act of Appraisal that evaluates how customer requests and inquiries are handled and resolved and produces a customer satisfaction assessment." ;
          skos:example "A contact-centre quality team calculates satisfaction with how inquiries were resolved last quarter and reports the result." .


###  http://example.org/apqc#P10402
ex:P10402 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11236
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11237
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11689
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerSatisfactionAssessment
                          ] ;
          ex:apqcSourceText "Measuring the satisfaction level of customers as pertains to how their complaints are handled and resolved. This process element requires the organization to estimate the customers level of fulfillment with the process reconciling their complaints and towards the objective of ensuring customer retention. The feedback received can be used to develop concepts for new opportunities to boost the level of customer satisfaction." ;
          ex:hierarchyID "6.5.2" ;
          ex:pcfID "10402" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it estimates the customers' level of fulfilment and yields the Descriptive ex:CustomerSatisfactionAssessment (GOLDEN PRINCIPLE)." ;
          rdfs:label "Measure customer satisfaction with customer-complaint handling and resolution" ;
          skos:definition "An Act of Appraisal that evaluates how customer complaints are handled and resolved and produces a customer satisfaction assessment." ;
          skos:example "A complaints-management team measures how satisfied customers were with the resolution of their complaints to support retention." .


###  http://example.org/apqc#P10403
ex:P10403 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11238
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11239
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11240
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11241
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20117
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CustomerSatisfactionAssessment
                          ] ;
          ex:apqcSourceText "Calculating satisfaction levels of customers with products/services. Obtain customer feedback on products/services, as well as the effectiveness of the advertising campaigns. Examine this information to reach meaningful conclusions, which could then be used to enhance the customer service operations." ;
          ex:hierarchyID "6.5.3" ;
          ex:pcfID "10403" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it calculates and judges satisfaction levels and yields the Descriptive ex:CustomerSatisfactionAssessment (GOLDEN PRINCIPLE)." ;
          rdfs:label "Measure customer satisfaction with products and services" ;
          skos:definition "An Act of Appraisal that evaluates customers' satisfaction with an organization's products and services and produces a customer satisfaction assessment." ;
          skos:example "A voice-of-customer team calculates post-sale product satisfaction and draws conclusions to improve service operations." .


###  http://example.org/apqc#P10410
ex:P10410 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10439
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10440
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10443
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10444
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20123
                          ] ;
          ex:apqcSourceText "Determining and handling employee requirements. Recruit or source the candidates as per the requirements. Screen and select the most appropriate candidates. Take care of the newly hired and re-hired employees. Maintain records of information for all applicants." ;
          ex:hierarchyID "7.2" ;
          ex:pcfID "10410" ;
          ex:requiresCapability ex:HumanCapitalManagementCapability ,
                                ex:TalentAcquisitionCapability ;
          rdfs:comment "Models APQC process group 7.2 as an occurrent. Its APQC Process children are process parts (cco:ont00001777), not subclasses." ;
          rdfs:label "Recruit, source, and select employees" ;
          skos:definition "An Act of Administration that handles employee requisitions, sources and screens candidates, hires the selected candidates, and maintains applicant records, so as to staff an organization's open positions." ;
          skos:example "An organization's recruiting team runs an end-to-end hiring cycle for a set of open positions." .


###  http://example.org/apqc#P10413
ex:P10413 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10512
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10513
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10514
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10515
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10516
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P17055
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20132
                          ] ;
          ex:apqcSourceText "Managing the reassignment and retirement of employees. Manage the process of employee promotion and demotion. Administer separation, retirement, and leaves of absence. Outplace employees. Deploy personnel. Relocate employees in order to manage assignments." ;
          ex:hierarchyID "7.6" ;
          ex:pcfID "10413" ;
          ex:requiresCapability ex:HumanCapitalManagementCapability ,
                                ex:WorkforceDeploymentCapability ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Models APQC process group 7.6 as a bounded occurrent. Its APQC children are process parts (cco:ont00001777), not subclasses. Has the affected employee as participant." ;
          rdfs:label "Redeploy and retire employees" ;
          skos:definition "An Act of Administration that carries out the organization's procedures for reassigning, redeploying, and separating employees, comprising the administration of promotions and demotions, separations, retirements, leaves of absence, outplacement, scheduling, and relocations." ;
          skos:example "An HR operations team runs the end-to-end cycle of moving, retiring, and offboarding employees over a quarter." .


###  http://example.org/apqc#P10417
ex:P10417 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10434
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10435
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10436
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10438
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceData
                          ] ;
          ex:apqcSourceText "Supervising the HR strategy, plans, and policies in order to refurbish them whenever needed. Determine the performance of HR plans and policies by measuring the objective achievement rate and its contribution to the overall business strategy. Ensure that information about these plans and strategies is effectively communicated to various stakeholders. Incorporate any suggestions by these stakeholders when revising HR plans and policies." ;
          ex:hierarchyID "7.1.3" ;
          ex:pcfID "10417" ;
          ex:requiresCapability ex:HumanCapitalManagementCapability ,
                                ex:WorkforcePlanningCapability ;
          rdfs:comment "Models APQC 7.1.3 as a bounded occurrent (a monitoring-and-revision cycle). Its APQC children are process parts (cco:ont00001777). Anchored at Act of Administration since the umbrella act supervises and maintains held directives." ;
          rdfs:label "Monitor and update strategy, plans, and policies" ;
          skos:definition "An Act of Administration that has as input performance data and an HR policy and oversees and revises the organization's HR strategy, plans, and policies." ;
          skos:example "HR runs its annual review cycle measuring and revising the HR strategy." .


###  http://example.org/apqc#P10418
ex:P10418 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicGoals
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicHRNeedsAssessment
                          ] ;
          ex:apqcSourceText "Strategically defining the current and future needs for developing an efficient HR strategy." ;
          ex:hierarchyID "7.1.1.1" ;
          ex:pcfID "10418" ;
          rdfs:comment "Genus is Act of Analysis (Information Processing): the output is a descriptive needs assessment, not a prescription (GOLDEN PRINCIPLE)." ;
          rdfs:label "Identify strategic HR needs" ;
          skos:definition "An Act of Analysis that has as input strategic goals and workforce data and produces a strategic HR needs assessment of the organization's current and future human-resource needs." ;
          skos:example "An HR analyst assesses current and projected staffing needs ahead of strategy development." .


###  http://example.org/apqc#P10419
ex:P10419 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:HumanResourcesProfessional
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRProgramSpecification
                          ] ;
          ex:apqcSourceText "Outlining the charge and duty of the HR function by defining its responsibility areas, as well as ensuring its accountability. Establish the HR function by laying out the roles and responsibilities for this function and the rules and regulations guiding HR. Define the goals and objectives of the HR, as well as a mission and vision for this function. Create a mechanism involving a set of policies, code of conduct, and institutional procedure to ensure HR accountability." ;
          ex:hierarchyID "7.1.1.2" ;
          ex:pcfID "10419" ;
          ex:requiresRole ex:HumanResourcesProfessionalRole ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive specification of roles/accountability (Directive ICE)." ;
          rdfs:label "Define HR and business function roles and accountability" ;
          skos:definition "An Act of Formulation that produces an HR program specification laying out the roles, responsibilities, goals, mission, and accountability mechanisms of the human resources function." ;
          skos:example "HR leadership documents the HR function's charter, responsibilities, and accountability rules." .


###  http://example.org/apqc#P10420
ex:P10420 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRCostAnalysis
                          ] ;
          ex:apqcSourceText "Ascertaining the costs and expenses of the HR function. Identify and report HR investments using, for example, a cost approach or a present value of future earnings approach." ;
          ex:hierarchyID "7.1.1.5" ;
          ex:pcfID "10420" ;
          rdfs:comment "Genus is Act of Analysis: output is a descriptive cost analysis, not a prescription (GOLDEN PRINCIPLE)." ;
          rdfs:label "Determine HR costs" ;
          skos:definition "An Act of Analysis that has as input HR policy data and produces an HR cost analysis ascertaining and reporting the costs and investments of the human resources function." ;
          skos:example "An HR analyst reports the fully loaded cost of the HR function for the fiscal year." .


###  http://example.org/apqc#P10421
ex:P10421 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRMeasureSpecification
                          ] ;
          ex:apqcSourceText "Evaluating the performance of HR function. Lay out the course of HR procedures that would formulate a plan of action needed to fulfill strategic HR needs. Deploy measures such as hiring policies, leave management, internal code of conducts, and compensation structure." ;
          ex:hierarchyID "7.1.1.6" ;
          ex:pcfID "10421" ;
          rdfs:comment "Genus is Act of Formulation: despite 'evaluating', the definitional output is a prescriptive specification of measures/procedures (Directive ICE)." ;
          rdfs:label "Establish HR measures" ;
          skos:definition "An Act of Formulation that produces an HR measure specification laying out the HR procedures and measures needed to fulfill strategic HR needs." ;
          skos:example "HR establishes the set of policies and measures (hiring, leave, conduct) implementing the HR strategy." .


###  http://example.org/apqc#P10422
ex:P10422 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ManagementPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeCommunicationPlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:HumanResourcesStrategy
                          ] ;
          ex:apqcSourceText "Conveying the strategies of HR function to employees and management. Effectively explain the vision, plans, and anticipated benefits of the HR strategy employees, as well as the public. Develop statements and messages that are easy to read, informative, and relevant to the audience." ;
          ex:hierarchyID "7.1.1.7" ;
          ex:pcfID "10422" ;
          ex:requiresRole ex:EmployeeRole ,
                          ex:ManagerRole ;
          rdfs:comment "Re-anchored from ex:ActOfAdministration to cco:ont00000402 (Act of Communication, verified: a Planned Act transferring an ICE from one Agent to another). Administration was a false-friend genus driven by 'Manage'-style framing; the source ('Conveying the strategies ... explain the vision, plans ...') is dissemination, consistent with P10532 and the 7.2/7.7 communication rows. Per the GOLDEN PRINCIPLE the act disseminates a held directive rather than producing one: ex:HumanResourcesStrategy is the disseminated has-input and ex:EmployeeCommunicationPlan is a governing has-input (changed from has-output), mirroring P10532; employees and management personnel are definitional recipients." ;
          rdfs:label "Communicate HR strategies" ;
          skos:definition "An Act of Communication that disseminates a held human resources strategy to employees and management in accordance with an employee communication plan, conveying the strategy's vision, plans, and benefits." ;
          skos:example "HR rolls out the new HR strategy to all staff in line with the employee communication plan." .


###  http://example.org/apqc#P10423
ex:P10423 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SkillRequirementData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforcePlan
                          ] ;
          ex:apqcSourceText "Evaluating the current and future skill requirements of the organization with regard to the overall corporate strategy of the organization and market conditions. Identify and establish the minimum skills needed for the requisite HR needs." ;
          ex:hierarchyID "7.1.2.1" ;
          ex:pcfID "10423" ;
          rdfs:comment "Genus is Act of Formulation: the definitional output is a prescriptive workforce plan (Directive ICE)." ;
          rdfs:label "Perform workforce planning" ;
          skos:definition "An Act of Formulation that has as input skill requirement data and strategic goals and produces a workforce plan establishing the skills and staffing the organization requires." ;
          skos:example "HR plans the skills and headcount the organization will need over the planning horizon." .


###  http://example.org/apqc#P10424
ex:P10424 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StaffingPlan
                          ] ;
          ex:apqcSourceText "Determining the requirements for employees and the need for employee resourcing for each every unit/function. Lay out a plan detailing employee resourcing requirements of individual functions and the organization as a whole." ;
          ex:hierarchyID "7.1.2.2" ;
          ex:pcfID "10424" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive staffing plan (Directive ICE)." ;
          rdfs:label "Perform operational workforce planning" ;
          skos:definition "An Act of Formulation that has as input workforce data and produces a staffing plan detailing employee-resourcing requirements for each unit and for the organization as a whole." ;
          skos:example "HR lays out per-department headcount and resourcing requirements for the year." .


###  http://example.org/apqc#P10425
ex:P10425 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10210
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketCompensationData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompensationStrategy
                          ] ;
          ex:apqcSourceText "Designing a plan that specifies the combination of wages, salaries, and benefits the employees receive in exchange for work. Define the total amount of compensation, in addition to the manner in which the compensation is paid and the purposes for which employees can receive bonuses, salary increases, and incentives." ;
          ex:hierarchyID "7.1.2.3" ;
          ex:pcfID "10425" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive compensation strategy (Directive ICE). Has process part 7.1.2.3.1 (establish incentive strategy)." ;
          rdfs:label "Develop compensation strategy" ;
          skos:definition "An Act of Formulation that has as input market compensation data and produces a compensation strategy specifying the combination of wages, salaries, and benefits employees receive in exchange for work." ;
          skos:example "Total-rewards team designs the firm's compensation strategy." .


###  http://example.org/apqc#P10426
ex:P10426 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SuccessionPlan
                          ] ;
          ex:apqcSourceText "Creating and implementing the plan for continuation of key positions within the organization. Identify internal people with the potential to fill key business leadership positions. Provide critical development experiences to employees who can move into important roles. Engage leaders to support the development of high-potential leaders." ;
          ex:hierarchyID "7.1.2.4" ;
          ex:pcfID "10426" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive succession plan (Directive ICE)." ;
          rdfs:label "Develop succession plan" ;
          skos:definition "An Act of Formulation that has as input employee data and produces a succession plan for the continuation of key positions within the organization." ;
          skos:example "HR identifies high-potential leaders and documents a succession plan for key roles." .


###  http://example.org/apqc#P10427
ex:P10427 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DiversityEquityInclusionPlan
                          ] ;
          ex:apqcSourceText "Creating and implementing the plan for ensuring a diverse work force. Develop and hire employees with varying characteristics including, but not limited to, religious and political beliefs, gender, ethnicity, education, socioeconomic background, sexual orientation, and geographic location." ;
          ex:hierarchyID "7.1.2.6" ;
          ex:pcfID "10427" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive DEI plan (Directive ICE). Implementation of the plan is the sibling process 7.1.2.7." ;
          rdfs:label "Develop diversity, equity, and inclusion plan" ;
          skos:definition "An Act of Formulation that produces a diversity, equity, and inclusion plan for ensuring a diverse workforce." ;
          skos:example "HR develops a DEI plan setting representation goals and hiring practices." .


###  http://example.org/apqc#P10428
ex:P10428 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRProgramSpecification
                          ] ;
          ex:apqcSourceText "Creating HR programs and services such as employee engagements programs to promote positive employee behavior. Create a variety of programs and services to support employees' professional and personal needs at work and at home." ;
          ex:hierarchyID "7.1.2.10" ;
          ex:pcfID "10428" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive program specification (Directive ICE)." ;
          rdfs:label "Develop other HR programs" ;
          skos:definition "An Act of Formulation that produces an HR program specification for additional HR programs and services supporting employees' professional and personal needs." ;
          skos:example "HR launches an employee-engagement and wellbeing program." .


###  http://example.org/apqc#P10429
ex:P10429 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRPolicy
                          ] ;
          ex:apqcSourceText "Creating rules and regulations that govern the HR function. Develop a policy plan that serves as a guideline for setting rules and regulations that help in achieving the HR goals and objectives." ;
          ex:hierarchyID "7.1.2.11" ;
          ex:pcfID "10429" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive HR policy (Directive ICE)." ;
          rdfs:label "Develop HR policies" ;
          skos:definition "An Act of Formulation that produces an HR policy comprising the rules and regulations that govern the human resources function." ;
          skos:example "HR drafts the leave, conduct, and remote-work policies." .


###  http://example.org/apqc#P10430
ex:P10430 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:HRPolicy
                          ] ;
          ex:apqcSourceText "Ensuring rules and regulations are followed and are flexible enough to accommodate indispensable deviations." ;
          ex:hierarchyID "7.1.2.12" ;
          ex:pcfID "10430" ;
          rdfs:comment "Genus is Act of Administration: the act enacts and enforces a held directive (the HR policy) rather than producing a new directive. R5: treated as a repeatable bounded administration act, not a standing capacity." ;
          rdfs:label "Administer HR policies" ;
          skos:definition "An Act of Administration that has as input an HR policy and enforces its rules and regulations while accommodating necessary deviations." ;
          skos:example "HR reviews a policy-exception request and grants a documented deviation." .


###  http://example.org/apqc#P10431
ex:P10431 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BenefitsAndRewardsPlan
                          ] ;
          ex:apqcSourceText "Planning benefits in kind (also called fringe benefits, perquisites, or perks). Include various types of non-wage compensations provided to employees in addition to normal wages or salaries." ;
          ex:hierarchyID "7.1.2.13" ;
          ex:pcfID "10431" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive benefits and rewards plan (Directive ICE)." ;
          rdfs:label "Plan employee benefits" ;
          skos:definition "An Act of Formulation that produces a benefits and rewards plan specifying the non-wage benefits provided to employees in addition to wages or salaries." ;
          skos:example "Total-rewards plans the fringe-benefit package for the coming year." .


###  http://example.org/apqc#P10432
ex:P10432 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRTechnologyStrategy
                          ] ;
          ex:apqcSourceText "Creating a strategy for the use of systems/technologies/tools in operating the HR function. Create a strategy concerning the use and utility of HR support tools and technologies. Decide what specific tools to use and in what quantity. Determine the levels of technology required for the HR management." ;
          ex:hierarchyID "7.1.1.8" ;
          ex:pcfID "10432" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive technology strategy (Directive ICE)." ;
          rdfs:label "Develop strategy for HR systems/technologies/tools" ;
          skos:definition "An Act of Formulation that produces an HR technology strategy prescribing the systems, technologies, and tools to be used in operating the human resources function." ;
          skos:example "HR formulates a roadmap selecting its HRIS, payroll, and talent tooling." .


###  http://example.org/apqc#P10433
ex:P10433 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceStrategyModel
                          ] ;
          ex:apqcSourceText "Creating and implementing models for effectively strategizing the work force of the organization. Develop a model that specifies the organization's overall approach for maximizing the performance of its work force by defining the goals, objectives, and expectations of the work force. Manage all aspects of performance required for the work force to function, including recruitment, selection, retention, and professional development." ;
          ex:hierarchyID "7.1.2.14" ;
          ex:pcfID "10433" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive workforce strategy model (Directive ICE). Implementation is the sibling process 7.1.2.15." ;
          rdfs:label "Develop workforce strategy models" ;
          skos:definition "An Act of Formulation that produces a workforce strategy model specifying the organization's overall approach for maximizing workforce performance." ;
          skos:example "HR builds a workforce strategy model covering recruitment, retention, and development." .


###  http://example.org/apqc#P10434
ex:P10434 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ObjectiveRealizationReport
                          ] ;
          ex:apqcSourceText "Determining the accomplishment of HR goals and objectives. Evaluate the effectiveness of the HR function by estimating the present rate of achievement of the established objectives. Use metrics to determine if the objectives are being realized. Leverage measures such as turnover, training, return on human capital, costs of labor, and expenses per employee." ;
          ex:hierarchyID "7.1.3.1" ;
          ex:pcfID "10434" ;
          rdfs:comment "Genus is Act of Appraisal (cco:ont00000636): the act evaluates/judges attainment; its output is a descriptive report (GOLDEN PRINCIPLE)." ;
          rdfs:label "Measure realization of objectives" ;
          skos:definition "An Act of Appraisal that has as input performance data and produces an objective realization report estimating the achievement rate of established HR objectives." ;
          skos:example "HR computes turnover and ROI metrics to gauge objective attainment." .


###  http://example.org/apqc#P10435
ex:P10435 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRReport
                          ] ;
          ex:apqcSourceText "Determining the role of HR function in implementing the organizational strategy. Measure the correlation between the HR performance and the overall business strategy. Calculate the amount of contribution of the HR function to the overall business growth." ;
          ex:hierarchyID "7.1.3.2" ;
          ex:pcfID "10435" ;
          rdfs:comment "Genus is Act of Appraisal: the act judges HR's strategic contribution; output is a descriptive report (GOLDEN PRINCIPLE)." ;
          rdfs:label "Measure contribution to business strategy" ;
          skos:definition "An Act of Appraisal that has as input performance data and produces an HR report assessing the human resources function's contribution to the overall business strategy." ;
          skos:example "HR quantifies its correlation with business growth in a contribution report." .


###  http://example.org/apqc#P10436
ex:P10436 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeCommunicationPlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:HumanResourcesStrategy
                          ] ;
          ex:apqcSourceText "Conveying the plans for HR function to stakeholders. Ensure that the HR plans and strategy are effectively communicated to the people who can affect or be affected by the organization's actions, objectives, and policies such as the creditors, shareholders, employees, and suppliers. Provide regular updates to these stakeholders to ensure effective communication." ;
          ex:hierarchyID "7.1.3.3" ;
          ex:pcfID "10436" ;
          ex:requiresRole ex:StakeholderRole ;
          rdfs:comment "Re-anchored from ex:ActOfAdministration to cco:ont00000402 (Act of Communication, verified). Same defect as P10422: Administration was a false-friend genus and inconsistent with the module's other communication anchors. Per the GOLDEN PRINCIPLE conveying plans disseminates held directives rather than producing a communication plan, so ex:EmployeeCommunicationPlan is changed from has-output to a governing has-input (mirroring P10532) and ex:HumanResourcesStrategy is the disseminated has-input; ex:Stakeholder remains the definitional recipient participant." ;
          rdfs:label "Communicate plans and provide updates to stakeholders" ;
          skos:definition "An Act of Communication that disseminates a held human resources strategy and regular updates to stakeholders in accordance with an employee communication plan." ;
          skos:example "HR issues quarterly HR-strategy updates to creditors, shareholders, employees, and suppliers per the communication plan." .


###  http://example.org/apqc#P10438
ex:P10438 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeFeedback
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:HRPolicyData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRPolicy
                          ] ;
          ex:apqcSourceText "Reassessing the strategies, plans, and policies of the HR function, with the objective of revising them. Revisit the schematic plans for the HR function. Taking stock of any suggestions or feedback from the stakeholders, revamp the blueprint of HR strategies and plans." ;
          ex:hierarchyID "7.1.3.4" ;
          ex:pcfID "10438" ;
          rdfs:comment "Genus is Act of Formulation: although it begins by reassessing, the definitional output is the revised prescriptive plan/policy (Directive ICE), per GOLDEN PRINCIPLE." ;
          rdfs:label "Review and revise HR plans" ;
          skos:definition "An Act of Formulation that has as input HR policy data and employee feedback and produces a revised HR policy reflecting reassessed HR strategies and plans." ;
          skos:example "HR revamps its plans incorporating stakeholder feedback from the review." .


###  http://example.org/apqc#P10439
ex:P10439 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10445
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10446
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10447
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10448
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10450
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10451
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10452
                          ] ;
          ex:apqcSourceText "Handling the requirements for new employees. Create and open job requisitions by clearly defining the job descriptions. Post these requirements internally and externally, and modify them as appropriate. Manage the dates of the whole requisition process." ;
          ex:hierarchyID "7.2.1" ;
          ex:pcfID "10439" ;
          rdfs:comment "Modeled as a bounded administration process (not a standing function): each requisition cycle has an identifiable beginning and end." ;
          rdfs:label "Manage employee requisitions" ;
          skos:definition "An Act of Administration that creates, opens, posts, modifies, and schedules job requisitions in order to handle an organization's requirements for new employees." ;
          skos:example "An HR team opens, posts, and tracks a batch of requisitions for a hiring round." .


###  http://example.org/apqc#P10440
ex:P10440 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10453
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10454
                          ] ;
          ex:apqcSourceText "Recruiting new candidates for deployment across various functional areas inside the organization. Select methods for sourcing new employees. Manage relationships with third-party agencies. Stage recruitment fairs and drives. Manage employee referral programs." ;
          ex:hierarchyID "7.2.2" ;
          ex:pcfID "10440" ;
          ex:requiresCapability ex:EmployeeReferralProgramCapability ,
                                ex:RecruitmentChannelManagementCapability ,
                                ex:RecruitmentVendorManagementCapability ;
          rdfs:comment "Process parts are the two bounded sub-acts (determine methods, perform events). The 'manage relationships/programs/channels' children are standing functions modeled as Organization Capabilities (ex:RecruitmentVendorManagementCapability, ex:EmployeeReferralProgramCapability, ex:RecruitmentChannelManagementCapability), realized in this process's acts, not asserted as process parts." ;
          rdfs:label "Recruit/Source candidates" ;
          skos:definition "An Act of Administration that determines recruitment methods and conducts recruiting activities to source candidates for an organization's open positions." ;
          skos:example "A talent team selects sourcing channels and runs a campus recruiting drive." .


###  http://example.org/apqc#P10443
ex:P10443 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10463
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10464
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10465
                          ] ;
          ex:apqcSourceText "Creating and making job offers to the selected candidates. Fairly negotiate the job offers. Agree on terms with the candidate to complete the hiring process." ;
          ex:hierarchyID "7.2.4" ;
          ex:pcfID "10443" ;
          rdfs:comment "Composite process; parts are draw-up/make offer, negotiate offer, and hire candidate." ;
          rdfs:label "Manage new hire/re-hire" ;
          skos:definition "An Act of Administration that draws up and extends a job offer, negotiates it with the selected candidate, and completes the hire." ;
          skos:example "HR makes, negotiates, and finalizes an offer with the chosen candidate." .


###  http://example.org/apqc#P10444
ex:P10444 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10460
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10466
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10468
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20124
                          ] ;
          ex:apqcSourceText "Creating and maintaining a system for managing the information of applicants. Create records for all candidates who apply. Maintain and track information through the use applicant-tracking systems." ;
          ex:hierarchyID "7.2.5" ;
          ex:pcfID "10444" ;
          rdfs:comment "Composite process; parts are obtain-background, create-record, the bounded position-classification act, and archive-non-hires. Modeled as a bounded administration process rather than a standing function because each act operates on a determinate applicant pool. NOTE: the open-ended applicant-data-tracking standing function (PCF 10467) is modeled as ex:ApplicantDataManagementCapability (R5/R6), not a process part; its bounded child P20124 is linked here directly so the partonomy still reaches the position-classification act." ;
          rdfs:label "Manage applicant information" ;
          skos:definition "An Act of Administration that obtains, creates, tracks, and archives applicant records across the recruitment cycle." ;
          skos:example "HR records, tracks, and archives all applicants for a hiring round." .


###  http://example.org/apqc#P10445
ex:P10445 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforcePlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StaffingPlan
                          ] ;
          ex:apqcSourceText "Creating a correspondence between the plan for hiring new employees and the desired employee requirements. Staff an adequate amount of people with the appropriate skills to effectively accomplish its legislative, regulatory, service, and production requirements." ;
          ex:hierarchyID "7.2.1.1" ;
          ex:pcfID "10445" ;
          rdfs:comment "Anchored under ex:ActOfFormulation (Act of Planning) because aligning produces a directive staffing plan; output and genus agree (GOLDEN PRINCIPLE)." ;
          rdfs:label "Align staffing plan to work force plan and business unit strategies/resource needs" ;
          skos:definition "An Act of Formulation that takes a workforce plan as input and produces a staffing plan brought into correspondence with the organization's workforce requirements." ;
          skos:example "An HR planner reconciles the hiring plan with the approved workforce plan." .


###  http://example.org/apqc#P10446
ex:P10446 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:JobRequisition
                          ] ;
          ex:apqcSourceText "Developing specific job requisitions, and ensuring their accessibility. Create and open a job requisition to fill the vacant positions within the organization. Clearly describe the job title, department, fill date, and the requisite skills and qualifications for the job." ;
          ex:hierarchyID "7.2.1.3" ;
          ex:pcfID "10446" ;
          rdfs:comment "Anchored under ex:ActOfFormulation (Act of Planning): a job requisition is a Directive ICE authorizing a hire; output and genus agree." ;
          rdfs:label "Open job requisitions" ;
          skos:definition "An Act of Formulation that creates and opens a job requisition prescribing the title, department, fill date, and required qualifications for a vacant position." ;
          skos:example "A hiring manager opens a requisition to fill a vacated engineering seat." .


###  http://example.org/apqc#P10447
ex:P10447 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:JobDescription
                          ] ;
          ex:apqcSourceText "Creating descriptions for job requisitions. Define the normal components of a job description, such as the overall position description with general areas of responsibility listed, essential functions of the job described with a couple of examples of each, required knowledge, skills, abilities, required education and experience, a description of the physical demands, and a description of the work environment." ;
          ex:hierarchyID "7.2.1.2" ;
          ex:pcfID "10447" ;
          rdfs:comment "Anchored under cco:ont00000366 (Act of Information Processing), not Act of Planning, because a job description is a Descriptive ICE (it describes a position); genus agrees with descriptive output (GOLDEN PRINCIPLE)." ;
          rdfs:label "Develop and maintain job descriptions" ;
          skos:definition "An Act of Information Processing that composes and maintains a job description detailing a position's responsibilities, required competencies, and work environment." ;
          skos:example "A recruiter drafts the job description for an open analyst role." .


###  http://example.org/apqc#P10448
ex:P10448 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:JobRequisition
                          ] ;
          ex:apqcSourceText "Posting and advertising job descriptions. Display open job descriptions internally and externally. Use public portals, online portals, and websites to upload these requisitions in order for applications to be received." ;
          ex:hierarchyID "7.2.1.4" ;
          ex:pcfID "10448" ;
          rdfs:comment "Anchored under cco:ont00000402 (Act of Communication): the act transfers an existing requisition ICE to prospective applicants rather than producing a new artifact." ;
          rdfs:label "Post job requisitions" ;
          skos:definition "An Act of Communication that disseminates open job requisitions internally and externally through portals and websites so that applications can be received." ;
          skos:example "Recruiting posts a requisition to the careers site and a job board." .


###  http://example.org/apqc#P10450
ex:P10450 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:JobRequisition
                          ] ;
          ex:apqcSourceText "Making the necessary alterations to job requisitions. Revamp or revise the job requisitions in case a position is filled or is not vacant anymore, as well as in case of any new openings. (It involves Manage the internal/external job posting websites [10449] to make the necessary changes.)" ;
          ex:hierarchyID "7.2.1.5" ;
          ex:pcfID "10450" ;
          rdfs:comment "Administration (not formulation) because it amends an existing directive artifact rather than composing a new one. Output is the revised ex:JobRequisition (non-definitional revision, recorded here)." ;
          rdfs:label "Modify job requisitions" ;
          skos:definition "An Act of Administration that revises existing job requisitions to reflect filled positions, closed vacancies, or new openings." ;
          skos:example "A recruiter updates a requisition's status after the role is filled." .


###  http://example.org/apqc#P10451
ex:P10451 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:HiringManager
                          ] ;
          ex:apqcSourceText "Informing and communicating with the hiring manager. Notify the manager responsible for the hiring process in cases of any new position openings or changes." ;
          ex:hierarchyID "7.2.1.6" ;
          ex:pcfID "10451" ;
          ex:requiresRole ex:HiringManagerRole ;
          rdfs:comment "Anchored under cco:ont00000402 (Act of Communication); has the hiring manager as participant." ;
          rdfs:label "Notify hiring manager" ;
          skos:definition "An Act of Communication that informs the hiring manager of new position openings or changes to a requisition." ;
          skos:example "HR emails the hiring manager that a new requisition has opened for their team." .


###  http://example.org/apqc#P10452
ex:P10452 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ;
          ex:apqcSourceText "Determining and managing the dates for the employee requisition process." ;
          ex:hierarchyID "7.2.1.7" ;
          ex:pcfID "10452" ;
          rdfs:comment "Bounded administrative act applied per requisition (open/post/fill dates); no definitional informational output." ;
          rdfs:label "Manage requisition dates" ;
          skos:definition "An Act of Administration that determines and manages the schedule of dates governing an employee requisition process." ;
          skos:example "A coordinator sets and tracks the posting and target-fill dates for a requisition." .


###  http://example.org/apqc#P10453
ex:P10453 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RecruitmentMethodSpecification
                          ] ;
          ex:apqcSourceText "Defining the methods and channels for recruitments in order to maximize the amount of candidate availability. Use channels such as headhunting, job postings, job portals, networking websites, and media advertising. Choose from the various methods of recruitment such as internal/external third-party sourcing." ;
          ex:hierarchyID "7.2.2.1" ;
          ex:pcfID "10453" ;
          rdfs:comment "Anchored under ex:ActOfSelection: the act chooses from candidate methods/channels and yields a Directive ICE (the chosen-method specification); genus agrees with directive output." ;
          rdfs:label "Determine recruitment methods and channels" ;
          skos:definition "An Act of Selection that chooses recruitment methods and channels from available options and produces a recruitment-method specification." ;
          skos:example "A recruiter selects job-board and referral channels for a hard-to-fill role." .


###  http://example.org/apqc#P10454
ex:P10454 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ;
          ex:apqcSourceText "Organizing and executing recruiting activities and events. Activities and events include on-campus hiring, refresher courses, information sessions, career fairs, etc. to increase the coverage of the sourcing in order to ensure that the most deserving and appropriate candidates are hired." ;
          ex:hierarchyID "7.2.2.2" ;
          ex:pcfID "10454" ;
          rdfs:comment "No definitional informational output; the act is the organized conduct of events. Realizes the recruitment vendor/referral/channel-management capabilities." ;
          rdfs:label "Perform recruiting activities/events" ;
          skos:definition "An Act of Administration that organizes and executes recruiting activities and events, such as campus hiring and career fairs, to broaden candidate sourcing." ;
          skos:example "A team stages a campus career fair to source graduate candidates." .


###  http://example.org/apqc#P10456
ex:P10456 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ;
          ex:apqcSourceText "Identifying and implementing tools for the selection of candidates. Recognize candidate selection tools such as screening, telephone interviews, hiring manager interviews, drug testing, and skills assessment. Effectively deploy these tools to check if the candidates fit in the workplace or not, as well as to ensure workplace safety." ;
          ex:hierarchyID "7.2.3.1" ;
          ex:pcfID "10456" ;
          rdfs:comment "Administration (set-up of the selection toolset) rather than a single info-processing output; no definitional informational output." ;
          rdfs:label "Identify and deploy candidate selection tools" ;
          skos:definition "An Act of Administration that identifies and puts into use the tools by which candidates are screened and selected." ;
          skos:example "Recruiting configures phone-screen, skills-test, and drug-test steps for a role." .


###  http://example.org/apqc#P10457
ex:P10457 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:JobCandidate
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CandidateAssessment
                          ] ;
          ex:apqcSourceText "Assessing the candidates by their performance in the interviews. Conduct HR interview, technical interview, hiring manager interview, etc. Understand the mindset of the candidate, and comprehend his/her personal and professional lives." ;
          ex:hierarchyID "7.2.3.2" ;
          ex:pcfID "10457" ;
          ex:requiresRole ex:JobCandidateRole ;
          rdfs:comment "Anchored under cco:ont00000636 (Act of Appraisal): it judges the candidate and yields a Descriptive ICE; genus agrees with descriptive output (GOLDEN PRINCIPLE). The candidate is a participant." ;
          rdfs:label "Interview candidates" ;
          skos:definition "An Act of Appraisal that assesses a candidate's performance in interviews and produces a candidate assessment." ;
          skos:example "A panel conducts technical and HR interviews and records its assessment." .


###  http://example.org/apqc#P10458
ex:P10458 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:JobCandidate
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CandidateAssessment
                          ] ;
          ex:apqcSourceText "Examining the candidates through tests. Prepare tools such as aptitude, technical, and grammar tests. Test the skills of the candidate through a written, oral, or computerized test." ;
          ex:hierarchyID "7.2.3.3" ;
          ex:pcfID "10458" ;
          ex:requiresRole ex:JobCandidateRole ;
          rdfs:comment "Anchored under cco:ont00000636 (Act of Appraisal); descriptive output and genus agree. The candidate is a participant." ;
          rdfs:label "Test candidates" ;
          skos:definition "An Act of Appraisal that examines a candidate's skills through tests and produces a candidate assessment." ;
          skos:example "A candidate sits an aptitude and technical test; results feed the assessment." .


###  http://example.org/apqc#P10459
ex:P10459 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CandidateAssessment
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CandidateSelectionDecision
                          ] ;
          ex:apqcSourceText "Approving the deserving candidates, and rejecting the others. Examining the performance of candidates. Ensure candidates would fit well with the organization. (Assess performance from Interview candidates [10457] and Test candidates [10458].)" ;
          ex:hierarchyID "7.2.3.4" ;
          ex:pcfID "10459" ;
          rdfs:comment "Anchored under ex:ActOfSelection: chooses from a candidate set and yields a Directive ICE (the decision); genus agrees with directive output. Inputs are the interview/test assessments (cross-reference 10457/10458)." ;
          rdfs:label "Select and reject candidates" ;
          skos:definition "An Act of Selection that chooses which candidates to approve and which to reject, taking candidate assessments as input and producing a candidate selection decision." ;
          skos:example "A hiring committee approves one candidate and rejects the rest." .


###  http://example.org/apqc#P10460
ex:P10460 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:JobCandidate
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CandidateBackgroundInformation
                          ] ;
          ex:apqcSourceText "Conducting a background investigation on the candidates with the objective of looking up and compiling criminal, commercial, and financial records." ;
          ex:hierarchyID "7.2.5.1" ;
          ex:pcfID "10460" ;
          ex:requiresRole ex:JobCandidateRole ;
          rdfs:comment "Anchored under cco:ont00000366 (Act of Information Processing): it gathers and compiles records into a Descriptive ICE; genus agrees with descriptive output. The candidate is a participant." ;
          rdfs:label "Obtain candidate background information" ;
          skos:definition "An Act of Information Processing that conducts a background investigation on a candidate and compiles candidate background information." ;
          skos:example "A vendor compiles a candidate's criminal and financial background check." .


###  http://example.org/apqc#P10463
ex:P10463 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:JobOffer
                          ] ;
          ex:apqcSourceText "Compiling job-related information for the selected candidates in order to make up a job. Include information about the job description, reporting relationship, salary, bonus potential, benefits, and vacation allotment." ;
          ex:hierarchyID "7.2.4.1" ;
          ex:pcfID "10463" ;
          rdfs:comment "Anchored under ex:ActOfFormulation (Act of Planning): a job offer is a Directive ICE prescribing terms of employment; output and genus agree." ;
          rdfs:label "Draw up and make offer" ;
          skos:definition "An Act of Formulation that compiles job, compensation, and benefits terms into a job offer extended to a selected candidate." ;
          skos:example "A recruiter assembles salary, bonus, and benefits into a written offer." .


###  http://example.org/apqc#P10464
ex:P10464 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfNegotiation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:JobCandidate
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:JobOffer
                          ] ;
          ex:apqcSourceText "Negotiating an offer with selected candidates. Discuss the job offer with the candidate to ensure a mutual understanding." ;
          ex:hierarchyID "7.2.4.2" ;
          ex:pcfID "10464" ;
          ex:requiresRole ex:JobCandidateRole ;
          rdfs:comment "Re-anchored (Gate-F) from ex:ActOfAdministration to ex:ActOfNegotiation: the source denotes bilateral bargaining over offer terms ('Negotiating an offer... Discuss the job offer with the candidate to ensure mutual understanding'), not mere execution of an established administrative arrangement; the slice already uses ex:ActOfNegotiation for P10484. The job offer is the input and the selected candidate participates; a revised offer remains typical (non-definitional) unless every instance produces one." ;
          rdfs:label "Negotiate offer" ;
          skos:definition "An Act of Negotiation that has as input a job offer and involves a selected candidate in order to reach mutual agreement on the offer's terms." ;
          skos:example "HR and the candidate negotiate the start date and signing bonus." .


###  http://example.org/apqc#P10465
ex:P10465 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:JobCandidate
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:JobOffer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeRecord
                          ] ;
          ex:apqcSourceText "Wrapping up the process for hiring candidates. Agree to all hiring terms and conditions. Have the candidate accept and sign the job offer." ;
          ex:hierarchyID "7.2.4.3" ;
          ex:pcfID "10465" ;
          ex:requiresRole ex:JobCandidateRole ;
          rdfs:comment "Anchored under ex:ActOfAcquisition (Planned Act): hiring obtains an employee not previously held. Takes the accepted job offer as input and produces an employee record. The candidate is a participant." ;
          rdfs:label "Hire candidate" ;
          skos:definition "An Act of Acquisition in which a candidate accepts and signs the job offer and the organization thereby obtains a new employee it did not previously hold." ;
          skos:example "The candidate signs the offer and is onboarded as a new employee." .


###  http://example.org/apqc#P10466
ex:P10466 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ApplicantRecord
                          ] ;
          ex:apqcSourceText "Creating and documenting the records of all applicants. Manage all individual applicants, including hires and non-hires. Maintain records to avoid any duplication and promote efficiency." ;
          ex:hierarchyID "7.2.5.2" ;
          ex:pcfID "10466" ;
          rdfs:comment "Anchored under cco:ont00000366 (Act of Information Processing); produces a Descriptive ICE (the applicant record); genus agrees with descriptive output." ;
          rdfs:label "Create applicant record" ;
          skos:definition "An Act of Information Processing that creates and documents an applicant record for each candidate who applies." ;
          skos:example "An ATS creates a record for each new applicant." .


###  http://example.org/apqc#P10468
ex:P10468 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ApplicantRecord
                          ] ;
          ex:apqcSourceText "Retaining and storing the records of the candidates who were rejected and not hired to ensure future availability in case the need arises. Create a centralized repository of profiles. Label these records in order to readily identify them. Add remarks for any future consideration." ;
          ex:hierarchyID "7.2.5.4" ;
          ex:pcfID "10468" ;
          rdfs:comment "Anchored under cco:ont00000366 (Act of Information Processing), whose definition includes the storing of ICEs. Takes applicant records as input." ;
          rdfs:label "Archive and retain records of non-hires" ;
          skos:definition "An Act of Information Processing that retains and stores the records of non-hired candidates in a centralized, labeled repository for future reference." ;
          skos:example "Rejected candidates' profiles are labeled and archived for future openings." .


###  http://example.org/apqc#P10474
ex:P10474 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10477
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10478
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OnboardingProgramSpecification
                          ] ;
          ex:apqcSourceText "Creating and maintaining a mechanism through which new employees acquire the necessary knowledge, skills, and behaviors to become effective organizational members and insiders. Conduct formal meetings, lectures, videos, printed materials, and/or computer-based orientations to introduce newcomers to their new jobs and the organization." ;
          ex:hierarchyID "7.3.1.1" ;
          ex:pcfID "10474" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeeOrientationAndDeploymentCapability ;
          rdfs:comment "Formulation (directive output) per GOLDEN PRINCIPLE: its definitional output OnboardingProgramSpecification is a Directive ICE. Decomposes into develop and maintain/update tasks." ;
          rdfs:label "Create/maintain employee onboarding program" ;
          skos:definition "An Act of Formulation that composes and maintains an onboarding program specification through which new employees acquire the knowledge, skills, and behaviors to become effective organizational members." ;
          skos:example "HR drafts and keeps current the new-hire induction program." .


###  http://example.org/apqc#P10477
ex:P10477 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:OnboardingProgramSpecification
                          ] ;
          ex:apqcSourceText "Designing a program to systematically introduce newly hired employees to the organizational culture of the company." ;
          ex:hierarchyID "7.3.1.1.1" ;
          ex:pcfID "10477" ;
          rdfs:comment "Formulation (directive output): an OnboardingProgramSpecification is a Directive ICE." ;
          rdfs:label "Develop employee induction program" ;
          skos:definition "An Act of Formulation that designs an onboarding program specification systematically introducing newly hired employees to the organizational culture." ;
          skos:example "An HR designer builds the slide deck, schedule, and materials for a new induction program." .


###  http://example.org/apqc#P10478
ex:P10478 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ;
          ex:apqcSourceText "Managing the orientation and training of new employees about the organizational culture of the company." ;
          ex:hierarchyID "7.3.1.1.2" ;
          ex:pcfID "10478" ;
          rdfs:comment "Administration (not Formulation): it maintains/updates an already-established program rather than composing a new directive from scratch. The program specification is the entity acted upon (rdfs:comment, not a definitional output)." ;
          rdfs:label "Maintain/Update employee induction program" ;
          skos:definition "An Act of Administration that keeps current and revises an existing onboarding program specification for orienting new employees to the organizational culture." ;
          skos:example "HR refreshes the induction deck each year to reflect updated policies." .


###  http://example.org/apqc#P10479
ex:P10479 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceObjective
                          ] ;
          ex:apqcSourceText "Outlining the objectives for employee performance. Establish key performance objectives and measures such as customer-focus objectives, financially focused objectives, and employee growth objectives." ;
          ex:hierarchyID "7.3.2.1" ;
          ex:pcfID "10479" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeePerformanceManagementCapability ;
          rdfs:comment "Formulation (directive output): a PerformanceObjective is a Directive ICE that prescribes a target." ;
          rdfs:label "Define employee performance objectives" ;
          skos:definition "An Act of Formulation that composes and articulates performance objectives and measures for an employee." ;
          skos:example "A manager sets quarterly objectives covering customer, financial, and growth goals for a direct report." .


###  http://example.org/apqc#P10481
ex:P10481 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceProgramEvaluation
                          ] ;
          ex:apqcSourceText "Assessing and revamping performance programs, including the instruments used to measure employee performance standards. Review and upgrade these performance programs to avoid any deprivations and ensure effectiveness." ;
          ex:hierarchyID "7.3.2.4" ;
          ex:pcfID "10481" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeePerformanceManagementCapability ;
          rdfs:comment "Appraisal (the assessing/reviewing facet drives the genus); the subsequent revamping is downstream. Descriptive output per GOLDEN PRINCIPLE." ;
          rdfs:label "Evaluate and review performance program" ;
          skos:definition "An Act of Appraisal that judges the effectiveness of an employee-performance-management program and its measurement instruments and has as output a performance program evaluation." ;
          skos:example "HR reviews the appraisal rubric and recommends upgrades to the rating scale." .


###  http://example.org/apqc#P10484
ex:P10484 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfNegotiation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ManagementPersonnel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CollectiveBargainingAgreement
                          ] ;
          ex:apqcSourceText "Managing any negotiations between an employer and a group of employees that determine the conditions of employment. Engage employees to reach agreements in regulating working conditions." ;
          ex:hierarchyID "7.4.2" ;
          ex:pcfID "10484" ;
          ex:requiresCapability ex:EmployeeRelationsCapability ,
                                ex:LaborRelationsCapability ;
          ex:requiresRole ex:EmployeeRole ,
                          ex:ManagerRole ;
          rdfs:comment "Re-anchored from ex:ActOfAdministration to ex:ActOfNegotiation. Administration was a false-friend genus driven by the label word 'Manage': its differentia is carrying out an ALREADY-ESTABLISHED arrangement 'without itself creating that arrangement', whereas collective bargaining CREATES a novel Directive ICE (the CBA) -- the source says 'reach agreements in regulating working conditions'. Producing a binding directive agreement is agreement-formation/negotiation, not administration; the new shared genus ex:ActOfNegotiation (PROPOSE-EXT, anchored under cco:ont00000228 Planned Act, differentia 'two or more parties jointly producing a binding directive agreement') is reusable for parallel bargaining/agreement nodes corpus-wide. Output ex:CollectiveBargainingAgreement is a Directive ICE (definitional, promoted) and the Employee/ManagementPersonnel participant restrictions remain correct under the new genus; genus now agrees with the directive output (GOLDEN PRINCIPLE)." ;
          rdfs:label "Manage collective bargaining process" ;
          skos:definition "An Act of Negotiation in which an employer and a group of employees confer and bargain over the conditions of employment and jointly produce a collective bargaining agreement that regulates working conditions." ;
          skos:example "An HR team and a labor union negotiate a new two-year contract setting wages and shift rules." .


###  http://example.org/apqc#P10487
ex:P10487 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DevelopmentGuideline
                          ] ;
          ex:apqcSourceText "Outlining the guidelines for development of employees. Design development policies and procedures to identify areas of growth for employees, either in their current position or in preparation for future roles. Include topics related to knowledge and skill development." ;
          ex:hierarchyID "7.3.3.1" ;
          ex:pcfID "10487" ;
          ex:requiresCapability ex:EmployeeCareerDevelopmentCapability ,
                                ex:EmployeeDevelopmentCapability ;
          rdfs:comment "Formulation (directive output): an employee DevelopmentGuideline is a Directive ICE." ;
          rdfs:label "Define employee development guidelines" ;
          skos:definition "An Act of Formulation that composes employee development guidelines prescribing policies and procedures for identifying employee growth areas." ;
          skos:example "HR drafts the development-planning policy that managers use to plan staff growth." .


###  http://example.org/apqc#P10488
ex:P10488 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CareerPlan
                          ] ;
          ex:apqcSourceText "Designing a future career path for the employees that encourages them to explore and gather information." ;
          ex:hierarchyID "7.3.3.2" ;
          ex:pcfID "10488" ;
          ex:requiresCapability ex:EmployeeCareerDevelopmentCapability ,
                                ex:EmployeeDevelopmentCapability ;
          rdfs:comment "Formulation (directive output): a CareerPlan is a Directive ICE prescribing a path." ;
          rdfs:label "Develop employee career plans and career paths" ;
          skos:definition "An Act of Formulation that designs a career plan laying out a future career path for an employee." ;
          skos:example "A manager and employee jointly map a three-step promotion path." .


###  http://example.org/apqc#P10490
ex:P10490 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceDevelopmentNeedsAlignment
                          ] ;
          ex:apqcSourceText "Aligning the needs of the employees to development needs." ;
          ex:hierarchyID "7.3.4.1" ;
          ex:pcfID "10490" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeeTrainingCapability ;
          rdfs:comment "Analysis (information processing) with a Descriptive output per GOLDEN PRINCIPLE." ;
          rdfs:label "Align employee with organization development needs" ;
          skos:definition "An Act of Analysis that reconciles individual employee development needs with organizational development needs and has as output a workforce development needs alignment." ;
          skos:example "L&D maps each team's skill gaps against the company's strategic capability needs." .


###  http://example.org/apqc#P10491
ex:P10491 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LearningProgramAlignmentSpecification
                          ] ;
          ex:apqcSourceText "Aligning the learning programs with the core capabilities and competencies of the organization. Contextualize the training programs so that employees can expand their knowledge base and add new skills in line with the core competencies of the organization." ;
          ex:hierarchyID "7.3.4.3" ;
          ex:pcfID "10491" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeeTrainingCapability ;
          rdfs:comment "Re-anchored from ex:ActOfAdministration to ex:ActOfFormulation (Act of Planning) for sibling consistency: its parallel 7.3.4 rows that also yield a Directive ICE -- P10487 (Define guidelines) and P16940 (Define competencies) -- are Formulation, and composing the directive ex:LearningProgramAlignmentSpecification reads as authoring a directive, not running a settled arrangement. Genus now agrees with the directive output (GOLDEN PRINCIPLE). Phase-3 fix: the prior [has input some ex:CompetencyManagementModel] existential restriction is demoted to commentary -- the source ('Aligning the learning programs with the core capabilities and competencies') cites competencies as the alignment TARGET, not a necessary input ICE present in every instance; it is a competency-question/annotation target pending domain review." ;
          rdfs:label "Align learning programs with competencies and skills" ;
          skos:definition "An Act of Formulation that composes a learning program alignment specification aligning the organization's learning programs to its core capabilities and competencies." ;
          skos:example "L&D re-maps the training catalog so each course builds a named core competency." .


###  http://example.org/apqc#P10492
ex:P10492 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:SkillRequirementData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SkillsGapAnalysis
                          ] ;
          ex:apqcSourceText "Determining the training necessitated by business processes, using an examination of skill sets that are needed by the organization and those already possessed. Examine the various skills required by individual employees. Design training in light of the availability of resources to provide specific segments of training." ;
          ex:hierarchyID "7.3.4.4" ;
          ex:pcfID "10492" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeeTrainingCapability ;
          rdfs:comment "Analysis (the examination/comparison of skill sets drives the genus); Descriptive output per GOLDEN PRINCIPLE." ;
          rdfs:label "Establish training needs by analysis of required and available skills" ;
          skos:definition "An Act of Analysis that has as input skill requirement data and has as output a skills gap analysis comparing skills required by the organization with those already possessed in order to establish training needs." ;
          skos:example "L&D compares the required and current skills matrices to determine which courses are needed." .


###  http://example.org/apqc#P10493
ex:P10493 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000234 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:TrainingProgramSpecification
                          ] ;
          ex:apqcSourceText "Creating, implementing, and managing the programs for training employees. Create and design sessions on the basis of the needs and the availability of the skills. Conduct the sessions on the ground. Manage all aspects related to the training programs. Consider including literacy training, interpersonal skills training, technical training, problem-solving training, diversity or sensitivity training, etc." ;
          ex:hierarchyID "7.3.4.5" ;
          ex:pcfID "10493" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeeTrainingCapability ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Anchored to CCO cco:ont00000234 (Act of Training). VERIFIED against the pinned CCO v2.0 closure (D6/§6): label 'Act of Training', definition 'A Planned Act in which knowledge, skills or values are imparted from one or more Agents to at least one other Agent', parent cco:ont00000228 (Planned Act) -- confirmed in CommonCoreOntologiesMerged.ttl. (cco:ont00000234 is hereby added to the module's verified-term set; the §6 table in apqc_to_bfo_cco_methodology.md should be updated to list it.) This sense fits the conduct/deliver facet that dominates this node. Compound-row de-conflation: the equally-labelled 'develop' (design a TrainingProgramSpecification = directive output, a Formulation/Planning facet) and 'manage' (Administration) facets are NOT collapsed into this genus -- the design facet's directive output is handled by the separate/downstream formulation node, and this primary PCF class is reduced to the dominant 'conduct/deliver' facet. Its guiding TrainingProgramSpecification is recorded as input; the trained Employee is the definitional participant (trainee), modeled with has participant rather than has input (an Agent is not an informational input)." ;
          rdfs:label "Develop, conduct, and manage employee and/or management training programs" ;
          skos:definition "An Act of Training in which an organization imparts knowledge, skills, or values to its employees and managers by developing, conducting, and managing training programs." ;
          skos:example "Trainers run a technical-skills bootcamp for a cohort of engineers." .


###  http://example.org/apqc#P10495
ex:P10495 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:HumanResourcesProfessional
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10504
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10505
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10506
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10507
                          ] ;
          ex:apqcSourceText "Managing and ensuring benefits enrollment by the employees. Process any benefit claims made by the employees. Balance the estimated amount and entitled amount of benefits." ;
          ex:hierarchyID "7.5.2" ;
          ex:pcfID "10495" ;
          ex:requiresCapability ex:CompensationAndBenefitsCapability ;
          ex:requiresRole ex:HumanResourcesProfessionalRole ;
          rdfs:comment "Models APQC 7.5.2 as a bounded, recurring administrative procedure; its APQC children are process parts, not subclasses." ;
          rdfs:label "Manage and administer benefits" ;
          skos:definition "An Act of Administration that manages employee benefits enrollment, processes benefit claims, and reconciles delivered benefits, comprising its constituent benefit-administration activities." ;
          skos:example "A benefits operations team runs the open-enrollment, claims, and reconciliation cycle for a plan year." .


###  http://example.org/apqc#P10497
ex:P10497 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PayStatement
                          ] ;
          ex:apqcSourceText "Managing the sum of all financial records of salaries for an employee, including wages, bonuses, and deductions. Use a payroll management system to deal with the financial aspects of employees' salaries, allowances, deductions, gross pay, net pay, etc. Generate pay slips for a specific period." ;
          ex:hierarchyID "7.5.4" ;
          ex:pcfID "10497" ;
          ex:requiresCapability ex:CompensationAndBenefitsCapability ;
          rdfs:comment "Has no modeled APQC children. Employee data is a definitional input; the pay statement (pay slip) is the definitional output." ;
          rdfs:label "Administer payroll" ;
          skos:definition "An Act of Administration that has as input employee data and manages the financial records of employee salaries, including wages, bonuses, and deductions, producing pay statements for a given period." ;
          skos:example "Payroll runs the monthly cycle computing gross and net pay and issuing pay slips." .


###  http://example.org/apqc#P10498
ex:P10498 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompensationStructure
                          ] ;
          ex:apqcSourceText "Creating the framework for the provision of salary/compensation to employees. Break down the salary structure into different components such as fixed pay, variable pay, bonus, and allowances such medical allowance, and rent allowance, etc. Develop, adjust, and maintain a pay structure." ;
          ex:hierarchyID "7.5.1.1" ;
          ex:pcfID "10498" ;
          rdfs:comment "Anchored under ex:ActOfFormulation (Act of Planning): it composes a Directive ICE (the pay structure). Market compensation data is a typical, not definitional, input." ;
          rdfs:label "Develop salary/compensation structure and plan" ;
          skos:definition "An Act of Formulation that composes a compensation structure prescribing the components of employee pay such as fixed pay, variable pay, bonus, and allowances." ;
          skos:example "A compensation analyst designs a banded pay structure with fixed, variable, and allowance components." .


###  http://example.org/apqc#P10499
ex:P10499 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BenefitsAndRewardsPlan
                          ] ;
          ex:apqcSourceText "Developing a plan for provision of rewards, commission, and benefits to employees. Plan health benefits, retirement benefits, non-monetary benefits, etc." ;
          ex:hierarchyID "7.5.1.2" ;
          ex:pcfID "10499" ;
          rdfs:comment "Anchored under ex:ActOfFormulation: output is a Directive ICE (the plan)." ;
          rdfs:label "Develop benefits and rewards plan" ;
          skos:definition "An Act of Formulation that composes a benefits and rewards plan prescribing the rewards, commission, and benefits to be provided to employees." ;
          skos:example "A benefits manager drafts the annual plan covering health, retirement, and non-monetary benefits." .


###  http://example.org/apqc#P10500
ex:P10500 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketCompensationData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompensationBenchmark
                          ] ;
          ex:apqcSourceText "Analyzing and evaluating the organization's benefits and rewards plan. Compare/Benchmark the benefits and employees plan with other organizations to adhere to industry standard practices." ;
          ex:hierarchyID "7.5.1.3" ;
          ex:pcfID "10500" ;
          rdfs:comment "GOLDEN PRINCIPLE: analysis/benchmarking produces a Descriptive ICE (the benchmark)." ;
          rdfs:label "Perform competitive analysis of benefits and rewards" ;
          skos:definition "An Act of Analysis that has as input market compensation data and has as output a compensation benchmark juxtaposing the organization's benefits and rewards against industry practice." ;
          skos:example "An analyst benchmarks the firm's benefits against peer employers and reports the gaps." .


###  http://example.org/apqc#P10501
ex:P10501 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:HRPolicyData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CompensationRequirement
                          ] ;
          ex:apqcSourceText "Recognizing the employee requirements for compensation on the basis of the financial, benefits, and HR policies of the organization. Recognize individual compensation requirements regarding the financial policies of the organization. Consider the benefits plan and overall HR policies while selecting compensation requirements." ;
          ex:hierarchyID "7.5.1.4" ;
          ex:pcfID "10501" ;
          rdfs:comment "GOLDEN PRINCIPLE: discernment/identification produces a Descriptive ICE (the requirement representation). Anchored under ex:ActOfIdentification (information processing)." ;
          rdfs:label "Identify compensation requirements based on financial, benefits, and HR policies" ;
          skos:definition "An Act of Identification that has as input HR policy data and has as output a compensation requirement discerned from the organization's financial, benefits, and HR policies." ;
          skos:example "An HR analyst identifies the compensation a role requires given the firm's pay and benefits policy." .


###  http://example.org/apqc#P10502
ex:P10502 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BenefitsAndRewardsPlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PayStatement
                          ] ;
          ex:apqcSourceText "Managing the provision of compensations and rewards to the employees while maintaining consistency with the compensation and benefits plan. Follow the compensation and benefits plan rigorously in order to avoid any discrepancies." ;
          ex:hierarchyID "7.5.1.5" ;
          ex:pcfID "10502" ;
          rdfs:comment "The benefits and rewards plan is a definitional directive input; the compensation structure constrains it but is typical, so recorded here rather than as a restriction." ;
          rdfs:label "Administer compensation and rewards to employees" ;
          skos:definition "An Act of Administration that provisions compensation and rewards to employees in accordance with the compensation and benefits plan and produces a pay statement." ;
          skos:example "Payroll disburses bonuses and allowances to employees per the approved plan and issues statements." .


###  http://example.org/apqc#P10503
ex:P10503 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ;
          ex:apqcSourceText "Rewarding and stimulating the performance efforts of employees. Create methods for motivating employees. Spur extrinsic and intrinsic motivation." ;
          ex:hierarchyID "7.5.1.6" ;
          ex:pcfID "10503" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Typical output: an incentive plan / motivation method (ex:IncentivePlan) and recognition of employees; not definitional for every instance, so recorded as a comment rather than an owl:someValuesFrom restriction. Participant: Employee." ;
          rdfs:label "Reward and motivate employees" ;
          skos:definition "An Act of Administration that rewards employees and applies extrinsic and intrinsic methods to stimulate their performance efforts." ;
          skos:example "A manager grants spot bonuses and public recognition to motivate a high-performing team." .


###  http://example.org/apqc#P10504
ex:P10504 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BenefitsAndRewardsPlan
                          ] ;
          ex:apqcSourceText "Implementing the programs that specify employee benefits, other than salary provided, such as those concerning medical care, death, and disability." ;
          ex:hierarchyID "7.5.2.1" ;
          ex:pcfID "10504" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "The benefits and rewards plan is the definitional directive input being implemented; participants are employees." ;
          rdfs:label "Deliver employee benefits program" ;
          skos:definition "An Act of Administration that implements the employee benefits program specifying non-salary benefits such as medical care, death, and disability coverage." ;
          skos:example "HR operations stands up the year's medical, life, and disability benefit offerings for staff." .


###  http://example.org/apqc#P10505
ex:P10505 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeRecord
                          ] ;
          ex:apqcSourceText "Handling the employee enrollment for obtaining benefits. Manage employee enrollment and eligibility. Encourage employees to enroll for benefits." ;
          ex:hierarchyID "7.5.2.2" ;
          ex:pcfID "10505" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Participant: Employee. Output is the enrollment/eligibility record (ex:EmployeeRecord)." ;
          rdfs:label "Administer benefit enrollment" ;
          skos:definition "An Act of Administration that handles employee enrollment and eligibility for benefits and produces an employee record of enrollment." ;
          skos:example "A benefits administrator enrolls a new hire in the medical plan and records eligibility." .


###  http://example.org/apqc#P10506
ex:P10506 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BenefitClaim
                          ] ;
          ex:apqcSourceText "Processing any formal requests or demands made by the employees claiming that they have earned some benefits. Send the request further up the managerial hierarchy to ensure approval." ;
          ex:hierarchyID "7.5.2.3" ;
          ex:pcfID "10506" ;
          rdfs:comment "Benefit claim is the definitional input. The approval decision and managerial routing are typical, recorded here rather than as restrictions." ;
          rdfs:label "Process claims" ;
          skos:definition "An Act of Administration that has as input an employee benefit claim and processes it, routing it for managerial approval." ;
          skos:example "A claims clerk validates a disability-benefit claim and forwards it to a manager for approval." .


###  http://example.org/apqc#P10507
ex:P10507 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BenefitReconciliationStatement
                          ] ;
          ex:apqcSourceText "Carrying out reconciliation of benefits delivered to employees. Compare the estimated benefit requirement made by the employee and the actual amount of benefits the employee is entitled to receive." ;
          ex:hierarchyID "7.5.2.4" ;
          ex:pcfID "10507" ;
          rdfs:comment "GOLDEN PRINCIPLE: reconciliation analysis produces a Descriptive ICE (the reconciliation statement)." ;
          rdfs:label "Perform benefit reconciliation" ;
          skos:definition "An Act of Analysis that compares the estimated and entitled benefit amounts for employees and has as output a benefit reconciliation statement." ;
          skos:example "A benefits accountant reconciles claimed against entitled benefits and issues a reconciliation statement." .


###  http://example.org/apqc#P10508
ex:P10508 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21440
                          ] ;
          ex:apqcSourceText "Designing programs that prompt proper balance between work (i.e., career and ambition) and lifestyle (i.e., health, pleasure, leisure, family, and spiritual development/meditation). Account for dependent care, flexible working arrangements, leaves of absence, on-the-job training, etc." ;
          ex:hierarchyID "7.5.3.1" ;
          ex:pcfID "10508" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Typical output: a work/life-balance program specification (a Directive ICE); not definitional for every instance, recorded as a comment. Has process part 7.5.3.1.1 Manage flexible working." ;
          rdfs:label "Deliver programs to support work/life balance for employees" ;
          skos:definition "An Act of Administration that designs and delivers programs promoting balance between employees' work and lifestyle, covering arrangements such as dependent care, flexible working, and leaves of absence." ;
          skos:example "An HR team launches a flexible-hours and dependent-care program for staff." .


###  http://example.org/apqc#P10509
ex:P10509 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:LegalAndRegulatoryRequirements
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FamilySupportProgramSpecification
                          ] ;
          ex:apqcSourceText "Creating a support structure that aligns with local and federal laws that allow for support for families. This could include things like maternity leave, care for a family member, or in some cases, extended sick leave." ;
          ex:hierarchyID "7.5.3.2" ;
          ex:pcfID "10509" ;
          rdfs:comment "Anchored under ex:ActOfFormulation (Act of Planning): the output is a Directive ICE (a family-support program specification). Phase-3 fix: the directive output is now promoted to an existential restriction on the newly-minted ex:FamilySupportProgramSpecification rather than left in commentary -- for a Formulation act the directive output IS definitional (it is what makes the act a formulation), matching the other 7.5 formulation acts (P10498->CompensationStructure, P10499->BenefitsAndRewardsPlan, P20958->HumanResourcesStrategy). The earlier 'no shared ICE captures it' rationale did not justify omission, since the module already mints local Directive ICEs for this situation. Legal and regulatory requirements remain a definitional input." ;
          rdfs:label "Develop family support systems" ;
          skos:definition "An Act of Formulation that composes a family support structure, aligned with local and federal law, prescribing provisions such as maternity leave, family-member care, and extended sick leave." ;
          skos:example "HR drafts a family-leave policy compliant with statutory entitlements." .


###  http://example.org/apqc#P10510
ex:P10510 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeMetric
                          ] ;
          ex:apqcSourceText "Reassessing the indicators for retention and motivation of employees. Monitor the indicators that signal the levels of motivation and retention. Regularly update and upgrade indicators to avoid depreciation and ensure high efficiency." ;
          ex:hierarchyID "7.5.1.7" ;
          ex:pcfID "10510" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the act reassesses and judges indicators. GOLDEN PRINCIPLE: appraisal yields a Descriptive judgement; the updated indicator set is a typical output, recorded as a comment." ;
          rdfs:label "Review retention and motivation indicators" ;
          skos:definition "An Act of Appraisal that has as input employee metrics signalling retention and motivation and judges their adequacy and currency." ;
          skos:example "An HR analytics team reviews turnover and engagement indicators and flags ones needing recalibration." .


###  http://example.org/apqc#P10511
ex:P10511 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CompensationStructure
                          ] ;
          ex:apqcSourceText "Analyzing existing compensation plans and making changes necessary to continue to retain employees." ;
          ex:hierarchyID "7.5.1.8" ;
          ex:pcfID "10511" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it evaluates the existing plan. The resulting change recommendations are a typical output, recorded as a comment rather than a restriction." ;
          rdfs:label "Review compensation plan" ;
          skos:definition "An Act of Appraisal that has as input the existing compensation structure and judges what changes are necessary to retain employees." ;
          skos:example "A compensation committee reviews the pay plan against attrition data and recommends adjustments." .


###  http://example.org/apqc#P10512
ex:P10512 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeRecord
                          ] ;
          ex:apqcSourceText "Administering the process of promoting and demoting employees. Design a system for advancing or demoting an employee's rank or position. Leverage techniques such as horizontal promotion, vertical promotion, dry promotion, and involuntary/voluntary demotion." ;
          ex:hierarchyID "7.6.1" ;
          ex:pcfID "10512" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Output is a Descriptive ICE (the updated record) because it registers a status change rather than prescribing future action. The promotion/demotion techniques are method, not tracked process parts." ;
          rdfs:label "Manage promotion and demotion process" ;
          skos:definition "An Act of Administration that has as input employee data and produces an updated employee record registering an advancement or reduction in an employee's rank or position." ;
          skos:example "HR processes a vertical promotion and updates the employee's grade in the personnel record." .


###  http://example.org/apqc#P10513
ex:P10513 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeRecord
                          ] ;
          ex:apqcSourceText "Managing the process of employee separation, including resignations, discharges, and layoffs. Inform the employee of the termination. Complete paperwork for continuation of benefits." ;
          ex:hierarchyID "7.6.2" ;
          ex:pcfID "10513" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Benefits-continuation paperwork is a typical further output, recorded here rather than as an existential restriction. Informing the employee is a method step, not a tracked process part." ;
          rdfs:label "Manage separation" ;
          skos:definition "An Act of Administration that has as input employee data and produces an updated employee record terminating the employment relationship by resignation, discharge, or layoff." ;
          skos:example "HR processes a layoff, notifies the employee, and closes out their employment record." .


###  http://example.org/apqc#P10514
ex:P10514 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeRecord
                          ] ;
          ex:apqcSourceText "Managing and administering instances where a person stops employment completely." ;
          ex:hierarchyID "7.6.3" ;
          ex:pcfID "10514" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Distinct from separation (7.6.2) in that retirement is the employee's permanent exit from the workforce." ;
          rdfs:label "Manage retirement" ;
          skos:definition "An Act of Administration that has as input employee data and produces an updated employee record recording the complete and permanent cessation of a person's employment by retirement." ;
          skos:example "HR processes a worker's retirement and finalizes their pension and personnel record." .


###  http://example.org/apqc#P10515
ex:P10515 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeRecord
                          ] ;
          ex:apqcSourceText "Managing the period of time that an employee must be away from their primary job, while maintaining the status of employee (i.e., paid and unpaid leave of absence but not vacations, holidays, hiatuses, sabbaticals, and work-from-home programs)." ;
          ex:hierarchyID "7.6.4" ;
          ex:pcfID "10515" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Scoped by APQC to paid/unpaid leave, excluding vacations, holidays, hiatuses, sabbaticals, and work-from-home." ;
          rdfs:label "Manage leave of absence" ;
          skos:definition "An Act of Administration that has as input employee data and produces an updated employee record governing a period during which an employee is away from their primary job while retaining employee status." ;
          skos:example "HR records and tracks an employee's approved unpaid medical leave." .


###  http://example.org/apqc#P10516
ex:P10516 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DevelopmentGuideline
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ;
          ex:apqcSourceText "Helping former employees transition to new jobs or to re-orient themselves in the job market. Deliver help through one-on-one sessions or in a group format. Provide guidance in career evaluation, resume writing, interview preparation, developing networks, and job searching." ;
          ex:hierarchyID "7.6.5" ;
          ex:pcfID "10516" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Re-anchored from ex:ActOfAdministration to cco:ont00000366 (Act of Information Processing) per FIX option (a). The source describes DELIVERY of counseling/help ('Helping former employees transition ... Deliver help through one-on-one sessions or in a group format. Provide guidance ...') -- an information-handling service rendered to a person, not the authoring of a prescriptive guideline document. Phase-3 fix: ex:DevelopmentGuideline is demoted from an existential has-output to a has-input (the transition guidance being delivered, not produced) -- a transition-guidance document is content delivered, not an artifact every instance definitionally produces. ex:Employee (the departing/former employee receiving the service) is the definitional participant. One-on-one vs group delivery is method, not a tracked part." ;
          rdfs:label "Develop and implement employee outplacement" ;
          skos:definition "An Act of Information Processing that delivers transition guidance to a departing or former employee -- through one-on-one or group sessions on career evaluation, resume writing, interview preparation, networking, and job searching -- to help them transition to a new job or re-orient in the job market." ;
          skos:example "An outplacement counselor runs resume and interview-prep sessions for laid-off staff." .


###  http://example.org/apqc#P10517
ex:P10517 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StaffingPlan
                          ] ;
          ex:apqcSourceText "Allocating employees. Deploy personnel to ensure that the labor of the organization is continuously in an optimal relation to the jobs and organizational structure." ;
          ex:hierarchyID "7.6.6.2" ;
          ex:pcfID "10517" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Output is the Directive ex:StaffingPlan (the deployment allocation). Has the deployed employee as participant. Act of Motion (cco:ont00000357) was considered but the act administers allocation rather than effecting physical relocation." ;
          rdfs:label "Manage resource deployment" ;
          skos:definition "An Act of Administration that has as input workforce data and produces a staffing plan that allocates and deploys personnel so that the organization's labor stays in optimal relation to its jobs and structure." ;
          skos:example "A workforce manager reassigns staff across teams to balance current demand." .


###  http://example.org/apqc#P10520
ex:P10520 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RelocationPlan
                          ] ;
          ex:apqcSourceText "Managing foreign resources. Manage employees who are sent to live abroad for a defined time period, as well as non-native employees." ;
          ex:hierarchyID "7.6.7.1" ;
          ex:pcfID "10520" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Specialization of relocation (7.6.7) for cross-border assignments. Output is the Directive ex:RelocationPlan covering the foreign-posting terms." ;
          rdfs:label "Manage expatriates" ;
          skos:definition "An Act of Administration that has as input employee data and produces a relocation plan governing the assignment of an employee sent to live abroad for a defined period, as well as non-native employees." ;
          skos:example "HR administers an expatriate package, visa, and term of an employee posted overseas." .


###  http://example.org/apqc#P10522
ex:P10522 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:HumanResourcesProfessional
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRReport
                          ] ;
          ex:apqcSourceText "Providing information and reports regarding employees to management." ;
          ex:hierarchyID "7.7.1" ;
          ex:pcfID "10522" ;
          ex:requiresRole ex:HumanResourcesProfessionalRole ;
          rdfs:comment "Anchored to ex:ActOfAdministration: the source describes a bounded, repeatable act of providing employee reports, not a standing function. Output ex:HRReport is Descriptive (a report represents rather than prescribes), agreeing with its information-handling character (GOLDEN PRINCIPLE)." ;
          rdfs:label "Manage reporting processes" ;
          skos:definition "An Act of Administration that compiles employee information and produces an HR report supplied to management." ;
          skos:example "HR runs the monthly headcount-and-turnover report and delivers it to the leadership team." .


###  http://example.org/apqc#P10523
ex:P10523 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeFeedback
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:GrievanceResolution
                          ] ;
          ex:apqcSourceText "Handling instances where an employee believes that he/she has been inappropriately treated or he/she desires clarification. Encourage employees to inquire when needed. Record and clarify the issues for which the enquiry has been made." ;
          ex:hierarchyID "7.7.2" ;
          ex:pcfID "10523" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Anchored to ex:ActOfAdministration: each inquiry is a bounded, repeatable occurrent (record then clarify). Input ex:EmployeeFeedback (the inquiry as raised). Output ex:GrievanceResolution is Descriptive (it records the resolved issue)." ;
          rdfs:label "Manage employee inquiry process" ;
          skos:definition "An Act of Administration that records and clarifies the issue raised in an employee inquiry and produces a grievance resolution." ;
          skos:example "An HR representative logs an employee's pay-discrepancy inquiry, investigates, and records the clarification provided." .


###  http://example.org/apqc#P10524
ex:P10524 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeRecord
                          ] ;
          ex:apqcSourceText "Capturing and updating employee information and data and information on the employees." ;
          ex:hierarchyID "7.7.3" ;
          ex:pcfID "10524" ;
          rdfs:comment "Anchored to ex:ActOfAdministration: despite 'manage and maintain' in the label, the source describes the concrete, repeatable capture-and-update act. Input ex:EmployeeData; output ex:EmployeeRecord (Descriptive)." ;
          rdfs:label "Manage and maintain employee data" ;
          skos:definition "An Act of Administration that captures and updates employee information and produces an employee record." ;
          skos:example "HR updates an employee's address and dependents in the personnel system after a life-event notification." .


###  http://example.org/apqc#P10526
ex:P10526 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000345 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeMetric
                          ] ;
          ex:apqcSourceText "Creating and maintaining performance metrics for employees. Create and manage a strategic system of data and statistics to accurately gauge each employee's information. Consider productivity metrics, efficiency metrics, training metrics, etc." ;
          ex:hierarchyID "7.7.5" ;
          ex:pcfID "10526" ;
          rdfs:comment "Re-anchored from ex:ActOfAdministration to cco:ont00000345 (Act of Measuring, VERIFIED against CCO v2.0: 'A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard', parent cco:ont00000228). The source ('Creating and maintaining performance metrics ... to accurately gauge each employee's information ... productivity metrics, efficiency metrics, training metrics') is deriving metrics that GAUGE/MEASURE employee performance -- measuring, not execution-of-a-settled-arrangement. REJECTED ex:ActOfAdministration: its differentia explicitly excludes creating the arrangement, whereas this act derives the metrics; the label word 'manage' pulled the prior anchor. The output ex:EmployeeMetric is Descriptive (a measured indicator), which agrees with a measuring/information-processing genus far better than with administration (GOLDEN PRINCIPLE). Input ex:EmployeeData retained." ;
          rdfs:label "Develop and manage employee measures" ;
          skos:definition "An Act of Measuring that derives and maintains performance metrics gauging each employee's productivity, efficiency, and training relative to a standard, and produces an employee metric." ;
          skos:example "An HR analyst computes and updates productivity, efficiency, and training-completion metrics for each employee." .


###  http://example.org/apqc#P10529
ex:P10529 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EmployeeCommunicationPlan
                          ] ;
          ex:apqcSourceText "Creating a plan for managing communication among employees. Inform employees of direction. Counter resistance with change management approaches. Seek specific areas of input to the decision-making process. Seek varying degrees of involvement and co-creation." ;
          ex:hierarchyID "7.8.1" ;
          ex:pcfID "10529" ;
          ex:requiresCapability ex:EmployeeCommunicationCapability ;
          rdfs:comment "Genus ex:ActOfFormulation (Act of Planning): the act articulates a Directive ICE (the plan). Employee feedback and stakeholder requirements may be sought as input for co-creation but are optional, so they are not promoted to existential restrictions (Phase-3)." ;
          rdfs:label "Develop employee communication plan" ;
          skos:definition "An Act of Formulation that composes a plan governing communication and engagement among employees and between employees and management, and has as output an employee communication plan." ;
          skos:example "An HR team drafts the annual internal-communications and engagement plan, incorporating change-management messaging." .


###  http://example.org/apqc#P10530
ex:P10530 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10530_SuggestionProgram
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeFeedback
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:EngagementSurveyResult
                          ] ;
          ex:apqcSourceText "Procuring and handling suggestions from employees, and performing research on employees. Manage and analyze the programs that help the organization to tap into employee ideas for improving the organization's processes and/or products. Use surveys, focus groups, and other data-gathering methods to find out the attitudes, opinions, and feelings of members of an organization." ;
          ex:hierarchyID "7.7.9" ;
          ex:pcfID "10530" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Compound-row de-conflation (§4): the source fuses (a) managing/collecting employee suggestions and running the suggestion PROGRAMS ('Manage and analyze the programs that help the organization to tap into employee ideas') -- administrative/program-management -- and (b) performing employee research via surveys and focus groups -- analysis. The primary PCF class is reduced to the research facet (ex:ActOfAnalysis -> ex:EngagementSurveyResult) and carries the PCF identifiers; the dropped suggestion-program-management facet is modeled in the supporting class ex:P10530_SuggestionProgram (ex:ActOfAdministration, input ex:EmployeeFeedback, output ex:SuggestionRegister) and linked here via has process part so it is not silently lost. Input ex:EmployeeFeedback; output ex:EngagementSurveyResult is Descriptive. Participant ex:Employee is the research subject. NOTE: the EmployeeFeedback-as-input pattern recurs at P16944 (7.8.2)." ;
          rdfs:label "Manage/Collect employee suggestions and perform employee research" ;
          skos:definition "An Act of Analysis that performs employee research through surveys and focus groups and produces an engagement survey result describing employee attitudes and opinions." ;
          skos:example "HR runs an annual engagement survey and a set of focus groups and reports the workforce's sentiment to leadership." .


###  http://example.org/apqc#P10530_SuggestionProgram
ex:P10530_SuggestionProgram rdf:type owl:Class ;
                            rdfs:subClassOf ex:ActOfAdministration ;
                            rdfs:comment "Supporting class minted to carry the administrative suggestion-program-management facet de-conflated from compound row P10530 (§4); it is NOT a PCF-derived class, so per §4 it bears no ex:pcfID/ex:hierarchyID/ex:apqcSourceText and is intentionally left without has-input/has-output someValuesFrom restrictions (so it is not subject to the PCF-provenance ProcessShape, which targets only ex: classes carrying an I/O or part restriction). Its I/O is recorded here: input ex:EmployeeFeedback (the suggestions collected); output ex:SuggestionRegister; participant ex:Employee. Anchored at ex:ActOfAdministration (running an established suggestion program); linked from P10530 by has process part." ;
                            rdfs:label "Manage employee suggestion program" ;
                            skos:definition "An Act of Administration that collects and handles employee suggestions and runs the programs through which an organization taps into employee ideas, recording them in a suggestion register." ;
                            skos:example "HR operates the staff suggestion scheme, logging and triaging submitted ideas." .


###  http://example.org/apqc#P10531
ex:P10531 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeGrievance
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:GrievanceResolution
                          ] ;
          ex:apqcSourceText "Taking care or resolving any complaint raised by an employee by procedures provided for in a collective agreement, an employment contract, or by other mechanisms established by an employer." ;
          ex:hierarchyID "7.4.4" ;
          ex:pcfID "10531" ;
          ex:requiresCapability ex:EmployeeRelationsCapability ,
                                ex:LaborRelationsCapability ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Genus is ex:ActOfAdministration (Planned Act): handling a grievance per established procedures. Both the input ex:EmployeeGrievance (the complaint being resolved) and the output ex:GrievanceResolution are definitional and promoted to restrictions. The complaining employee is a definitional participant." ;
          rdfs:label "Manage employee grievances" ;
          skos:definition "An Act of Administration in which an Agent processes and resolves a complaint raised by an employee according to procedures established by a collective agreement, employment contract, or other employer mechanism, producing a grievance resolution." ;
          skos:example "An HR officer reviews a worker's overtime complaint against the contract and issues a written resolution." .


###  http://example.org/apqc#P10532
ex:P10532 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:EmployeeCommunicationPlan
                          ] ;
          ex:apqcSourceText "Implementing the communication plan for employees. Initiate dialogues and engagement by monitoring the exchange of ideas and opinions, the development of personal relationships, etc." ;
          ex:hierarchyID "7.8.3" ;
          ex:pcfID "10532" ;
          ex:requiresCapability ex:EmployeeCommunicationCapability ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "Anchored directly under cco:ont00000402 (Act of Communication, verified: a Planned Act transferring an ICE from one Agent to another) rather than minting a genus; reuse before mint (D5/D6). The employee communication plan it implements is a definitional input; employees are definitional participants (recipients). The specific informational content transferred varies by message and is therefore left as commentary rather than an existential output restriction." ;
          rdfs:label "Deliver employee communications" ;
          skos:definition "An Act of Communication that transfers information to employees in execution of an employee communication plan, initiating dialogue and engagement." ;
          skos:example "Internal communications publishes the planned messaging to staff and hosts town-hall dialogues to gather responses." .


###  http://example.org/apqc#P10728
ex:P10728 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000568 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P10738
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P10739
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P10740
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P10741
                          ] ;
          ex:apqcSourceText "Determining different stages of the planning process and accounting. Classify, determine, analyze, interpret, and communicate information to make up-to-date business decisions for better management and control functions." ;
          ex:hierarchyID "9.1" ;
          ex:pcfID "10728" ;
          rdfs:comment "R5 = capability (R6). The APQC process group denotes a standing finance function with no identifiable single beginning and end, so it is an Organization Capability (cco:ont00000568), not a process. Its four child Processes are the acts in which it is realized." ;
          rdfs:label "Perform planning and management accounting (capability)" ;
          skos:definition "An Organization Capability that inheres in a finance function in virtue of its capacity to plan, budget, account for, and evaluate financial performance, realized in acts of management accounting." ;
          skos:example "A corporation's standing management-accounting function exercised continuously across fiscal periods." .


###  http://example.org/apqc#P10729
ex:P10729 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAccounting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10742
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10743
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10744
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10745
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10746
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FinancialData
                          ] ;
          ex:apqcSourceText "Comparing revenue targets to reality. Review all transactions and entries passed in final accounts in a year in order to examine profits." ;
          ex:hierarchyID "9.2" ;
          ex:pcfID "10729" ;
          ex:requiresCapability ex:AccountingCapability ,
                                ex:FinancialManagementCapability ;
          rdfs:comment "Models APQC process group 9.2 as a bounded occurrent. Its APQC level-3 children are process parts (cco:ont00001777), not subclasses." ;
          rdfs:label "Perform revenue accounting" ;
          skos:definition "An Act of Accounting that reviews a period's revenue-related transactions and final-account entries and produces financial data comparing revenue targets to realized results." ;
          skos:example "A finance team's annual revenue close in which the year's customer transactions are reviewed to examine profits." .


###  http://example.org/apqc#P10730
ex:P10730 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAccounting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10748
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10749
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10750
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FinancialStatement
                          ] ;
          ex:apqcSourceText "Making statements about business activities and functions. Prepare financial statements (balance sheet, income statement, statement of cash flows, and statement of stockholders' equity) according to accounting concepts and principles." ;
          ex:hierarchyID "9.3" ;
          ex:pcfID "10730" ;
          ex:requiresCapability ex:AccountingCapability ,
                                ex:FinancialManagementCapability ;
          rdfs:comment "Models APQC process group 9.3 as a bounded occurrent (the accounting-and-reporting cycle). Its APQC children are process parts (cco:ont00001777), not subclasses. 9.3.1 is a standing function modeled as a capability, hence absent from the partonomy." ;
          rdfs:label "Perform general accounting and reporting" ;
          skos:definition "An Act of Accounting that records an organization's financial transactions and produces financial statements describing its activities in accordance with accounting concepts and principles." ;
          skos:example "A company's fiscal-period close culminating in a published set of financial statements." .


###  http://example.org/apqc#P10732
ex:P10732 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFinancialTransaction ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:PaymentInstrument
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10753
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10754
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10755
                          ] ;
          ex:apqcSourceText "Handling reporting time, managing pay, and processing taxes from salaries. Pay employees. Withhold taxes. Confirm the correct funds are paid to the correct government agency." ;
          ex:hierarchyID "9.5" ;
          ex:pcfID "10732" ;
          ex:requiresCapability ex:FinancialManagementCapability ;
          rdfs:comment "Models APQC group 9.5 as a bounded payroll-run occurrent. Its three APQC children are process parts, not subclasses. The disbursed monetary payment is a MATERIAL participant (obo:BFO_0000057, not has output: cco:ont00001986 has output is reserved for ICE outputs); time records and tax filings are produced by its parts." ;
          rdfs:label "Process payroll" ;
          skos:definition "An Act of Financial Transaction that disburses pay to an organization's employees by reporting their time, managing their pay, and processing their payroll taxes, producing monetary payments to employees and to tax authorities." ;
          skos:example "A company's biweekly payroll cycle that pays employees and remits withheld taxes." .


###  http://example.org/apqc#P10733
ex:P10733 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFinancialTransaction ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10756
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10757
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20929
                          ] ;
          ex:apqcSourceText "Handling bills and reimbursements to be made. Make payments for goods or services taken or used on behalf of the organization." ;
          ex:hierarchyID "9.6" ;
          ex:pcfID "10733" ;
          ex:requiresCapability ex:FinancialManagementCapability ;
          rdfs:comment "Models APQC process group 9.6 as a bounded occurrent (the organization's payables-and-reimbursement payment cycle); its APQC children are process parts, not subclasses." ;
          rdfs:label "Process accounts payable and expense reimbursements" ;
          skos:definition "An Act of Financial Transaction that handles bills and reimbursements owed by an organization and disburses payment for goods or services taken or used on its behalf." ;
          skos:example "A finance team's monthly run that settles supplier invoices, employee reimbursements, and corporate-card balances." .


###  http://example.org/apqc#P10734
ex:P10734 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000568 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P10885
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P10893
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P12974
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P14079
                          ] ;
          ex:apqcSourceText "Managing business's investments in trading in bonds, currencies, financial derivatives, etc. Manage the financial assets and holdings of the organization. Optimize the organization's liquidity. Invest excess cash. Reduce financial risks." ;
          ex:hierarchyID "9.7" ;
          ex:pcfID "10734" ;
          rdfs:comment "R5: standing treasury function with no natural end -> Organization Capability (R6), not a process. Sub-functions and their underlying acts realize it." ;
          rdfs:label "Manage treasury operations" ;
          skos:definition "An Organization Capability that is realized in acts of managing an organization's investments, financial assets, liquidity, and financial risk." ;
          skos:example "A corporate treasury department's ongoing stewardship of the firm's cash, debt, investments, and hedging." .


###  http://example.org/apqc#P10738
ex:P10738 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10771
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10772
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10773
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20135
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20136
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:Budget
                          ] ;
          ex:apqcSourceText "Allocating funds to meet future and current financial goals. Led by the chief financial officer, have the finance function plan, budget, and forecast in order to determine and describe long and short-term financial goals." ;
          ex:hierarchyID "9.1.1" ;
          ex:pcfID "10738" ;
          rdfs:comment "Composite process; APQC children are process parts (cco:ont00001777), not subclasses. Genus is ex:ActOfFormulation because the dominant output is a directive budget/plan." ;
          rdfs:label "Perform planning/budgeting/forecasting" ;
          skos:definition "An Act of Formulation in which a finance function plans, budgets, and forecasts to set an organization's short- and long-term financial goals, producing a financial plan and budget." ;
          skos:example "A finance team's annual budgeting and forecasting cycle led by the CFO." .


###  http://example.org/apqc#P10739
ex:P10739 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAccounting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10774
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10775
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10776
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10777
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11175
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P14057
                          ] ;
          ex:apqcSourceText "Defining costs to be incurred and methods for optimum utilization. Determine the costs of products, processes, projects, etc. to compile in the financial statements, as well as to assist management in making decisions regarding planning and control. Control costs by managing and reducing business expenses." ;
          ex:hierarchyID "9.1.2" ;
          ex:pcfID "10739" ;
          rdfs:comment "Composite process; APQC children are process parts. Genus ex:ActOfAccounting because the dominant output is descriptive accounting records (cost determination compiled into statements)." ;
          rdfs:label "Perform cost accounting and control" ;
          skos:definition "An Act of Accounting that determines the costs of products, processes, and projects and compiles them into financial records to support cost control." ;
          skos:example "A cost-accounting close that compiles product costs into the period's financial statements." .


###  http://example.org/apqc#P10740
ex:P10740 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10778
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10779
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10780
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10781
                          ] ;
          ex:apqcSourceText "Deciding which expenses can be avoided to reduce some costs and increase revenues. Plan and control the organization's budget to forecast future expenditures." ;
          ex:hierarchyID "9.1.3" ;
          ex:pcfID "10740" ;
          rdfs:comment "Composite process anchored at cco:ont00000228 (Planned Act) because its parts are heterogeneous (descriptive cost-driver analysis plus directive resource allocation), so no single descriptive/directive act genus fits the whole." ;
          rdfs:label "Perform cost management" ;
          skos:definition "A Planned Act in which an organization identifies and measures cost drivers and reallocates resources to reduce avoidable expenses and control costs." ;
          skos:example "A cost-reduction initiative that profiles cost drivers and reallocates assets." .


###  http://example.org/apqc#P10741
ex:P10741 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10782
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10783
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10784
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10785
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10786
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10787
                          ] ;
          ex:apqcSourceText "Checking and achieving predetermined financial targets and timelines. Assess and manage the profitability, feasibility, and consistency of a business or project. Study the revenues generated." ;
          ex:hierarchyID "9.1.4" ;
          ex:pcfID "10741" ;
          rdfs:comment "Composite process anchored at cco:ont00000228 (Planned Act) because its parts mix appraisal (assess profitability, evaluate new products) with planning/selection (optimize mix), so no single act genus fits the whole." ;
          rdfs:label "Evaluate and manage financial performance" ;
          skos:definition "A Planned Act in which an organization appraises and manages the profitability and feasibility of its products, customers, and projects against predetermined financial targets." ;
          skos:example "A profitability and product-mix review cycle assessing performance against targets." .


