ex:PCF_16400 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing investments, holdings, products, businesses, and brands, along with the related projects that together constitute a program." ;
             ex:designatesProcessType ex:PortfolioProgramProjectManagementCapability ;
             ex:hierarchyID "13.2" ;
