          skos:definition "An Act of Monitoring that has as input IT performance data and has as output an IT performance report measuring online-system performance against expected results." ;
          skos:example "An operator watches live dashboards for the transaction systems." .


###  http://example.org/apqc#P20907
ex:P20907 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITPerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITPerformanceReport
                          ] ;
          ex:apqcSourceText "Operate and monitor the application of scheduling batch jobs to be run in the background at a certain date and time." ;
          ex:hierarchyID "8.7.6.2" ;
          ex:pcfID "20907" ;
          rdfs:comment "Monitoring (Descriptive output): runs and watches batch execution." ;
          rdfs:label "Run and monitor batch job schedule" ;
          skos:definition "An Act of Monitoring that has as input IT performance data and has as output an IT performance report tracking the execution of scheduled batch jobs." ;
          skos:example "An operator confirms overnight batch jobs completed successfully." .


###  http://example.org/apqc#P20908
ex:P20908 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ITInfrastructureComponent
                          ] ;
          ex:apqcSourceText "Analyze and manage workload needs in relation to service delivery. Plan resources and mechanism around those workload needs so that services could be delivered smoothly." ;
          ex:hierarchyID "8.7.6.3" ;
          ex:pcfID "20908" ;
          rdfs:comment "Service Provision (operations): provisions material infrastructure components (obo:BFO_0000057) against live workload demand." ;
          rdfs:label "Manage service delivery workloads" ;
          skos:definition "An Act of Service Provision that allocates resources to meet service-delivery workload needs so that services are delivered smoothly." ;
          skos:example "A delivery lead shifts capacity to absorb a month-end processing spike." .


###  http://example.org/apqc#P20909
ex:P20909 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITPerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITPerformanceReport
                          ] ;
          ex:apqcSourceText "Managing the performance and capacity of infrastructure by using key performance indicators to routinely track the performance and capacity levels. Review performance. Evaluate the efficiency and effectiveness of the infrastructure." ;
          ex:hierarchyID "8.7.6.4" ;
          ex:pcfID "20909" ;
          rdfs:comment "Monitoring (Descriptive output): routine KPI tracking and evaluation yields a performance report." ;
          rdfs:label "Manage infrastructure performance and capacity" ;
          skos:definition "An Act of Monitoring that has as input IT performance data and has as output an IT performance report tracking and evaluating IT infrastructure performance and capacity against key performance indicators." ;
          skos:example "A capacity team reviews monthly utilization and headroom metrics." .


###  http://example.org/apqc#P20910
ex:P20910 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITIssueRequest
                          ] ;
          ex:apqcSourceText "Addressing to an issue in operational activities within the IT function, that occur outside of normal routine or preventative maintenance." ;
          ex:hierarchyID "8.7.6.5" ;
          ex:pcfID "20910" ;
          rdfs:comment "Service Provision (operations): an incident-response act." ;
          rdfs:label "Respond to unplanned operational issues" ;
          skos:definition "An Act of Service Provision that has as input an IT issue/request and addresses an operational issue arising outside normal routine or preventative maintenance." ;
          skos:example "An on-call engineer restores a service after an unexpected outage." .


###  http://example.org/apqc#P20911
ex:P20911 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITPerformanceReport
                          ] ;
          ex:apqcSourceText "Identify and introduce resources to display output in a viewable form to key decision makers and evaluators." ;
          ex:hierarchyID "8.7.6.6" ;
          ex:pcfID "20911" ;
          rdfs:comment "Service Provision (operations): produces and delivers output artifacts (the IT performance report as informational output) to recipients." ;
          rdfs:label "Produce and distribute output media" ;
          skos:definition "An Act of Service Provision that produces and distributes output media in a viewable form to key decision makers and evaluators, and has as output an IT performance report." ;
          skos:example "An operations team generates and circulates the daily processing report." .


###  http://example.org/apqc#P20912
ex:P20912 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITSecurityThreatData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITSecurityThreatAnalysis
                          ] ;
          ex:apqcSourceText "Identifying, examining, and recognizing any flaw or breach in security of IT infrastructure. Ensure that protocols and guidelines for individual IT components are being followed and there is no misuse of information and breach of individual or organizational privacy." ;
          ex:hierarchyID "8.7.6.7" ;
          ex:pcfID "20912" ;
          rdfs:comment "Monitoring (Descriptive output): surveils for security flaws/breaches, yielding a threat analysis." ;
          rdfs:label "Monitor IT infrastructure security" ;
          skos:definition "An Act of Monitoring that has as input IT security threat data and has as output an IT security threat analysis identifying flaws or breaches in IT infrastructure security." ;
          skos:example "A SOC analyst watches the SIEM for intrusion indicators." .


###  http://example.org/apqc#P20913
ex:P20913 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ITInfrastructureComponent
                          ] ;
          ex:apqcSourceText "Managing resources of IT infrastructure and their recovery capacity. Manage storage, computer hardware, software, and infrastructure resources that can be stored as inventory or provided by the organization as needed. Managing backup/recovery for IT services and solutions. Use a backup system or application." ;
          ex:hierarchyID "8.7.6.8" ;
          ex:pcfID "20913" ;
          rdfs:comment "Service Provision (operations): acts on material infrastructure components (obo:BFO_0000057) for backup/recovery." ;
          rdfs:label "Manage IT infrastructure/data recovery" ;
          skos:definition "An Act of Service Provision that performs backup and recovery operations on IT infrastructure components to safeguard and restore IT services and solutions." ;
          skos:example "A backup operator validates restores from the previous night's backup." .


###  http://example.org/apqc#P20914
ex:P20914 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000568 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P20915
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P20916
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P20917
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P20918
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P20919
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000054 ;
                            owl:someValuesFrom ex:P20920
                          ] ;
          ex:apqcSourceText "Managing the resources required for administration of IT infrastructure. Manage the IT inventory and assets. Take care of the organization's IT resource capacity." ;
          ex:hierarchyID "8.7.7" ;
          ex:pcfID "20914" ;
          rdfs:comment "R5/R6: 'Manage ... administration' is a standing function with no natural end. Modeled as cco:ont00000568 (Organization Capability) realized in its bounded child acts (configuration, maintenance, deployment, records, licensing, provisioning)." ;
          rdfs:label "Manage infrastructure resource administration" ;
          skos:definition "An Organization Capability that an organization realizes in the acts by which it administers IT infrastructure resources, inventory, assets, and capacity." ;
          skos:example "An IT department's ongoing ability to administer its infrastructure estate." .


###  http://example.org/apqc#P20915
ex:P20915 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDataManagement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITLandscapeData
                          ] ;
          ex:apqcSourceText "Identifying and tracking individual configuration items, documenting functional capabilities and interdependencies of IT infrastructure. Determining the gaps and needs in order to enhance existing infrastructure configuration." ;
          ex:hierarchyID "8.7.7.1" ;
          ex:pcfID "20915" ;
          ex:requiresCapability ex:ITInfrastructureManagementCapability ;
          rdfs:comment "Data Management (Descriptive output): maintains the configuration record (a CMDB-like ICE)." ;
          rdfs:label "Manage infrastructure configuration" ;
          skos:definition "An Act of Data Management that identifies, tracks, and documents the configuration items, capabilities, and interdependencies of IT infrastructure, producing IT landscape data." ;
          skos:example "A config manager updates the CMDB with new server dependencies." .


###  http://example.org/apqc#P20916
ex:P20916 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000950 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ITInfrastructureComponent
                          ] ;
          ex:apqcSourceText "Evaluating and maintaining all aspects of infrastructure component maintenance. Ensure that all components of an IT infrastructure are functioning properly as per the expectation. Maintenance includes all preventative, routine, and corrective measures." ;
          ex:hierarchyID "8.7.7.2" ;
          ex:pcfID "20916" ;
          ex:requiresCapability ex:ITInfrastructureManagementCapability ;
          rdfs:comment "Reuses cco:ont00000950 (Act of Maintenance). Gate-F D6 fix -- VERIFICATION RECORD (add to methodology §6 'Verified core terms'): cco:ont00000950 PINNED against CommonCoreOntologiesMerged v2.0 (2024-11-06) by reading its actual triples: label 'Act of Maintenance'; definition 'An Act of Artifact Modification in which a Material Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions.'; parent chain ont00000950 rdfs:subClassOf cco:ont00000970 (Act of Artifact Modification). The definition fits component maintenance exactly, so the reuse is now auditable rather than asserted from a remembered definition. Operates on a Material Entity participant (obo:BFO_0000057 some ex:ITInfrastructureComponent), legal in operations category 8.0; this class carries only a has-participant restriction (no has input/output/process-part), so it is outside the SHACL ProcessShape target and its anchor is not subject to the S2 Act-allowlist." ;
          rdfs:label "Perform infrastructure component maintenance" ;
          skos:definition "An Act of Maintenance that modifies IT infrastructure components to preserve or restore their designed functions and qualities." ;
          skos:example "A field tech replaces failing disks and applies firmware patches." .


###  http://example.org/apqc#P20917
ex:P20917 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDeployment ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ITInfrastructureComponent
                          ] ;
          ex:apqcSourceText "Installing/configuring/upgrading all the components required for operational activities within IT infrastructure. Ensure that all components of an IT infrastructure are functioning properly and updated to latest version/technology." ;
          ex:hierarchyID "8.7.7.3" ;
          ex:pcfID "20917" ;
          ex:requiresCapability ex:ITInfrastructureManagementCapability ;
          rdfs:comment "Deployment (operations): places/updates material infrastructure components into service (obo:BFO_0000057). Distinct from maintenance (which preserves/restores existing function)." ;
          rdfs:label "Install/configure/upgrade infrastructure components" ;
          skos:definition "An Act of Deployment that installs, configures, and upgrades IT infrastructure components required for operational activities, bringing them into functioning, up-to-date service." ;
          skos:example "An engineer racks, images, and configures new servers." .


###  http://example.org/apqc#P20918
ex:P20918 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDataManagement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITLandscapeData
                          ] ;
          ex:apqcSourceText "Maintaining the complete list of IT items or resources available with the organization with the details on date of purchase, licenses, deployment and SLAs." ;
          ex:hierarchyID "8.7.7.4" ;
          ex:pcfID "20918" ;
          ex:requiresCapability ex:ITInfrastructureManagementCapability ;
          rdfs:comment "Data Management (Descriptive output): maintains the asset register ICE; the records describe material IT assets but the act manipulates the ICE." ;
          rdfs:label "Maintain IT asset records" ;
          skos:definition "An Act of Data Management that maintains an IT landscape data register of the organization's IT items and resources, including purchase, license, deployment, and SLA details." ;
          skos:example "An asset manager updates the inventory when new laptops are issued." .


###  http://example.org/apqc#P20919
ex:P20919 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITPolicy
                          ] ;
          ex:apqcSourceText "Administering and overseeing the terms and policies associated with licensing the IT intellectual property. Create and manage the policies and terms governing the possible granting of a license to any external agent. Demarcate a clear framework that governs the licensing of any patents or copyrights held by the organization." ;
          ex:hierarchyID "8.7.7.5" ;
          ex:pcfID "20919" ;
          ex:requiresCapability ex:ITInfrastructureManagementCapability ;
          rdfs:comment "Formulation (Directive output): licensing policies and terms are prescriptive." ;
          rdfs:label "Administer IT licenses/user agreements" ;
          skos:definition "An Act of Formulation that has as output an IT policy prescribing the terms and conditions governing the licensing of the organization's IT intellectual property." ;
          skos:example "Legal and IT jointly set the terms for licensing the firm's patented software." .


###  http://example.org/apqc#P20920
ex:P20920 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ITInfrastructureComponent
                          ] ;
          ex:apqcSourceText "Providing all the infrastructure services and capabilities required for operational activities within the IT function supporting overall business objectives." ;
          ex:hierarchyID "8.7.7.6" ;
          ex:pcfID "20920" ;
          ex:requiresCapability ex:ITInfrastructureManagementCapability ;
          rdfs:comment "Service Provision (operations): delivers infrastructure services/capacity (a Material Entity, IT infrastructure component, as participant via obo:BFO_0000057) to consumers." ;
          rdfs:label "Provide IT infrastructure service and capabilities" ;
          skos:definition "An Act of Service Provision that provisions the IT infrastructure services and capabilities required for the operational activities of the IT function." ;
          skos:example "An infrastructure team provisions compute, storage, and network capacity to application teams." .


###  http://example.org/apqc#P20921
ex:P20921 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20922
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20923
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20925
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20926
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20927
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20928
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITIssueRequest
                          ] ;
          ex:apqcSourceText "Managing systematic user support functionality and capability through defined procedures. Determine, record, and monitor user requests. Execute issue/request resolution. Utilize escalation path when needed. Resolve issue/request." ;
          ex:hierarchyID "8.7.8" ;
          ex:pcfID "20921" ;
          ex:requiresCapability ex:ITSupportCapability ;
          rdfs:comment "Operations process: the bounded support-operation cycle is composed of triage, resolution, escalation, and recovery children." ;
          rdfs:label "Operate IT user support" ;
          skos:definition "An Act of Service Provision that runs the systematic IT user-support function, recording user requests and driving them to resolution through defined procedures." ;
          skos:example "A service desk operates the end-to-end ticket lifecycle for users." .


###  http://example.org/apqc#P20922
ex:P20922 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITIssueRequest
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITServiceSupportRecord
                          ] ;
          ex:apqcSourceText "Evaluate and assign IT issues/requests accordingly to allow for the correct routing of IT issues to the relevant support teams." ;
          ex:hierarchyID "8.7.8.1" ;
          ex:pcfID "20922" ;
          rdfs:comment "Analysis (Descriptive output): evaluates and classifies the request; the routing assignment is a descriptive record." ;
          rdfs:label "Triage IT issues/requests" ;
          skos:definition "An Act of Analysis that has as input an IT issue/request and has as output an IT service support record assigning and routing the issue to the relevant support team." ;
          skos:example "A first-line agent categorizes a ticket and routes it to the network team." .


###  http://example.org/apqc#P20923
ex:P20923 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITIssueRequest
                          ] ;
          ex:apqcSourceText "Providing the necessary skills and competencies required to efficiently provide IT resolution through the support structure." ;
          ex:hierarchyID "8.7.8.2" ;
          ex:pcfID "20923" ;
          ex:requiresCapability ex:ITSupportCapability ;
          rdfs:comment "Service Provision (operations): makes resolution capability available through the support structure." ;
          rdfs:label "Provide IT resolution capabilities" ;
          skos:definition "An Act of Service Provision that supplies the skills and competencies needed to resolve IT issues through the support structure." ;
          skos:example "A support team staffs specialists to handle complex incidents." .


###  http://example.org/apqc#P20925
ex:P20925 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITIssueRequest
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITServiceSupportRecord
                          ] ;
          ex:apqcSourceText "Creating an effective plan and structure to address and resolve requests of IT users. Determine, record, and monitor user requests. Obtain information about the effectiveness and performance of the user request handling process from the IT users through various means." ;
          ex:hierarchyID "8.7.8.3" ;
          ex:pcfID "20925" ;
          rdfs:comment "Service Provision (operations): records and tracks user requests to resolution." ;
          rdfs:label "Manage IT user requests" ;
          skos:definition "An Act of Service Provision that has as input an IT issue/request and has as output an IT service support record, recording and monitoring IT user requests through the handling process." ;
          skos:example "A service desk logs, updates, and monitors each user request to closure." .


###  http://example.org/apqc#P20926
ex:P20926 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfCommunication ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITIssueRequest
                          ] ;
          ex:apqcSourceText "Follow processes and procedures to escalate IT requests to required levels for resolution or effective decision making when necessary." ;
          ex:hierarchyID "8.7.8.4" ;
          ex:pcfID "20926" ;
          rdfs:comment "Gate-F D6 fix: re-anchored to the shared ex:ActOfCommunication, which wraps the D6-VERIFIED cco:ont00000402 'Act of Communication' ('A Planned Act in which some Information Content Entity is transferred from some Agent to Another.', parent cco:ont00000228); verification recorded in the §6 record at the ex:ActOfCommunication declaration. The verified CCO Act of Communication denotes GENERIC ICE-transfer (not only the truth-committing cco:ont00000379 'Act of Representative Communication'), so escalation-as-conveyance of the request ICE fits. The prior per-class raw cco:ont00000402 IRI and the explanatory-only cco:ont00000228 co-anchor are REMOVED: the chain to the allowlisted Planned Act now comes from the shared genus ex:ActOfCommunication (which carries cco:ont00000228 for the SHACL S2 graph), so the workaround no longer masks an unverified IRI." ;
          rdfs:label "Escalate IT requests" ;
          skos:definition "An Act of Communication that conveys an unresolved IT request to a higher support or decision-making level per defined escalation procedures." ;
          skos:example "A second-line agent escalates a major incident to the on-call manager." .


###  http://example.org/apqc#P20927
ex:P20927 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITIssueRequest
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITServiceSupportRecord
                          ] ;
          ex:apqcSourceText "Creating a structure to resolve issues/requests of IT services using different mechanisms." ;
          ex:hierarchyID "8.7.8.5" ;
          ex:pcfID "20927" ;
          rdfs:comment "Service Provision (operations): performs the resolution and records its outcome." ;
          rdfs:label "Resolve IT issues/requests" ;
          skos:definition "An Act of Service Provision that has as input an IT issue/request and has as output an IT service support record resolving the issue or request through available support mechanisms." ;
          skos:example "An engineer fixes a user's mailbox sync issue and closes the ticket." .


###  http://example.org/apqc#P20928
ex:P20928 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfServiceProvision ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITContinuityPlan
                          ] ;
          ex:apqcSourceText "Successfully implement preventive measures to manage IT risk of exposure to internal and external threats. Integrating the disciplines of Emergency Response, Crisis Management, Disaster Recovery (technology continuity) and Business Continuity for IT." ;
          ex:hierarchyID "8.7.8.6" ;
          ex:pcfID "20928" ;
          rdfs:comment "Service Provision (operations): executes the continuity plan; the plan is the directive input that guides the act." ;
          rdfs:label "Execute IT continuity and recovery action" ;
          skos:definition "An Act of Service Provision that has as input an IT continuity plan and implements preventive and recovery measures integrating emergency response, crisis management, disaster recovery, and business continuity for IT." ;
          skos:example "An IT team invokes the disaster-recovery runbook after a datacenter failure." .


###  http://example.org/apqc#P20929
ex:P20929 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfCardAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:CorporateCreditCard
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20930
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20931
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20932
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20933
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20934
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20935
                          ] ;
          ex:apqcSourceText "Handling and authoring credit cards to business entities or for corporate purchases." ;
          ex:hierarchyID "9.6.3" ;
          ex:pcfID "20929" ;
          rdfs:comment "Re-anchored from ex:ActOfFinancialTransaction to ex:ActOfCardAdministration. (1) Genus fix: 'handling and authoring (issuing) credit cards' is card issuance/administration, not a transfer of money/Financial-Instrument in settlement, so ex:ActOfFinancialTransaction's differentia is not satisfied (false friend on the theme 'credit card'); the new ex:ActOfCardAdministration (a Planned Act) covers the issue/handle/deactivate family. (2) R5 discriminator (made explicit and applied identically to ex:P10734): open-ended stewardship with no natural terminus -> Organization Capability (cco:ont00000568), as for ex:P10734 'Manage treasury operations' (ongoing optimization of cash/liquidity/risk, realized-in its acts); a bounded card-lifecycle exercise over a concrete card-set with a definite completion -> a process, as here (issue a set of cards, run their lifecycle, deactivate). The source verbs 'Handling and authoring' name discrete bounded acts with material card participants, so 9.6.3 is a process whose activities are process parts -- distinct from the no-end stewardship that makes ex:P10734 a capability. The corporate credit card is a definitional material participant." ;
          rdfs:label "Manage corporate credit cards" ;
          skos:definition "An Act of Card Administration that handles and authorizes the issuance of corporate credit cards to business entities and for corporate purchases, and that has as process parts the card-lifecycle activities of policy-setting, request handling, ordering, account maintenance, limit changes, and deactivation." ;
          skos:example "A finance team issuing and administering corporate purchasing cards." .


###  http://example.org/apqc#P20930
ex:P20930 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FinancialPolicy
                          ] ;
          ex:apqcSourceText "Developing procedures for using company credit cards. Set or approve credit limits." ;
          ex:hierarchyID "9.6.3.1" ;
          ex:pcfID "20930" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (cco:ont00000511): composing card-use procedures and limits yields a Directive ICE (GOLDEN PRINCIPLE)." ;
          rdfs:label "Establish corporate credit card policies and approval limits" ;
          skos:definition "An Act of Formulation that develops the procedures and credit limits governing corporate credit-card use and produces a financial policy." ;
          skos:example "Issuing a corporate-card policy that sets default spend limits by role." .


###  http://example.org/apqc#P20931
ex:P20931 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfCardAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:CorporateCreditCard
                          ] ;
          ex:apqcSourceText "Handling applications credit card applications for business expenses." ;
          ex:hierarchyID "9.6.3.2" ;
          ex:pcfID "20931" ;
          rdfs:comment "Re-anchored from ex:ActOfFinancialTransaction to ex:ActOfCardAdministration. Handling card applications transfers no money and settles no obligation, so it falls outside ex:ActOfFinancialTransaction's differentia; 'family coherence' is not a valid reason to file an act under a genus whose differentia it fails (same false-friend as ex:P20929/ex:P20935). ex:ActOfCardAdministration (a Planned Act) is the correct shared genus. The corporate-card request remains a typical input ICE (commented, not a definitional restriction); the card requested is the material participant in the lifecycle." ;
          rdfs:label "Process corporate credit card requests" ;
          skos:definition "An Act of Card Administration that handles applications for corporate credit cards for business expenses within the card-issuance lifecycle." ;
          skos:example "Intake and routing of an employee's corporate-card application." .


###  http://example.org/apqc#P20932
ex:P20932 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:CorporateCreditCard
                          ] ;
          ex:apqcSourceText "Obtaining credit cards for business-related expenses." ;
          ex:hierarchyID "9.6.3.3" ;
          ex:pcfID "20932" ;
          rdfs:comment "Anchored to ex:ActOfAcquisition (inlined; cco:ont00000228 Planned Act): obtaining a card from an issuer that the organization did not previously hold. The card obtained is a MATERIAL participant (obo:BFO_0000057), not has output." ;
          rdfs:label "Order corporate credit cards" ;
          skos:definition "An Act of Acquisition that obtains corporate credit cards, not previously held, for business-related expenses." ;
          skos:example "Ordering newly approved corporate purchasing cards from the issuing bank." .


###  http://example.org/apqc#P20933
ex:P20933 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAccounting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AccountStatement
                          ] ;
          ex:apqcSourceText "Handling credit card accounts of business customers." ;
          ex:hierarchyID "9.6.3.4" ;
          ex:pcfID "20933" ;
          rdfs:comment "R5: the source ('Handling credit card accounts') denotes discrete account-record maintenance, a bounded occurrent, not a no-end function. Anchored to ex:ActOfAccounting (cco:ont00000366)." ;
          rdfs:label "Manage corporate credit card accounts" ;
          skos:definition "An Act of Accounting that maintains the corporate credit-card accounts of business customers and produces updated account statements." ;
          skos:example "Reconciling and updating a corporate-card account at month-end." .


###  http://example.org/apqc#P20934
ex:P20934 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PaymentApproval
                          ] ;
          ex:apqcSourceText "Authorizing changes to the available credit advances." ;
          ex:hierarchyID "9.6.3.5" ;
          ex:pcfID "20934" ;
          rdfs:comment "Anchored to cco:ont00000228 (Planned Act) -- the §6 TOP intentional-act anchor -- as an AUTHORIZATION/RATIFICATION of a settled limit change (no candidate set), for which CCO 2.0 has no dedicated act kind. REJECTED candidates (D5/§6 step 3), uniform with the 9.6 approval siblings ex:P10872 and ex:P10882: (1) cco:ont00000636 'Act of Appraisal' -- would pair an Appraisal genus (Descriptive judgement) with the Directive ex:PaymentApproval output, breaking GOLDEN-PRINCIPLE agreement. (2) ex:ActOfSelection -- no candidate set; ratifying a single settled change routes to cco:ont00000228 per the apqc-ext ActOfSelection note. Output is the Directive ex:PaymentApproval (reused for the authorization decision)." ;
          rdfs:label "Approve/Change credit limits" ;
          skos:definition "A Planned Act that authorizes a change to the available credit advances on a corporate credit card and produces an approval decision." ;
          skos:example "Approving an increase to a department card's monthly credit limit." .


###  http://example.org/apqc#P20935
ex:P20935 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfCardAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:CorporateCreditCard
                          ] ;
          ex:apqcSourceText "Blocking an existing credit card to disable all future transactions." ;
          ex:hierarchyID "9.6.3.6" ;
          ex:pcfID "20935" ;
          rdfs:comment "Re-anchored from ex:ActOfFinancialTransaction to ex:ActOfCardAdministration (critical fix). ex:ActOfFinancialTransaction is 'A Planned Act in which an Agent transfers money or a Financial Instrument ... in settlement ...'; blocking a card to disable future transactions transfers no money and settles nothing -- it is the OPPOSITE of a financial transaction, a false friend driven by the theme 'credit card' rather than the verb 'block/deactivate'. The genus definition does not subsume this act. REJECTED candidate ex:ActOfFinancialTransaction (reason: no money/instrument transfer). Modeled as a card-lifecycle administrative act (ex:ActOfCardAdministration, a Planned Act over the card artifact), with the corporate credit card as the definitional material participant." ;
          rdfs:label "Cancel/Deactivate credit card" ;
          skos:definition "An Act of Card Administration that blocks an existing corporate credit card so as to disable all of its future transactions." ;
          skos:example "Deactivating a lost corporate card to prevent further charges." .


###  http://example.org/apqc#P20936
ex:P20936 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10349
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10350
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10351
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10352
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20109
                          ] ;
          ex:apqcSourceText "Creating and executing a strategy for all the internal activities related to the flow/transfer of inbound materials. This process includes planning inbound material receipts, managing inbound material flow, monitoring inbound delivery performance, managing the flow of returned products, controlling the quality of returned parts, and salvaging or repairing returned products." ;
          ex:hierarchyID "4.4.2" ;
          ex:pcfID "20936" ;
          ex:requiresCapability ex:LogisticsManagementCapability ,
                                ex:SupplyChainManagementCapability ;
          rdfs:comment "Heterogeneous operational aggregate (planning + material handling + monitoring + returns) anchored at the generic cco:ont00000228 (Planned Act). Its APQC children are process parts. The standing oversight aspect is realized by ex:LogisticsManagementCapability." ;
          rdfs:label "Plan and manage inbound material flow" ;
          skos:definition "A Planned Act that plans and carries out the internal activities for the flow and transfer of inbound materials, including receipt planning, material handling, delivery monitoring, and returns disposition." ;
          skos:example "An inbound-logistics team's per-shipment cycle from receipt plan through put-away and returns disposition." .


###  http://example.org/apqc#P20937
ex:P20937 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITCustomerRequirements
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITRequirementsAnalysis
                          ] ;
          ex:apqcSourceText "Assessing identified IT gaps to plan for remediation efforts to allow outcomes to meet established performance levels." ;
          ex:hierarchyID "8.1.4.3" ;
          ex:pcfID "20937" ;
          rdfs:label "Analyze IT customer requirements" ;
          skos:definition "An Act of Analysis that examines identified IT gaps in order to plan remediation and produces an IT requirements analysis." ;
          skos:example "A team analyzes catalogued gaps and recommends remediation priorities." .


###  http://example.org/apqc#P20938
ex:P20938 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITPerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITPerformanceReport
                          ] ;
          ex:apqcSourceText "Providing stakeholders with collected IT performance measures for further development based on evaluation." ;
          ex:hierarchyID "8.1.7.4" ;
          ex:pcfID "20938" ;
          rdfs:comment "Synthesis yields a descriptive report; the distribution to stakeholders is a typical follow-on communication noted here rather than restricted." ;
          rdfs:label "Synthesize and distribute IT performance information" ;
          skos:definition "An Act of Analysis that synthesizes collected IT performance measures for stakeholders and produces an IT performance report." ;
          skos:example "An analyst consolidates measures into a stakeholder performance report." .


###  http://example.org/apqc#P20939
ex:P20939 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITResearchFindings
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITResearchOutcomeAssessment
                          ] ;
          ex:apqcSourceText "Assessing IT research projects based on defined outcome expectations." ;
          ex:hierarchyID "8.2.7.5" ;
          ex:pcfID "20939" ;
          rdfs:label "Evaluate IT research project outcomes" ;
          skos:definition "An Act of Appraisal that has as input IT research findings and has as output an IT research outcome assessment judging research projects against their defined outcome expectations." ;
          skos:example "An R&D review board assesses each research project against its expected outcomes." .


###  http://example.org/apqc#P20940
ex:P20940 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessUnitRiskToleranceProfile
                          ] ;
          ex:apqcSourceText "Understand the risk tolerance levels of individual business units, given risk-return trade-offs for one or more anticipated and predictable consequences." ;
          ex:hierarchyID "8.3.1.2" ;
          ex:pcfID "20940" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis (cco:ont00000366): producing an understanding (Descriptive ICE) of unit risk tolerance." ;
          rdfs:label "Understand business unit risk tolerance" ;
          skos:definition "An Act of Analysis that examines the risk-return trade-offs of individual business units and produces a business-unit risk-tolerance profile." ;
          skos:example "A risk team profiles each division's appetite for IT-service disruption." .


###  http://example.org/apqc#P20941
ex:P20941 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:RegulatoryRequirementData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITComplianceSupportSystemIdentification
                          ] ;
          ex:apqcSourceText "Identifying and adopting information technology solutions to support changing regulatory compliance. Safeguard compliance and manage risk by outlining the risk policies and procedures." ;
          ex:hierarchyID "8.3.1.7" ;
          ex:pcfID "20941" ;
          rdfs:comment "Anchored to ex:ActOfIdentification (cco:ont00000366): discerning/enumerating supporting systems yields a Descriptive ICE registering them." ;
          rdfs:label "Identify systems to support compliance" ;
          skos:definition "An Act of Identification that discerns the IT solutions suited to support changing regulatory compliance and produces an IT compliance support system identification." ;
          skos:example "A compliance architect identifies GRC tooling to track new regulations." .


###  http://example.org/apqc#P20942
ex:P20942 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ITPolicy
                          ] ;
          ex:apqcSourceText "Develop and maintain an architecture for securing and ensuring the privacy of data flows throughout the organization. Create, test, evaluate, and implement IT security policies to ensure the safe use of IT services and solutions." ;
          ex:hierarchyID "8.3.3.4" ;
          ex:pcfID "20942" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (cco:ont00000511): composing security policies yields a Directive ICE. Test/evaluate steps are method notes; the standing 'maintain' is the IT Risk Management Capability (R6)." ;
          rdfs:label "Create and maintain IT security policies, standards, and procedures" ;
          skos:definition "An Act of Formulation that develops, tests, evaluates, and implements IT security policies, standards, and procedures and produces an IT policy." ;
          skos:example "A security architect issues a data-flow privacy policy after testing it." .


###  http://example.org/apqc#P20943
ex:P20943 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDataManagement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ITKnowledgeRepository
                          ] ;
          ex:apqcSourceText "Maintaining and transfer of knowledge towards service support with the change/upgrade in technology over a stipulated period. Ensure IT staff is well trained and tested on the new learning of service support." ;
          ex:hierarchyID "8.7.5.4" ;
          ex:pcfID "20943" ;
          rdfs:comment "Data Management (knowledge transfer): maintains and disseminates the knowledge ICE; training of staff is the downstream effect rather than the definitional output." ;
          rdfs:label "Maintain service support learning" ;
          skos:definition "An Act of Data Management that maintains and transfers service-support knowledge from an IT knowledge repository as technology changes, keeping IT staff trained on new learning." ;
          skos:example "A trainer refreshes the support team on a newly adopted platform." .


###  http://example.org/apqc#P20944
ex:P20944 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20945
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20950
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20955
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModel
                          ] ;
          ex:apqcSourceText "Establishing how an organization creates, delivers and captures value or makes profit. Identify the products or services that a business will sell, its target market, anticipated expenses, and other core aspects of its modus operandi. Revise the plan as required to reflect changing circumstances." ;
          ex:hierarchyID "1.4" ;
          ex:pcfID "20944" ;
          rdfs:comment "Models APQC process group 1.4 as a bounded occurrent. Its APQC dotted children are process parts (cco:ont00001777), not subclasses (D1). This is a Process Group, not the Category 1.0, so a has-process-part restriction is licensed." ;
          rdfs:label "Develop and maintain business models" ;
          skos:definition "An Act of Planning that establishes how an organization creates, delivers, and captures value, and revises that arrangement as circumstances change, comprising the development, maintenance, and governance of its business models." ;
          skos:example "An organization's program to design its business model, keep it current against market feedback, and govern its evolution over a planning horizon." .


###  http://example.org/apqc#P20945
ex:P20945 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20946
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20947
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20948
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20949
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessConcept
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessStrategy
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModel
                          ] ;
          ex:apqcSourceText "Creating an economic model that describes the goals of an organization and the business processes needed to achieve those goals. This involves information gathering, securing necessary approvals and authorizations, integrating with preexisting models, including the general business concept [10002] and business strategy [10015], and formally accepting the model as the basis for organization's day-to-day operations." ;
          ex:hierarchyID "1.4.1" ;
          ex:pcfID "20945" ;
          rdfs:comment "Inputs ex:BusinessConcept and ex:BusinessStrategy are definitional (the source states the model must integrate the general business concept [10002] and business strategy [10015]), so they are promoted to restrictions (Phase-3 necessity)." ;
          rdfs:label "Develop business models" ;
          skos:definition "An Act of Planning that examines a business concept and business strategy and produces a business model describing an organization's goals and the processes needed to achieve them." ;
          skos:example "A strategy team integrates the firm's business concept and strategy into a formally adopted business model." .


###  http://example.org/apqc#P20946
ex:P20946 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessModelSourceMaterial
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModelInformation
                          ] ;
          ex:apqcSourceText "Collecting all relevant materials needed to develop the business model, so that it can adequately model its processes." ;
          ex:hierarchyID "1.4.1.1" ;
          ex:pcfID "20946" ;
          rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): assembling is the receiving and storing of input ICEs, not the analysis (ex:ActOfAnalysis) of their subject matter. Added (Gate-F) the definitional has-input ex:BusinessModelSourceMaterial that the Information-Processing genus (whose definition is 'one or more input ICEs are received, manipulated, transferred, or stored') requires; without an input ICE the genus' differentia was unsatisfied." ;
          rdfs:label "Assemble business model information" ;
          skos:definition "An Act of Information Processing that collects business-model source material and produces a body of assembled business-model information." ;
          skos:example "An analyst gathers cost, market, and process documents into a single business-model information pack." .


###  http://example.org/apqc#P20947
ex:P20947 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessAuthorization
                          ] ;
          ex:apqcSourceText "Obtaining required permissions, licenses and authorizations that legitimize the business, help to mitigate associated risks and safeguard the operations." ;
          ex:hierarchyID "1.4.1.2" ;
          ex:pcfID "20947" ;
          rdfs:comment "Output ex:BusinessAuthorization is a Directive ICE (Action Permission). Genus is the local ex:ActOfAcquisition because no CCO Act covers obtaining a held authorization (see that genus' rdfs:comment). Rejected (Gate-F, per §6) cco:ont00000366 (Act of Information Processing): securing approvals is coming to HOLD an authorization the agent did not previously have, not receiving/manipulating/transferring/storing the CONTENT of an input ICE -- the authorization is acquired as a held entity, not processed for its information. Also rejected cco:ont00000402 (Act of Communication): the transfer of the permission to the agent is incidental to the agent's coming to hold it." ;
          rdfs:label "Secure appropriate approvals" ;
          skos:definition "An Act of Acquisition that obtains the permissions, licenses, and authorizations required to legitimize a business and produces a business authorization." ;
          skos:example "A compliance officer secures the licenses needed to operate the proposed line of business." .


###  http://example.org/apqc#P20948
ex:P20948 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessModel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessModelInformation
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ModelIntegrationPointRegister
                          ] ;
          ex:apqcSourceText "Ensuring coherence with pre-exsiting models to avoid contradictions between models. Make sure that all models represent the same long-term vision." ;
          ex:hierarchyID "1.4.1.3" ;
          ex:pcfID "20948" ;
          rdfs:comment "Genus ex:ActOfIdentification (discernment sense, from apqc-ext.ttl): the act discerns and enumerates integration points. Input ex:BusinessModel ranges over pre-existing models. CHOSEN READING (Gate-F): Identification, because the leaf 'ensures coherence' by discerning and registering the points of contact (output ex:ModelIntegrationPointRegister, Descriptive). Rejected ex:ActOfAnalysis: the act enumerates discrete integration points rather than examining subject matter to synthesize an understanding -- discernment, not analysis." ;
          rdfs:label "Identify integration points with existing models" ;
          skos:definition "An Act of Identification that has as input business-model information and pre-existing business models and has as output a register of the points at which the new model must integrate with them." ;
          skos:example "A modeller maps where the new business model touches the existing operating model to prevent contradictions." .


###  http://example.org/apqc#P20949
ex:P20949 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:BusinessModel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModelAdoptionDecision
                          ] ;
          ex:apqcSourceText "Consenting to a particular business model and formally accepting it to serve as the set of guiding principles in operating the company." ;
          ex:hierarchyID "1.4.1.4" ;
          ex:pcfID "20949" ;
          rdfs:comment "Re-anchored (Gate-F) from ex:ActOfSelection to cco:ont00000228 (Planned Act): the source is 'consenting to a PARTICULAR business model and formally accepting it' -- a commitment/ratification act over a single model, not a choice among a set of candidates (ex:ActOfSelection definitionally chooses from a set). Rejected ex:ActOfSelection: there is no candidate set here; the model has already been settled, and this leaf is the ratification. No narrower CCO act denotes ratification/acceptance, so it anchors at the generic Planned Act, parallel to ex:P19507 'Execute strategic initiatives'. Output ex:BusinessModelAdoptionDecision (Directive) is kept: a ratification still prescribes that the model govern operations. Anchored as Planned Act consistently with the parallel ratification leaf ex:P10056 'Migrate to new organization'." ;
          rdfs:label "Adopt the business model" ;
          skos:definition "A Planned Act that consents to and formally ratifies a single business model, producing an adoption decision accepting it as the basis of operations." ;
          skos:example "An executive board formally adopts the proposed business model as the company's operating basis." .


###  http://example.org/apqc#P20950
ex:P20950 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20951
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20952
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20953
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20954
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModel
                          ] ;
          ex:apqcSourceText "Revising and updating business models to reflect the changes in the marketed services, product inventory, market behavior, available resources or accrued expenses. Determine how and when to modify the accepted business model in response to incoming feedback." ;
          ex:hierarchyID "1.4.2" ;
          ex:pcfID "20950" ;
          rdfs:comment "R5 bounded-occurrent test: this is a bounded revision PROCESS, not the standing function. Begin/end criterion (Gate-F): an instance BEGINS when a triggering condition (incoming feedback or a scheduled review) opens a revision episode and ENDS when the reissued business model is published; it has a determinate temporal extent and modeled child steps. By contrast, the standing upkeep/oversight FUNCTION (which has no per-episode begin/end and persists between revisions) is the continuant ex:BusinessModelGovernanceCapability set up by 1.4.3, not this process. The ex:CustomerFeedback input is demoted (Gate-F, Phase-3) from an existential has-input to this comment: the source's wider scope ('changes in marketed services, product inventory, market behavior, available resources or accrued expenses') shows feedback is only one of several alternative triggers, so it is not necessary for every instance." ;
          rdfs:label "Maintain business models" ;
          skos:definition "An Act of Planning that revises and updates an organization's business models in response to feedback and changing circumstances and produces an updated business model." ;
          skos:example "A product team runs its periodic review and reissues the business model to reflect new market behavior." .


###  http://example.org/apqc#P20951
ex:P20951 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModelMaintenancePlan
                          ] ;
          ex:apqcSourceText "Determining the timeline, procedures and responsibilities for reviewing the business model and for updating it to best serve the organization." ;
          ex:hierarchyID "1.4.2.1" ;
          ex:pcfID "20951" ;
          rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it makes a procedure (a Directive ICE) prescribing how and when maintenance occurs." ;
          rdfs:label "Establish business model maintenance parameters" ;
          skos:definition "An Act of Planning that determines the timeline, procedures, and responsibilities for reviewing and updating a business model and produces a business-model maintenance plan." ;
          skos:example "A governance lead sets a quarterly review cadence and assigns owners for business-model updates." .


###  http://example.org/apqc#P20952
ex:P20952 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FeedbackCriteriaSpecification
                          ] ;
          ex:apqcSourceText "Deciding the type of responses, reactions, sentiments and insights that are crucial to be taken into consideration with business model maintenance." ;
          ex:hierarchyID "1.4.2.2" ;
          ex:pcfID "20952" ;
          rdfs:comment "Genus ex:ActOfSelection: the act picks, among candidate feedback types, those that count. Output ex:FeedbackCriteriaSpecification is a Directive ICE prescribing which feedback is admissible. CHOSEN READING (Gate-F): Selection, because the source verb is 'DECIDING the type of responses ... crucial to be taken into consideration' -- choosing admissible types from a candidate set, with a Directive chosen-option output (Golden Principle agreement). Rejected ex:ActOfFormulation: the act selects among pre-existing feedback kinds rather than composing a novel specification from scratch." ;
          rdfs:label "Accept business model feedback parameters" ;
          skos:definition "An Act of Selection that determines which types of feedback are to be taken into consideration during business-model maintenance and produces a feedback-criteria specification." ;
          skos:example "A team decides that only structured customer-survey and churn signals will drive model changes." .


###  http://example.org/apqc#P20953
ex:P20953 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerFeedback
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:FeedbackPrioritization
                          ] ;
          ex:apqcSourceText "Evaluating the feedback regarding products, services, processes or resources. Determine which judgments are critical and mandate changes to the current business model to better deliver the desired value" ;
          ex:hierarchyID "1.4.2.3" ;
          ex:pcfID "20953" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it evaluates and judges the importance of feedback. Input ex:CustomerFeedback is definitional (the act is about the feedback)." ;
          rdfs:label "Prioritize and manage incoming feedback" ;
          skos:definition "An Act of Appraisal that evaluates incoming feedback to judge which items are critical and produces a prioritization of that feedback." ;
          skos:example "A product council ranks incoming feedback and flags the items that mandate model changes." .


###  http://example.org/apqc#P20954
ex:P20954 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModel
                          ] ;
          ex:apqcSourceText "Modifying the business models that are presently in use in response to incoming feedback or changing markets to achieve the enterprise business goals." ;
          ex:hierarchyID "1.4.2.4" ;
          ex:pcfID "20954" ;
          rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): revising the operative plan (the business model, a Directive ICE). The ex:CustomerFeedback input is demoted (Gate-F, Phase-3) from an existential has-input to this comment: the source says the update is triggered by 'incoming feedback OR changing markets', so feedback is only ONE of two alternative triggers and is not necessary for every instance. Output ex:BusinessModel retained." ;
          rdfs:label "Update existing models" ;
          skos:definition "An Act of Planning that modifies the business models presently in use in response to feedback or changing markets and produces an updated business model." ;
          skos:example "A team revises the in-force business model to reflect prioritized feedback and new market conditions." .


###  http://example.org/apqc#P20955
ex:P20955 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000511 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:BusinessModelGovernancePolicy
                          ] ;
          ex:apqcSourceText "Creating and implementing a strategy, responsibilities and control mechanisms for managing business models that are timely, efficient and cost-effective." ;
          ex:hierarchyID "1.4.3" ;
          ex:pcfID "20955" ;
          ex:requiresCapability ex:BusinessModelGovernanceCapability ;
          rdfs:comment "R5/R6: the bounded establishing act passes R5 and is modeled here as a process; the standing governance function it stands up is the pre-existing shared ex:BusinessModelGovernanceCapability (Organization Capability), reused (not re-minted) and linked via obo:BFO_0000054 (realized in)." ;
          rdfs:label "Establish business model governance" ;
          skos:definition "An Act of Planning that creates and implements the strategy, responsibilities, and control mechanisms for governing an organization's business models and produces a business-model governance policy." ;
          skos:example "An organization stands up a model-governance board with a charter, owners, and review controls." .


###  http://example.org/apqc#P20956
ex:P20956 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductSample
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProductionLot
                          ] ;
          ex:apqcSourceText "Selecting a set of elements from a product lot to draw conclusions or make inferences about the quality of the product lot from which the sample is drawn. Sampling is frequently used because gathering data on every product produced by a company is often impossible, impractical, or too costly to collect." ;
          ex:hierarchyID "4.3.3.3" ;
          ex:pcfID "20956" ;
          rdfs:comment "Anchored under cco:ont00000228 (Planned Act): drawing physical samples takes a material lot as input and yields a material product sample, so it is not ex:ActOfSelection (whose output is a Directive ICE). The production lot is the material input (has input); the product sample is a material participant (obo:has participant, since has output is reserved for ICEs)." ;
          rdfs:label "Manage quality samples" ;
          skos:definition "A Planned Act that draws a set of elements from a production lot to obtain a product sample representative of the lot's quality." ;
          skos:example "An inspector pulls ten units from a batch for testing." .


###  http://example.org/apqc#P20957
ex:P20957 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfTransportation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:InventoryItem
                          ] ;
          ex:apqcSourceText "Shipping items from one warehouse to another in a multi-warehouse environment. A warehouse transfer is typically handled electronically in a system designed to replicate the physical processes involved with transferring items from one warehouse to another." ;
          ex:hierarchyID "4.4.3.8" ;
          ex:pcfID "20957" ;
          rdfs:comment "Operations material I/O (section 4.0): the transferred inventory items participate via has participant." ;
          rdfs:label "Manage warehouse transfers" ;
          skos:definition "An Act of Transportation that ships inventory items from one warehouse to another in a multi-warehouse environment." ;
          skos:example "A planner triggers a stock transfer of items from a regional warehouse to a depleted one." .


###  http://example.org/apqc#P20958
ex:P20958 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10418
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10419
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10420
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10421
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10422
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10432
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21430
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21431
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StrategicGoals
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HumanResourcesStrategy
                          ] ;
          ex:apqcSourceText "Creating a long-term plan to associate human resource requirements with the strategic goals of the company to ensure that there is enough qualified staffing to achieve those goals, to maintain competitive advantage and to reduce employee turnover." ;
          ex:hierarchyID "7.1.1" ;
          ex:pcfID "20958" ;
          ex:requiresCapability ex:HumanCapitalManagementCapability ,
                                ex:WorkforcePlanningCapability ;
          rdfs:comment "Models APQC 7.1.1 as a bounded occurrent. Its APQC children are process parts (cco:ont00001777), not subclasses." ;
          rdfs:label "Develop human resources strategy" ;
          skos:definition "An Act of Formulation that has as input strategic goals and produces a human resources strategy associating human-resource requirements with the organization's strategic goals." ;
          skos:example "An HR leadership team formulates a three-year HR strategy aligned to corporate goals." .


###  http://example.org/apqc#P20960
ex:P20960 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:Hypothesis
                          ] ;
          ex:apqcSourceText "Creating theories that explain empirical data. Use the hypotheses to guide feature selection in the process of data collection." ;
          ex:hierarchyID "13.7.3" ;
          ex:pcfID "20960" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "R5 de-conflation: the bounded 'develop hypotheses' act is modeled here; the 'manage' aspect is the standing analytics function carried by ex:AnalyticsCapability (this act is one of its realized-in fillers), not a separate conflated occurrent. Anchored to ex:ActOfAnalysis (under cco:ont00000366 Act of Information Processing): a hypothesis-forming act composes a descriptive account of empirical data, not a directive plan. Per the GOLDEN PRINCIPLE the Info-Processing genus agrees with the Descriptive output ex:Hypothesis (a candidate account of how reality is). REJECTED ex:ActOfFormulation (cco:ont00000511 Act of Planning): a Planning/Directive genus would contradict the descriptive output." ;
          rdfs:label "Develop and manage hypotheses" ;
          skos:definition "An Act of Information Processing that composes and frames the hypotheses explaining empirical data, producing a hypothesis used to guide feature selection during data collection." ;
          skos:example "A data scientist frames a testable hypothesis about which features drive customer churn." .


###  http://example.org/apqc#P20961
ex:P20961 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AnalyticsDataset
                          ] ;
          ex:apqcSourceText "Gathering and harvesting structured and unstructured data from disparate sources. Clean and pre-process data. Remove duplicates. Convert to a uniform format to make records comparable." ;
          ex:hierarchyID "13.7.4" ;
          ex:pcfID "20961" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to ex:ActOfAcquisition (reused from apqc-ext, under cco:ont00000228 Planned Act): the differentiating step is obtaining data the organization did not previously hold from disparate sources. DISPOSITIONED Act of Information Processing (cco:ont00000366): the clean/dedup/normalize sub-steps are information processing, but the dominant act-kind is acquisition (gather/harvest from sources); the consolidation is a method sub-step. Output is the descriptive ex:AnalyticsDataset." ;
          rdfs:label "Collect data" ;
          skos:definition "An Act of Acquisition that gathers and harvests structured and unstructured data from disparate sources and cleans, deduplicates, and normalizes it into an analytics dataset." ;
          skos:example "An ETL pipeline pulls and normalizes transaction logs from three source systems." .


###  http://example.org/apqc#P20962
ex:P20962 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PreparedDataset
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DataAnalysisResult
                          ] ;
          ex:apqcSourceText "Conducting data analysis. Choose statistical algorithms that best reveal patterns and trends in the data. Compare with hypotheses and time series forecasts. Determine error rates and significant outliers." ;
          ex:hierarchyID "13.7.6" ;
          ex:pcfID "20962" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to ex:ActOfAnalysis (under cco:ont00000366): the canonical analysis act of the group. Input is the prepared dataset (definitional); output is the descriptive ex:DataAnalysisResult. Mirrors the Appendix-A AnalyzeCompetitors pattern." ;
          rdfs:label "Analyze data" ;
          skos:definition "An Act of Analysis that applies statistical algorithms to a prepared dataset to reveal patterns, trends, error rates, and outliers and produces a data analysis result." ;
          skos:example "A data scientist runs regression and clustering over the prepared data to surface churn drivers." .


###  http://example.org/apqc#P20963
ex:P20963 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DataAnalysisResult
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AnalysisReport
                          ] ;
          ex:apqcSourceText "Summarizing and documenting the results of data analysis. Create graphs and visualizations to illustrate numerical findings to make them more accessible to readers." ;
          ex:hierarchyID "13.7.10" ;
          ex:pcfID "20963" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): assembling and documenting analysis results into a Descriptive ICE. DISPOSITIONED cco:ont00000402 'Act of Communication': the dominant act here is composing/documenting the report (information processing); dissemination to readers is a downstream/typical facet. Input is the data analysis result; output is the descriptive ex:AnalysisReport." ;
          rdfs:label "Report on analysis" ;
          skos:definition "An Act of Information Processing that summarizes and documents the results of data analysis, including graphs and visualizations, and produces an analysis report." ;
          skos:example "An analyst compiles the findings into a visual report for the business sponsor." .


###  http://example.org/apqc#P20964
ex:P20964 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RemedialActionSpecification
                          ] ;
          ex:apqcSourceText "Determining the steps that need to be taken to correct the shortcomings." ;
          ex:hierarchyID "13.7.11" ;
          ex:pcfID "20964" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation, NOT ex:ActOfIdentification, despite the 'Identify' label: the source 'Determining the STEPS that need to be taken to correct the shortcomings' composes a prescription of corrective steps, and its output ex:RemedialActionSpecification is Directive. Anchoring under the descriptive ex:ActOfIdentification would pair a descriptive genus with a Directive output and violate the GOLDEN PRINCIPLE; the formulation genus agrees with the directive output." ;
          rdfs:label "Identify remedial actions" ;
          skos:definition "An Act of Formulation that determines the steps required to correct identified shortcomings and produces a remedial action specification prescribing them." ;
          skos:example "A team specifies the corrective steps to address the data-quality gaps the analysis revealed." .


###  http://example.org/apqc#P20965
ex:P20965 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11114
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11115
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20966
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20967
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20968
                          ] ;
          ex:apqcSourceText "Creating knowledge bases and other repositories to preserve and develop company expertise, and to train new employees." ;
          ex:hierarchyID "13.5.3" ;
          ex:pcfID "20965" ;
          ex:requiresCapability ex:KnowledgeManagementCapability ;
          rdfs:comment "Anchored at cco:ont00000228 (Planned Act): an aggregate build-and-deploy effort spanning formulation, implementation, and improvement sub-acts; no single act genus dominates, and its APQC children are process parts, not subclasses." ;
          rdfs:label "Design and implement KM capabilities" ;
          skos:definition "A Planned Act that designs and then puts into operation the knowledge bases, approaches, and supporting technology that preserve and develop an organization's expertise." ;
          skos:example "A KM program builds a new expertise repository and rolls it out to a business unit." .


###  http://example.org/apqc#P20966
ex:P20966 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:KMResourceModel
                          ] ;
          ex:apqcSourceText "Creating a model to describe resources and approaches to organization's knowledge management. Establish standards and guidelines to be followed." ;
          ex:hierarchyID "13.5.3.2" ;
          ex:pcfID "20966" ;
          rdfs:comment "Output is a Directive ICE (resource model with standards/guidelines) per the GOLDEN PRINCIPLE." ;
          rdfs:label "Design resource model for KM approaches" ;
          skos:definition "An Act of Formulation that composes a KM resource model prescribing the resources, standards, and guidelines that the organization's KM approaches will follow." ;
          skos:example "A KM architect models the staffing, tooling, and content resources required for each KM approach." .


###  http://example.org/apqc#P20967
ex:P20967 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfImprovement ;
          ex:apqcSourceText "Using existing technologies to improve organization's knowledge management processes. Research available third-party offerings. Develop proprietary solutions. Employ knowledge engineers, data scientists and other relevant personnel." ;
          ex:hierarchyID "13.5.3.4" ;
          ex:pcfID "20967" ;
          rdfs:comment "Anchored to ex:ActOfImprovement (PROPOSE-EXT): the act augments existing IT for a better-than-prior KM process state. Researching third-party offerings and employing specialists are typical methods, noted here rather than as restrictions." ;
          rdfs:label "Leverage and enhance IT for KM approaches" ;
          skos:definition "An Act of Improvement that uses and enhances existing information technology in order to raise the performance of an organization's knowledge-management processes." ;
          skos:example "A KM engineering team integrates a third-party search platform to speed knowledge retrieval." .


###  http://example.org/apqc#P20968
ex:P20968 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceIndicatorSpecification
                          ] ;
          ex:apqcSourceText "Creating metrics that can be used to systematically describe KM approaches and capabilities. Choose applicable scales, benchmarks and units of measure. Determine required precision and error rates." ;
          ex:hierarchyID "13.5.3.5" ;
          ex:pcfID "20968" ;
          rdfs:comment "Establishing metrics yields a Directive ICE (a specification of indicators) per the GOLDEN PRINCIPLE; parallels ex:P11109." ;
          rdfs:label "Develop measures" ;
          skos:definition "An Act of Formulation that establishes and prescribes a performance-indicator specification of the metrics, scales, benchmarks, and units used to describe KM approaches and capabilities." ;
          skos:example "A KM analyst defines the measurement scales and precision targets for KM capability metrics." .


###  http://example.org/apqc#P20969
ex:P20969 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11113
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20970
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20971
                          ] ;
          ex:apqcSourceText "Developing resources for improved knowledge management and knowledge engineering." ;
          ex:hierarchyID "13.5.4" ;
          ex:pcfID "20969" ;
          ex:requiresCapability ex:KnowledgeManagementCapability ;
          rdfs:comment "Anchored at cco:ont00000228 (Planned Act): an aggregate of enhancement, sustainment, and expansion sub-acts; no single act genus dominates, and its APQC children are process parts, not subclasses." ;
          rdfs:label "Evolve and sustain KM capabilities" ;
          skos:definition "A Planned Act that develops and augments resources in order to improve and sustain an organization's knowledge-management and knowledge-engineering capabilities over time." ;
          skos:example "A KM program runs a continuous-improvement cycle that upgrades repositories and grows usage." .


###  http://example.org/apqc#P20970
ex:P20970 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:KMAwarenessCommunication
                          ] ;
          ex:apqcSourceText "Developing awareness about available knowledge bases and promoting their use to maximize their impact." ;
          ex:hierarchyID "13.5.4.2" ;
          ex:pcfID "20970" ;
          ex:requiresRole ex:StakeholderRole ;
          rdfs:comment "RE-ANCHORED from ex:ActOfImplementation to cco:ont00000402 (Act of Communication, VERIFIED §6: transfers an ICE from one Agent to another; parent cco:ont00000228 Planned Act). Source text -- 'Developing awareness about available knowledge bases and promoting their use to maximize their impact' -- describes a PROMOTION / awareness-raising act whose essence is communication, not the neutral execution of a directive. Rejected candidate ex:ActOfImplementation: a false-friend genus (the prior 'operationalizing the communication plan' framing buried the communicative act-kind) and a D5 reuse miss. Added a has-output (ex:KMAwarenessCommunication) and an audience participant so the communicative content and recipients are visible. R5: read as repeatable bounded promotion campaigns (each campaign has a begin/end) realizing the standing engagement function, not as a single open-ended occurrent. Explicit cco:ont00000228 co-parent gives Gate C the Act anchor without the CCO closure." ;
          rdfs:label "Sustain awareness and engagement" ;
          skos:definition "An Act of Communication that develops awareness of available knowledge bases and promotes their use across the organization, producing awareness messaging directed at the organization's members in order to maximize the knowledge bases' impact." ;
          skos:example "A KM team runs an internal campaign encouraging staff to contribute to and consult the knowledge base." .


###  http://example.org/apqc#P20971
ex:P20971 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfImprovement ;
          ex:apqcSourceText "Augmenting available resources to better leverage the offerings of the organization to serve existing clients and to expand the client base." ;
          ex:hierarchyID "13.5.4.3" ;
          ex:pcfID "20971" ;
          rdfs:comment "Anchored to ex:ActOfImprovement (PROPOSE-EXT): augmenting resources to a greater-than-prior capacity. Target may be material (servers, storage) or informational; modeled generically as improvement." ;
          rdfs:label "Expand KM infrastructure to meet demand" ;
          skos:definition "An Act of Improvement that augments the available knowledge-management infrastructure and resources in order to increase capacity to serve existing and new clients." ;
          skos:example "A KM operations team adds storage and indexing capacity ahead of a surge in knowledge-base usage." .


###  http://example.org/apqc#P21421
ex:P21421 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:MarketData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:GoNoGoDecision
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SubstitutionBusinessCase
                          ] ;
          ex:apqcSourceText "Examining if there are other existing products or services in the marketplace, and building the business case to make a go/no go decision based upon substitutions." ;
          ex:hierarchyID "1.1.1.3" ;
          ex:pcfID "21421" ;
          rdfs:comment "Re-anchored (Gate-F) from cco:ont00000636 (Act of Appraisal) to ex:ActOfSelection: the source builds a business case in order to 'make a go/no go decision', and the definitional output is the Directive ex:GoNoGoDecision (a chosen-option commitment), which the Golden Principle ties to a Selection act, not an Appraisal. This supersedes the 1.1.1 reference module's Act-of-Appraisal + dual-output model (the Selection genus is the cleaner anchor for an act culminating in a decision). The source explicitly says the act is 'building the business case to make a go/no go decision', so ex:SubstitutionBusinessCase is restored as a SECOND (Descriptive) has-output produced by this act en route to the decision -- a Selection act may carry a secondary descriptive output -- rather than demoted to prose; this answers the CQ 'what document supports the substitution go/no-go?'. Was ex:EvaluateSubstituteProducts in the GOLD module." ;
          rdfs:label "Identify potential product or service alternatives" ;
          skos:definition "An Act of Selection that examines substitute products or services on the market and produces a go/no-go decision on the alternative." ;
          skos:example "A product team weighs a substitute on the market and commits to a no-go decision." .


###  http://example.org/apqc#P21422
ex:P21422 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceRecord
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceReport
                          ] ;
          ex:apqcSourceText "Periodic review of initiatives based performance, conditions, and marketplace response." ;
          ex:hierarchyID "1.3.6" ;
          ex:pcfID "21422" ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): a periodic review judges execution. Repeatable occurrence with identifiable begin/end each cycle." ;
          rdfs:label "Review execution of strategic initiatives" ;
          skos:definition "An Act of Appraisal that periodically judges the execution of strategic initiatives against performance, conditions, and marketplace response and produces a performance report." ;
          skos:example "A quarterly steering review assesses how the executed initiatives are performing." .


###  http://example.org/apqc#P21423
ex:P21423 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceReport
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StrategicInitiativeSpecification
                          ] ;
          ex:apqcSourceText "Performing required updates to strategic initiatives based upon changes in the marketplace or performance." ;
          ex:hierarchyID "1.3.7" ;
          ex:pcfID "21423" ;
          rdfs:comment "Anchored to ex:ActOfFormulation (under cco:ont00000511): re-formulating a plan is planning. Input is the performance report that triggers the revision." ;
          rdfs:label "Refine strategic initiatives and project plans as needed" ;
          skos:definition "An Act of Formulation that revises strategic initiatives and project plans in response to marketplace or performance changes and produces an updated strategic-initiative specification." ;
          skos:example "After a downturn, the team rewrites two initiatives' project plans to fit the new market." .


###  http://example.org/apqc#P21424
ex:P21424 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfForecasting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:CustomerData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PurchasingForecast
                          ] ;
          ex:apqcSourceText "Using customer segmentation tools to examine past customer behavior to predict future purchasing patterns." ;
          ex:hierarchyID "3.1.1.1.2" ;
          ex:pcfID "21424" ;
          rdfs:comment "Anchored to ex:ActOfForecasting (PROPOSE-EXT, under cco:ont00000371 Act of Prediction) because the output is a Predictive ICE about uncertain future behavior, satisfying the GOLDEN PRINCIPLE for predictive output." ;
          rdfs:label "Predict customer purchasing behavior" ;
          skos:definition "An Act of Forecasting that has as input customer data and has as output a customer purchasing forecast that describes expected future purchasing patterns of a customer segment." ;
          skos:example "A team applies segmentation tools to historical data and forecasts next-quarter purchasing." .


###  http://example.org/apqc#P21425
ex:P21425 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:GoToMarketStrategy
                          ] ;
          ex:apqcSourceText "Creation of a plan detailing how a company plans to execute a successful product release and promotion, and ultimately its sale to customers." ;
          ex:hierarchyID "3.3.8" ;
          ex:pcfID "21425" ;
          rdfs:comment "Directive output (a go-to-market strategy) agrees with the planning genus." ;
          rdfs:label "Develop go-to-market strategy" ;
          skos:definition "An Act of Formulation that composes a go-to-market strategy detailing how an offering will be released, promoted, and sold to customers." ;
          skos:example "A product team writes the go-to-market plan for a new product launch." .


###  http://example.org/apqc#P21427
ex:P21427 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrder
                          ] ;
          ex:apqcSourceText "Execution of sales at physical / brick and mortar locations." ;
          ex:hierarchyID "3.5.6" ;
          ex:pcfID "21427" ;
          rdfs:label "Perform sales at physical outlets" ;
          skos:definition "An Act of Selling that executes sales of an organization's products or services at physical, brick-and-mortar locations." ;
          skos:example "A retail associate completes a sale at a store checkout." .


###  http://example.org/apqc#P21428
ex:P21428 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrder
                          ] ;
          ex:apqcSourceText "Execution of sales within field/remote locations.  This could be any location that is not part of a headquarters location." ;
          ex:hierarchyID "3.5.7" ;
          ex:pcfID "21428" ;
          rdfs:label "Perform field sales" ;
          skos:definition "An Act of Selling that executes sales of an organization's products or services at field or remote locations away from a headquarters." ;
          skos:example "A field rep closes a sale at a customer's site." .


###  http://example.org/apqc#P21429
ex:P21429 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelling ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:SalesOrder
                          ] ;
          ex:apqcSourceText "Execution of sales in an online environment." ;
          ex:hierarchyID "3.5.8" ;
          ex:pcfID "21429" ;
          rdfs:label "Perform digital sales" ;
          skos:definition "An Act of Selling that executes sales of an organization's products or services in an online environment." ;
          skos:example "A customer completes a purchase through the organization's e-commerce site." .


###  http://example.org/apqc#P21430
ex:P21430 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRProgramSpecification
                          ] ;
          ex:apqcSourceText "Establishing the roles that are required to execute the HR function.  This process also examines the organizational structure required to support the organization." ;
          ex:hierarchyID "7.1.1.3" ;
          ex:pcfID "21430" ;
          rdfs:comment "Genus is Act of Formulation: output prescribes roles and structure (Directive ICE)." ;
          rdfs:label "Determine HR function roles and structure" ;
          skos:definition "An Act of Formulation that produces an HR program specification establishing the roles and supporting organizational structure required to execute the human resources function." ;
          skos:example "HR defines the role set and reporting structure needed to run the HR function." .


###  http://example.org/apqc#P21431
ex:P21431 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRDeliveryModel
                          ] ;
          ex:apqcSourceText "Determining how an organization's human resources department offers services to and interacts with employees." ;
          ex:hierarchyID "7.1.1.4" ;
          ex:pcfID "21431" ;
          rdfs:comment "Genus is Act of Formulation: output is a prescriptive delivery-model specification (Directive ICE)." ;
          rdfs:label "Determine HR delivery model" ;
          skos:definition "An Act of Formulation that produces an HR delivery model prescribing how the human resources department delivers services to and interacts with employees." ;
          skos:example "HR adopts a shared-services-plus-business-partner delivery model." .


###  http://example.org/apqc#P21433
ex:P21433 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DiversityEquityInclusionPlan
                          ] ;
          ex:apqcSourceText "Execution of diversity, equity, and inclusion plans within an organization.  Often called a DEI plan." ;
          ex:hierarchyID "7.1.2.7" ;
          ex:pcfID "21433" ;
          rdfs:comment "Anchored at cco:ont00000228 (Planned Act): implementation is the execution of a held Directive ICE (the DEI plan), not the formulation of a new directive (GOLDEN PRINCIPLE -- no formulation output)." ;
          rdfs:label "Implement diversity, equity, and inclusion plan" ;
          skos:definition "A Planned Act that has as input a diversity, equity, and inclusion plan and carries out that plan within the organization." ;
          skos:example "HR rolls out the DEI plan's hiring and inclusion initiatives across business units." .


###  http://example.org/apqc#P21434
ex:P21434 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:PerformanceObjective
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PerformanceAppraisal
                          ] ;
          ex:apqcSourceText "Execution of employee reviews/performance on a frequent basis." ;
          ex:hierarchyID "7.3.2.2" ;
          ex:pcfID "21434" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeePerformanceManagementCapability ;
          rdfs:comment "Appraisal genus with a Descriptive output (PerformanceAppraisal) per GOLDEN PRINCIPLE." ;
          rdfs:label "Review employee performance" ;
          skos:definition "An Act of Appraisal that has as input performance data and performance objectives and has as output a performance appraisal of an employee." ;
          skos:example "A manager conducts a mid-year review and records the employee's appraisal." .


###  http://example.org/apqc#P21436
ex:P21436 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:LearningProgramEvaluation
                          ] ;
          ex:apqcSourceText "Oversight of the organization's learning programs. This process also includes the effectiveness of these programs." ;
          ex:hierarchyID "7.3.4.7" ;
          ex:pcfID "21436" ;
          ex:requiresCapability ex:EmployeeDevelopmentCapability ,
                                ex:EmployeeTrainingCapability ;
          rdfs:comment "Appraisal (monitor/evaluate effectiveness); Descriptive output per GOLDEN PRINCIPLE." ;
          rdfs:label "Monitor and evaluate learning programs" ;
          skos:definition "An Act of Appraisal that oversees and judges the coverage and effectiveness of an organization's learning programs and has as output a learning program evaluation." ;
          skos:example "L&D reports quarterly on which training programs are delivering measurable skill gains." .


###  http://example.org/apqc#P21437
ex:P21437 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:LegalAndRegulatoryRequirements
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:RegulatoryEnvironmentAssessment
                          ] ;
          ex:apqcSourceText "Awareness of the employee legislature that is in place for the organization. The regulatory environment could include areas, regions, or countries." ;
          ex:hierarchyID "7.4.5" ;
          ex:pcfID "21437" ;
          ex:requiresCapability ex:EmployeeRelationsCapability ;
          rdfs:comment "Genus is ex:ActOfAnalysis (Act of Information Processing): monitoring is the examination of regulatory inputs to yield awareness. Per the GOLDEN PRINCIPLE the output is a Descriptive ICE (ex:RegulatoryEnvironmentAssessment represents the regulatory state, it does not prescribe). Input ex:LegalAndRegulatoryRequirements and the descriptive output are definitional." ;
          rdfs:label "Monitor legal and regulatory environment" ;
          skos:definition "An Act of Analysis that examines the employment-related legal and regulatory requirements in force across the jurisdictions relevant to an organization and produces an assessment describing the current regulatory environment." ;
          skos:example "An HR compliance team reviews labor-law changes across its operating regions and circulates a regulatory-awareness brief." .


###  http://example.org/apqc#P21438
ex:P21438 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:HumanResourcesProfessional
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10498
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10499
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10500
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10501
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10502
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10503
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10510
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10511
                          ] ;
          ex:apqcSourceText "Developing a salary/compensation structure and plan; developing a benefits and reward plan; develop commission plan; performing competitive analyses of benefits and rewards; identifying compensation requirements based on compensation, benefits, and HR policies; administering compensation, commission, and rewards to employees; and rewarding and motivating employees." ;
          ex:hierarchyID "7.5.1" ;
          ex:pcfID "21438" ;
          ex:requiresCapability ex:CompensationAndBenefitsCapability ;
          ex:requiresRole ex:HumanResourcesProfessionalRole ;
          rdfs:comment "Models APQC 7.5.1 as a bounded, recurring administrative procedure; its APQC children are process parts, not subclasses." ;
          rdfs:label "Develop and manage reward, recognition, and motivation programs" ;
          skos:definition "An Act of Administration that develops and manages an organization's reward, recognition, and motivation programs, comprising the formulation of compensation and benefits plans and the administration of compensation and rewards to employees." ;
          skos:example "An HR compensation team's annual cycle of refreshing the pay structure and benefits plan and administering rewards." .


###  http://example.org/apqc#P21439
ex:P21439 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:HumanResourcesProfessional
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10508
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10509
                          ] ;
          ex:apqcSourceText "Managing activities centered around delivering programs to support work/life balance for employees; developing family support systems; reviewing retention and motivation indicators; and reviewing compensation plans." ;
          ex:hierarchyID "7.5.3" ;
          ex:pcfID "21439" ;
          ex:requiresCapability ex:CompensationAndBenefitsCapability ;
          ex:requiresRole ex:HumanResourcesProfessionalRole ;
          rdfs:comment "Models APQC 7.5.3 as a bounded, recurring administrative procedure; its APQC children are process parts, not subclasses." ;
          rdfs:label "Manage employee assistance and retention" ;
          skos:definition "An Act of Administration that manages employee assistance and retention by delivering work/life-balance programs and developing family support systems." ;
          skos:example "An HR well-being team operates the work/life-balance and family-support programs for a benefit year." .


###  http://example.org/apqc#P21440
ex:P21440 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAdministration ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Employee
                          ] ;
          ex:apqcSourceText "Creation and execution of a plan that might allow for work from home days, or alternate hours." ;
          ex:hierarchyID "7.5.3.1.1" ;
          ex:pcfID "21440" ;
          ex:requiresRole ex:EmployeeRole ;
          rdfs:comment "The flexible-working plan is created and then executed within this act; as both an intermediate artifact and operational provisioning, the plan is recorded here rather than as a restriction." ;
          rdfs:label "Manage flexible working" ;
          skos:definition "An Act of Administration that creates and executes a flexible-working plan permitting arrangements such as work-from-home days or alternate hours." ;
          skos:example "A manager sets up and runs a hybrid work-from-home schedule for the team." .


###  http://example.org/apqc#P21441
ex:P21441 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21442
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21443
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21444
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21445
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21446
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StakeholderRequirements
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ;
          ex:apqcSourceText "Understand, develop, and gather workforce data in support of stakeholder requirements." ;
          ex:hierarchyID "7.7.7" ;
          ex:pcfID "21441" ;
          ex:requiresCapability ex:WorkforceAnalyticsCapability ;
          rdfs:comment "Re-anchored from ex:ActOfAnalysis to ex:ActOfAcquisition (Planned Act: obtaining workforce data the function did not previously hold). REJECTED ex:ActOfAnalysis: neither the source ('Understand, develop, and gather workforce data in support of stakeholder requirements') nor the modeling is an analysis -- ex:ActOfAnalysis is defined as examining input ICEs to produce 'an ICE that represents an understanding of their subject matter', whereas the output ex:WorkforceData is a raw gathered dataset, not an understanding. The genus was driven by the label word 'analytics'. None of its five process-part children is an analysis act (21442/21443/21445 Identification, 21444 Selection, 21446 Acquisition); the actual analysis facet is realized by the SIBLING P21447 (Implement workforce analytics). This is a scoping-and-data-gathering aggregate. Output ex:WorkforceData retained. Its APQC children (21442-21446) are process parts, not subclasses." ;
          rdfs:label "Develop workforce analytics" ;
          skos:definition "An Act of Acquisition that scopes, sources, and gathers workforce data in support of stakeholder requirements and produces a body of workforce data for analytics." ;
          skos:example "A people-analytics team turns leadership's questions into a sourced, gathered workforce dataset ready for analysis." .


###  http://example.org/apqc#P21442
ex:P21442 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StakeholderRequirements
                          ] ;
          ex:apqcSourceText "Collect and manage requirements from various enterprise stakeholders about workforce analytics." ;
          ex:hierarchyID "7.7.7.1" ;
          ex:pcfID "21442" ;
          ex:requiresRole ex:StakeholderRole ;
          rdfs:comment "Anchored to ex:ActOfIdentification (information processing): the act discerns and registers requirements. Output ex:StakeholderRequirements is Descriptive (it records what stakeholders need)." ;
          rdfs:label "Determine stakeholder requirements" ;
          skos:definition "An Act of Identification that collects and discerns workforce-analytics requirements from enterprise stakeholders and produces a stakeholder-requirements record." ;
          skos:example "An analyst interviews HR, finance, and operations leaders and consolidates their workforce-analytics requirements." .


###  http://example.org/apqc#P21443
ex:P21443 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StakeholderRequirements
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ResearchQuestion
                          ] ;
          ex:apqcSourceText "Summarize stakeholder requirements into discrete research questions in support of workforce analytics." ;
          ex:hierarchyID "7.7.7.2" ;
          ex:pcfID "21443" ;
          rdfs:comment "Anchored to ex:ActOfIdentification (information processing): the act discerns and enumerates research questions. Input ex:StakeholderRequirements; output ex:ResearchQuestion is Descriptive." ;
          rdfs:label "Identify research questions" ;
          skos:definition "An Act of Identification that summarizes stakeholder requirements into discrete research questions and produces a research question." ;
          skos:example "Requirements about attrition risk are restated as the question 'which factors predict voluntary turnover within 12 months?'." .


###  http://example.org/apqc#P21444
ex:P21444 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ResearchQuestion
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StakeholderRequirements
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceAnalysisMethodology
                          ] ;
          ex:apqcSourceText "Consider stakeholder requirements, research questions, and organizations standards around research to select appropriate research methodology in support of workforce analytics." ;
          ex:hierarchyID "7.7.7.3" ;
          ex:pcfID "21444" ;
          rdfs:comment "Anchored to ex:ActOfSelection: a methodology is chosen from candidates. Output ex:WorkforceAnalysisMethodology is Directive (it prescribes how the analysis is to be conducted), so selection (directive output) satisfies the GOLDEN PRINCIPLE." ;
          rdfs:label "Select workforce analysis methodology" ;
          skos:definition "An Act of Selection that chooses an appropriate research methodology from candidate approaches in light of stakeholder requirements and research questions and produces a workforce analysis methodology." ;
          skos:example "Given the turnover question, the team selects a survival-analysis methodology over simple cross-tabulation." .


###  http://example.org/apqc#P21445
ex:P21445 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ;
          ex:apqcSourceText "Identify appropriate data sources for workforce analytics data while considering organizational standards for data sources." ;
          ex:hierarchyID "7.7.7.4" ;
          ex:pcfID "21445" ;
          rdfs:comment "Anchored to ex:ActOfIdentification (information processing): the act discerns and registers suitable data sources. Phase-3: the output (a register of identified workforce data sources) is left in this comment rather than promoted to a has-output restriction because no shared ICE filler exists for it and minting one is not warranted for this leaf." ;
          rdfs:label "Identify workforce data sources" ;
          skos:definition "An Act of Identification that discerns the appropriate data sources for workforce-analytics data in light of organizational data-source standards." ;
          skos:example "The team confirms the HRIS, payroll, and an external benchmarking feed as the approved sources for the study." .


###  http://example.org/apqc#P21446
ex:P21446 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAcquisition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ;
          ex:apqcSourceText "Collect and procure, as needed, workforce data from internal and external data sources in support of workforce analytics." ;
          ex:hierarchyID "7.7.7.5" ;
          ex:pcfID "21446" ;
          rdfs:comment "Anchored to ex:ActOfAcquisition (Planned Act): the act obtains workforce data the analytics function did not previously hold (collected or purchased). Output ex:WorkforceData is the descriptive data so obtained. Rejected ex:ActOfAdministration because the emphasis is on procuring new data, not maintaining existing records." ;
          rdfs:label "Gather workforce data" ;
          skos:definition "An Act of Acquisition that collects and procures workforce data from internal and external sources and produces a body of workforce data." ;
          skos:example "The team extracts internal HRIS records and purchases an external labor-market dataset for the analysis." .


###  http://example.org/apqc#P21447
ex:P21447 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21448
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21449
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21450
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceAnalysis
                          ] ;
          ex:apqcSourceText "Transform, develop, and communicate workforce data into analytics in support of organizational requirements." ;
          ex:hierarchyID "7.7.8" ;
          ex:pcfID "21447" ;
          ex:requiresCapability ex:WorkforceAnalyticsCapability ;
          rdfs:comment "Anchored to ex:ActOfAnalysis (information processing): input workforce data is manipulated into an analytic representation. Its APQC children (21448-21450) are process parts, not subclasses." ;
          rdfs:label "Implement workforce analytics" ;
          skos:definition "An Act of Analysis that transforms workforce data, develops insights, and communicates them, producing a workforce analysis in support of organizational requirements." ;
          skos:example "The people-analytics team validates the dataset, models attrition drivers, and briefs leadership on the findings." .


###  http://example.org/apqc#P21448
ex:P21448 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00001158 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ;
          ex:apqcSourceText "Logically and statistically validate collected or purchased data in support of analytics needs" ;
          ex:hierarchyID "7.7.8.1" ;
          ex:pcfID "21448" ;
          rdfs:comment "Reuses CCO cco:ont00001158 (Act of Data Transformation) directly: input ICEs are validated/cleaned into output ICEs. Input and output are ex:WorkforceData (the dataset before and after validation), Descriptive throughout." ;
          rdfs:label "Transform workforce analysis data" ;
          skos:definition "An Act of Data Transformation that logically and statistically validates collected or purchased workforce data and produces validated workforce data." ;
          skos:example "The analyst removes duplicates, checks ranges, and runs validation statistics on the gathered dataset." .


###  http://example.org/apqc#P21449
ex:P21449 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforceData
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:WorkforceAnalysis
                          ] ;
          ex:apqcSourceText "Synthesize insights from workforce analytics data" ;
          ex:hierarchyID "7.7.8.2" ;
          ex:pcfID "21449" ;
          rdfs:comment "Anchored to ex:ActOfAnalysis (information processing): the act manipulates the validated dataset into an analytic representation. Input ex:WorkforceData; output ex:WorkforceAnalysis is Descriptive." ;
          rdfs:label "Develop insights into workforce analytics outcomes" ;
          skos:definition "An Act of Analysis that synthesizes insights from validated workforce-analytics data and produces a workforce analysis." ;
          skos:example "From the validated data the team derives the finding that overtime intensity predicts attrition in two units." .


###  http://example.org/apqc#P21450
ex:P21450 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000402 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:WorkforceAnalysis
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:HRReport
                          ] ;
          ex:apqcSourceText "Summarize, package, and distribute results of workforce analysis." ;
          ex:hierarchyID "7.7.8.3" ;
          ex:pcfID "21450" ;
          ex:requiresRole ex:StakeholderRole ;
          rdfs:comment "Reuses CCO cco:ont00000402 (Act of Communication): an Information Content Entity (the packaged workforce analysis) is transferred from the analytics team to recipients. Input ex:WorkforceAnalysis; output ex:HRReport (the packaged, distributed result), Descriptive." ;
          rdfs:label "Communicate workforce analysis outcomes" ;
          skos:definition "An Act of Communication that summarizes and packages a workforce analysis and distributes it to its recipients as an HR report." ;
          skos:example "The team turns the analysis into a dashboard and briefing deck and distributes it to the requesting leaders." .


###  http://example.org/apqc#P21452
ex:P21452 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProcessControlPointSpecification
                          ] ;
          ex:apqcSourceText "Establishment of a \"checkpoint\" in a process that prevent the process from continuing unless all requirements are satisfied." ;
          ex:hierarchyID "13.1.3.3" ;
          ex:pcfID "21452" ;
          rdfs:comment "Anchored to ex:ActOfFormulation: a control-point specification is a Directive ICE that prescribes a gating rule." ;
          rdfs:label "Identify and denote process control points" ;
          skos:definition "An Act of Formulation that establishes checkpoints within a process and produces a process control point specification gating continuation on satisfied requirements." ;
          skos:example "A team designates an approval gate that halts the process until compliance checks pass." .


###  http://example.org/apqc#P21453
ex:P21453 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfImprovement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11138
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16397
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16398
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P16399
                          ] ;
          ex:apqcSourceText "Identifying, selecting, and managing improvements. Based on the type and scope of the improvement, determination of the appropriate improvement methodology (e.g., Lean, Six Sigma, etc.) should guide the effort. This includes continuous improvement, process redesign, process reengineering, and application of the organizations approaches for Manage projects." ;
          ex:hierarchyID "13.1.5" ;
          ex:pcfID "21453" ;
          ex:requiresCapability ex:BusinessProcessManagementCapability ;
          rdfs:comment "Anchored to ex:ActOfImprovement: the act changes existing processes to optimize them. Its APQC children are process parts." ;
          rdfs:label "Improve processes" ;
          skos:definition "An Act of Improvement that identifies, selects, and manages modifications to an organization's business processes so as to raise their efficiency and effectiveness." ;
          skos:example "A continuous-improvement program runs Lean and Six Sigma initiatives across the process portfolio." .


###  http://example.org/apqc#P21454
ex:P21454 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfSelection ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProjectPortfolioSelection
                          ] ;
          ex:apqcSourceText "Stack ranking of projects in the portfolio based upon preestablished criteria." ;
          ex:hierarchyID "13.2.3.1.6" ;
          ex:pcfID "21454" ;
          rdfs:comment "Anchored to ex:ActOfSelection (reused): chooses/prioritizes from candidate projects, yielding a Directive decision ICE (the selection/prioritization)." ;
          rdfs:label "Prioritize and select projects for the portfolio" ;
          skos:definition "An Act of Selection that stack-ranks and chooses the projects for the portfolio against preestablished criteria and produces a project portfolio selection." ;
          skos:example "A portfolio board ranks and selects which projects to fund this cycle." .


###  http://example.org/apqc#P21455
ex:P21455 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProgramManager
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProjectReviewRecord
                          ] ;
          ex:apqcSourceText "Hold post project reviews, lessons learned, or After Action Reviews (AARs) at the end of each project to understand what could be improved during future projects." ;
          ex:hierarchyID "13.2.3.4.5" ;
          ex:pcfID "21455" ;
          ex:requiresRole ex:ProgramManagerRole ,
                          ex:StakeholderRole ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): a review judges what worked and what could improve; output is the Descriptive ex:ProjectReviewRecord. Program managers and stakeholders are definitional participants." ;
          rdfs:label "Conduct Project Reviews with Program Managers and other stakeholders" ;
          skos:definition "An Act of Appraisal that conducts a post-project or after-action review with program managers and stakeholders and produces a project review record of lessons learned." ;
          skos:example "A team holds an after-action review and records lessons for future projects." .


###  http://example.org/apqc#P21456
ex:P21456 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfImprovement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:ProjectPlan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ProjectPlan
                          ] ;
          ex:apqcSourceText "Changes to project plans based upon internal and or external influences on the project.  This would include the update to the project plan file, as well as the communication to the team." ;
          ex:hierarchyID "13.2.3.4.7" ;
          ex:pcfID "21456" ;
          rdfs:comment "Anchored to ex:ActOfImprovement (under cco:ont00000228): it modifies an existing project plan rather than composing one de novo. Input and revised output are both ex:ProjectPlan; communication to the team is a typical sub-step." ;
          rdfs:label "Adjust project plan as needed" ;
          skos:definition "An Act of Improvement that makes required changes to an existing project plan in response to internal and external influences and produces the updated project plan." ;
          skos:example "A project manager updates the plan and notifies the team after a scope change." .


###  http://example.org/apqc#P21457
ex:P21457 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11139
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11140
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11141
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11142
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11143
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11144
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11145
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11146
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11147
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11148
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11149
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11150
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P11151
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20143
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20144
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:ChangeManagementPlan
                          ] ;
          ex:apqcSourceText "Evaluating impact and planning change activities. Spanning the lifecycle of change from initial concept, to designing, implementing, and sustaining the change, change planning identifies the activities to enage and enable the stakeholders and all impacted by the change. Change plans should address the interplay between people, process, technology, and knowledge to guide the transition, or tranformation, from current state to the future state." ;
          ex:hierarchyID "13.4.1" ;
          ex:pcfID "21457" ;
          ex:requiresCapability ex:ChangeManagementCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation (under cco:ont00000511 Act of Planning) because its definitional output is a Directive ICE (the change plan). APQC children are process parts." ;
          rdfs:label "Plan for change" ;
          skos:definition "An Act of Formulation that evaluates the impact of an intended change and composes a change management plan identifying the activities needed to engage stakeholders and guide the transition from current to future state." ;
          skos:example "A program team scopes a transformation, assesses readiness, and produces the change management plan." .


###  http://example.org/apqc#P21459
ex:P21459 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfIdentification ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:StakeholderNeedsStatement
                          ] ;
          ex:apqcSourceText "Gathering information from stakeholders prior to conducting analytics." ;
          ex:hierarchyID "13.7.1" ;
          ex:pcfID "21459" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          ex:requiresRole ex:StakeholderRole ;
          rdfs:comment "Anchored to ex:ActOfIdentification (discernment, under cco:ont00000366). REJECTED cco:ont00001261 'Act of Identifying' (a communication act of asserting who/what a thing is) per §6: 'Identify' here means discerning needs, i.e. information processing. Output is a Descriptive ICE." ;
          rdfs:label "Identify needs from stakeholders" ;
          skos:definition "An Act of Identification that gathers and discerns the needs of stakeholders prior to conducting analytics and produces a stakeholder needs statement." ;
          skos:example "An analytics team interviews business stakeholders and records their information needs." .


###  http://example.org/apqc#P21460
ex:P21460 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:StakeholderNeedsStatement
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:AnalyticsProjectScopeStatement
                          ] ;
          ex:apqcSourceText "Determining the size and scale of the project based upon the collected information and analytics." ;
          ex:hierarchyID "13.7.2" ;
          ex:pcfID "21460" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation: the definitional output (the scope statement) is a Directive ICE prescribing size/scale, so the formulation genus agrees with the directive output (GOLDEN PRINCIPLE). Input is the stakeholder needs statement." ;
          rdfs:label "Scope analytics project" ;
          skos:definition "An Act of Formulation that determines the size and scale of an analytics project from collected information and produces an analytics project scope statement." ;
          skos:example "A lead analyst sets the boundaries and resourcing of a churn-analysis project." .


###  http://example.org/apqc#P21461
ex:P21461 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000366 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:AnalyticsDataset
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PreparedDataset
                          ] ;
          ex:apqcSourceText "Creation and validation of data in order to initiate the process of analysis." ;
          ex:hierarchyID "13.7.5" ;
          ex:pcfID "21461" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): validation/preparation manipulates the collected dataset into an analysis-ready form. Genus is deliberately DISTINCT from sibling 20961 'Collect data' (ex:ActOfAcquisition): collection obtains the data; preparation validates/transforms data already held. Input is ex:AnalyticsDataset; output is the distinct ex:PreparedDataset." ;
          rdfs:label "Prepare data" ;
          skos:definition "An Act of Information Processing that creates and validates an analytics dataset so as to produce a prepared dataset fit to initiate analysis." ;
          skos:example "A data engineer validates and feature-engineers the collected dataset before modeling." .


###  http://example.org/apqc#P21462
ex:P21462 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DataModel
                          ] ;
          ex:apqcSourceText "Creation of conceptual and physical data models as an outline for data structure and storage." ;
          ex:hierarchyID "13.7.7" ;
          ex:pcfID "21462" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation: the output ex:DataModel is Directive (it prescribes required data structure/storage), so the formulation genus agrees with the directive output (GOLDEN PRINCIPLE). (If on review ex:DataModel were read as a descriptive representation, it would be re-anchored to cco:ont00000853 and this genus switched to analysis to preserve agreement.)" ;
          rdfs:label "Create data models" ;
          skos:definition "An Act of Formulation that composes conceptual and physical data models prescribing how data is to be structured and stored, producing a data model." ;
          skos:example "A data architect produces the conceptual and physical schema for the analytics store." .


###  http://example.org/apqc#P21463
ex:P21463 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000636 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:Stakeholder
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DataModel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DataModelReviewRecord
                          ] ;
          ex:apqcSourceText "Confirm data models represent the hypothesis supporting the original research question" ;
          ex:hierarchyID "13.7.8" ;
          ex:pcfID "21463" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          ex:requiresRole ex:StakeholderRole ;
          rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'review/confirm against the hypothesis' judges the models, distinct from the formulation genus of its create/refine siblings 21462/21464. Input is the data model; output is the descriptive ex:DataModelReviewRecord." ;
          rdfs:label "Review data models with stakeholders" ;
          skos:definition "An Act of Appraisal that reviews data models with stakeholders against the original research question and hypothesis and produces a data model review record." ;
          skos:example "The team confirms with stakeholders that the model captures the hypothesized relationships." .


###  http://example.org/apqc#P21464
ex:P21464 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfFormulation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:DataModelReviewRecord
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:DataModel
                          ] ;
          ex:apqcSourceText "Make required changes to data model based upon review with stakeholders." ;
          ex:hierarchyID "13.7.9" ;
          ex:pcfID "21464" ;
          ex:requiresCapability ex:AnalyticsCapability ;
          rdfs:comment "Anchored to ex:ActOfFormulation, aligned with sibling 21462 'Create data models' per sibling consistency (the create->review->refine triad: 21462 formulation, 21463 appraisal, 21464 formulation). Input is the data model review record; output is the revised Directive ex:DataModel." ;
          rdfs:label "Refine data models" ;
          skos:definition "An Act of Formulation that makes the required changes to a data model based on the stakeholder review and produces the revised data model." ;
          skos:example "The architect updates the schema to address the review findings." .


###  http://example.org/apqc#P21574
ex:P21574 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10918
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10919
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001921 ;
                            owl:someValuesFrom ex:InternalControlPolicy
                          ] ;
          ex:apqcSourceText "Performing planning, management, operations, and monitoring of internal control mechanism policies and procedures in order to manage internal controls." ;
          ex:hierarchyID "9.8.2" ;
          ex:pcfID "21574" ;
          ex:requiresCapability ex:InternalControlCapability ;
          rdfs:comment "Re-anchored from ex:ActOfMonitoring to cco:ont00000228 (Planned Act) as a composite OPERATE-and-monitor process. The source enumerates 'Performing planning, management, OPERATIONS, and monitoring of internal control mechanism' and the label leads with 'OPERATE controls': operating/running controls is a performative Planned Act, not an information-processing/observation act, so anchoring the whole as ex:ActOfMonitoring captured only the 'monitor' facet and silently dropped the dominant 'operate' facet. This is now consistent with the module's own treatment of the sibling child ex:P10919 ('Remediate'), which was pulled OUT of ex:ActOfMonitoring to cco:ont00000228 because executing a measure is not information-processing. The monitoring facet is carried by the has-process-part ex:P10918 (an ex:ActOfMonitoring that produces ex:ControlEffectivenessAssessment); the ex:ControlEffectivenessAssessment output is therefore NOT asserted as a definitional output of the whole composite (it is produced by the monitoring part, not by the operate-and-monitor process as a whole). Input ex:InternalControlPolicy is the control standard operated and monitored; definitional, so restricted. REJECTED candidate ex:ActOfMonitoring (would scope the whole to pure observation, dropping the operate facet)." ;
          rdfs:label "Operate controls and monitor compliance with internal controls policies and procedures" ;
          skos:definition "A Planned Act that operates an organization's internal-control mechanisms and monitors compliance with control policies and procedures, having as process parts the monitoring of control effectiveness and the remediation of control deficiencies." ;
          skos:example "An internal-controls team runs the control suite each period and assesses whether procedures were followed." .


###  http://example.org/apqc#P21575
ex:P21575 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000228 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19209
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19224
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19229
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P20139
                          ] ;
          ex:apqcSourceText "Designing and constructing assets such as machines, tools, factories, etc. Manage steps to acquire assets including managing capital, as well as planning, scheduling, and overseeing acquisition/construction." ;
          ex:hierarchyID "10.2" ;
          ex:pcfID "21575" ;
          rdfs:comment "Models APQC process group 10.2 as a bounded undertaking (one asset build program), not a standing function. Anchored at cco:ont00000228 (Planned Act) because it is a composite program spanning planning and material work rather than a single act of one genus. Its APQC children are process parts, not subclasses." ;
          rdfs:label "Design and construct assets" ;
          skos:definition "A Planned Act in which an Organization designs, plans, finances, schedules, and physically constructs productive assets, decomposing into managing the capital program, designing and planning the construction, scheduling and performing the construction work, and managing the construction effort." ;
          skos:example "A manufacturer's program to design, finance, and build a new production plant, ending when the plant is commissioned." .


###  http://example.org/apqc#P21576
ex:P21576 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDisposition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10952
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10953
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P12721
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P12722
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19258
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21579
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21580
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21581
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21582
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P21583
                          ] ;
          ex:apqcSourceText "Managing the disposition of assets at their end-of-life. End-of-life for an asset may be due to obsolescence, replacement, excess capacity, or disrepair among other potential factors. Steps may include decommissioning, disassembly, recycling, etc. Tracking and reporting may also be appropriate for some or all asset types due to law, regulation, or social/environmental responsibility." ;
          ex:hierarchyID "10.4" ;
          ex:pcfID "21576" ;
          rdfs:comment "Models APQC process group 10.4 as a bounded occurrent. Its APQC children are process parts (cco:ont00001777), not subclasses. The standing function of operating take-back centers (10.4.4) is modeled as a capability (ex:AssetDispositionCapability), not a process part." ;
          rdfs:label "Manage asset end-of-life" ;
          skos:definition "An Act of Disposition that retires and disposes of an organization's assets once they reach end-of-life, comprising the development of an exit strategy and the decommissioning, sale, dismantling, recycling, abandonment, and waste management of those assets." ;
          skos:example "A utility's program to retire and dispose of an obsolete substation, from exit strategy through demolition, recycling, and regulatory reporting." .


###  http://example.org/apqc#P21577
ex:P21577 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfAnalysis ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:CostBenefitAnalysis
                          ] ;
          ex:apqcSourceText "Cost/benefit analysis of assets to determine retention or end-of-life. Evaluating asset total lifecycle cost against other factors such as repair/refurbishment, replacement, and alternate solutions." ;
          ex:hierarchyID "10.4.1.2" ;
          ex:pcfID "21577" ;
          rdfs:comment "GOLDEN PRINCIPLE: analysis -> Descriptive ICE (CostBenefitAnalysis). Uses ex:ActOfAnalysis." ;
          rdfs:label "Perform cost vs. benefit analysis for replacement" ;
          skos:definition "An Act of Analysis that examines an asset's total lifecycle cost against repair, replacement, and alternative options and produces a cost-benefit analysis informing retention or end-of-life." ;
          skos:example "An analyst compares the cost of refurbishing a turbine against replacing it and documents the trade-off." .


###  http://example.org/apqc#P21579
ex:P21579 rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000970 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:AssetPart
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:ProductiveAsset
                          ] ;
          ex:apqcSourceText "Dismantling an asset into manageable parts. The parts may follow different dispositions, such as resale, reuse, recycle, etc." ;
          ex:hierarchyID "10.4.5" ;
          ex:pcfID "21579" ;
          ex:requiresCapability ex:AssetDispositionCapability ;
          rdfs:comment "Anchored to cco:ont00000970 (Act of Artifact Modification): the asset's structure is physically altered by removing parts, without yet disposing of them. Asset is a definitional material input; parts are the material output." ;
          rdfs:label "Dismantle assets" ;
          skos:definition "An Act of Artifact Modification that disassembles an end-of-life asset into manageable parts that may follow different downstream dispositions." ;
          skos:example "A technician disassembles a decommissioned generator into its motor, frame, and copper windings." .


###  http://example.org/apqc#P21580
ex:P21580 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfMonitoring ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001986 ;
                            owl:someValuesFrom ex:PartTrackingRecord
                          ] ;
          ex:apqcSourceText "Tracking the disposition of all parts from end-of-life assets. Tracking should provide an audit trail to include source, rational for disposition, and destination." ;
          ex:hierarchyID "10.4.6" ;
          ex:pcfID "21580" ;
          rdfs:comment "GOLDEN PRINCIPLE: monitoring/tracking -> Descriptive ICE (PartTrackingRecord). Uses ex:ActOfMonitoring (PROPOSE-EXT)." ;
          rdfs:label "Track parts" ;
          skos:definition "An Act of Monitoring that follows the disposition of parts from end-of-life assets and produces a part tracking record providing an audit trail of source, rationale, and destination." ;
          skos:example "A disposition coordinator logs each salvaged part's origin asset, chosen disposition, and final destination." .


###  http://example.org/apqc#P21581
ex:P21581 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDisposition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:AssetPart
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty obo:BFO_0000057 ;
                            owl:someValuesFrom ex:RecoveredMaterial
                          ] ;
          ex:apqcSourceText "Recycling parts in accordance with legal, regulatory, and social/environmental responsibilities." ;
          ex:hierarchyID "10.4.7" ;
          ex:pcfID "21581" ;
          ex:requiresCapability ex:AssetDispositionCapability ;
          rdfs:comment "Parts are a definitional material input; recovered material is the output. Operations category permits material I/O." ;
          rdfs:label "Recycle parts" ;
          skos:definition "An Act of Disposition that processes parts from end-of-life assets into recovered material in accordance with legal, regulatory, and social/environmental responsibilities." ;
          skos:example "Copper windings stripped from a dismantled motor are sent to a smelter and returned as recovered copper stock." .


###  http://example.org/apqc#P21582
ex:P21582 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDisposition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P13131
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P13132
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P13133
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P19465
                          ] ;
          ex:apqcSourceText "Planning and performing abandonment activities. Whether facilities  or equipment, ensure assets to be abandoned are safe, secure, and meet all legal, regulatory, and social/environmental responsibilities." ;
          ex:hierarchyID "10.4.10" ;
          ex:pcfID "21582" ;
          ex:requiresCapability ex:AssetDispositionCapability ;
          rdfs:comment "Parent of four sub-activities (process parts). Anchored at ex:ActOfDisposition because abandonment removes an asset from service and ownership responsibility." ;
          rdfs:label "Perform abandonment" ;
          skos:definition "An Act of Disposition that abandons a facility or equipment by demolishing and securing it, restoring its site, monitoring the site as required, and handing it over, ensuring the abandoned asset is safe, secure, and compliant." ;
          skos:example "An operator abandons a depleted well site: plugging, demolishing surface equipment, remediating soil, and handing the land back." .


###  http://example.org/apqc#P21583
ex:P21583 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfDisposition ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P12180
                          ] ,
                          [ rdf:type owl:Restriction ;
