             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19985 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review infringement of patents and copyrights" .


###  http://example.org/apqc#PCF_16827
ex:PCF_16827 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the business need for patents and copyrights. The patents and copyrights are managed by Manage copyrights and patents [11062]." ;
             ex:designatesProcessType ex:P16827 ;
             ex:hierarchyID "2.1.3.3" ;
             ex:pcfID "16827" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19985 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine patent and copyright needs" .


###  http://example.org/apqc#PCF_16848
ex:PCF_16848 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing marketing communications that deliver promotional messages, in a coordinated way, through multiple marketing channels, such as print, radio, television, direct mail, online or mobile advertising, email, social media or personal selling." ;
             ex:designatesProcessType ex:P16848 ;
             ex:hierarchyID "3.2.5" ;
             ex:pcfID "16848" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10102 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop marketing communication strategy" .


###  http://example.org/apqc#PCF_16849
ex:PCF_16849 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Timing and scheduling the delivery of marketing messages to maximize their impact on customer purchasing behavior. Integrate individual messages to larger marketing campaigns and to seasonal purchasing patterns." ;
             ex:designatesProcessType ex:P16849 ;
             ex:hierarchyID "3.2.5.1" ;
             ex:pcfID "16849" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop customer communication calendar" .


###  http://example.org/apqc#PCF_16850
ex:PCF_16850 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Deciding how to promote and maintain a favorable public image of the company in the eyes of its employees, customers, investors, suppliers, politicians or the general public. This may involve various means but is frequently conducted through publicity, education, corporate social responsibility, charitable causes or civic engagements." ;
             ex:designatesProcessType ex:P16850 ;
             ex:hierarchyID "3.2.5.2" ;
             ex:pcfID "16850" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define public relations (PR) strategy" .


###  http://example.org/apqc#PCF_16851
ex:PCF_16851 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Devising a master plan how to select potential customers or qualified clients for customized offers, and contact them on one-to-one basis through chat, phone, email or regular mail. The strategy would need to take into account that personalizing offers and contacting customers individually is an effective but resource-intensive marketing technique, and that ill-targeted offers risk at angering and alienating the contactees." ;
             ex:designatesProcessType ex:P16851 ;
             ex:hierarchyID "3.2.5.3" ;
             ex:pcfID "16851" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define direct marketing strategy" .


###  http://example.org/apqc#PCF_16852
ex:PCF_16852 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a program to promote the objectives, values, products and services of the company to its employees by treating them as potential customers, in order to extend company client base, increase employee engagement or to foster brand advocacy." ;
             ex:designatesProcessType ex:P16852 ;
             ex:hierarchyID "3.2.5.4" ;
             ex:pcfID "16852" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define internal marketing communication strategy" .


###  http://example.org/apqc#PCF_16853
ex:PCF_16853 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Finding emerging media based on digital or other technologies that would enable the company to increase the speed and volume of marketing communications, to make communications more interactive and to customize promotional messages more easily to the target audience, thus rendering them more effective." ;
             ex:designatesProcessType ex:P16853 ;
             ex:hierarchyID "3.2.5.5" ;
             ex:pcfID "16853" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify new media for marketing communication" .


###  http://example.org/apqc#PCF_16854
ex:PCF_16854 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a marketing strategy that is maximally effective in a new or emerging media channel by capitalizing on its novel attributes and capabilities." ;
             ex:designatesProcessType ex:P16854 ;
             ex:hierarchyID "3.2.5.6" ;
             ex:pcfID "16854" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define new media communication strategy" .


###  http://example.org/apqc#PCF_16855
ex:PCF_16855 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing a framework for coordinated marketing to increase the profitability and increase brand awareness at the point of sale. This may include promotional posters on product shelves or island displays, advertisements in shopping carts, stickers on the floor that lead consumers to the promoted product, multi-buy promotions, coupons on sales receipts, etc. " ;
             ex:designatesProcessType ex:P16855 ;
             ex:hierarchyID "3.2.5.7" ;
             ex:pcfID "16855" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define point of sale (POS) communication strategy" .


###  http://example.org/apqc#PCF_16890
ex:PCF_16890 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and maintaining claims processing and routing rules. Establish and maintain claims processing and routing rules for product warranties, coverage lists, repair, fault, trouble codes, repair time setup, and warranty policy registration. This also includes rolling out the codes and rules, and the improvements/updates to these rules and codes via systematic updates." ;
             ex:designatesProcessType ex:P16890 ;
             ex:hierarchyID "6.1.6.2" ;
             ex:pcfID "16890" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20089 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create and manage warranty rules/claim codes for products" .


###  http://example.org/apqc#PCF_16893
ex:PCF_16893 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing warranty policies to assure customers that the company will guarantee its warranties that it issues. " ;
             ex:designatesProcessType ex:P16893 ;
             ex:hierarchyID "6.1.6.1" ;
             ex:pcfID "16893" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20089 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine and document warranty policies" .


###  http://example.org/apqc#PCF_16905
ex:PCF_16905 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establish a strategy that includes rules and regulations for the physical handling, information processing, and disposition of product and packaging returned by the buyer to the seller or an intermediary. Include return approval, transportation coordination, advance communication, product tracking, receipt, disposition of the return, and processing warranty claims in the strategy." ;
             ex:designatesProcessType ex:P16905 ;
             ex:hierarchyID "4.4.1.7" ;
             ex:pcfID "16905" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10338 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define reverse logistics strategy" .


###  http://example.org/apqc#PCF_16928
ex:PCF_16928 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Utilizing customer inquiries as opportunities to either provide a comparable service to the one in question, offer additional complimentary service, or suggest a service that is better than what was initially offered." ;
             ex:designatesProcessType ex:P16928 ;
             ex:hierarchyID "6.2.2.5" ;
             ex:pcfID "16928" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10388 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify and capture upsell/cross-sell opportunities" .


###  http://example.org/apqc#PCF_16937
ex:PCF_16937 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing possible sales leads to the sales team in an effort to garner more business opportunities." ;
             ex:designatesProcessType ex:P16937 ;
             ex:hierarchyID "6.2.2.6" ;
             ex:pcfID "16937" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10388 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Deliver opportunity to sales team" .


###  http://example.org/apqc#PCF_16938
