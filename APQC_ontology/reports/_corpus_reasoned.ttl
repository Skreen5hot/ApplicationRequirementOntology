ex:PCF_16462 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating reports on risk activities, and communicating them to management. Prepare reports on the potential for adverse safety consequences." ;
             ex:designatesProcessType ex:P16462 ;
             ex:hierarchyID "11.1.3.7" ;
             ex:pcfID "16462" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17462 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report on risk activities" .


###  http://example.org/apqc#PCF_16463
ex:PCF_16463 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Obeying laws, guidelines, strategies, and stipulations related to the business." ;
             ex:designatesProcessType ex:RegulatoryComplianceManagementCapability ;
             ex:hierarchyID "11.2.2" ;
             ex:pcfID "16463" ;
