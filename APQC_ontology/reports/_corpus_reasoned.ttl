###  http://example.org/apqc#PCF_21599
ex:PCF_21599 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing sustainability training and awareness. Plan, prepare, and oversee delivery of sustainability education and enablement activities." ;
             ex:designatesProcessType ex:P21599 ;
             ex:hierarchyID "13.9.2.1" ;
             ex:pcfID "21599" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21598 ;
             skos:inScheme apqc:PCF ;
