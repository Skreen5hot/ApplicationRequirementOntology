###  http://example.org/apqc#PCF_19246
ex:PCF_19246 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining a timetable for which to execute the maintenance of the asset. " ;
             ex:designatesProcessType ex:P19246 ;
