                skos:scopeNote "Sound waves with frequencies in this range are typically audible to humans."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000531
cco:ont00000531 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000192 ;
