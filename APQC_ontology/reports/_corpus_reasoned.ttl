@prefix : <http://example.org/apqc/slice/10.0#> .
@prefix ex: <http://example.org/apqc#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix apqc: <http://example.org/apqc/scheme#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://example.org/apqc/slice/10.0> .

<http://example.org/apqc/slice/10.0> rdf:type owl:Ontology ;
                                      dct:source "APQC Process Classification Framework (Cross-Industry)" ;
                                      dct:title "APQC reality-layer slice 10.0: Acquire, Construct, and Manage Assets" ;
                                      rdfs:comment "Reality-layer BFO 2020 / CCO 2.0 module for APQC section 10.0. CCO pin: v2.0 (2024-11-06). Modeling decisions per ADR-001 (two-layer model; R5 bounded-occurrent test; GOLDEN PRINCIPLE genus<->output agreement). Self-contained: the shared act genera it uses are inlined from the apqc-ext.ttl registry, so it validates standalone against the pinned CCO/BFO closure with no extension merge." ;
                                      owl:versionInfo "0.3.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/apqc#apqcSourceText
ex:apqcSourceText rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Verbatim APQC Element Description retained for provenance." ;
                  rdfs:label "APQC source description" .


###  http://example.org/apqc#bearsPermission
ex:bearsPermission rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Role -> Action Permission class the role carries. The deontic hook (RDM/IEE authors the permission)." ;
                   rdfs:label "bears permission" .


###  http://example.org/apqc#designatesProcessType
ex:designatesProcessType rdf:type owl:AnnotationProperty ;
                         rdfs:comment "ADR-001 R4 bridge: catalog node (ex:PCF_<id>, defined in apqc-catalog.ttl) -> reality-layer process universal or capability. Populated during reality-layer modeling, NOT by the catalog generator." ,
                                      "ADR-001 R4 bridge: catalog node -> reality-layer process universal or capability. Populated during reality-layer modeling, NOT by the catalog generator." ,
                                      "Bridges a catalog node (ex:PCF_<pcfID>) to its reality-layer class (ex:P<pcfID> or a supporting capability)." ,
                                      "Bridges a catalog node (ex:PCF_<pcfID>) to its reality-layer class (ex:P<pcfID> or a supporting capability). The catalog nodes themselves are declared and typed (owl:NamedIndividual, cco:ont00000853 Descriptive ICE, skos:Concept) in apqc-catalog.ttl. An ANNOTATION property is used (not an object property) deliberately, to keep the slice in OWL DL and avoid ICE-to-class punning (ADR-001 R4)." ,
                                      "Catalog->reality bridge. Links an APQC catalog node (ex:PCF_<pcfID>) to the reality-layer class (process, capability) that it designates." ,
                                      "Catalog->reality bridge: relates an APQC catalog node (ex:PCF_<pcfID>) to the reality-layer class (process or capability) it designates." ,
                                      "Catalog-to-reality bridge: links an APQC catalog node (ex:PCF_<pcfID>) to the reality-layer class (process or capability) it designates." ;
                         rdfs:label "designates process type" .


###  http://example.org/apqc#enablesProcess
ex:enablesProcess rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Capability -> process class whose execution it enables. Operational inverse of ex:requiresCapability; BFO grounding is 'has realization' (a capability is realized in such processes). Used for authoring scope and wiring-coherence checks." ;
                  rdfs:label "enables process" .


###  http://example.org/apqc#hierarchyID
ex:hierarchyID rdf:type owl:AnnotationProperty ;
               rdfs:comment "Positional dotted-decimal locator. NON-STABLE across PCF versions." ,
                            "Positional dotted-decimal locator. NON-STABLE across PCF versions. Reference only; never for IRI minting or subsumption." ;
               rdfs:label "APQC Hierarchy ID" .


###  http://example.org/apqc#pcfID
ex:pcfID rdf:type owl:AnnotationProperty ;
         rdfs:comment "Stable APQC identifier. Anchor IRIs to this; it persists across PCF versions." ,
                      "Stable APQC identifier. Anchor process-class IRIs (ex:P<pcfID>) to this; it persists across PCF versions." ;
         rdfs:label "APQC PCF ID" .


###  http://example.org/apqc#routable
ex:routable rdf:type owl:AnnotationProperty ;
            rdfs:comment "Process Contract facet: marks a process universal as one the composer may route to a registered agent. Asserted alongside ex:requiresCapability/ex:requiresRole so the compiled graph is maximally queryable without inference." ;
            rdfs:label "routable" .


