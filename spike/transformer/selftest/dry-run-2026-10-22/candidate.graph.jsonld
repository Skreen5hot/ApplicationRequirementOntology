        "sf:658a9996d6424f3b7d7b5933"
      ],
      "status": "open",
      "raisedBy": "transformer"
    },
    {
      "@id": "diag:t:4",
      "@type": "Ambiguity",
      "blocking": true,
      "statement": "It is unclear whether loan records must survive only a single restart event or must survive every restart of the service.",
      "evidence": [
        "sf:ae8fcd033bf75c2d6341f07d"
      ],
      "status": "open",
      "raisedBy": "transformer",
      "interpretations": [
        "Loan records must survive at least one restart of the service (a single occurrence is sufficient).",
        "Loan records must survive any and every restart of the service (all occurrences)."
      ]
    },
    {
      "@id": "diag:t:5",
      "@type": "Ambiguity",
      "blocking": true,
      "statement": "It is unclear whether 'may borrow up to eight items at a time' states a member entitlement only, or also requires the system to detect and prevent members from exceeding eight items.",
      "evidence": [
        "sf:d5f73136eab9efb6613ad0fe"
      ],
      "status": "open",
      "raisedBy": "transformer",
      "interpretations": [
        "Members are granted permission to borrow up to eight items; the text does not require the system to enforce or block attempts to exceed that number.",
        "The system must enforce a hard upper limit of eight concurrent loans per member and must refuse any checkout that would cause a member to exceed it."
      ]
    },
    {
      "@id": "diag:t:6",
      "@type": "Underdetermination",
      "blocking": true,
      "statement": "The term 'durably' is not defined; the text specifies only that records must survive a restart, leaving unresolved what other failure scenarios or storage guarantees are required.",
      "evidence": [
        "sf:4b1de2c68b55d0d0b7e01e41"
      ],
      "status": "open",
      "raisedBy": "transformer"
    },
