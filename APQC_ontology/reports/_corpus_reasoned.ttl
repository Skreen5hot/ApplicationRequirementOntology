###  http://example.org/apqc#PCF_21574
ex:PCF_21574 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Performing planning, management, operations, and monitoring of internal control mechanism policies and procedures in order to manage internal controls." ;
             ex:designatesProcessType ex:P21574 ;
             ex:hierarchyID "9.8.2" ;
             ex:pcfID "21574" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10735 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Operate controls and monitor compliance with internal controls policies and procedures" .


###  http://example.org/apqc#PCF_21575
ex:PCF_21575 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing and constructing assets such as machines, tools, factories, etc. Manage steps to acquire assets including managing capital, as well as planning, scheduling, and overseeing acquisition/construction." ;
             ex:designatesProcessType ex:P21575 ;
             ex:hierarchyID "10.2" ;
             ex:pcfID "21575" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_19207 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design and construct assets" .


###  http://example.org/apqc#PCF_21576
ex:PCF_21576 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the disposition of assets at their end-of-life. End-of-life for an asset may be due to obsolescence, replacement, excess capacity, or disrepair among other potential factors. Steps may include decommissioning, disassembly, recycling, etc. Tracking and reporting may also be appropriate for some or all asset types due to law, regulation, or social/environmental responsibility." ;
             ex:designatesProcessType ex:P21576 ;
             ex:hierarchyID "10.4" ;
             ex:pcfID "21576" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_19207 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage asset end-of-life" .


###  http://example.org/apqc#PCF_21577
ex:PCF_21577 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Cost/benefit analysis of assets to determine retention or end-of-life. Evaluating asset total lifecycle cost against other factors such as repair/refurbishment, replacement, and alternate solutions." ;
             ex:designatesProcessType ex:P21577 ;
             ex:hierarchyID "10.4.1.2" ;
             ex:pcfID "21577" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10952 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform cost vs. benefit analysis for replacement" .


###  http://example.org/apqc#PCF_21579
ex:PCF_21579 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Dismantling an asset into manageable parts. The parts may follow different dispositions, such as resale, reuse, recycle, etc." ;
             ex:designatesProcessType ex:P21579 ;
             ex:hierarchyID "10.4.5" ;
             ex:pcfID "21579" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21576 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Dismantle assets" .


###  http://example.org/apqc#PCF_21580
ex:PCF_21580 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Tracking the disposition of all parts from end-of-life assets. Tracking should provide an audit trail to include source, rational for disposition, and destination." ;
             ex:designatesProcessType ex:P21580 ;
             ex:hierarchyID "10.4.6" ;
             ex:pcfID "21580" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21576 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track parts" .


###  http://example.org/apqc#PCF_21581
ex:PCF_21581 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recycling parts in accordance with legal, regulatory, and social/environmental responsibilities." ;
             ex:designatesProcessType ex:P21581 ;
             ex:hierarchyID "10.4.7" ;
             ex:pcfID "21581" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21576 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Recycle parts" .


###  http://example.org/apqc#PCF_21582
ex:PCF_21582 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Planning and performing abandonment activities. Whether facilities  or equipment, ensure assets to be abandoned are safe, secure, and meet all legal, regulatory, and social/environmental responsibilities." ;
             ex:designatesProcessType ex:P21582 ;
             ex:hierarchyID "10.4.10" ;
             ex:pcfID "21582" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21576 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform abandonment" .


###  http://example.org/apqc#PCF_21583
ex:PCF_21583 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Planning and performing waste and hazardous goods management. In compliance with all legal, regulatory, and social/environmental requirements, plan, document, and conduct hazardous material handling, disposal, and reporting." ;
             ex:designatesProcessType ex:P21583 ;
             ex:hierarchyID "10.4.11" ;
             ex:pcfID "21583" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21576 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform waste and hazardous goods management" .


###  http://example.org/apqc#PCF_21584
ex:PCF_21584 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining and managing measurement and benchmarking. Measure and benchmark the performance of internal processes, as well as the organization as a whole." ;
             ex:designatesProcessType ex:P21584 ;
             ex:hierarchyID "13.6" ;
             ex:pcfID "21584" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure and benchmark" .


###  http://example.org/apqc#PCF_21585
ex:PCF_21585 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and implementing a strategy for managing organizational performance. The strategy should include approaches for measuring, tracking, streamlining, and improving internal performance. It encompasses a blueprint for the tactical measurement of internal processes and work force improvement, in alignment with Employee Metrics Developed and Managed [10526]." ;
             ex:designatesProcessType ex:P21585 ;
             ex:hierarchyID "13.6.1" ;
             ex:pcfID "21585" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21584 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define and manage organizational performance strategy" .


###  http://example.org/apqc#PCF_21586
ex:PCF_21586 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reviewing, evaluating, and updating enterprise measurement models. Align measurement models to current and future goals and performance targets, and make adjustments to support visibility and reporting needs across the organization." ;
             ex:designatesProcessType ex:P21586 ;
             ex:hierarchyID "13.6.1.2" ;
             ex:pcfID "21586" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21585 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain enterprise measurement models" .


###  http://example.org/apqc#PCF_21587
ex:PCF_21587 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the performance, costs and benefits of EHS. Measure and report the performance of EHS. Implement plans for emergency response and pollution prevention. Train and educate employees. Provide EHS support." ;
             ex:designatesProcessType ex:P21587 ;
             ex:hierarchyID "13.8.3" ;
             ex:pcfID "21587" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11179 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor and manage EHS program" .


###  http://example.org/apqc#PCF_21588
ex:PCF_21588 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and managing sustainability practices for the organization. Ensure proper understanding and communication of ESG standards, requirements, capabilities, and future trends. Promote awareness, alignment, and continuity." ;
             ex:designatesProcessType ex:SustainabilityManagementCapability ;
             ex:hierarchyID "13.9" ;
             ex:pcfID "21588" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage sustainability" .


###  http://example.org/apqc#PCF_21589
ex:PCF_21589 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing sustainability (ESG) capabilities for the organization. Understand and communicate legal, regulatory, and social/environmental requirements. Establish policies, objectives, guidelines and approaches for ESG efforts and reporting." ;
             ex:designatesProcessType ex:P21589 ;
             ex:hierarchyID "13.9.1" ;
             ex:pcfID "21589" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21588 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop sustainability capability" .


###  http://example.org/apqc#PCF_21590
ex:PCF_21590 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying, documenting, and communicating sustainability requirements. Closely examine all standards and matters of compliance relating to ESG. Determine protocols or standards to comply with, set by regulatory agencies or the organizations stakeholders." ;
             ex:designatesProcessType ex:P21590 ;
             ex:hierarchyID "13.9.1.1" ;
             ex:pcfID "21590" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21589 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify sustainability requirements" .


###  http://example.org/apqc#PCF_21591
ex:PCF_21591 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining and communicating sustainability disclosure requirements. Clarify and align disclosure requirements to other organizational reporting requirements and needs. Integrate preparation and reporting activities." ;
             ex:designatesProcessType ex:P21591 ;
             ex:hierarchyID "13.9.1.1.1" ;
             ex:pcfID "21591" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_21590 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define sustainability disclosure requirements" .


###  http://example.org/apqc#PCF_21592
ex:PCF_21592 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining governance requirements for sustainability. Include structure, roles, alignment to organization models, processes and standards to be applied." ;
             ex:designatesProcessType ex:P21592 ;
             ex:hierarchyID "13.9.1.1.2" ;
             ex:pcfID "21592" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_21590 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define sustainability governance requirements" .


###  http://example.org/apqc#PCF_21593
ex:PCF_21593 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining functional and performance requirements for sustainability. Align with ESG strategies, goals, and the implementation of sustainability efforts across the organization, provide a roadmap and visibility to shared and collective requirements." ;
             ex:designatesProcessType ex:P21593 ;
             ex:hierarchyID "13.9.1.1.3" ;
             ex:pcfID "21593" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_21590 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define sustainability functional and performance requirements" .


###  http://example.org/apqc#PCF_21594
ex:PCF_21594 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing organizational sustainability goals/objectives. Gather, align, and promote organization-wide sustainability goals that collectively address the overall sustainability requirements. Ensure the goals are measurable and have qualitative and quantitative targets." ;
             ex:designatesProcessType ex:P21594 ;
             ex:hierarchyID "13.9.1.2" ;
             ex:pcfID "21594" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21589 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish sustainability goals/objectives" .


###  http://example.org/apqc#PCF_21595
ex:PCF_21595 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing, documenting, and communicating sustainability policies. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
             ex:designatesProcessType ex:P21595 ;
             ex:hierarchyID "13.9.1.3" ;
             ex:pcfID "21595" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21589 ;
             skos:inScheme apqc:PCF ;
