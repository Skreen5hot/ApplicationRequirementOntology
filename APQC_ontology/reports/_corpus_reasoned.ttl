             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11010 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate with shareholders" .


###  http://example.org/apqc#PCF_11038
ex:PCF_11038 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Persuading public and government policy at the local, regional, national, and global level (subject to government regulations)." ;
             ex:designatesProcessType ex:P11038 ;
             ex:hierarchyID "12.2.1" ;
             ex:pcfID "11038" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11011 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage government relations" .


###  http://example.org/apqc#PCF_11039
ex:PCF_11039 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing relations with quasi-governmental organizations, corporations, businesses, or any other agency that is treated by national laws and principles to be under the supervision of the government but also distinct and self-directed from the government." ;
             ex:designatesProcessType ex:P11039 ;
             ex:hierarchyID "12.2.2" ;
             ex:pcfID "11039" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11011 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage relations with quasi-government bodies" .


###  http://example.org/apqc#PCF_11040
ex:PCF_11040 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing relations with organizations established and financed by businesses that operate in a specific industry. Participate in public relations actions such as lobbying and publishing, advertising, education, and political donations." ;
             ex:designatesProcessType ex:P11040 ;
             ex:hierarchyID "12.2.3" ;
             ex:pcfID "11040" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11011 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage relations with trade or industry groups" .


###  http://example.org/apqc#PCF_11041
ex:PCF_11041 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing lobbying activities to affect government policies. " ;
             ex:designatesProcessType ex:P11041 ;
             ex:hierarchyID "12.2.4" ;
             ex:pcfID "11041" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11011 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage lobby activities" .


###  http://example.org/apqc#PCF_11042
ex:PCF_11042 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reporting financial results to management, and releasing results to the public. Report financial statements, including the income statement, balance sheet, and statement of cash flows." ;
             ex:designatesProcessType ex:P11042 ;
             ex:hierarchyID "12.3.1" ;
             ex:pcfID "11042" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11012 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report financial results" .


###  http://example.org/apqc#PCF_11043
ex:PCF_11043 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reporting audit findings to management. Practice an internal audit with criteria for confirming a problem, a description of the situation, and the root cause of the problem. Make recommendations that resolve the issue." ;
             ex:designatesProcessType ex:P11043 ;
             ex:hierarchyID "12.3.2" ;
             ex:pcfID "11043" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11012 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report audit findings" .


###  http://example.org/apqc#PCF_11044
ex:PCF_11044 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a code of ethics that communicate the organization's philosophy to employees, vendors, customers, clients, and the public." ;
             ex:designatesProcessType ex:P11044 ;
             ex:hierarchyID "12.4.1" ;
             ex:pcfID "11044" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create ethics policies" .


###  http://example.org/apqc#PCF_11045
ex:PCF_11045 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the system of rules, practices, and processes through which a company is directed and controlled. Balance stakeholder interests including shareholders, management, customers, suppliers, financiers, government, and the community. Outline a strategy for achieving organizational goals, from action plans and internal controls to performance measurement and corporate disclosure." ;
             ex:designatesProcessType ex:P11045 ;
             ex:hierarchyID "12.4.2" ;
             ex:pcfID "11045" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage corporate governance policies" .


###  http://example.org/apqc#PCF_11046
ex:PCF_11046 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and applying programs and activities. Encourage the adherence preventive laws, such as environmental law, sex discrimination, computer law, estate planning, corporate compliance, business planning, and property transactions." ;
             ex:designatesProcessType ex:P11046 ;
             ex:hierarchyID "12.4.3" ;
             ex:pcfID "11046" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and perform preventive law programs" .


###  http://example.org/apqc#PCF_11047
ex:PCF_11047 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ensuring the organization's compliance position. Validate compliance with different statutes, regulatory directions, and legal principles (using Establish compliance framework and policies [17468]). Coordinate with compliance and risk management personnel." ;
             ex:designatesProcessType ex:P11047 ;
             ex:hierarchyID "12.4.4" ;
             ex:pcfID "11047" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Ensure compliance" .


###  http://example.org/apqc#PCF_11048
ex:PCF_11048 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing professionals, sought externally for assistance over legal and ethical concerns. Administer and oversee assistance from subject matter experts and professionals for sourcing expert opinion and counseling over legal and ethical matters." ;
             ex:designatesProcessType ex:P11048 ;
             ex:hierarchyID "12.4.5" ;
             ex:pcfID "11048" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage outside counsel" .


###  http://example.org/apqc#PCF_11049
ex:PCF_11049 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Safeguarding the intellectual property of the organization. This process requires the organization to protect a wide variety of intellectual property created by it. It involves creating and managing non-disclosure agreements (NDAs), following up on current developments in the areas where the organization holds patents, tracking the use of the organization's copyrighted material, creating and upholding licensing terms, and administering policies for safeguarding intellectual property." ;
             ex:designatesProcessType ex:P11049 ;
             ex:hierarchyID "12.4.6" ;
             ex:pcfID "11049" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Protect intellectual property" .


###  http://example.org/apqc#PCF_11050
ex:PCF_11050 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Resolving disputes or civil lawsuits internally or externally. " ;
             ex:designatesProcessType ex:P11050 ;
             ex:hierarchyID "12.4.7" ;
             ex:pcfID "11050" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Resolve disputes and litigations" .


###  http://example.org/apqc#PCF_11051
ex:PCF_11051 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing legal advice concerning the substance or procedure of a law in relation to a particular situation." ;
             ex:designatesProcessType ex:P11051 ;
             ex:hierarchyID "12.4.8" ;
             ex:pcfID "11051" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide legal advice/counseling" .


###  http://example.org/apqc#PCF_11052
ex:PCF_11052 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Negotiating terms to reach a final draft of a contract that is acceptable to all parties. " ;
             ex:designatesProcessType ex:P11052 ;
             ex:hierarchyID "12.4.9" ;
             ex:pcfID "11052" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Negotiate and document agreements/contracts" .


###  http://example.org/apqc#PCF_11053
ex:PCF_11053 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Employing an internal system or process to identify and reduce the risk of breaching the Competition and Consumer Act 2010. Remedy any breach. Create a culture of compliance. Design compliance programs." ;
             ex:designatesProcessType ex:P11053 ;
             ex:hierarchyID "12.4.4.1" ;
             ex:pcfID "11053" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11047 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan and initiate compliance program" .


###  http://example.org/apqc#PCF_11054
ex:PCF_11054 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing the established compliance program in order to meet the government laws and regulations. Create a compliance team that scrutinizes the rules set out by government bodies such as the Securities and Exchange Commission." ;
             ex:designatesProcessType ex:P11054 ;
             ex:hierarchyID "12.4.4.2" ;
             ex:pcfID "11054" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11047 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Execute compliance program" .


###  http://example.org/apqc#PCF_11056
ex:PCF_11056 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the problems and deciding the action requirements for engaging outside counsel. This process element calls upon the organization to internally analyze the issues for which assistance from external counsel is needed. Additionally, the organization needs to break-down the issue, identifying the tasks and exercises where outside counsel can help." ;
             ex:designatesProcessType ex:P11056 ;
             ex:hierarchyID "12.4.5.1" ;
             ex:pcfID "11056" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11048 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess problem and determine work requirements" .


###  http://example.org/apqc#PCF_11057
ex:PCF_11057 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recruiting the assistance of outside counsel for any legal and/or ethical concerns. Engage and/or retain any external counsel sought from subject matter experts and professionals." ;
             ex:designatesProcessType ex:P11057 ;
             ex:hierarchyID "12.4.5.2" ;
             ex:pcfID "11057" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11048 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Engage/Retain outside counsel if necessary" .


###  http://example.org/apqc#PCF_11058
ex:PCF_11058 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Making a financial plan. This strategy sets out, using figures, an organization's expected future results. Enlist the finance function to support work generated by other business functions in order to build and secure their support for the budget." ;
             ex:designatesProcessType ex:P11058 ;
             ex:hierarchyID "12.4.5.3" ;
             ex:pcfID "11058" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11048 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Receive strategy/budget" .


###  http://example.org/apqc#PCF_11059
ex:PCF_11059 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Receiving deliverables from outside counsel, and monitoring the efforts committed by them. Track the progress of, collect, and validate the required work product from the subject matter experts and professionals engaged as external counsel. Verify the amount of effort dedicated by these counsels to the issue at hand, in order to confirm their fees." ;
             ex:designatesProcessType ex:P11059 ;
             ex:hierarchyID "12.4.5.4" ;
             ex:pcfID "11059" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11048 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Receive work product and manage/monitor case and work performed" .


###  http://example.org/apqc#PCF_11060
ex:PCF_11060 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Making payments to legal advisers for their services. Payments include addressing issues or suits by customers, suppliers, competitors, bankers, government agencies, etc." ;
             ex:designatesProcessType ex:P11060 ;
             ex:hierarchyID "12.4.5.5" ;
             ex:pcfID "11060" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11048 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Process payment for legal services" .


###  http://example.org/apqc#PCF_11061
ex:PCF_11061 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Keeping track of the legal activities and performance of the organization. " ;
             ex:designatesProcessType ex:P11061 ;
             ex:hierarchyID "12.4.5.6" ;
             ex:pcfID "11061" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11048 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Track legal activity/performance" .


###  http://example.org/apqc#PCF_11062
ex:PCF_11062 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the patents and copyrights already held or sought by the organization. Administer and oversee applying for, securing, and maintaining intellectual property rights in the form of patents and copyrights. Submit applications for such rights. Handle associated legal issues. Draft and communicate proper attributions. Collect royalties. Monitor any misuse of the intellectual property rights." ;
             ex:designatesProcessType ex:P11062 ;
             ex:hierarchyID "12.4.6.1" ;
             ex:pcfID "11062" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11049 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage copyrights, patents, and trademarks" .


###  http://example.org/apqc#PCF_11063
ex:PCF_11063 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the upkeep of intellectual property rights by creating and managing a framework of rules, policies, procedures, and restrictions. Outline a clear policy for any possible scenario of their use by any external agent." ;
             ex:designatesProcessType ex:P11063 ;
             ex:hierarchyID "12.4.6.2" ;
             ex:pcfID "11063" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11049 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain intellectual property rights and restrictions" .


###  http://example.org/apqc#PCF_11064
ex:PCF_11064 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering and overseeing the terms and policies associated with licensing the organization's intellectual property. Create and manage the policies and terms governing the possible granting of a license to any external agent. Demarcate a clear framework that governs the licensing of any patents or copyrights held by the organization." ;
             ex:designatesProcessType ex:P11064 ;
             ex:hierarchyID "12.4.6.3" ;
             ex:pcfID "11064" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11049 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Administer licensing terms" .


###  http://example.org/apqc#PCF_11065
ex:PCF_11065 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing options regarding licensing agreements. Follow favorable terms and conditions. " ;
             ex:designatesProcessType ex:P11065 ;
             ex:hierarchyID "12.4.6.4" ;
             ex:pcfID "11065" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11049 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Administer options" .


###  http://example.org/apqc#PCF_11066
ex:PCF_11066 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and administering community relations. Establish business connections with the people constituting the environment the organization operates in and draws resources from in order to foster mutual understanding, trust, and support. Create programs that promote the organization's image in a positive and community-oriented way." ;
             ex:designatesProcessType ex:P11066 ;
             ex:hierarchyID "12.5.1" ;
             ex:pcfID "11066" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11014 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage community relations" .


###  http://example.org/apqc#PCF_11067
ex:PCF_11067 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing and managing relations with media. Develop connections with journalists to solicit critical, third-party endorsements for a product, issue, service, or organization." ;
             ex:designatesProcessType ex:P11067 ;
             ex:hierarchyID "12.5.2" ;
             ex:pcfID "11067" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11014 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage media relations" .


###  http://example.org/apqc#PCF_11068
ex:PCF_11068 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Promoting political security and stability in the regions where the organization conducts business. Encourage political stability in the regions where the organization operates. Support civic programs, citizen engagement, connection platforms, etc." ;
             ex:designatesProcessType ex:P11068 ;
             ex:hierarchyID "12.5.3" ;
             ex:pcfID "11068" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11014 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Promote political stability" .


###  http://example.org/apqc#PCF_11069
ex:PCF_11069 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing press releases to communicate developments and generate interest in the organization. " ;
             ex:designatesProcessType ex:P11069 ;
             ex:hierarchyID "12.5.4" ;
             ex:pcfID "11069" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11014 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create press releases" .


###  http://example.org/apqc#PCF_11070
ex:PCF_11070 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Issuing press releases to carefully selected media in distribution channels such as the web, newspapers, and social media." ;
             ex:designatesProcessType ex:P11070 ;
             ex:hierarchyID "12.5.5" ;
             ex:pcfID "11070" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11014 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Issue press releases" .


###  http://example.org/apqc#PCF_11072
ex:PCF_11072 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Comparing organizational performance internally or externally with other organizations. " ;
             ex:designatesProcessType ex:P11072 ;
             ex:hierarchyID "13.6.2" ;
             ex:pcfID "11072" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21584 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Benchmark performance" .


###  http://example.org/apqc#PCF_11073
ex:PCF_11073 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and administering the capability of the organization's knowledge management function. Develop a strategy for knowledge management. Assess capabilities of the knowledge management function. " ;
             ex:designatesProcessType ex:KnowledgeManagementCapability ;
             ex:hierarchyID "13.5" ;
             ex:pcfID "11073" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and manage enterprise-wide knowledge management (KM) capability" .


###  http://example.org/apqc#PCF_11074
ex:PCF_11074 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Planning, designing, and implementing the change. Ensure improvement in the change process." ;
             ex:designatesProcessType ex:P11074 ;
             ex:hierarchyID "13.4" ;
             ex:pcfID "11074" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage change" .


###  http://example.org/apqc#PCF_11075
ex:PCF_11075 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a model for organization's management systems. Develop a high-level measurement system to track performance across the enterprise or in specific functions or business units. Determine which processes to measure, which measures to use, how often to measure, and measurement targets. Review strategic decisions about how to best measure an organization." ;
             ex:designatesProcessType ex:P11075 ;
             ex:hierarchyID "13.6.1.1" ;
             ex:pcfID "11075" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21585 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define enterprise measurement models" .


###  http://example.org/apqc#PCF_11083
ex:PCF_11083 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Measuring, researching, and recording the performance of people, processes, mechanisms, or other areas of the business that the organization wants to benchmark or track." ;
             ex:designatesProcessType ex:P11083 ;
             ex:hierarchyID "13.6.2.1" ;
             ex:pcfID "11083" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11072 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct performance assessments" .


###  http://example.org/apqc#PCF_11084
ex:PCF_11084 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Improving an organization's ability to compare its performance internally or externally, and maintaining benchmarking relationships with other organizations. Train staff in benchmarking. Develop technological solutions or other materials to aid benchmarking efforts. Consult with external entities to gain knowledge or tools to help benchmark." ;
             ex:designatesProcessType ex:P11084 ;
             ex:hierarchyID "13.6.2.2" ;
             ex:pcfID "11084" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11072 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop benchmarking capabilities" .


###  http://example.org/apqc#PCF_11085
ex:PCF_11085 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Benchmarking internal processes and against external competitors. " ;
             ex:designatesProcessType ex:P11085 ;
             ex:hierarchyID "13.6.2.3" ;
             ex:pcfID "11085" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11072 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct internal and external benchmarking" .


###  http://example.org/apqc#PCF_11087
ex:PCF_11087 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining performance against benchmarked organizations or entities. Determine how much performance needs to change to meet expectations. Reach strategic goals." ;
             ex:designatesProcessType ex:P11087 ;
             ex:hierarchyID "13.6.2.4" ;
             ex:pcfID "11087" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11072 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct gap analysis" .


###  http://example.org/apqc#PCF_11088
ex:PCF_11088 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing a need for changing the performance of the organization. Make use of the gap analysis results in order to define the need for change. " ;
             ex:designatesProcessType ex:P11088 ;
             ex:hierarchyID "13.6.2.5" ;
             ex:pcfID "11088" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11072 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish need for change" .


###  http://example.org/apqc#PCF_11095
ex:PCF_11095 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan for managing the organization's knowledge base. Determine what kind of specialized knowledge the organization possesses, which elements of this collective knowledge can prove beneficial, how to capture and maintain this knowledge, how to grant access to this library of information, and how the organization should proceed." ;
             ex:designatesProcessType ex:P11095 ;
             ex:hierarchyID "13.5.1" ;
             ex:pcfID "11095" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11073 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop KM strategy" .


###  http://example.org/apqc#PCF_11096
ex:PCF_11096 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the maturity of the existing initiatives in knowledge management, and evaluating existing KM approaches. Identify the gaps and needs in order to enhance the existing KM approaches. Develop and implement new KM approaches." ;
             ex:designatesProcessType ex:P11096 ;
             ex:hierarchyID "13.5.2" ;
             ex:pcfID "11096" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11073 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess KM capabilities" .


###  http://example.org/apqc#PCF_11100
ex:PCF_11100 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a structure for the governance of the organization's collective knowledge. Gather, maintain, and make accessible the collective knowledge base. Develop a standard procedure for the conservation and perpetuation of the organization's knowledge. Create policies for the usage and maintenance of this knowledge. Establish specialized roles." ;
             ex:designatesProcessType ex:P11100 ;
             ex:hierarchyID "13.5.1.1" ;
             ex:pcfID "11100" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop governance model with roles and accountability" .


###  http://example.org/apqc#PCF_11102
ex:PCF_11102 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Clearly determining the roles and responsibilities of all personnel involved in the management of the organization's corpus of knowledge. Flesh out the roles and responsibilities of the KM core group, as well as the operational staff involved in the upkeep of the knowledge management program." ;
             ex:designatesProcessType ex:P11102 ;
             ex:hierarchyID "13.5.1.2" ;
             ex:pcfID "11102" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define roles and accountability of core group versus operating units" .


###  http://example.org/apqc#PCF_11103
ex:PCF_11103 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyze the organization's current approach to funding. Learn from the funding approaches of peer organizations. Evaluate the revenue potential and costs of those short-list funding models. Select funding models to implement." ;
             ex:designatesProcessType ex:P11103 ;
             ex:hierarchyID "13.5.1.3" ;
             ex:pcfID "11103" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop funding models" .


###  http://example.org/apqc#PCF_11104
ex:PCF_11104 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying any links that exist between the strategy for knowledge management and any other functional areas. Determine any correlations that exist between the strategic road map for the knowledge management and any other functional areas. Study each function's/unit's attributes." ;
             ex:designatesProcessType ex:P11104 ;
             ex:hierarchyID "13.5.1.4" ;
             ex:pcfID "11104" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify links to key initiatives" .


###  http://example.org/apqc#PCF_11105
ex:PCF_11105 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating core knowledge management procedures and methodologies. Initiate developing a strategy, planning, execution, and improvement." ;
             ex:designatesProcessType ex:P11105 ;
             ex:hierarchyID "13.5.1.5" ;
             ex:pcfID "11105" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop core KM methodologies" .


###  http://example.org/apqc#PCF_11106
ex:PCF_11106 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the IT needs for developing the knowledge management strategy, and collaborating with the IT function to implement the strategy. Assess requirements for technologies such as computer hardware, software, electronics, semiconductors, internet, and telecommunications equipment in order to effectively build and implement the strategy for knowledge management." ;
             ex:designatesProcessType ex:P11106 ;
             ex:hierarchyID "13.5.1.6" ;
             ex:pcfID "11106" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess IT needs and engage IT function" .


###  http://example.org/apqc#PCF_11107
ex:PCF_11107 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating plans for KM training plans and conveying the knowledge management strategy within the organization. Create training programs, sessions, and activities in order to familiarize employees and management with the concept of knowledge management." ;
             ex:designatesProcessType ex:P11107 ;
             ex:hierarchyID "13.5.1.7" ;
             ex:pcfID "11107" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop training and communication plans" .


###  http://example.org/apqc#PCF_11108
ex:PCF_11108 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating approaches for effectively administering the changes in knowledge management. Design an approach that transforms individuals, teams, and the organization to a desired future state represented by the change." ;
             ex:designatesProcessType ex:P11108 ;
             ex:hierarchyID "13.5.1.8" ;
             ex:pcfID "11108" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop change management approaches" .


###  http://example.org/apqc#PCF_11109
ex:PCF_11109 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing measures and indicators for evaluating the performance of the knowledge management function. Define key performance indicators such as the amount of knowledge assets created and number of knowledge projects undertaken." ;
             ex:designatesProcessType ex:P11109 ;
             ex:hierarchyID "13.5.1.9" ;
             ex:pcfID "11109" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11095 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop strategic measures and indicators" .


###  http://example.org/apqc#PCF_11110
ex:PCF_11110 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating if initiatives are effective or should be discarded. Design a framework for assessing maturity, typically from Level 1 (undefined), Level 2 (repeatable), Level 3 (defined), and Level 4 (managed) through Level 5 (optimized)." ;
             ex:designatesProcessType ex:P11110 ;
             ex:hierarchyID "13.5.2.1" ;
             ex:pcfID "11110" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11096 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess maturity of existing KM initiatives" .


###  http://example.org/apqc#PCF_11111
ex:PCF_11111 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating existing procedures, policies, and guidelines for knowledge management. Study and examine the organization's approach against industry best practices by benchmarking, competitive analysis, etc." ;
             ex:designatesProcessType ex:P11111 ;
             ex:hierarchyID "13.5.2.2" ;
             ex:pcfID "11111" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11096 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate existing KM approaches" .


###  http://example.org/apqc#PCF_11112
ex:PCF_11112 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the KM approach evaluations in order to identify any gaps or needs. Compare the performance of the KM approach against the desired or expected performance, as well as against the standard knowledge management industry approach." ;
             ex:designatesProcessType ex:P11112 ;
             ex:hierarchyID "13.5.2.3" ;
             ex:pcfID "11112" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11096 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify gaps and needs" .


###  http://example.org/apqc#PCF_11113
ex:PCF_11113 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Leveraging KM evaluations and identified gap to enhance existing approaches. " ;
             ex:designatesProcessType ex:P11113 ;
             ex:hierarchyID "13.5.4.1" ;
             ex:pcfID "11113" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20969 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Enhance/Modify existing KM approaches" .


###  http://example.org/apqc#PCF_11114
ex:PCF_11114 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing new policies, procedures, and guidelines to support knowledge management." ;
             ex:designatesProcessType ex:P11114 ;
             ex:hierarchyID "13.5.3.1" ;
             ex:pcfID "11114" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20965 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop new KM approaches" .


###  http://example.org/apqc#PCF_11115
ex:PCF_11115 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing new policies, procedures, and guidelines to support knowledge management." ;
             ex:designatesProcessType ex:P11115 ;
             ex:hierarchyID "13.5.3.3" ;
             ex:pcfID "11115" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20965 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Implement new KM approaches" .


###  http://example.org/apqc#PCF_11117
ex:PCF_11117 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing and defining what the project is ultimately supposed to do. Specify the capabilities, features, or attributes of the project's deliverables, as well as any kind of formal documentation." ;
             ex:designatesProcessType ex:P11117 ;
             ex:hierarchyID "13.2.3.1.1" ;
             ex:pcfID "11117" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16411 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify project requirements and objectives" .


###  http://example.org/apqc#PCF_11118
ex:PCF_11118 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the culture and readiness of the organizational environment is order to implement the project management approach. " ;
             ex:designatesProcessType ex:P11118 ;
             ex:hierarchyID "13.2.3.1.3" ;
             ex:pcfID "11118" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16411 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess culture and readiness for project management approach" .


###  http://example.org/apqc#PCF_11119
ex:PCF_11119 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and implementing the techniques and procedures for managing business projects. Identify the most appropriate models, which are to be employed by the project managers for the purpose of designing, planning, implementing, and achieving project objectives. Examine and assess various project management methodologies such as adaptive project framework, agile development, crystal methods, and feature-driven development." ;
             ex:designatesProcessType ex:P11119 ;
             ex:hierarchyID "13.2.3.2" ;
             ex:pcfID "11119" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16410 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify appropriate project management methodologies" .


###  http://example.org/apqc#PCF_11120
ex:PCF_11120 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a document that includes the current situation, proposed solution, financial analysis, conclusion, etc. Convince a decision maker and investors to approve the project. Obtain funding." ;
             ex:designatesProcessType ex:P11120 ;
             ex:hierarchyID "13.2.3.1.4" ;
             ex:pcfID "11120" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16411 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create business case" .


###  http://example.org/apqc#PCF_11121
ex:PCF_11121 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing procedures and indictors to assess performance of business projects. Design and develop metrics and indicators--such as cost, schedule, resources, risk, and quality--that exhibit the performance of the business projects." ;
             ex:designatesProcessType ex:P11121 ;
             ex:hierarchyID "13.2.3.1.5" ;
             ex:pcfID "11121" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16411 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop project measures and indicators" .


###  http://example.org/apqc#PCF_11123
ex:PCF_11123 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the resources and their roles in the business projects. " ;
             ex:designatesProcessType ex:P11123 ;
             ex:hierarchyID "13.2.3.3.1" ;
             ex:pcfID "11123" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define roles and resources" .


###  http://example.org/apqc#PCF_11124
ex:PCF_11124 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the IT requirements for specific business projects. Identify the requirements of computers and telecommunications equipment to store, retrieve, transmit, and manipulate data related to the project. Consider factors such as functional requirements, design requirements, project phases, and project schedule." ;
             ex:designatesProcessType ex:P11124 ;
             ex:hierarchyID "13.2.3.3.3" ;
             ex:pcfID "11124" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify specific IT requirements" .


###  http://example.org/apqc#PCF_11125
ex:PCF_11125 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Designing a plan for equipping the project team with the necessary skills and abilities to fulfill their roles and responsibilities in the project effectively and efficiently. Offer formal training, mentoring, or coaching. Initiate informal conversations. Communicate messages during the project." ;
             ex:designatesProcessType ex:P11125 ;
             ex:hierarchyID "13.2.3.3.4" ;
             ex:pcfID "11125" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create training and communication plans" .


###  http://example.org/apqc#PCF_11127
ex:PCF_11127 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan for recognizing and rewarding extraordinary performances within the business projects. Use incentives, bonuses, and certificates for recognition and rewarding purposes." ;
             ex:designatesProcessType ex:P11127 ;
             ex:hierarchyID "13.2.3.3.5" ;
             ex:pcfID "11127" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design recognition and reward approaches" .


###  http://example.org/apqc#PCF_11128
ex:PCF_11128 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan specifying when to initiate the project, and introducing it to the target audience. Clearly define the project team, objectives, timelines, and milestone." ;
             ex:designatesProcessType ex:P11128 ;
             ex:hierarchyID "13.2.3.3.6" ;
             ex:pcfID "11128" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design and plan launch of project" .


###  http://example.org/apqc#PCF_11129
ex:PCF_11129 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Putting the project into position by effectively bringing it into action. " ;
             ex:designatesProcessType ex:P11129 ;
             ex:hierarchyID "13.2.3.3.7" ;
             ex:pcfID "11129" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16413 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Deploy the project" .


###  http://example.org/apqc#PCF_11131
ex:PCF_11131 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the impact of business project management on the measures and outcomes of the projects. Gauge non-financial measures, frequency of measurement, action plan, etc." ;
             ex:designatesProcessType ex:P11131 ;
             ex:hierarchyID "13.2.3.4.1" ;
             ex:pcfID "11131" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16414 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate impact of project management (strategy and projects) on measures and outcomes" .


###  http://example.org/apqc#PCF_11132
ex:PCF_11132 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Encouraging and sustaining the activities and involvement while executing projects. Promote the execution activities of the projects. Encourage employee involvement in project implementation. " ;
             ex:designatesProcessType ex:P11132 ;
             ex:hierarchyID "13.2.3.4.4" ;
             ex:pcfID "11132" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16414 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Promote and sustain activity and involvement" .


###  http://example.org/apqc#PCF_11133
ex:PCF_11133 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reorganizing and stimulating the approach and strategy for managing business projects. Make improvements based on the project scope and on findings from Evaluate the impact of project management (strategy and projects) on measures and outcomes [11131]." ;
             ex:designatesProcessType ex:P11133 ;
             ex:hierarchyID "13.2.3.4.6" ;
             ex:pcfID "11133" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16414 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Realign and refresh project management strategy and approaches" .


###  http://example.org/apqc#PCF_11135
ex:PCF_11135 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing plans for change management, training, communication, and rewards/incentives. Establish metrics for measuring the change adoption. Clarify new roles for employees. Identify budgets." ;
             ex:designatesProcessType ex:P11135 ;
             ex:hierarchyID "13.4.2" ;
             ex:pcfID "11135" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11074 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design the change" .


###  http://example.org/apqc#PCF_11136
ex:PCF_11136 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Effectuating the change within the desired impact areas of the organization. Ensure adequate commitment from all corners of the organization for the desired change. Create support structures. Refashion all processes deemed necessary. Observe the progress." ;
             ex:designatesProcessType ex:P11136 ;
             ex:hierarchyID "13.4.3" ;
             ex:pcfID "11136" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11074 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Implement change" .


###  http://example.org/apqc#PCF_11137
ex:PCF_11137 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Sustaining the impact of the change process in order to enact continual process improvement. Monitor the performance of re-engineered business processes. Identify best practices and potential issues. Effectuate remedial steps." ;
             ex:designatesProcessType ex:P11137 ;
             ex:hierarchyID "13.4.4" ;
             ex:pcfID "11137" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11074 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Sustain improvement" .


###  http://example.org/apqc#PCF_11138
ex:PCF_11138 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing and choosing methodologies to identify, analyze, and improve existing processes within an organization to meet new goals and objective. Assess the various methodologies available such as process mapping, statistical process control, and simulation. Choose the most appropriate and effective methodology." ;
             ex:designatesProcessType ex:P11138 ;
             ex:hierarchyID "13.1.5.2" ;
             ex:pcfID "11138" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21453 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select process improvement methodology" .


###  http://example.org/apqc#PCF_11139
ex:PCF_11139 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the level of preparedness of the conditions, attitudes, and resources at all levels in the organization needed for change to happen successfully. Define scope of the proposed change. Select the tools for a change readiness assessment." ;
             ex:designatesProcessType ex:P11139 ;
             ex:hierarchyID "13.4.1.2" ;
             ex:pcfID "11139" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess readiness for change" .


###  http://example.org/apqc#PCF_11140
ex:PCF_11140 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and communicating with shareholders affected by the change. Consider internal and external stakeholders that will be affected by the change. Determine the amount of influence the change will have on them. Ensure the involvement of these stakeholders in the change process by effectively communicating with them. " ;
             ex:designatesProcessType ex:P11140 ;
             ex:hierarchyID "13.4.1.1" ;
             ex:pcfID "11140" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine stakeholders" .


###  http://example.org/apqc#PCF_11141
ex:PCF_11141 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying people exhibit an extraordinary interest in the adoption, implementation, and success of the change. Engage champions in each division or team. Define the roles and responsibilities for the change champions. Determine criteria for selecting change champions. Provide training sessions to champions. Reward and recognize champions." ;
             ex:designatesProcessType ex:P11141 ;
             ex:hierarchyID "13.4.1.3" ;
             ex:pcfID "11141" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify change champion(s)" .


###  http://example.org/apqc#PCF_11142
ex:PCF_11142 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Preparing a design team for implementing change throughout the organization. " ;
             ex:designatesProcessType ex:P11142 ;
             ex:hierarchyID "13.4.1.4" ;
             ex:pcfID "11142" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Form design team" .


###  http://example.org/apqc#PCF_11143
ex:PCF_11143 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the extent of the area or subject matter that the change process deals with or to which it is relevant. Establish a set of tools, processes, skills, and principles for managing the people side of change to achieve the required outcomes of the change process." ;
             ex:designatesProcessType ex:P11143 ;
             ex:hierarchyID "13.4.1.5" ;
             ex:pcfID "11143" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define scope" .


###  http://example.org/apqc#PCF_11144
ex:PCF_11144 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Using graphical and statistical tools such as pareto diagrams, process flow diagrams, cause-and-effect diagrams, check sheets, histograms, run charts, and scatter diagrams." ;
             ex:designatesProcessType ex:P11144 ;
             ex:hierarchyID "13.4.1.6" ;
             ex:pcfID "11144" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Understand current state" .


###  http://example.org/apqc#PCF_11145
ex:PCF_11145 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the state or position that the organization wants to be in after the implementation of the change. Gather necessary information about the processes, structures, and cultures. Define resource requirements." ;
             ex:designatesProcessType ex:P11145 ;
             ex:hierarchyID "13.4.1.7" ;
             ex:pcfID "11145" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define future state" .


###  http://example.org/apqc#PCF_11146
ex:PCF_11146 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Looking beyond the immediate consequences of the threat to a critical asset and placing it in the context of what is important to the organization. Identify the impact of threats to critical assets. Create risk evaluation criteria. Evaluate the impact of threats to critical assets. Incorporate probability into the risk analysis." ;
             ex:designatesProcessType ex:P11146 ;
             ex:hierarchyID "13.4.1.8" ;
             ex:pcfID "11146" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct organizational risk analysis" .


###  http://example.org/apqc#PCF_11147
ex:PCF_11147 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the culture within the organization. Adopt a quantitative, multidimensional measurement approach of an organization's culture and the aspirations for it. Diagnose cultural activities, enhance leadership sections. Integrate cultures." ;
             ex:designatesProcessType ex:P11147 ;
             ex:hierarchyID "13.4.1.9" ;
             ex:pcfID "11147" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess cultural context" .


###  http://example.org/apqc#PCF_11148
ex:PCF_11148 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and assigning the people accountable for effective change management. Hold managers accountable for ensuring change happens systematically and rigorously. Ensure that certain behaviors are rewarded or reprimanded accordingly." ;
             ex:designatesProcessType ex:P11148 ;
             ex:hierarchyID "13.4.1.12" ;
             ex:pcfID "11148" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish accountability for change management" .


###  http://example.org/apqc#PCF_11149
ex:PCF_11149 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing the circumstances or obstacles that keep the organization from progressing. Identify who and what are the resources resisting change. Identify integration failures, threats by competitive forces, and complexity failures." ;
             ex:designatesProcessType ex:P11149 ;
             ex:hierarchyID "13.4.1.13" ;
             ex:pcfID "11149" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify barriers to change" .


###  http://example.org/apqc#PCF_11150
ex:PCF_11150 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying the person(s) or thing(s)responsible for making the change possible. Consider factors such as interdependence of efforts, reward to the integrators, sharing of power and responsibility, and employee understanding of why change is essential." ;
             ex:designatesProcessType ex:P11150 ;
             ex:hierarchyID "13.4.1.14" ;
             ex:pcfID "11150" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine change enablers" .


###  http://example.org/apqc#PCF_11151
ex:PCF_11151 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing the resource requirements, and developing measures for change. Identify the financial, material, human, and informational resources needed to successfully implement the change. Develop programs, campaigns, etc. for establishing the change within the organization." ;
             ex:designatesProcessType ex:P11151 ;
             ex:hierarchyID "13.4.1.15" ;
             ex:pcfID "11151" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21457 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify resources and develop measures" .


###  http://example.org/apqc#PCF_11152
ex:PCF_11152 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Correlating the change initiative with the other initiatives. Create an alignment between the goals and objectives of the change process and that of the other initiatives." ;
             ex:designatesProcessType ex:P11152 ;
             ex:hierarchyID "13.4.2.1" ;
             ex:pcfID "11152" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess connection to other initiatives" .


###  http://example.org/apqc#PCF_11153
ex:PCF_11153 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a detailed structure summary for the purposes of managing the change. Demonstrate the reasons for the change. Define the type and scope of change. Form a change management team. Create a communication plan. " ;
             ex:designatesProcessType ex:P11153 ;
             ex:hierarchyID "13.4.2.2" ;
             ex:pcfID "11153" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop change management plans" .


###  http://example.org/apqc#PCF_11154
ex:PCF_11154 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a detailed summary of all the actions relevant to teaching a person a particular skill or type of behavior. Determine who will deliver the training. Determine when and where the apprentice or trainee needs to go to receive the structured component of the training." ;
             ex:designatesProcessType ex:P11154 ;
             ex:hierarchyID "13.4.2.3" ;
             ex:pcfID "11154" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop training plan" .


###  http://example.org/apqc#PCF_11155
ex:PCF_11155 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a plan for imparting or exchanging information relevant the to change. Define goals, objectives, and audience. Gather tools for all communications." ;
             ex:designatesProcessType ex:P11155 ;
             ex:hierarchyID "13.4.2.4" ;
             ex:pcfID "11155" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop communication plan" .


###  http://example.org/apqc#PCF_11156
ex:PCF_11156 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and designing the plan for rewarding the employees exhibiting the desired behavior. Specify rewards in recognition of service, effort, or achievement regarding the change, including bonuses, compensation, stock options, profit sharing, vacations, and flexible time." ;
             ex:designatesProcessType ex:P11156 ;
             ex:hierarchyID "13.4.2.6" ;
             ex:pcfID "11156" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop rewards/incentives plan" .


###  http://example.org/apqc#PCF_11157
ex:PCF_11157 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing a system or standard of measurement for measuring the adoption of the change. Consider activities such as the number of people who have adopted the change, how quickly have they adopted, number of unique adopters, and adopters by teams/divisions." ;
             ex:designatesProcessType ex:P11157 ;
             ex:hierarchyID "13.4.2.7" ;
             ex:pcfID "11157" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish change adoption measures" .


###  http://example.org/apqc#PCF_11158
ex:PCF_11158 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and explaining the new roles to employees. Assign roles and responsibilities to resources." ;
             ex:designatesProcessType ex:P11158 ;
             ex:hierarchyID "13.4.2.8" ;
             ex:pcfID "11158" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish/Clarify new roles" .


###  http://example.org/apqc#PCF_11159
ex:PCF_11159 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan of financial outlay for the newly defined roles. Determine the amount of capital the organization is willing to invest in effectuating these new roles, how would the roles be financed, and what would comprise the ROI from these flows. Coordinate personnel responsible for change management and the finance division." ;
             ex:designatesProcessType ex:P11159 ;
             ex:hierarchyID "13.4.2.9" ;
             ex:pcfID "11159" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11135 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify budget/roles" .


###  http://example.org/apqc#PCF_11160
ex:PCF_11160 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Kindling an organization wide commitment for effectuating the change. Effectively communicate the advantages of the desired change. Personalize the pitch for change. " ;
             ex:designatesProcessType ex:P11160 ;
             ex:hierarchyID "13.4.3.1" ;
             ex:pcfID "11160" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11136 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create commitment for improvement/change" .


###  http://example.org/apqc#PCF_11161
ex:PCF_11161 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Restructuring, redesigning, repurposing, and/or retrofitting existing business processes, activities, and frameworks in order to effectuate the desired change. Review pertinent processes from the ground up by starting with the desired result. (Build on Select a process improvement methodology [11138] to create business processes that perfectly fit with the road map for change.)" ;
             ex:designatesProcessType ex:P11161 ;
             ex:hierarchyID "13.4.3.2" ;
             ex:pcfID "11161" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11136 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Reengineer business processes and systems" .


###  http://example.org/apqc#PCF_11162
ex:PCF_11162 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Supporting the transition of personnel to new roles and the dismissal of any existing employees, necessitated for the desired change. Create an on-boarding process for seamlessly transitioning personnel to new roles. Offer orientation and training. Address any concerns. Create a structured procedure for the discharge of incumbents from their positions." ;
             ex:designatesProcessType ex:P11162 ;
             ex:hierarchyID "13.4.3.3" ;
             ex:pcfID "11162" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11136 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Support transition to new roles or exit strategies for incumbents" .


###  http://example.org/apqc#PCF_11163
ex:PCF_11163 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Monitoring activities in the change process in order to assess the performance of individual agents and the process as a whole. Oversee the implementation of activities needed for effectuating the change. Track the pace, impact, enthusiasm, reaction, and feedback over the change process." ;
             ex:designatesProcessType ex:P11163 ;
             ex:hierarchyID "13.4.3.4" ;
             ex:pcfID "11163" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11136 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor change" .


###  http://example.org/apqc#PCF_11164
ex:PCF_11164 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Monitoring the performance of improved business processes. Track the key performance indicators of the upgraded processes in order to gauge its contribution to the desired change. Expedite through the use of business process management software." ;
             ex:designatesProcessType ex:P11164 ;
             ex:hierarchyID "13.4.4.1" ;
             ex:pcfID "11164" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11137 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor improved process performance" .


###  http://example.org/apqc#PCF_11165
ex:PCF_11165 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Documenting and standardizing insights gleaned and the knowledge acquired from studying the change process already implemented. Create case studies/best practices guides from the process of implementing change. Include experienced personnel. " ;
             ex:designatesProcessType ex:P11165 ;
             ex:hierarchyID "13.4.4.2" ;
             ex:pcfID "11165" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11137 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Capture and reuse lessons learned from change process" .


###  http://example.org/apqc#PCF_11166
ex:PCF_11166 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implement corrective action to adjust the re-engineered processes for maximizing the desired impact. Adjust business processes and systems to implement the desired change." ;
             ex:designatesProcessType ex:P11166 ;
             ex:hierarchyID "13.4.4.3" ;
             ex:pcfID "11166" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11137 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Take corrective action as necessary" .


###  http://example.org/apqc#PCF_11168
ex:PCF_11168 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Refining the attributes of organizational offerings to define their value proposition for the customer. Clearly define the suite of offerings in terms of the value delivered, from the perspective of what the customer desires. Validate the benefits delivered to the customers against target market segments, using techniques such as minimum viable product. Position brands for the respective products/services, in line with their unique value proposition and aligned with customers needs." ;
             ex:designatesProcessType ex:P11168 ;
             ex:hierarchyID "3.2.1" ;
             ex:pcfID "11168" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10102 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define offering and customer value proposition" .


###  http://example.org/apqc#PCF_11169
ex:PCF_11169 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining problem(s) that the organization's products/services solve for the customers, thereby determining how they are positioned in the market. Refine the product/service concepts from the perspective of customers. Succinctly outline the problem the organization's offerings solves for the customers, making a case for why the customer should buy a product or use a service. Define the offering's unique value." ;
             ex:designatesProcessType ex:P11169 ;
             ex:hierarchyID "3.2.1.1" ;
             ex:pcfID "11169" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11168 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define offering and positioning" .


###  http://example.org/apqc#PCF_11170
ex:PCF_11170 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Boosting the attractiveness of products/services to the targeted customers, and creating a unique brand projection around these features. Identify and enhance those product/service features that reinforce the attractiveness of these offerings, for these segment of customers. Underscore the perceived value delivered to the customers by clearly specifying the relevance and desirability of these products/services. Once it has been clarified how the organization's offerings meet the customer's expectations or deliver specific benefits, position the brands around these benefits." ;
             ex:designatesProcessType ex:P11170 ;
             ex:hierarchyID "3.2.1.2" ;
             ex:pcfID "11170" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11168 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop value proposition including brand positioning for target segments" .


###  http://example.org/apqc#PCF_11171
ex:PCF_11171 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Validating the desirability of the perceived value delivered by the organization's offerings, to the targeted customer segment. Substantiate the value of the benefits accrued to the customers through the organization's offerings. Justify the value proposition in light of the targeted segments by gathering feedback (using teaser demonstrations, surveys, interviews, primary research studies, and customer case studies). Corroborate the benefits of the organization's offerings." ;
             ex:designatesProcessType ex:P11171 ;
             ex:hierarchyID "3.2.1.3" ;
             ex:pcfID "11171" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11168 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Validate value proposition with target segments" .


###  http://example.org/apqc#PCF_11172
ex:PCF_11172 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating branding collaterals and campaigns that carve a significant and differentiated presence for the organization's offerings. Create new collaterals, which include names, designs, and symbols, for their products/services. Ensure collaterals reflect the unique value proposition of the respective offerings through a consistent theme. Create advertising and promotion campaigns." ;
             ex:designatesProcessType ex:P11172 ;
             ex:hierarchyID "3.2.1.4" ;
             ex:pcfID "11172" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11168 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop new branding" .


###  http://example.org/apqc#PCF_11173
ex:PCF_11173 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan for managing the accounts of key customers in order to better maintain relationships with them. Chart a scheme for managing sales. Create a plan for administering accounts of the significant and most important customers of the organization. Coordinate the accounts of principal clients. " ;
             ex:designatesProcessType ex:P11173 ;
             ex:hierarchyID "3.5.2.2" ;
             ex:pcfID "11173" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10183 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop sales/key account plan" .


###  http://example.org/apqc#PCF_11174
ex:PCF_11174 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the organization's relationship with its customers, by systematically coordinating interactions over multiple touch points, on a regular basis. Coordinate the organization's efforts to reach out to its customers. Create and manage effective touch points for interactions from the customers, which could include emails, social-media interactions, newsletters, and direct conversations." ;
             ex:designatesProcessType ex:SalesManagementCapability ;
             ex:hierarchyID "3.5.2.4" ;
             ex:pcfID "11174" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10183 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage customer relationships" .


###  http://example.org/apqc#PCF_11175
ex:PCF_11175 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Making a report about revenues generated by the organization or business unit concerned. This process requires the organization to create a report which shows how business is generating profits. Profits are the part which is left after paying all expenses directly related to the generation of the revenue, such as producing a product, and other expenses related to conducting business activities." ;
             ex:designatesProcessType ex:P11175 ;
             ex:hierarchyID "9.1.2.6" ;
             ex:pcfID "11175" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10739 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Report on profitability" .


###  http://example.org/apqc#PCF_11179
ex:PCF_11179 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the impacts of environmental health and safety. Create and implement the EHS program. Train and educate employees of the EHS function. Oversee and manage the EHS program. " ;
             ex:designatesProcessType ex:EHSManagementCapability ;
             ex:hierarchyID "13.8" ;
             ex:pcfID "11179" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage environmental health and safety (EHS)" .


###  http://example.org/apqc#PCF_11180
ex:PCF_11180 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the impact of EHS offering--and the procedures it employs to process them--on the environment at large, as well as the health and safety of employees. Evaluate the environmental impact of the organization's products, services, and operations. Conduct health, safety, and environmental audits." ;
             ex:designatesProcessType ex:P11180 ;
             ex:hierarchyID "13.8.1" ;
             ex:pcfID "11180" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11179 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine environmental health and safety impacts" .


###  http://example.org/apqc#PCF_11181
ex:PCF_11181 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identify the requirements for regulation and shareholders. Assess future risks and opportunities. Develop a policy for the EHS program. Record and manage EHS program events." ;
             ex:designatesProcessType ex:P11181 ;
             ex:hierarchyID "13.8.2" ;
             ex:pcfID "11181" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11179 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop EHS program" .


###  http://example.org/apqc#PCF_11182
ex:PCF_11182 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conducting programs such as on-the-job training sessions, group training workshops, and online training." ;
             ex:designatesProcessType ex:P11182 ;
             ex:hierarchyID "13.8.3.5" ;
             ex:pcfID "11182" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21587 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Train and educate functional employees" .


###  http://example.org/apqc#PCF_11185
ex:PCF_11185 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the efforts and activities for remediation. This process element requires the organization to create plans for corrective action in collaboration with government agencies and pertinent professional services agencies which specialize in remediation efforts relevant to the organization's operations. Additionally, the organization needs to consult experts to validate the plan, determine resources allocation, resolve any legal concerns, and formulate a company-wide policy for remediation." ;
             ex:designatesProcessType ex:RemediationManagementCapability ;
             ex:hierarchyID "11.3" ;
             ex:pcfID "11185" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_16437 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage remediation efforts" .


###  http://example.org/apqc#PCF_11186
ex:PCF_11186 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the impact of offerings and the auxiliary operations required to process them on the immediate ecosystem and the environment at large. Study the lifecycle of the products/services offered by the organization. Estimate any affect on the environment through metrics such as a calculation of carbon footprint." ;
             ex:designatesProcessType ex:P11186 ;
             ex:hierarchyID "13.8.1.1" ;
             ex:pcfID "11186" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11180 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate environmental impact of products, services, and operations" .


###  http://example.org/apqc#PCF_11187
ex:PCF_11187 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conducting an inspection to verify that the organization adequately complies with the environmental, health, and safety standards. Audit procedures and records regarding responsibility for the environment, health, and safety." ;
             ex:designatesProcessType ex:P11187 ;
             ex:hierarchyID "13.8.1.2" ;
             ex:pcfID "11187" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11180 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct health and safety and environmental audits" .


###  http://example.org/apqc#PCF_11188
ex:PCF_11188 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining any protocols or standards to comply with, set by regulatory agencies or the organization's stakeholders. Closely examine all standards and matters of compliance relating to the environment, health, and safety." ;
             ex:designatesProcessType ex:P11188 ;
             ex:hierarchyID "13.8.2.1" ;
             ex:pcfID "11188" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11181 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify regulatory and stakeholder requirements" .


###  http://example.org/apqc#PCF_11189
ex:PCF_11189 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating any risks and opportunities that might affect the environmental, health, and safety of products/services. Leverage techniques such as cost-benefit analysis, trend extrapolation, systems analysis, social surveys, historical surveys, historical analogy, Delphi, conferences, workshops, briefings, hearings, advisory committees, moot courts, artistic judgment, on-site field investigation, scaling techniques, and scenario creation." ;
             ex:designatesProcessType ex:P11189 ;
             ex:hierarchyID "13.8.2.2" ;
             ex:pcfID "11189" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11181 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess future risks and opportunities" .


###  http://example.org/apqc#PCF_11190
ex:PCF_11190 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a plan for managing the environmental, health, and safety impact of products/services. Establish minimum requirements for the organization regarding the environment at large and the health and safety of employees. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
             ex:designatesProcessType ex:P11190 ;
             ex:hierarchyID "13.8.2.3" ;
             ex:pcfID "11190" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11181 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create EHS policy" .


###  http://example.org/apqc#PCF_11191
ex:PCF_11191 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recording and managing all events and activities associated with complying with environmental, health and safety standards. Create event calendars. Assign funds. Educate employees. Conduct events." ;
             ex:designatesProcessType ex:P11191 ;
             ex:hierarchyID "13.8.2.4" ;
             ex:pcfID "11191" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11181 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Record and manage EHS events" .


###  http://example.org/apqc#PCF_11193
ex:PCF_11193 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Administering the costs and benefits of EHS management program. Evaluate program costs to ensure that the benefits of the program always outweigh its costs. " ;
             ex:designatesProcessType ex:P11193 ;
             ex:hierarchyID "13.8.3.1" ;
             ex:pcfID "11193" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21587 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage EHS costs and benefits" .


###  http://example.org/apqc#PCF_11194
ex:PCF_11194 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Using performance techniques and indicators. Utilize number of audits or inspections performed, safety committee meetings, the number and types of findings and observations, timely preventive maintenance tasks performed, etc." ;
             ex:designatesProcessType ex:P11194 ;
             ex:hierarchyID "13.8.3.2" ;
             ex:pcfID "11194" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21587 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Measure and report EHS performance" .


###  http://example.org/apqc#PCF_11195
ex:PCF_11195 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Supporting employees in light of the organization's environmental, health, and safety policies and standards. Provide medical insurance, maternity leave, environmental education, training over safety, etc." ;
             ex:designatesProcessType ex:P11195 ;
             ex:hierarchyID "13.8.3.6" ;
             ex:pcfID "11195" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21587 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide EHS support" .


###  http://example.org/apqc#PCF_11196
ex:PCF_11196 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing a program for organizing, coordinating, and directing available resources to respond to the event. Conduct a risk assessment to identify potential emergency scenarios in order to create a program that ensures that resources are on hand--or quickly available--in case of emergencies." ;
             ex:designatesProcessType ex:P11196 ;
             ex:hierarchyID "13.8.3.3" ;
             ex:pcfID "11196" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21587 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Implement emergency response program" .


###  http://example.org/apqc#PCF_11197
ex:PCF_11197 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing a program that reduces or eliminates the creation of pollutants through increased efficiency in the use of raw materials, energy, water, or other resources. Implement a program to inspect facilities that store, manufacture, or use hazardous, toxic, or polluting materials." ;
             ex:designatesProcessType ex:P11197 ;
             ex:hierarchyID "13.8.3.4" ;
             ex:pcfID "11197" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21587 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Implement pollution prevention program" .


###  http://example.org/apqc#PCF_11201
ex:PCF_11201 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating plans for remediation efforts. Make a plan to address a case of environmental adulteration. Identify and treat the adulteration so that the area will become operational again." ;
             ex:designatesProcessType ex:P11201 ;
             ex:hierarchyID "11.3.1" ;
             ex:pcfID "11201" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create remediation plans" .


###  http://example.org/apqc#PCF_11202
ex:PCF_11202 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Discussing and soliciting advice from experts for in order to incorporate their suggestion (regarding Create remediation plans [11201])." ;
             ex:designatesProcessType ex:P11202 ;
             ex:hierarchyID "11.3.2" ;
             ex:pcfID "11202" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Contact and confer with experts" .


###  http://example.org/apqc#PCF_11203
ex:PCF_11203 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and dedicating the resources for managing remediation efforts. Discern the resources needed for remediation efforts. Dispense with resources in a sound and well-reasoned manner." ;
             ex:designatesProcessType ex:P11203 ;
             ex:hierarchyID "11.3.3" ;
             ex:pcfID "11203" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify/dedicate resources" .


###  http://example.org/apqc#PCF_11204
ex:PCF_11204 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining regulatory and legislative frameworks. Obligate the organization to remediate any damages through compensations, fines, and any other remedial efforts necessitated to correct the situations. Analyze local environmental laws, binding international covenants, etc. in order to examine legal accuracy about the rules and procedures." ;
             ex:designatesProcessType ex:P11204 ;
             ex:hierarchyID "11.3.4" ;
             ex:pcfID "11204" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Investigate legal aspects" .


###  http://example.org/apqc#PCF_11205
ex:PCF_11205 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Studying the causes of damage, which could be environmental, physical, social, etc. at country level in order to institute better policies and regulations." ;
             ex:designatesProcessType ex:P11205 ;
             ex:hierarchyID "11.3.5" ;
             ex:pcfID "11205" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Investigate damage cause" .


###  http://example.org/apqc#PCF_11206
ex:PCF_11206 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Crafting a new framework of policies and procedures for deploying remediation efforts, or change existing policies and procedures. Adapt the policy structure to the context of the apposite national and international regulatory frameworks." ;
             ex:designatesProcessType ex:P11206 ;
             ex:hierarchyID "11.3.6" ;
             ex:pcfID "11206" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11185 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Amend or create policy" .


###  http://example.org/apqc#PCF_11208
ex:PCF_11208 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Performing transactions that limit investment risk with the help of derivatives, such as options and futures contracts. Manage interest rates, foreign exchange, and exposure risks. Develop and execute hedging transactions. Evaluate and refine hedging positions. Produce hedge accounting transactions and reports. Monitor credit." ;
             ex:designatesProcessType ex:P11208 ;
             ex:hierarchyID "9.7.5" ;
             ex:pcfID "11208" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10734 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor and execute risk and hedging transactions" .


###  http://example.org/apqc#PCF_11209
ex:PCF_11209 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling risks arising from changes in the interest rate. " ;
             ex:designatesProcessType ex:P11209 ;
             ex:hierarchyID "9.7.5.2" ;
             ex:pcfID "11209" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11208 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage interest rate risk" .


###  http://example.org/apqc#PCF_11210
ex:PCF_11210 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Taking care of foreign-exchange risks. " ;
             ex:designatesProcessType ex:P11210 ;
             ex:hierarchyID "9.7.5.3" ;
             ex:pcfID "11210" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11208 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage foreign exchange risk" .


###  http://example.org/apqc#PCF_11211
ex:PCF_11211 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Taking care of exposure risks. Maintain financial investments in particular investments or a portfolios that could be risky for the organization." ;
             ex:designatesProcessType ex:P11211 ;
             ex:hierarchyID "9.7.5.4" ;
             ex:pcfID "11211" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11208 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage exposure risk" .


###  http://example.org/apqc#PCF_11213
ex:PCF_11213 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining options in the market for hedging investments. Select an option." ;
             ex:designatesProcessType ex:P11213 ;
             ex:hierarchyID "9.7.5.5.4" ;
             ex:pcfID "11213" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_20137 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate and refine hedging positions" .


###  http://example.org/apqc#PCF_11214
ex:PCF_11214 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Preparing and documenting accounts and records of all hedging investment transactions to reduce risks due to change in markets." ;
             ex:designatesProcessType ex:P11214 ;
             ex:hierarchyID "9.7.5.6" ;
             ex:pcfID "11214" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_11208 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Produce hedge accounting transactions and reports" .


###  http://example.org/apqc#PCF_11215
ex:PCF_11215 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Revising credit reports periodically for accurateness and changes that could be suggestive of duplicitous activity." ;
             ex:designatesProcessType ex:P11215 ;
             ex:hierarchyID "9.7.5.5.5" ;
             ex:pcfID "11215" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_20137 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor credit" .


###  http://example.org/apqc#PCF_11216
ex:PCF_11216 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Including the processes required to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat. Develop a more dynamic, strategic, and integrated approach to managing compliance obligations." ;
             ex:designatesProcessType ex:BusinessResiliencyCapability ;
             ex:hierarchyID "11.4" ;
             ex:pcfID "11216" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_16437 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage business resiliency" .


###  http://example.org/apqc#PCF_11221
ex:PCF_11221 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a strategy for rapidly adapting to disturbances. Maintain continuous business processes and protecting employees, assets, and overall brand equity." ;
             ex:designatesProcessType ex:P11221 ;
             ex:hierarchyID "11.4.1" ;
             ex:pcfID "11221" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop the business resilience strategy" .


###  http://example.org/apqc#PCF_11222
ex:PCF_11222 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing plans to ensure continuous business operations. " ;
             ex:designatesProcessType ex:P11222 ;
             ex:hierarchyID "11.4.2" ;
             ex:pcfID "11222" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform continuous business operations planning" .


###  http://example.org/apqc#PCF_11223
ex:PCF_11223 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing ongoing activities within the organization that are not intended to stop except for in an emergency. " ;
             ex:designatesProcessType ex:P11223 ;
             ex:hierarchyID "11.4.3" ;
             ex:pcfID "11223" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Test continuous business operations" .


###  http://example.org/apqc#PCF_11224
ex:PCF_11224 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating business operations. Determine which activities generate revenues, perform best, and provide good returns." ;
             ex:designatesProcessType ex:P11224 ;
             ex:hierarchyID "11.4.4" ;
             ex:pcfID "11224" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_11216 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain continuous business operations" .


###  http://example.org/apqc#PCF_11236
ex:PCF_11236 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Requesting customer feedback on the process of handling and resolving customer complaints. Obtain information about the effectiveness and performance of the customer complaint handling process from the customers through various means (e.g., online and by phone)." ;
             ex:designatesProcessType ex:P11236 ;
             ex:hierarchyID "6.5.2.1" ;
             ex:pcfID "11236" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10402 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Solicit customer feedback on complaint handling and resolution" .


###  http://example.org/apqc#PCF_11237
ex:PCF_11237 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the information obtained through handling and resolving complaints for development/improvement opportunities. Categorize the customer complaints data on the basis of speed, accuracy, courtesy, price, product choice, availability, hours, location, etc. Determine complaint patterns in order to diagnose areas needing enhancement." ;
             ex:designatesProcessType ex:P11237 ;
             ex:hierarchyID "6.5.2.2" ;
             ex:pcfID "11237" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10402 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze customer complaint data and identify improvement opportunities" .


###  http://example.org/apqc#PCF_11238
ex:PCF_11238 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Obtaining customer feedback/review on the quality and utility derived from the products/services after the sale is complete. Use techniques such as surveys, feedback boxes, and user activity and usability tests." ;
             ex:designatesProcessType ex:P11238 ;
             ex:hierarchyID "6.5.3.1" ;
             ex:pcfID "11238" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10403 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Gather and solicit post-sale customer feedback on products and services" .


###  http://example.org/apqc#PCF_11239
ex:PCF_11239 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the influence of advertisements on purchasing behavior. Use techniques such as surveys and product recognition tests, questionnaires or feedback flyers, and toll-free numbers in order to encourage customer interaction after the sale." ;
             ex:designatesProcessType ex:P11239 ;
             ex:hierarchyID "6.5.3.2" ;
             ex:pcfID "11239" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10403 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Solicit post-sale customer feedback on ad effectiveness" .


###  http://example.org/apqc#PCF_11240
ex:PCF_11240 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the information collected on customer satisfaction levels with products/services in order to determine areas for improvement. Examine the data and information extracted from the customer feedback and reviews to measure the satisfaction levels of the customers. Identify opportunities that could enhance the customer satisfaction levels and the overall customer service strategy." ;
             ex:designatesProcessType ex:P11240 ;
             ex:hierarchyID "6.5.3.4" ;
             ex:pcfID "11240" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10403 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze product and service satisfaction data and identify improvement opportunities" .


###  http://example.org/apqc#PCF_11241
ex:PCF_11241 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing feedback from customers on products/services to the product management team. Analyze information collected through Gather and solicit post-sale customer feedback on products/services [11238]. Share with the product management team for consideration while improving existing offerings or developing new products/services. " ;
             ex:designatesProcessType ex:P11241 ;
             ex:hierarchyID "6.5.3.5" ;
             ex:pcfID "11241" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10403 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide feedback and insights to appropriate teams (product design/development, marketing, manufacturing)" .


###  http://example.org/apqc#PCF_11243
ex:PCF_11243 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the performance and effectiveness of employee on-boarding program. Examine the performance of on-boarding program through feedback and reviews from the new employees. Create web and written forms. Obtain information through face-to-face discussions." ;
             ex:designatesProcessType ex:P11243 ;
             ex:hierarchyID "7.3.1.2" ;
             ex:pcfID "11243" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10469 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate the effectiveness of the employee onboarding program" .


###  http://example.org/apqc#PCF_11250
ex:PCF_11250 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the objectives and risks associated with a process. Delineate process goals. Determine the risks attached to it. Determine what the process is meant to accomplish, potential issues, a timeline of potential risks, the scope and potential impact of risks, etc." ;
             ex:designatesProcessType ex:P11250 ;
             ex:hierarchyID "9.8.1.4" ;
             ex:pcfID "11250" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10762 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define business process objectives and risks" .


###  http://example.org/apqc#PCF_11251
ex:PCF_11251 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the risk tolerance levels of individual units, as well as the organization as a whole. Determine the specific maximum risk to take in quantitative terms for each relevant risk subcategory, including strategic, operational, financial, and compliance risks." ;
             ex:designatesProcessType ex:P11251 ;
             ex:hierarchyID "9.8.1.5" ;
             ex:pcfID "11251" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10762 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define entity/unit risk tolerances" .


###  http://example.org/apqc#PCF_11276
ex:PCF_11276 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing the construction process to ensure that activates are on task, on budget, and are being performed with safety and quality in mind." ;
             ex:designatesProcessType ex:P11276 ;
             ex:hierarchyID "10.2.2.2" ;
             ex:pcfID "11276" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20139 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Perform construction performance management" .


###  http://example.org/apqc#PCF_11331
ex:PCF_11331 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining requirements related to the creation of the product/service. Explain potential achievements that could be made." ;
             ex:designatesProcessType ex:P11331 ;
             ex:hierarchyID "2.2.3.1" ;
             ex:pcfID "11331" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19990 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define product/service requirements" .


###  http://example.org/apqc#PCF_11417
ex:PCF_11417 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Regularly monitoring production runs of the production and/or delivery operations. " ;
             ex:designatesProcessType ex:P11417 ;
             ex:hierarchyID "2.3.3.4.1" ;
             ex:pcfID "11417" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10100 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor initial production runs" .


###  http://example.org/apqc#PCF_11418
ex:PCF_11418 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Requesting changes in the production and/or delivery operations for processing the new or revised products/services. Rectify any problems identified in the manufacturing or delivery processes (through Monitor production runs [11417]). Seek changes in components, repair machinery, optimize production lines, and tweak factory assemblies through a formal notice to the concerned division, known as an engineering change order." ;
             ex:designatesProcessType ex:P11418 ;
             ex:hierarchyID "2.3.3.3" ;
             ex:pcfID "11418" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19997 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Request engineering/process change" .


###  http://example.org/apqc#PCF_11423
ex:PCF_11423 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Learning from either a test or a full production run within the consumer market. Companies use this as an opportunity to both test and react to new products, ideas, or innovations based on the initial reaction of consumers on an individual level. Within this process, analytics are used to determine the relative success of a new product offering. Within this process, companies will launch key analytics to test a products acceptance. They will also review market performance and compare to similar products and against the business case or the financial plan. Companies can also measure the effectiveness of their supply chain network, and can apply what is learned from the post launch review to other new products, processes, and procedures to ensure and enhance the product quality." ;
             ex:designatesProcessType ex:P11423 ;
             ex:hierarchyID "2.1.2.5" ;
             ex:pcfID "11423" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10067 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct post launch review" .


###  http://example.org/apqc#PCF_11424
ex:PCF_11424 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conducting customer and market analysis to review progress and identify opportunities for increasing market position. Track and review product/service response through sales reports, website statistics, direct response from customers, and survey reports." ;
             ex:designatesProcessType ex:P11424 ;
             ex:hierarchyID "2.1.2.5.2" ;
             ex:pcfID "11424" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_11423 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review market performance" .


###  http://example.org/apqc#PCF_11425
ex:PCF_11425 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the performance of supply chain to all departments and logistics from input to shop floor. Seeking performance reviews at each intersection and communication channels. Review effectiveness of supply chain and distribution to check if it is meeting the demands of the various groups and organizations that are concerned with its activities (groups might include customers, partners, suppliers, and vendors)." ;
             ex:designatesProcessType ex:P11425 ;
             ex:hierarchyID "2.1.2.5.3" ;
             ex:pcfID "11425" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_11423 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review effectiveness of supply chain and distribution network" .


###  http://example.org/apqc#PCF_11426
ex:PCF_11426 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying the quality and performance of the product/service delivered to customers. Analyze data from the customer feedback, audits, measures of customer satisfaction (such as product quality complaints and recalls), and organizational policies on delivery." ;
             ex:designatesProcessType ex:P11426 ;
             ex:hierarchyID "2.1.2.5.5" ;
             ex:pcfID "11426" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_11423 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review quality and performance of the product/service" .


###  http://example.org/apqc#PCF_11427
ex:PCF_11427 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating organization's financial reports and financial reporting processes. Review and document the ROI catered by the product/service delivery to the customer in the market." ;
             ex:designatesProcessType ex:P11427 ;
             ex:hierarchyID "2.1.2.5.6" ;
             ex:pcfID "11427" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_11423 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct financial review" .


###  http://example.org/apqc#PCF_11428
ex:PCF_11428 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing the steps involved in the development of new product, its effect on existing product, resources, and functions related to the development of the new product until its sale in the competitive market place." ;
             ex:designatesProcessType ex:P11428 ;
             ex:hierarchyID "2.1.2.5.7" ;
             ex:pcfID "11428" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_11423 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct new product development process assessment" .


###  http://example.org/apqc#PCF_11465
ex:PCF_11465 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing category management strategies for customers through the use of consumer insights and understanding of customer specifics. Develop consumer and channel insights. Establish long term strategies, objectives and targets across the brand." ;
             ex:designatesProcessType ex:P11465 ;
             ex:hierarchyID "3.4.2.4" ;
             ex:pcfID "11465" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10130 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop customer trade strategy and customer objectives/targets" .


