###  http://example.org/apqc#PCF_21463
ex:PCF_21463 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Confirm data models represent the hypothesis supporting the original research question" ;
             ex:designatesProcessType ex:P21463 ;
             ex:hierarchyID "13.7.8" ;
             ex:pcfID "21463" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20959 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Review data models with stakeholders" .


###  http://example.org/apqc#PCF_21464
ex:PCF_21464 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Make required changes to data model based upon review with stakeholders." ;
             ex:designatesProcessType ex:P21464 ;
             ex:hierarchyID "13.7.9" ;
             ex:pcfID "21464" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_20959 ;
             skos:inScheme apqc:PCF ;
