###  http://example.org/apqc#PCF_17040
ex:PCF_17040 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a conceptual framework of the organization's business activity and strategic vision with long-term applicability. Scout the organization's internal capabilities, as well as the customer's needs and desires, to identify a fit that can be used to advance a conceptual structure of the organization's business activity. Conduct analysis in light of relevant externalities and large-scale shifts in the market landscape." ;
             ex:designatesProcessType ex:P17040 ;
             ex:hierarchyID "1.1" ;
             ex:pcfID "17040" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10002 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define the business concept and long-term vision" .


###  http://example.org/apqc#PCF_17041
ex:PCF_17041 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Supervising and overseeing the plan for internal activities such as production, inventory, and staffing. Set the quantity of items to produce each week of a short-range planning horizon." ;
             ex:designatesProcessType ex:P17041 ;
             ex:hierarchyID "4.1.4.3" ;
             ex:pcfID "17041" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10224 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain master production schedule" .


###  http://example.org/apqc#PCF_17042
ex:PCF_17042 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Maintaining master data of finished products and inventory. Identify the requirements of finished products at the destination, as well as partner requirements. Calculate the consolidation at source. Manage replenishment planning. Create and administer a dispatch plan. Calculate load plans for destinations and partners. Manage the cost of supplying these products. Ensure effective utilization of capacity." ;
             ex:designatesProcessType ex:P17042 ;
             ex:hierarchyID "4.1.5" ;
             ex:pcfID "17042" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10215 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan distribution requirements" .


###  http://example.org/apqc#PCF_17043
ex:PCF_17043 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating strategies for the HR function. Create and implement strategies for managing the work force. Supervise and enhance the strategies, plans, and policies supporting the HR function. Developing models for managing competency levels of the HR of the organization." ;
             ex:hierarchyID "7.1" ;
             ex:pcfID "17043" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10007 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and manage human resources planning, policies, and strategies" .


###  http://example.org/apqc#PCF_17045
ex:PCF_17045 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and executing strategies and policies for smooth administration of work force. Determine and gather skill requirements. Plan the requirements for employee resourcing per unit. Create compensation, succession, HR program, and employee diversity plans. Develop and administer policies for HR. Develop benefits for employees. Create models for work force strategies." ;
             ex:designatesProcessType ex:P17045 ;
             ex:hierarchyID "7.1.2" ;
             ex:pcfID "17045" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17043 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and implement workforce strategy and policies" .


###  http://example.org/apqc#PCF_17046
ex:PCF_17046 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and implementing the tools for managing the competency levels of HR. Design a model for integrating HR planning with business planning. Assess current HR capacity based on the competencies against the capacity needed to achieve the vision, mission, and business goals of the organization. Consider factors such as employee development, career path, compensation policies, and performance management." ;
             ex:designatesProcessType ex:P17046 ;
             ex:hierarchyID "7.1.4" ;
             ex:pcfID "17046" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17043 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop competency management models" .


###  http://example.org/apqc#PCF_17047
ex:PCF_17047 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and managing a recruiting strategy where current employees are rewarded for referring qualified candidates for employment. " ;
             ex:hierarchyID "7.2.2.4" ;
             ex:pcfID "17047" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10440 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage employee referral programs" .


###  http://example.org/apqc#PCF_17048
ex:PCF_17048 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and maintaining channels for recruiting. Extract the best out of every recruitment channel. Manage all the processes related to all the sourcing channels." ;
             ex:hierarchyID "7.2.2.5" ;
