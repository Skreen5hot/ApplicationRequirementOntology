cco:ont00000005 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000005 rdf:type owl:Class .
cco:ont00000005 rdfs:label "Act"@en .
cco:ont00000005 rdfs:subClassOf obo:BFO_0000015 .
cco:ont00000005 skos:definition "A Process in which at least one Agent plays a causative role."@en .

cco:ont00000051 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000051 rdf:type owl:Class .
cco:ont00000051 rdfs:label "Act of Construction"@en .
cco:ont00000051 rdfs:subClassOf cco:ont00000908 .
cco:ont00000051 skos:definition "An Act of Material Artifact Processing wherein Material Artifacts are built on site as prescribed by some contract."@en .
cco:ont00000051 skos:scopeNote "An Act of Construction typically involves the production of only one or a limited number of goods, such as in the construction of an airport or a community of condominiums."@en .

cco:ont00000065 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000065 rdf:type owl:Class .
cco:ont00000065 rdfs:label "Act of Location Change"@en .
cco:ont00000065 rdfs:subClassOf cco:ont00000357 .
cco:ont00000065 skos:definition "An Act of Motion in which the location of some Object is changed by some Agent."@en .

cco:ont00000117 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00000117 rdf:type owl:Class .
cco:ont00000117 rdfs:label "Information Processing Artifact"@en .
cco:ont00000117 rdfs:subClassOf cco:ont00000995 .
cco:ont00000117 skos:definition "A Material Artifact that is designed to use algorithms to transform some Information Content Entity into another Information Content Entity."@en .

cco:ont00000151 cco:ont00001754 "http://www.merriam-webster.com/dictionary/report" .
cco:ont00000151 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000151 rdf:type owl:Class .
cco:ont00000151 rdfs:label "Act of Reporting"@en .
cco:ont00000151 rdfs:subClassOf cco:ont00000379 .
cco:ont00000151 skos:definition "An Act of Representative Communication performed by giving a detailed account or statement."@en .

cco:ont00000187 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000187 rdf:type owl:Class .
cco:ont00000187 rdfs:label "Authority Role"@en .
cco:ont00000187 rdfs:subClassOf obo:BFO_0000023 .
cco:ont00000187 skos:definition "A Role that is realized by Processes which create, modify, transfer, or eliminate Process Regulations or other Authority Roles, and inheres in an Agent in virtue of collective acceptance of that Agent's ability to issue binding directives."@en .
cco:ont00000187 skos:scopeNote "Authority Roles are externally grounded in a social group's collective acceptance of the binding force of the agent's directives. This acceptance can be direct or indirect (e.g., by accepting a procedure for deputizing authority). Such collective acceptance need not be explicit or cognized; rather, collective acceptance can be expressed in the dispositions and attitudes of people toward that agent's directives. In many cases, the directives issued by Authority Roles are backed by threats of punishment or sanction for failure to comply, but the issuing of a directive plus a threat is not sufficient for authority. Rather, an agent's authority must be accepted either directly or indirectly through the acceptance of a procedure for bestowing authority (e.g., elections)."@en .

cco:ont00000192 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00000192 rdf:type owl:Class .
cco:ont00000192 rdfs:label "Facility"@en .
cco:ont00000192 rdfs:subClassOf cco:ont00000995 .
cco:ont00000192 skos:definition "A Material Artifact that is designed as a building or campus dedicated to some specific purpose."@en .

cco:ont00000228 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000228 rdf:type owl:Class .
cco:ont00000228 rdfs:label "Planned Act"@en .
cco:ont00000228 rdfs:subClassOf cco:ont00000005 .
cco:ont00000228 skos:altLabel "Intentional Act"@en .
cco:ont00000228 skos:definition "An Act in which at least one Agent plays a causative role and which is prescribed by some Directive Information Content Entity held by at least one of the Agents."@en .

cco:ont00000234 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI .
cco:ont00000234 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000234 rdf:type owl:Class .
cco:ont00000234 rdfs:label "Act of Training"@en .
cco:ont00000234 rdfs:subClassOf cco:ont00000228 .
cco:ont00000234 skos:definition "A Planned Act in which knowledge, skills or values are imparted from one or more Agents to at least one other Agent."@en .

cco:ont00000253 cco:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000178"^^xsd:anyURI .
cco:ont00000253 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00000253 rdf:type owl:Class .
cco:ont00000253 rdfs:label "Information Bearing Entity"@en .
cco:ont00000253 rdfs:subClassOf obo:BFO_0000030 .
cco:ont00000253 skos:altLabel "IBE"@en .
cco:ont00000253 skos:altLabel "Information Carrying Entity"@en .
cco:ont00000253 skos:definition "An Object upon which an Information Content Entity generically depends."@en .
cco:ont00000253 skos:scopeNote "This class continues to use the word ‘bearing’ in its rdfslabel because of potential confusion with the acronym ‘ICE’, which is widely used for information content entity."@en .

cco:ont00000300 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000300 rdf:type owl:Class .
cco:ont00000300 rdfs:label "Group of Agents"@en .
cco:ont00000300 rdfs:subClassOf obo:BFO_0000027 .
cco:ont00000300 skos:definition "An Object Aggregate that has only Agents as member parts."@en .

cco:ont00000345 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000345 rdf:type owl:Class .
cco:ont00000345 rdfs:label "Act of Measuring"@en .
cco:ont00000345 rdfs:subClassOf cco:ont00000228 .
cco:ont00000345 skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en .
cco:ont00000345 skos:example "putting an object on a scale to measure its weight in kilograms" .
cco:ont00000345 skos:example "rating Hollywood movies on a 1 to 5 star scale" .
cco:ont00000345 skos:example "using a tape measure to determine the height and width of a doorway in inches" .

cco:ont00000357 cco:ont00001754 "http://www.merriam-webster.com/dictionary/motion" .
cco:ont00000357 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000357 rdf:type owl:Class .
cco:ont00000357 rdfs:label "Act of Motion"@en .
cco:ont00000357 rdfs:subClassOf cco:ont00000228 .
cco:ont00000357 skos:definition "A Planned Act by which an Agent causes the position or location of some Object to change."@en .

cco:ont00000366 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000366 rdf:type owl:Class .
cco:ont00000366 rdfs:label "Act of Information Processing"@en .
cco:ont00000366 rdfs:subClassOf cco:ont00000228 .
cco:ont00000366 skos:definition "A Planned Act in which one or more input Information Content Entities are received, manipulated, transferred, or stored by an Agent."@en .

cco:ont00000371 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000371 rdf:type owl:Class .
cco:ont00000371 rdfs:label "Act of Prediction"@en .
cco:ont00000371 rdfs:subClassOf cco:ont00000228 .
cco:ont00000371 skos:definition "A Planned Act that involves the generation of a Predictive Information Content entity that is intended to describe an uncertain possible future event, value, entity, or attribute of an entity."@en .
cco:ont00000371 skos:example "a chess master predicting the next 8 moves his opponent will make" .
cco:ont00000371 skos:example "predicting that a particular stock will double in value over the next fiscal quarter" .
cco:ont00000371 skos:example "using sample exit polls data to predict the winners of an election" .
cco:ont00000371 skos:scopeNote "An Act of Prediction may involve the use of some or no relevant information. An Act of Prediction that utilizes relevant information may also be (or at least involve) an Act of Estimation. Hence, these two classes are not disjoint. Furthermore, neither class subsumes the other since estimates can be made about existing entities and not all predictions produce measurements (e.g. predicting that it will rain tomorrow)."@en .
cco:ont00000371 skos:scopeNote "Predictions can only be made about things that are not yet the case (i.e. future things) and are further restricted to being about things that do not have a probability of either 1 (necessary) or 0 (impossible). For example, assuming that no organism is immortal, one cannot predict of a given organism that it will eventually die; however, one may predict uncertain things about the organism's eventual death, such as its precise cause or time."@en .

cco:ont00000379 cco:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" .
cco:ont00000379 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000379 rdf:type owl:Class .
cco:ont00000379 rdfs:label "Act of Representative Communication"@en .
cco:ont00000379 rdfs:subClassOf cco:ont00000402 .
cco:ont00000379 skos:definition "An Act of Communication that commits a speaker to the truth of the expressed content."@en .
cco:ont00000379 skos:scopeNote "Examples: affirming, alleging, announcing, answering, attributing, claiming, classifying, concurring, confirming, conjecturing, denying, disagreeing, disclosing, disputing, identifying, informing, insisting, predicting, ranking, reporting, stating, stipulating"@en .

cco:ont00000402 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communication&oldid=1063752020"^^xsd:anyURI .
cco:ont00000402 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000402 rdf:type owl:Class .
cco:ont00000402 rdfs:label "Act of Communication"@en .
cco:ont00000402 rdfs:subClassOf cco:ont00000228 .
cco:ont00000402 skos:definition "A Planned Act in which the objective is to create a concretization of some Information Content Entity in one or more recipients."@en .
cco:ont00000402 skos:scopeNote "Act of Communication is not intended to be a success term - a term that only applies when the act it denotes is successful. While successful communication is the goal, it is important that instances of this class can include both better and worse communication acts as well attempted communications that fail altogether."@en .

cco:ont00000408 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000408 rdf:type owl:Class .
cco:ont00000408 rdfs:label "Government Organization"@en .
cco:ont00000408 rdfs:subClassOf cco:ont00001180 .
cco:ont00000408 skos:definition "An Organization that is part of a Government and is responsible for the oversight or administration of specific governmental functions."@en .

cco:ont00000433 cco:ont00001754 "http://en.wiktionary.org/wiki/associate" .
cco:ont00000433 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000433 rdf:type owl:Class .
cco:ont00000433 rdfs:label "Act of Association"@en .
cco:ont00000433 rdfs:subClassOf cco:ont00001327 .
cco:ont00000433 skos:definition "A Social Act wherein an Agent unites with some other Agent in a Planned Act, enterprise or business."@en .

cco:ont00000449 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Remuneration&oldid=1033306001"^^xsd:anyURI .
cco:ont00000449 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000449 rdf:type owl:Class .
cco:ont00000449 rdfs:label "Act of Remuneration"@en .
cco:ont00000449 rdfs:subClassOf cco:ont00001334 .
cco:ont00000449 skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Employer) to compensate another Agent (the Employee) for the services they perform for the Employer."@en .
cco:ont00000449 skos:scopeNote "Comment: Remuneration normally consists of salary or hourly wages, but also applies to commission, stock options, fringe benefits, etc."@en .

cco:ont00000457 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00000457 rdf:type owl:Class .
cco:ont00000457 rdfs:label "Portion of Material"@en .
cco:ont00000457 rdfs:subClassOf cco:ont00001084 .
cco:ont00000457 skos:definition "A Portion of Processed Material that was produced to be used as the input for another Act of Material Artifact Processing."@en .

cco:ont00000476 cco:ont00001754 "http://en.wikipedia.org/wiki/Objective_(goal)" .
cco:ont00000476 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000476 rdf:type owl:Class .
cco:ont00000476 rdfs:label "Objective"@en .
cco:ont00000476 rdfs:subClassOf cco:ont00000965 .
cco:ont00000476 skos:definition "A Prescriptive Information Content Entity that prescribes some projected state that some Agent intends to achieve."@en .

cco:ont00000506 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000506 rdf:type owl:Class .
cco:ont00000506 rdfs:label "Contractor Role"@en .
cco:ont00000506 rdfs:subClassOf obo:BFO_0000023 .
cco:ont00000506 skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents entering into a Contract to provide materials or labor to perform a service or complete a task."@en .
cco:ont00000506 skos:scopeNote "A Contractor Role differs from an Occupation Role in at least two ways. First, the Contract that binds the two parties together is not one of employment. Second, a Contractor Role is occupationally neutral in that an Agent can be contracted to perform any number of Occupational Roles."@en .

cco:ont00000511 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000511 rdf:type owl:Class .
cco:ont00000511 rdfs:label "Act of Planning"@en .
cco:ont00000511 rdfs:subClassOf cco:ont00000228 .
cco:ont00000511 skos:definition "A Planned Act that involves making a Plan to achieve some specified Objective."@en .

cco:ont00000537 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI .
cco:ont00000537 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00000537 rdf:type owl:Class .
cco:ont00000537 rdfs:label "Financial Instrument"@en .
cco:ont00000537 rdfs:subClassOf cco:ont00000995 .
cco:ont00000537 skos:definition "A Material Artifact that is designed to be a tradeable asset and that is legally sanctioned."@en .

cco:ont00000566 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000566 rdf:type owl:Class .
cco:ont00000566 rdfs:label "Act of Artifact Employment"@en .
cco:ont00000566 rdfs:subClassOf cco:ont00000228 .
cco:ont00000566 skos:definition "A Planned Act of using a Material Artifact."@en .

cco:ont00000568 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000568 rdf:type owl:Class .
cco:ont00000568 rdfs:label "Organization Capability"@en .
cco:ont00000568 rdfs:subClassOf cco:ont00001379 .
cco:ont00000568 skos:definition "An Agent Capability that inheres in an Organization to the extent of that Organization's capacity to realize it in Intentional Acts of a certain type."@en .

cco:ont00000588 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Media&oldid=1062799283"^^xsd:anyURI .
cco:ont00000588 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000588 rdf:type owl:Class .
cco:ont00000588 rdfs:label "Act of Mass Media Communication"@en .
cco:ont00000588 rdfs:subClassOf cco:ont00000402 .
cco:ont00000588 skos:definition "An Act of Communication intended to reach a large audience using a medium such as the internet, television, radio, newspaper, or magazine."@en .

cco:ont00000595 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000595 rdf:type owl:Class .
cco:ont00000595 rdfs:label "Act of Cargo Transportation"@en .
cco:ont00000595 rdfs:subClassOf cco:ont00000065 .
cco:ont00000595 skos:definition "An Act of Location Change wherein some Payload is moved from one location to another."@en .

cco:ont00000626 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00000626 rdf:type owl:Class .
cco:ont00000626 rdfs:label "Predictive Information Content Entity"@en .
cco:ont00000626 rdfs:subClassOf cco:ont00000853 .
cco:ont00000626 skos:altLabel "Prediction Information Content Entity"@en .
cco:ont00000626 skos:altLabel "Prediction"@en .
cco:ont00000626 skos:definition "A Descriptive Information Content Entity that describes an uncertain future event."@en .
cco:ont00000626 skos:scopeNote "Since predictions are inherently about not-yet-existant things, the Modal Relation Ontology term 'describes' (i.e. mro:describes) should be used (instead of the standard cco:describes) to relate instances of Predictive Information Content Entity to the entities they are about."@en .

cco:ont00000636 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000636 rdf:type owl:Class .
cco:ont00000636 rdfs:label "Act of Appraisal"@en .
cco:ont00000636 rdfs:subClassOf cco:ont00000345 .
cco:ont00000636 skos:definition "An Act of Measuring that involves evaluating, assessing, estimating, or judging the nature, value, importance, condition, or quality of something or someone."@en .
cco:ont00000636 skos:example "a food critic rating the quality of a restaurant's ambiance, service, and food" .
cco:ont00000636 skos:example "a mechanic assessing whether a damaged vehicle is repairable" .
cco:ont00000636 skos:example "an insurance agent appraising the financial value of a building" .
cco:ont00000636 skos:scopeNote "In the context of an Act of Appraisal, the terms 'value', 'condition', and 'quality' do not have the same meanings as their counterparts that are defined in the Common Core Ontologies. For example, a knife may be appraised to be of high quality if it is sharp and sturdy or to be of inferior quality if it is dull or fragile."@en .
cco:ont00000636 skos:scopeNote "Note that, while most if not all Acts of Appraisal involve some estimating and many Acts of Estimation involve some appraising (i.e. these classes are not disjoint), neither class subsumes the other. For example, some Acts of Appraisal (e.g. a tax assessor appraising the value of a building) impart a normative element to the measured value while others (e.g. a gustatory appraisal that fresh green beans taste better than canned green beans) involve complete information. Furthermore, many Acts of Estimation (e.g. estimating the height of a tree) are concerned solely with determining a numerical value (as opposed to the nature, value, importance, condition, or quality)."@en .

cco:ont00000684 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Contract&oldid=1061365227"^^xsd:anyURI .
cco:ont00000684 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000684 rdf:type owl:Class .
cco:ont00000684 rdfs:label "Act of Contract Formation"@en .
cco:ont00000684 rdfs:subClassOf cco:ont00000821 .
cco:ont00000684 skos:definition "An Act of Promising having a lawful object entered into voluntarily by two or more agents with legal capacity, each of whom intends to create one or more legal obligations between them."@en .

cco:ont00000713 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle&oldid=1063682179"^^xsd:anyURI .
cco:ont00000713 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00000713 rdf:type owl:Class .
cco:ont00000713 rdfs:label "Vehicle"@en .
cco:ont00000713 rdfs:subClassOf cco:ont00000995 .
cco:ont00000713 skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another by conveying them there."@en .

cco:ont00000751 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000751 rdf:type owl:Class .
cco:ont00000751 rdfs:label "Action Permission"@en .
cco:ont00000751 rdfs:subClassOf cco:ont00001324 .
cco:ont00000751 skos:altLabel "Authorization"@en .
cco:ont00000751 skos:altLabel "License"@en .
cco:ont00000751 skos:definition "A Process Regulation that permits some Process."@en .

cco:ont00000821 cco:ont00001754 "http://www.merriam-webster.com/dictionary/promise" .
cco:ont00000821 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000821 rdf:type owl:Class .
cco:ont00000821 rdfs:label "Act of Promising"@en .
cco:ont00000821 rdfs:subClassOf cco:ont00001162 .
cco:ont00000821 skos:definition "An Act of Commissive Communication performed by declaring that the promising agent will do, or refrain from doing, the specified action."@en .

cco:ont00000836 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000836 rdf:type owl:Class .
cco:ont00000836 rdfs:label "Act of Financial Instrument Use"@en .
cco:ont00000836 rdfs:subClassOf cco:ont00000566 .
cco:ont00000836 skos:definition "An Act of Artifact Employment in which some Agent uses some Financial Instrument."@en .

cco:ont00000853 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00000853 owl:disjointWith cco:ont00000965 .
cco:ont00000853 rdf:type owl:Class .
cco:ont00000853 rdfs:label "Descriptive Information Content Entity"@en .
cco:ont00000853 rdfs:subClassOf cco:ont00000958 .
cco:ont00000853 skos:altLabel "Descriptive ICE"@en .
cco:ont00000853 skos:definition "An Information Content Entity that describes some Entity."@en .

cco:ont00000884 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Loan&oldid=1063513958"^^xsd:anyURI .
cco:ont00000884 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000884 rdf:type owl:Class .
cco:ont00000884 rdfs:label "Act of Loaning"@en .
cco:ont00000884 rdfs:subClassOf cco:ont00000836 .
cco:ont00000884 skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is given by an Agent (the Creditor) to another Agent (the Debtor) in order to receive Repayments from the Debtor which are of greater Financial Value."@en .

cco:ont00000908 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000908 rdf:type owl:Class .
cco:ont00000908 rdfs:label "Act of Material Artifact Processing"@en .
cco:ont00000908 rdfs:subClassOf cco:ont00000228 .
cco:ont00000908 skos:definition "A Planned Act of performing a series of physical operations on a material artifact in order to change or preserve the artifact."@en .

cco:ont00000950 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000950 rdf:type owl:Class .
cco:ont00000950 rdfs:label "Act of Maintenance"@en .
cco:ont00000950 rdfs:subClassOf cco:ont00000970 .
cco:ont00000950 skos:definition "An Act of Artifact Modification in which a Material Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions."@en .

cco:ont00000958 cco:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000030" .
cco:ont00000958 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00000958 rdf:type owl:Class .
cco:ont00000958 rdfs:label "Information Content Entity"@en .
cco:ont00000958 rdfs:subClassOf obo:BFO_0000031 .
cco:ont00000958 skos:altLabel "ICE"@en .
cco:ont00000958 skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en .
cco:ont00000958 skos:scopeNote "Information Content Entity is here intended to be a class of Entities whose instances are the informational content of Information Bearing Entities. For example, three instances of information bearers -- such as a bar chart, color-coded map, and a written report -- each of which lists the GDP of Countries for the year 2010 are each different carriers of the same information content. It is this content that is generically dependent upon its carrier. This treatment of Informational Content Entity (cf. the Information Artifact Ontology) leads to a principle of subtyping based upon the relationship that ICE's have with the Entity they are about rather than characteristics such as format, language, measurement scale, or media. The latter are treated here as being Qualities of bearers."@en .

cco:ont00000965 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00000965 rdf:type owl:Class .
cco:ont00000965 rdfs:label "Prescriptive Information Content Entity"@en .
cco:ont00000965 rdfs:subClassOf cco:ont00000958 .
cco:ont00000965 skos:altLabel "Directive ICE"@en .
cco:ont00000965 skos:definition "An Information Content Entity that prescribes some Entity."@en .

cco:ont00000970 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00000970 rdf:type owl:Class .
cco:ont00000970 rdfs:label "Act of Artifact Modification"@en .
cco:ont00000970 rdfs:subClassOf cco:ont00000908 .
cco:ont00000970 skos:definition "An Act of Material Artifact Processing in which an existing Material Artifact is acted upon in a manner that changes, adds, or removes one or more of its Qualities, Dispositions, or Functions."@en .
cco:ont00000970 skos:scopeNote "Excluded from this class are instances of role change or role creation such as the introduction of an artifact as a piece of evidence in a trial or the loading of artifacts onto a ship for transport."@en .

cco:ont00000974 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Plan&oldid=1047320560"^^xsd:anyURI .
cco:ont00000974 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000974 rdf:type owl:Class .
cco:ont00000974 rdfs:label "Plan"@en .
cco:ont00000974 rdfs:subClassOf cco:ont00000965 .
cco:ont00000974 skos:definition "A Prescriptive Information Content Entity that prescribes some set of intended Intentional Acts through which some Agent expects to achieve some Objective."@en .

cco:ont00000980 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00000980 rdf:type owl:Class .
cco:ont00000980 rdfs:label "Portion of Waste Material"@en .
cco:ont00000980 rdfs:subClassOf cco:ont00001084 .
cco:ont00000980 skos:definition "A Portion of Processed Material that serves no further use in terms of the initial user's own purposes of production, transformation, or consumption such that the Agent wants to dispose of it."@en .

cco:ont00000984 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00000984 rdf:type owl:Class .
cco:ont00000984 rdfs:label "Occupation Role"@en .
cco:ont00000984 rdfs:subClassOf obo:BFO_0000023 .
cco:ont00000984 skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill within the context of some Act of Employment."@en .

cco:ont00000995 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00000995 rdf:type owl:Class .
cco:ont00000995 rdfs:label "Material Artifact"@en .
cco:ont00000995 rdfs:subClassOf obo:BFO_0000040 .
cco:ont00000995 skos:definition "A Material Entity that was designed by some Agent to realize a certain Function."@en .

cco:ont00001017 cco:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en .
cco:ont00001017 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001017 rdf:type owl:Class .
cco:ont00001017 rdfs:label "Agent"@en .
cco:ont00001017 rdfs:subClassOf obo:BFO_0000040 .
cco:ont00001017 skos:definition "A Material Entity that bears an Agent Capability."@en .

cco:ont00001075 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00001075 rdf:type owl:Class .
cco:ont00001075 rdfs:label "Act of Training Instruction"@en .
cco:ont00001075 rdfs:subClassOf cco:ont00000234 .
cco:ont00001075 skos:definition "An Act of Training performed by an Agent by imparting knowledge to another Agent."@en .

cco:ont00001084 cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .
cco:ont00001084 rdf:type owl:Class .
cco:ont00001084 rdfs:label "Portion of Processed Material"@en .
cco:ont00001084 rdfs:subClassOf cco:ont00000995 .
cco:ont00001084 skos:definition "A Material Artifact that is the output of an Act of Material Artifact Processing."@en .

cco:ont00001158 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00001158 rdf:type owl:Class .
cco:ont00001158 rdfs:label "Act of Data Transformation"@en .
cco:ont00001158 rdfs:subClassOf cco:ont00000366 .
cco:ont00001158 skos:definition "An Act of Information Processing in which an algorithm is executed to act upon one or more input Information Content Entities into one or more output Information Content Entities."@en .
cco:ont00001158 skos:scopeNote "It is not a requirement that the output Information Content Entity(ies) be qualitatively distinct from the input(s) as a result of an Act of Data Transformation, though doing so is typically the goal of performing this Act. Consider, for example, selecting a column in an Excel spreadsheet then executing the \\\"Remove Duplicates\\\" Algorithm on it. The intent is to remove rows in that column containing duplicate content. If no duplicate values are present, the information in the column remains unchanged but an Act of Data Transformation was nonetheless performed."@en .

cco:ont00001162 cco:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" .
cco:ont00001162 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00001162 rdf:type owl:Class .
cco:ont00001162 rdfs:label "Act of Commissive Communication"@en .
cco:ont00001162 rdfs:subClassOf cco:ont00000402 .
cco:ont00001162 skos:definition "An Act of Communication in which an Agent commits themselves to doing, or refraining from doing, some future action."@en .
cco:ont00001162 skos:scopeNote "Examples: agreeing, betting, guaranteeing, inviting, offering, promising, swearing, volunteering"@en .

cco:ont00001180 cco:ont00001754 "http://purl.obolibrary.org/obo/OBI_0000245" .
cco:ont00001180 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001180 rdf:type owl:Class .
cco:ont00001180 rdfs:label "Organization"@en .
cco:ont00001180 rdfs:subClassOf cco:ont00000300 .
cco:ont00001180 skos:definition "A Group of Agents which can be the bearer of roles, has members, and has a set of organization rules."@en .
cco:ont00001180 skos:scopeNote "Members of organizations are either Organizations themselves or individual Persons. Members can bear specific Organization Member Roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the Organization by the organization members."@en .

cco:ont00001324 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001324 rdf:type owl:Class .
cco:ont00001324 rdfs:label "Process Regulation"@en .
cco:ont00001324 rdfs:subClassOf cco:ont00000965 .
cco:ont00001324 skos:definition "A Prescriptive Information Content Entity that prescribes an Process as required, prohibited, or permitted, and is the output of an Process which realizes some Authority Role."@en .
cco:ont00001324 skos:scopeNote "Although regulations often regulate processes which involve agents--as the regulating or regulated participant--it is unclear how causally active an agents need to be in those regulated processes. For example, it is not clear how causally active a human agent is in the process of a traffic light regulating the motion of a self-driving vehicle."@en .

cco:ont00001327 cco:ont00001754 "http://en.wiktionary.org/wiki/commually" .
cco:ont00001327 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00001327 rdf:type owl:Class .
cco:ont00001327 rdfs:label "Social Act"@en .
cco:ont00001327 rdfs:subClassOf cco:ont00000228 .
cco:ont00001327 skos:definition "A Planned Act having an objective that affects, is performed by, or is performed on behalf of, a community or group of Persons."@en .

cco:ont00001334 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Purchasing&oldid=1050163120"^^xsd:anyURI .
cco:ont00001334 cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .
cco:ont00001334 rdf:type owl:Class .
cco:ont00001334 rdfs:label "Act of Purchasing"@en .
cco:ont00001334 rdfs:subClassOf cco:ont00000836 .
cco:ont00001334 skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is used by an Agent (the Purchaser) to acquire a good or service from another Agent (the Provider)."@en .

cco:ont00001379 cco:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en .
cco:ont00001379 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001379 rdf:type owl:Class .
cco:ont00001379 rdfs:label "Agent Capability"@en .
cco:ont00001379 rdfs:subClassOf obo:BFO_0000017 .
cco:ont00001379 skos:definition "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."@en .

cco:ont00001754 rdf:type owl:AnnotationProperty .
cco:ont00001754 rdfs:label "definition source"@en .

cco:ont00001760 rdf:type owl:AnnotationProperty .
cco:ont00001760 rdfs:label "is curated in ontology"@en .

cco:ont00001777 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001777 owl:inverseOf cco:ont00001857 .
cco:ont00001777 rdf:type owl:ObjectProperty .
cco:ont00001777 rdfs:domain obo:BFO_0000015 .
cco:ont00001777 rdfs:label "has process part"@en .
cco:ont00001777 rdfs:range obo:BFO_0000015 .
cco:ont00001777 rdfs:subPropertyOf obo:BFO_0000117 .
cco:ont00001777 skos:definition "x has process part y =Def y is part of process x."@en .

cco:ont00001787 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001787 owl:inverseOf cco:ont00001833 .
cco:ont00001787 rdf:type owl:ObjectProperty .
cco:ont00001787 rdfs:domain cco:ont00001017 .
cco:ont00001787 rdfs:label "agent in"@en .
cco:ont00001787 rdfs:range obo:BFO_0000015 .
cco:ont00001787 rdfs:subPropertyOf obo:BFO_0000056 .
cco:ont00001787 skos:definition "x agent_in y iff y is an instance of Process and x is an instance of Agent, such that x is causally active in y."@en .

cco:ont00001801 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001801 owl:inverseOf cco:ont00001808 .
cco:ont00001801 rdf:type owl:ObjectProperty .
cco:ont00001801 rdfs:domain obo:BFO_0000001 .
cco:ont00001801 rdfs:label "is subject of"@en .
cco:ont00001801 rdfs:range cco:ont00000958 .
cco:ont00001801 skos:definition "x is subject of y =Def y is about x."@en .

cco:ont00001808 cco:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000136" .
cco:ont00001808 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001808 rdf:type owl:ObjectProperty .
cco:ont00001808 rdfs:domain cco:ont00000958 .
cco:ont00001808 rdfs:label "is about"@en .
cco:ont00001808 rdfs:range obo:BFO_0000001 .
cco:ont00001808 skos:definition "x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y."@en .

cco:ont00001816 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001816 owl:inverseOf cco:ont00001986 .
cco:ont00001816 rdf:type owl:ObjectProperty .
cco:ont00001816 rdfs:label "is output of"@en .
cco:ont00001816 rdfs:range obo:BFO_0000015 .
cco:ont00001816 rdfs:subPropertyOf obo:BFO_0000056 .
cco:ont00001816 skos:definition "x is output of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the end of y is a necessary condition for the completion of y."@en .

cco:ont00001833 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001833 rdf:type owl:ObjectProperty .
cco:ont00001833 rdfs:domain obo:BFO_0000015 .
cco:ont00001833 rdfs:label "has agent"@en .
cco:ont00001833 rdfs:range cco:ont00001017 .
cco:ont00001833 rdfs:subPropertyOf obo:BFO_0000057 .
cco:ont00001833 skos:definition "x has agent y =Def y agent in x."@en .

cco:ont00001841 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001841 owl:inverseOf cco:ont00001921 .
cco:ont00001841 rdf:type owl:ObjectProperty .
cco:ont00001841 rdfs:label "is input of"@en .
cco:ont00001841 rdfs:range obo:BFO_0000015 .
cco:ont00001841 rdfs:subPropertyOf obo:BFO_0000056 .
cco:ont00001841 skos:definition "x is input of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the beginning of y is a necessary condition for the start of y."@en .

cco:ont00001844 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001844 owl:inverseOf cco:ont00001993 .
cco:ont00001844 rdf:type owl:ObjectProperty .
cco:ont00001844 rdfs:domain cco:ont00000402 .
cco:ont00001844 rdfs:label "has sender"@en .
cco:ont00001844 rdfs:range cco:ont00001017 .
cco:ont00001844 rdfs:subPropertyOf obo:BFO_0000057 .
cco:ont00001844 skos:definition "x has sender y =Def y sends x."@en .

cco:ont00001857 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001857 rdf:type owl:ObjectProperty .
cco:ont00001857 rdfs:label "is part of process"@en .
cco:ont00001857 rdfs:subPropertyOf obo:BFO_0000132 .
cco:ont00001857 skos:definition "x is part of process y iff x is occurrent part of y, x and y are Processes, and x occupies a temporal region that is a proper occurrent part of the temporal interval of y."@en .

cco:ont00001889 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001889 owl:inverseOf cco:ont00001954 .
cco:ont00001889 rdf:type owl:ObjectProperty .
cco:ont00001889 rdfs:domain cco:ont00001379 .
cco:ont00001889 rdfs:label "capability of"@en .
cco:ont00001889 rdfs:range cco:ont00001017 .
cco:ont00001889 rdfs:subPropertyOf obo:BFO_0000197 .
cco:ont00001889 skos:definition "x capability_of y iff y is an instance of Agent and x is an instance of Agent Capability, such that x inheres in y."@en .

cco:ont00001921 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001921 rdf:type owl:ObjectProperty .
cco:ont00001921 rdfs:domain obo:BFO_0000015 .
cco:ont00001921 rdfs:label "has input"@en .
cco:ont00001921 rdfs:subPropertyOf obo:BFO_0000057 .
cco:ont00001921 skos:definition "x has input y =Def y is input of x."@en .

cco:ont00001922 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001922 owl:inverseOf cco:ont00001978 .
cco:ont00001922 rdf:type owl:ObjectProperty .
cco:ont00001922 rdfs:domain cco:ont00000402 .
cco:ont00001922 rdfs:label "has recipient"@en .
cco:ont00001922 rdfs:range cco:ont00001017 .
cco:ont00001922 rdfs:subPropertyOf obo:BFO_0000057 .
cco:ont00001922 skos:definition "x has recipient y =Def y receives x."@en .

cco:ont00001954 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001954 rdf:type owl:ObjectProperty .
cco:ont00001954 rdfs:domain cco:ont00001017 .
cco:ont00001954 rdfs:label "has capability"@en .
cco:ont00001954 rdfs:range cco:ont00001379 .
cco:ont00001954 rdfs:subPropertyOf obo:BFO_0000196 .
cco:ont00001954 skos:definition "x has capability y =Def y capability of x."@en .

cco:ont00001978 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001978 rdf:type owl:ObjectProperty .
cco:ont00001978 rdfs:domain cco:ont00001017 .
cco:ont00001978 rdfs:label "receives"@en .
cco:ont00001978 rdfs:range cco:ont00000402 .
cco:ont00001978 rdfs:subPropertyOf obo:BFO_0000056 .
cco:ont00001978 skos:definition "x receives y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the recipient and decoder of the InformationContentEntity intended for communication in y."@en .

cco:ont00001986 cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=IPO_model&oldid=1024398398"^^xsd:anyURI .
cco:ont00001986 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001986 rdf:type owl:ObjectProperty .
cco:ont00001986 rdfs:domain obo:BFO_0000015 .
cco:ont00001986 rdfs:label "has output"@en .
cco:ont00001986 rdfs:subPropertyOf obo:BFO_0000057 .
cco:ont00001986 skos:definition "x has output y =Def y is output of x."@en .

cco:ont00001993 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001993 rdf:type owl:ObjectProperty .
cco:ont00001993 rdfs:domain cco:ont00001017 .
cco:ont00001993 rdfs:label "sends"@en .
cco:ont00001993 rdfs:range cco:ont00000402 .
cco:ont00001993 rdfs:subPropertyOf obo:BFO_0000056 .
cco:ont00001993 skos:definition "x sends y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the initiator and encoder of the InformationContentEntity intended for communication in y."@en .

dcterms:license rdf:type owl:AnnotationProperty .

