###  http://example.org/apqc#PCF_11689
ex:PCF_11689 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining complaint patterns in order to identify common issues. Document common problems for correction." ;
             ex:designatesProcessType ex:P11689 ;
