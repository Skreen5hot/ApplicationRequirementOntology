                skos:definition "A Facility that is designed to support processes of receiving or transmitting information."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000532
cco:ont00000532 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( cco:ont00001335
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty cco:ont00001859 ;
                                                             owl:someValuesFrom cco:ont00000139
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
