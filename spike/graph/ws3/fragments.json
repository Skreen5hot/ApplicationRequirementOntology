    {
      "fragmentId": "sf:590259498f7dac6171526d27",
      "label": "V-S1",
      "kind": "text-span",
      "source": {
        "doc": "SPEC.md",
        "digest": "sha256:2428b115bafe685044b88f97ac11f6ba28e1179c45989ee1b596b72ae3c89450"
      },
      "locator": {
        "codepointRange": [
          18032,
