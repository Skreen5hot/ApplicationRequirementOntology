                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Defoliant&oldid=1059494225"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


