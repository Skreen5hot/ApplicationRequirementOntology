###  https://www.commoncoreontologies.org/ont00001414
cco:ont00001414 rdf:type owl:NamedIndividual ,
                         cco:ont00001328 ;
                rdfs:label "Terrestrial Time"@en ;
                skos:scopeNote "TT is an astronomical time standard that is a theoretical ideal designed to be free of the irregularities in Earth's rotation and is primarily used for time measurements of astronomical observations made from the surface of Earth. It was formerly called Terrestrial Dynamical Time (TDT), which was formulated to replace Ephemeris Time (ET)."@en ;
                cco:ont00001753 "TT" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001415
cco:ont00001415 rdf:type owl:NamedIndividual ,
