###  https://www.commoncoreontologies.org/ont00000934
cco:ont00000934 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000126 ;
                rdfs:label "Constituent State"@en ;
                skos:altLabel "State"@en ;
