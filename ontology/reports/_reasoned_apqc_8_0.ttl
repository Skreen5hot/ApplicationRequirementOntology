                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Antibiotic&oldid=1063633090"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


