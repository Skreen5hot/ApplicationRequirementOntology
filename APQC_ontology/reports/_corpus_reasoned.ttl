###  http://example.org/apqc#PCF_17059
ex:PCF_17059 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Making and collecting payments for transactions in products/services, and transporting them to interested markets." ;
             ex:designatesProcessType ex:P17059 ;
             ex:hierarchyID "9.11" ;
             ex:pcfID "17059" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_17058 ;
