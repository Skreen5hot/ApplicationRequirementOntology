      ],
      "status": "open",
      "raisedBy": "transformer"
    },
    {
      "@id": "diag:t:8",
      "@type": "Ambiguity",
      "blocking": true,
      "statement": "It is unclear whether overdue notices are sent to both the branch manager and the duty librarian simultaneously, or to exactly one of them, and if exactly one, by what criterion the recipient is selected.",
