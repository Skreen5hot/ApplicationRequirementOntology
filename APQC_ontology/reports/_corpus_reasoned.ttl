                rdfs:subPropertyOf obo:BFO_0000056 ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( obo:BFO_0000020
                                            obo:BFO_0000031
                                            [ owl:intersectionOf ( obo:BFO_0000004
                                                                   [ rdf:type owl:Class ;
                                                                     owl:complementOf obo:BFO_0000006
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                                          )
                            ] ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "is affected by"@en ;
                skos:definition "x is affected by y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and y influences x in some manner, most often by producing a change in x."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001888
cco:ont00001888 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000015 ;
                dct:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
                dct:creator "https://cubrc.org"^^xsd:anyURI ;
                rdfs:label "disrupts"@en ;
                skos:definition "A relation where one process disrupts another process from occurring as it would have."@en ;
                skos:editorialNote "To lower the grade of a process is to lower the quality of a process according to some standard, for example when realizing a capability or a function."@en ;
                skos:prefLabel "disrupts"@en ;
                skos:scopeNote "A process can disrupt another process from occurring as it would have by 1) preventing a disposition or role from being realized by that process, 2) lowering the grade of the process, or 3) stopping the process from continuing to occur."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001889
cco:ont00001889 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000197 ;
                owl:inverseOf cco:ont00001954 ;
                rdfs:domain cco:ont00001379 ;
                rdfs:range cco:ont00001017 ;
                rdfs:label "capability of"@en ;
                skos:definition "x capability_of y iff y is an instance of Agent and x is an instance of Agent Capability, such that x inheres in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001893
cco:ont00001893 rdf:type owl:ObjectProperty ;
                owl:inverseOf cco:ont00001990 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:domain obo:BFO_0000203 ;
                rdfs:range obo:BFO_0000203 ;
                rdfs:label "instant is after"@en ;
                skos:definition "x instant_is_after y iff x and y are both instances of Temporal Instant and there exists some instance of Temporal Interval z such that y is the starting instant of z and x is the ending instant of z."@en ;
                skos:scopeNote "'instant is after' is a primitive relationship. Informally, a temporal instant x is after some temporal instant y iff y precedes x."@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001895
cco:ont00001895 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000056 ;
                rdfs:domain cco:ont00001017 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "accomplice in"@en ;
                skos:definition "Agent x is accomplice_in Process y iff x assists in the commission of y, is located at the location of y, but is not agent_in y."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Accomplice&oldid=1002047204"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001896
cco:ont00001896 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001862 ;
                rdf:type owl:IrreflexiveProperty ;
                rdfs:domain obo:BFO_0000202 ;
                rdfs:range obo:BFO_0000202 ;
                rdfs:label "interval meets"@en ;
                skos:definition "x interval meets y =Def y interval met by x"@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001898
cco:ont00001898 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001836 ;
                rdfs:domain obo:BFO_0000027 ;
                rdfs:range cco:ont00001379 ;
                rdfs:label "aggregate has capability"@en ;
                skos:definition "x aggregate has capability y =Def y capability of aggregate x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001899
cco:ont00001899 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001942 ;
                owl:inverseOf cco:ont00001976 ;
                rdfs:domain cco:ont00001175 ;
                rdfs:range cco:ont00000253 ;
                rdfs:label "language used in"@en ;
                skos:definition "x language_used_by y iff y is an instance of Information Bearing Entity and x is an instance of Language, such that the literal value of y is a string that is encoded according to the syntax of x."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001900
cco:ont00001900 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001997 ;
                owl:inverseOf cco:ont00001913 ;
                rdfs:domain cco:ont00000469 ;
                rdfs:range cco:ont00000253 ;
                rdfs:label "is geospatial coordinate reference system of"@en ;
                skos:definition "x is_geospatial_coordinate_reference_system_of y iff y is an instance of Information Bearing Entity and x is an instance of Geospatial Coordinate Reference System, such that x describes the set of standards mentioned in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001901
cco:ont00001901 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001836 ;
                rdfs:domain obo:BFO_0000027 ;
                rdfs:range obo:BFO_0000023 ;
                rdfs:label "aggregate has role"@en ;
                skos:definition "x aggregate_has_role y iff x is an instance of Object Aggregate and y is an instance of Role, such that x aggregate_bearer_of y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001904
cco:ont00001904 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001917 ;
                owl:inverseOf cco:ont00001966 ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00001163 ;
                rdfs:label "is measured by"@en ;
                skos:definition "x is measured by y =Def y is a measurement of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001907
cco:ont00001907 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001836 ;
                rdfs:domain obo:BFO_0000027 ;
                rdfs:range obo:BFO_0000019 ;
                rdfs:label "aggregate has quality"@en ;
                skos:definition "x aggregate_has_quality y iff x is an instance of Object Aggregate and y is an instance of Quality, such that x aggregate_bearer_of y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001908
cco:ont00001908 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000101 ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range cco:ont00000829 ;
                rdfs:label "uses time zone identifier"@en ;
                skos:definition "x uses time zone identifier y =Def y time zone identifier used by x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001909
cco:ont00001909 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001855 ;
                rdfs:domain obo:BFO_0000141 ;
                rdfs:range obo:BFO_0000141 ;
                rdfs:label "has tangential part"@en ;
                skos:definition "x has tangential part y =Def y tangential part of x"@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ;
                cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001910
cco:ont00001910 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001942 ;
                owl:inverseOf cco:ont00001998 ;
                rdfs:domain cco:ont00001324 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "permits"@en ;
                skos:definition "x permits y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that y may occur."@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001912
cco:ont00001912 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000101 ;
                owl:inverseOf cco:ont00001997 ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range cco:ont00000398 ;
                rdfs:label "uses reference system"@en ;
                skos:definition "x uses reference system y =Def y is reference system of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001913
cco:ont00001913 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001912 ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range cco:ont00000469 ;
                rdfs:label "uses geospatial coordinate reference system"@en ;
                skos:definition "x uses geospatial coordinate reference system y =Def y is geospatial coordinate reference system of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001914
cco:ont00001914 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001904 ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00000293 ;
                rdfs:label "is measured by nominal"@en ;
                skos:definition "x is measured by nominal y =Def y is a nominal measurement of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001915
cco:ont00001915 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001862 ;
                rdf:type owl:IrreflexiveProperty ;
                rdfs:domain obo:BFO_0000202 ;
                rdfs:range obo:BFO_0000202 ;
                rdfs:label "interval met by"@en ;
                skos:definition "x interval_met_by y iff x and y are both instances of Temporal Interval and y interval_meets x."@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001916
cco:ont00001916 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001808 ;
                rdfs:domain cco:ont00000686 ;
                rdfs:range obo:BFO_0000001 ;
                rdfs:label "designates"@en ;
                skos:definition "x designates y iff x is an instance of a Designative Information Content Entity, and y is an instance of an Entity, such that given some context, x uniquely distinguishes y from other entities."@en ;
                skos:example "a URL designates the location of a Web Page on the internet" ,
                             "a person's name designates that person" ,
                             "a vehicle identification number designates some vehicle" ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001917
cco:ont00001917 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001801 ;
                owl:inverseOf cco:ont00001982 ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00000853 ;
                rdfs:label "described by"@en ;
                skos:definition "x described by y =Def y describes x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001918
cco:ont00001918 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000066 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000029 ;
                rdfs:label "occurs at"@en ;
                skos:definition "x occurs_at y iff x is an instance of Process and y is an instance of Site, such that x occurs in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001919
cco:ont00001919 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00000253 ;
                rdfs:label "is mentioned by"@en ;
                skos:definition "x is_mentioned_by y iff y is an instance of Information Bearing Entity and x is an instance of Entity, such that y is used as a reference to x."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001920
cco:ont00001920 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001801 ;
                owl:inverseOf cco:ont00001942 ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00000965 ;
                rdfs:label "prescribed by"@en ;
                skos:definition "x prescribed by y =Def y prescribes x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001921
cco:ont00001921 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000057 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( obo:BFO_0000020
                                           obo:BFO_0000031
                                           [ owl:intersectionOf ( obo:BFO_0000004
                                                                  [ rdf:type owl:Class ;
                                                                    owl:complementOf obo:BFO_0000006
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ]
                                         )
                           ] ;
                rdfs:label "has input"@en ;
                skos:definition "x has input y =Def y is input of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001922
cco:ont00001922 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000057 ;
                owl:inverseOf cco:ont00001978 ;
                rdfs:domain cco:ont00000402 ;
                rdfs:range cco:ont00001017 ;
                rdfs:label "has recipient"@en ;
                skos:definition "x has recipient y =Def y receives x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001923
cco:ont00001923 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001971 ;
                rdfs:domain obo:BFO_0000202 ;
                rdfs:range obo:BFO_0000202 ;
                rdfs:label "interval starts"@en ;
                skos:definition "x interval_starts y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant v, w, and z such that v is the starting instant of both x and y, w is the ending instant of x, z is the ending instant of y and w is before z."@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001924
cco:ont00001924 rdf:type owl:ObjectProperty ;
                owl:inverseOf cco:ont00001971 ;
                rdfs:domain obo:BFO_0000202 ;
                rdfs:range obo:BFO_0000202 ;
                rdfs:label "interval contains"@en ;
                skos:definition "x interval contains y =Def y interval contained by x"@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001925
cco:ont00001925 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000040 ;
                rdfs:range cco:ont00001017 ;
                rdfs:label "is used by"@en ;
                skos:definition "x is used by y =Def y uses x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001928
cco:ont00001928 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000004 ;
                rdfs:range obo:BFO_0000004 ;
                rdfs:label "is predecessor of"@en ;
                skos:definition "x is_predecessor_of y iff x and y are both instances of Independent Continuant and there is some process p and x is an input to p and y is an output of p."@en ;
                skos:scopeNote "More informally, x is_predecessor_of y iff y follows or replaces x."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001931
cco:ont00001931 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001810 ;
                rdfs:domain obo:BFO_0000141 ;
                rdfs:range obo:BFO_0000141 ;
                rdfs:label "externally connects with"@en ;
                skos:definition "x externally_connects_with y iff x and y are both instances of Immaterial Entity and x connects with y and x does not overlap y."@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ;
                cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001933
cco:ont00001933 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001803 ;
                owl:inverseOf cco:ont00001962 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "process starts"@en ;
                skos:definition "x process_starts y iff x and y are instances of processes, and x is_cause_of y, and i is an instance of a temporal instant, and r is an instance of a temporal interval, and y has starting instance i, and x occupies temporal region r, and r has inside instant i."@en ;
                skos:scopeNote "A process x starts another process y when x causes y while x is still occurring."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001936
cco:ont00001936 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000056 ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( obo:BFO_0000020
                                            obo:BFO_0000031
                                            [ owl:intersectionOf ( obo:BFO_0000004
                                                                   [ rdf:type owl:Class ;
                                                                     owl:complementOf obo:BFO_0000006
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                                          )
                            ] ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "is object of"@en ;
                skos:definition "x is object of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and y is performed by Agent z and x is part of the projected state that z intends to achieve by performing y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001938
cco:ont00001938 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001808 ;
                rdfs:domain cco:ont00001069 ;
                rdfs:range obo:BFO_0000001 ;
                rdfs:label "represents"@en ;
                skos:definition "x represents y iff x is an instance of Representational Information Content Entity, y is an instance of Entity, and z is carrier of x, such that x is about y in virtue of there existing an isomorphism between characteristics of z and y."@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ,
                               "Isomorphism between the carrier of x and the represented entity can be via a direct similarity relation, e.g., grooves in a vinyl record corresponding to sound waves, or linguistic convention, e.g., a court stenographer's transcription of spoken words, as well as others, such as encoding processes for images."@en ,
                               "The relationship that is being defined here is that between the content of a photographic image and its object, between the content of a video and its objects and events, between the content of an audio recording and the sounds or events generating those sounds, or between the content of a written transcript and the verbal event that it transcribes."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001939
cco:ont00001939 rdf:type owl:ObjectProperty ;
                owl:inverseOf cco:ont00001977 ;
                rdfs:domain cco:ont00001017 ;
                rdfs:range cco:ont00001017 ;
                rdfs:label "is affiliated with"@en ;
                skos:definition "x is_affiliated_with y iff x and y are instances of Agent, such that they have any kind of social or business relationship."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001940
cco:ont00001940 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001862 ;
                rdfs:domain obo:BFO_0000202 ;
                rdfs:range obo:BFO_0000202 ;
                rdfs:label "interval is before"@en ;
                skos:definition "x interval_is_before y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant w, z such that w is the ending instant of x and z is the starting instant of y and w is before z."@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001942
cco:ont00001942 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001808 ;
                rdfs:domain cco:ont00000965 ;
                rdfs:range obo:BFO_0000001 ;
                rdfs:label "prescribes"@en ;
                skos:definition "x prescribes y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x serves as a rule or guide for y if y an Occurrent, or x serves as a model for y if y is a Continuant."@en ;
                skos:example "A blueprint prescribes some artifact or facility by being a model for it." ,
                             "A professional code of conduct prescribes some realizations of a profession (role) by giving rules for how the bearer should act in those realizations." ,
                             "An operations plan prescribes an operation by enumerating the tasks that need to be performed in order to achieve the objectives of the operation." ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001943
cco:ont00001943 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001977 ;
                rdfs:domain cco:ont00001262 ;
                rdfs:range cco:ont00001262 ;
                rdfs:label "supervises"@en ;
                skos:definition "x supervises y =Def y is supervised by x"@en ;
                cco:ont00001754 "http://en.wiktionary.org/wiki/supervise" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001944
cco:ont00001944 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000176 ,
                                   cco:ont00001810 ;
                rdfs:domain obo:BFO_0000141 ;
                rdfs:range obo:BFO_0000141 ;
                rdfs:label "spatial part of"@en ;
                skos:definition "x spatial_part_of y iff x, y, z, and q are instances of Immaterial Entity, such that for any z connected with x, z is also connected with y, and q is connected with y but not connected with x."@en ;
                skos:scopeNote "in the sense used here, spatial part of is elsewhere referred to as proper spatial part of"@en ;
                cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001947
cco:ont00001947 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001809 ;
                rdfs:domain obo:BFO_0000019 ;
                rdfs:range obo:BFO_0000027 ;
                rdfs:label "quality of aggregate"@en ;
                skos:definition "x quality_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Quality, and x inheres_in_aggregate y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001949
cco:ont00001949 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000057 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range cco:ont00001017 ;
                rdfs:label "has accessory"@en ;
                skos:definition "x has accessory y =Def y accessory in x"@en ;
                cco:ont00001754 "http://en.wikipedia.org/wiki/Accessory_(legal_term)" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001951
cco:ont00001951 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000023 ;
                rdfs:range obo:BFO_0000023 ;
                rdfs:label "has subordinate role"@en ;
                skos:definition "x has subordinate role y =Def y is subordinate role to x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001954
cco:ont00001954 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000196 ;
                rdfs:domain cco:ont00001017 ;
                rdfs:range cco:ont00001379 ;
                rdfs:label "has capability"@en ;
                skos:definition "x has capability y =Def y capability of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001956
cco:ont00001956 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001836 ;
                rdfs:domain obo:BFO_0000027 ;
                rdfs:range obo:BFO_0000016 ;
                rdfs:label "aggregate has disposition"@en ;
                skos:definition "x aggregate has disposition y =Def y disposition of aggregate x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001959
cco:ont00001959 rdf:type owl:ObjectProperty ;
                owl:inverseOf cco:ont00001970 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "inhibits"@en ;
                skos:definition "x inhibits y =Def y is inhibited by x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001961
cco:ont00001961 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000084 ;
                rdfs:domain cco:ont00000120 ;
                rdfs:range cco:ont00000253 ;
                rdfs:label "is measurement unit of"@en ;
                skos:definition "x is_measurement_unit_of y iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001962
cco:ont00001962 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001819 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "process started by"@en ;
                skos:definition "x process started by y =Def y process starts x"@en ;
                skos:scopeNote "A process x is started by another process y when y causes x while y is still occurring."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001963
cco:ont00001963 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001904 ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00001010 ;
                rdfs:label "is measured by ordinal"@en ;
                skos:definition "x is measured by ordinal y =Def y is a ordinal measurement of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001964
cco:ont00001964 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001904 ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00001364 ;
                rdfs:label "is measured by interval"@en ;
                skos:definition "x is measured by interval y =Def y is a interval measurement of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001965
cco:ont00001965 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001904 ;
                owl:inverseOf cco:ont00001983 ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range cco:ont00001022 ;
                rdfs:label "is measured by ratio"@en ;
                skos:definition "x is measured by ratio y =Def y is a ratio measurement of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001966
cco:ont00001966 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001982 ;
                rdfs:domain cco:ont00001163 ;
                rdfs:range obo:BFO_0000001 ;
                rdfs:label "is a measurement of"@en ;
                skos:definition "x is_a_measurement_of y iff x is an instance of Measurement Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ,
                               "This object property, as well as all of its children are typified as functional properties. This means that for instances x, y, and z if x is a measurement of y and x is a measurement of z, then y = z."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001970
cco:ont00001970 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "inhibited by"@en ;
                skos:definition "y inhibited_by x iff x and y are non-identical Processes, d is a Decrease of Realizable Entity, and x is_cause_of d, and r is a Realizable Entity, and d has_participant r, and r realized_in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001971
cco:ont00001971 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000202 ;
                rdfs:range obo:BFO_0000202 ;
                rdfs:label "interval contained by"@en ;
                skos:definition "x interval_contained_by y iff x and y are both instances of Temporal Interval and y interval_contains x."@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001974
cco:ont00001974 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001942 ;
                rdfs:domain cco:ont00001324 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:label "requires"@en ;
                skos:definition "x requires y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that some y must occur."@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001976
cco:ont00001976 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001920 ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range cco:ont00001175 ;
                rdfs:label "uses language"@en ;
                skos:definition "x uses language y =Def y language used in x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001977
cco:ont00001977 rdf:type owl:ObjectProperty ;
                rdfs:domain cco:ont00001017 ;
                rdfs:range cco:ont00001017 ;
                rdfs:label "has affiliate"@en ;
                skos:definition "x has affiliate y =Def y is affiliated with x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001978
cco:ont00001978 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000056 ;
                rdfs:domain cco:ont00001017 ;
                rdfs:range cco:ont00000402 ;
                rdfs:label "receives"@en ;
                skos:definition "x receives y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the recipient and decoder of the InformationContentEntity intended for communication in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001980
cco:ont00001980 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001808 ;
                rdfs:domain cco:ont00000127 ;
                rdfs:range obo:BFO_0000001 ;
                owl:propertyChainAxiom ( obo:BFO_0000178
                                         cco:ont00001982
                                       ) ;
                rdfs:label "describes condition"@en ;
                skos:definition "p describes_condition c iff p is an instance of a Performance Specification and c is an instance of Entity and p has part d, and d is an instance of a Descriptive Information Content Entity, and p prescribes an entity s, and d describes c, and c is an entity that is causally relevant to s existing as prescribed by p."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001982
cco:ont00001982 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001808 ;
                rdfs:domain cco:ont00000853 ;
                rdfs:range obo:BFO_0000001 ;
                rdfs:label "describes"@en ;
                skos:definition "x describes y iff x is an instance of Descriptive Information Content Entity, and y is an instance of Entity, such that x is_about the characteristics that identify y."@en ;
                skos:example "the content of a newspaper article describes some current event" ,
                             "the content of a visitor's log describes some facility visit" ,
                             "the content of an accident report describes some accident" ;
                skos:scopeNote "It is possible that this relation should be a functional property, that is for all x, y, z if x describes y and x describes z then y = z. For example, if a financial report x describes the quarterly results of a company y and that same financial report describes the quarterly results of a company z, then it should be inferred that companies y and z are the same. We refrained from classifying the relation as a functional property on the concern that descriptions are multifaceted and so consequently it may be that the same report would contain descriptions of multiple entities."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001983
cco:ont00001983 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001966 ;
                rdfs:domain cco:ont00001022 ;
                rdfs:range obo:BFO_0000001 ;
                rdfs:label "is a ratio measurement of"@en ;
                skos:definition "x is_a_ratio_measurement_of y iff x is an instance of Ratio Measurement Information Content Entity and y is an instance of Entity and x describes some attribute of y relative to a scale having equal unit values and a zero value that corresponds to the absence of the attribute being measured."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001984
cco:ont00001984 rdf:type owl:ObjectProperty ;
                rdfs:domain cco:ont00001017 ;
                rdfs:range obo:BFO_0000015 ;
                dct:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
                dct:creator "https://cubrc.org"^^xsd:anyURI ;
                rdfs:label "has interest in"@en ;
                skos:definition "A relation between an Agent and some Process where the Agent has an interest in that Process."@en ;
                skos:editorialNote "This term is meant to be weakly normative. The only sense in which the process is of positive normative value is that it's prescribed by the Agent, or historically of evolutionary benefit to the Agent's ancestors, or facilitates a process the Agent has an interest in for the prior two reasons. The process an Agent has an interest could in many or all ways be harmful to the Agent."@en ;
                skos:prefLabel "has interest in"@en ;
                skos:scopeNote "There are four conditions in which an agent has an interest in some process. 1) Biological Condition: If a part (including improper part) of an organism has a function, then that organism has an interest in the realization of that function. 2) Artifactual Condition: If a part (including improper part) of an artifact has a function, then some agent or group of agents, at some time, has an interest in the realization of that function. 3) Prescription Condition: If an agent or group of agents has a plan, then it has an interest in the realization of all the processes and process-combinations prescribed by that plan. 4) Facilitation Condition: If (a) agent x has an interest in the realization of a disposition y, and (b) the realization of a disposition z facilitates the realization of disposition y, then (c) x has an interest in the realization of disposition z, and by 'facilitates' we mean that the occurrence of a process w, which realizes realization of z is either (1) required for y, to realize or (2) would contribute positively to the grade of, y's realization."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001986
cco:ont00001986 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000057 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( obo:BFO_0000020
                                           obo:BFO_0000031
                                           [ owl:intersectionOf ( obo:BFO_0000004
                                                                  [ rdf:type owl:Class ;
                                                                    owl:complementOf obo:BFO_0000006
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ]
                                         )
                           ] ;
                rdfs:label "has output"@en ;
                skos:definition "x has output y =Def y is output of x"@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=IPO_model&oldid=1024398398"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001989
cco:ont00001989 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001855 ;
                rdfs:domain obo:BFO_0000141 ;
                rdfs:range obo:BFO_0000141 ;
                rdfs:label "has nontangential part"@en ;
                skos:definition "x has nontangential part y =Def y nontangential part of x"@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ;
                cco:ont00001754 "Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001990
cco:ont00001990 rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:domain obo:BFO_0000203 ;
                rdfs:range obo:BFO_0000203 ;
                rdfs:label "instant is before"@en ;
                skos:definition "x instant_is_before y iff x and y are both instances of Zero Dimensional Temporal Region and there exists some instance of Temporal Interval z such that x is the starting instant of z and y is the ending instant of z."@en ;
                skos:scopeNote "'instant is before' is a primitive relationship. Informally, a temporal instant x is before some temporal instant y iff x precedes y."@en ;
                cco:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001992
cco:ont00001992 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000023 ;
                rdfs:range cco:ont00001180 ;
                rdfs:label "has organizational context"@en ;
                skos:definition "x has organizational context y =Def y is organizational context of x"@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001993
cco:ont00001993 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000056 ;
                rdfs:domain cco:ont00001017 ;
                rdfs:range cco:ont00000402 ;
                rdfs:label "sends"@en ;
                skos:definition "x sends y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the initiator and encoder of the InformationContentEntity intended for communication in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001997
cco:ont00001997 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000084 ;
                rdfs:domain cco:ont00000398 ;
                rdfs:range cco:ont00000253 ;
                rdfs:label "is reference system of"@en ;
                skos:definition "x is_reference_system_of y iff y is an instance of Information Bearing Entity and x is an instance of Reference System, such that x describes the set of standards mentioned in y."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001998
cco:ont00001998 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf cco:ont00001920 ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range cco:ont00001324 ;
                rdfs:label "is permitted by"@en ;
                skos:definition "x is permitted by y =Def y permits x"@en ;
                skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .


#################################################################
#    Data properties
#################################################################

###  http://www.opengis.net/ont/geosparql#asWKT
<http://www.opengis.net/ont/geosparql#asWKT> rdf:type owl:DatatypeProperty ;
                                             rdfs:label "as WKT"@en ;
                                             skos:definition "A Data Property that has as its range a string formated according to the Well-known text standardization for geometric objects."@en ;
                                             skos:example "Polygon ((10 10, 10 20, 20 20, 20 15, 10 10))" ;
                                             skos:scopeNote "ISO 19162:2015"@en ;
                                             cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001763
cco:ont00001763 rdf:type owl:DatatypeProperty ;
                rdfs:label "has altitude value"@en ;
                skos:scopeNote "Altitude values typically use kilometers as the Unit of Measurement."@en ,
                               "This data property can be used along with has_latitude_value and has_longitude_value to connect three-dimensional spatial data to a single Information Bearing Entity to specify the location of an entity in a Geospatial Region."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001764
cco:ont00001764 rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:decimal ;
                rdfs:label "has longitude value"@en ;
                skos:definition "A Data Property that has as its range the longitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001765
cco:ont00001765 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:label "has text value"@en ;
                skos:definition "A data property that has as its range a string value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001766
cco:ont00001766 rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:decimal ;
                rdfs:label "has latitude value"@en ;
                skos:definition "A Data Property that has as its range the latitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001767
cco:ont00001767 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range xsd:dateTime ;
                rdfs:label "has datetime value"@en ;
                skos:definition "A data property that has as its value a datetime value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001768
cco:ont00001768 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range xsd:anyURI ;
                rdfs:label "has URI value"@en ;
                skos:definition "A data property that has as its range a URI value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001769
cco:ont00001769 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range xsd:decimal ;
                rdfs:label "has decimal value"@en ;
                skos:definition "A data property that has as its range a decimal value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001770
cco:ont00001770 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range xsd:double ;
                rdfs:label "has double value"@en ;
                skos:definition "A data property that has as its range a double value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001771
cco:ont00001771 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:label "has date value"@en ;
                skos:definition "A data property that has as its range a date value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001772
cco:ont00001772 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range xsd:boolean ;
                rdfs:label "has boolean value"@en ;
                skos:definition "A data property that has as its range a boolean value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00001773
cco:ont00001773 rdf:type owl:DatatypeProperty ;
                rdfs:domain cco:ont00000253 ;
                rdfs:range xsd:integer ;
                rdfs:label "has integer value"@en ;
                skos:definition "A data property that has as its range an integer value."@en ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


#################################################################
#    Classes
#################################################################

###  http://example.org/apqc#AccountApprovalDecision
ex:AccountApprovalDecision rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Minted locally: Directive (not Descriptive) because a decision prescribes rather than describes. Distinct from the shared ex:CreditAssessment (the Descriptive judgement underlying it) and from ex:PaymentApproval (a per-payment approval)." ;
                           rdfs:label "Account Approval Decision" ;
                           skos:definition "A Directive Information Content Entity that prescribes whether to approve or decline the opening of a new customer credit account." ;
                           skos:example "A recorded decision to approve a new customer's credit account at a $10,000 limit." .


###  http://example.org/apqc#AccountStatement
ex:AccountStatement rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:label "Account Statement" ;
                    skos:definition "A Descriptive Information Content Entity that describes the balance and activity of a particular financial account over a period." .


###  http://example.org/apqc#Accountant
ex:Accountant rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00001017 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty obo:BFO_0000196 ;
                                owl:someValuesFrom ex:AccountantRole
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cco:ont00001954 ;
                                owl:someValuesFrom ex:AccountingCapability
                              ] ;
              rdfs:label "Accountant" ;
              skos:definition "An Agent that has an accounting capability and bears an accountant role." .


###  http://example.org/apqc#AccountantRole
ex:AccountantRole rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000984 ;
                  rdfs:label "Accountant Role" ;
                  skos:definition "A Role that is borne by an Agent in virtue of being tasked with recording, classifying, and reporting an Organization's financial transactions." .


###  http://example.org/apqc#AccountingCapability
ex:AccountingCapability rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00001379 ;
                        ex:enablesProcess ex:P10729 ,
                                          ex:P10730 ;
                        rdfs:label "Accounting Capability" ;
                        skos:definition "An Agent Capability that inheres in an Agent in virtue of its capacity to record, classify, reconcile, and report financial transactions." .


###  http://example.org/apqc#ActOfAccounting
ex:ActOfAccounting rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000366 ;
                   rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no generic bookkeeping/record-keeping class; recording and reconciling transactions manipulates input ICEs into an updated record ICE, so it anchors under cco:ont00000366 (Act of Information Processing), per the GOLDEN PRINCIPLE. Rejected cco:ont00000950 'Act of Maintenance' (modifies Material Artifacts, not records). Distinct from ex:ActOfFinancialTransaction (which moves the money itself). Recurs in accounting categories (9.0; likely 8.0)." ;
                   rdfs:label "Act of Accounting" ;
                   skos:definition "An Act of Information Processing in which an Agent records, classifies, posts, or reconciles financial transactions and produces or updates a Descriptive Information Content Entity (such as a ledger, journal, or account record) that registers the organization's financial state." .


###  http://example.org/apqc#ActOfAcquisition
ex:ActOfAcquisition rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000228 ;
                    rdfs:comment "Local extension (D9). Rejected cco:ont00000950 'Act of Maintenance' (modifying Material Artifacts) and cco:ont00000402 'Act of Communication' (mere ICE transfer). Securing/obtaining a held entity anchors at the generic Planned Act. Expected to recur in procurement/asset-acquisition categories (4.0, 10.0)." ,
                                 "Local extension (D9). Rejected cco:ont00000950 'Act of Maintenance' (modifying Material Artifacts) and cco:ont00000402 'Act of Communication' (mere ICE transfer). Securing/obtaining a held entity anchors at the generic Planned Act. Expected to recur in procurement/asset-acquisition categories (4.0, 10.0). Also rejected cco:ont00001334 (Act of Purchasing) and cco:ont00000389 (Act of Buying): both require a Financial Instrument and descend from cco:ont00000836 (Act of Financial Instrument Use), too narrow for non-purchase acquisitions such as obtaining permits/licenses from an authority or securing financing; purchasing is a species of acquisition, not its genus." ;
                    rdfs:label "Act of Acquisition" ;
                    skos:definition "A Planned Act in which an Agent obtains from some authority or supplier an entity (such as an authorization, license, or resource) that the Agent did not previously hold." .


###  http://example.org/apqc#ActOfAdministration
ex:ActOfAdministration rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000228 ;
                       ex:requiresCapability ex:HumanResourcesInformationSystemCapability ,
                                             ex:TimeAndAttendanceManagementCapability ;
                       rdfs:comment "PROPOSE-EXT (D9). Anchored at the generic cco:ont00000228 (Planned Act), neutral on output kind, so administrative acts yielding a Descriptive record or a Directive schedule both fit. Rejected cco:ont00000950 'Act of Maintenance' (modifies Material Artifacts to restore designed Qualities/Functions, whereas administration executes a directive arrangement rather than repairing an artifact), cco:ont00000511 'Act of Planning' (planning creates the arrangement; administering merely runs an existing one), and cco:ont00000366 'Act of Information Processing' (too narrow: administration provisions resources and enacts directives, not only ICE manipulation). Differentia is execution-and-upkeep of a settled arrangement. Recurs in 7.0." ;
                       rdfs:label "Act of Administration" ;
                       skos:definition "A Planned Act in which an Agent carries out, enforces, delivers, coordinates, and maintains an already-established arrangement (such as a policy, program, plan, scheme, record set, or relationship) on behalf of an Organization in accordance with a Directive Information Content Entity, without itself creating that arrangement." .


###  http://example.org/apqc#ActOfAdvocacy
ex:ActOfAdvocacy rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00001327 ;
                 rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00001327 'Social Act' (verified: 'A Planned Act having an objective that affects, is performed by, or is performed on behalf of, a community or group of Persons'; parent cco:ont00000228) because advocacy/promotion targets a community or society rather than uniting with a single counterpart. Evaluated cco:ont00000079 'Act of Social Movement' (verified: 'A Social Act composed of a series of performances, displays and campaigns directed at implementing, resisting or undoing a change in society') as the nearest sibling: it fits campaign-driven activism but is narrower than the general supporting/promoting intent here (supporting civic programs and connection platforms is not necessarily a movement to undo a societal change), so a dedicated advocacy genus is minted under the shared Social Act parent. Rejected cco:ont00000433 'Act of Association' (a bilateral uniting-with-an-Agent, whereas advocacy influences a societal/political environment rather than uniting into a shared enterprise). Recurs across promote/encourage/support-the-environment nodes (12.0)." ;
                 rdfs:label "Act of Advocacy" ;
                 skos:definition "A Social Act in which an Agent promotes, encourages, or supports a cause, position, or change in the societal or political environment through campaigns, programs, or public engagement, on behalf of an organization." .


###  http://example.org/apqc#ActOfAnalysis
ex:ActOfAnalysis rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000366 ;
                 rdfs:comment "Local extension (D9). CCO 2.0 has no generic analysis class; analysis is information processing, so it is anchored under cco:ont00000366." ;
                 rdfs:label "Act of Analysis" ;
                 skos:definition "An Act of Information Processing in which an Agent examines one or more input Information Content Entities and produces an Information Content Entity that represents an understanding of their subject matter." .


###  http://example.org/apqc#ActOfCardAdministration
ex:ActOfCardAdministration rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000228 ;
                           rdfs:comment "PROPOSE-EXT (D9). Minted for the corporate-credit-card lifecycle family (issue/handle, process requests, deactivate). REJECTED ex:ActOfFinancialTransaction: card issuance/handling/blocking transfers no money and settles no obligation, so it falls outside that genus's differentia ('transfers money or a Financial Instrument in settlement') -- anchoring it there was a false friend driven by the surface theme 'credit card'. Anchored at the generic cco:ont00000228 (Planned Act) because the act operates on the card artifact (a material participant) rather than manipulating only ICEs (cco:ont00000366) or obtaining a not-previously-held entity (ex:ActOfAcquisition, which covers ordering a card). Recurs in 9.0." ;
                           rdfs:label "Act of Card Administration" ;
                           skos:definition "A Planned Act in which an Agent issues, handles, processes a request for, or deactivates a payment card on behalf of an Organization, thereby establishing or altering the card's status without itself transferring money or a Financial Instrument." .


###  http://example.org/apqc#ActOfCommunication
ex:ActOfCommunication rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000402 ;
                      rdfs:comment "PROPOSE-EXT (D9). Shared anchor that wraps the VERIFIED cco:ont00000402 (Act of Communication, def: 'A Planned Act in which some Information Content Entity is transferred from some Agent to Another'; parent cco:ont00000228) so the recurring 'communicate'/'convey'/'escalate'/'route' rows reuse one consistent, D6-verified parent rather than re-citing the raw IRI per class. NOT cco:ont00000379 'Act of Representative Communication' (the methodology's flagged false-friend, the truth-committing subclass): plain conveyance/escalation does not assert truth, whereas reporting (ex:ActOfReporting) does and therefore anchors under ont00000379. The cco:ont00000228 co-anchor is retained because SHACL S2 evaluates rdfs:subClassOf+ over the module graph only. Recurs in 8.0." ;
                      rdfs:label "Act of Communication (shared anchor)" ;
                      skos:definition "A Planned Act in which an Agent transfers one or more Information Content Entities to one or more other Agents." .


###  http://example.org/apqc#ActOfDataManagement
ex:ActOfDataManagement rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000366 ;
                       rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000366 (Act of Information Processing: ICEs are received, manipulated, transferred, or stored). Covers maintain-records / maintain-repository / control-access / document acts. Rejected cco:ont00001158 (Act of Data Transformation: requires executing an algorithm to transform inputs into outputs) and cco:ont00000950 (Act of Maintenance: modifies Material Artifacts, not ICEs). A standing 'Manage business information' function with no natural end is an Organization Capability (cco:ont00000568) realized in such acts, not itself a process. Recurs in information-management categories (2.0, 8.0)." ;
                       rdfs:label "Act of Data Management" ;
                       skos:definition "An Act of Information Processing in which an Agent stores, controls, updates, maintains, or governs access to a body of Information Content Entities so as to keep it accurate, secure, and available." .


###  http://example.org/apqc#ActOfDeployment
ex:ActOfDeployment rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000228 ;
                   rdfs:comment "PROPOSE-EXT (D9). Anchored at the generic cco:ont00000228 (Planned Act) because deployment places and configures a (often material) IT component into operation: it acts on material participants (IT infrastructure components / software releases, attached via obo:BFO_0000057 has participant), so it is neither a pure information-processing act nor a service-rendering act. Rejected ex:ActOfServiceProvision (renders an intangible service rather than installing/configuring a discrete component), cco:ont00000950 (Act of Maintenance: restores/preserves an existing artifact's qualities rather than first making it operational), and cco:ont00000908 (Act of Material Artifact Processing: fabricates/transforms matter rather than installing/configuring an already-built component). Recurs in IT/operations install-and-configure activities (8.0, 9.0)." ;
                   rdfs:label "Act of Deployment" ;
                   skos:definition "A Planned Act in which an Agent installs, configures, distributes, or otherwise makes operationally available an IT component, software release, or solution within an organization's environment." .


###  http://example.org/apqc#ActOfDesign
ex:ActOfDesign rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000511 ;
               rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no generic design act; designing produces a Directive ICE (a design/architecture specification) prescribing an artifact-to-be, so it is anchored under cco:ont00000511 (Act of Planning), not under cco:ont00000908 (Act of Material Artifact Processing), which physically operates on existing matter. Rejected cco:ont00000051 (Act of Construction) and cco:ont00001359 (Act of Manufacturing) as both build/mass-produce finished goods rather than authoring a concept-stage design. Recurs across develop/design categories (2.0, 4.0, 7.0, 8.0)." ;
               rdfs:label "Act of Design" ;
               skos:definition "An Act of Planning in which an Agent devises and specifies the form, structure, and behavior of a prospective product, service, solution, process, or architecture and produces a Directive Information Content Entity (a design specification) that prescribes how it is to be realized." .


###  http://example.org/apqc#ActOfDevelopment
ex:ActOfDevelopment rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000228 ;
                    rdfs:comment "Inlined from apqc-ext.ttl (D9). Genus for ex:ImplementPhase: implementing a planned module into a working change set is bringing a software component from a specification into a realized state; its comment in apqc-ext explicitly covers software/informational outputs. Reused (reuse-before-mint) in preference to the request's bare cco:ont00000366." ,
                                 "PROPOSE-EXT (D9). Anchored at the generic cco:ont00000228 (Planned Act) because development spans both informational and material outputs (new technologies, software/hardware components, prototypes, delivery processes) and is broader than cco:ont00001359 (Act of Manufacturing, mass production) and cco:ont00000051 (Act of Construction, building to contract); a development act whose product is specifically a built/mass-produced material artifact should instead use those narrower CCO acts, attaching the material product via obo:BFO_0000057 (has participant), not has output (reserved for ICEs). Recurs across develop/build categories (2.0, 4.0, 8.0)." ;
                    rdfs:label "Act of Development" ;
                    skos:definition "A Planned Act in which an Agent brings a novel product, service, solution, technology, component, prototype, or process from a specification or concept into an existent realized state." .


###  http://example.org/apqc#ActOfDisposition
ex:ActOfDisposition rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000228 ;
                    rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no generic disposal/disposition Act. Anchored at the generic cco:ont00000228 (Planned Act) because disposition spans physical destruction/recycling AND ownership transfer (sale/trade) AND waste-stream removal -- not all of which physically process a material artifact. Rejected cco:ont00000908 (Act of Material Artifact Processing: too narrow -- excludes sale/abandonment), cco:ont00000950 (Act of Maintenance: preserves/restores Qualities, the opposite of retiring an asset), and cco:ont00000970 (Act of Artifact Modification: changes an artifact's qualities, not its service/ownership status). Recurs across asset end-of-life: decommission, sale/trade, recycle, abandonment, hazardous-material/waste disposition (10.0)." ,
                                 "PROPOSE-EXT (D9). CCO 2.0 has no generic disposal/disposition Act. Anchored at the generic cco:ont00000228 (Planned Act) because disposition spans physical destruction/recycling AND ownership transfer (sale/trade) AND waste-stream removal -- not all of which physically process a material artifact. Rejected cco:ont00000908 (Act of Material Artifact Processing: too narrow -- excludes sale/abandonment), cco:ont00000950 (Act of Maintenance: preserves/restores Qualities, the opposite of retiring an asset), and cco:ont00000970 (Act of Artifact Modification: changes an artifact's qualities, not its service/ownership status). Recurs across asset end-of-life: decommission, sale/trade, recycle, abandonment, hazardous-material/waste disposition (10.0). Also rejected cco:ont00001336 (Act of Ownership) and its parent cco:ont00001232 (Act of Possession): these model an agent HOLDING / exercising control over property (a state of possession), not relinquishing or transferring it; CCO 2.0 has no Act of Selling / Act of Ownership Transfer." ;
                    rdfs:label "Act of Disposition" ;
                    skos:definition "A Planned Act in which an Agent removes an asset or portion of material from active service, ownership, or possession at its end-of-life by retiring, selling, dismantling, recycling, abandoning, or otherwise applying a terminal disposition to it or its parts in accordance with applicable requirements." .


###  http://example.org/apqc#ActOfFinancialTransaction
ex:ActOfFinancialTransaction rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000836 ;
                             rdfs:comment "PROPOSE-EXT (D9). Re-anchored from the bare cco:ont00000228 to cco:ont00000836 (Act of Financial Instrument Use): every subclass here uses/transfers a Financial Instrument (money and cash are Financial Instruments in CCO -- cf. Portion of Cash cco:ont00000475 subClassOf 537), and CCO models settlements, loans, purchases, deposits, withdrawals and exchanges uniformly under 836, so the earlier claim that this genus is 'broader than financial-instrument use' was incorrect (investments and exchanges still USE financial instruments). Rejected cco:ont00001334 'Act of Purchasing' and cco:ont00000389 'Act of Buying' (both acquire a good/service -- too narrow for payments/remittances/trades/deposits) and cco:ont00000366 'Act of Information Processing' (a payment moves a material/financial-instrument filler, not only an ICE). cco:ont00000228 co-asserted because 836 falls outside the S2 standalone-SHACL allowlist. Recurs in payment/treasury/trade categories (9.0)." ,
                                          "PROPOSE-EXT (D9). Re-anchored from the bare cco:ont00000228 to cco:ont00000836 (Act of Financial Instrument Use): every subclass uses/transfers a Financial Instrument (money and cash are Financial Instruments in CCO -- cf. Portion of Cash cco:ont00000475 subClassOf 537), and CCO models settlements, loans, purchases, deposits, withdrawals and exchanges uniformly under 836. Rejected cco:ont00001334 'Act of Purchasing' and cco:ont00000389 'Act of Buying' (both acquire a good/service -- too narrow) and cco:ont00000366 'Act of Information Processing' (a payment moves a material/financial-instrument filler, not only an ICE). cco:ont00000228 co-asserted because 836 falls outside the S2 standalone-SHACL allowlist. Recurs in payment/treasury/trade categories (9.0)." ;
                             rdfs:label "Act of Financial Transaction" ;
                             skos:definition "A Planned Act in which an Agent transfers or uses money or a Financial Instrument to or from another Agent in settlement of an obligation, an investment, or an exchange." .


###  http://example.org/apqc#ActOfForecasting
ex:ActOfForecasting rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000371 ;
                    rdfs:comment "Inlined canonical shared genus (apqc-ext.ttl registry). Anchored under cco:ont00000371 (Act of Prediction; parent cco:ont00000228), whose definitional output is a Predictive ICE (cco:ont00000626 subClassOf cco:ont00000853) -- exactly the genus of a demand/sales/volume forecast. Recurs in 3.0 and 6.0." ,
                                 "Inlined canonical shared genus (apqc-ext.ttl registry). Anchored under cco:ont00000371 (Act of Prediction; parent cco:ont00000228), whose definitional output is a Predictive ICE (cco:ont00000626 subClassOf cco:ont00000853) -- exactly the genus of a demand/sales/volume forecast. Recurs in 3.0, 5.0, 6.0 and 8.0." ,
                                 "Inlined canonical shared genus (apqc-ext.ttl registry). Anchored under cco:ont00000371 (Act of Prediction; parent cco:ont00000228), whose definitional output is a Predictive ICE (cco:ont00000626 subClassOf cco:ont00000853) -- exactly the genus of a demand/sales/volume forecast. Recurs in 3.0/5.0/6.0/8.0/10.0/4.0." ,
                                 "Local extension (D9). Genus cco:ont00000371 (Act of Prediction, a Planned Act). Used where a process's definitional output is a forecast/projection of an uncertain future state (a Predictive ICE, cco:ont00000626), as opposed to ex:ActOfAnalysis whose output is a plain Descriptive ICE about an existing subject. cco:ont00000228 co-asserted locally so the class still anchors to an S2-allowlisted Planned Act. Recurs corpus-wide (slices 5.0/6.0/8.0/10.0)." ,
                                 "PROPOSE-EXT (D9). Anchored under cco:ont00000371 (Act of Prediction, verified: 'A Planned Act that involves the generation of a Predictive Information Content entity that is intended to describe an uncertain possible future event, value, entity, or attribute'; parent cco:ont00000228), whose definitional output is a Predictive ICE (cco:ont00000626 ⊑ cco:ont00000853 Descriptive ICE) -- exactly the genus of a sales/demand/volume/ROI forecast. A thin specialization (quantitative, history-driven business projection) kept shared so slice agents need not re-derive the anchor. Output is a PREDICTIVE ICE (a Descriptive ICE about an uncertain future), per the GOLDEN PRINCIPLE. Recurs in 3.0 and 6.0." ;
                    rdfs:label "Act of Forecasting" ;
                    skos:definition "An Act of Prediction in which an Agent examines present information about an entity and generates a Predictive Information Content Entity that describes an uncertain future event, value, or condition of that entity." ,
                                    "An Act of Prediction in which an Agent extrapolates from historical and current Information Content Entities to produce a Predictive Information Content Entity that estimates a future quantity such as demand, volume, revenue, or value." .


###  http://example.org/apqc#ActOfFormulation
ex:ActOfFormulation rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000511 ;
                    rdfs:comment "Inlined from apqc-ext.ttl (D9) for self-containment; same IRI/definition, so the merge with the corpus is idempotent." ,
                                 "Local extension (D9). Anchored under cco:ont00000511 (Act of Planning) because formulating a strategy/mission/design is making a plan to achieve an objective; its output is a Directive ICE. Recurs across develop/define/compose-a-directive processes corpus-wide." ;
                    rdfs:label "Act of Formulation" ;
                    skos:definition "An Act of Planning in which an Agent composes and articulates a Directive Information Content Entity - such as a mission, strategy, objective, design, roadmap, or business model - that prescribes an organization's intended course of action." .


###  http://example.org/apqc#ActOfIdentification
ex:ActOfIdentification rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000366 ;
                       rdfs:comment "Local extension (D9). NOT cco:ont00001261 'Act of Identifying' (a communication act). APQC 'Identify ...' denotes discernment, i.e. information processing." ;
                       rdfs:label "Act of Identification (discernment sense)" ;
                       skos:definition "An Act of Information Processing in which an Agent discerns and enumerates entities of a given kind and produces an Information Content Entity that registers them." .


###  http://example.org/apqc#ActOfImplementation
ex:ActOfImplementation rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000228 ;
                       rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000228 (Planned Act): carrying out a Directive ICE is realizing a plan, and its effect is a change in the world rather than a new ICE. Distinct from ex:ActOfFormulation (which composes the plan) and ex:ActOfDeployment (the narrower IT install/configure case). Rejected cco:ont00000950 'Act of Maintenance' (restricted to modifying Material Artifacts). Recurs in execute/deploy/implement processes (13.0)." ;
                       rdfs:label "Act of Implementation" ;
                       skos:definition "A Planned Act in which an Agent executes, deploys, or puts into operation a previously specified plan, program, methodology, or system so as to bring about the state of affairs it prescribes." .


###  http://example.org/apqc#ActOfImprovement
ex:ActOfImprovement rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000228 ;
                    rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000228 (Planned Act): it alters an existing occurrent-type or system rather than merely processing information or composing a new plan. Distinct from ex:ActOfImplementation (enacts a fixed directive). Rejected cco:ont00000950 'Act of Maintenance' (restores/preserves a Material Artifact's designed Qualities/Functions, whereas improvement raises performance of a process/system). Recurs in improve/reengineer/enhance/sustain processes (13.0)." ;
                    rdfs:label "Act of Improvement" ;
                    skos:definition "A Planned Act in which an Agent modifies an existing process, system, or capability with the intent of raising its performance, quality, or fitness against stated objectives." .


###  http://example.org/apqc#ActOfInvestigation
ex:ActOfInvestigation rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000366 ;
                      rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no generic investigation/examination class. Anchored under cco:ont00000366 (Act of Information Processing) because investigation gathers and manipulates evidence into a Descriptive findings ICE (GOLDEN PRINCIPLE). Distinct from ex:ActOfAnalysis (examines GIVEN input ICEs) in that investigation also acquires the evidence; retained as a separate genus because 'investigate' recurs as a distinct verb. Rejected cco:ont00000636 (Act of Appraisal: judges value/condition, not factual examination of causes) and cco:ont00000151 (Act of Reporting: a communication act). Recurs in audit/forensics/incident categories (11.0)." ;
                      rdfs:label "Act of Investigation" ;
                      skos:definition "An Act of Information Processing in which an Agent systematically examines and gathers evidence about a situation, framework, or cause in order to produce a Descriptive Information Content Entity that establishes the relevant facts." .


###  http://example.org/apqc#ActOfMonitoring
ex:ActOfMonitoring rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000366 ;
                   rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no generic monitoring/tracking class. Anchored under cco:ont00000366 (Act of Information Processing) because monitoring ingests repeated observations (including electronic records, not only senses) and yields a descriptive status/deviation ICE -- the GOLDEN PRINCIPLE (descriptive output => information-processing genus) holds. Rejected cco:ont00000037 (Act of Observation: a single sense-based acquisition, too narrow -- monitoring also processes ICEs and is sustained); cco:ont00000636 (Act of Appraisal: renders a single bounded value/quality judgement rather than tracking status over time); and cco:ont00000345 (Act of Measuring: a single quantification against a standard at one time -- at most a method sub-step of the monitoring cycle; a node that is purely one quantification, e.g. Calculate performance measures, anchors to cco:ont00000345 directly, not here). Distinct from ex:ActOfAnalysis (one-shot examination of a fixed input set) by its continuous, longitudinal character. A standing 'Manage/Monitor X' function with no natural end is an Organization Capability (cco:ont00000568) realized in such acts, not itself a process. Recurs corpus-wide (slices 3.0/4.0/5.0/6.0/8.0/9.0/10.0/11.0/12.0/13.0). Reconciled from 10 divergent slice restatements to one definition." ;
                   rdfs:label "Act of Monitoring" ;
                   skos:definition "An Act of Information Processing in which an Agent repeatedly or continuously observes the state, progress, or performance of some process, system, or quantity over time and produces a Descriptive Information Content Entity that represents its tracked status against expected conditions, targets, or requirements." .


###  http://example.org/apqc#ActOfNegotiation
ex:ActOfNegotiation rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000228 ;
                    rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000228 (Planned Act): negotiation is two or more agents conferring and bargaining over terms to reach a mutually binding directive (an agreement or contract). Rejected cco:ont00001327 (Social Act) as too generic; Act of Contract Formation (cco:ont00000684) models only the consummating promise, narrower than the bargaining process." ;
                    rdfs:label "Act of Negotiation" ;
                    skos:definition "A Planned Act in which two or more Agents confer and bargain over terms and conditions, exchanging proposals and concessions, in order to reach and record a mutually binding Directive Information Content Entity such as an agreement or contract." .


###  http://example.org/apqc#ActOfOrganizationalEstablishment
ex:ActOfOrganizationalEstablishment rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000228 ;
                                    rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no Act-of-Establishment/Organization class (verified: no 'Act of Establish/Organiz/Constitut/Found' label in the closure). REJECTED ex:ActOfFormulation (Act of Planning): formulating composes a Directive ICE, but establishing a committee primarily constitutes an independent continuant (the body) rather than authoring a directive; the responsibility-assignment directive is a downstream byproduct of seating the body, not the act's primary product. Anchored at the generic cco:ont00000228 (Planned Act). Recurs in 9.0." ;
                                    rdfs:label "Act of Organizational Establishment" ;
                                    skos:definition "A Planned Act in which an Agent constitutes and seats an Organization or organizational body (such as a board, committee, or unit), bringing the body into existence and conferring its mandate." .


###  http://example.org/apqc#ActOfPayment
ex:ActOfPayment rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000836 ;
                rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000836 'Act of Financial Instrument Use' (verified: 'An Act of Artifact Employment in which some Agent uses some Financial Instrument'; parent cco:ont00000566 Act of Artifact Employment). Rejected cco:ont00001334 'Act of Purchasing' (acquires a good/service in exchange, whereas payment may settle a pre-existing debt without acquisition) and cco:ont00000389 'Act of Buying' (acquires ownership of a good, narrower still). The transferred money is a material entity moved as a participant; the act's definitional informational output is a Descriptive ICE payment record. Recurs in disbursement/procurement processes (12.0)." ;
                rdfs:label "Act of Payment" ;
                skos:definition "An Act of Financial Instrument Use in which an Agent (the payer) transfers money or a monetary instrument to another Agent (the payee) in settlement of an obligation." .


###  http://example.org/apqc#ActOfProcessControl
ex:ActOfProcessControl rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000228 ;
                       rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000228 (Planned Act): closed-loop control ACTS ON the plant (it changes setpoints and equipment state), so its product is a change in the controlled material participants, not a Descriptive ICE. Rejected ex:ActOfMonitoring (cco:ont00000366, Act of Information Processing): monitoring is the OBSERVE half only and over-commits to a descriptive output, whereas advanced process control / real-time optimization also ACTUATE. The controlled equipment is attached via obo:BFO_0000057 (has participant). Recurs across automate/control-plant and industrial-control activities (4.0)." ;
                       rdfs:label "Act of Process Control" ;
                       skos:definition "A Planned Act in which an Agent, or an automation system acting for an Agent, regulates a running production process or plant by closing the loop between observation and actuation -- adjusting setpoints, parameters, and equipment so as to keep the process within target or optimize its performance." .


###  http://example.org/apqc#ActOfProduction
ex:ActOfProduction rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000908 ;
                   rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000908 (Act of Material Artifact Processing, verified: 'A Planned Act of performing a series of physical operations on a material artifact in order to change or preserve the artifact'; parent cco:ont00000228), the common parent of Act of Manufacturing (cco:ont00001359) and Act of Artifact Assembly. Generalizes produce/assemble-product where APQC covers both mass manufacturing and assembly; cco:ont00001359 (mass production for sale) alone is too narrow and Assembly alone excludes non-assembly production, so the shared genus sits at their common parent. The material product is attached via obo:BFO_0000057 (has participant), NOT has output -- a deliberate CORPUS-LOCAL CONVENTION (not a missing output): cco:has output is used only for informational (ICE) outputs in these reality slices, so material products produced or moved by operations attach via bfo:has participant. CCO itself permits a material has-output; adopting that pattern corpus-wide is an open policy option (see methodology section 10). Recurs in physical-production categories (4.0, 6.0)." ;
                   rdfs:label "Act of Production" ;
                   skos:definition "An Act of Material Artifact Processing in which an Agent transforms raw materials and components into finished Material Artifacts according to a production specification or schedule." .


###  http://example.org/apqc#ActOfRelationshipManagement
ex:ActOfRelationshipManagement rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000433 ;
                               rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000433 'Act of Association' (verified: 'A Social Act wherein an Agent unites with some other Agent in a Planned Act, enterprise or business'; parent cco:ont00001327 Social Act -> cco:ont00000228) because relationship-building is a sustained social uniting, not mere ICE transfer. Rejected cco:ont00000402 'Act of Communication' (a single ICE-transfer event, too narrow), cco:ont00000511 'Act of Planning' (output is a relationship, not a plan), and cco:ont00000168 'Act of Interpersonal Relationship' (restricted to Persons, whereas the external counterparties here are typically Organizations). Recurs across plan/build/manage-relationship nodes (12.0)." ;
                               rdfs:label "Act of Relationship Management" ;
                               skos:definition "An Act of Association in which an Agent builds, maintains, extends, or advances an ongoing relationship between an organization and one or more external parties or held assets." .


###  http://example.org/apqc#ActOfRemuneration
ex:ActOfRemuneration rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000449 ;
                     rdfs:comment "PROPOSE-EXT (D9). Inlines the verified CCO leaf cco:ont00000449 (Act of Remuneration, subClassOf cco:ont00001334 Act of Purchasing subClassOf cco:ont00000836) for payroll rows whose APQC text is salary/compensation disbursement to employees -- a closer genus than ex:ActOfFinancialTransaction. NOT used for payroll-TAX remittance to a government authority (the recipient is not the compensated employee; those keep ex:ActOfFinancialTransaction). cco:ont00000228 co-asserted because 449 is outside the standalone-SHACL S2 process-anchor allowlist." ,
                                  "PROPOSE-EXT (D9). Inlines the verified CCO leaf cco:ont00000449 (Act of Remuneration, subClassOf cco:ont00001334 Act of Purchasing subClassOf cco:ont00000836) for payroll rows whose APQC text is salary/compensation disbursement to employees -- a closer genus than ex:ActOfFinancialTransaction. NOT used for payroll-TAX remittance to a government authority. cco:ont00000228 co-asserted because 449 is outside the standalone-SHACL S2 process-anchor allowlist." ;
                     rdfs:label "Act of Remuneration" ;
                     skos:definition "An Act of Remuneration in which an Employer disburses a Financial Instrument (salary, wages, bonus, or other compensation) to an Employee for services performed." .


###  http://example.org/apqc#ActOfReporting
ex:ActOfReporting rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000379 ;
                  rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no broad reporting class spanning compilation and assertion. Anchored under cco:ont00000379 (Act of Representative Communication), with cco:ont00000228 (Planned Act) co-anchored so standalone SHACL resolves the act chain: reporting transfers to recipients a descriptive account (report, statement, scorecard, filing) asserting an organization's condition or results. Pure submission of an already-prepared report may use the verified leaf cco:ont00000151 directly." ,
                               "Registry genus (D9) for DISSEMINATE-class reporting acts whose source makes sharing/reporting-to-an-audience definitional (vs COMPILE-class acts that merely create/record/summarize a report ICE, which stay at cco:ont00000366 Act of Information Processing). VERIFIED in vendored CCO: cco:ont00000151 'Act of Reporting' subClassOf cco:ont00000379 (Act of Representative Communication) subClassOf cco:ont00000402 (Act of Communication), def 'performed by giving a detailed account or statement'. Co-asserts cco:ont00000228 because 379 is outside the standalone-SHACL S2 process allowlist {366,636,511,228}." ;
                  rdfs:label "Act of Reporting" ;
                  skos:definition "An Act of Representative Communication in which an Agent gives a detailed account or statement of some subject matter and shares it with a target audience." ,
                                  "An Act of Representative Communication in which an Agent transfers to one or more recipients a Descriptive Information Content Entity (such as a report, statement, scorecard, or filing) that asserts, as true, a representation of an organization's condition or results." .


###  http://example.org/apqc#ActOfResolution
ex:ActOfResolution rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000228 ;
                   rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no generic resolution/case-management class. A leaf resolve act settles one complaint and records a Descriptive resolution; an end-to-end case-resolution process composes information-processing/appraisal/planning/communication sub-acts and is individuated by carrying a case from open to closed. Both are Planned Acts that settle a matter, so the coherent genus is the generic cco:ont00000228 (Planned Act), neutral on output kind. Rejected cco:ont00000636 (Act of Appraisal: resolution settles a matter rather than merely judging value) and cco:ont00000402 (Act of Communication: the downstream notify/respond to the customer is a separate communication act). Recurs in service/support case management (6.0)." ;
                   rdfs:label "Act of Resolution" ;
                   skos:definition "A Planned Act in which an Agent settles a raised case -- such as a customer inquiry, complaint, warranty claim, supplier-recovery matter, or product recall -- by determining and recording its disposition, comprising as needed the receipt, investigation, decision, and closure of the case." .


###  http://example.org/apqc#ActOfScheduling
ex:ActOfScheduling rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000511 ;
                   rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000511 (Act of Planning, verified: 'A Planned Act that involves making a Plan to achieve some specified Objective'): a schedule is a plan whose differentia is the temporal/resource ordering of activities; its output is a Directive ICE, satisfying the GOLDEN PRINCIPLE. Distinct from ex:ActOfFormulation (mission/strategy/design) by its specifically temporal/resource-allocation product. Recurs across operations and project categories (4.0, 6.0, 8.0)." ;
                   rdfs:label "Act of Scheduling" ;
                   skos:definition "An Act of Planning in which an Agent fixes the timing, sequencing, and resource allocation of future activities and produces a schedule (a Directive Information Content Entity) that prescribes when, in what order, and by whom those activities are to be performed." .


###  http://example.org/apqc#ActOfSelection
ex:ActOfSelection rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000366 ;
                  rdfs:comment "Local extension (D9). Anchored under cco:ont00000366 (Act of Information Processing): receives candidate-option ICEs and yields a decision ICE. Distinct from Act of Appraisal (judges without committing) and Act of Planning. NOTE: ratifying a single already-settled option is NOT selection (no candidate set) -- anchor such acts at cco:ont00000228 (Planned Act)." ;
                  rdfs:label "Act of Selection" ;
                  skos:definition "An Act of Information Processing in which an Agent chooses one or more options from a set of candidates and produces a Directive Information Content Entity that prescribes the chosen option(s)." .


###  http://example.org/apqc#ActOfSelling
ex:ActOfSelling rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 models only the BUYER side (cco:ont00001334 Act of Purchasing, cco:ont00000389 Act of Buying, cco:ont00000836 Act of Financial Instrument Use); APQC 3.5 makes the seller the focal Agent, so a complementary seller-side act is anchored at the generic cco:ont00000228 (Planned Act). Rejected cco:ont00000402 (Act of Communication: a sale transfers a good/value, not merely an ICE). A transactional Planned Act, neutral on ICE output. Recurs across sell-product/service processes (3.0)." ;
                rdfs:label "Act of Selling" ;
                skos:definition "A Planned Act in which an Agent (the seller) transfers ownership of a good or the provision of a service to another Agent (the buyer) in exchange for a Financial Instrument." .


###  http://example.org/apqc#ActOfServiceProvision
ex:ActOfServiceProvision rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000228 ;
                         rdfs:comment "PROPOSE-EXT (D9). Operations-category signature genus for 'deliver/render/execute/deploy/operate a service' processes. Anchored at the generic cco:ont00000228 (Planned Act) because service provision need not produce or modify an artifact and need not transfer an ICE. Rejected cco:ont00000908 (Act of Material Artifact Processing: its product is a modified Material Artifact, whereas a service need not modify matter) and cco:ont00000402 (Act of Communication: mere ICE transfer). Recurs in operations/IT-service categories (4.0, 5.0, 6.0, 8.0, 9.0, 10.0)." ;
                         rdfs:label "Act of Service Provision" ;
                         skos:definition "A Planned Act in which an Agent renders a service to a customer by carrying out and completing the tasks that fulfil an agreed service need." .


###  http://example.org/apqc#ActOfTransportation
ex:ActOfTransportation rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000065 ;
                       rdfs:comment "PROPOSE-EXT (D9). Anchored under cco:ont00000065 (Act of Location Change, verified: 'An Act of Motion in which the location of some Object is changed by some Agent'; parent cco:ont00000357 Act of Motion -> ... -> Planned Act), the parent of cco:ont00000595 'Act of Cargo Transportation'. Generalizes inbound/outbound movement, picking-packing-shipping, and warehouse transfers; cco:ont00000595 is a close fit but is scoped to a Payload being conveyed, whereas ex:ActOfTransportation also covers internal warehouse transfers and deployment. Recurs across physical-logistics categories (4.0, 6.0, 9.0)." ;
                       rdfs:label "Act of Transportation" ;
                       skos:definition "An Act of Location Change in which an Agent moves materials or finished products from one supply-chain location to another, such as from a source to a warehouse, distribution center, or customer." .


###  http://example.org/apqc#ActOfVerification
ex:ActOfVerification rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000636 ;
                     rdfs:comment "Inlined from apqc-ext.ttl (D9). Genus for ex:EvaluateOutput (the determination the Process Team handed us): evaluating an artifact against acceptance criteria IS appraisal-against-requirements. Verified cco:ont00000636 reaches Planned Act cco:ont00000228 (via cco:ont00000345)." ,
                                  "PROPOSE-EXT (D9). CCO 2.0 has no generic verification/checking/testing class. Anchored under cco:ont00000636 (Act of Appraisal): verification checks a product, service, solution, system, plan, control, or process against specified requirements and produces a descriptive judgement. Many verification acts also have an information-processing character, but Act of Appraisal is the canonical genus for this corpus." ;
                     rdfs:label "Act of Verification" ;
                     skos:definition "An Act of Appraisal in which an Agent subjects a product, service, solution, system, plan, control, or process to a test, audit, trial, or review against specified requirements and produces a Descriptive Information Content Entity that records whether and to what extent the requirements are met." .


###  http://example.org/apqc#AdEffectivenessAssessment
ex:AdEffectivenessAssessment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Minted per Gate-F as the definitional output of P11239 (6.5.3.2). Descriptive (a judgement), satisfying the GOLDEN PRINCIPLE for the Appraisal genus. Captures the ad-effectiveness judgement that the lead gerund 'Assessing the influence of advertisements on purchasing behavior' makes intrinsic to the act; the analysis sibling 6.5.3.4 covers product/service satisfaction generally, not ad influence specifically, so this commitment would otherwise be dropped." ;
                             rdfs:label "Ad Effectiveness Assessment" ;
                             skos:definition "A Descriptive Information Content Entity that describes a judgement of the influence of advertisements on customers' purchasing behavior." .


###  http://example.org/apqc#Advisor
ex:Advisor rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00001017 ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty obo:BFO_0000196 ;
                             owl:someValuesFrom ex:AdvisorRole
                           ] ;
           rdfs:comment "Minted for 12.2.1.4 / 12.2.1.5 (receive input from internal/external advisors)." ;
           rdfs:label "Advisor" ;
           skos:definition "An Agent that bears an advisor role in virtue of providing advice or counsel, whether internally or as a third party, to support an organization's relationships." .


###  http://example.org/apqc#AdvisorRole
ex:AdvisorRole rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000023 ;
               rdfs:label "Advisor Role" ;
               skos:definition "A Role that is borne by an Agent in virtue of providing advice or counsel to support a focal organization's relationships or decisions." .


###  http://example.org/apqc#AdvisoryInput
ex:AdvisoryInput rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Input for 12.2.1.4 / 12.2.1.5 (receive input from advisors)." ;
                 rdfs:label "Advisory Input" ;
                 skos:definition "A Descriptive Information Content Entity that describes advice or counsel furnished by an internal or external advisor." .


###  http://example.org/apqc#AllianceAgreement
ex:AllianceAgreement rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output of 3.4.2.9 (establish partner and alliance agreements). Directive: an agreement prescribes mutual obligations. The ratification act is anchored at cco:ont00000228 (Planned Act)." ;
                     rdfs:label "Alliance Agreement" ;
                     skos:definition "A Directive Information Content Entity that prescribes the ratified terms, responsibilities, and benefits binding an organization and its alliance partners." .


###  http://example.org/apqc#AllianceSelection
ex:AllianceSelection rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output of 3.4.2.3 (10140). Directive (Selection genus): committing to chosen partners prescribes a course of action. Distinct from the descriptive ex:PartnerEvaluation (judges performance) and from ex:AllianceAgreement (ratified terms). PROPOSE-VOCAB candidate." ;
                     rdfs:label "Alliance Selection" ;
                     skos:definition "A Directive Information Content Entity that prescribes the alliance partners chosen from a candidate set as those the organization will commit to." .


###  http://example.org/apqc#AllianceStrategy
ex:AllianceStrategy rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 3.4.2, 3.4.2.2, 3.4.2.7. Directive (Formulation)." ;
                    rdfs:label "Partner and Alliance Strategy" ;
                    skos:definition "A Directive Information Content Entity that prescribes how an organization identifies, selects, manages, and develops partner and alliance relationships." .


###  http://example.org/apqc#AnalysisReport
ex:AnalysisReport rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "Analysis Report" ;
                  skos:definition "A Descriptive Information Content Entity that summarizes and documents the results of data analysis, including graphs and visualizations of numerical findings." .


###  http://example.org/apqc#AnalystRelationsManagementCapability
ex:AnalystRelationsManagementCapability rdf:type owl:Class ;
                                        rdfs:subClassOf ex:StakeholderRelationshipManagementCapability ;
                                        ex:enablesProcess ex:P11036 ;
                                        rdfs:comment "Minted for 12.1.2 (P11036), re-judged under R5 as a standing function -> Organization Capability ('creating and maintaining LONG-TERM relations' signals the no-natural-end / standing-capacity branch), reconciled with 12.2.1-3 (Gate-F cross-row consistency). Realized in the bounded analyst-relationship-cultivation episodes via obo:BFO_0000054." ;
                                        rdfs:label "Analyst Relations Management Capability" ;
                                        skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to create and maintain long-term relationships with financial analysts so as to elicit market intelligence." .


###  http://example.org/apqc#AnalyticsCapability
ex:AnalyticsCapability rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000568 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P20960
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P20961
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P20962
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P20963
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P20964
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P21459
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P21460
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P21461
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P21462
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P21463
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000054 ;
                                         owl:someValuesFrom ex:P21464
                                       ] ;
                       ex:enablesProcess ex:P20960 ,
                                         ex:P20961 ,
                                         ex:P20962 ,
                                         ex:P20963 ,
                                         ex:P20964 ,
                                         ex:P21459 ,
                                         ex:P21460 ,
                                         ex:P21461 ,
                                         ex:P21462 ,
                                         ex:P21463 ,
                                         ex:P21464 ;
                       rdfs:comment "Standing-function reading of APQC 13.7 'Develop, manage, and deliver analytics' (PCF 20959). Per R5 the 'Develop/manage/deliver' group node is a standing function -> Organization Capability; the catalog node ex:PCF_20959 designates this capability. Its 11 bounded leaf acts (ex:P21459..ex:P20964) are wired as obo:BFO_0000054 (realized in) fillers, mirroring the 13.1/13.5 capability pattern; they are NOT has-process-part of a capability." ;
                       rdfs:label "Analytics Capability" ;
                       skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop, manage, and deliver analytics across its data-management pipeline, realized in its bounded analytics acts." .


###  http://example.org/apqc#AnalyticsDataset
ex:AnalyticsDataset rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:label "Analytics Dataset" ;
                    skos:definition "A Descriptive Information Content Entity consisting of structured and unstructured data gathered, cleaned, and converted to a uniform format for analysis." .


###  http://example.org/apqc#AnalyticsProjectScopeStatement
ex:AnalyticsProjectScopeStatement rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:label "Analytics Project Scope Statement" ;
                                  skos:definition "A Directive Information Content Entity that prescribes the size and scale of an analytics project based on collected information." .


###  http://example.org/apqc#ApplicableRequirementsDetermination
ex:ApplicableRequirementsDetermination rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000853 ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty cco:ont00001808 ;
                                                         owl:someValuesFrom ex:RegulatoryRequirement
                                                       ] ;
                                       rdfs:comment "Output of 11.2.2.2 (identify applicable regulatory requirements), produced by ex:ActOfIdentification (discernment). Gate-F mint: an information-processing/discernment act produces a DESCRIPTIVE determination of which requirements apply -- it does NOT author the Directive ex:RegulatoryRequirement (which is issued by a governing authority and is the act's INPUT/subject). This realigns genus, output kind, and the GOLDEN PRINCIPLE. Descriptive (cco:ont00000853)." ;
                                       rdfs:label "Applicable Requirements Determination" ;
                                       skos:definition "A Descriptive Information Content Entity, about one or more regulatory requirements, that describes which of the candidate body of regulation applies to the organization." .


###  http://example.org/apqc#ApplicantDataManagementCapability
ex:ApplicantDataManagementCapability rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000568 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P20124
                                                     ] ;
                                     ex:apqcSourceText "Keeping track of all the information about the candidates who apply for jobs. Use applicant-tracking systems that can be accessed online as a central location and database for recruitment efforts." ;
                                     ex:enablesProcess ex:P20124 ;
                                     ex:hierarchyID "7.2.5.3" ;
                                     rdfs:comment "Models APQC 7.2.5.3 (PCF 10467) 'Manage/track applicant data' under R5/R6: an open-ended standing function ('Keeping track of all the information ... a central location and database'), with no natural end, so an Organization Capability (cco:ont00000568) realized in its bounded acts rather than a process. This matches the R5 treatment of its sibling 'Manage X' rows (PCF 10455, 17048). Operates on ex:ApplicantRecord (non-definitional). The former process-part link to P20124 is re-expressed as a realized-in axiom because capabilities cannot carry has-process-part." ;
                                     rdfs:label "Applicant Data Management Capability" ;
                                     skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to keep track of and maintain applicant information through an applicant-tracking system, realized in the bounded acts of classifying and recording applicants." ;
                                     skos:example "An organization's standing ability to maintain applicant records in its ATS across hiring rounds." .


###  http://example.org/apqc#ApplicantRecord
ex:ApplicantRecord rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:JobCandidate
                                   ] ;
                   rdfs:comment "About the JobCandidate it records; maintained in applicant-tracking systems (group 7.2.5)." ;
                   rdfs:label "Applicant Record" ;
                   skos:definition "A Descriptive Information Content Entity that records the application and disposition of an individual job candidate." .


###  http://example.org/apqc#ApprovalLimitSpecification
ex:ApprovalLimitSpecification rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Minted locally: more specific than ex:FinancialPolicy/ex:FinancialProcedure (numeric approval thresholds). Directive per GOLDEN PRINCIPLE (it prescribes, not describes)." ;
                              rdfs:label "Approval Limit Specification" ;
                              skos:definition "A Directive Information Content Entity that prescribes the monetary thresholds and conditions under which financial approvals may be granted." ;
                              skos:example "A schedule stating that purchases over USD 50,000 require CFO sign-off." .


###  http://example.org/apqc#ApproveImplementationPlan
ex:ApproveImplementationPlan rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000228 ;
                             rdfs:comment "Anchored at the generic cco:ont00000228 (Planned Act): an authorization/passage decision, neutral on ICE output. This is the Process that ex:ApproveImplementationPlanPermission (capabilities_roles.ttl) permits and onto which ex:requiresPermission would be derived once RDM/IEE populates the permission catalogue." ;
                             rdfs:label "Approve implementation plan" ;
                             skos:definition "A Planned Act in which an authority-bearing agent authorizes passage of an implementation plan beyond its review gate." .


###  http://example.org/apqc#ApproveImplementationPlanPermission
ex:ApproveImplementationPlanPermission rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000751 ;
                                       rdfs:label "Approve implementation plan (permission)" ;
                                       skos:definition "Permission to authorize passage of an implementation plan beyond its review gate. RDM/IEE-owned; stubbed here to show the role->permission seam." .


###  http://example.org/apqc#ApproverRole
ex:ApproverRole rdf:type owl:Class ;
                rdfs:subClassOf ex:Role ,
                                cco:ont00000187 ;
                ex:bearsPermission ex:ApproveImplementationPlanPermission ;
                rdfs:label "Approver role" ;
                skos:definition "The authority role occupied by the party who may approve passage through a review/approval gate." .


###  http://example.org/apqc#ArchitectRole
ex:ArchitectRole rdf:type owl:Class ;
                 rdfs:subClassOf ex:Role ,
                                 cco:ont00000984 ;
                 rdfs:label "Architect role" ;
                 skos:definition "The occupation role of an agent authoring and reviewing a build's structural decisions." .


###  http://example.org/apqc#ArchitectureCapability
ex:ArchitectureCapability rdf:type owl:Class ;
                          rdfs:subClassOf ex:Capability ;
                          ex:enablesProcess ex:AuthorArchitecture ;
                          rdfs:label "Architecture capability" ;
                          skos:definition "An Agent Capability that enables its bearer to author a build's structural plan: its module boundaries, exported interfaces, and layering." .


###  http://example.org/apqc#ArchitecturePlan
ex:ArchitecturePlan rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000974 ;
                    rdfs:label "Architecture plan" ;
                    skos:definition "A Plan that specifies a build's structure - its module boundaries, exported interfaces, and layering - to be realized by downstream implementation." .


###  http://example.org/apqc#AssetConstructionCapability
ex:AssetConstructionCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ;
                               ex:enablesProcess ex:P19209 ,
                                                 ex:P19224 ,
                                                 ex:P19229 ,
                                                 ex:P20139 ;
                               rdfs:label "Asset Construction Capability" ;
                               skos:definition "An Organization Capability that is realized in acts of designing, planning, scheduling, and performing the construction of assets." .


###  http://example.org/apqc#AssetDeploymentPlan
ex:AssetDeploymentPlan rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Minted: shared vocab has ex:FinancialPlan/ex:Budget but no class specific to asset-resource allocation. Directive because it prescribes a deployment." ;
                       rdfs:label "Asset Deployment Plan" ;
                       skos:definition "A Directive Information Content Entity that prescribes how asset resources are allocated across processes for optimal utilization." ;
                       skos:example "A plan reassigning two machines from line A to line B for the next quarter." .


###  http://example.org/apqc#AssetDesign
ex:AssetDesign rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000965 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cco:ont00001808 ;
                                 owl:someValuesFrom ex:ProductiveAsset
                               ] ;
               rdfs:label "Asset Design" ;
               skos:definition "A Directive Information Content Entity, about a productive asset, that prescribes the specifications of that asset and the construction codes it must satisfy." .


###  http://example.org/apqc#AssetDispositionCapability
ex:AssetDispositionCapability rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000568 ;
                              ex:enablesProcess ex:P19258 ,
                                                ex:P21579 ,
                                                ex:P21581 ,
                                                ex:P21582 ;
                              rdfs:comment "Models the 10.4.4 'Manage take-back centers' standing function (R5/R6): a never-ending capacity, not a bounded process. Catalog bridge ex:PCF_12717 -> this capability." ;
                              rdfs:label "Asset Disposition Capability" ;
                              skos:definition "An Organization Capability that is realized in acts of managing the end-of-life disposition of assets, including decommissioning, dismantling, recycling, and abandonment." .


###  http://example.org/apqc#AssetExitStrategy
ex:AssetExitStrategy rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:label "Asset Exit Strategy" ;
                     skos:definition "A Directive Information Content Entity that prescribes an organization's approach for managing the end-of-life exit of its assets." .


###  http://example.org/apqc#AssetHandoverDocumentation
ex:AssetHandoverDocumentation rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cco:ont00001808 ;
                                                owl:someValuesFrom ex:ProductiveAsset
                                              ] ;
                              rdfs:label "Asset Handover Documentation" ;
                              skos:definition "A Descriptive Information Content Entity, about an asset, that documents the asset's history and current state to enable an orderly handover to a new operator or landowner." .


###  http://example.org/apqc#AssetMaintenanceCapability
ex:AssetMaintenanceCapability rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000568 ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P19239
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P19245
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P19253
                                              ] ;
                              ex:enablesProcess ex:P19239 ,
                                                ex:P19245 ,
                                                ex:P19253 ;
                              rdfs:comment "Models the 10.3 process-group standing function (R5/R6). Realized in 10.3.1/.2/.3 (see R6 axioms in the 10.3 process block); 10.3 mints no ex:P19238 process." ;
                              rdfs:label "Asset Maintenance Capability" ;
                              skos:definition "An Organization Capability that is realized in acts of planning, managing, and performing asset maintenance." .


###  http://example.org/apqc#AssetManagerRole
ex:AssetManagerRole rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000984 ;
                    rdfs:label "Asset Manager Role" ;
                    skos:definition "A Role that is borne by an Agent in virtue of being tasked with overseeing the construction, maintenance, and end-of-life of an organization's productive assets." .


###  http://example.org/apqc#AssetPart
ex:AssetPart rdf:type owl:Class ;
             rdfs:subClassOf obo:BFO_0000040 ;
             rdfs:label "Asset Part" ;
             skos:definition "A Material Entity that results from dismantling an end-of-life asset and that may follow a disposition such as resale, reuse, recycling, or disposal." .


###  http://example.org/apqc#AuditFindingsReport
ex:AuditFindingsReport rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Output of 12.3.2 (Report audit findings)." ;
                       rdfs:label "Audit Findings Report" ;
                       skos:definition "A Descriptive Information Content Entity that describes the findings of an audit, including the situation, root cause, and recommendations for resolving a problem." .


###  http://example.org/apqc#AuditInquiry
ex:AuditInquiry rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Input for 12.2.2.2 (Respond to audit inquiries) and 12.3.2 (Report audit findings)." ;
                rdfs:label "Audit Inquiry" ;
                skos:definition "A Descriptive Information Content Entity that describes a question or request raised by an auditor in the course of an audit." .


###  http://example.org/apqc#AuditJudgement
ex:AuditJudgement rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Minted locally for 9.6.1.3: descriptive output of the invoice/AP-data audit." ;
                  rdfs:label "Invoice Audit Judgement" ;
                  skos:definition "A Descriptive Information Content Entity that records the findings of an audit of invoices and key accounts-payable data." .


###  http://example.org/apqc#Auditor
ex:Auditor rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00001017 ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty obo:BFO_0000196 ;
                             owl:someValuesFrom ex:AuditorRole
                           ] ;
           rdfs:comment "Minted for 12.2.2.2 (Respond to audit inquiries) and 12.3.2 (Report audit findings). Agent because an auditor may be an individual or an audit firm." ;
           rdfs:label "Auditor" ;
           skos:definition "An Agent that bears an auditor role and independently examines an Organization's financial records or controls." ,
                           "An Agent that bears an auditor role in virtue of conducting an examination of an organization's records, controls, or compliance." .


###  http://example.org/apqc#AuditorRole
ex:AuditorRole rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000984 ;
               rdfs:comment "Covers both internal and external auditors; the bearer (a Person or Organization) carries the role." ;
               rdfs:label "Auditor Role" ;
               skos:definition "A Role that is borne by an Agent in virtue of independently examining and attesting to an organization's records, controls, or compliance." .


###  http://example.org/apqc#AuthorArchitecture
ex:AuthorArchitecture rdf:type owl:Class ;
                      rdfs:subClassOf ex:ActOfFormulation ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001986 ;
                                        owl:someValuesFrom ex:ArchitecturePlan
                                      ] ;
                      ex:requiresCapability ex:ArchitectureCapability ;
                      ex:requiresRole ex:ArchitectRole ;
                      ex:routable "true"^^xsd:boolean ;
                      rdfs:label "Author architecture" ;
                      skos:definition "An Act of Formulation in which an architect agent composes a build's structural plan - its module boundaries, exported interfaces, and layering - from a normative specification." .


###  http://example.org/apqc#AuthorImplementationPlan
ex:AuthorImplementationPlan rdf:type owl:Class ;
                            rdfs:subClassOf ex:ActOfFormulation ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cco:ont00001986 ;
                                              owl:someValuesFrom ex:ImplementationPlanArtifact
                                            ] ;
                            ex:requiresCapability ex:PlanAuthoringCapability ;
                            ex:requiresRole ex:PlannerRole ;
                            ex:routable "true"^^xsd:boolean ;
                            rdfs:label "Author implementation plan" ;
                            skos:definition "An Act of Formulation in which a planning agent composes a tactical implementation plan, with falsifiable acceptance criteria, for a roadmap phase." .


###  http://example.org/apqc#AuthorRoadmap
ex:AuthorRoadmap rdf:type owl:Class ;
                 rdfs:subClassOf ex:ActOfFormulation ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cco:ont00001986 ;
                                   owl:someValuesFrom ex:RoadmapPlan
                                 ] ;
                 ex:requiresCapability ex:PlanAuthoringCapability ;
                 ex:requiresRole ex:PlannerRole ;
                 ex:routable "true"^^xsd:boolean ;
                 rdfs:label "Author roadmap" ;
                 skos:definition "An Act of Formulation in which a planning agent composes a phased roadmap from a normative specification." .


###  http://example.org/apqc#AvailableToPromiseQuantity
ex:AvailableToPromiseQuantity rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:label "Available-to-Promise Quantity" ;
                              skos:definition "A Descriptive Information Content Entity that describes the volume of products or services that may be committed for delivery to fulfill sales." .


###  http://example.org/apqc#BPMGovernanceLeader
ex:BPMGovernanceLeader rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001017 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:BPMGovernanceLeaderRole
                                       ] ;
                       rdfs:comment "Minted as the named participant of ex:P16380 (Define and manage governance approach). Bears the shared ex:BPMGovernanceLeaderRole (D4: realizables on Agents only)." ;
                       rdfs:label "BPM Governance Leader" ;
                       skos:definition "An Agent that bears the BPM Governance Leader Role within an organization's business-process-management governance." .


###  http://example.org/apqc#BPMGovernanceLeaderRole
ex:BPMGovernanceLeaderRole rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000984 ;
                           rdfs:comment "Minted for APQC 13.1.1.1 'Identify BPM governance leaders'." ;
                           rdfs:label "BPM Governance Leader Role" ;
                           skos:definition "A Role that is borne by an Agent in virtue of being designated to set standards and priorities for business-process-management efforts within an Organization." .


###  http://example.org/apqc#BPMToolTemplate
ex:BPMToolTemplate rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Directive: a template prescribes how a tool is set up. Minted because no shared-vocab ICE covers BPM tool/template artifacts (output of ex:P16381)." ;
                   rdfs:label "BPM Tool Template" ;
                   skos:definition "A Directive Information Content Entity that prescribes a reusable configuration of a business-process-management tool (process engine, analytics, content management, or collaboration tool) ready for implementation." ;
                   skos:example "A pre-built process-engine workflow template instantiated for new processes." .


###  http://example.org/apqc#BankFeeAnalysis
ex:BankFeeAnalysis rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "Local mint for 9.7.2.8. Descriptive: it represents a judgement of fee levels rather than prescribing them." ;
                   rdfs:label "Bank Fee Analysis" ;
                   skos:definition "A Descriptive Information Content Entity that describes a study and negotiated determination of the fees a bank charges for its services." .


###  http://example.org/apqc#BankingPartner
ex:BankingPartner rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00001180 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000196 ;
                                    owl:someValuesFrom ex:BankingPartnerRole
                                  ] ;
                  rdfs:label "Banking Partner" ;
                  skos:definition "An Organization that bears a banking partner role and provides banking, financial-intermediary, or custodial services to a focal Organization." .


###  http://example.org/apqc#BankingPartnerRole
ex:BankingPartnerRole rdf:type owl:Class ;
                      rdfs:subClassOf obo:BFO_0000023 ;
                      rdfs:comment "Used for banks and financial intermediaries in treasury and international-funds processes (9.7, 9.10)." ;
                      rdfs:label "Banking Partner Role" ;
                      skos:definition "A Role that is borne by an Organization in virtue of providing banking, financial-intermediary, or custodial services to a focal Organization." .


###  http://example.org/apqc#BaselineDemandForecast
ex:BaselineDemandForecast rdf:type owl:Class ;
                          rdfs:subClassOf ex:DemandForecast ;
                          rdfs:label "Baseline Demand Forecast" ;
                          skos:definition "A Demand Forecast that describes the bedrock anticipated level of market demand, estimated from historical data and market analysis." .


###  http://example.org/apqc#BenchmarkAnalysis
ex:BenchmarkAnalysis rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:label "Benchmark Analysis" ;
                     skos:definition "A Descriptive Information Content Entity that describes a comparison of an Organization's performance internally or against external organizations." .


###  http://example.org/apqc#BenchmarkingCapability
ex:BenchmarkingCapability rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000568 ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty obo:BFO_0000054 ;
                                            owl:someValuesFrom ex:P21584
                                          ] ;
                          ex:enablesProcess ex:P21584 ;
                          rdfs:comment "Standing-function reading of APQC 13.6 'Measure and benchmark'. Improved by the bounded act ex:P11084 'Develop benchmarking capabilities'. Carries a realized-in restriction to the bounded enterprise measure-and-benchmark cycle ex:P21584 so the dual model (standing capability + bounded cycle) is coherent." ;
                          rdfs:label "Benchmarking Capability" ;
                          skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to measure and benchmark the performance of its internal processes and of the organization as a whole against internal or external reference points, realized in its bounded measure-and-benchmark cycles." .


###  http://example.org/apqc#BenefitClaim
ex:BenefitClaim rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:label "Benefit Claim" ;
                skos:definition "A Descriptive Information Content Entity that records a formal request by an employee asserting entitlement to a benefit." .


###  http://example.org/apqc#BenefitReconciliationStatement
ex:BenefitReconciliationStatement rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:label "Benefit Reconciliation Statement" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the comparison between the benefits claimed by and the benefits owed to an employee." .


###  http://example.org/apqc#BenefitsAndRewardsPlan
ex:BenefitsAndRewardsPlan rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:label "Benefits and Rewards Plan" ;
                          skos:definition "A Directive Information Content Entity that prescribes the rewards, commissions, and benefits to be provided to employees." .


###  http://example.org/apqc#BestPracticesRegister
ex:BestPracticesRegister rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Best Practices Register" ;
                         skos:definition "A Descriptive Information Content Entity that describes the practices and procedures identified as most effective for the success of a business." .


###  http://example.org/apqc#BillOfMaterials
ex:BillOfMaterials rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "DUPLICATE RECONCILED to ONE Directive class: a BOM prescribes which components/parts must be used to build the product. Output of the 2.3 design act ex:P16818 and the managed master-data object of the 2.1 act ex:P11742." ;
                   rdfs:label "Bill of Materials" ;
                   skos:definition "A Directive Information Content Entity that lists and prescribes the raw materials, components, and parts (across design, manufacturing, and service variants) required to produce an end product." ;
                   skos:example "An engineering, manufacturing, and service BOM for a new appliance." .


###  http://example.org/apqc#BoardOfDirectors
ex:BoardOfDirectors rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00001180 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty obo:BFO_0000196 ;
                                      owl:someValuesFrom ex:BoardOfDirectorsRole
                                    ] ;
                    rdfs:comment "Minted for 12.3. Modeled as Organization (a Group of Agents with rules), not as a single Agent." ;
                    rdfs:label "Board of Directors" ;
                    skos:definition "An Organization that bears a board-of-directors role in virtue of representing stockholders and governing a company's major decisions." .


###  http://example.org/apqc#BoardOfDirectorsRole
ex:BoardOfDirectorsRole rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000187 ;
                        rdfs:label "Board of Directors Role" ;
                        skos:definition "A Role that is borne by an Organization in virtue of representing stockholders and governing a focal company's major decisions." .


###  http://example.org/apqc#BrandPositioning
ex:BrandPositioning rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 3.2.1.2. Directive (Formulation)." ;
                    rdfs:label "Brand Positioning" ;
                    skos:definition "A Directive Information Content Entity that prescribes how a brand is projected and differentiated for target customer segments." .


###  http://example.org/apqc#BrandingCollateral
ex:BrandingCollateral rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Output of 3.2.1.4 (develop new branding) and 3.3.4.5 (execute promotional activities). Directive: collateral encodes a prescribed brand identity to be applied (Formulation genus). Modeled as an ICE (its content), not the physical artifact." ;
                      rdfs:label "Branding Collateral" ;
                      skos:definition "A Directive Information Content Entity, such as a name, design, symbol, or campaign, that prescribes the projected identity of an organization's offering." .


###  http://example.org/apqc#Budget
ex:Budget rdf:type owl:Class ;
          rdfs:subClassOf cco:ont00000965 ;
          rdfs:comment "Directive: a budget prescribes intended fund allocation, constraining subsequent spending." ,
                       "Has-input to budget-feasibility and capital-program work. Directive (cco:ont00000965): a budget prescribes intended fund allocation, constraining subsequent spending; harmonized to Directive corpus-wide (slices 9.0/12.0). The realized commitment of funds is captured by ex:CapitalInvestmentPlan. (The definition/comment formerly read 'Descriptive', contradicting the harmonized 965 anchor; corrected here.)" ,
                       "Input for 12.4.5.3 (Receive strategy/budget). Directive: a financial plan that constrains spending." ;
          rdfs:label "Budget" ;
          skos:definition "A Directive Information Content Entity that prescribes the planned allocation of funds for a project or program." ,
                          "A Directive Information Content Entity that prescribes the planned allocation of funds to activities over a defined period." ,
                          "A Directive Information Content Entity that prescribes, using figures, an organization's expected future financial results for an activity." .


###  http://example.org/apqc#BudgetAnalysis
ex:BudgetAnalysis rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "Budget Analysis" ;
                  skos:definition "A Descriptive Information Content Entity that describes a judgement of the feasibility of a budget prepared for construction or acquisition." .


###  http://example.org/apqc#BuildBuyDecision
ex:BuildBuyDecision rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Shared section-5.0 output (5.3.2.6). Directive: a decision prescribes the chosen course of action." ;
                    rdfs:label "Build/Buy Decision" ;
                    skos:definition "A Directive Information Content Entity that prescribes whether a service-delivery solution is to be constructed in-house or purchased." .


###  http://example.org/apqc#BuildBuyLeaseDecision
ex:BuildBuyLeaseDecision rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cco:ont00001808 ;
                                           owl:someValuesFrom ex:RealProperty
                                         ] ;
                         rdfs:comment "Directive: a decision that authorizes/selects a future course of action (acquisition mode). Distinct from a mere decision record." ;
                         rdfs:label "Build/Buy/Lease Decision" ;
                         skos:definition "A Directive Information Content Entity, about a property, that prescribes whether the organization will build, buy, or lease that property." .


###  http://example.org/apqc#BusinessAuthorization
ex:BusinessAuthorization rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000751 ;
                         rdfs:comment "Minted for 1.4.1.2 output. Subclass of cco:ont00000751 (Action Permission, altLabel Authorization/License), itself a Directive ICE." ;
                         rdfs:label "Business Authorization" ;
                         skos:definition "An Action Permission that authorizes the conduct of a particular business or business activity." .


###  http://example.org/apqc#BusinessCase
ex:BusinessCase rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Descriptive (an argument/justification representing a situation), not Directive; the go/no-go decision it supports is a separate Directive ICE." ,
                             "Reused naming from the reference module's 'business case' pattern. Descriptive: it argues for/against rather than prescribing. Output of 2.3.1.2, finalized at 2.3.2.3." ;
                rdfs:label "Business Case" ;
                skos:definition "A Descriptive Information Content Entity that describes a current situation, proposed solution, financial analysis, and conclusion in order to justify a course of action to a decision maker." ,
                                "A Descriptive Information Content Entity that describes an argument weighing the costs and benefits of a proposed product or service project." .


###  http://example.org/apqc#BusinessConcept
ex:BusinessConcept rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of process group 1.1 'Define the business concept and long-term vision'." ;
                   rdfs:label "Business Concept" ;
                   skos:definition "A Directive Information Content Entity that prescribes the conceptual framework of an organization's business activity with long-term applicability." .


###  http://example.org/apqc#BusinessContinuityPlan
ex:BusinessContinuityPlan rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Output of 11.4.2 (perform continuous business operations planning); subject of 11.4.3 (test) and 11.4.4 (maintain). Directive: prescribes continuity actions." ;
                          rdfs:label "Business Continuity Plan" ;
                          skos:definition "A Directive Information Content Entity that prescribes the arrangements ensuring continuous business operations are maintained, including during disruption or emergency." .


###  http://example.org/apqc#BusinessEnvironmentAssessment
ex:BusinessEnvironmentAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Output of 3.1.1.6. Descriptive (Appraisal genus). Distinct from the 1.1.1 ExternalEnvironmentAssessment by covering internal as well as external factors for a market-entry lens." ;
                                 rdfs:label "Business Environment Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the internal and external environment in which an organization operates and its bearing on bringing offerings to market." .


###  http://example.org/apqc#BusinessModel
ex:BusinessModel rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:comment "Output of group 1.4 'Develop and maintain business models'. Directive: an adopted business model serves as the guiding model for day-to-day operations." ;
                 rdfs:label "Business Model" ;
                 skos:definition "A Directive Information Content Entity that prescribes how an organization creates, delivers, and captures value, including its products, target market, and core economics." .


###  http://example.org/apqc#BusinessModelAdoptionDecision
ex:BusinessModelAdoptionDecision rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Minted for 1.4.1.4 output. Directive (a decision prescribes) rather than Descriptive." ;
                                 rdfs:label "Business Model Adoption Decision" ;
                                 skos:definition "A Directive Information Content Entity that prescribes that a particular business model is to serve as the accepted basis of an organization's operations." .


###  http://example.org/apqc#BusinessModelGovernanceCapability
ex:BusinessModelGovernanceCapability rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000568 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P20955
                                                     ] ;
                                     ex:enablesProcess ex:P20955 ;
                                     rdfs:comment "Realizable behind the standing functions 1.4.2 'Maintain business models' / 1.4.3 'Establish business model governance' when R5 demotes them from process to capability." ;
                                     rdfs:label "Business Model Governance Capability" ;
                                     skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to maintain and govern its business models through intentional acts of review, update, and control." .


###  http://example.org/apqc#BusinessModelGovernancePolicy
ex:BusinessModelGovernancePolicy rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Output of 1.4.3 'Establish business model governance' and the maintenance-parameter nodes of 1.4.2." ;
                                 rdfs:label "Business Model Governance Policy" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the responsibilities, control mechanisms, and review parameters for managing an organization's business models." .


###  http://example.org/apqc#BusinessModelInformation
ex:BusinessModelInformation rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:label "Business Model Information" ;
                            skos:definition "A Descriptive Information Content Entity that describes the materials, goals, and process facts gathered as the basis for developing or revising a business model." .


###  http://example.org/apqc#BusinessModelMaintenancePlan
ex:BusinessModelMaintenancePlan rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "Minted for 1.4.2.1 output. Directive (it prescribes the maintenance procedure)." ;
                                rdfs:label "Business Model Maintenance Plan" ;
                                skos:definition "A Directive Information Content Entity that prescribes the timeline, procedures, and responsibilities for reviewing and updating a business model." .


###  http://example.org/apqc#BusinessModelSourceMaterial
ex:BusinessModelSourceMaterial rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Minted (Gate-F) for P20946 'Assemble business model information' as the definitional input its Act-of-Information-Processing genus receives. Distinct from ex:BusinessModelInformation (the assembled output)." ;
                               rdfs:label "Business Model Source Material" ;
                               skos:definition "A Descriptive Information Content Entity comprising the relevant materials, documents, and process facts gathered as the raw input from which a business model is developed." .


###  http://example.org/apqc#BusinessObjectives
ex:BusinessObjectives rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Section-8.0 shared input. Recurs across 8.2 (align IT to business objectives), 8.5.1, 8.6.1, 8.7.1.1, 8.7.4.2. Directive: objectives prescribe an intended end-state." ;
                      rdfs:label "Business Objectives" ;
                      skos:definition "A Directive Information Content Entity that prescribes the overall business goals an organization intends its IT function to advance." .


###  http://example.org/apqc#BusinessOperationsEvaluation
ex:BusinessOperationsEvaluation rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "Output of 11.4.4 (maintain continuous business operations -- the text is evaluative)." ;
                                rdfs:label "Business Operations Evaluation" ;
                                skos:definition "A Descriptive Information Content Entity that describes a judgement of an organization's continuous business operations, including which activities generate revenue, perform best, and provide good returns." .


###  http://example.org/apqc#BusinessProcess
ex:BusinessProcess rdf:type owl:Class ;
                   rdfs:subClassOf obo:BFO_0000015 ;
                   rdfs:comment "Minted as the aboutness referent for descriptive process ICEs (e.g. ex:ProcessAnalysis, ex:ProcessModel). A business process is an occurrent (obo:BFO_0000015), NOT an ICE and NOT the ex:ProcessOwner Agent. S8 (is-about-on-ICE) is subject-only and does not constrain this filler." ;
                   rdfs:label "Business Process" ;
                   skos:definition "A Process consisting of a structured set of related activities and tasks carried out by the participants of one or more Organizations to achieve a business goal." .


###  http://example.org/apqc#BusinessProcessManagementCapability
ex:BusinessProcessManagementCapability rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000568 ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P16379
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P16384
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P16387
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P16392
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P21453
                                                       ] ;
                                       ex:enablesProcess ex:P16379 ,
                                                         ex:P16384 ,
                                                         ex:P16387 ,
                                                         ex:P16392 ,
                                                         ex:P21453 ;
                                       rdfs:comment "Models APQC group 13.1 'Manage business processes' (PCF 16378). Per R5/R6 the verb 'Manage' denotes a standing organizational function with no natural end, so it is an Organization Capability realized in the child acts -- NOT a process class. No ex:P16378 is minted." ;
                                       rdfs:label "Business Process Management Capability" ;
                                       skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to govern, define, administer, and improve its business processes, realized in the acts of establishing process governance, defining process frameworks, defining processes, managing process performance, and improving processes." .


###  http://example.org/apqc#BusinessResilienceStrategy
ex:BusinessResilienceStrategy rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Output of 11.4.1 (develop the business resilience strategy), produced by ex:ActOfFormulation (reused from ext)." ;
                              rdfs:label "Business Resilience Strategy" ;
                              skos:definition "A Directive Information Content Entity that prescribes an organization's integrated approach for rapidly adapting and responding to internal or external opportunities, demands, disruptions, or threats while protecting employees, assets, and brand equity." .


###  http://example.org/apqc#BusinessResiliencyCapability
ex:BusinessResiliencyCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P11221
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P11222
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P11223
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P11224
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P16471
                                                ] ;
                                ex:apqcSourceText "Including the processes required to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat. Develop a more dynamic, strategic, and integrated approach to managing compliance obligations." ;
                                ex:enablesProcess ex:P11221 ,
                                                  ex:P11222 ,
                                                  ex:P11223 ,
                                                  ex:P11224 ,
                                                  ex:P16471 ;
                                ex:hierarchyID "11.4" ;
                                ex:pcfID "11216" ;
                                rdfs:comment "Models APQC process group 11.4 ('Manage business resiliency') under R5/R6: it is a standing function with no natural end, so it is an Organization Capability (cco:ont00000568) realized in its constituent acts, NOT a process. Per R3/R5 it carries no has-process-part to its children. rdfs:label/skos:definition are supplied in the shared-vocabulary block above." ,
                                             "Models the standing function of 11.4 'Manage business resiliency' (R5/R6)." ;
                                rdfs:label "Business Resiliency Capability" ;
                                skos:definition "An Organization Capability that is realized in acts of developing resilience strategy, planning, testing, and maintaining continuous business operations, and sharing risk knowledge so an organization can rapidly adapt to disruption." ;
                                skos:example "An enterprise's standing ability to keep critical operations running and recover quickly during a regional outage." .


###  http://example.org/apqc#BusinessRule
ex:BusinessRule rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:comment "Output of 3.3.6.4 (develop business rules). Directive (Formulation)." ;
                rdfs:label "Business Rule" ;
                skos:definition "A Directive Information Content Entity that prescribes a formula or condition governing personalized offers, recommendations, or targeted advertisements." .


###  http://example.org/apqc#BusinessStrategy
ex:BusinessStrategy rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000974 ;
                    rdfs:comment "Directive input the section aligns to (APQC cross-reference 'Develop a business strategy [10015]'); used as has-input where concepts are checked for alignment (2.1.1.2)." ,
                                 "Reuses CCO Plan (ont00000974) rather than minting under ont00000965, because the CCO Plan definition ('prescribes some set of intended Intentional Acts through which some Agent expects to achieve some Objective') fits a strategy exactly. Base genus for the strategy outputs of 1.2.3, 1.2.7, and 1.2.8." ,
                                 "Shared has-input across 10.0 (e.g. confirm property requirements align with business strategy). Directive (cco:ont00000965): harmonized to Directive corpus-wide (cf. slice 2.0) so the shared class stays satisfiable across slices; the further prescriptive strategy artifacts produced within 10.0 are typed separately (e.g. ex:PropertyStrategy, ex:ConstructionStrategy). (The definition/comment formerly read 'Descriptive', contradicting the harmonized 965 anchor; corrected here.)" ;
                    rdfs:label "Business Strategy" ;
                    skos:definition "A Directive Information Content Entity that prescribes an organization's intended overall course of business action." ,
                                    "A Directive Information Content Entity that prescribes an organization's overall direction, goals, and competitive positioning, against which asset requirements are aligned." ,
                                    "A Plan that prescribes the set of intended intentional acts through which an organization expects to achieve its long-term business objectives." .


###  http://example.org/apqc#BusinessTechnologyStrategy
ex:BusinessTechnologyStrategy rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "8.2.1 supporting class. Directive (GOLDEN PRINCIPLE): a strategy prescribes a course of action. Output of an Act of Formulation." ;
                              rdfs:label "Business Technology and Governance Strategy" ;
                              skos:definition "A Directive Information Content Entity that prescribes an organization's intended use of technology in business together with the governance of its IT investments and security." .


###  http://example.org/apqc#BusinessTechnologyValueCommunication
ex:BusinessTechnologyValueCommunication rdf:type owl:Class ;
                                        rdfs:subClassOf cco:ont00000853 ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty cco:ont00001808 ;
                                                          owl:someValuesFrom ex:ITValueContributionAssessment
                                                        ] ;
                                        rdfs:comment "Minted (8.2.6.3) as the communicated descriptive product of P20696 'Communicate business technology value contribution'. Descriptive: an Act of Reporting (cco:ont00000151) characteristically yields a communicated Descriptive ICE, so this is the has-output that the bare has-input previously lacked -- Gate-F fix restoring sibling consistency with P20690 (input+output) and GOLDEN-PRINCIPLE traceability. Carries 'is about' the IT value contribution assessment it conveys." ;
                                        rdfs:label "Business Technology Value Communication" ;
                                        skos:definition "A Descriptive Information Content Entity that describes, for a stakeholder audience, the value contribution delivered through adopting technology for profitable business operations." .


###  http://example.org/apqc#BusinessUnit
ex:BusinessUnit rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00001180 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000196 ;
                                  owl:someValuesFrom ex:BusinessUnitRole
                                ] ;
                rdfs:label "Business Unit" ;
                skos:definition "An Organization that bears a business unit role within a larger parent organization." .


###  http://example.org/apqc#BusinessUnitRiskToleranceProfile
ex:BusinessUnitRiskToleranceProfile rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:comment "8.3.1.2 output. Descriptive." ;
                                    rdfs:label "Business Unit Risk Tolerance Profile" ;
                                    skos:definition "A Descriptive Information Content Entity that describes the risk tolerance levels of individual business units given their risk-return trade-offs." ;
                                    skos:example "A summary of each business unit's appetite for IT-service disruption." .


###  http://example.org/apqc#BusinessUnitRole
ex:BusinessUnitRole rdf:type owl:Class ;
                    rdfs:subClassOf obo:BFO_0000023 ;
                    rdfs:comment "Borne by the sub-organization (the unit), not by the business-unit-strategy ICE about it." ;
                    rdfs:label "Business Unit Role" ;
                    skos:definition "A Role that is borne by an Organization in virtue of being a constituent operating unit within a larger parent organization." .


###  http://example.org/apqc#BusinessValueAssessment
ex:BusinessValueAssessment rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:label "Business Value Assessment" ;
                           skos:definition "A Descriptive Information Content Entity that describes the assessed business or customer value of a strategic priority or initiative." .


###  http://example.org/apqc#BusinessValueDriver
ex:BusinessValueDriver rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Minted for PCF 19982/19983: distinct from ex:PerformanceMetric (a target measure) -- a driver is the underlying value-causing factor." ;
                       rdfs:label "Business Value Driver" ;
                       skos:definition "A Descriptive Information Content Entity that describes a key operational, financial, or sustainability indicator responsible for driving business value." .


###  http://example.org/apqc#BusinessValueDriverBaseline
ex:BusinessValueDriverBaseline rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Minted for PCF 19983/19984: distinct from ex:ProcessBaseline (process-scoped) -- this baselines a value driver. Distinct from ex:PerformanceRecord (actuals)." ;
                               rdfs:label "Business Value Driver Baseline" ;
                               skos:definition "A Descriptive Information Content Entity that records a baseline standard measure for a business value driver against which later performance is assessed." .


###  http://example.org/apqc#CandidateAssessment
ex:CandidateAssessment rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:JobCandidate
                                       ] ;
                       rdfs:comment "Descriptive (Appraisal output) and about the assessed JobCandidate." ;
                       rdfs:label "Candidate Assessment" ;
                       skos:definition "A Descriptive Information Content Entity that describes a judgement of a candidate's suitability derived from interviews and tests." .


###  http://example.org/apqc#CandidateBackgroundInformation
ex:CandidateBackgroundInformation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:label "Candidate Background Information" ;
                                  skos:definition "A Descriptive Information Content Entity that records the criminal, commercial, and financial background of a job candidate." .


###  http://example.org/apqc#CandidateData
ex:CandidateData rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:label "Candidate Data" ;
                 skos:definition "A Descriptive Information Content Entity that describes a job candidate, including qualifications, experience, and application details." .


###  http://example.org/apqc#CandidateSelectionDecision
ex:CandidateSelectionDecision rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:label "Candidate Selection Decision" ;
                              skos:definition "A Directive Information Content Entity that prescribes which candidates are to be approved and which rejected for a position." .


###  http://example.org/apqc#Capability
ex:Capability rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00001379 ;
              rdfs:label "FNSR Capability" ;
              skos:definition "A competence borne by an agent in virtue of which it can successfully perform some kind of process. Realized in process executions; a feasibility filter for dispatch." .


###  http://example.org/apqc#CapabilityConfirmation
ex:CapabilityConfirmation rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Output of 3.1.2.4.2 (PCF 10121). Descriptive because it reports the result of a verification rather than prescribing action." ;
                          rdfs:label "Internal Capability Confirmation" ;
                          skos:definition "A Descriptive Information Content Entity that describes a verification that an organization has sufficient infrastructure and resources to deliver and scale its offerings to an identified market segment." .


###  http://example.org/apqc#CapacityAssessment
ex:CapacityAssessment rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Capacity Assessment" ;
                      skos:definition "A Descriptive Information Content Entity that describes the manufacturing and processing capacities of an organization or supplier." .


###  http://example.org/apqc#CapacityUtilizationReport
ex:CapacityUtilizationReport rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:label "Capacity Utilization Report" ;
                             skos:definition "A Descriptive Information Content Entity that describes the extent to which an organization uses its installed productive capacity." .


###  http://example.org/apqc#CapitalExpensePolicy
ex:CapitalExpensePolicy rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:label "Capital Expense Policy" ;
                        skos:definition "A Directive Information Content Entity that prescribes rules and regulations governing expenditure on acquiring or upgrading manufacturing capital." .


###  http://example.org/apqc#CapitalInvestmentPlan
ex:CapitalInvestmentPlan rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Directive (a plan that prescribes intended investment acts). Output of Act of Planning / Formulation." ;
                         rdfs:label "Capital Investment Plan" ;
                         skos:definition "A Directive Information Content Entity that prescribes what funds will be invested in the construction or acquisition of productive assets in pursuit of established business objectives." .


###  http://example.org/apqc#CapitalProgramReport
ex:CapitalProgramReport rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Output of monitoring acts (proposed ex:ActOfMonitoring)." ;
                        rdfs:label "Capital Program Report" ;
                        skos:definition "A Descriptive Information Content Entity that describes the status, progress, and variances of a capital program against its plan." .


###  http://example.org/apqc#CareerPlan
ex:CareerPlan rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000965 ;
              rdfs:label "Career Plan" ;
              skos:definition "A Directive Information Content Entity that prescribes a future career path and development steps for an employee." .


###  http://example.org/apqc#Carrier
ex:Carrier rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00001180 ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty obo:BFO_0000196 ;
                             owl:someValuesFrom ex:CarrierRole
                           ] ;
           rdfs:label "Carrier" ;
           skos:definition "An Organization that bears a carrier role, conveying products between supply-chain locations on behalf of another organization." .


###  http://example.org/apqc#CarrierInvoice
ex:CarrierInvoice rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cco:ont00001808 ;
                                    owl:someValuesFrom ex:Carrier
                                  ] ;
                  rdfs:label "Carrier Invoice" ;
                  skos:definition "A Descriptive Information Content Entity that records the financial, regulatory, and administrative account of a carrier's freight transaction." .


###  http://example.org/apqc#CarrierInvoiceAuditResult
ex:CarrierInvoiceAuditResult rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Minted locally (D5): no shared-vocab ICE covers a carrier-freight invoice audit. Descriptive (not Directive) because it reports a reconciliation judgement rather than prescribing action. Rejected ex:PurchaseOrderReconciliationReport (procurement PO scope)." ;
                             rdfs:label "Carrier Invoice Audit Result" ;
                             skos:definition "A Descriptive Information Content Entity that reports the reconciliation of carrier invoices and freight account documents against shipment and contract records, recording verified charges and discrepancies." ;
                             skos:example "An audit summary listing matched freight charges and flagged carrier overbilling for a billing period." .


###  http://example.org/apqc#CarrierPerformanceReport
ex:CarrierPerformanceReport rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cco:ont00001808 ;
                                              owl:someValuesFrom ex:Carrier
                                            ] ;
                            rdfs:label "Carrier Performance Report" ;
                            skos:definition "A Descriptive Information Content Entity that describes the delivery performance of carriers conveying products from warehouses to retailers or consumers." .


###  http://example.org/apqc#CarrierRole
ex:CarrierRole rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000506 ;
               rdfs:label "Carrier Role" ;
               skos:definition "A Role that is borne by an Organization in virtue of conveying products between supply-chain locations on behalf of another organization." .


###  http://example.org/apqc#CashPosition
ex:CashPosition rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Local mint for 9.7.2.1; reconciliation input/output not covered by the shared vocabulary." ;
                rdfs:label "Cash Position" ;
                skos:definition "A Descriptive Information Content Entity that describes the reconciled balance of an organization's available cash funds at a point in time." .


###  http://example.org/apqc#CertificationAuthority
ex:CertificationAuthority rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00001180 ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty obo:BFO_0000196 ;
                                            owl:someValuesFrom ex:CertificationAuthorityRole
                                          ] ;
                          rdfs:comment "External certification body in group 7.3 (7.3.4.6.x)." ;
                          rdfs:label "Certification Authority" ;
                          skos:definition "An Organization that bears a certification-authority role in virtue of being empowered to issue and maintain certifications attesting to an agent's qualifications." .


###  http://example.org/apqc#CertificationAuthorityRole
ex:CertificationAuthorityRole rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000187 ;
                              rdfs:label "Certification Authority Role" ;
                              skos:definition "A Role that is borne by an Organization in virtue of being empowered to issue and maintain certifications attesting to an agent's qualifications." .


###  http://example.org/apqc#CertificationRecord
ex:CertificationRecord rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:label "Certification Record" ;
                       skos:definition "A Descriptive Information Content Entity that records an agent's attained certification and its maintenance status." .


###  http://example.org/apqc#CertificationTestResult
ex:CertificationTestResult rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Minted locally (group 7.3, used by P20127)." ;
                           rdfs:label "Certification Test Result" ;
                           skos:definition "A Descriptive Information Content Entity that describes the outcome of a certification test administered to a member of the workforce." ;
                           skos:example "A score report recording that an employee passed the welding certification examination." .


###  http://example.org/apqc#ChangeAdoptionMeasureSpecification
ex:ChangeAdoptionMeasureSpecification rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000965 ;
                                      rdfs:label "Change Adoption Measure Specification" ;
                                      skos:definition "A Directive Information Content Entity that prescribes the measures and standards for assessing the adoption of a change." .


###  http://example.org/apqc#ChangeBarrierAnalysis
ex:ChangeBarrierAnalysis rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Change Barrier Analysis" ;
                         skos:definition "A Descriptive Information Content Entity that describes the obstacles, resistors, and enablers bearing on an Organization's change." .


###  http://example.org/apqc#ChangeChampion
ex:ChangeChampion rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00001017 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000196 ;
                                    owl:someValuesFrom ex:ChangeChampionRole
                                  ] ;
                  rdfs:label "Change Champion" ;
                  skos:definition "An Agent that bears a change-champion role." .


###  http://example.org/apqc#ChangeChampionRole
ex:ChangeChampionRole rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000984 ;
                      rdfs:comment "Minted for APQC 13.4.1.3 'Identify change champion(s)' and 13.4.2.5 'Assign change champion(s)'." ;
                      rdfs:label "Change Champion Role" ;
                      skos:definition "A Role that is borne by an Agent in virtue of being designated to promote, communicate, and drive the adoption of a change initiative within a division or team of an Organization." .


###  http://example.org/apqc#ChangeImpactAssessment
ex:ChangeImpactAssessment rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Change Impact Assessment" ;
                          skos:definition "A Descriptive Information Content Entity that describes which groups and assets are impacted by a change and the degree of that impact." .


###  http://example.org/apqc#ChangeManagementCapability
ex:ChangeManagementCapability rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000568 ;
                              ex:enablesProcess ex:P11135 ,
                                                ex:P11136 ,
                                                ex:P11137 ,
                                                ex:P21457 ;
                              rdfs:comment "Shared target for the standing-function reading of APQC 13.4 'Manage change'. The 13.4 group node ex:P11074 models a single bounded change-management cycle as a Planned Act; this capability is the standing-function reading." ;
                              rdfs:label "Change Management Capability" ;
                              skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to plan, design, implement, and sustain organizational change." .


###  http://example.org/apqc#ChangeManagementPlan
ex:ChangeManagementPlan rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:label "Change Management Plan" ;
                        skos:definition "A Directive Information Content Entity that prescribes the reasons, type, scope, team, and communications for managing an Organization's change." .


###  http://example.org/apqc#ChangeManager
ex:ChangeManager rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00001017 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty obo:BFO_0000196 ;
                                   owl:someValuesFrom ex:ChangeManagerRole
                                 ] ;
                 rdfs:label "Change Manager" ;
                 skos:definition "An Agent that bears a change-manager role, held accountable for ensuring an Organization's change is managed systematically." .


###  http://example.org/apqc#ChangeManagerRole
ex:ChangeManagerRole rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000984 ;
                     rdfs:comment "Minted for APQC 13.4.1.12 'Establish accountability for change management'." ;
                     rdfs:label "Change Manager Role" ;
                     skos:definition "A Role that is borne by an Agent in virtue of being held accountable for ensuring that an Organization's change is planned, designed, implemented, and sustained systematically." .


###  http://example.org/apqc#ChangeNeedStatement
ex:ChangeNeedStatement rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Used by 13.6.2.5 'Establish need for change'; can feed 13.4 change planning." ;
                       rdfs:label "Change Need Statement" ;
                       skos:definition "A Directive Information Content Entity that prescribes the need and rationale for changing an Organization's performance, derived from gap-analysis results." .


###  http://example.org/apqc#ChangeReadinessAssessment
ex:ChangeReadinessAssessment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:label "Change Readiness Assessment" ;
                             skos:definition "A Descriptive Information Content Entity that describes the preparedness of the conditions, attitudes, and resources at all levels of an Organization for a change to succeed." .


###  http://example.org/apqc#ChangeReleaseApproval
ex:ChangeReleaseApproval rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "8.6.3.6 output. Directive (a decision permitting an action), analogous to the GOLD ex:GoNoGoDecision pattern." ;
                         rdfs:label "Change/Release Deployment Approval" ;
                         skos:definition "A Directive Information Content Entity that prescribes that a specified IT change or release deployment is permitted to proceed." .


###  http://example.org/apqc#ChangeReport
ex:ChangeReport rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:label "Change Report" ;
                skos:definition "A Descriptive Information Content Entity that describes the outcome of a change and the impact it had on critical assets." .


###  http://example.org/apqc#ChannelData
ex:ChannelData rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00000853 ;
               rdfs:comment "Input to 3.2.3 and 3.2.4. Descriptive." ;
               rdfs:label "Channel Data" ;
               skos:definition "A Descriptive Information Content Entity that describes the attributes, partners, costs, and performance of marketing and distribution channels." .


###  http://example.org/apqc#ChannelEvaluation
ex:ChannelEvaluation rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cco:ont00001808 ;
                                       owl:someValuesFrom ex:MarketingChannel
                                     ] ;
                     rdfs:comment "Output of 3.2.3.3 and 3.2.3.6. Descriptive (Appraisal); is about the MarketingChannel." ;
                     rdfs:label "Channel Evaluation" ;
                     skos:definition "A Descriptive Information Content Entity that describes the assessed attributes, fit, and partner capabilities of marketing channels." .


###  http://example.org/apqc#ChannelManagementCapability
ex:ChannelManagementCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16500
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16501
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16573
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16574
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000054 ;
                                                 owl:someValuesFrom ex:P16575
                                               ] ;
                               ex:apqcSourceText "Monitoring marketing and distribution efforts of all channels individually and as a network. Re-distribute or add resources to channels that perform better than expected. Purge or consolidate under-performing channels, and find more promising replacements." ;
                               ex:enablesProcess ex:P16500 ,
                                                 ex:P16501 ,
                                                 ex:P16573 ,
                                                 ex:P16574 ,
                                                 ex:P16575 ;
                               ex:hierarchyID "3.2.4" ;
                               ex:pcfID "20006" ;
                               rdfs:comment "Models APQC 3.2.4 (PCF 20006) as a standing Organization Capability (R5/R6), NOT a process: 'monitor ... re-distribute ... purge or consolidate ... find replacements' is an ongoing management function with no natural end. The IRI ex:ChannelManagementCapability (subClassOf cco:ont00000568) is declared in the shared supporting vocab; the realized-in axioms below wire it to this group's bounded child acts." ,
                                            "Standing capability behind 3.2.3, 3.2.4 ('Define and manage channel strategy', 'Analyze and manage channel performance') (R6). Realized-in axioms for PCF 20006 are attached additively below." ;
                               rdfs:label "Channel Management Capability" ;
                               skos:altLabel "Analyze and manage channel performance" ;
                               skos:definition "An Organization Capability that is realized in Acts of defining, analyzing, and managing marketing and distribution channels." .


###  http://example.org/apqc#ChannelPartnerRole
ex:ChannelPartnerRole rdf:type owl:Class ;
                      rdfs:subClassOf obo:BFO_0000023 ;
                      rdfs:comment "Narrower than SalesPartnerRole, specific to distribution intermediaries (3.2.3)." ;
                      rdfs:label "Channel Partner Role" ;
                      skos:definition "A Role that is borne by an Organization in virtue of serving as a distributor, wholesaler, or retailer in an organization's marketing or distribution channel." .


###  http://example.org/apqc#ChannelPerformanceAnalysis
ex:ChannelPerformanceAnalysis rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cco:ont00001808 ;
                                                owl:someValuesFrom ex:MarketingChannel
                                              ] ;
                              rdfs:comment "Output of 3.2.4.4. Descriptive (Analysis); is about the MarketingChannel." ;
                              rdfs:label "Channel Performance Analysis" ;
                              skos:definition "A Descriptive Information Content Entity that describes channel performance reviewed against chosen metrics, benchmarks, and targets." .


###  http://example.org/apqc#ChannelRequirements
ex:ChannelRequirements rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Output of 3.2.3.2, 3.2.3.5, 3.2.3.7.2. Directive (Formulation)." ;
                       rdfs:label "Channel Requirements" ;
                       skos:definition "A Directive Information Content Entity that prescribes the capabilities and preconditions a channel must satisfy to be adopted." .


###  http://example.org/apqc#ChannelSelection
ex:ChannelSelection rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 3.2.3.1 and 3.2.3.4. Directive (Selection genus): commits to chosen channels." ;
                    rdfs:label "Channel Selection" ;
                    skos:definition "A Directive Information Content Entity that prescribes the marketing channels chosen for target segments." .


###  http://example.org/apqc#ChannelStrategy
ex:ChannelStrategy rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of 3.2.3. Directive (Formulation)." ;
                   rdfs:label "Channel Strategy" ;
                   skos:definition "A Directive Information Content Entity that prescribes which marketing and distribution channels an organization will use and how they align with strategy for each segment." .


###  http://example.org/apqc#ChartOfAccounts
ex:ChartOfAccounts rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:label "Chart of Accounts" ;
                   skos:definition "A Descriptive Information Content Entity that enumerates and classifies the accounts used in an Organization's general ledger." .


###  http://example.org/apqc#ClaimAssessment
ex:ClaimAssessment rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:WarrantyClaim
                                   ] ;
                   rdfs:comment "Minted per Gate-F as the definitional output of P20100 (6.3.2.3.5). An Act of Appraisal is definitionally judgement-producing, so omitting the output left a thin appraisal class (Gate D thin-class risk). Descriptive (a judgement), satisfying the GOLDEN PRINCIPLE. Distinct from ex:ClaimDisposition (the Directive approve/reject decision committed by the Selection act P12668): P20100 JUDGES the results, P12668 COMMITS the decision." ;
                   rdfs:label "Claim Assessment" ;
                   skos:definition "A Descriptive Information Content Entity that records the warranty team's assessment of the investigation results and corrective-action recommendation toward approving or denying a warranty claim." .


###  http://example.org/apqc#ClaimClosureRecord
ex:ClaimClosureRecord rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Minted: output of P20105 (close claim). Descriptive closure artifact." ;
                      rdfs:label "Claim Closure Record" ;
                      skos:definition "A Descriptive Information Content Entity that records the archival and closure of a warranty claim following a final approve or reject decision." .


###  http://example.org/apqc#ClaimDisposition
ex:ClaimDisposition rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cco:ont00001808 ;
                                      owl:someValuesFrom ex:WarrantyClaim
                                    ] ;
                    rdfs:comment "Directive (a decision -> prescribes). Output of 6.3.2.6 (Approve or reject warranty claim); reused by notify (6.3.2.7) and authorize payment (6.3.2.8)." ;
                    rdfs:label "Claim Disposition" ;
                    skos:definition "A Directive Information Content Entity that prescribes the approval or rejection of a warranty claim." .


###  http://example.org/apqc#ClaimPreAuthorization
ex:ClaimPreAuthorization rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Output of 6.3.2.5. Directive: permits/prescribes that the claim may proceed; distinct from ex:PaymentAuthorization (authorizes disbursement) and ex:ClaimDisposition (final decision)." ;
                         rdfs:label "Claim Pre-Authorization" ;
                         skos:definition "A Directive Information Content Entity that grants preliminary authorization of a warranty claim prior to its formal submittal." .


###  http://example.org/apqc#CodeChangeSet
ex:CodeChangeSet rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000958 ;
                 rdfs:label "Code change set" ;
                 skos:definition "An Information Content Entity comprising a set of file changes that together implement a planned module." .


###  http://example.org/apqc#CodeImplementationCapability
ex:CodeImplementationCapability rdf:type owl:Class ;
                                rdfs:subClassOf ex:Capability ;
                                ex:enablesProcess ex:ImplementPhase ;
                                rdfs:label "Code implementation capability" ;
                                skos:definition "An Agent Capability that enables its bearer to implement a planned module as a working code change set." .


###  http://example.org/apqc#CodeOfEthics
ex:CodeOfEthics rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:comment "Minted for 9.8. Directive (cco:ont00000965), not Descriptive, because a code prescribes conduct rather than describing it." ;
                rdfs:label "Code of Ethics" ;
                skos:definition "A Directive Information Content Entity that prescribes the standards of ethical conduct expected of an organization's personnel." ;
                skos:example "A published corporate code of conduct circulated to all employees." .


###  http://example.org/apqc#CollectiveBargainingAgreement
ex:CollectiveBargainingAgreement rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Directive: an agreement prescribing working conditions, output of the collective-bargaining acts in group 7.4." ;
                                 rdfs:label "Collective Bargaining Agreement" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the conditions of employment agreed between an employer and a group of employees." .


###  http://example.org/apqc#CommunicationCalendar
ex:CommunicationCalendar rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Output of 3.2.5.1. Directive: a schedule prescribes when to act (Formulation genus). Reuse corrected (Gate-F): formerly also assigned to 3.4.2.10 (P11522) and 3.4.2.12 (P11468), but those concern a trade-event timetable, not message-delivery scheduling; they now use the dedicated ex:TradeMarketingCalendar." ;
                         rdfs:label "Communication Calendar" ;
                         skos:definition "A Directive Information Content Entity that prescribes the timing and scheduling of marketing message delivery." .


###  http://example.org/apqc#CommunicationPlan
ex:CommunicationPlan rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Shared across 13.2.3.3.4, 13.4.2.4, 13.5.1.7." ;
                     rdfs:label "Communication Plan" ;
                     skos:definition "A Directive Information Content Entity that prescribes the goals, audiences, and tools for imparting or exchanging information relevant to a project, change, or initiative." .


###  http://example.org/apqc#CommunicationStrategy
ex:CommunicationStrategy rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000974 ;
                         rdfs:comment "Reuses CCO Plan. Output of the 'communicate' nodes (1.1.4.3, 1.2.1.3, 1.2.9, 1.3.3.2, 1.2.8.2.7 content strategy)." ;
                         rdfs:label "Communication Strategy" ;
                         skos:definition "A Plan that prescribes the intended channels and acts for conveying a mission, vision, or strategy to stakeholders." .


###  http://example.org/apqc#Community
ex:Community rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00001180 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty obo:BFO_0000196 ;
                               owl:someValuesFrom ex:CommunityRole
                             ] ;
             rdfs:comment "Minted for 12.5.1 (Manage community relations). Modeled as Organization (a Group of Agents)." ;
             rdfs:label "Community" ;
             skos:definition "An Organization that bears a community role in virtue of constituting the population of the environment in which an organization operates and from which it draws resources." .


###  http://example.org/apqc#CommunityRole
ex:CommunityRole rdf:type owl:Class ;
                 rdfs:subClassOf obo:BFO_0000023 ;
                 rdfs:label "Community Role" ;
                 skos:definition "A Role that is borne by an Organization in virtue of constituting the population of the environment in which a focal organization operates." .


###  http://example.org/apqc#CompensationAndBenefitsCapability
ex:CompensationAndBenefitsCapability rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000568 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P10495
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P10497
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P21438
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P21439
                                                     ] ;
                                     ex:enablesProcess ex:P10495 ,
                                                       ex:P10497 ,
                                                       ex:P21438 ,
                                                       ex:P21439 ;
                                     rdfs:comment "For standing functions in group 7.5. Group 7.5's group node (PCF 10412) is mapped to this capability; its R6 realized-in axioms for group 7.5 are added in the group 7.5 section." ;
                                     rdfs:label "Compensation and Benefits Capability" ;
                                     skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to reward, recognize, compensate, and retain its employees and to administer their benefits and payroll." .


###  http://example.org/apqc#CompensationBenchmark
ex:CompensationBenchmark rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Compensation Benchmark" ;
                         skos:definition "A Descriptive Information Content Entity that describes a comparison of an organization's benefits and rewards against those of other organizations." .


###  http://example.org/apqc#CompensationRequirement
ex:CompensationRequirement rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Minted locally (group 7.5, used by P10501): no reuse-list ICE captures discerned compensation requirements; SkillRequirementData concerns skills, not pay. Descriptive (it represents requirements) rather than Directive (D6 false-friend guard: the 'Requirement' label is descriptive here; the directive obligation, if needed, is separate)." ;
                           rdfs:label "Compensation Requirement" ;
                           skos:definition "A Descriptive Information Content Entity that describes the compensation an employee or role requires given the organization's financial, benefits, and HR policies." .


###  http://example.org/apqc#CompensationStrategy
ex:CompensationStrategy rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:label "Compensation Strategy" ;
                        skos:definition "A Directive Information Content Entity that prescribes the combination of wages, salaries, and benefits employees receive and the terms on which it is paid." .


###  http://example.org/apqc#CompensationStructure
ex:CompensationStructure rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:label "Compensation Structure" ;
                         skos:definition "A Directive Information Content Entity that prescribes the components and pay bands of an organization's salary and compensation framework." .


###  http://example.org/apqc#CompetencyManagementModel
ex:CompetencyManagementModel rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:label "Competency Management Model" ;
                             skos:definition "A Directive Information Content Entity that prescribes how an organization manages the competency levels of its human resources, integrating HR planning with business planning." .


###  http://example.org/apqc#CompetencyRequirementSpecification
ex:CompetencyRequirementSpecification rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000965 ;
                                      rdfs:comment "Minted: no competency-requirement directive in the shared vocabulary (output of ex:P17479)." ;
                                      rdfs:label "Competency Requirement Specification" ;
                                      skos:definition "A Directive Information Content Entity that prescribes the competencies required to perform a defined set of quality-control activities." .


###  http://example.org/apqc#CompetingOrganization
ex:CompetingOrganization rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00001180 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty obo:BFO_0000196 ;
                                           owl:someValuesFrom ex:CompetitorRole
                                         ] ;
                         rdfs:comment "Subject of CompetitiveAnalysis. Modeled as Organization per APQC 'competing organizations'." ;
                         rdfs:label "Competing Organization" ;
                         skos:definition "An Organization that bears a competitor role in relation to some focal organization or market." .


###  http://example.org/apqc#CompetitiveAnalysis
ex:CompetitiveAnalysis rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:CompetingOrganization
                                       ] ;
                       rdfs:comment "Output of 3.1.1.4 and 3.5.3.4. Descriptive; is about the CompetingOrganization." ;
                       rdfs:label "Competitive Analysis" ;
                       skos:definition "A Descriptive Information Content Entity that describes the strengths, weaknesses, and attributes of competing organizations and substitute products relative to a focal organization." .


###  http://example.org/apqc#CompetitiveAnalysisCapability
ex:CompetitiveAnalysisCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00001379 ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000054 ;
                                                   owl:someValuesFrom ex:P19945
                                                 ] ;
                                 ex:enablesProcess ex:P19945 ;
                                 rdfs:comment "Carried over from the 1.1.1 reference module; the realized-in filler is re-pointed to ex:P19945 (this module's IRI for 'Identify competitors / Analyze competitors')." ;
                                 rdfs:label "Competitive Analysis Capability" ;
                                 skos:definition "An Agent Capability that is realized in Acts of Analyzing Competitors." .


###  http://example.org/apqc#CompetitiveBenchmark
ex:CompetitiveBenchmark rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "Competitive Benchmark" ;
                        skos:definition "A Descriptive Information Content Entity that describes a juxtaposition of processes and performance metrics against competitors." .


###  http://example.org/apqc#CompetitiveForcesAssessment
ex:CompetitiveForcesAssessment rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:label "Competitive Forces Assessment" ;
                               skos:definition "A Descriptive Information Content Entity that describes a judgement of the competitive forces in a marketplace." .


###  http://example.org/apqc#CompetitiveIntelligenceAnalyst
ex:CompetitiveIntelligenceAnalyst rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00001017 ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty obo:BFO_0000196 ;
                                                    owl:someValuesFrom ex:CompetitiveIntelligenceAnalystRole
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cco:ont00001954 ;
                                                    owl:someValuesFrom ex:CompetitiveAnalysisCapability
                                                  ] ;
                                  rdfs:comment "Narrower than BFO material entity: cco:Agent excludes tools, animals, and arbitrary material objects from being analysts." ;
                                  rdfs:label "Competitive Intelligence Analyst" ;
                                  skos:definition "An Agent that has a competitive analysis capability and bears a competitive-intelligence analyst role." .


###  http://example.org/apqc#CompetitiveIntelligenceAnalystRole
ex:CompetitiveIntelligenceAnalystRole rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000984 ;
                                      rdfs:label "Competitive Intelligence Analyst Role" ;
                                      skos:definition "A Role that is borne by an Agent in virtue of being tasked with analyzing competitors on behalf of an Organization." .


###  http://example.org/apqc#Competitor
ex:Competitor rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00001180 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty obo:BFO_0000196 ;
                                owl:someValuesFrom ex:CompetitorRole
                              ] ;
              rdfs:comment "Modeled as Organization per APQC 'competing firms'. Use cco:Agent for individual (non-organizational) competitors." ;
              rdfs:label "Competitor" ;
              skos:definition "An Organization that bears a competitor role in relation to some focal organization or market." .


###  http://example.org/apqc#CompetitorAnalysis
ex:CompetitorAnalysis rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001808 ;
                                        owl:someValuesFrom ex:Competitor
                                      ] ;
                      rdfs:comment "Carried over from the 1.1.1 reference module. Descriptive (not Directive) because it represents competitors rather than prescribing a course of action." ;
                      rdfs:label "Competitor Analysis" ;
                      skos:definition "A Descriptive Information Content Entity that describes one or more competitors with respect to their strengths and weaknesses relative to a focal organization." ;
                      skos:example "A report comparing two competitors' pricing, product capabilities, and market position." .


###  http://example.org/apqc#CompetitorData
ex:CompetitorData rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:comment "Recurring input in 3.1.1.4, 3.5.3.4. Descriptive representation of rivals." ;
                  rdfs:label "Competitor Data" ;
                  skos:definition "A Descriptive Information Content Entity that describes competing organizations and their products or services." ,
                                  "A Descriptive Information Content Entity that describes competitors and their products or services." .


###  http://example.org/apqc#CompetitorRole
ex:CompetitorRole rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000023 ;
                  rdfs:comment "Borne by an independent continuant (the rival Organization), never by the analysis ICE that is about it." ,
                               "Reused intent from the 1.1.1 reference module; re-stated for section 3.0 (3.1.1.4, 3.5.3.4)." ;
                  rdfs:label "Competitor Role" ;
                  skos:definition "A Role that is borne by an Organization in virtue of competing with a focal organization in a market." .


###  http://example.org/apqc#ComplaintAnalysis
ex:ComplaintAnalysis rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cco:ont00001808 ;
                                       owl:someValuesFrom ex:CustomerComplaint
                                     ] ;
                     rdfs:comment "Output of 6.2.3.5 and the complaint-data analysis of 6.5.2." ;
                     rdfs:label "Complaint Analysis" ;
                     skos:definition "A Descriptive Information Content Entity that describes patterns and insights drawn from complaint logs for service improvement and customer profiling." .


###  http://example.org/apqc#ComplaintResolution
ex:ComplaintResolution rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:CustomerComplaint
                                       ] ;
                       rdfs:comment "Output of 6.2.3.3 (Resolve customer complaints)." ;
                       rdfs:label "Complaint Resolution" ;
                       skos:definition "A Descriptive Information Content Entity that records the redress determined for a sound and reasonable customer complaint." .


###  http://example.org/apqc#ComplaintResponse
ex:ComplaintResponse rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cco:ont00001808 ;
                                       owl:someValuesFrom ex:CustomerComplaint
                                     ] ;
                     rdfs:comment "Output of 6.2.3.4 (Respond to customer complaints)." ;
                     rdfs:label "Complaint Response" ;
                     skos:definition "A Descriptive Information Content Entity communicated to a customer that conveys an organization's reply to their complaint." .


###  http://example.org/apqc#CompletedServiceOrderRegister
ex:CompletedServiceOrderRegister rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Minted: output of P10334. Descriptive register." ;
                                 rdfs:label "Completed Service Order Register" ;
                                 skos:definition "A Descriptive Information Content Entity that registers the service orders that have been successfully completed and delivered to the customer." .


###  http://example.org/apqc#ComplianceAssessment
ex:ComplianceAssessment rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Shared output of appraisal acts in 11.2.2.4 and input to control-implementation acts (11.2.2.5)." ;
                        rdfs:label "Compliance Assessment" ;
                        skos:definition "A Descriptive Information Content Entity that describes a judgement of an organization's current compliance position against applicable regulations, including identified weaknesses, shortfalls, and necessary changes." .


###  http://example.org/apqc#ComplianceAuditReport
ex:ComplianceAuditReport rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Compliance Audit Report" ;
                         skos:definition "A Descriptive Information Content Entity that describes the findings of an audit of hazardous-material handling, disposal, and reporting practices against regulatory requirements." .


###  http://example.org/apqc#ComplianceCapabilityDemonstration
ex:ComplianceCapabilityDemonstration rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000853 ;
                                     rdfs:comment "Minted: descriptive evidentiary artifact (SPC, process-capability analysis) of conformance ability (output of ex:P17480)." ;
                                     rdfs:label "Compliance Capability Demonstration" ;
                                     skos:definition "A Descriptive Information Content Entity that describes evidence demonstrating an organization's ability to confirm and fulfil its quality requirements before stakeholders." .


###  http://example.org/apqc#ComplianceControl
ex:ComplianceControl rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output/subject of 11.2.2.5 (implement missing or stronger controls) and 11.2.1.4 (controls-related technologies and tools). Directive: a control prescribes required behaviour." ;
                     rdfs:label "Compliance Control Specification" ;
                     skos:definition "A Directive Information Content Entity that prescribes a control, safeguard, or check implemented to ensure regulatory compliance and the security of an organization's information and processes." .


###  http://example.org/apqc#ComplianceManagementCapability
ex:ComplianceManagementCapability rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000568 ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty obo:BFO_0000054 ;
                                                    owl:someValuesFrom ex:P17468
                                                  ] ;
                                  ex:enablesProcess ex:P17468 ;
                                  rdfs:comment "Models the standing function of 11.2 'Manage compliance' (R5/R6). Its regulatory-compliance facet is further specialized by ex:RegulatoryComplianceManagementCapability." ;
                                  rdfs:label "Compliance Management Capability" ;
                                  skos:definition "An Organization Capability that is realized in acts of establishing compliance frameworks and policies and of managing enduring compliance with industry regulations and government legislation." .


###  http://example.org/apqc#ComplianceMonitoringReport
ex:ComplianceMonitoringReport rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "Output of 11.2.2.6 (monitor and test regulatory compliance position), produced by ex:ActOfVerification (inlined above)." ;
                              rdfs:label "Compliance Monitoring Report" ;
                              skos:definition "A Descriptive Information Content Entity that describes the observed compliance position of an organization and the robustness of its existing controls, tracked and tested over time against regulatory requirements." .


###  http://example.org/apqc#ComplianceOfficer
ex:ComplianceOfficer rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00001017 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000196 ;
                                       owl:someValuesFrom ex:ComplianceOfficerRole
                                     ] ;
                     rdfs:comment "Definitional participant in compliance acts across 11.2." ;
                     rdfs:label "Compliance Officer" ;
                     skos:definition "An Agent that bears a compliance-officer role." .


###  http://example.org/apqc#ComplianceOfficerRole
ex:ComplianceOfficerRole rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000984 ;
                         rdfs:label "Compliance Officer Role" ;
                         skos:definition "A Role that is borne by an Agent in virtue of being tasked with validating, maintaining, and ensuring an organization's enduring compliance with applicable regulations and legislation." .


###  http://example.org/apqc#CompliancePersonnel
ex:CompliancePersonnel rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001017 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:ComplianceOfficerRole
                                       ] ;
                       rdfs:comment "Minted for 12.4.4 (Ensure compliance; coordinate with compliance and risk-management personnel)." ;
                       rdfs:label "Compliance Personnel" ;
                       skos:definition "An Agent that bears a compliance-officer role in virtue of being tasked with validating and maintaining an organization's compliance position." .


###  http://example.org/apqc#CompliancePolicy
ex:CompliancePolicy rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 12.4.4 / 12.4.4.1 (compliance framework and programs)." ,
                                 "Shared output across 11.2.1.1 (enterprise compliance policies) and 11.2.2.1 (regulatory compliance procedures). Directive: prescribes compliance conduct." ;
                    rdfs:label "Compliance Policy" ,
                               "Compliance Policy and Procedure" ;
                    skos:definition "A Directive Information Content Entity that prescribes an organization's standardized approach to ethics and compliance and the procedures for complying with applicable guidelines, provisions, and legislation." ,
                                    "A Directive Information Content Entity that prescribes the framework, rules, and procedures by which an organization maintains adherence to applicable statutes and regulations." .


###  http://example.org/apqc#ComplianceProgram
ex:ComplianceProgram rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output of 12.4.4.1 (Plan and initiate compliance program); implemented by 12.4.4.2." ;
                     rdfs:label "Compliance Program" ;
                     skos:definition "A Directive Information Content Entity that prescribes the internal system and activities for identifying and reducing the risk of breaching applicable laws and regulations." .


###  http://example.org/apqc#ComplianceReport
ex:ComplianceReport rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Transferred ICE of 11.2.2.8 (compile and communicate internal and regulatory compliance reports): an already-compiled report submitted to regulators, modeled as the `has input` of P19596 (cco:ont00000151 communication/submission act), not its output. Descriptive: it represents compliance state." ;
                    rdfs:label "Compliance Report" ,
                               "Internal Controls Compliance Report" ;
                    skos:definition "A Descriptive Information Content Entity that describes an organization's compliance status for submission to internal stakeholders or regulatory agencies." ,
                                    "A Descriptive Information Content Entity that describes the state of an Organization's compliance with its internal-control policies and procedures." .


###  http://example.org/apqc#ComplianceScorecard
ex:ComplianceScorecard rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Output of 11.2.2.7 (compile and communicate compliance scorecards)." ;
                       rdfs:label "Compliance Scorecard" ;
                       skos:definition "A Descriptive Information Content Entity that presents a graphical summary of metrics describing the general health of an organization with respect to risk and compliance." .


###  http://example.org/apqc#ConsensusDemandForecast
ex:ConsensusDemandForecast rdf:type owl:Class ;
                           rdfs:subClassOf ex:DemandForecast ;
                           rdfs:comment "Shared section-5.0 output (5.2.1.4)." ;
                           rdfs:label "Consensus Demand Forecast" ;
                           skos:definition "A Demand Forecast that describes a level of future demand agreed upon by reconciling baseline forecasts with customer input." ,
                                           "A Demand Forecast that describes an agreed level of anticipated demand reconciled between baseline forecasts and customer-collaboration estimates." .


###  http://example.org/apqc#ConsolidatedFinancialStatement
ex:ConsolidatedFinancialStatement rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:label "Consolidated Financial Statement" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the combined financial position and results of a parent Organization and its subsidiaries." .


###  http://example.org/apqc#ConsolidationQuantity
ex:ConsolidationQuantity rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Minted because no shared-vocab Descriptive ICE captures a source-consolidation volume; it is the output of Calculate consolidation at source [10255]. Descriptive (states a computed quantity), so its producing act is an Act of Analysis." ;
                         rdfs:label "Consolidation Quantity" ;
                         skos:definition "A Descriptive Information Content Entity that states the aggregate volume of finished products consolidated at a source location for delivery on a given date." .


###  http://example.org/apqc#ConstrainedMaterialsPlan
ex:ConstrainedMaterialsPlan rdf:type owl:Class ;
                            rdfs:subClassOf ex:MaterialsPlan ;
                            rdfs:label "Constrained Materials Plan" ;
                            skos:definition "A Materials Plan that prescribes raw-material and inventory provision bounded by the actual supply-chain scenario." .


###  http://example.org/apqc#ConstructionContractor
ex:ConstructionContractor rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00001017 ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty obo:BFO_0000196 ;
                                            owl:someValuesFrom ex:ConstructionContractorRole
                                          ] ;
                          rdfs:comment "Modeled as Agent (rather than Organization) so it covers both individual and organizational contractors; slice modules may narrow to Organization where the text requires." ;
                          rdfs:label "Construction Contractor" ;
                          skos:definition "An Agent that bears a construction contractor role." .


###  http://example.org/apqc#ConstructionContractorRole
ex:ConstructionContractorRole rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000506 ;
                              rdfs:label "Construction Contractor Role" ;
                              skos:definition "A Role that is borne by an Agent in virtue of being engaged to perform or oversee construction work on an organization's assets." .


###  http://example.org/apqc#ConstructionFinancing
ex:ConstructionFinancing rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Output of an acquisition act (securing financing). Directive because a financing agreement prescribes obligations." ;
                         rdfs:label "Construction Financing Arrangement" ;
                         skos:definition "A Directive Information Content Entity, such as a loan agreement, that prescribes the terms under which funds are provided to construct necessary assets." .


###  http://example.org/apqc#ConstructionPermit
ex:ConstructionPermit rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Directive: a permit authorizes future action under stated conditions. Obtained via an acquisition act (ex:ActOfAcquisition)." ;
                      rdfs:label "Construction Permit" ;
                      skos:definition "A Directive Information Content Entity, issued by a jurisdiction, that authorizes and prescribes conditions for performing construction work on an asset." .


###  http://example.org/apqc#ConstructionResource
ex:ConstructionResource rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000040 ;
                        rdfs:comment "Anchored at BFO material entity because resources range over materials and equipment (artifacts) as well as raw materials (non-artifacts)." ;
                        rdfs:label "Construction Resource" ;
                        skos:definition "A Material Entity, such as materials, equipment, or labor input, that is acquired and consumed or employed in performing construction work." .


###  http://example.org/apqc#ConstructionResourcePlan
ex:ConstructionResourcePlan rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:label "Construction Resource Plan" ;
                            skos:definition "A Directive Information Content Entity that prescribes which resources will be acquired for construction, and when, where, how, and for how long they will be used." .


###  http://example.org/apqc#ConstructionSchedule
ex:ConstructionSchedule rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "Directive (a schedule prescribes when intended acts occur)." ;
                        rdfs:label "Construction Schedule" ;
                        skos:definition "A Directive Information Content Entity that prescribes a timetable for executing the construction of an asset." .


###  http://example.org/apqc#ConstructionStrategy
ex:ConstructionStrategy rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "Directive (a strategy prescribing intended course of action); output of Act of Formulation." ;
                        rdfs:label "Construction Strategy" ;
                        skos:definition "A Directive Information Content Entity that prescribes the approach for performing asset construction so that timelines, regulations, resources, and budget are met." .


###  http://example.org/apqc#ContactRecord
ex:ContactRecord rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Input/output for 12.2.2.3 (Maintain documentation of contacts)." ;
                 rdfs:label "Contact Record" ;
                 skos:definition "A Descriptive Information Content Entity that describes a partner, prospect, or customer within an organization's network of contacts." .


###  http://example.org/apqc#ContactVolumeForecast
ex:ContactVolumeForecast rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000626 ;
                         rdfs:comment "Output of 6.2.1.1. PREDICTIVE ICE (cco:ont00000626 subClassOf Descriptive ICE): estimates an uncertain future volume, matching the forecast pattern in slices 3 and 5. Produced by ex:ActOfForecasting." ;
                         rdfs:label "Contact Volume Forecast" ;
                         skos:definition "A Predictive Information Content Entity that estimates the future volume of customer service contacts and the workforce required to service them." .


###  http://example.org/apqc#ContaminatedMaterial
ex:ContaminatedMaterial rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000040 ;
                        rdfs:comment "Material subject of 11.3 remediation. Anchored at BFO material entity (obo:BFO_0000040) rather than a 'Portion of Waste Material' class (processed material the user wants to dispose of) because contaminated soil/water/site is not necessarily processed waste; the relevant fact is its adulterated state. The remediation PLAN and POLICY are separate informational artifacts (Directive ICEs)." ;
                        rdfs:label "Contaminated Material" ;
                        skos:definition "A Material Entity that has been subject to environmental adulteration and that remediation efforts seek to identify and treat so that the affected area becomes operational again." .


###  http://example.org/apqc#ContinuityTestResult
ex:ContinuityTestResult rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Output of 11.4.3 (test continuous business operations), produced by ex:ActOfVerification (inlined above)." ;
                        rdfs:label "Continuity Test Result" ;
                        skos:definition "A Descriptive Information Content Entity that describes the results of assessing whether continuous business operations perform as intended under test conditions." .


###  http://example.org/apqc#Contract
ex:Contract rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000965 ;
            rdfs:comment "Output of 12.4.9 (Negotiate and document agreements/contracts) and the engagement instrument in 12.4.5.2." ;
            rdfs:label "Contract" ;
            skos:definition "A Directive Information Content Entity that prescribes the mutually agreed terms binding two or more parties to a course of action." .


###  http://example.org/apqc#ContractFulfillmentConfirmation
ex:ContractFulfillmentConfirmation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000853 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cco:ont00001808 ;
                                                     owl:someValuesFrom ex:ServiceDeliveryContract
                                                   ] ;
                                   rdfs:comment "Minted locally: APQC 5.3.3.3 output; no shared-vocab ICE supplied." ;
                                   rdfs:label "Contract Fulfillment Confirmation" ;
                                   skos:definition "A Descriptive Information Content Entity that describes confirmation that all terms of a service-delivery contract have been satisfied." ;
                                   skos:example "A sign-off memo stating every contractual deliverable has been met." .


###  http://example.org/apqc#ContractManufacturer
ex:ContractManufacturer rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00001180 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:BFO_0000196 ;
                                          owl:someValuesFrom ex:SupplierRole
                                        ] ;
                        rdfs:label "Contract Manufacturer" ;
                        skos:definition "An Organization that bears a supplier role and manufactures products under contract on behalf of a procuring organization." .


###  http://example.org/apqc#ContractReviewAssessment
ex:ContractReviewAssessment rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Minted: no shared-vocab ICE for contract-administration findings. Descriptive because it represents review findings, not new terms." ;
                            rdfs:label "Contract Review Assessment" ;
                            skos:definition "A Descriptive Information Content Entity that describes the findings of a periodic review of a supplier contract for currency and compliance." ;
                            skos:example "A quarterly note flagging that a contract's pricing schedule has lapsed and needs renewal." .


###  http://example.org/apqc#ContractTermsReview
ex:ContractTermsReview rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:ServiceDeliveryContract
                                       ] ;
                       rdfs:comment "Minted locally (Gate-F fix, 5.3.1.1): output of ex:P20060. Rejected reuse of ex:ServiceDeliveryReview, which is defined as 'an end-to-end evaluation of the SUCCESS of a COMPLETED service-delivery engagement' (a post-delivery retrospective, the correct output of ex:P20078): a contract-terms appraisal at INITIATION cannot output a completed-engagement success review. 'is about' the contract whose terms it appraises. Descriptive: it records an appraisal judgement." ;
                       rdfs:label "Contract Terms Review" ;
                       skos:definition "A Descriptive Information Content Entity that describes a judgement, formed at service-delivery initiation, of the terms of a solutions contract under review prior to their agreement." ;
                       skos:example "Meeting notes recording the agreed and contested clauses of a solutions contract before sign-off." .


###  http://example.org/apqc#ControlEffectivenessAssessment
ex:ControlEffectivenessAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:label "Control Effectiveness Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes a judgement of how effectively an Organization's internal controls mitigate risk." .


###  http://example.org/apqc#ControlResponsibilityAssignment
ex:ControlResponsibilityAssignment rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000965 ;
                                   rdfs:comment "Minted for 9.8. Directive because it prescribes who is accountable for what. Output of both 'establish board/audit committee' and 'assign roles and responsibility for internal controls'." ;
                                   rdfs:label "Control Responsibility Assignment" ;
                                   skos:definition "A Directive Information Content Entity that prescribes the roles, responsibilities, and accountabilities of agents for the effectiveness of an organization's internal controls and financial reporting." ;
                                   skos:example "A RACI matrix assigning internal-control duties to the audit committee and process owners." .


###  http://example.org/apqc#ControlsTechnologyMaintenanceCapability
ex:ControlsTechnologyMaintenanceCapability rdf:type owl:Class ;
                                           rdfs:subClassOf cco:ont00000568 ;
                                           rdfs:comment "Reality-layer correlate of APQC 11.2.1.4 (PCF 14137), a standing 'Maintain' function with no natural end; modeled as a capability (R5/R6) rather than a process." ;
                                           rdfs:label "Controls Technology Maintenance Capability" ;
                                           skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to manage and maintain the technologies and tools that safeguard the confidentiality, integrity, and availability of its information." .


###  http://example.org/apqc#CoreCompetencyAnalysis
ex:CoreCompetencyAnalysis rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Core Competency Analysis" ;
                          skos:definition "A Descriptive Information Content Entity that describes the strategically significant competences and capacities that differentiate an organization in its market." .


###  http://example.org/apqc#CorporateCreditCard
ex:CorporateCreditCard rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000995 ;
                       rdfs:comment "Material object handled in 9.6.3 (manage corporate credit cards): ordered, issued, deactivated. Anchored to cco:ont00000995 (Material Artifact), NOT cco:ont00000537 (Financial Instrument): a credit card is an access/authorization device, not a tradeable asset, so 537's 'designed to be a tradeable asset' differentia is unsatisfied (a finance-theme false friend). Genuinely tradeable instruments are modeled separately under 537 via ex:FinancialInstrument." ;
                       rdfs:label "Corporate Credit Card" ;
                       skos:definition "A Material Artifact issued to an Organization or its personnel that is designed to realize the function of authorizing the charging of business expenses to a corporate credit account." .


###  http://example.org/apqc#CorporateGovernancePolicy
ex:CorporateGovernancePolicy rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Output of 12.4.2 (Manage corporate governance policies)." ;
                             rdfs:label "Corporate Governance Policy" ;
                             skos:definition "A Directive Information Content Entity that prescribes the system of rules, practices, and processes through which a company is directed and controlled." .


###  http://example.org/apqc#CorrectiveActionCompletionRecord
ex:CorrectiveActionCompletionRecord rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ;
                                    rdfs:comment "Descriptive (a completion/effect record), not Directive: it represents what was done and the brought-about state, in contrast to the governing ex:CorrectiveAndPreventiveActionSpecification (the input directive). Output of ex:P17496 'Take corrective or preventative action'." ;
                                    rdfs:label "Corrective Action Completion Record" ;
                                    skos:definition "A Descriptive Information Content Entity that describes the corrective and preventive actions carried out against a non-conformity and the resulting state after implementation and monitoring." ;
                                    skos:example "A closed CAPA log entry recording the tooling change implemented and the post-change defect rate observed." .


###  http://example.org/apqc#CorrectiveActionRecommendation
ex:CorrectiveActionRecommendation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:comment "Output of 6.3.2.3.4 (Investigate issue / root cause analysis), consumed by claim disposition (6.3.2.5-6) and supplier recovery (6.3.3.1)." ;
                                  rdfs:label "Corrective Action Recommendation" ;
                                  skos:definition "A Directive Information Content Entity that prescribes the corrective action to take in response to a diagnosed warranty issue." .


###  http://example.org/apqc#CorrectiveActionRecord
ex:CorrectiveActionRecord rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Minted for 9.8.2.2. Descriptive: it records what remediation was performed. The remediation act itself is a Planned Act, not an information-processing act." ;
                          rdfs:label "Corrective Action Record" ;
                          skos:definition "A Descriptive Information Content Entity that describes the corrective measures taken to rectify deficiencies in an organization's internal controls." ;
                          skos:example "A remediation log noting that a missing approval control was reinstated for the procurement workflow." .


###  http://example.org/apqc#CorrectiveAndPreventiveActionSpecification
ex:CorrectiveAndPreventiveActionSpecification rdf:type owl:Class ;
                                              rdfs:subClassOf cco:ont00000965 ;
                                              rdfs:label "Corrective and Preventive Action Specification" ;
                                              skos:definition "A Directive Information Content Entity that prescribes the corrective and preventive actions to eliminate the cause of a detected non-conformity and prevent its recurrence." .


###  http://example.org/apqc#CostAnalysis
ex:CostAnalysis rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Output of 3.3.2.2, 3.3.3.1 and the cost-calculation activities of 3.4.3 (3.4.3.3-.4). Descriptive (Analysis/Info-Processing genus)." ;
                rdfs:label "Cost Analysis" ;
                skos:definition "A Descriptive Information Content Entity that describes the calculated costs of marketing, producing, distributing, or selling offerings." ,
                                "A Descriptive Information Content Entity that describes the composition, drivers, and behavior of an Organization's costs." .


###  http://example.org/apqc#CostBenefitAnalysis
ex:CostBenefitAnalysis rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:ProductiveAsset
                                       ] ;
                       rdfs:label "Cost-Benefit Analysis" ;
                       skos:definition "A Descriptive Information Content Entity, about an asset, that describes a comparison of the asset's total lifecycle cost against repair, refurbishment, replacement, and alternative-solution options to inform retention or end-of-life decisions." .


###  http://example.org/apqc#CostData
ex:CostData rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000853 ;
            rdfs:comment "Input to pricing (3.2.2, 3.3.3) and budgeting (3.3.2, 3.4.3). Descriptive." ;
            rdfs:label "Cost Data" ;
            skos:definition "A Descriptive Information Content Entity that describes the costs incurred in producing products, delivering services, or performing activities." ,
                            "A Descriptive Information Content Entity that describes the production, distribution, marketing, and overhead costs associated with offerings or activities." .


###  http://example.org/apqc#CostDriverMeasurement
ex:CostDriverMeasurement rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Minted: distinct from ex:CostDriverSpecification (which names the drivers) - this records their quantified values. Descriptive measurement record." ;
                         rdfs:label "Cost-Driver Measurement" ;
                         skos:definition "A Descriptive Information Content Entity that records the measured magnitudes of identified cost drivers." ;
                         skos:example "A table giving 12,400 machine-hours and 830 setups for the period." .


###  http://example.org/apqc#CostDriverSpecification
ex:CostDriverSpecification rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Minted: shared vocab has ex:CostData (raw cost facts) and ex:CostAnalysis (a cost study) but no class for the enumerated set of identified cost drivers. Descriptive because it registers what the drivers are." ;
                           rdfs:label "Cost-Driver Specification" ;
                           skos:definition "A Descriptive Information Content Entity that registers the factors identified as driving the cost of an activity." ;
                           skos:example "A list naming machine-hours, setups, and order lines as the drivers of warehousing cost." .


###  http://example.org/apqc#CostTarget
ex:CostTarget rdf:type owl:Class ;
              rdfs:subClassOf cco:ont00000965 ;
              rdfs:comment "Output of 2.1.1.4." ;
              rdfs:label "Cost Target" ;
              skos:definition "A Directive Information Content Entity that prescribes a budgetary or development-cost target for a product or service portfolio." .


###  http://example.org/apqc#CreditAssessment
ex:CreditAssessment rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cco:ont00001808 ;
                                      owl:someValuesFrom ex:Customer
                                    ] ;
                    rdfs:label "Credit Assessment" ;
                    skos:definition "A Descriptive Information Content Entity that describes a judgement of a customer's or applicant's creditworthiness." .


###  http://example.org/apqc#CreditPolicy
ex:CreditPolicy rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:label "Credit Policy" ;
                skos:definition "A Directive Information Content Entity that prescribes the credit standards, terms, and collection rules an Organization applies to its customers." .


###  http://example.org/apqc#CreditScoreRequirementSpecification
ex:CreditScoreRequirementSpecification rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000965 ;
                                       rdfs:comment "Directive (not Descriptive): a requirement prescribes a threshold the applicant must satisfy, rather than describing a projected future state. Minted for ex:P14188 ('Planning credit score requirements based on established credit policies'); contrast ex:FinancialForecast, which is a predictive description of income/cash flows and does not denote a credit-score requirement." ;
                                       rdfs:label "Credit Score Requirement Specification" ;
                                       skos:definition "A Directive Information Content Entity that prescribes the minimum credit scores an applicant must meet for credit to be extended." .


###  http://example.org/apqc#CreditScoringHistory
ex:CreditScoringHistory rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "Credit Scoring History" ;
                        skos:definition "A Descriptive Information Content Entity that describes the past credit scores and payment behavior of a customer or applicant." .


###  http://example.org/apqc#CriticalActivityDetermination
ex:CriticalActivityDetermination rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Minted: no shared-vocab class registers the essential/non-cuttable activities. Descriptive register of a determination." ;
                                 rdfs:label "Critical-Activity Determination" ;
                                 skos:definition "A Descriptive Information Content Entity that records which finance activities are indispensable and where costs cannot be reduced." ;
                                 skos:example "A register marking payroll and statutory reporting as indispensable." .


###  http://example.org/apqc#CriticalToQualityCharacteristicSpecification
ex:CriticalToQualityCharacteristicSpecification rdf:type owl:Class ;
                                                rdfs:subClassOf cco:ont00000965 ;
                                                rdfs:label "Critical-to-Quality Characteristic Specification" ;
                                                skos:definition "A Directive Information Content Entity that prescribes the key measurable performance characteristics that products and processes must satisfy to meet customer needs." .


###  http://example.org/apqc#CrossFunctionalProcessRegister
ex:CrossFunctionalProcessRegister rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Descriptive: represents which processes are cross-functional. Minted because no shared-vocab ICE covers this register (output of ex:P16386)." ;
                                  rdfs:label "Cross-Functional Process Register" ;
                                  skos:definition "A Descriptive Information Content Entity that describes the business processes spanning two or more functional areas of an organization." ;
                                  skos:example "A list of order-to-cash processes flagged as cross-functional." .


###  http://example.org/apqc#CultivateAnalystRelations
ex:CultivateAnalystRelations rdf:type owl:Class ;
                             rdfs:subClassOf ex:ActOfRelationshipManagement ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000057 ;
                                               owl:someValuesFrom ex:FinancialAnalyst
                                             ] ;
                             ex:requiresRole ex:FinancialAnalystRole ;
                             rdfs:comment "Supporting bounded act (no pcfID) minted for 12.1.2: the discrete episodes (analyst meetings, briefings) in which ex:AnalystRelationsManagementCapability is realized (obo:BFO_0000054). The FinancialAnalyst is a definitional participant of these episode acts (not of a capability), per the Gate-F fix." ;
                             rdfs:label "Cultivate Analyst Relations" ;
                             skos:definition "An Act of Relationship Management that cultivates and sustains an organization's relationship with one or more financial analysts during a bounded engagement episode in order to elicit market intelligence, and has a financial analyst as participant." ;
                             skos:example "An investor-relations officer's briefing with a sell-side analyst ahead of an earnings release." .


###  http://example.org/apqc#CultivateLenderRelations
ex:CultivateLenderRelations rdf:type owl:Class ;
                            rdfs:subClassOf ex:ActOfRelationshipManagement ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty obo:BFO_0000057 ;
                                              owl:someValuesFrom ex:Lender
                                            ] ;
                            ex:requiresRole ex:LenderRole ;
                            rdfs:comment "Supporting bounded act (no pcfID) minted for 12.1.1: the discrete episodes (a cultivation act, a banking meeting, a communication) in which ex:LenderRelationsManagementCapability is realized (obo:BFO_0000054). The Lender is a definitional participant; typical relationship/contact data I/O is non-definitional (Phase-3) and omitted." ;
                            rdfs:label "Cultivate Lender Relations" ;
                            skos:definition "An Act of Relationship Management that cultivates and sustains an organization's relationship with one or more lenders during a bounded engagement episode, fostering a receptive environment for favorable lending terms, and has a lender as participant." ;
                            skos:example "A treasury team's quarterly banker briefing to secure a low-rate credit line." .


###  http://example.org/apqc#CulturalContextAssessment
ex:CulturalContextAssessment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:label "Cultural Context Assessment" ;
                             skos:definition "A Descriptive Information Content Entity that describes an Organization's culture and the aspirations for it along multiple dimensions." .


###  http://example.org/apqc#CurrencyConversionRecord
ex:CurrencyConversionRecord rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Minted for group 9.11. Output of 9.11.4. Descriptive record of a performed conversion." ;
                            rdfs:label "Currency Conversion Record" ;
                            skos:definition "A Descriptive Information Content Entity that describes the conversion of a monetary amount from one currency to another at an identified exchange rate." ;
                            skos:example "A record converting 100,000 yen to US dollars at the day's spot rate." .


###  http://example.org/apqc#CurrentBusinessAnalysis
ex:CurrentBusinessAnalysis rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Minted (Gate-F) for P10044 'Define current business'. Descriptive (it represents an understanding of the status quo), so it agrees with the ex:ActOfAnalysis genus; ex:BusinessConcept (Directive) is reserved for the formulation acts P10045/P17040." ;
                           rdfs:label "Current Business Analysis" ;
                           skos:definition "A Descriptive Information Content Entity that describes the de-facto core of what a business does and the capacities that underpin it, as understood at the present time." .


###  http://example.org/apqc#CurrentStateAssessment
ex:CurrentStateAssessment rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Current State Assessment" ;
                          skos:definition "A Descriptive Information Content Entity that describes the existing processes, structures, and culture of an Organization prior to a change." .


###  http://example.org/apqc#Customer
ex:Customer rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00001017 ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty obo:BFO_0000196 ;
                              owl:someValuesFrom ex:CustomerRole
                            ] ;
            rdfs:comment "Anchored at cco:Agent because a customer may be an individual person; an organizational customer is also an Agent via the role. Bears CustomerRole." ,
                         "Minted because CCO 2.0 has no Customer class. Genus cco:ont00001017 (Agent) so individuals and organizations alike may be customers; the customer-specific aspect is carried by ex:CustomerRole on an independent continuant (D4)." ,
                         "Modeled as Agent so it covers both individual persons and organizational buyers; use ex:CustomerRole on an Organization for B2B customers." ,
                         "Modeled as cco:Agent to cover both individual consumers and customer organizations participating in tests/interviews (2.3.2.2)." ,
                         "Shared section-5.0 participant. Modeled as cco:Agent (not Organization) so that both individual and organizational customers are admitted; group agents may narrow to cco:ont00001180 where the customer is specifically an organization." ;
            rdfs:label "Customer" ;
            skos:definition "An Agent that bears a customer role in relation to a focal Organization." ,
                            "An Agent that bears a customer role in relation to a focal organization's products or services." ,
                            "An Agent that bears a customer role in relation to an organization delivering a service." ,
                            "An Agent that bears a customer role in relation to an organization from which it has obtained or seeks goods or services." ,
                            "An Agent that bears a customer role in relation to an organization, being a recipient of its products or services." ,
                            "An Agent that bears a customer role with respect to an organization's offerings." ,
                            "An Agent that bears a customer role." .


###  http://example.org/apqc#CustomerBehaviorModel
ex:CustomerBehaviorModel rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cco:ont00001808 ;
                                           owl:someValuesFrom ex:Customer
                                         ] ;
                         rdfs:comment "Output of 3.1.1.1.1 and 3.1.1.1.2. Descriptive model; is about the Customer. (A purely forward-looking purchasing prediction is a Predictive ICE; see ex:PurchasingForecast.)" ;
                         rdfs:label "Customer Behavior Model" ;
                         skos:definition "A Descriptive Information Content Entity that describes patterns in customer purchasing behavior, including a forecast of future purchasing." .


###  http://example.org/apqc#CustomerBusinessObjectives
ex:CustomerBusinessObjectives rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:comment "Shared section-5.0 input (5.3.1.4). Directive: objectives prescribe an intended end-state. Distinct from ex:ServiceDeliveryGoal (the provider's own goals)." ;
                              rdfs:label "Customer Business Objectives" ;
                              skos:definition "A Directive Information Content Entity that prescribes the business goals a customer intends a delivered service to advance." .


###  http://example.org/apqc#CustomerCompensationOffer
ex:CustomerCompensationOffer rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Minted (D5) as the conveyed deliverable of Perform salvage activities [10366], whose Element Description is about presenting customer incentives, not physical reconditioning. Directive because an offer proposes terms/action to the customer. Distinct from ex:DispositionDecision (reverse-logistics disposition of a returned artifact)." ;
                             rdfs:label "Customer Compensation Offer" ;
                             skos:definition "A Directive Information Content Entity that proposes additional incentives or compensation to a customer in the event of a defective delivery or specification discrepancy, in order to retain the order and avoid a permanent return." ;
                             skos:example "A retention offer of a partial refund and free reshipment made to keep a customer from returning a discrepant order." .


###  http://example.org/apqc#CustomerComplaint
ex:CustomerComplaint rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Input to 6.2.3 (Manage customer complaints)." ;
                     rdfs:label "Customer Complaint" ;
                     skos:definition "A Descriptive Information Content Entity in which a customer expresses an objection, grievance, or criticism regarding an organization's products or services." .


###  http://example.org/apqc#CustomerComplaintManagementCapability
ex:CustomerComplaintManagementCapability rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000568 ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P10397
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P10398
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P10399
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P10400
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P19072
                                                         ] ;
                                         ex:enablesProcess ex:P10397 ,
                                                           ex:P10398 ,
                                                           ex:P10399 ,
                                                           ex:P10400 ,
                                                           ex:P19072 ;
                                         rdfs:comment "R5/R6: models APQC 6.2.3 'Manage customer complaints' (PCF 10389), a standing 'Manage X' function, as a capability realized in its five bounded child acts rather than as a process." ;
                                         rdfs:label "Customer Complaint Management Capability" ;
                                         skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to receive, route, resolve, respond to, and analyze customer complaints." .


###  http://example.org/apqc#CustomerData
ex:CustomerData rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Minted because section 3.0 repeatedly consumes customer descriptions as input (3.1, 3.3, 3.5). Descriptive: it represents customers rather than prescribing action." ;
                rdfs:label "Customer Data" ;
                skos:definition "A Descriptive Information Content Entity that describes customers, their attributes, needs, and behavior." ,
                                "A Descriptive Information Content Entity that describes customers, their characteristics, and their needs and wants." .


###  http://example.org/apqc#CustomerExperienceAssessment
ex:CustomerExperienceAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:label "Customer Experience Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes measured customer experience, satisfaction, and feedback across touchpoints." .


###  http://example.org/apqc#CustomerExperienceManagementCapability
ex:CustomerExperienceManagementCapability rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000568 ;
                                          ex:enablesProcess ex:P19959 ,
                                                            ex:P19960 ,
                                                            ex:P19964 ,
                                                            ex:P19971 ;
                                          rdfs:comment "Supports the standing-function reading of 1.2.8 'Develop customer experience strategy' and its design sub-nodes." ;
                                          rdfs:label "Customer Experience Management Capability" ;
                                          skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to register, design, and improve the experience of its customers through intentional acts of assessment and design." .


###  http://example.org/apqc#CustomerExperienceRoadmap
ex:CustomerExperienceRoadmap rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000974 ;
                             rdfs:comment "Output of 1.2.8.3/1.2.8.4 customer-experience support structure and roadmap." ;
                             rdfs:label "Customer Experience Roadmap" ;
                             skos:definition "A Plan that prescribes the intended capabilities, behaviors, and timeline for delivering a defined customer experience." .


###  http://example.org/apqc#CustomerFeedback
ex:CustomerFeedback rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:comment "Input to 3.2.1.3 (validation), 3.3.6 (respond to insight). Descriptive." ,
                                 "Input to the satisfaction-measurement processes of 6.5 and to 6.3.4.4 (Ensure quality of service)." ,
                                 "Shared section-5.0 input. Recurs across 5.1.1.4, 5.2.3.7, 5.3.3.6." ;
                    rdfs:label "Customer Feedback" ;
                    skos:definition "A Descriptive Information Content Entity that describes a customer's evaluation of services rendered, solicited to inform improvement of service delivery." ,
                                    "A Descriptive Information Content Entity that describes responses, opinions, and reactions expressed by customers about an organization's offerings." ,
                                    "A Descriptive Information Content Entity that describes responses, opinions, and satisfaction reported by customers about a product or service." ,
                                    "A Descriptive Information Content Entity that describes responses, reactions, sentiments, and insights expressed by customers about products, services, or experiences." ,
                                    "A Descriptive Information Content Entity that records a customer's review or evaluation of services delivered, products, advertisements, or service experience." .


###  http://example.org/apqc#CustomerInquiry
ex:CustomerInquiry rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "Covers the requests/inquiries/problems received in 6.2.2. Received over email, phone, online forms, social media, etc." ;
                   rdfs:label "Customer Inquiry" ;
                   skos:definition "A Descriptive Information Content Entity in which a customer requests information about, or assistance with, an organization's products or services." .


###  http://example.org/apqc#CustomerInquiryManagementCapability
ex:CustomerInquiryManagementCapability rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000568 ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10394
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10395
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10396
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P13482
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P16928
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P16937
                                                       ] ;
                                       ex:enablesProcess ex:P10394 ,
                                                         ex:P10395 ,
                                                         ex:P10396 ,
                                                         ex:P13482 ,
                                                         ex:P16928 ,
                                                         ex:P16937 ;
                                       rdfs:comment "R5/R6: models APQC 6.2.2 'Manage customer service problems, requests, and inquiries' (PCF 10388), a standing 'Manage X' function, as a capability realized in its six bounded child acts rather than as a process." ;
                                       rdfs:label "Customer Inquiry Management Capability" ;
                                       skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to receive, analyze, resolve, and respond to customer problems, requests, and inquiries and to surface sales opportunities arising from them." .


###  http://example.org/apqc#CustomerInsight
ex:CustomerInsight rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:Customer
                                   ] ;
                   rdfs:comment "Output of 3.3.6 (analyze and respond to customer insight), 3.3.6.1, and 3.5.3.6. Descriptive (Analysis); is about the Customer." ;
                   rdfs:label "Customer Insight" ;
                   skos:definition "A Descriptive Information Content Entity that describes understanding derived from customer feedback, social media, website activity, and the customer's field of operation and business needs." .


###  http://example.org/apqc#CustomerJourneyMap
ex:CustomerJourneyMap rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Customer Journey Map" ;
                      skos:definition "A Descriptive Information Content Entity that describes the sequence of a customer's interactions with an organization from initial contact through long-term relationship." .


###  http://example.org/apqc#CustomerLifetimeValue
ex:CustomerLifetimeValue rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000626 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cco:ont00001808 ;
                                           owl:someValuesFrom ex:Customer
                                         ] ;
                         rdfs:comment "Output of 3.3.5.1 (determine customer lifetime value). Predictive ICE (Forecasting genus): an estimate of uncertain future value. is about the Customer." ;
                         rdfs:label "Customer Lifetime Value Estimate" ;
                         skos:definition "A Predictive Information Content Entity that describes the estimated total future contribution of a customer over their relationship with the organization." .


###  http://example.org/apqc#CustomerLoyaltyProgram
ex:CustomerLoyaltyProgram rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Output of 3.2.6, 3.2.6.1 (define loyalty program). Directive (Formulation). The program's content is the ICE; its enrolled members are independent continuants modeled elsewhere." ;
                          rdfs:label "Customer Loyalty Program Specification" ;
                          skos:definition "A Directive Information Content Entity that prescribes the procedures, rewards, and mechanisms of a customer loyalty program." .


###  http://example.org/apqc#CustomerManagementMeasure
ex:CustomerManagementMeasure rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "Output of 3.4.5 (and revised in 3.3.5.5). Directive (Formulation): selecting a measure prescribes what to track." ;
                             rdfs:label "Customer Management Measure" ;
                             skos:definition "A Directive Information Content Entity that prescribes the measures used to track customer activity, satisfaction, and account management." .


###  http://example.org/apqc#CustomerMasterData
ex:CustomerMasterData rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001808 ;
                                        owl:someValuesFrom ex:Customer
                                      ] ;
                      rdfs:comment "Subject of 3.5.4.2 and 3.5.2.5 (manage/collect/de-duplicate customer data). Descriptive; is about the Customer." ;
                      rdfs:label "Customer Master Data" ;
                      skos:definition "A Descriptive Information Content Entity that describes the maintained corpus of account, contact, address, and communication data for an organization's customers." .


###  http://example.org/apqc#CustomerMasterFile
ex:CustomerMasterFile rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Customer Master File" ;
                      skos:definition "A Descriptive Information Content Entity that records the identifying details and purchase history of an Organization's customers." .


###  http://example.org/apqc#CustomerMetricAnalysis
ex:CustomerMetricAnalysis rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cco:ont00001808 ;
                                            owl:someValuesFrom ex:Customer
                                          ] ;
                          rdfs:comment "Output of 3.3.5, 3.3.5.2, 3.3.5.3, 3.3.5.4, 3.3.6.2. Descriptive (Analysis); is about the Customer." ;
                          rdfs:label "Customer Metric Analysis" ;
                          skos:definition "A Descriptive Information Content Entity that describes analyzed measures of customer value, revenue, attrition, retention, and behavior." .


###  http://example.org/apqc#CustomerNeedsAnalysis
ex:CustomerNeedsAnalysis rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Minted locally: APQC 5.3.2.1 output and input to 5.3.2.2; no shared-vocab ICE supplied." ;
                         rdfs:label "Customer Needs Analysis" ;
                         skos:definition "A Descriptive Information Content Entity that describes an understanding of a customer's environment and service needs within the organization's scope." ;
                         skos:example "A discovery report summarizing a client's pain points and the in-scope needs to address." .


###  http://example.org/apqc#CustomerNeedsAssessment
ex:CustomerNeedsAssessment rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:label "Customer Needs Assessment" ;
                           skos:definition "A Descriptive Information Content Entity that describes the products and services that are needed or wanted by customers in a relevant market." .


###  http://example.org/apqc#CustomerProfile
ex:CustomerProfile rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:someValuesFrom ex:Customer
                                   ] ;
                   rdfs:comment "Covers APQC customer profiles, personas, and the 'single view of the customer'." ,
                                "Output of 6.3.4.1.2 (Create customer profile); about a Customer." ;
                   rdfs:label "Customer Profile" ;
                   skos:definition "A Descriptive Information Content Entity that describes a group of customers with respect to their characteristics, needs, and behavioral patterns." ,
                                   "A Descriptive Information Content Entity that describes an individual customer's service requirements and personal information." .


###  http://example.org/apqc#CustomerRequirements
ex:CustomerRequirements rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Shared section-5.0 input. Recurs across 5.1.1.1, 5.1.2.3, 5.2.1.3, 5.3.1.2, 5.3.2.1. Descriptive: it states needs rather than prescribing a course of action." ;
                        rdfs:label "Customer Requirements" ;
                        skos:definition "A Descriptive Information Content Entity that describes the needs, expectations, and constraints a customer places on a service to be delivered." .


###  http://example.org/apqc#CustomerResearchFindings
ex:CustomerResearchFindings rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cco:ont00001808 ;
                                              owl:someValuesFrom ex:Customer
                                            ] ;
                            rdfs:comment "Output of 3.1.1.1. Descriptive; is about the Customer studied." ;
                            rdfs:label "Customer Research Findings" ;
                            skos:definition "A Descriptive Information Content Entity that describes the behavior, characteristics, drives, and desires of prospective and current customers as discovered through research." .


###  http://example.org/apqc#CustomerRole
ex:CustomerRole rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:comment "Borne by an independent continuant (the purchasing Agent/Organization)." ,
                             "Borne by the (organizational or individual) customer; recurs in customer-test and market-review processes (2.1.2.5, 2.3.2.2)." ,
                             "Minted because CCO 2.0 has no Customer class/role. Borne by an independent continuant (the buying Agent/Organization), never by the customer-profile ICE that is about it." ;
                rdfs:label "Customer Role" ;
                skos:definition "A Role that is borne by an Agent or Organization in virtue of acquiring, consuming, contracting for, or being a target acquirer of the goods or services of a focal organization." .


###  http://example.org/apqc#CustomerSatisfactionAssessment
ex:CustomerSatisfactionAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Output of the measurement processes of 6.5 (6.5, 6.5.1, 6.5.2, 6.5.3, 6.5.4.1) -> producing act is an Act of Appraisal." ;
                                  rdfs:label "Customer Satisfaction Assessment" ;
                                  skos:definition "A Descriptive Information Content Entity that describes measured levels of customer satisfaction with a customer service process, product, or warranty." .


###  http://example.org/apqc#CustomerServiceCapability
ex:CustomerServiceCapability rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00001379 ;
                             ex:enablesProcess ex:P10394 ,
                                               ex:P10395 ,
                                               ex:P10396 ,
                                               ex:P10397 ,
                                               ex:P10398 ,
                                               ex:P10399 ,
                                               ex:P10400 ,
                                               ex:P13482 ,
                                               ex:P16928 ,
                                               ex:P19072 ;
                             rdfs:comment "Borne by ex:CustomerServiceRepresentative. Use ex:CustomerServiceManagementCapability (Organization Capability) for the org-level standing function." ;
                             rdfs:label "Customer Service Capability" ;
                             skos:definition "An Agent Capability that is realized in acts of handling customer problems, requests, inquiries, and complaints." .


###  http://example.org/apqc#CustomerServiceChannelStrategy
ex:CustomerServiceChannelStrategy rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000965 ;
                                  rdfs:comment "Output of 6.1.3 (Define and manage customer service channel strategy)." ;
                                  rdfs:label "Customer Service Channel Strategy" ;
                                  skos:definition "A Directive Information Content Entity that prescribes the procedures and channels for customer service and technical support." .


###  http://example.org/apqc#CustomerServiceExperienceSpecification
ex:CustomerServiceExperienceSpecification rdf:type owl:Class ;
                                          rdfs:subClassOf cco:ont00000965 ;
                                          rdfs:comment "Output of 6.1.2 (Define customer service experience)." ;
                                          rdfs:label "Customer Service Experience Specification" ;
                                          skos:definition "A Directive Information Content Entity that prescribes what is expected of customer service resources when engaging the customer." .


###  http://example.org/apqc#CustomerServiceManagementCapability
ex:CustomerServiceManagementCapability rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000568 ;
                                       ex:enablesProcess ex:P20595 ;
                                       rdfs:comment "Target for any R5 'Manage ...' node (e.g. the standing function 'Plan and manage customer service work force') that resolves to a capability rather than a process." ;
                                       rdfs:label "Customer Service Management Capability" ;
                                       skos:definition "An Organization Capability that is realized in the acts by which an organization plans, delivers, and evaluates customer service." .


###  http://example.org/apqc#CustomerServicePolicy
ex:CustomerServicePolicy rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Output of 6.1.4 (Define customer service policies and procedures)." ;
                         rdfs:label "Customer Service Policy" ;
                         skos:definition "A Directive Information Content Entity that prescribes the rules, regulations, and methods that guide an organization's customer service strategy." .


###  http://example.org/apqc#CustomerServiceRepresentative
ex:CustomerServiceRepresentative rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00001017 ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty obo:BFO_0000196 ;
                                                   owl:someValuesFrom ex:CustomerServiceRepresentativeRole
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cco:ont00001954 ;
                                                   owl:someValuesFrom ex:CustomerServiceCapability
                                                 ] ;
                                 rdfs:comment "Minted (no CCO equivalent). The participant named across 6.2.1.4 and the receive/route/resolve/respond activities of 6.2." ;
                                 rdfs:label "Customer Service Representative" ;
                                 skos:definition "An Agent that bears a customer-service-representative role and has a customer-service capability, by which it handles customer problems, requests, inquiries, and complaints on behalf of an organization." .


###  http://example.org/apqc#CustomerServiceRepresentativeRole
ex:CustomerServiceRepresentativeRole rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000984 ;
                                     rdfs:label "Customer Service Representative Role" ;
                                     skos:definition "A Role that is borne by an Agent in virtue of being tasked with handling customer problems, requests, inquiries, and complaints on behalf of an organization." .


###  http://example.org/apqc#CustomerServiceRequirementSpecification
ex:CustomerServiceRequirementSpecification rdf:type owl:Class ;
                                           rdfs:subClassOf cco:ont00000965 ;
                                           rdfs:comment "Output of 6.1.1 (Define customer service requirements across the enterprise). Enterprise-wide scope. Per Gate-F it is NO LONGER the output of the individual-customer act 6.3.4.1 (which now produces the individual-scope ex:IndividualServiceRequirement); it is retained as a constraining Directive input to 6.3.4.1 and 6.3.4.1.3." ;
                                           rdfs:label "Customer Service Requirement Specification" ;
                                           skos:definition "A Directive Information Content Entity that prescribes the behaviors, skills, and policies required to provide customer service across an enterprise." .


###  http://example.org/apqc#CustomerServiceStrategy
ex:CustomerServiceStrategy rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Output of 6.1 (Develop customer service strategy). Directive -> producing act is a Formulation (inlined)." ;
                           rdfs:label "Customer Service Strategy" ;
                           skos:definition "A Directive Information Content Entity that prescribes an organization's plan for removing customer obstacles and delivering customer service." .


###  http://example.org/apqc#CustomerServiceWorkforceManagementCapability
ex:CustomerServiceWorkforceManagementCapability rdf:type owl:Class ;
                                                rdfs:subClassOf cco:ont00000568 ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty obo:BFO_0000054 ;
                                                                  owl:someValuesFrom ex:P10390
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty obo:BFO_0000054 ;
                                                                  owl:someValuesFrom ex:P10391
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty obo:BFO_0000054 ;
                                                                  owl:someValuesFrom ex:P10392
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty obo:BFO_0000054 ;
                                                                  owl:someValuesFrom ex:P10393
                                                                ] ;
                                                ex:enablesProcess ex:P10390 ,
                                                                  ex:P10391 ,
                                                                  ex:P10392 ,
                                                                  ex:P10393 ;
                                                rdfs:comment "R5/R6: models APQC 6.2.1 'Plan and manage customer service work force' (PCF 10387), a standing function with no natural end, as a capability realized in its four bounded child acts (forecast, schedule, track utilization, monitor interaction quality) rather than as a process." ;
                                                rdfs:label "Customer Service Workforce Management Capability" ;
                                                skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to plan, schedule, track, and assure the quality of the workforce deployed for customer service provision." .


###  http://example.org/apqc#CustomerTestReport
ex:CustomerTestReport rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cco:ont00001808 ;
                                        owl:someValuesFrom ex:ProductServiceOffering
                                      ] ;
                      rdfs:comment "Minted: output of 2.3.2.2; not in shared list. Descriptive, is about the offering." ;
                      rdfs:label "Customer Test Report" ;
                      skos:definition "A Descriptive Information Content Entity that records qualitative and quantitative findings from customer tests and interviews of a new product or service." .


###  http://example.org/apqc#CustomerTouchpointInventory
ex:CustomerTouchpointInventory rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Minted (Gate-F) for P19961 'Identify and review customer touchpoints'. A register of discerned touchpoints, agreeing with the ex:ActOfIdentification genus; replaces the mis-typed ex:CustomerExperienceAssessment output." ;
                               rdfs:label "Customer Touchpoint Inventory" ;
                               skos:definition "A Descriptive Information Content Entity that registers the touchpoints through which customers interact with an organization, such as billboards, web sites, direct mail, and service calls." .


###  http://example.org/apqc#CustomerTradeStrategy
ex:CustomerTradeStrategy rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:comment "Output of 3.4.2.4 (11465). Directive (Formulation). Distinct from ex:AllianceStrategy (partners) and ex:SalesPlan (single account). PROPOSE-VOCAB candidate." ;
                         rdfs:label "Customer Trade Strategy" ;
                         skos:definition "A Directive Information Content Entity that prescribes an organization's category-management and trade strategy, objectives, and long-term targets for its customers." .


###  http://example.org/apqc#CustomerValueAssessment
ex:CustomerValueAssessment rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:comment "Minted (Gate-F) for P19979 'Determine the customer value'. Descriptive judgement of value, parallel to ex:BusinessValueAssessment (the sibling P19978 output)." ;
                           rdfs:label "Customer Value Assessment" ;
                           skos:definition "A Descriptive Information Content Entity that describes the assessed value a customer derives from a product or service relative to what the customer gives up to obtain it." .


###  http://example.org/apqc#CustomsInformation
ex:CustomsInformation rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:comment "Minted for group 9.11. The ICE transferred to customs in 9.11.6 (an Act of Communication)." ;
                      rdfs:label "Customs Information" ;
                      skos:definition "A Descriptive Information Content Entity that describes the trade particulars mandated by law to be disclosed to the customs authority that controls and collects duties on the international exchange of products and services." ;
                      skos:example "An electronic customs declaration submitted with a shipment." .


###  http://example.org/apqc#DamageCauseAnalysis
ex:DamageCauseAnalysis rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:DamagedMaterialEntity
                                       ] ;
                       rdfs:comment "Output of 11.3.5 (investigate damage cause), produced by ex:ActOfInvestigation (inlined above)." ;
                       rdfs:label "Damage Cause Analysis" ;
                       skos:definition "A Descriptive Information Content Entity, about an instance of damage, that describes a study of the environmental, physical, or social causes of that damage in order to inform better policies and regulations." .


###  http://example.org/apqc#DamagedMaterialEntity
ex:DamagedMaterialEntity rdf:type owl:Class ;
                         rdfs:subClassOf obo:BFO_0000040 ;
                         rdfs:comment "The damaged site or system that is the subject of ex:DamageCauseAnalysis (cco:ont00001808 'is about'). Renamed from ex:Damage so the label matches its BFO category: it is a Material Entity (obo:BFO_0000040) that has undergone harm -- the damaged thing, not the damage condition itself. (If a contributor needs the harm qua condition, model it separately as a BFO Quality borne by this entity.)" ;
                         rdfs:label "Damaged Material Entity" ;
                         skos:definition "A Material Entity that has undergone harmful physical, environmental, or social alteration whose causes are studied in order to inform better policies and regulations." .


###  http://example.org/apqc#DataAccessDecision
ex:DataAccessDecision rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Minted: authorization decision not in shared list. Directive (a prescriptive authorization) per the GOLDEN PRINCIPLE." ;
                      rdfs:label "Data Access Decision" ;
                      skos:definition "A Directive Information Content Entity that prescribes whether to permit or deny a data access request according to internal data-security policy." .


###  http://example.org/apqc#DataAccessRequest
ex:DataAccessRequest rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Minted: input request record not in shared list. Descriptive (it describes a request, not yet a decision)." ;
                     rdfs:label "Data Access Request" ;
                     skos:definition "A Descriptive Information Content Entity that describes a requester and the data accessibility being requested." .


###  http://example.org/apqc#DataAnalysisResult
ex:DataAnalysisResult rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Data Analysis Result" ;
                      skos:definition "A Descriptive Information Content Entity that describes the patterns, trends, error rates, and outliers revealed by statistical analysis of data." .


###  http://example.org/apqc#DataAnalyst
ex:DataAnalyst rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00001017 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000196 ;
                                 owl:someValuesFrom ex:DataAnalystRole
                               ] ;
               rdfs:label "Data Analyst" ;
               skos:definition "An Agent that bears a data-analyst role." .


###  http://example.org/apqc#DataAnalystRole
ex:DataAnalystRole rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000984 ;
                   rdfs:comment "Minted for recurring APQC 13.7 participant ('knowledge engineers, data scientists, and other relevant personnel')." ;
                   rdfs:label "Data Analyst Role" ;
                   skos:definition "A Role that is borne by an Agent in virtue of being tasked with collecting, preparing, analyzing, and modeling data to produce analytical findings for an Organization." .


###  http://example.org/apqc#DataInformationAnalyticObjectives
ex:DataInformationAnalyticObjectives rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "8.4.1.1 output. Directive per the GOLDEN PRINCIPLE (output of a formulation act)." ;
                                     rdfs:label "Data, Information, and Analytic Objectives" ;
                                     skos:definition "A Directive Information Content Entity that prescribes the organization's intended objectives for the security, privacy, and proper use of its data, information, and analytic capabilities." ;
                                     skos:example "A signed-off statement of data-privacy and analytics-use objectives for the coming fiscal year." .


###  http://example.org/apqc#DataModel
ex:DataModel rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000965 ;
             rdfs:comment "Directive: a data model prescribes how data is to be structured and stored (a model/blueprint), per CCO's notion of prescription for Continuants. CAUTION (false friend): this is the Directive (965) design/specification sense of 'model' (a blueprint for structuring data); a statistical, learned, or predictive 'model' that DESCRIBES patterns in data is a separate Descriptive (853) or Predictive (626) ICE, not this class." ;
             rdfs:label "Data Model" ;
             skos:definition "A Directive Information Content Entity that prescribes the conceptual and physical structure and storage of data." .


###  http://example.org/apqc#DataModelReviewRecord
ex:DataModelReviewRecord rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:label "Data Model Review Record" ;
                         skos:definition "A Descriptive Information Content Entity that describes the outcome of reviewing data models with stakeholders against the original research question and hypothesis." .


###  http://example.org/apqc#DataStewardshipAssignment
ex:DataStewardshipAssignment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:comment "8.4.2.4 output. Assigning ownership/stewardship responsibilities is prescriptive, hence Directive, agreeing with its formulation-act genus (GOLDEN PRINCIPLE)." ;
                             rdfs:label "Data Stewardship Assignment" ;
                             skos:definition "A Directive Information Content Entity that prescribes which entities are responsible for the accuracy, integrity, and timeliness of given data and who may authorize or deny access to it." ;
                             skos:example "A RACI matrix naming the data owner and stewards for each master-data domain." .


###  http://example.org/apqc#DealOptionAnalysis
ex:DealOptionAnalysis rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Deal Option Analysis" ;
                      skos:definition "A Descriptive Information Content Entity that describes an appraisal of acquisition, merger, de-merger, or divestment options for an organization." .


###  http://example.org/apqc#DebtorRole
ex:DebtorRole rdf:type owl:Class ;
              rdfs:subClassOf obo:BFO_0000023 ;
              rdfs:comment "Used for delinquent/default account holders in 9.2." ;
              rdfs:label "Debtor Role" ;
              skos:definition "A Role that is borne by an Agent in virtue of owing an outstanding amount to an Organization under a credit or payment obligation." .


###  http://example.org/apqc#DefaultAccountManagementCapability
ex:DefaultAccountManagementCapability rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000568 ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:BFO_0000054 ;
                                                        owl:someValuesFrom ex:P14007
                                                      ] ;
                                      ex:enablesProcess ex:P14007 ;
                                      rdfs:comment "Models APQC 9.2.4.7 'Manage default accounts' (PCF 14008). R5: a standing function with no natural end, so modeled as an Organization Capability (cco:ont00000568) per R6 rather than a process. Bears no ex:pcfID (supporting class); realized in ex:P14007 (Perform recovery workout) as a bounded act of that management." ;
                                      rdfs:label "Default Account Management Capability" ;
                                      skos:definition "An Organization Capability that is realized in the recovery and collection acts by which an organization handles customer accounts that have not met their agreed repayment obligations." .


###  http://example.org/apqc#DefectivePart
ex:DefectivePart rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000995 ;
                 rdfs:comment "Material input to 6.3.2.3.3 (Request and receive defective part)." ;
                 rdfs:label "Defective Part" ;
                 skos:definition "A Material Artifact component that has failed and is requested and received for investigation or root-cause analysis of a warranty claim." .


###  http://example.org/apqc#DefectiveProduct
ex:DefectiveProduct rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000995 ;
                    rdfs:comment "Material (not informational) entity. Subject of recalls (6.4) and returns (6.2.4)." ;
                    rdfs:label "Defective Product" ;
                    skos:definition "A Material Artifact that fails to realize one or more of its designed functions or qualities and is therefore subject to repair, return, or recall." .


###  http://example.org/apqc#DeliveryPartner
ex:DeliveryPartner rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00001017 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000196 ;
                                     owl:someValuesFrom ex:DeliveryPartnerRole
                                   ] ;
                   rdfs:comment "Shared section-5.0 participant (5.2.2.4, 5.3.1.1). Distinguished from ex:Supplier: a partner collaborates on delivery rather than merely supplying resources." ;
                   rdfs:label "Delivery Partner" ;
                   skos:definition "An Agent that bears a delivery-partner role in virtue of collaborating with an organization to supplement its service-delivery skills and capabilities." .


###  http://example.org/apqc#DeliveryPartnerRole
ex:DeliveryPartnerRole rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000023 ;
                       rdfs:label "Delivery Partner Role" ;
                       skos:definition "A Role that is borne by an Agent in virtue of collaborating with an organization to supplement its service-delivery skills and capabilities." .


###  http://example.org/apqc#DeliveryPerformanceReport
ex:DeliveryPerformanceReport rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:label "Delivery Performance Report" ;
                             skos:definition "A Descriptive Information Content Entity that describes the efficiency, cost-effectiveness, and schedule adherence of an inbound or outbound delivery system." .


###  http://example.org/apqc#DeliveryServicePolicy
ex:DeliveryServicePolicy rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000965 ;
                         rdfs:label "Delivery Service Policy" ;
                         skos:definition "A Directive Information Content Entity that prescribes the rules, terms, and conditions governing how, when, and in what way services are delivered to customers." .


###  http://example.org/apqc#DemandForecast
ex:DemandForecast rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000626 ;
                  rdfs:comment "Predictive (cco:ont00000626, a specialization of Descriptive cco:ont00000853): a forecast estimates an uncertain future demand state rather than prescribing action. Re-anchored from plain cco:ont00000853 to match the corpus forecast pattern (slice 5's identical ex:DemandForecast is 626+853); cco:ont00000853 co-asserted because 626 is outside the S3/S4 ICE allowlist. Genus for baseline and consensus forecasts." ,
                               "Shared section-5.0 output. Baseline (5.2.1.2) and consensus (5.2.1.4) forecasts are both Demand Forecasts; ex:ConsensusDemandForecast specialises this. PREDICTIVE (cco:ont00000626, a Descriptive ICE about an uncertain future), matching the Slice-3 forecast pattern -- produced by ex:ActOfForecasting." ;
                  rdfs:label "Demand Forecast" ;
                  skos:definition "A Predictive Information Content Entity that describes the anticipated (uncertain, future) level of customer demand for an organization's services." ,
                                  "A Predictive Information Content Entity that estimates the anticipated future demand for an organization's products or services." .


###  http://example.org/apqc#DemandForecastAccuracyReport
ex:DemandForecastAccuracyReport rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cco:ont00001808 ;
                                                  owl:someValuesFrom ex:DemandForecast
                                                ] ;
                                rdfs:label "Demand Forecast Accuracy Report" ;
                                skos:definition "A Descriptive Information Content Entity that describes the measured accuracy and reliability of an organization's demand forecasts." .


###  http://example.org/apqc#DemandForecastingCapability
ex:DemandForecastingCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ;
                               ex:enablesProcess ex:P20041 ,
                                                 ex:P20043 ,
                                                 ex:P20045 ;
                               rdfs:comment "Shared section-5.0 capability underlying the forecasting acts in 5.2.1." ;
                               rdfs:label "Demand Forecasting Capability" ;
                               skos:definition "An Organization Capability that is realized in the acts by which an organization forecasts and revises demand for its services." .


###  http://example.org/apqc#DemographicAnalysis
ex:DemographicAnalysis rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:label "Demographic Analysis" ;
                       skos:definition "A Descriptive Information Content Entity that describes the size, distribution, and composition of relevant populations." .


###  http://example.org/apqc#DemographicData
ex:DemographicData rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:label "Demographic Data" ;
                   skos:definition "A Descriptive Information Content Entity that describes the size, distribution, and composition of populations." .


###  http://example.org/apqc#DeploymentApprovalAssignment
ex:DeploymentApprovalAssignment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:comment "8.6.1.5 output. Directive (not Descriptive) because it prescribes responsibility allocation rather than describing reality." ;
                                rdfs:label "Deployment Approval Assignment" ;
                                skos:definition "A Directive Information Content Entity that prescribes which agents or roles hold deployment-approval responsibility for IT changes and releases." .


###  http://example.org/apqc#DeploymentPlan
ex:DeploymentPlan rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ;
                  rdfs:comment "Section-8.0 shared output. APQC 8.6.1 deployment strategy, 8.6.2 plan implementation, 8.6.2.2 schedule/roll-out sequence, 8.6.4.7 / 8.6.4.9 roll-back plan. Directive." ;
                  rdfs:label "Deployment Plan" ;
                  skos:definition "A Directive Information Content Entity that prescribes the schedule, sequence, procedures, and roll-back arrangements for deploying a change to IT services or solutions." .


###  http://example.org/apqc#DesignCapability
ex:DesignCapability rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00001379 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty obo:BFO_0000054 ;
                                      owl:someValuesFrom ex:P19995
                                    ] ;
                    ex:enablesProcess ex:P19995 ;
                    rdfs:comment "Borne by design staff Agents; bearer-agnostic between individual and organization, hence Agent Capability. Realized in the design acts of group 2.3 (e.g. ex:P19995)." ;
                    rdfs:label "Design Capability" ;
                    skos:definition "An Agent Capability that is realized in Acts of Design of products, services, and processes." .


###  http://example.org/apqc#DesignSpecification
ex:DesignSpecification rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:ProductServiceOffering
                                       ] ;
                       rdfs:comment "Output of 2.3.1.3, 2.3.1.4 (UX), documented at 2.3.1.6, designed against at 2.3.1.8, and managed at 2.1.4.5. Directive: a specification prescribes." ;
                       rdfs:label "Design Specification" ;
                       skos:definition "A Directive Information Content Entity that prescribes the technical, quality, ergonomic, safety, and servicing requirements to be met in the design of a product or service." .


###  http://example.org/apqc#DesignStaff
ex:DesignStaff rdf:type owl:Class ;
               rdfs:subClassOf cco:ont00001017 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000196 ;
                                 owl:someValuesFrom ex:DesignStaffRole
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cco:ont00001954 ;
                                 owl:someValuesFrom ex:DesignCapability
                               ] ;
               rdfs:comment "APQC 'solutioning and/or design staff' (group 2.3)." ;
               rdfs:label "Design Staff" ;
               skos:definition "An Agent that has a design capability and bears a design staff role." .


###  http://example.org/apqc#DesignStaffRole
ex:DesignStaffRole rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000984 ;
                   rdfs:comment "Recurs across the design-and-prototype processes (group 2.3); APQC 'solutioning and/or design staff'." ;
                   rdfs:label "Design Staff Role" ;
                   skos:definition "A Role that is borne by an Agent in virtue of being tasked with creating product/service design specifications and prototypes within an Organization." .


###  http://example.org/apqc#DestinationRequirementQuantity
ex:DestinationRequirementQuantity rdf:type owl:Class ;
                                  rdfs:subClassOf cco:ont00000853 ;
                                  rdfs:comment "Minted (D5) as the descriptive figure output of Calculate requirements at destination [10254], mirroring ex:ConsolidationQuantity for the parallel sibling Calculate consolidation at source [10255]. Descriptive (states a computed figure), so its producing act is an Act of Analysis -- not a Directive requirements spec." ;
                                  rdfs:label "Destination Requirement Quantity" ;
                                  skos:definition "A Descriptive Information Content Entity that states the specific computed figure correctly representing the distribution requirements at a destination." .


###  http://example.org/apqc#DetermineLegalWorkRequirements
ex:DetermineLegalWorkRequirements rdf:type owl:Class ;
                                  rdfs:subClassOf ex:ActOfFormulation ;
                                  rdfs:comment "Supporting act (no pcfID, so it carries NO targeted has-output someValuesFrom restriction -- the IRI scheme reserves pcfIDs for catalog-backed process classes and the process shape requires a pcfID on any class bearing an I/O restriction). Minted to de-conflate the compound row 12.4.5.1 (Phase-1): producing a Directive WorkRequirementsSpecification is a planning/decision facet whose genus is ex:ActOfFormulation (Act of Planning), in agreement with its Directive output (GOLDEN PRINCIPLE). Its output ex:WorkRequirementsSpecification is recorded here and in the definition rather than as a restriction. It is a cco:has process part of the appraisal P11056, which keeps only its Descriptive output." ;
                                  rdfs:label "Determine legal work requirements" ;
                                  skos:definition "An Act of Formulation that determines and specifies the tasks and action requirements for engaging outside counsel on a legal problem and has as output a work requirements specification (ex:WorkRequirementsSpecification, a Directive ICE)." ;
                                  skos:example "In-house counsel breaks down a dispute into the tasks to hand to outside counsel and documents the action requirements." .


###  http://example.org/apqc#DevelopAndManageServicesSolutionsCapability
ex:DevelopAndManageServicesSolutionsCapability rdf:type owl:Class ;
                                               rdfs:subClassOf cco:ont00000568 ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                 owl:someValuesFrom ex:P20785
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                 owl:someValuesFrom ex:P20808
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                 owl:someValuesFrom ex:P20817
                                                               ] ;
                                               ex:apqcSourceText "Develop and manage services/solutions. Create a strategy, plan the lifecycle, develop the architecture, create and test, and maintain IT services and solutions." ;
                                               ex:enablesProcess ex:P20785 ,
                                                                 ex:P20808 ,
                                                                 ex:P20817 ;
                                               ex:hierarchyID "8.5" ;
                                               ex:pcfID "20784" ;
                                               rdfs:comment "APQC group 8.5 [PCF 20784] is a standing 'develop and manage' function with no natural end, so it is modeled as an Organization Capability (R5/R6) realized in its bounded child processes, not as a process with existential has-process-part (R3). The catalog node ex:PCF_20784 designates this capability." ;
                                               rdfs:label "Develop and Manage Services/Solutions Capability" ;
                                               skos:definition "An Organization Capability that inheres in an IT service provider in virtue of its capacity to develop, build, deploy, and maintain IT services and solutions." ;
                                               skos:example "An IT service provider's standing capability to design, build, release, and maintain its service catalogue." .


###  http://example.org/apqc#DeveloperRole
ex:DeveloperRole rdf:type owl:Class ;
                 rdfs:subClassOf ex:Role ,
                                 cco:ont00000984 ;
                 rdfs:label "Developer role" ;
                 skos:definition "The occupation role of an agent implementing planned modules as code change sets." .


###  http://example.org/apqc#DevelopmentGuideline
ex:DevelopmentGuideline rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:label "Employee Development Guideline" ;
                        skos:definition "A Directive Information Content Entity that prescribes policies and procedures for identifying and addressing employee growth areas." .


###  http://example.org/apqc#DevelopmentSchedule
ex:DevelopmentSchedule rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ;
                       rdfs:comment "Output of 2.1.1.5 (specify development timing targets)." ;
                       rdfs:label "Development Schedule" ;
                       skos:definition "A Directive Information Content Entity that prescribes timeframes and deadlines for developing or revising products and services." .


###  http://example.org/apqc#DigitalTransformationStrategy
ex:DigitalTransformationStrategy rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "8.2.1.3 output. Directive: prescribes the transformation course of action. (Distinct from the shared ex:ITTransformationPlan, which is the broader execution plan.)" ;
                                 rdfs:label "Digital Transformation Strategy" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the integration of digital technology into an organization's business operations and service delivery." .


###  http://example.org/apqc#DispatchPlan
ex:DispatchPlan rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:label "Dispatch Plan" ;
                skos:definition "A Directive Information Content Entity that prescribes the timing, duration, routes, and logistics of delivering inventory from a source to a destination." .


###  http://example.org/apqc#DispositionDecision
ex:DispositionDecision rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000965 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:ProductiveAsset
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:ont00001808 ;
                                         owl:someValuesFrom ex:ReturnedProduct
                                       ] ;
                       rdfs:comment "Directive because it authorizes a course of action on the returned product (Phase 3). Output of an Act of Selection over disposition options." ,
                                    "Directive: a decision that selects and authorizes a future disposition. Shared across 10.4 (take-back centers, dismantling, waste disposition)." ;
                       rdfs:label "Asset Disposition Decision" ,
                                  "Disposition Decision" ;
                       skos:definition "A Directive Information Content Entity that prescribes whether a returned product is to be salvaged, repaired, refurbished, or returned to inventory." ,
                                       "A Directive Information Content Entity, about an asset or part, that prescribes the disposition to be applied to it at end-of-life, such as retention, resale, reuse, recycling, or disposal." .


###  http://example.org/apqc#DispositionNeedRegister
ex:DispositionNeedRegister rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:label "Disposition Need Register" ;
                           skos:definition "A Descriptive Information Content Entity that records identified hazardous materials or waste recognized as requiring disposition, together with the rationale for that need." ;
                           skos:example "A flagged list of expired solvents and contaminated rags awaiting a disposal determination." .


###  http://example.org/apqc#DispositionRecord
ex:DispositionRecord rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:label "Disposition and Disposal Record" ;
                     skos:definition "A Descriptive Information Content Entity that records the disposition, disposal, and reprocessing activities performed on hazardous materials and waste." .


###  http://example.org/apqc#DisputeResolution
ex:DisputeResolution rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000965 ;
                     rdfs:comment "Output of 12.4.7 (Resolve disputes and litigations). Directive: a settlement that binds the parties." ;
                     rdfs:label "Dispute Resolution" ;
                     skos:definition "A Directive Information Content Entity that prescribes the agreed or adjudicated terms settling a dispute or civil lawsuit." .


###  http://example.org/apqc#DistributionCenter
ex:DistributionCenter rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000192 ;
                      rdfs:label "Distribution Center" ;
                      skos:definition "A Facility designed for receiving, storing, and dispatching products to downstream destinations in a distribution network." .


###  http://example.org/apqc#DistributionMasterData
ex:DistributionMasterData rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Distribution Master Data" ;
                          skos:definition "A Descriptive Information Content Entity that describes the systematic master data of finished products and inventory used for distribution planning." .


###  http://example.org/apqc#DistributionPlanningConstraintSpecification
ex:DistributionPlanningConstraintSpecification rdf:type owl:Class ;
                                               rdfs:subClassOf cco:ont00000965 ;
                                               rdfs:label "Distribution Planning Constraint Specification" ;
                                               skos:definition "A Directive Information Content Entity that prescribes the constraints governing distribution planning, covering distribution-center layout, inventory, transportation, and storage management." .


###  http://example.org/apqc#DistributionPolicy
ex:DistributionPolicy rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:label "Distribution Policy" ;
                      skos:definition "A Directive Information Content Entity that prescribes guidelines for the distribution network, sourcing relationships, and dynamic product deployment across distribution centers." .


###  http://example.org/apqc#DistributionRequirementsPlan
ex:DistributionRequirementsPlan rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:label "Distribution Requirements Plan" ;
                                skos:definition "A Directive Information Content Entity that prescribes the finished-goods requirements, consolidation, replenishment, dispatch, and load arrangements for distributing products from source to destination." .


###  http://example.org/apqc#DiversityEquityInclusionPlan
ex:DiversityEquityInclusionPlan rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000965 ;
                                rdfs:label "Diversity, Equity, and Inclusion Plan" ;
                                skos:definition "A Directive Information Content Entity that prescribes measures for ensuring a diverse, equitable, and inclusive workforce." .


###  http://example.org/apqc#DueDiligenceReport
ex:DueDiligenceReport rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Due-Diligence Report" ;
                      skos:definition "A Descriptive Information Content Entity that describes verified tangible and substantial facts about an entity being considered for a restructuring transaction." .


###  http://example.org/apqc#DutyCalculation
ex:DutyCalculation rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "Minted for group 9.11. Output of 9.11.5. Descriptive: it represents a computed amount owed, it does not prescribe an action." ;
                   rdfs:label "Duty Calculation" ;
                   skos:definition "A Descriptive Information Content Entity that describes the excise duty computed as payable on a given international-trade transaction." ;
                   skos:example "A line-item computation of customs duty owed on an imported shipment." .


###  http://example.org/apqc#EHSAuditReport
ex:EHSAuditReport rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "EHS Audit Report" ;
                  skos:definition "A Descriptive Information Content Entity that describes the findings of an inspection verifying compliance with environmental, health, and safety standards." .


###  http://example.org/apqc#EHSCostBenefitAssessment
ex:EHSCostBenefitAssessment rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000853 ;
                            rdfs:comment "Descriptive (a judgement of cost vs benefit). Output of ex:P11193 'Manage EHS costs and benefits'." ;
                            rdfs:label "EHS Cost-Benefit Assessment" ;
                            skos:definition "A Descriptive Information Content Entity that describes the evaluated costs and benefits of an environmental, health, and safety program and whether its benefits outweigh its costs." .


###  http://example.org/apqc#EHSEventRecord
ex:EHSEventRecord rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "EHS Event Record" ;
                  skos:definition "A Descriptive Information Content Entity that describes the events and activities associated with complying with environmental, health, and safety standards." .


###  http://example.org/apqc#EHSManagementCapability
ex:EHSManagementCapability rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000568 ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty obo:BFO_0000054 ;
                                             owl:someValuesFrom ex:P11180
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty obo:BFO_0000054 ;
                                             owl:someValuesFrom ex:P11181
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty obo:BFO_0000054 ;
                                             owl:someValuesFrom ex:P21587
                                           ] ;
                           ex:enablesProcess ex:P11180 ,
                                             ex:P11181 ,
                                             ex:P21587 ;
                           rdfs:comment "Standing-function reading of APQC 13.8 'Manage environmental health and safety' (PCF 11179). Per R5 the 'Manage' group node is a standing function -> Organization Capability; the catalog node ex:PCF_11179 designates this capability. Its three bounded group children (ex:P11180 determine impacts, ex:P11181 develop program, ex:P21587 monitor and manage) are wired as obo:BFO_0000054 (realized in) fillers, mirroring the 13.1/13.5 capability pattern. No ex:P11179 process is minted." ;
                           rdfs:label "EHS Management Capability" ;
                           skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to determine, develop, monitor, and manage its environmental, health, and safety program, realized in its bounded EHS acts." .


###  http://example.org/apqc#EHSManagerRole
ex:EHSManagerRole rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000984 ;
                  rdfs:comment "Minted for recurring APQC 13.8 participant." ;
                  rdfs:label "EHS Manager Role" ;
                  skos:definition "A Role that is borne by an Agent in virtue of being responsible for developing, monitoring, and managing an Organization's environmental, health, and safety program." .


###  http://example.org/apqc#EHSPerformanceReport
ex:EHSPerformanceReport rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "EHS Performance Report" ;
                        skos:definition "A Descriptive Information Content Entity that describes the measured performance of an environmental, health, and safety program against its indicators." .


###  http://example.org/apqc#EHSPolicy
ex:EHSPolicy rdf:type owl:Class ;
             rdfs:subClassOf cco:ont00000965 ;
             rdfs:label "EHS Policy" ;
             skos:definition "A Directive Information Content Entity that prescribes the minimum requirements, procedures, and tools by which an Organization will manage its environmental, health, and safety impact." .


###  http://example.org/apqc#EHSRequirementRegister
ex:EHSRequirementRegister rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Descriptive (a register/record of discerned, externally-set requirements). Output of ex:P11188 'Identify regulatory and stakeholder requirements', restoring Info-Processing -> Descriptive agreement (GOLDEN PRINCIPLE). The externally-authored Directive ex:EHSRequirementSpecification is the has-input it captures." ;
                          rdfs:label "EHS Requirement Register" ;
                          skos:definition "A Descriptive Information Content Entity that registers the regulatory and stakeholder protocols and standards an Organization has discerned it must comply with for environment, health, and safety." .


###  http://example.org/apqc#EHSRequirementSpecification
ex:EHSRequirementSpecification rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000965 ;
                               rdfs:comment "Directive ICE authored externally by regulators/stakeholders, NOT by the discernment act ex:P11188. P11188 consumes it as a has-input and produces the Descriptive ex:EHSRequirementRegister; it does not compose this directive." ;
                               rdfs:label "EHS Requirement Specification" ;
                               skos:definition "A Directive Information Content Entity that prescribes the regulatory and stakeholder protocols and standards an Organization must comply with for environment, health, and safety." .


###  http://example.org/apqc#EHSRiskAndOpportunityAssessment
ex:EHSRiskAndOpportunityAssessment rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000853 ;
                                   rdfs:label "EHS Risk and Opportunity Assessment" ;
                                   skos:definition "A Descriptive Information Content Entity that describes the future risks and opportunities affecting the environmental, health, and safety of products and services." .


###  http://example.org/apqc#EQMSPerformanceAssessment
ex:EQMSPerformanceAssessment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:label "EQMS Performance Assessment" ;
                             skos:definition "A Descriptive Information Content Entity that describes the benchmarked performance of an enterprise quality management system and the gaps relative to industry peers." .


###  http://example.org/apqc#EQMSScopeAndGoalSpecification
ex:EQMSScopeAndGoalSpecification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Minted: distinct from the broader Quality Strategy; fixes the deployable EQMS scope/targets/goals (output of ex:P17498/ex:P17500)." ;
                                 rdfs:label "EQMS Scope and Goal Specification" ;
                                 skos:definition "A Directive Information Content Entity that prescribes the scope, targets, and goals of an enterprise quality management system." .


###  http://example.org/apqc#ERMProcessConformanceReport
ex:ERMProcessConformanceReport rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000853 ;
                               rdfs:comment "Output of 11.1.2.8 (ensure each unit follows the ERM process), produced by ex:ActOfVerification (inlined above). Gate-F mint: a dedicated process-conformance finding ICE replacing the false-friend ex:RiskMonitoringReport (a time-series monitoring artifact) so the verification genus and its output ICE agree. Descriptive (cco:ont00000853)." ;
                               rdfs:label "ERM Process Conformance Report" ;
                               skos:definition "A Descriptive Information Content Entity that describes the finding of a check of whether each business unit and function follows the enterprise risk management process." .


###  http://example.org/apqc#ERMReportingConformanceReport
ex:ERMReportingConformanceReport rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Output of 11.1.2.9 (ensure each unit follows the ERM reporting process), produced by ex:ActOfVerification (inlined above). Gate-F mint: a dedicated reporting-process-conformance finding ICE replacing the false-friend ex:RiskMonitoringReport so the verification genus and its output ICE agree. Sibling of ex:ERMProcessConformanceReport. Descriptive (cco:ont00000853)." ;
                                 rdfs:label "ERM Reporting Conformance Report" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the finding of a check of whether each business unit and function follows the enterprise risk reporting process." .


###  http://example.org/apqc#EarningsInformation
ex:EarningsInformation rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:label "Employee Earnings Information" ;
                       skos:definition "A Descriptive Information Content Entity that describes the structure and components of an employee's salary or wages held in a central repository." ;
                       skos:example "The salary-structure record (base, allowances, bonus components) for one employee." .


