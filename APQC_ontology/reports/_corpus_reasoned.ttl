ex:EcologicalData rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "Ecological Data" ;
                  skos:definition "A Descriptive Information Content Entity that describes ecological factors and shifts relevant to an organization." .


###  http://example.org/apqc#EmergencyResponseProgram
ex:EmergencyResponseProgram rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:label "Emergency Response Program" ;
                            skos:definition "A Directive Information Content Entity that prescribes how available resources are organized, coordinated, and directed to respond to emergency scenarios." .


###  http://example.org/apqc#EmergingTechnologyData
ex:EmergingTechnologyData rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Section-8.0 shared input. APQC 8.2.1.2 monitor/map technologies, 8.2.7.2 analyze emerging concepts, 8.5.2.1 track capabilities. Descriptive." ;
                          rdfs:label "Emerging Technology Data" ;
                          skos:definition "A Descriptive Information Content Entity that describes new, emerging, and potentially disruptive technologies relevant to an organization's IT capabilities." .


###  http://example.org/apqc#Employee
ex:Employee rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00001017 ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty obo:BFO_0000196 ;
                              owl:someValuesFrom ex:EmployeeRole
                            ] ;
            rdfs:comment "Modeled as cco:Agent (a Material Entity bearing an Agent Capability), subsuming individual persons; reused as the participant/subject across recruiting, development, reward, and separation acts." ,
                         "Subject of payroll (9.5) and expense reimbursement (9.6)." ;
            rdfs:label "Employee" ;
            skos:definition "An Agent that bears an employee role in relation to an employing Organization." ,
                            "An Agent that bears an employee role in virtue of being engaged by an organization to perform assigned activities in exchange for compensation." .


###  http://example.org/apqc#EmployeeCareerDevelopmentCapability
ex:EmployeeCareerDevelopmentCapability rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000568 ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10487
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10488
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P17051
                                                       ] ;
                                       ex:apqcSourceText "Establishing employee development guidelines. Lay out career paths and plans for them. Manage the development of their skills to enhance their skills, ability, and knowledge." ;
                                       ex:enablesProcess ex:P10487 ,
                                                         ex:P10488 ,
                                                         ex:P17051 ;
                                       ex:hierarchyID "7.3.3" ;
                                       rdfs:comment "R6: APQC 7.3.3 'Manage employee career development' (PCF 10472) is a standing function realized in its bounded acts." ;
                                       rdfs:label "Employee Career Development Capability" ;
                                       skos:definition "An Organization Capability that inheres in an Organization to the extent of its capacity to establish development guidelines, lay out career plans and paths, and administer the development of employee skills and competencies." ;
                                       skos:example "A firm's standing ability to maintain career ladders and grow its employees' competencies." .


###  http://example.org/apqc#EmployeeCommunicationCapability
ex:EmployeeCommunicationCapability rdf:type owl:Class ;
                                   rdfs:subClassOf cco:ont00000568 ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P10529
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P10532
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty obo:BFO_0000054 ;
                                                     owl:someValuesFrom ex:P16944
                                                   ] ;
                                   ex:enablesProcess ex:P10529 ,
                                                     ex:P10532 ,
                                                     ex:P16944 ;
                                   rdfs:comment "For standing functions in group 7.8." ;
                                   rdfs:label "Employee Communication Capability" ;
                                   skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to plan, deliver, and manage communication and engagement with and among its employees." .


###  http://example.org/apqc#EmployeeCommunicationPlan
ex:EmployeeCommunicationPlan rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000965 ;
                             rdfs:label "Employee Communication Plan" ;
                             skos:definition "A Directive Information Content Entity that prescribes how communication and engagement with and among employees are to be managed." .


###  http://example.org/apqc#EmployeeData
ex:EmployeeData rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:label "Employee Data" ;
                skos:definition "A Descriptive Information Content Entity that records information about individual employees, including their attributes, status, and history." .


###  http://example.org/apqc#EmployeeDevelopmentCapability
ex:EmployeeDevelopmentCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ;
                                 ex:enablesProcess ex:P10474 ,
                                                   ex:P10479 ,
                                                   ex:P10481 ,
                                                   ex:P10487 ,
                                                   ex:P10488 ,
                                                   ex:P10490 ,
                                                   ex:P10491 ,
                                                   ex:P10492 ,
                                                   ex:P10493 ,
                                                   ex:P11243 ,
                                                   ex:P16940 ,
                                                   ex:P17050 ,
                                                   ex:P17051 ,
                                                   ex:P20125 ,
                                                   ex:P21434 ,
                                                   ex:P21436 ;
                                 rdfs:comment "For standing functions in group 7.3 (onboarding, performance, career development, training)." ;
                                 rdfs:label "Employee Development Capability" ;
                                 skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to onboard, train, develop, and manage the performance of its employees." .


###  http://example.org/apqc#EmployeeFeedback
ex:EmployeeFeedback rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000853 ;
                    rdfs:label "Employee Feedback" ;
                    skos:definition "A Descriptive Information Content Entity that records suggestions, opinions, attitudes, or survey responses gathered from employees." .


###  http://example.org/apqc#EmployeeGrievance
ex:EmployeeGrievance rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000853 ;
                     rdfs:comment "Minted locally (group 7.4, used by P10531): no provided input ICE captures an employee-raised complaint specifically. Descriptive because it represents a complaint rather than prescribing action." ;
                     rdfs:label "Employee Grievance" ;
                     skos:definition "A Descriptive Information Content Entity that describes a complaint raised by an employee concerning the terms or conditions of employment." ;
                     skos:example "A written complaint that a shift assignment violated the collective agreement." .


###  http://example.org/apqc#EmployeeMetric
ex:EmployeeMetric rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ;
                  rdfs:label "Employee Metric" ;
                  skos:definition "A Descriptive Information Content Entity that describes a measured indicator of employee productivity, efficiency, training, retention, or motivation." .


###  http://example.org/apqc#EmployeeOrientationAndDeploymentCapability
ex:EmployeeOrientationAndDeploymentCapability rdf:type owl:Class ;
                                              rdfs:subClassOf cco:ont00000568 ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:BFO_0000054 ;
                                                                owl:someValuesFrom ex:P10474
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:BFO_0000054 ;
                                                                owl:someValuesFrom ex:P11243
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:BFO_0000054 ;
                                                                owl:someValuesFrom ex:P17050
                                                              ] ;
                                              ex:apqcSourceText "Creating and maintaining various employee on-boarding programs typically known as induction programs in order to ensure that the new employees are effectively introduced to the organization and its existing employees. Examine and evaluate the performance of these induction programs. Execute these programs on the ground level." ;
                                              ex:enablesProcess ex:P10474 ,
                                                                ex:P11243 ,
                                                                ex:P17050 ;
                                              ex:hierarchyID "7.3.1" ;
                                              rdfs:comment "R6 (R5 = standing function): APQC 7.3.1 'Manage employee orientation and deployment' (PCF 10469) has no natural end, so it is modeled as an Organization Capability realized in its bounded onboarding acts, not as a process." ;
                                              rdfs:label "Employee Orientation and Deployment Capability" ;
                                              skos:definition "An Organization Capability that inheres in an Organization to the extent of its capacity to create, maintain, evaluate, and execute employee onboarding and orientation programs." ;
                                              skos:example "A firm's standing ability to onboard and deploy new hires through its induction program." .


###  http://example.org/apqc#EmployeePerformanceManagementCapability
ex:EmployeePerformanceManagementCapability rdf:type owl:Class ;
                                           rdfs:subClassOf cco:ont00000568 ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000054 ;
                                                             owl:someValuesFrom ex:P10479
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000054 ;
                                                             owl:someValuesFrom ex:P10481
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000054 ;
                                                             owl:someValuesFrom ex:P21434
                                                           ] ;
                                           ex:apqcSourceText "Defining individual performance objectives. Review performance in order to provide appraisals. Evaluate the efficiency and effectiveness of the current performance program. Update it regularly." ;
                                           ex:enablesProcess ex:P10479 ,
                                                             ex:P10481 ,
                                                             ex:P21434 ;
                                           ex:hierarchyID "7.3.2" ;
                                           rdfs:comment "R6: APQC 7.3.2 'Manage employee performance' (PCF 10470) is a standing function realized in its bounded acts. The sibling APQC node 7.3.2.3 (PCF 21435), itself the standing 'management of reviewing', is subsumed by this capability rather than minted as a process." ;
                                           rdfs:label "Employee Performance Management Capability" ;
                                           skos:definition "An Organization Capability that inheres in an Organization to the extent of its capacity to define performance objectives, appraise employee performance, and evaluate and revise its performance-management program." ;
                                           skos:example "An organization's standing ability to run its annual performance-review cycle." .


###  http://example.org/apqc#EmployeeRecord
ex:EmployeeRecord rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000853 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cco:ont00001808 ;
                                    owl:someValuesFrom ex:Employee
                                  ] ;
                  rdfs:comment "About the Employee it records; captured and maintained in group 7.7." ;
                  rdfs:label "Employee Record" ;
                  skos:definition "A Descriptive Information Content Entity that records the information and history of an individual employee." .


###  http://example.org/apqc#EmployeeReferralProgramCapability
ex:EmployeeReferralProgramCapability rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000568 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:BFO_0000054 ;
                                                       owl:someValuesFrom ex:P10440
                                                     ] ;
                                     ex:enablesProcess ex:P10440 ;
                                     rdfs:comment "APQC 7.2.2.4 (PCF 17047) is a standing function (ongoing program/strategy management), modeled as a capability per R5/R6. R6 fix: realized-in corrected from the narrow ex:P10454 (Perform recruiting activities/events) -- a copy-paste mis-anchor, since running career fairs does not realize referral-program operation -- to the group sourcing process ex:P10440 (Recruit/Source candidates), whose source text explicitly covers 'Manage employee referral programs'." ;
                                     rdfs:label "Employee Referral Program Capability" ;
                                     skos:definition "An Organization Capability that is realized in Acts of operating an employee-referral program in which employees are rewarded for referring qualified candidates." .


###  http://example.org/apqc#EmployeeRelationsCapability
ex:EmployeeRelationsCapability rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00000568 ;
                               ex:enablesProcess ex:P10484 ,
                                                 ex:P10531 ,
                                                 ex:P21437 ;
                               rdfs:comment "For standing functions in group 7.4." ;
                               rdfs:label "Employee Relations Capability" ;
                               skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to develop, maintain, and improve relationships with and among employees, including labor relations and grievance handling." .


###  http://example.org/apqc#EmployeeRole
ex:EmployeeRole rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000984 ;
                rdfs:comment "Used for payroll and expense-reimbursement subjects in 9.5 and 9.6." ;
                rdfs:label "Employee Role" ;
                skos:definition "A Role that is borne by an Agent in virtue of being engaged or employed by an organization to perform assigned activities in exchange for compensation." .


###  http://example.org/apqc#EmployeeTaxStatement
ex:EmployeeTaxStatement rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:label "Employee Annual Tax Statement" ;
                        skos:definition "A Descriptive Information Content Entity that describes the tax withheld from an employee's salary over a year, issued to the employee for reference or refund." ;
                        skos:example "A year-end wage-and-tax statement provided to each employee." .


###  http://example.org/apqc#EmployeeTrainingCapability
ex:EmployeeTrainingCapability rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000568 ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P10490
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P10491
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P10492
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P10493
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P16940
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P20125
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty obo:BFO_0000054 ;
                                                owl:someValuesFrom ex:P21436
                                              ] ;
                              ex:apqcSourceText "Creating a link between employee and organizational development needs. Conduct and manage employee training programs by considering the need and availability of these programs." ;
                              ex:enablesProcess ex:P10490 ,
                                                ex:P10491 ,
                                                ex:P10492 ,
                                                ex:P10493 ,
                                                ex:P16940 ,
                                                ex:P20125 ,
                                                ex:P21436 ;
                              ex:hierarchyID "7.3.4" ;
                              rdfs:comment "R6: APQC 7.3.4 'Develop and train employees' (PCF 10473) is a standing function with no natural end, realized in its bounded training acts. Narrower companion to the shared ex:EmployeeDevelopmentCapability." ;
                              rdfs:label "Employee Training Capability" ;
                              skos:definition "An Organization Capability that inheres in an Organization to the extent of its capacity to align development needs, define competencies, and conduct and manage employee and management training programs." ;
                              skos:example "A firm's standing ability to run its corporate training and certification programs." .


###  http://example.org/apqc#EmployeeUtilizationReport
ex:EmployeeUtilizationReport rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:label "Employee Utilization Report" ;
                             skos:definition "A Descriptive Information Content Entity that describes the productive (billable) hours of employees relative to their available hours." ;
                             skos:example "A utilization dashboard showing each consultant's billable-hour ratio." .


###  http://example.org/apqc#EmployerBrandingCapability
ex:EmployerBrandingCapability rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000568 ;
                              rdfs:comment "R5: APQC 7.1.1.9 (PCF 20606) 'Manage employer branding' is a standing function (ongoing create/maintain/communicate) with no natural end, so it is modeled as a capability, not a process." ;
                              rdfs:label "Employer Branding Capability" ;
                              skos:definition "An Organization Capability that inheres in an organization's human resources function in virtue of its capacity to create, maintain, and communicate the organization's reputation and values so as to retain and attract employees." ;
                              skos:example "An HR function's ongoing ability to sustain a positive employer brand across recruiting channels." .


###  http://example.org/apqc#EngagementRules
ex:EngagementRules rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Shared section-5.0 output (5.3.1.6.2). Directive: rules prescribe required conduct." ;
                   rdfs:label "Engagement Rules" ;
                   skos:definition "A Directive Information Content Entity that prescribes how service-delivery resources are to interact with and accommodate the customer." .


###  http://example.org/apqc#EngagementSurveyResult
ex:EngagementSurveyResult rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:label "Engagement Survey Result" ;
                          skos:definition "A Descriptive Information Content Entity that describes employees' overall workplace satisfaction as ascertained through an engagement survey." .


###  http://example.org/apqc#EngineeringChangeOrder
ex:EngineeringChangeOrder rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Output of 2.3.3.3 (request engineering/process change); APQC 'engineering change order'." ;
                          rdfs:label "Engineering Change Order" ;
                          skos:definition "A Directive Information Content Entity that prescribes requested changes to production or delivery operations for a product or service." .


###  http://example.org/apqc#EnterpriseArchitect
ex:EnterpriseArchitect rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001017 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:EnterpriseArchitectRole
                                       ] ;
                       rdfs:comment "Section-8.0 shared. Bearer of ex:EnterpriseArchitectRole. Participant in the enterprise-architecture definition and governance acts (8.2.3) where the role is definitional." ;
                       rdfs:label "Enterprise Architect" ;
                       skos:definition "An Agent that bears an enterprise-architect role within an organization's IT function." .


###  http://example.org/apqc#EnterpriseArchitectRole
ex:EnterpriseArchitectRole rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000984 ;
                           rdfs:comment "APQC 8.2.3 define and maintain enterprise architecture; 8.5.3 service/solution architecture." ;
                           rdfs:label "Enterprise Architect Role" ;
                           skos:definition "A Role that is borne by an Agent in virtue of being responsible for defining, governing, and maintaining an organization's enterprise IT architecture." .


###  http://example.org/apqc#EnterpriseArchitectureGovernanceModel
ex:EnterpriseArchitectureGovernanceModel rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000965 ;
                                         rdfs:comment "8.2.3.2 output. Directive: a governance model prescribes how the architecture is to be governed." ;
                                         rdfs:label "Enterprise Architecture Governance Model" ;
                                         skos:definition "A Directive Information Content Entity that prescribes the rules, regulations, policies, and standards governing the components of an enterprise's IT architecture and the architecture as a whole." .


###  http://example.org/apqc#EnterpriseArchitecturePrinciples
ex:EnterpriseArchitecturePrinciples rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000965 ;
                                    rdfs:comment "8.2.3.1 output. Directive: principles prescribe; foundation for the EA specification." ;
                                    rdfs:label "Enterprise Architecture Principles" ;
                                    skos:definition "A Directive Information Content Entity that prescribes the high-level fundamental values guiding IT decision-making and forming the foundation for enterprise architecture." .


###  http://example.org/apqc#EnterpriseArchitectureSpecification
ex:EnterpriseArchitectureSpecification rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000965 ;
                                       rdfs:comment "Section-8.0 shared output. APQC 8.2.3 define and maintain enterprise architecture, 8.4.2 information architecture, 8.5.3 service/solution architecture. Directive: an architecture specification prescribes how IT is to be structured." ;
                                       rdfs:label "Enterprise Architecture Specification" ;
                                       skos:definition "A Directive Information Content Entity that prescribes the principles, components, frameworks, and governance rules that constitute an organization's enterprise IT architecture." .


###  http://example.org/apqc#EnterpriseDataModelSpecification
ex:EnterpriseDataModelSpecification rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000965 ;
                                    rdfs:comment "8.4.2.2 output. A data model is a prescriptive design artifact, hence Directive, agreeing with its design-act genus (GOLDEN PRINCIPLE)." ;
                                    rdfs:label "Enterprise Data Model Specification" ;
                                    skos:definition "A Directive Information Content Entity that prescribes the representation, usage, and identification of data entities and their relationships across the organization's independent or interdependent sources." ;
                                    skos:example "An enterprise logical data model of customer, product, and order entities." .


###  http://example.org/apqc#EnterpriseMeasurementModel
ex:EnterpriseMeasurementModel rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000965 ;
                              rdfs:label "Enterprise Measurement Model" ;
                              skos:definition "A Directive Information Content Entity that prescribes which processes to measure, which measures to use, how often to measure, and the measurement targets across an enterprise." .


###  http://example.org/apqc#EnterpriseQualityManagementCapability
ex:EnterpriseQualityManagementCapability rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000568 ;
                                         ex:enablesProcess ex:P17472 ,
                                                           ex:P17482 ,
                                                           ex:P17492 ,
                                                           ex:P17498 ;
                                         rdfs:comment "Shared target for the standing-function reading of APQC 13.3 'Manage enterprise quality'. The 13.3 group node ex:P17471 carries the same intent with explicit realized-in restrictions to its child acts." ;
                                         rdfs:label "Enterprise Quality Management Capability" ;
                                         skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish quality requirements, evaluate performance against them, manage non-conformance, and operate an enterprise quality management system." .


###  http://example.org/apqc#EnterpriseRiskManagementCapability
ex:EnterpriseRiskManagementCapability rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000568 ;
                                      ex:enablesProcess ex:P16439 ,
                                                        ex:P16445 ,
                                                        ex:P17462 ;
                                      rdfs:comment "Models the standing function of 11.1 'Manage enterprise risk' (R5/R6). The realized-in axioms to the bounded 11.1 acts are carried by ex:P17060 below, which is this capability's reality-layer correlate." ;
                                      rdfs:label "Enterprise Risk Management Capability" ;
                                      skos:definition "An Organization Capability that is realized in acts of establishing risk frameworks and policies and of overseeing, coordinating, and managing risk across an organization and its business units." .


###  http://example.org/apqc#EnterpriseRiskPolicy
ex:EnterpriseRiskPolicy rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "Output of 11.1.1.2 (develop and maintain enterprise risk policies and procedures); reference framework for 11.1.3.2 (assess risks using enterprise risk framework). Directive: prescribes conduct." ;
                        rdfs:label "Enterprise Risk Policy and Procedure" ;
                        skos:definition "A Directive Information Content Entity that prescribes the rules, regulations, and procedures for managing hazardous, financial, operational, and strategic risk across an organization." .


###  http://example.org/apqc#EnterpriseRiskReport
ex:EnterpriseRiskReport rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ;
                        rdfs:comment "Shared reporting output across 11.1.1.5, 11.1.2.6, and 11.1.3.7. Descriptive (it represents the state of risk), produced by Act of Reporting." ;
                        rdfs:label "Enterprise Risk Report" ;
                        skos:definition "A Descriptive Information Content Entity that describes hazard, financial, and operational risks and risk-management activities for presentation to executive management and the board." .


###  http://example.org/apqc#EnterpriseRiskTool
ex:EnterpriseRiskTool rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:comment "Output of 11.1.1.3 (identify and implement enterprise risk management tools). Modeled as a Directive ICE (a methodological specification), distinct from any physical software tool; if a particular org deploys a software artifact, that is a separate Material Artifact not minted here." ;
                      rdfs:label "Enterprise Risk Management Tool Specification" ;
                      skos:definition "A Directive Information Content Entity that prescribes the methods, models, and processes adopted for managing risks and opportunities associated with business objectives." .


###  http://example.org/apqc#EnvironmentalImpactAssessment
ex:EnvironmentalImpactAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:label "Environmental Impact Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes the environmental impact of an Organization's products, services, and operations over their lifecycle." .


###  http://example.org/apqc#EnvironmentalReadinessConfirmation
ex:EnvironmentalReadinessConfirmation rdf:type owl:Class ;
                                      rdfs:subClassOf cco:ont00000853 ;
                                      rdfs:comment "Shared section-5.0 output (5.3.1.5). Descriptive: a confirmation reports a verified state." ;
                                      rdfs:label "Environmental Readiness Confirmation" ;
                                      skos:definition "A Descriptive Information Content Entity that describes a confirmed judgement that an organization holds the resources and conditions required to deliver a service." .


###  http://example.org/apqc#EthicsPolicy
ex:EthicsPolicy rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ;
                rdfs:comment "Output of 12.4.1 (Create ethics policies)." ;
                rdfs:label "Ethics Policy" ;
                skos:definition "A Directive Information Content Entity that prescribes an organization's code of ethics communicating its philosophy to employees, partners, and the public." .


###  http://example.org/apqc#EvaluateOutput
ex:EvaluateOutput rdf:type owl:Class ;
                  rdfs:subClassOf ex:ActOfVerification ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cco:ont00001986 ;
                                    owl:someValuesFrom ex:JudgeVerdict
                                  ] ;
                  ex:requiresCapability ex:EvaluationCapability ;
                  ex:requiresRole ex:EvaluatorRole ;
                  ex:routable "true"^^xsd:boolean ;
                  rdfs:label "Evaluate output" ;
                  skos:definition "An Act of Verification in which an evaluator agent appraises an artifact against its acceptance criteria and records a verdict." .


###  http://example.org/apqc#EvaluationCapability
ex:EvaluationCapability rdf:type owl:Class ;
                        rdfs:subClassOf ex:Capability ;
                        ex:enablesProcess ex:EvaluateOutput ;
                        rdfs:label "Evaluation capability" ;
                        skos:definition "An Agent Capability that enables its bearer to evaluate an artifact against its acceptance criteria." .


###  http://example.org/apqc#EvaluatorRole
ex:EvaluatorRole rdf:type owl:Class ;
                 rdfs:subClassOf ex:Role ,
                                 cco:ont00000984 ;
                 rdfs:label "Evaluator role" ;
                 skos:definition "The occupation role of an agent evaluating artifacts against their acceptance criteria." .


###  http://example.org/apqc#ExceptionResolutionRecord
ex:ExceptionResolutionRecord rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ;
                             rdfs:comment "Minted locally for 9.6.1.7: descriptive output of researching/resolving payable exceptions." ;
                             rdfs:label "Payable Exception Resolution Record" ;
                             skos:definition "A Descriptive Information Content Entity that records the investigation and disposition of an atypical or inconsistent accounts-payable situation." .


###  http://example.org/apqc#ExecutionRoadmap
ex:ExecutionRoadmap rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00000965 ;
                    rdfs:comment "Output of 3.2.3.8, 3.4.2.6, and 3.5.3.7. Directive (Formulation)." ;
                    rdfs:label "Execution Roadmap" ;
                    skos:definition "A Directive Information Content Entity that prescribes the actions, ordering, timing, and dependencies for executing a strategy or delivering a proposed solution." .


###  http://example.org/apqc#ExecutiveAppointment
ex:ExecutiveAppointment rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000965 ;
                        rdfs:comment "Output of 12.2.1.2 (Appoint responsible executives). Directive: it assigns responsibility." ;
                        rdfs:label "Executive Appointment" ;
                        skos:definition "A Directive Information Content Entity that prescribes the assignment of an executive-level agent to manage and drive a designated set of relationships." .


###  http://example.org/apqc#ExecutiveManagement
ex:ExecutiveManagement rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00001017 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000196 ;
                                         owl:someValuesFrom ex:ExecutiveManagementRole
                                       ] ;
                       rdfs:comment "Definitional recipient in 11.1.1.5 (report enterprise risk to executive management and board)." ;
                       rdfs:label "Executive Management" ;
                       skos:definition "An Agent that bears an executive-management role and is a recipient of enterprise risk and compliance reports." .


###  http://example.org/apqc#ExecutiveManagementRole
ex:ExecutiveManagementRole rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000984 ;
                           rdfs:label "Executive Management Role" ;
                           skos:definition "A Role that is borne by an Agent in virtue of exercising executive authority and accountability for an organization, including oversight of enterprise risk and compliance." .


###  http://example.org/apqc#ExecutivePersonnel
ex:ExecutivePersonnel rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00001017 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty obo:BFO_0000196 ;
                                        owl:someValuesFrom ex:ExecutiveRole
                                      ] ;
                      rdfs:comment "Minted for 12.2.1.2 (Appoint responsible executives) and other rows assigning executive-level resources." ;
                      rdfs:label "Executive Personnel" ;
                      skos:definition "An Agent that bears an executive role in virtue of holding senior managerial authority responsible for driving and overseeing organizational relationships and activities." .


###  http://example.org/apqc#ExecutiveRole
ex:ExecutiveRole rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000984 ;
                 rdfs:label "Executive Role" ;
                 skos:definition "A Role that is borne by an Agent in virtue of holding senior managerial authority within an Organization." .


###  http://example.org/apqc#ExperienceQualificationAssessment
ex:ExperienceQualificationAssessment rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000853 ;
                                     rdfs:comment "Minted locally (group 7.3, used by P20128)." ;
                                     rdfs:label "Experience Qualification Assessment" ;
                                     skos:definition "A Descriptive Information Content Entity that describes a judgement of the experience level required to qualify for a specific job or certification." ;
                                     skos:example "A determination that a senior technician certification requires three years of practical field experience." .


###  http://example.org/apqc#ExpertAdvice
ex:ExpertAdvice rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:comment "Output/input of 11.3.2 (contact and confer with experts); consumed by 11.3.1 (create remediation plans). Descriptive: it represents expert opinion." ;
                rdfs:label "Expert Advice" ;
                skos:definition "A Descriptive Information Content Entity that describes the recommendations and judgements solicited from subject-matter experts to inform remediation planning." .


###  http://example.org/apqc#ExposureLimitResolution
ex:ExposureLimitResolution rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000965 ;
                           rdfs:comment "Local mint for 9.7.5.4.2. Directive because a resolution prescribes the corrective course of action." ;
                           rdfs:label "Exposure Limit Resolution" ;
                           skos:definition "A Directive Information Content Entity that prescribes the settlement of a customer exposure-limit violation." .


###  http://example.org/apqc#ExternalDataSourceAssessment
ex:ExternalDataSourceAssessment rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:comment "8.4.2.3 output. Descriptive (it characterizes sources rather than prescribing action), agreeing with its identification-act genus (GOLDEN PRINCIPLE)." ;
                                rdfs:label "External Data Source Assessment" ;
                                skos:definition "A Descriptive Information Content Entity that describes identified external data sources with respect to their reliability, security, and authenticity." ;
                                skos:example "A register rating third-party data feeds by trustworthiness and provenance." .


###  http://example.org/apqc#ExternalEnvironmentAppraisal
ex:ExternalEnvironmentAppraisal rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000853 ;
                                rdfs:label "External Environment Appraisal" ;
                                skos:definition "A Descriptive Information Content Entity that describes a judgement of the external circumstances, objects, events, and aspects surrounding an organization that affect its asset decisions, including opportunities and risks." .


###  http://example.org/apqc#ExternalEnvironmentAssessment
ex:ExternalEnvironmentAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000853 ;
                                 rdfs:comment "Carried over from the 1.1.1 reference module so this module is self-contained." ;
                                 rdfs:label "External Environment Assessment" ;
                                 skos:definition "A Descriptive Information Content Entity that describes a big-picture understanding of an organization's external environment." ;
                                 skos:example "A strategy team's annual environmental scan report." .


###  http://example.org/apqc#ExternalITSupportProvider
ex:ExternalITSupportProvider rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00001180 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000196 ;
                                               owl:someValuesFrom ex:ITServiceProviderRole
                                             ] ;
                             rdfs:comment "Section-8.0 shared. APQC 8.7.5.8 'coordinate with external support providers', 8.3.7.3 'external IT service provider', 8.7.1.5 sourcing. Distinguished from ex:ITServiceProvider only by being external; both bear the same provider role." ;
                             rdfs:label "External IT Support Provider" ;
                             skos:definition "An Organization that bears an IT service provider role and is external to the focal organization, engaged to supply IT support or service-delivery resources under contract." .


###  http://example.org/apqc#ExternalReviewReport
ex:ExternalReviewReport rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000853 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cco:ont00001808 ;
                                          owl:someValuesFrom ex:ProductServiceOffering
                                        ] ;
                        rdfs:comment "Minted: output of 2.3.1.7; not in shared list. Descriptive." ;
                        rdfs:label "External Review Report" ;
                        skos:definition "A Descriptive Information Content Entity that records the findings of mandatory and elective external reviews of a product or service design specification against external standards." .


###  http://example.org/apqc#Facility
ex:Facility rdf:type owl:Class ;
            rdfs:subClassOf cco:ont00000192 ;
            rdfs:comment "Specialization of CCO Facility (ont00000192, 'a building or campus dedicated to some specific purpose') scoped to the managed-asset role in section 10.0." ;
            rdfs:label "Facility (asset)" ;
            skos:definition "A Facility that an organization plans, designs, constructs, modifies, operates, maintains, or disposes of as part of managing its assets." .


###  http://example.org/apqc#FacilityDesign
ex:FacilityDesign rdf:type owl:Class ;
                  rdfs:subClassOf cco:ont00000965 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cco:ont00001808 ;
                                    owl:someValuesFrom ex:Facility
                                  ] ;
                  rdfs:comment "Directive (a blueprint/specification prescribing how the facility shall be realized), per CCO's Directive-ICE elucidation citing blueprints." ;
                  rdfs:label "Facility Design" ;
                  skos:definition "A Directive Information Content Entity, about a facility, that prescribes the configuration, layout, and specifications of that facility to be built or modified." .


###  http://example.org/apqc#FacilityManagementCapability
ex:FacilityManagementCapability rdf:type owl:Class ;
                                rdfs:subClassOf cco:ont00000568 ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P10965
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty obo:BFO_0000054 ;
                                                  owl:someValuesFrom ex:P10966
                                                ] ;
                                ex:enablesProcess ex:P10965 ,
                                                  ex:P10966 ;
                                rdfs:comment "Organization Capability (cco:ont00000568) because 'Manage facilities operations' (10.1.4) is a standing organizational function (R5). Realized in the operational location-change acts via obo:BFO_0000054 (see R6 axioms in the 10.1 process block)." ;
                                rdfs:label "Facility Management Capability" ;
                                skos:definition "An Organization Capability that is realized in acts of planning, providing, operating, and maintaining facilities and workspaces." .


###  http://example.org/apqc#FacilityManagementPersonnel
ex:FacilityManagementPersonnel rdf:type owl:Class ;
                               rdfs:subClassOf cco:ont00001017 ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty obo:BFO_0000196 ;
                                                 owl:someValuesFrom ex:FacilityManagerRole
                                               ] ;
                               rdfs:label "Facility Management Personnel" ;
                               skos:definition "An Agent that bears a facility manager role." .


###  http://example.org/apqc#FacilityManagerRole
ex:FacilityManagerRole rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000984 ;
                       rdfs:label "Facility Manager Role" ;
                       skos:definition "A Role that is borne by an Agent in virtue of being tasked with planning, providing, and operating an organization's facilities and workspaces." .


###  http://example.org/apqc#FacilityTermsAgreement
ex:FacilityTermsAgreement rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000965 ;
                          rdfs:comment "Directive: a contract/agreement prescribes the obligations of the parties." ;
                          rdfs:label "Facility Terms Agreement" ;
                          skos:definition "A Directive Information Content Entity that prescribes the negotiated terms and conditions under which a facility is to be occupied or used." .


###  http://example.org/apqc#FamilySupportProgramSpecification
ex:FamilySupportProgramSpecification rdf:type owl:Class ;
                                     rdfs:subClassOf cco:ont00000965 ;
                                     rdfs:comment "Minted as the definitional Directive output of P10509 (Develop family support systems), mirroring the directive outputs of the other 7.5 formulation acts (CompensationStructure, BenefitsAndRewardsPlan)." ;
                                     rdfs:label "Family Support Program Specification" ;
                                     skos:definition "A Directive Information Content Entity that prescribes an organization's family-support provisions such as maternity leave, family-member care, and extended sick leave, aligned with applicable law." .


###  http://example.org/apqc#FeasibilityAssessment
ex:FeasibilityAssessment rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000853 ;
                         rdfs:comment "Output of feasibility/technical-assessment acts (2.2.1.3, 2.3.1.2, 2.3.2.4)." ;
                         rdfs:label "Feasibility Assessment" ;
                         skos:definition "A Descriptive Information Content Entity that describes a judgement of whether a proposed technology, concept, or project can practicably be realized." .


###  http://example.org/apqc#FeedbackCriteriaSpecification
ex:FeedbackCriteriaSpecification rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000965 ;
                                 rdfs:comment "Minted for 1.4.2.2 output. Directive (it prescribes admissible feedback)." ;
                                 rdfs:label "Feedback Criteria Specification" ;
                                 skos:definition "A Directive Information Content Entity that prescribes which types of feedback are to be taken into consideration during business-model maintenance." .


###  http://example.org/apqc#FeedbackPrioritization
ex:FeedbackPrioritization rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Minted for 1.4.2.3 output. Descriptive (it represents a judgement of importance)." ;
                          rdfs:label "Feedback Prioritization" ;
                          skos:definition "A Descriptive Information Content Entity that describes the relative importance of items of incoming feedback, identifying which are critical to act upon." .


###  http://example.org/apqc#FieldServiceAgent
ex:FieldServiceAgent rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00001017 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty obo:BFO_0000196 ;
                                       owl:someValuesFrom ex:FieldServiceAgentRole
                                     ] ;
                     rdfs:comment "Minted. Named in 6.3.2.3.2 (Schedule field service) and 6.3.4.3 (Provide service to specific customers)." ;
                     rdfs:label "Field Service Agent" ;
                     skos:definition "An Agent that bears a field-service-agent role, by which it performs on-site investigation, repair, and evidence collection in support of warranty and service processes." .


###  http://example.org/apqc#FieldServiceAgentRole
ex:FieldServiceAgentRole rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000984 ;
                         rdfs:label "Field Service Agent Role" ;
                         skos:definition "A Role that is borne by an Agent in virtue of being tasked with on-site investigation, repair, and evidence collection for service and warranty processes." .


###  http://example.org/apqc#FinanceFunction
ex:FinanceFunction rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00001180 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000196 ;
                                     owl:someValuesFrom ex:FinanceFunctionRole
                                   ] ;
                   rdfs:comment "Models the finance department/function as an organizational unit (an Organization), NOT a realizable function/capability despite the 'Function' label. Mirrors the slice-7 ex:HumanResourcesFunction precedent: cco:ont00001180 (Organization) is a Group of Agents / Object Aggregate, not an Agent (cco:ont00001017). Bearer of the finance-function role and the agent/participant of section 9.0 acts." ;
                   rdfs:label "Finance Function" ;
                   skos:definition "An Organization that bears a finance-function role within a larger organization in virtue of being tasked with carrying out its financial management activities." .


###  http://example.org/apqc#FinanceFunctionRole
ex:FinanceFunctionRole rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000023 ;
                       rdfs:comment "Shared across 9.0. Borne by the independent continuant (the finance unit or officer), never by an ICE." ;
                       rdfs:label "Finance Function Role" ;
                       skos:definition "A Role that is borne by an Agent or organizational unit in virtue of being tasked with carrying out the financial management activities of an Organization." .


###  http://example.org/apqc#FinancialAnalyst
ex:FinancialAnalyst rdf:type owl:Class ;
                    rdfs:subClassOf cco:ont00001017 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty obo:BFO_0000196 ;
                                      owl:someValuesFrom ex:FinancialAnalystRole
                                    ] ;
                    rdfs:comment "Minted for 12.1.2 (Plan, build, and manage analyst relations)." ;
                    rdfs:label "Financial Analyst" ;
                    skos:definition "An Agent that bears a financial-analyst role in virtue of evaluating the securities, performance, and prospects of an organization." .


###  http://example.org/apqc#FinancialAnalystRole
ex:FinancialAnalystRole rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000984 ;
                        rdfs:label "Financial Analyst Role" ;
                        skos:definition "A Role that is borne by an Agent in virtue of evaluating the securities, performance, and prospects of a focal organization." .


###  http://example.org/apqc#FinancialData
ex:FinancialData rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:comment "Input for 12.3.1 (Report financial results)." ;
                 rdfs:label "Financial Data" ;
                 skos:definition "A Descriptive Information Content Entity that describes an Organization's financial transactions, balances, or results." ,
                                 "A Descriptive Information Content Entity that describes an organization's financial position and performance." .


###  http://example.org/apqc#FinancialForecast
ex:FinancialForecast rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000626 ;
                     rdfs:comment "Predictive (a specialization of Descriptive, cco:ont00000853): a forecast describes an uncertain expected future state rather than prescribing an allocation; contrast ex:Budget. Re-anchored from cco:ont00000853 to cco:ont00000626 (Predictive Information Content Entity) so the output kind matches the predictive nature of ex:P10773 (Act of Prediction). Still a Descriptive ICE for GOLDEN-PRINCIPLE purposes (cco:ont00000626 subClassOf cco:ont00000853)." ;
                     rdfs:label "Financial Forecast" ;
                     skos:definition "A Predictive Information Content Entity that describes projected future income, expenses, or cash flows of an Organization." .


###  http://example.org/apqc#FinancialHealthAnalysis
ex:FinancialHealthAnalysis rdf:type owl:Class ;
                           rdfs:subClassOf cco:ont00000853 ;
                           rdfs:label "Financial Health Analysis" ;
                           skos:definition "A Descriptive Information Content Entity that describes an appraisal of an organization's financial state and capacities." .


###  http://example.org/apqc#FinancialInstrument
ex:FinancialInstrument rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000537 ;
                       rdfs:comment "Specializes the verified CCO class cco:ont00000537 (a legally-sanctioned tradeable Material Artifact) for the treasury and trade instruments in 9.7, 9.10, 9.11." ;
                       rdfs:label "Traded Financial Instrument" ;
                       skos:definition "A Financial Instrument such as a bond, currency holding, derivative, or marketable security that is held, traded, or hedged in treasury operations." .


###  http://example.org/apqc#FinancialJustification
ex:FinancialJustification rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Business case substantiating project approval in 9.4." ;
                          rdfs:label "Financial Justification" ;
                          skos:definition "A Descriptive Information Content Entity that describes the projected costs and benefits supporting or opposing a capital project or investment." .


###  http://example.org/apqc#FinancialManagementCapability
ex:FinancialManagementCapability rdf:type owl:Class ;
                                 rdfs:subClassOf cco:ont00000568 ;
                                 ex:enablesProcess ex:P10729 ,
                                                   ex:P10730 ,
                                                   ex:P10732 ,
                                                   ex:P10733 ;
                                 rdfs:comment "Process-layer 'Manage ...' standing functions (R5 capabilities) realize-in the section's acts; group modules attach realized-in restrictions to this or its specializations." ;
                                 rdfs:label "Financial Management Capability" ;
                                 skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to plan, account for, control, and report on its financial resources." .


###  http://example.org/apqc#FinancialPlan
ex:FinancialPlan rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000965 ;
                 rdfs:label "Financial Plan" ;
                 skos:definition "A Directive Information Content Entity that prescribes the financial goals and the actions intended to achieve them over a planning horizon." .


###  http://example.org/apqc#FinancialPolicy
ex:FinancialPolicy rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "General policy genus for the many 'Establish ... policies' nodes across 9.0." ;
                   rdfs:label "Financial Policy" ;
                   skos:definition "A Directive Information Content Entity that prescribes the rules governing a financial process such as budgeting, accounting, credit, or reimbursement." .


###  http://example.org/apqc#FinancialPolicyManagementCapability
ex:FinancialPolicyManagementCapability rdf:type owl:Class ;
                                       rdfs:subClassOf cco:ont00000568 ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10816
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10817
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P10818
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000054 ;
                                                         owl:someValuesFrom ex:P20604
                                                       ] ;
                                       ex:enablesProcess ex:P10816 ,
                                                         ex:P10817 ,
                                                         ex:P10818 ,
                                                         ex:P20604 ;
                                       rdfs:comment "R5/R6: APQC 9.3.1 'Manage financial policies and procedures' is a standing function (no natural end), so modeled as a capability realized in its bounded child acts. No ex:pcfID (capability, not a PCF process)." ;
                                       rdfs:label "Financial Policy Management Capability" ;
                                       skos:definition "An Organization Capability that is realized in the acts of establishing, publishing, and enforcing an organization's accounting policies and procedures." ;
                                       skos:example "A finance department's ongoing capacity to keep accounting policy current and enforced." .


###  http://example.org/apqc#FinancialProcedure
ex:FinancialProcedure rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000965 ;
                      rdfs:label "Financial Procedure" ;
                      skos:definition "A Directive Information Content Entity that prescribes the ordered steps for carrying out a financial process." .


###  http://example.org/apqc#FinancialReport
ex:FinancialReport rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "General report genus for AR/AP, profitability, treasury, and shareholder reports across 9.0." ;
                   rdfs:label "Financial Report" ;
                   skos:definition "A Descriptive Information Content Entity that presents financial data compiled for a management, shareholder, or regulatory audience." .


###  http://example.org/apqc#FinancialResultsReport
ex:FinancialResultsReport rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000853 ;
                          rdfs:comment "Output of 12.3.1 (Report financial results)." ;
                          rdfs:label "Financial Results Report" ;
                          skos:definition "A Descriptive Information Content Entity that describes an organization's financial results, including its income statement, balance sheet, and statement of cash flows." .


###  http://example.org/apqc#FinancialReview
ex:FinancialReview rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000853 ;
                   rdfs:comment "Minted: no shared-list financial ICE. Descriptive (an evaluation record)." ;
                   rdfs:label "Financial Review" ;
                   skos:definition "A Descriptive Information Content Entity that describes an evaluation of an organization's financial reports and the return on investment of a product/service." .


###  http://example.org/apqc#FinancialStatement
ex:FinancialStatement rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Financial Statement" ;
                      skos:definition "A Descriptive Information Content Entity that describes an Organization's financial position and results, comprising balance sheet, income statement, cash-flow statement, and statement of equity." ,
                                      "A Descriptive Information Content Entity that describes the financial state of an organization, including its balance sheet, income, cash flows, equity, and liquidity." .


###  http://example.org/apqc#FinishedProduct
ex:FinishedProduct rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000995 ;
                   rdfs:label "Finished Product" ;
                   skos:definition "A Material Artifact that has completed production and is ready to be tested, stored, distributed, or delivered to a customer." .


###  http://example.org/apqc#FixedAssetProjectAccountingCapability
ex:FixedAssetProjectAccountingCapability rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000568 ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P10751
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000054 ;
                                                           owl:someValuesFrom ex:P10752
                                                         ] ;
                                         ex:enablesProcess ex:P10751 ,
                                                           ex:P10752 ;
                                         rdfs:comment "Reality-layer node for APQC process group 9.4 (PCF 10731). Modeled as a standing function (R5/R6), not a bounded process: 'Manage ... project accounting' over many years has no natural end. Realized in its bounded child acts P10751 and P10752. Carries no ex:pcfID per the IRI scheme (capabilities are supporting classes)." ;
                                         rdfs:label "Fixed-Asset Project Accounting Capability" ;
                                         skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to plan, approve, and account for large capital (fixed-asset) projects over their multi-year lifecycle." ;
                                         skos:example "A corporation's standing ability to run capital-project accounting across its portfolio of multi-year investments." .


###  http://example.org/apqc#FixedAssetRegister
ex:FixedAssetRegister rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00000853 ;
                      rdfs:label "Fixed-Asset Register" ;
                      skos:definition "A Descriptive Information Content Entity that records each of an Organization's fixed assets together with its cost, useful life, depreciation, and resale value." .


###  http://example.org/apqc#FleetManagementCapability
ex:FleetManagementCapability rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000568 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty obo:BFO_0000054 ;
                                               owl:someValuesFrom ex:P10341
                                             ] ;
                             ex:enablesProcess ex:P10341 ;
                             rdfs:comment "Gate-F R5 fix for APQC 4.4.4.3 'Manage transportation fleet' [10362]: the source is a textbook STANDING administrative function with no natural end ('Taking care of a range of functions... Manage vehicle financing, maintenance, telematics, driver management, speed management, fuel management, and health and safety management'), so it is modeled as an Organization Capability rather than a bounded Planned Act -- mirroring how group 10219 is handled as ex:LogisticsManagementCapability. Realized in ex:P10341, the bounded outbound-transport operations (including fleet maintenance and telematics-monitoring acts) that exercise the fleet. The catalog node ex:PCF_10362 designates this capability per the ADR-001 R4 bridge." ;
                             rdfs:label "Fleet Management Capability" ;
                             skos:definition "An Organization Capability that inheres in a supply-chain organization in virtue of its capacity to administer the transportation vehicles used for delivering end products, covering vehicle financing, maintenance, telematics, driver, speed, fuel, and health-and-safety management." .


###  http://example.org/apqc#ForecastAccuracyAssessment
ex:ForecastAccuracyAssessment rdf:type owl:Class ;
                              rdfs:subClassOf cco:ont00000853 ;
                              rdfs:comment "Shared section-5.0 output (5.2.1.8). Descriptive: it reports a measured comparison." ;
                              rdfs:label "Forecast Accuracy Assessment" ;
                              skos:definition "A Descriptive Information Content Entity that describes a judgement of how closely a demand forecast matched realized demand." .


###  http://example.org/apqc#ForecastingMethodologyAssessment
ex:ForecastingMethodologyAssessment rdf:type owl:Class ;
                                    rdfs:subClassOf cco:ont00000853 ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cco:ont00001808 ;
                                                      owl:someValuesFrom ex:DemandForecast
                                                    ] ;
                                    rdfs:comment "Minted (D5) for the appraisal output of Evaluate and revise demand forecasting approach [10240]. Distinct from ex:DemandForecastAccuracyReport, which describes the accuracy of the forecasts themselves (output of Measure demand forecast accuracy [10241]) rather than the fitness of the forecasting METHOD. Descriptive because it represents a judgement of the methodology rather than prescribing a revised method." ;
                                    rdfs:label "Forecasting Methodology Assessment" ;
                                    skos:definition "A Descriptive Information Content Entity that describes a judgement of the fitness of an organization's demand-forecasting methodology in light of current market realities." ;
                                    skos:example "A planning lead's note that the current ARIMA model under-reacts to promotional spikes and should be reviewed." .


###  http://example.org/apqc#FraudulentClaimAssessment
ex:FraudulentClaimAssessment rdf:type owl:Class ;
                             rdfs:subClassOf cco:ont00000853 ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cco:ont00001808 ;
                                               owl:someValuesFrom ex:WarrantyClaim
                                             ] ;
                             rdfs:comment "Output of 6.5.4.5 (Investigate fraudulent claims)." ;
                             rdfs:label "Fraudulent Claim Assessment" ;
                             skos:definition "A Descriptive Information Content Entity that describes a judgement of whether a claim contains deliberately incorrect information or was submitted to deceive." .


###  http://example.org/apqc#FulfillmentPlan
ex:FulfillmentPlan rdf:type owl:Class ;
                   rdfs:subClassOf cco:ont00000965 ;
                   rdfs:comment "Output of 3.5.4.4 (determine fulfillment process). Directive (Formulation)." ;
                   rdfs:label "Order Fulfillment Plan" ;
                   skos:definition "A Directive Information Content Entity that prescribes the sequence of activities required to deliver a sales order to the customer." .


###  http://example.org/apqc#FunctionalEmployee
ex:FunctionalEmployee rdf:type owl:Class ;
                      rdfs:subClassOf cco:ont00001017 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty obo:BFO_0000196 ;
                                        owl:someValuesFrom ex:TraineeRole
                                      ] ;
                      rdfs:comment "Minted as the definitional training-recipient participant of ex:P11182 'Train and educate functional employees' (13.8.3.5), mirroring the ex:ProcessOwner pattern used by the sibling-analog ex:P16393 'Provide process training'. NOT ex:Stakeholder (an interested/affected party): the source names functional employees as the recipients." ;
                      rdfs:label "Functional Employee" ;
                      skos:definition "An Agent that bears a trainee role as a functional employee receiving an organization's training -- e.g. environmental, health, and safety training." .


###  http://example.org/apqc#FutureStateSpecification
ex:FutureStateSpecification rdf:type owl:Class ;
                            rdfs:subClassOf cco:ont00000965 ;
                            rdfs:label "Future State Specification" ;
                            skos:definition "A Directive Information Content Entity that prescribes the target state an Organization intends to reach after implementing a change, including resource requirements." .


###  http://example.org/apqc#GapAndNeedsAnalysis
ex:GapAndNeedsAnalysis rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000853 ;
                       rdfs:comment "Shared across 13.5.2.3 and the gap-analysis work in 13.6.2.4." ;
                       rdfs:label "Gap and Needs Analysis" ;
                       skos:definition "A Descriptive Information Content Entity that describes the gaps and needs identified by comparing actual performance or capability against a desired or standard reference." .


###  http://example.org/apqc#GeneralLedger
ex:GeneralLedger rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000853 ;
                 rdfs:label "General Ledger" ;
                 skos:definition "A Descriptive Information Content Entity that records, by account, the complete set of an Organization's financial transactions for an accounting period." .


###  http://example.org/apqc#GoNoGoDecision
ex:GoNoGoDecision rdf:type owl:Class ;
