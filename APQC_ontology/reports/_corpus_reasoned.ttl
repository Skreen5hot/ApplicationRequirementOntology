###  http://example.org/apqc#PCF_19698
ex:PCF_19698 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying and describing new product or service thoughts based on organizational objectives/targets." ;
             ex:designatesProcessType ex:P19698 ;
