  "diagnostics": [
    {
      "@id": "diag:t:1",
      "@type": "MissingInformation",
      "blocking": true,
      "statement": "The section contains no normative statements (shall, must, will, required, may not, should) and no plain statements of system behaviour; there are therefore no obligations, prohibitions, permissions, or recommendations that can be asserted as Requirements, AcceptanceClauses, or Constraints.",
      "evidence": [
