###  http://example.org/apqc#PCF_21600
ex:PCF_21600 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Providing support for sustainability activities. Augment functional units and support teams with coaching, mentoring, and SME capacity to perform sustainability projects and activities." ;
             ex:designatesProcessType ex:P21600 ;
             ex:hierarchyID "13.9.2.2" ;
             ex:pcfID "21600" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_21598 ;
             skos:inScheme apqc:PCF ;
