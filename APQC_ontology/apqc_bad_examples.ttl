@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix ex:   <https://fandaws.com/ontology/apqc#> .

# Reused good fillers (minimal declarations)
ex:CompetitorAnalysis a owl:Class ; rdfs:subClassOf cco:ont00000853 .
ex:CompetitorRole     a owl:Class ; rdfs:subClassOf obo:BFO_0000023 .
ex:CompetitorData     a owl:Class ; rdfs:subClassOf cco:ont00000853 .
ex:Competitor         a owl:Class ; rdfs:subClassOf cco:ont00001180 .

# V-S2: a process with NO CCO Act anchor (+ V-S1: no label/def/pcfID)
ex:OrphanProcess a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom ex:CompetitorAnalysis ] .

# V-S6: a process subclassed UNDER another process (taxonomy-from-partonomy error)
ex:GoodAnchorProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom ex:CompetitorAnalysis ] ;
    rdfs:label "anchor proc" ; skos:definition "x" ; ex:pcfID "1" ; skos:example "e" .
ex:BadSubsumedProcess a owl:Class ;
    rdfs:subClassOf ex:GoodAnchorProcess ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom ex:CompetitorAnalysis ] ;
    rdfs:label "bad sub" ; skos:definition "x" ; ex:pcfID "2" ; skos:example "e" .

# V-S3: has output filler is a Role, not an ICE
ex:BadOutputProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom ex:CompetitorRole ] ;
    rdfs:label "bad out" ; skos:definition "x" ; ex:pcfID "3" ; skos:example "e" .

# V-S5: has process part filler is Data (not a process)
ex:BadWholeProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001777 ; owl:someValuesFrom ex:CompetitorData ] ;
    rdfs:label "bad whole" ; skos:definition "x" ; ex:pcfID "4" ; skos:example "e" .

# V-S7: an ICE class that bears a Role
ex:RoleBearingICE a owl:Class ;
    rdfs:subClassOf cco:ont00000853 ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom ex:CompetitorRole ] .

# V-S8: a process (non-ICE) carrying an 'is about' restriction
ex:AboutOnProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom ex:CompetitorAnalysis ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom ex:Competitor ] ;
    rdfs:label "about proc" ; skos:definition "x" ; ex:pcfID "5" ; skos:example "e" .

# W-S4: has input filler is neither ICE nor material entity (a Role)
ex:WeirdInputProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom ex:CompetitorRole ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom ex:CompetitorAnalysis ] ;
    rdfs:label "weird in" ; skos:definition "x" ; ex:pcfID "6" ; skos:example "e" .

# ---------------------------------------------------------------------
# capabilities_roles_shapes.ttl (C1-C7)
#
# Added when BFO and CCO were vendored. Until then that shape set could
# not be evaluated at all, so the absence of a fixture behind it did not
# show; the moment it became evaluable it reported zero violations
# against the corpus, and zero from a constraint that selects nothing
# looks exactly like zero from data that is clean.
#
# Every case below names the constraint it is built to break. The
# positive controls are here for the same reason: a fixture where
# everything violates cannot show that a constraint discriminates.
#
# These are read with the fixture loaded ALONE, so each class states the
# subClassOf edge it needs rather than inheriting it from the corpus.

# -- C1: capability must reach cco:ont00001379, and be labelled --------

ex:Capability a owl:Class ;
    rdfs:label "Capability" ; skos:definition "local anchor" .

# C1-a: declared a capability, reaches no CCO anchor.
ex:UnanchoredCapability a owl:Class ;
    rdfs:subClassOf ex:Capability ;
    rdfs:label "unanchored cap" ; skos:definition "x" .

# C1-b: anchored, but carries neither label nor definition.
ex:UnlabelledCapability a owl:Class ;
    rdfs:subClassOf ex:Capability , cco:ont00001379 .

# C1-positive: anchored and labelled. Must NOT violate C1.
ex:GoodCapability a owl:Class ;
    rdfs:subClassOf ex:Capability , cco:ont00001379 ;
    rdfs:label "good cap" ; skos:definition "x" .

# -- C2: role must reach bfo:Role, and be labelled ---------------------

ex:Role a owl:Class ;
    rdfs:label "Role" ; skos:definition "local anchor" .

# C2-a: declared a role, reaches no BFO anchor.
ex:UnanchoredRole a owl:Class ;
    rdfs:subClassOf ex:Role ;
    rdfs:label "unanchored role" ; skos:definition "x" .

# C2-b: anchored, unlabelled.
ex:UnlabelledRole a owl:Class ;
    rdfs:subClassOf ex:Role , obo:BFO_0000023 .

# C2-positive: anchored and labelled. Must NOT violate C2.
ex:GoodRole a owl:Class ;
    rdfs:subClassOf ex:Role , obo:BFO_0000023 ;
    rdfs:label "good role" ; skos:definition "x" .

# -- C3: nothing is both a capability and a role -----------------------

ex:ConfusedCapabilityRole a owl:Class ;
    rdfs:subClassOf ex:Capability , cco:ont00001379 , obo:BFO_0000023 ;
    rdfs:label "both at once" ; skos:definition "x" .

# -- C4/C7: permission targets must reach cco:ont00000751 --------------

ex:GoodPermission a owl:Class ;
    rdfs:subClassOf cco:ont00000751 ;
    rdfs:label "good permission" ; skos:definition "x" .

ex:NotAPermission a owl:Class ;
    rdfs:subClassOf cco:ont00000853 ;
    rdfs:label "not a permission" ; skos:definition "x" .

ex:PermissionBearer a owl:Class ;
    rdfs:subClassOf cco:ont00001180 ;
    rdfs:label "bearer" ; skos:definition "x" ;
    ex:bearsPermission ex:NotAPermission ,   # C4-a: violates
                       ex:GoodPermission .   # C4-positive: must not

# -- C5/C6/C7: the requires* edges point at the wrong kind of thing ----

ex:MiswiredProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom ex:CompetitorAnalysis ] ;
    rdfs:label "miswired proc" ; skos:definition "x" ; ex:pcfID "7" ; skos:example "e" ;
    ex:requiresCapability ex:UnanchoredCapability ,  # C5-a: violates
                          ex:GoodCapability ;        # C5-positive
    ex:requiresRole       ex:UnanchoredRole ,        # C6-a: violates
                          ex:GoodRole ;              # C6-positive
    ex:requiresPermission ex:NotAPermission ,        # C7-a: violates
                          ex:GoodPermission .        # C7-positive
