###  http://example.org/apqc#P10751
ex:P10751 rdf:type owl:Class ;
          rdfs:subClassOf ex:ActOfReporting ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10844
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty cco:ont00001777 ;
                            owl:someValuesFrom ex:P10845
                          ] ,
