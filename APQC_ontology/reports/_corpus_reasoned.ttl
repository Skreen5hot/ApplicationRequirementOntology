###  http://example.org/apqc#PCF_17060
ex:PCF_17060 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating requisite frameworks and coordinating all risk management activities for the entire organization and each function. Manage the enterprise risk by outlining the risk policies and procedures. Monitor and communicate all risk management activities. Encourage correspondence among the business units. Manage the risk of all business units and functions." ;
             ex:designatesProcessType ex:P17060 ;
             ex:hierarchyID "11.1" ;
             ex:pcfID "17060" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_16437 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage enterprise risk" .


###  http://example.org/apqc#PCF_17389
ex:PCF_17389 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing areas of growth and further development of product/service mix, customization, market based changes, etc., to further demonstrate value to the customer in the competition." ;
             ex:designatesProcessType ex:P17389 ;
             ex:hierarchyID "2.2.3.3" ;
             ex:pcfID "17389" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19990 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify product/service bundling opportunities" .


###  http://example.org/apqc#PCF_17462
ex:PCF_17462 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing the threats a business unit/function faces to prioritize the controls it implements.. " ;
             ex:designatesProcessType ex:P17462 ;
             ex:hierarchyID "11.1.3" ;
             ex:pcfID "17462" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17060 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage business unit and function risk" .


###  http://example.org/apqc#PCF_17467
ex:PCF_17467 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing steps to confirm enduring compliance to industry regulations and government legislation." ;
             ex:designatesProcessType ex:ComplianceManagementCapability ;
             ex:hierarchyID "11.2" ;
             ex:pcfID "17467" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_16437 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage compliance" .


###  http://example.org/apqc#PCF_17468
ex:PCF_17468 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing a set of procedures detailing an organization's progress in complying with established guidelines, provisions, and legislation." ;
             ex:designatesProcessType ex:P17468 ;
             ex:hierarchyID "11.2.1" ;
             ex:pcfID "17468" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17467 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish compliance framework and policies" .


###  http://example.org/apqc#PCF_17469
ex:PCF_17469 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating a standardized approach to ethics and compliance. Have a programmatic approach for compliance that focuses on the definite risks the organization faces." ;
             ex:designatesProcessType ex:P17469 ;
             ex:hierarchyID "11.2.1.1" ;
             ex:pcfID "17469" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17468 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop enterprise compliance policies and procedures" .


###  http://example.org/apqc#PCF_17470
ex:PCF_17470 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Implementing standardized for ethics and compliance. Have a programmatic approach, built from the top down, to enterprise compliance that focuses on the definite risks the organization faces." ;
             ex:designatesProcessType ex:P17470 ;
             ex:hierarchyID "11.2.1.2" ;
             ex:pcfID "17470" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17468 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Implement enterprise compliance activities" .


###  http://example.org/apqc#PCF_17471
ex:PCF_17471 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Managing organizational attributes that are closely associated with the quality of output. Determine the quality requirements. Evaluate the correspondence between the quality performance and requirements. Manage non-conformance activities. Ensure implementation and maintenance of the enterprise quality management system. " ;
             ex:designatesProcessType ex:P17471 ;
             ex:hierarchyID "13.3" ;
             ex:pcfID "17471" ;
             rdfs:comment "APQC level: ProcessGroup" ;
             skos:broader ex:PCF_10013 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage enterprise quality" .


###  http://example.org/apqc#PCF_17472
ex:PCF_17472 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining essential activities, processes, and attributes for securing enterprise quality. Outline critical characteristics for quality. Outline activities encouraging the preservation of quality. Create quality controls. Confirm capabilities in accordance with quality requirements. Finalize the plan for quality maintenance." ;
             ex:designatesProcessType ex:P17472 ;
             ex:hierarchyID "13.3.1" ;
             ex:pcfID "17472" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17471 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish quality requirements" .


###  http://example.org/apqc#PCF_17473
ex:PCF_17473 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining characteristics crucial for managing enterprise quality. Translate broad customer needs into specific, actionable, measurable performance requirements. Define the key measurable characteristics of key products and processes." ;
             ex:designatesProcessType ex:P17473 ;
             ex:hierarchyID "13.3.1.1" ;
             ex:pcfID "17473" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17472 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define critical-to-quality characteristics" .


###  http://example.org/apqc#PCF_17474
ex:PCF_17474 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Identifying gaps in customer requirements and determining whether the gap will be mitigated through preventive Quality activities or deemed as acceptable risk. The goal of any preventive quality activities is to create provisions to prevent, control, or reduce the risk of not meeting the CtQCs. In addition, any standard methodology that will be used to design or conduct preventive Quality activities are defined and documented." ;
             ex:designatesProcessType ex:P17474 ;
             ex:hierarchyID "13.3.1.2" ;
             ex:pcfID "17474" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17472 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define preventive quality activities" .


###  http://example.org/apqc#PCF_17475
ex:PCF_17475 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Developing controls for managing the quality of enterprise. Define the process steps for quality controls and the sampling plan. Identify the tools and methods to measure quality. Define the competencies required. " ;
             ex:designatesProcessType ex:P17475 ;
             ex:hierarchyID "13.3.1.3" ;
             ex:pcfID "17475" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17472 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop quality controls" .


###  http://example.org/apqc#PCF_17476
ex:PCF_17476 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing the steps for developing quality controls. Conduct Alpha testing. Have the product team conduct rework. Send the product/service for Beta testing, and carry on rework as needed." ;
             ex:designatesProcessType ex:P17476 ;
             ex:hierarchyID "13.3.1.3.1" ;
             ex:pcfID "17476" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17475 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define process steps for controls (or integration points)" .


###  http://example.org/apqc#PCF_17477
ex:PCF_17477 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing a detailed summary including measures, on which material, in what manner, and by whom. Identify the parameters to be measured, the range of possible values, and the required resolution. Provide a sampling scheme that details how and when samples will be taken. Select sample sizes. Assign roles and responsibilities." ;
             ex:designatesProcessType ex:P17477 ;
             ex:hierarchyID "13.3.1.3.2" ;
             ex:pcfID "17477" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17475 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define sampling plan" .


###  http://example.org/apqc#PCF_17478
ex:PCF_17478 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Using tools to measure quality. Use tools such as quality improvement oversight system tool, performance measurement tools, consumer information models/guides, and validation tools to effectively determine the quality levels." ;
             ex:designatesProcessType ex:P17478 ;
             ex:hierarchyID "13.3.1.3.3" ;
             ex:pcfID "17478" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17475 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify measurement methods" .


###  http://example.org/apqc#PCF_17479
ex:PCF_17479 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Defining the competencies required for developing quality controls. Define the required competencies including compliance management, audit management, and document control and document management." ;
             ex:designatesProcessType ex:P17479 ;
             ex:hierarchyID "13.3.1.3.4" ;
             ex:pcfID "17479" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17475 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define required competencies" .


###  http://example.org/apqc#PCF_17480
ex:PCF_17480 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Demonstrating the ability and capability to confirm and fulfill the quality requirements in front of customers, managers, employees, board members, associations, regulatory bodies, and creditors. Leverage tools and techniques such as process behavior or control charts, statistical process control, measurement system analysis, gage calibration management, and process capability analysis." ;
             ex:designatesProcessType ex:P17480 ;
             ex:hierarchyID "13.3.1.4" ;
             ex:pcfID "17480" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17472 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Prove capability to assess compliance with requirements" .


###  http://example.org/apqc#PCF_17481
ex:PCF_17481 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing how the critical-to-quality characteristics will be achieved, controlled, ensured, and managed throughout the lifecycle of a product/service. Address quality requirements and critical-to-quality characteristics. Conduct a preventive quality assessment. Describe how to verify the product/service, verification criteria, and response to nonconformance. Keep records to demonstrate conformity." ;
             ex:designatesProcessType ex:P17481 ;
             ex:hierarchyID "13.3.1.5" ;
             ex:pcfID "17481" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17472 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Finalize quality plan" .


###  http://example.org/apqc#PCF_17482
ex:PCF_17482 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing if the performance of the quality plan has achieved the estimated and desired requirements. Conduct tests against the quality plan. Assess the results of these tests." ;
             ex:designatesProcessType ex:P17482 ;
             ex:hierarchyID "13.3.2" ;
             ex:pcfID "17482" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17471 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Evaluate performance to requirements" .


###  http://example.org/apqc#PCF_17483
ex:PCF_17483 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Examining the quality of organizational processes. Conduct tests. Collect information and data. Record the results of these tests. Determine the dispositions of the test results." ;
             ex:designatesProcessType ex:P17483 ;
             ex:hierarchyID "13.3.2.1" ;
             ex:pcfID "17483" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17482 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Test against quality plan" .


###  http://example.org/apqc#PCF_17484
ex:PCF_17484 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating quality performance through periodic or episodic testing against the established standards for quality characteristics. For periodic testing, design a schedule with sufficient time to make any required adjustments to the process or system to maintain the desired level of quality. For episodic testing, conduct a test whenever a known non-conformance or fault occurs, which results in outputs or outcomes known to be unsatisfactory to performance requirements." ;
             ex:designatesProcessType ex:P17484 ;
             ex:hierarchyID "13.3.2.1.1" ;
             ex:pcfID "17484" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17483 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Conduct test and collect data" .


###  http://example.org/apqc#PCF_17485
ex:PCF_17485 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Maintaining and recording the results of Test against the quality plan [17483] electronically and in standard formats. Assign ownership to a designated function or role. " ;
             ex:designatesProcessType ex:P17485 ;
             ex:hierarchyID "13.3.2.1.2" ;
             ex:pcfID "17485" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17483 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Record result(s)" .


###  http://example.org/apqc#PCF_17486
ex:PCF_17486 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Deciding whether to take any additional actions based on the results of quality tests. Initiate a quarantine disposition and relocated inventory, scrap workflow item and scrap transaction, rework operation, net-able and nonnet-able items, and the activity list." ;
             ex:designatesProcessType ex:P17486 ;
             ex:hierarchyID "13.3.2.1.3" ;
             ex:pcfID "17486" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17483 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine disposition of result(s)" .


###  http://example.org/apqc#PCF_17487
ex:PCF_17487 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the significance of the sample. Summarize the results of the test. Recommend improvement actions. Decide what steps to take next." ;
             ex:designatesProcessType ex:P17487 ;
             ex:hierarchyID "13.3.2.2" ;
             ex:pcfID "17487" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17482 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess results of tests" .


###  http://example.org/apqc#PCF_17488
ex:PCF_17488 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assessing the significance of the sample chosen for the test in order to determine whether or not the sample is representative of the larger output or outcome. Determine if the sample meets or does not meet the requirements. Identify the conditions for acceptance, rejection, remediation, and prevention." ;
             ex:designatesProcessType ex:P17488 ;
             ex:hierarchyID "13.3.2.2.1" ;
             ex:pcfID "17488" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17487 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess sample significance" .


###  http://example.org/apqc#PCF_17489
ex:PCF_17489 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the major facts and figures of the quality test results in order to provide insights and information. Use charts, tables, statistical test results, and written findings and conclusions in a summary of results." ;
             ex:designatesProcessType ex:P17489 ;
             ex:hierarchyID "13.3.2.2.2" ;
             ex:pcfID "17489" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17487 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Summarize result(s)" .


###  http://example.org/apqc#PCF_17490
ex:PCF_17490 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recommending measures for improvement. Assess the summarized results to identify areas which can be improved. Suggest actions to management for improving the quality plan basis on the results of the tests." ;
             ex:designatesProcessType ex:P17490 ;
             ex:hierarchyID "13.3.2.2.3" ;
             ex:pcfID "17490" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17487 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Recommend actions" .


###  http://example.org/apqc#PCF_17491
ex:PCF_17491 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Selecting the subsequent actions that the organization can adopt for improving the enterprise quality. Select measures and recommended actions for managing the enterprise quality." ;
             ex:designatesProcessType ex:P17491 ;
             ex:hierarchyID "13.3.2.2.4" ;
             ex:pcfID "17491" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17487 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Decide next steps" .


###  http://example.org/apqc#PCF_17492
ex:PCF_17492 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handling any nonconformance activities or events. Assess the potential impact of the nonconformity. Decide the immediate actions to take. Identify the root causes. Take corrective or preventive action. Ensure future conformance." ;
             ex:designatesProcessType ex:P17492 ;
             ex:hierarchyID "13.3.3" ;
             ex:pcfID "17492" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17471 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage non-conformance" .


###  http://example.org/apqc#PCF_17493
ex:PCF_17493 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing any nonconformance events. Determine the need for corrective and/or preventative action(s). Leverage root-cause analysis, risk exposure, and other evaluations to properly review and approve/reject subsequent actions." ;
             ex:designatesProcessType ex:P17493 ;
             ex:hierarchyID "13.3.3.1" ;
             ex:pcfID "17493" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17492 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess potential impact" .


###  http://example.org/apqc#PCF_17494
ex:PCF_17494 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Initiating immediate corrective, preventative, or no action based upon the impact and likelihood of reoccurrence. Consider cost/benefit, risk exposure, timing, the assignment of responsibility, and other pertinent factors ." ;
             ex:designatesProcessType ex:P17494 ;
             ex:hierarchyID "13.3.3.2" ;
             ex:pcfID "17494" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17492 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine immediate action(s)" .


###  http://example.org/apqc#PCF_17495
ex:PCF_17495 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing the reasons that have triggered the nonconformance events or activities. Perform a root-cause analysis through documentary evidence and interviews. Involve the appropriate individuals. Leverage cause analysis and risk assessment." ;
             ex:designatesProcessType ex:P17495 ;
             ex:hierarchyID "13.3.3.3" ;
             ex:pcfID "17495" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17492 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify root cause(s)" .


###  http://example.org/apqc#PCF_17496
ex:PCF_17496 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Pursuing corrective and preventative activities to eliminate the cause of a detected nonconformity. Define the nonconformity. Communicate and assign responsibility. Identify the appropriate corrective and preventive action. Implement and monitor for reoccurrence. " ;
             ex:designatesProcessType ex:P17496 ;
             ex:hierarchyID "13.3.3.4" ;
             ex:pcfID "17496" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17492 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Take corrective or preventative action" .


###  http://example.org/apqc#PCF_17497
ex:PCF_17497 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Closing nonconformance. Perform all the final processes related to the nonconformance, including documenting root causes. Document corrective and preventive actions." ;
             ex:designatesProcessType ex:P17497 ;
             ex:hierarchyID "13.3.3.5" ;
             ex:pcfID "17497" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17492 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Close non-conformance" .


###  http://example.org/apqc#PCF_17498
ex:PCF_17498 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and administering the software that manages content and business processes for quality and compliance across the value chain. Define the quality strategy. Plan and deploy the EQMS scope, targets, and goals. Identify core process controls and metric. Develop EQMS governance. Assess the performance of EQMS. Encourage improvements in EQMS." ;
             ex:designatesProcessType ex:P17498 ;
             ex:hierarchyID "13.3.4" ;
             ex:pcfID "17498" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_17471 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Implement and maintain the enterprise quality management system (EQMS)" .


###  http://example.org/apqc#PCF_17499
ex:PCF_17499 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Outlining the strategy for managing enterprise quality. Define and formalize quality techniques and standards. Assign responsibilities for achieving the required quality levels. Standardize the quality maintenance procedure, tools and techniques, recording and reporting, the timing of quality maintenance activities, and the roles and responsibilities for the quality management team." ;
             ex:designatesProcessType ex:P17499 ;
             ex:hierarchyID "13.3.4.1" ;
             ex:pcfID "17499" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17498 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define the quality strategy" .


###  http://example.org/apqc#PCF_17500
ex:PCF_17500 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and effectively deploying the scope, targets, and goals of EQMS. Define the role of EQMS through nonconformance/corrective and preventive action, compliance/audit management, risk management, failure mode and effects analysis, and statistical process control. Implement EQMS into operational activities. Define the goals and objectives that are to be achieved by the EQMS." ;
             ex:designatesProcessType ex:P17500 ;
             ex:hierarchyID "13.3.4.2" ;
             ex:pcfID "17500" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17498 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Plan and deploy the EQMS scope, targets, and goals" .


###  http://example.org/apqc#PCF_17501
ex:PCF_17501 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recognizing and implementing the processes, controls, and metrics for maintenance of EQMS. Define the role of EQMS in failure mode and effects analysis, complaint handling, and advanced product quality planning. Establish the role of EQMS in evaluating metrics such as cost of quality, overall equipment effectiveness, on-time and complete shipments, percentage of products in compliance, and new product introductions." ;
             ex:designatesProcessType ex:P17501 ;
             ex:hierarchyID "13.3.4.3" ;
             ex:pcfID "17501" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17498 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify core EQMS processes, controls, and metrics" .


###  http://example.org/apqc#PCF_17502
ex:PCF_17502 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Setting the process limits. Gather required information. Align with other documents and processes. Define the document structure." ;
             ex:designatesProcessType ex:P17502 ;
             ex:hierarchyID "13.3.4.4" ;
             ex:pcfID "17502" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17498 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop and document EQMS policies, procedures, standards, and measures" .


###  http://example.org/apqc#PCF_17503
ex:PCF_17503 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Benchmarking current performance in quality metrics that span across the value chain. Identify gaps in performance as compared to industry peers. Identify and implement complementary EQMS capabilities. Enable a continuous improvement environment." ;
             ex:designatesProcessType ex:P17503 ;
             ex:hierarchyID "13.3.4.5" ;
             ex:pcfID "17503" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17498 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess the EQMS performance" .


###  http://example.org/apqc#PCF_17504
ex:PCF_17504 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Rewarding excellence in quality. Create and maintain quality partnerships. Maintain talent capabilities and competencies. Incorporate EQMS messaging into communication channels. Transfer proven EQMS methods. Consider factors such as EQMS reviews and gap assessments and the alignment and compatibility of business processes and quality. Adopt Lean principles. " ;
             ex:designatesProcessType ex:P17504 ;
             ex:hierarchyID "13.3.4.6" ;
             ex:pcfID "17504" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_17498 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create environment and capability for EQMS improvement(s)" .


###  http://example.org/apqc#PCF_17505
ex:PCF_17505 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Provisioning rewards for achieving quality excellence. Provide monetary and nonmonetary rewards such as compensation, vacations, gift cards, and reimbursements to employees in in recognition of their services, efforts, and achievements in quality excellence." ;
             ex:designatesProcessType ex:P17505 ;
             ex:hierarchyID "13.3.4.6.1" ;
             ex:pcfID "17505" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17504 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Reward quality excellence" .


###  http://example.org/apqc#PCF_17506
ex:PCF_17506 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing and maintaining partnerships with third-party sources to achieve quality excellence. Source and evaluate third-party sources both public and private to ensure that the most effective and efficient partnerships are formed." ;
             ex:designatesProcessType ex:P17506 ;
             ex:hierarchyID "13.3.4.6.2" ;
             ex:pcfID "17506" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17504 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Create and maintain quality partnerships" .


###  http://example.org/apqc#PCF_17507
ex:PCF_17507 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Maintaining a common denominator for the competency level within the organization's talent circle. Conduct training sessions, skill development activities, and quality excellence activities to ensure that the resources of the organization are competent enough and have the capabilities to achieve the required level of quality." ;
             ex:designatesProcessType ex:P17507 ;
             ex:hierarchyID "13.3.4.6.3" ;
             ex:pcfID "17507" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17504 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Maintain talent capabilities and competencies" .


###  http://example.org/apqc#PCF_17508
ex:PCF_17508 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Assimilating all the communication related to the EQMS into the organization's already established communication channels. " ;
             ex:designatesProcessType ex:P17508 ;
             ex:hierarchyID "13.3.4.6.4" ;
             ex:pcfID "17508" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17504 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Incorporate EQMS messaging into communication channels" .


###  http://example.org/apqc#PCF_17509
ex:PCF_17509 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Ensuring EQMS access to the person in charge of the quality management process. Establish who has the authority to manage the EQMS. Ensure access of EQMS to only the person(s) in authority. " ;
             ex:designatesProcessType ex:P17509 ;
             ex:hierarchyID "13.3.4.6.5" ;
             ex:pcfID "17509" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17504 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assure independent EQMS management access to appropriate authority in the organization" .


###  http://example.org/apqc#PCF_17510
ex:PCF_17510 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Recording and transferring the best practices and proven methods associated with enterprise quality management systems (EQMS) that can be leveraged in improving the organization's framework. Record proven methodologies and approaches with the objective of communicating them for upgrading, refining, and enhancing the organization's systems." ;
             ex:designatesProcessType ex:P17510 ;
             ex:hierarchyID "13.3.4.6.6" ;
             ex:pcfID "17510" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_17504 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Transfer proven EQMS methods" .


###  http://example.org/apqc#PCF_17682
ex:PCF_17682 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining the percentage of total sales volume in the market for a particular product." ;
             ex:designatesProcessType ex:P17682 ;
             ex:hierarchyID "3.4.3.1" ;
             ex:pcfID "17682" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10131 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Calculate product market share" .


###  http://example.org/apqc#PCF_17683
ex:PCF_17683 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Estimating how much profit the company would generate for its expenses on marketing . Forecasted return on investment, used as a metric to gauge the efficiency of marketing, is beneficial in revising marketing budgets and adjusting costs to improve the overall yield. " ;
             ex:designatesProcessType ex:P17683 ;
             ex:hierarchyID "3.3.2.4" ;
             ex:pcfID "17683" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10149 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine projected ROI for marketing investment" .


###  http://example.org/apqc#PCF_17684
ex:PCF_17684 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Obtaining internal price approvals and governmental approvals that are required for licensed products and for products that can be reimbursed by the government." ;
             ex:designatesProcessType ex:P17684 ;
             ex:hierarchyID "3.3.3.10" ;
             ex:pcfID "17684" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20593 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Achieve regulatory approval for pricing" .


###  http://example.org/apqc#PCF_18083
ex:PCF_18083 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Supporting the design, manufacture and distribution of product and services through the extended enterprise model.  This is concerned with the strategic decisions on make vs buy, in house or out sourced.  Senior Executives map out how they want to run their business.  Make strategic choices as to whether to buy in components / sub-assemblies, run their own distribution fleet or contract out, own their dealerships or franchise out, etc.  Strategize with partnerships. Collaborate design consideration at strategy level for automotive and procurement act within the Target Operating Model set at strategy level." ;
             ex:designatesProcessType ex:P18083 ;
             ex:hierarchyID "1.2.2.1.1" ;
             ex:pcfID "18083" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10047 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Select partnerships and relationships to support the extended enterprise" .


###  http://example.org/apqc#PCF_18115
ex:PCF_18115 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Reviewing the set of potential customers and sales opportunities. Approve the leads that meet company requirements on new businesses." ;
             ex:designatesProcessType ex:P18115 ;
             ex:hierarchyID "3.5.1.3" ;
             ex:pcfID "18115" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10182 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Validate and qualify leads/opportunities" .


###  http://example.org/apqc#PCF_18116
ex:PCF_18116 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating plans about how to close leads and win sales opportunities. " ;
             ex:designatesProcessType ex:P18116 ;
             ex:hierarchyID "3.5.1.5" ;
             ex:pcfID "18116" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10182 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Develop opportunity win plans" .


###  http://example.org/apqc#PCF_18126
ex:PCF_18126 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Handing over data to management to analyze common issues in regards to customer service." ;
             ex:designatesProcessType ex:P18126 ;
             ex:hierarchyID "6.5.1.3" ;
             ex:pcfID "18126" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10401 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide customer feedback to product management on customer service experience" .


###  http://example.org/apqc#PCF_18129
ex:PCF_18129 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Evaluating the changing needs for insurance coverage. Research available insurance providers and offerings. " ;
             ex:designatesProcessType ex:P18129 ;
             ex:hierarchyID "11.1.3.3.1" ;
             ex:pcfID "18129" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_16458 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Assess adequacy of insurance coverage" .


###  http://example.org/apqc#PCF_18130
ex:PCF_18130 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Authoring or overseeing the creation of the textual portion of a product description, advertisement, or web page, including the headline, body, product attributes, and brand or advertiser information. A copy is designed to provide information about the product and to catch and hold the interest of prospective buyers long enough to persuade them to make a purchase. The copy of a website is called its content. " ;
             ex:designatesProcessType ex:P18130 ;
             ex:hierarchyID "3.3.9.2" ;
             ex:pcfID "18130" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16629 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage product copy" .


###  http://example.org/apqc#PCF_18592
ex:PCF_18592 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Monitoring assets against their planned useful life. Each asset may have specific criteria that indicate their usability. This may include time-based, maintenance history, capacity planning, etc." ;
             ex:designatesProcessType ex:P18592 ;
             ex:hierarchyID "10.4.1.1" ;
             ex:pcfID "18592" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10952 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor useful life of assets" .


###  http://example.org/apqc#PCF_18627
ex:PCF_18627 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing standardized procedures for effective communication that maximizes ROI, promotes brand awareness and respects customers. In its simplest form, it includes a message (what is to be said), a target (to whom the message is reaching) and a medium or a channel (where the message is to be said)." ;
             ex:designatesProcessType ex:P18627 ;
             ex:hierarchyID "3.2.5.8" ;
             ex:pcfID "18627" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_16848 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define communication guidelines and mechanisms" .


###  http://example.org/apqc#PCF_18629
ex:PCF_18629 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Setting up strategic alliances with key trade partners and ratifying partnership agreements." ;
             ex:designatesProcessType ex:P18629 ;
             ex:hierarchyID "3.4.2.9" ;
             ex:pcfID "18629" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10130 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Establish partner and alliance agreements" .


###  http://example.org/apqc#PCF_18641
ex:PCF_18641 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Distributing marketing materials and sales brochures to entities that the company partners with." ;
             ex:designatesProcessType ex:P18641 ;
             ex:hierarchyID "3.5.5.2" ;
             ex:pcfID "18641" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10187 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Provide marketing materials to sales partners/alliances" .


###  http://example.org/apqc#PCF_18916
ex:PCF_18916 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Conveying planned procedures and methods to both internal departments and external stakeholders like customers, suppliers, etc., in an effective manner based on organizational objective." ;
             ex:designatesProcessType ex:P18916 ;
             ex:hierarchyID "1.2.9" ;
             ex:pcfID "18916" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10015 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Communicate strategies internally and externally" .


###  http://example.org/apqc#PCF_18924
ex:PCF_18924 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Creating and managing a customer loyalty program. The loyalty program is a key part of marketing, with an elaborate strategy and process for acquiring, retaining, and engaging with members. Members are engaged and acquainted to the loyalty program, thus growing relationship and adding value through the program. " ;
             ex:designatesProcessType ex:P18924 ;
             ex:hierarchyID "3.2.6" ;
             ex:pcfID "18924" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_10102 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Design and manage customer loyalty program" .


###  http://example.org/apqc#PCF_18925
ex:PCF_18925 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Convincing customers to register their personal information with the company and be assigned a unique identifier that they use when making purchases. The identifier makes it easier for the company to track customer purchases. Customers are rewarded by various incentives that encourage repeat business [20007]. " ;
             ex:designatesProcessType ex:P18925 ;
             ex:hierarchyID "3.2.6.2" ;
             ex:pcfID "18925" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_18924 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Acquire members to customer loyalty program" .


###  http://example.org/apqc#PCF_18926
ex:PCF_18926 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Building deeper relationships between a customer and a brand in order to promote customer loyalty and derive repeat business. Besides making frequent purchases, highly engaged customers refer family, friends and colleagues to make purchases as well, consume and re-broadcast promotional materials, provide feedback to the purchases they make and do not support competing brands." ;
             ex:designatesProcessType ex:P18926 ;
             ex:hierarchyID "3.2.6.3" ;
             ex:pcfID "18926" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_18924 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Build engagement and relationship with members" .


###  http://example.org/apqc#PCF_18927
ex:PCF_18927 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Enhancing the customer loyalty program so that it will yield maximum value both for the company and for the patrons enrolled in the program, increasing customer retention and continued engagement." ;
             ex:designatesProcessType ex:P18927 ;
             ex:hierarchyID "3.2.6.5" ;
             ex:pcfID "18927" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_18924 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Optimize loyalty program value to both the enterprise and the customer" .


###  http://example.org/apqc#PCF_18941
ex:PCF_18941 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Determining which groups of potential customers do not yet, or already do have access to the product or a service that the company produces or markets. Use those findings to create specialized product offerings and differentiated marketing campaigns." ;
             ex:designatesProcessType ex:P18941 ;
             ex:hierarchyID "3.1.2.2.1" ;
             ex:pcfID "18941" ;
             rdfs:comment "APQC level: Task" ;
             skos:broader ex:PCF_10117 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Identify under-served and saturated market segments" .


###  http://example.org/apqc#PCF_18948
ex:PCF_18948 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Introducing financial inducements, such as discounts, to distributors, resellers or vendors as a motivation to prioritize selling company's products or services over those of its competitors." ;
             ex:designatesProcessType ex:P18948 ;
             ex:hierarchyID "3.3.3.2" ;
             ex:pcfID "18948" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_20593 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Determine corporate incentives" .


###  http://example.org/apqc#PCF_19072
ex:PCF_19072 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Analyzing complaint logs to provide input for continuous service improvement and customer profiling." ;
             ex:designatesProcessType ex:P19072 ;
             ex:hierarchyID "6.2.3.5" ;
             ex:pcfID "19072" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_10389 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Analyze customer complaints and response/redressal" .


###  http://example.org/apqc#PCF_19207
ex:PCF_19207 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Relating to the design, construction, acquisition, and management of both productive and non-productive assets." ;
             ex:hierarchyID "10.0" ;
             ex:pcfID "19207" ;
             rdfs:comment "APQC level: Category" ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Acquire, Construct, and Manage Assets" .


###  http://example.org/apqc#PCF_19209
ex:PCF_19209 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Producing and maintaining a planning schedule and a financial plan to purchase or manufacture productive assets. Determine the investment plan, monitor capital, and secure the necessary financing in order to realize completion of the program." ;
             ex:designatesProcessType ex:P19209 ;
             ex:hierarchyID "10.2.1" ;
             ex:pcfID "19209" ;
             rdfs:comment "APQC level: Process" ;
             skos:broader ex:PCF_21575 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Manage capital program for assets" .


###  http://example.org/apqc#PCF_19210
ex:PCF_19210 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Establishing what funds will be invested in the construction of productive assets for the advancement of established business objectives. " ;
             ex:designatesProcessType ex:P19210 ;
             ex:hierarchyID "10.2.1.1" ;
             ex:pcfID "19210" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19209 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Define capital investment plan" .


###  http://example.org/apqc#PCF_19211
ex:PCF_19211 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Monitoring plans on capital projects. Capital projects can be purchasing buildings, lands, etc. " ;
             ex:designatesProcessType ex:P19211 ;
             ex:hierarchyID "10.2.1.2" ;
             ex:pcfID "19211" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19209 ;
             skos:inScheme apqc:PCF ;
             skos:prefLabel "Monitor capital program" .


###  http://example.org/apqc#PCF_19212
ex:PCF_19212 rdf:type owl:NamedIndividual ,
                      skos:Concept ,
                      cco:ont00000853 ;
             ex:apqcSourceText "Acquiring the loans needed to construct necessary assets." ;
             ex:designatesProcessType ex:P19212 ;
             ex:hierarchyID "10.2.1.3" ;
             ex:pcfID "19212" ;
             rdfs:comment "APQC level: Activity" ;
             skos:broader ex:PCF_19209 ;
             skos:inScheme apqc:PCF ;
